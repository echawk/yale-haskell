#!/bin/sh
#
# run-smoke -- run each tests/smoke/*.hs with bin/yale-haskell and compare
# stdout with the matching .out file (stdin comes from .in, if present).
# Compiler chatter goes to stdout too, so only the trailing lines that
# the .out file has are compared.

cd "$(dirname "$0")/.." || exit 1
fail=0
for hs in tests/smoke/*.hs; do
  base=${hs%.hs}
  [ -f "$base.out" ] || continue
  in=/dev/null; [ -f "$base.in" ] && in=$base.in
  n=$(wc -l < "$base.out")
  if bin/yale-haskell "$hs" < "$in" 2>&1 | tail -n "$n" | diff -u "$base.out" - ; then
    echo "PASS $hs"
  else
    echo "FAIL $hs"; fail=1
  fi
done
exit $fail
