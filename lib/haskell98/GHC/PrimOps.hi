{-# LANGUAGE MagicHash #-}
-- GHC/PrimOps.hi -- GHC's primitive operations (GHC.Exts):
-- src/base/primops-runtime.lisp.  Unboxed tuples (# s, a #) are
-- ordinary tuples, and Int# etc. are Int etc. (GHC.Exts).

interface GHC.PrimOps where

