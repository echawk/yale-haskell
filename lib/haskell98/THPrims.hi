-- THPrims.hi -- Template Haskell's primitives into the compiler:
-- src/compiler/th/reify.mumble.

interface THPrims where

import PreludeCore(Char)

-- primTHReify namespace module occ: the definition the name refers to,
-- described as an s-expression (Language.Haskell.TH.Syntax decodes it),
-- or "" when there is none.  The namespace is "v", "d", "tc" or "" (any).
primTHReify :: String -> String -> String -> IO String

-- primTHQuery what arg: about the splice running (reify.mumble's
-- prim.th-query): "location" (file, module and line, one per line),
-- "extensions" (the module's, one per line), "lookup-type" and
-- "lookup-value" (the module and occurrence of the name ARG refers to, or
-- "").
primTHQuery :: String -> String -> IO String

{-#
primTHReify :: LispName("prim.th-reify")
primTHQuery :: LispName("prim.th-query")
#-}
