-- PosixPrims.hi -- primitives under the System.Posix subset
-- (src/base/posix-runtime.lisp).

interface PosixPrims where

import PreludeCore(Int,Integer,Bool,String)
import IOPrims(HandleObj)

-- a file's status: the host's stat structure
data FileStatusObj
-- mkstemp's result: the descriptor and the name
data MkstempObj

primPosixStat        :: String -> Bool -> IO FileStatusObj
primPosixFstat       :: Int -> IO FileStatusObj
primStatMode         :: FileStatusObj -> Int
primStatSize         :: FileStatusObj -> Integer
primStatMtime        :: FileStatusObj -> Integer
primStatAtime        :: FileStatusObj -> Integer
primModeFileType     :: Int -> Int
primPosixChmod       :: String -> Int -> IO ()
primPosixUtimes      :: String -> Integer -> Integer -> IO ()
primPosixLink        :: String -> String -> IO ()
primPosixSymlink     :: String -> String -> IO ()
primPosixSleep       :: Int -> IO Int
primPosixOpen        :: String -> Int -> Int -> Bool -> Bool -> Bool -> Bool -> Bool -> IO Int
primPosixClose       :: Int -> IO ()
primPosixDup2        :: Int -> Int -> IO Int
primPosixDup         :: Int -> IO Int
primPosixSetFdOption :: Int -> Int -> Bool -> IO ()
primHandleToFd       :: HandleObj -> IO Int
primFdToHandle       :: Int -> Int -> String -> IO HandleObj
primSignalNumber     :: String -> Int
primInstallSignalHandler :: Int -> Int -> IO () -> IO ()
primRaiseSignal      :: Int -> IO ()
primGetProcessID     :: IO Int
primSetCooked        :: Bool -> IO ()
primStatField        :: FileStatusObj -> Int -> Integer
primPosixReadlink    :: String -> IO String
primPosixRename      :: String -> String -> IO ()
primPosixUnlink      :: String -> IO ()
primPosixMkfifo      :: String -> Int -> IO ()
primPosixMknod       :: String -> Int -> Integer -> IO ()
primPosixChown       :: String -> Int -> Int -> Bool -> IO ()
primPosixFchown      :: Int -> Int -> Int -> IO ()
primPosixFchmod      :: Int -> Int -> IO ()
primPosixTruncate    :: String -> Integer -> IO ()
primPosixFtruncate   :: Int -> Integer -> IO ()
primPosixUmask       :: Int -> IO Int
primPosixAccess      :: String -> Bool -> Bool -> Bool -> IO Bool
primPosixPathconf    :: String -> Int -> IO Integer
primPosixFpathconf   :: Int -> Int -> IO Integer
primPosixMkstemp     :: String -> IO MkstempObj
primMkstempFd        :: MkstempObj -> Int
primMkstempName      :: MkstempObj -> String
primPosixTime        :: IO Integer
primPosixUname       :: Int -> String

