primReadMutArr     :: LispName("prim.read-mut-arr")
primWriteMutArr    :: LispName("prim.write-mut-arr"), Strictness("S,S,N,S")
primMutArrEq       :: LispName("prim.ref-eq")
primMutArrToArray  :: LispName("prim.mut-arr-to-array"), Strictness("S,S")
primCopyMutArrToArray :: LispName("prim.copy-mut-arr-to-array"), Strictness("S,S,S")
primArrayToMutArr  :: LispName("prim.array-to-mut-arr"), Strictness("S")
primCopyArrayToMutArr :: LispName("prim.copy-array-to-mut-arr"), Strictness("S,S")
primUnsafePerformIO    :: LispName("prim.unsafe-perform-io")
primUnsafeInterleaveIO :: LispName("prim.unsafe-interleave-io")
primCatchAny       :: LispName("prim.catch-any"), Strictness("N,S,S")
primThrowExc       :: LispName("prim.throw-exc")
primExcKind        :: LispName("prim.exc-kind")
primExcMessage     :: LispName("prim.exc-message")
primMakeErrorCall  :: LispName("prim.make-error-call")
primMakeArithError :: LispName("prim.make-arith-error")
primArithCode      :: LispName("prim.arith-code")
primMakeUserExc    :: LispName("prim.make-user-exc")
primExcValue       :: LispName("prim.exc-value")
primExcToObj       :: LispName("prim.identity")
primObjToExc       :: LispName("prim.identity")
primEvaluate       :: LispName("prim.identity"), Strictness("S,S")
primSystem         :: LispName("prim.system")
primLastExitCode      :: LispName("prim.last-exit-code")
primLaunchProcess  :: LispName("prim.launch-process")
primProcessHandle  :: LispName("prim.process-handle")
primWaitProcess    :: LispName("prim.wait-process")
primProcessRunning :: LispName("prim.process-running")
primTerminateProcess :: LispName("prim.terminate-process")
primReadProcessFull :: LispName("prim.read-process-full")
primLastStderr     :: LispName("prim.last-stderr")
primProcessFailed  :: LispName("prim.process-failed")
primReadProcessOutput :: LispName("prim.read-process-output")
primOS             :: LispName("prim.os")
primArch           :: LispName("prim.arch")
primEnvIsSet       :: LispName("prim.env-is-set")
primEnvValue       :: LispName("prim.env-value")
primSetEnv         :: LispName("prim.set-env")
primUnsetEnv       :: LispName("prim.unset-env")
primHomeDirectory  :: LispName("prim.home-directory")
primTemporaryDirectory :: LispName("prim.temporary-directory")
primCreateDirectoryIfMissing :: LispName("prim.create-directory-if-missing")
primRemoveDirectoryRecursive :: LispName("prim.remove-directory-recursive")
primCopyFile       :: LispName("prim.copy-file")
primFindExecutable :: LispName("prim.find-executable")
primIsTerminal     :: LispName("prim.is-terminal")
primGetEcho        :: LispName("prim.get-echo")
primSetEcho        :: LispName("prim.set-echo")
primTruncateFile   :: LispName("prim.truncate-file")
primCreateTempFile :: LispName("prim.create-temp-file")
primGetHostName    :: LispName("prim.get-host-name")
#-}
