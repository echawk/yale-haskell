-- BasePrims.hi -- primitives under the base library modules that are not
-- the FFI's: exceptions, processes, the platform, the environment and
-- directories (src/base/base-runtime.lisp).

interface BasePrims where

import PreludeCore(Int,Integer,Bool,Char,Array)
import IOPrims(HandleObj)

-- an exception: a Lisp condition (Control.Exception)
data Exc

-- a mutable reference (Data.IORef, Data.STRef): the runtime's cell
-- (src/runtime/handle-prims.mumble, as RandomPrims.hi); the value is
-- stored unevaluated
data Ref a

-- a weak pointer (System.Mem.Weak): SBCL's, to an evaluated key
data WeakObj
primWeakPtr        :: a -> IO WeakObj
primWeakAlive      :: WeakObj -> IO Bool

-- wait until a file descriptor can be read (True) or written (False)
primWaitFd         :: Int -> Bool -> IO ()

primNewRef         :: a -> IO (Ref a)
primReadRef        :: Ref a -> IO a
primWriteRef       :: Ref a -> a -> IO ()
primRefEq          :: Ref a -> Ref a -> Bool
-- the same object (GHC.Exts' reallyUnsafePtrEquality#), both evaluated
primPtrEq          :: a -> a -> Bool

-- a mutable array (Data.Array.Base): a Lisp simple vector; elements are
-- stored unevaluated
data MutArr a

primNewMutArr      :: Int -> a -> IO (MutArr a)
primNewUMutArr     :: Int -> a -> IO (MutArr a)
primReadMutArr     :: MutArr a -> Int -> IO a
primWriteMutArr    :: MutArr a -> Int -> a -> IO ()
primMutArrEq       :: MutArr a -> MutArr a -> Bool
-- an Array's vector holds the same values (a Box is its field), so
-- these wrap or copy the vector: the bounds must be evaluated
primMutArrToArray  :: (i, i) -> MutArr e -> Array i e
primCopyMutArrToArray :: (i, i) -> MutArr e -> IO (Array i e)
primArrayToMutArr  :: Array i e -> MutArr e
primCopyArrayToMutArr :: Array i e -> IO (MutArr e)

-- System.IO.Unsafe (and runST)
primUnsafePerformIO    :: IO a -> a
primUnsafeInterleaveIO :: IO a -> IO a

primCatchAny       :: IO a -> (Exc -> IO a) -> IO a
primThrowExc       :: Exc -> a
primExcKind        :: Exc -> Int
primExcMessage     :: Exc -> String
primMakeErrorCall  :: String -> Exc
primMakeArithError :: Int -> Exc
primArithCode      :: Exc -> Int
-- an exception of a program's own type (Control.Exception): its shown
-- text and the value as a Dynamic
primMakeUserExc    :: String -> a -> Exc
primExcValue       :: Exc -> a
-- between Exc and the Prelude's IOErrorObj (both conditions); the other
-- type is left polymorphic, and fixed by Control.Exception
primExcToObj       :: Exc -> b
primObjToExc       :: b -> Exc

-- the argument evaluated when the action runs (Control.Exception.evaluate)
primEvaluate       :: a -> IO a

primSystem         :: String -> IO Int
primLastExitCode      :: IO Int
primReadProcessOutput :: String -> String -> IO String
-- System.Process: a running process (uiop's process-info)
data Proc
primLaunchProcess  :: String -> String -> Bool -> String -> Int -> HandleObj
                      -> Int -> HandleObj -> Int -> HandleObj -> IO Proc
primProcessHandle  :: Proc -> Int -> IO HandleObj
primWaitProcess    :: Proc -> IO Int
primProcessRunning :: Proc -> IO Bool
primTerminateProcess :: Proc -> IO ()
primReadProcessFull :: String -> String -> Bool -> String -> String -> Bool
                       -> IO String
primLastStderr     :: IO String
primProcessFailed  :: String -> IO a

primOS             :: String
primArch           :: String

primEnvIsSet       :: String -> IO Bool
primEnvValue       :: String -> IO String
primSetEnv         :: String -> String -> IO ()
primUnsetEnv       :: String -> IO ()
primHomeDirectory  :: IO String
primTemporaryDirectory :: IO String

primCreateDirectoryIfMissing :: Bool -> String -> IO ()
primRemoveDirectoryRecursive :: String -> IO ()
primCopyFile       :: String -> String -> IO ()
primFindExecutable :: String -> IO String

primIsTerminal     :: Int -> IO Bool
primGetEcho        :: IO Bool
primSetEcho        :: Bool -> IO ()
primTruncateFile   :: String -> Integer -> IO ()
primCreateTempFile :: String -> String -> String -> IO String
primGetHostName    :: IO String

-- Text.Regex: a compiled regular expression (a cl-ppcre scanner)
data RegexObj
primRegexCompile   :: String -> Bool -> Bool -> RegexObj
primRegexMatch     :: RegexObj -> String -> String
data TypeRepObj
primTypeRepName    :: TypeRepObj -> String
primTypeRepModule  :: TypeRepObj -> String
primTypeRepArity   :: TypeRepObj -> Int
primTypeRepArg     :: TypeRepObj -> Int -> TypeRepObj
primTypeableDict   :: a
data KnobObj
primKnobNew        :: String -> IO KnobObj
primEnvironment    :: IO String
primKnobContents   :: KnobObj -> IO String
primKnobSet        :: KnobObj -> String -> IO ()
primKnobHandle     :: KnobObj -> String -> Int -> IO HandleObj

{-#
primRegexCompile   :: LispName("prim.regex-compile")
primRegexMatch     :: LispName("prim.regex-match")
primTypeRepName    :: LispName("prim.typerep-name")
primTypeRepModule  :: LispName("prim.typerep-module")
primTypeRepArity   :: LispName("prim.typerep-arity")
primTypeRepArg     :: LispName("prim.typerep-arg")
primTypeableDict   :: LispName("prim.typeable-dict")
primKnobNew        :: LispName("prim.knob-new")
primEnvironment    :: LispName("prim.environment")
primKnobContents   :: LispName("prim.knob-contents")
primKnobSet        :: LispName("prim.knob-set")
primKnobHandle     :: LispName("prim.knob-handle")
primNewRef         :: LispName("prim.new-ref"), Strictness("N,S")
primWeakPtr        :: LispName("prim.weak-ptr"), Strictness("S,S")
primWaitFd         :: LispName("prim.wait-fd"), Strictness("S,S,S")
primWeakAlive      :: LispName("prim.weak-alive"), Strictness("S,S")
