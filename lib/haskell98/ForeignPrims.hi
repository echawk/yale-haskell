-- ForeignPrims.hi -- the primitives under the Foreign.* modules (Haskell
-- 2010 chapter 8), over CFFI: src/ffi/ffi-runtime.lisp.  Ptr and FunPtr
-- are foreign pointers; the marshalling of foreign import declarations
-- (backend/interface-codegen.mumble) knows them by this module's name.

interface ForeignPrims where

import PreludeCore(Int,Integer,Float,Double,Char,Bool)

-- The peek and poke primitives of the Data.Int and Data.Word types have
-- a polymorphic value type: those types are newtypes over Int or Integer
-- (erased at run time), and only Foreign.Storable's instances, which fix
-- the type, use them.

data Ptr a
data FunPtr a

primNullPtr          :: Ptr a
primNullFunPtr       :: FunPtr a
primPlusPtr          :: Ptr a -> Int -> Ptr b
primMinusPtr         :: Ptr a -> Ptr b -> Int
primPtrEq, primPtrLe :: Ptr a -> Ptr a -> Bool
primFunPtrEq, primFunPtrLe :: FunPtr a -> FunPtr a -> Bool
primPtrToInteger     :: Ptr a -> Integer
primFunPtrToInteger  :: FunPtr a -> Integer
primIntegerToPtr     :: Integer -> Ptr a
primCastPtr          :: Ptr a -> Ptr b
primCastFunPtr       :: FunPtr a -> FunPtr b
primCastFunPtrToPtr  :: FunPtr a -> Ptr b
primCastPtrToFunPtr  :: Ptr a -> FunPtr b

primPeekInt8   :: Ptr a -> Int -> IO b
primPeekInt16  :: Ptr a -> Int -> IO b
primPeekInt32  :: Ptr a -> Int -> IO b
primPeekInt64  :: Ptr a -> Int -> IO b
primPeekWord8  :: Ptr a -> Int -> IO b
primPeekWord16 :: Ptr a -> Int -> IO b
primPeekWord32 :: Ptr a -> Int -> IO b
primPeekWord64 :: Ptr a -> Int -> IO b
primPeekWord   :: Ptr a -> Int -> IO b
primPeekInt    :: Ptr a -> Int -> IO Int
primPeekChar   :: Ptr a -> Int -> IO Char
primPeekCInt   :: Ptr a -> Int -> IO Int
primPeekDouble :: Ptr a -> Int -> IO Double
primPeekFloat  :: Ptr a -> Int -> IO Float
primPeekPtr    :: Ptr a -> Int -> IO (Ptr b)
primPeekFunPtr :: Ptr a -> Int -> IO (FunPtr b)

primPokeInt8   :: Ptr a -> Int -> b -> IO ()
primPokeInt16  :: Ptr a -> Int -> b -> IO ()
primPokeInt32  :: Ptr a -> Int -> b -> IO ()
primPokeInt64  :: Ptr a -> Int -> b -> IO ()
primPokeWord8  :: Ptr a -> Int -> b -> IO ()
primPokeWord16 :: Ptr a -> Int -> b -> IO ()
primPokeWord32 :: Ptr a -> Int -> b -> IO ()
primPokeWord64 :: Ptr a -> Int -> b -> IO ()
primPokeWord   :: Ptr a -> Int -> b -> IO ()
primPokeInt    :: Ptr a -> Int -> Int -> IO ()
primPokeChar   :: Ptr a -> Int -> Char -> IO ()
primPokeCInt   :: Ptr a -> Int -> Int -> IO ()
primPokeDouble :: Ptr a -> Int -> Double -> IO ()
primPokeFloat  :: Ptr a -> Int -> Float -> IO ()
primPokePtr    :: Ptr a -> Int -> Ptr b -> IO ()
primPokeFunPtr :: Ptr a -> Int -> FunPtr b -> IO ()

primMalloc     :: Int -> IO (Ptr a)
primCalloc     :: Int -> IO (Ptr a)
primRealloc    :: Ptr a -> Int -> IO (Ptr b)
primFree       :: Ptr a -> IO ()
primCopyBytes  :: Ptr a -> Ptr a -> Int -> IO ()
primMoveBytes  :: Ptr a -> Ptr a -> Int -> IO ()
primFillBytes  :: Ptr a -> Int -> Int -> IO ()

primNewCString     :: String -> IO (Ptr a)
primPeekCString    :: Ptr a -> IO String
primPeekCStringLen :: Ptr a -> Int -> IO String
primCStringLength  :: String -> Int

primLoadLibrary    :: String -> IO ()
primUnsafePerformIO :: IO a -> a

