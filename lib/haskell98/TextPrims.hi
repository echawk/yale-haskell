-- TextPrims.hi -- the packed Data.Text (a Lisp string) and its
-- primitives: src/base/text-runtime.lisp.  A Char is passed as its code;
-- a TextList is a [Text] (Data.Text coerces), forced by the primitive.

interface TextPrims where

import PreludeCore(Int,Integer,Char,Bool)
import IOPrims(HandleObj)

data TextRep
data TextList

primTextPack         :: String -> TextRep
primTextUnpack       :: TextRep -> String
primTextSingleton    :: Char -> TextRep
primTextLength       :: TextRep -> Int
primTextIndex        :: TextRep -> Int -> Char
primTextCompare      :: TextRep -> TextRep -> Int
primTextEq           :: TextRep -> TextRep -> Bool
primTextAppend       :: TextRep -> TextRep -> TextRep
primTextConcat       :: TextList -> TextRep
primTextIntercalate  :: TextRep -> TextList -> TextRep
primTextCons         :: Char -> TextRep -> TextRep
primTextSnoc         :: TextRep -> Char -> TextRep
primTextReplicate    :: Int -> TextRep -> TextRep
primTextReverse      :: TextRep -> TextRep
primTextSlice        :: TextRep -> Int -> Int -> TextRep
primTextSearch       :: TextRep -> TextRep -> Int -> Int
primTextIsPrefix, primTextIsSuffix, primTextIsInfix :: TextRep -> TextRep -> Bool
primTextCount        :: TextRep -> TextRep -> Int
primTextReplace      :: TextRep -> TextRep -> TextRep -> TextRep
primTextSplitOn      :: TextRep -> TextRep -> TextList
primTextLines, primTextWords :: TextRep -> TextList
primTextUnlines, primTextUnwords :: TextList -> TextRep
primTextStrip        :: TextRep -> Int -> TextRep
primTextMap          :: (Char -> Char) -> TextRep -> TextRep
primTextFilter       :: (Char -> Bool) -> TextRep -> TextRep
primTextSpanLength, primTextSpanLengthEnd :: (Char -> Bool) -> TextRep -> Int
primTextFindIndex    :: (Char -> Bool) -> TextRep -> Int
primTextFoldlStrict  :: (a -> Char -> a) -> a -> TextRep -> a
primTextToUpper, primTextToLower :: TextRep -> TextRep
primTextReadFile     :: String -> IO TextRep
primTextHGetContents :: HandleObj -> IO TextRep
primTextHPutStr      :: HandleObj -> TextRep -> IO ()
-- Data.ByteString.Char8's IO (a ByteString is a TextRep of bytes)
primBytesReadFile    :: String -> IO TextRep
primBytesHGetContents :: HandleObj -> IO TextRep
primBytesHPutStr     :: HandleObj -> TextRep -> IO ()

{-#
primTextPack         :: LispName("prim.text-pack")
primTextUnpack       :: LispName("prim.text-unpack")
