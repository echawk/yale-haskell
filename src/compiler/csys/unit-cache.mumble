;;; unit-cache.mumble -- compiled units kept on disk between runs
;;;
;;; Without a cache, every run compiles every unit it loads except the
;;; Prelude: the program and the library modules it imports.  With one,
;;; a unit compiled once writes its code and interface files under the
;;; cache directory, and later runs load those while they are current
;;; (unit-valid?: newer than the unit's sources and the units it imports).
;;;
;;; Each unit's files are put at the absolute name of the files a .hu
;;; file's :output would give, under
;;;
;;;   <root>/<build>/<mode>/
;;;
;;; root   $YALE_HASKELL_CACHE_DIR, else $XDG_CACHE_HOME/yale-haskell,
;;;        else $HOME/.cache/yale-haskell
;;; build  the Lisp, the dialect and the executable's write date: a new
;;;        build starts afresh, since compiled code depends on it
;;; mode   what changes the code compiled: --haskell2010,
;;;        --modern-prelude, the back end and the optimizers
;;;        (unit-cache-mode-key, in command-utils.mumble)
;;;
;;; Which units are cached (setup-unit-cache):
;;;   all      batch runs (yale-haskell foo.hs)
;;;   library  only $HASKELL_LIBRARY's units: the interactive system,
;;;            which needs the program's own modules whole (not just their
;;;            interfaces), and runs with printers on
;;;   off      YALE_HASKELL_CACHE=0 (or off, no)
;;; YALE_HASKELL_CACHE=library limits batch runs to library units; the
;;; tests do that, since cached units do not repeat their warnings.
;;; The Prelude (in the executable) and units with Lisp files are never
;;; cached.

(define *unit-cache-directory* '#f)   ; ends in /; '#f: no cache
(define *unit-cache-policy* 'off)     ; off, library or all

;;; Turns the cache on for POLICY (all or library), within what
;;; $YALE_HASKELL_CACHE allows.  MODE-KEY names the compilation mode.

(define (setup-unit-cache policy mode-key)
  (let* ((env      (or (getenv "YALE_HASKELL_CACHE") ""))
	 (policy   (cond ((mem-string env '("0" "off" "no")) 'off)
			 ((string=? env "library")
			  (if (eq? policy 'off) 'off 'library))
			 (else policy)))
	 (root     (unit-cache-root))
	 (build    (unit-cache-build-key)))
    (if (or (eq? policy 'off) (not root) (not build))
	(begin
	  (setf *unit-cache-policy* 'off)
	  (setf *unit-cache-directory* '#f))
	(begin
	  (when (not (file-exists? (string-append root build "/")))
	    (remove-old-unit-caches root build))
	  (setf *unit-cache-policy* policy)
	  (setf *unit-cache-directory*
		(string-append root build "/" mode-key "/"))))))

;;; A new build starts a new cache directory: the old builds' ones (the
;;; same Lisp and dialect, another date) are removed then.

(define (remove-old-unit-caches root build)
  (let ((prefix  (substring build 0 (1+ (lisp:position #\- build :from-end '#t)))))
    (dolist (dir (lisp:funcall (lisp:find-symbol "SUBDIRECTORIES" "UIOP")
			       (absolute-filename root)))
      (let ((name  (car (lisp:last (lisp:pathname-directory dir)))))
	(when (or (and (string-starts? prefix name) (not (string=? name build)))
		  (old-format-cache-name? prefix name))
	  (lisp:ignore-errors
	   (lisp:funcall (lisp:find-symbol "DELETE-DIRECTORY-TREE" "UIOP")
			 dir ':validate '#t)))))))

;;; A cache of this Lisp and dialect named before the place was in the
;;; key: "sbcl-haskell98-<date>".
(define (old-format-cache-name? prefix name)
  (let* ((p     (lisp:position #\- prefix :end (1- (string-length prefix))
			      :from-end '#t))
	 (base  (and p (substring prefix 0 (1+ p)))))
    (and base
	 (string-starts? base name)
	 (> (string-length name) (string-length base))
	 (lisp:every (function lisp:digit-char-p)
		     (substring name (string-length base) (string-length name))))))

(define (unit-cache-root)
  (let ((dir   (getenv "YALE_HASKELL_CACHE_DIR"))
	(xdg   (getenv "XDG_CACHE_HOME"))
	(home  (getenv "HOME")))
    (cond ((nonempty-string? dir)  (directory-name dir))
	  ((nonempty-string? xdg)  (string-append (directory-name xdg)
						  "yale-haskell/"))
	  ((nonempty-string? home) (string-append (directory-name home)
						  ".cache/yale-haskell/"))
	  (else '#f))))

(define (nonempty-string? s)
  (and (string? s) (not (string=? s ""))))

(define (directory-name dir)
  (if (char=? (string-ref dir (1- (string-length dir))) #\/)
      dir
      (string-append dir "/")))

;;; "sbcl-haskell98-<place>-<date>", from $PRELUDEBIN (build/<lisp>/
;;; <dialect>/prelude), a hash of where that build directory is, and the
;;; write date of the executable beside it.  The place keeps two checkouts
;;; (a worktree) from taking each other's caches for old builds of their
;;; own and removing them, even while the other's programs use them.

(define (unit-cache-build-key)
  (let ((pbin  (getenv "PRELUDEBIN")))
    (and (nonempty-string? pbin)
	 (let* ((build  (filename-place
			 (absolute-filename
			  (string-append (directory-name pbin) "../x"))))
		(exe    (string-append build "yale-haskell"))
		(parts  (last-path-components build 2)))
	   (and (file-exists? exe)
		(format '#f "~A-~A-~(~36R~)-~A" (car parts) (cadr parts)
			(string-hash-32 build) (file-write-date exe)))))))

;;; FNV-1a over the characters' codes: the same in every Lisp and session.
(define (string-hash-32 s)
  (let ((h  2166136261))
    (dotimes (i (string-length s))
      (setf h (lisp:logand (* (lisp:logxor h (char->integer (string-ref s i)))
			      16777619)
			   4294967295)))
    h))

;;; The last N components of directory name DIR (ending in /).

(define (last-path-components dir n)
  (let ((result  '())
	(end     (1- (string-length dir))))
    (dotimes (i n)
      (let ((start  (let ((p (lisp:position #\/ dir :end end :from-end '#t)))
		      (if p (1+ p) 0))))
	(push (substring dir start end) result)
	(setf end (max 0 (1- start)))))
    result))

;;; Whether a unit's files go in the cache.

(define (cache-unit-output? ufile stable? lisp-files)
  (and *unit-cache-directory*
       (not stable?)
       (null? lisp-files)
       (or (eq? *unit-cache-policy* 'all)
	   (library-source-file? ufile))))

;;; Where a unit with output name FILENAME keeps its files in the cache.

(define (unit-cache-filename filename)
  (let ((abs  (absolute-filename filename)))
    (string-append (dynamic *unit-cache-directory*)
		   (if (and (> (string-length abs) 0)
			    (char=? (string-ref abs 0) #\/))
		       (substring abs 1 (string-length abs))
		       abs))))

;;; The units a cached unit was compiled against, beside its files
;;; (<cfile>.imports): if another unit now provides one of its imports
;;; (a new M.hs next to the program, --modern-prelude's Control.Monad),
;;; dates alone would not show it stale.  The names are written absolute
;;; (a program's own units are named relative to the directory it was run
;;; from), so a run from another directory finds them unchanged.

(define (unit-imports-filename c)
  (string-append (ucache-cfile c) ".imports"))

(define (write-unit-imports c)
  (call-with-output-file (unit-imports-filename c)
    (lambda (port)
      (dolist (u (unit-imports-names c))
	(write-string u port)
	(write-char #\newline port)))))

(define (unit-imports-unchanged? c)
  (let ((file  (unit-imports-filename c)))
    (and (file-exists? file)
	 (equal? (call-with-input-file file
		   (lambda (port)
		     (do ((line (read-line port) (read-line port))
			  (lines '() (cons line lines)))
			 ((eof-object? line) (reverse lines)))))
		 (unit-imports-names c)))))

(define (unit-imports-names c)
  (map (lambda (u)
	 (if (string-starts? "$" u) u (absolute-filename u)))
       (ucache-imported-units c)))

(define (unit-in-cache? c)
  (and *unit-cache-directory*
       (string-starts? *unit-cache-directory* (ucache-cfile c))))

;;; Loading a cached unit compiles it and writes its files.

(define *unit-cache-cflags*
  (make cflags
	(load-code?          '#t)
	(compile-code?       '#t)
	(write-code?         '#t)
	(write-interface?    '#t)))

;;; Concurrent compilations of one unit (make test -j, parallel harness
;;; runs) wrote its files (code, interface, imports) each by an atomic
;;; rename, but a reader could take one compilation's interface with the
;;; other's code: the two number their generated constants differently,
;;; and a program faulted (happy's showVersion, 2026-10-16).  A writer
;;; now holds <code file>.lock, made by exclusive create, while it
;;; writes; another process meanwhile compiles the unit in core without
;;; writing, and does not read a unit whose lock exists.  A lock older
;;; than *unit-lock-stale-seconds* is a crashed writer's, and is removed.

(define *unit-lock-stale-seconds* 600)

(define *unit-in-core-cflags*
  (make cflags
	(load-code?          '#t)
	(compile-code?       '#t)
	(write-code?         '#f)
	(write-interface?    '#f)))

(define (unit-lock-file c)
  (string-append (ucache-cfile c) ".lock"))

(define (unit-locked? c)
  (and (unit-in-cache? c)
       (let ((lock  (unit-lock-file c)))
	 (and (file-exists? lock)
	      (if (> (- (current-date) (or (lisp:ignore-errors (file-write-date lock)) 0))
		     *unit-lock-stale-seconds*)
		  (begin (lisp:ignore-errors (lisp:delete-file lock)) '#f)
		  '#t)))))

;;; The lock's name, or '#f when another process holds it.
(define (acquire-unit-lock c)
  (let ((lock  (unit-lock-file c)))
    (unit-locked? c)			; clears a stale one
    (lisp:ensure-directories-exist lock)
    (let ((s  (lisp:ignore-errors
	       (lisp:open lock ':direction ':output ':if-exists '#f
			  ':if-does-not-exist ':create))))
      (if s
	  (begin (lisp:close s) lock)
	  '#f))))

;;; Compiles unit C (compiler-driver.mumble), holding its lock when its
;;; files go in the cache.
(define (compile-unit-locked c cflags compile)
  (if (and (unit-in-cache? c)
	   (or (cflags-write-code? cflags) (cflags-write-interface? cflags)))
      (let ((lock  (acquire-unit-lock c)))
	(if lock
	    (lisp:unwind-protect
		(funcall compile c cflags)
	      (lisp:ignore-errors (lisp:delete-file lock)))
	    (funcall compile c *unit-in-core-cflags*)))
      (funcall compile c cflags)))

(define (unit-cflags c cflags)
  (if (and (cflags-load-code? cflags)
	   (not (cflags-write-code? cflags))
	   (not (cflags-write-interface? cflags))
	   (unit-in-cache? c))
      *unit-cache-cflags*
      cflags))
