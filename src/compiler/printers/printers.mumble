;;; printers.mumble -- compilation unit definition for structure printers
;;;
;;; author :  Sandra Loosemore
;;; date   :  3 Jan 1992
;;;
;;;

(define-compilation-unit printer-support
  (source-filename "$Y2/src/compiler/printers/")
  (require global)
  (unit util
	(source-filename "util.mumble")))

(define-compilation-unit printers
  (source-filename "$Y2/src/compiler/printers/")
  (require printer-support)
  (unit print-exps
	(source-filename "print-exps.mumble"))
  (unit print-modules
	(source-filename "print-modules.mumble"))
  (unit print-types
	(source-filename "print-types.mumble"))
  (unit print-ntypes
	(source-filename "print-ntypes.mumble"))
  (unit print-valdefs
	(source-filename "print-valdefs.mumble"))
  )

