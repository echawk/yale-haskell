;;; These routines deal with the global symbol table.  The symbol table
;;; is represented in two stages: a module table which maps module names
;;; onto module structures and local tables within each module which
;;; map names (symbols) to definitions.

;;; The following functions deal with the module table (*modules*):

;;;  (initialize-module-table) - this clears out all modules from the
;;;      symbol table.  Every compilation should start with this.
;;;  (add-module-to-module-table module) - this takes a module ast,
;;;      either from a .exp file or previous compilation with the same
;;;      incarnation of the compiler and adds it to the set of `known'
;;;      modules.  Incomplete module ast's in the process of compilation
;;;      are also added to this table.


(define (initialize-module-table)
  (setf *modules* (make-table)))

(define (add-module-to-symbol-table module)
  (let* ((name (module-name module))
	 (old-module (table-entry *modules* name)))
    (when (not (eq? old-module '#f))
      (if (eq? *unit* (module-unit old-module))
	  (signal-module-double-definition name)
	  (signal-module-already-defined name)))
    (setf (table-entry *modules* name) module)))

(define (remove-module-from-symbol-table module)
  (let ((name (module-name module)))
    (setf (table-entry *modules* name) '#f)))

(define (locate-module name)
  (table-entry *modules* name))

;;;  (walk-modules fn mod-list) - this calls fn for each module in the
;;;      mod-list.  It also binds the global variable *module* to the
;;;      current module, *symbol-table* to the local symbol
;;;      table.  The fixity table is also placed in a global.

(define (walk-modules mods fn)
  ;; (the last call's value: th/reify.mumble looks a name up this way)
  (let ((result '#f))
    (dolist (mod mods)
      (dynamic-let ((*module* mod)
		    (*module-name* (module-name mod))
		    (*symbol-table* (module-symbol-table mod))
		    (*fixity-table* (module-fixity-table mod))
		    (*inverted-symbol-table* (module-inverted-symbol-table mod)))
	(setf result (funcall fn))))
    result))

;;; create-definition makes a new definition object 

(define (create-definition module name type)
  (cond ((module-prelude? module)
	 (let ((def (table-entry *core-symbols* name)))
	   (cond ((eq? def '#f)
		  (create-definition/non-core module name type))
		 (else
		  (setf (def-unit def) *unit*)
		  (setf (def-module def) (module-name module))
		  ;; *** Should any other properties be reinitialized here?
		  (cond ((or (eq? type 'var) (eq? type 'method-var))
			 (setf (var-fixity def) '#f)
			 (setf (var-signature def) '#f))
			((eq? type 'con)
			 (setf (con-fixity def) '#f)))
		  def))))
	(else (create-definition/non-core module name type))))

;(define (create-definition/non-core module name type)
;  (create-definition/new module name type)
;      (let* ((interface (module-interface-module module))
;	     (old-def (table-entry (module-symbol-table interface) name)))
;	(if (eq? old-def '#f)
;	    (create-definition/new module name type)
;	    (cond ((eq? type 'var)
;		   (unless (var? old-def)	
;		       (def-conflict module name type old-def))
;		   (setf (var-interface-type old-def) (var-type old-def)))
;		  ((eq? type 'con)
;		   (unless (con? old-def)
;		      (def-conflict module name type old-def)))
;		  ((eq? type 'synonym)
;		   (unless (synonym? old-def)
;		      (def-conflict module name type old-def)))
;		  ((eq? type 'algdata)
;		   (unless (algdata? old-def)
;		      (def-conflict module name type old-def)))
;		  ((eq? type 'class)
;		   (unless (class? old-def)
;		      (def-conflict module name type old-def)))
;		  ((eq? type 'method-var)
;		   (unless (method-var? old-def)
;		      (def-conflict module name type old-def)))))
;	(setf (def-unit old-def) *unit*)
;	old-def)))
;
;(define (def-conflict module name type def)
;  (phase-error 'interface-conflict
;    "The ~A ~A in module ~A was defined as a ~A in an interface."
;    (cond ((var? def) "variable")
;	  ((class? def) "class")
;	  ((algdata? def) "data type")
;	  ((synonym? def) "synonym")
;	  ((con? def) "constructor")
;	  (else "widgit"))
;    name (module-name module) type))    

(define (create-definition/non-core module name type)
  (let ((mname  (module-name module)))
    (when (eq? (module-type *module*) 'interface)
       (mlet (((mod name1) (rename-interface-symbol name)))
         (setf mname mod)
	 (setf name name1)))
    (create-definition/inner mname name type)))

(define (create-definition/inner mname name type)
    (cond ((eq? type 'var)
	   (make var (name name) (module mname) (unit *unit*)))
	  ((eq? type 'con)
	   (make con (name name) (module mname) (unit *unit*)))
	  ((eq? type 'synonym)
	   (make synonym (name name) (module mname) (unit *unit*)))
	  ((eq? type 'algdata)
	   (make algdata (name name) (module mname) (unit *unit*)))
	  ((eq? type 'class)
	   (make class (name name) (module mname) (unit *unit*)))
	  ((eq? type 'method-var)
	   (make method-var (name name) (module mname) (unit *unit*)))
	  (else
	   (error "Bad type argument ~s." type))))


(define (create-top-definition name type)
  (let ((def (create-definition *module* name type)))
    (insert-top-definition name def)
    ;; A module's own top-level names are also M.x (report 5.5.1).
    (when (feature? 'qualified-names)
      (insert-qualified-definition (qualify-name *module-name* name) def))
    def))

;;; Qualified names (report 5.5.1).  M.x is entered in the symbol table
;;; as the symbol |M.x| (|;M.C| for a constructor, keeping the ; prefix
;;; in front), next to the unqualified names, so lookups need no change.
;;; The lexer produces the same spelling for a qualified name token.

(define (qualify-name mod-name name)
  (let ((m (symbol->string mod-name))
	(n (symbol->string name)))
    (string->symbol
     (if (and (> (string-length n) 0) (char=? (string-ref n 0) #\;))
	 (string-append ";" m "." (substring n 1 (string-length n)))
	 (string-append m "." n)))))

;;; The base name of a qualified name and its module, or #f for an
;;; unqualified one: |M.x| -> x, M;  |;A.B.C| -> ;C, A.B.  The module is
;;; the longest run of Conid segments each followed by `.' that leaves a
;;; non-empty base name.

(define (split-qualified-name name)
  (let* ((s (symbol->string name))
	 (n (string-length s))
	 (start (if (and (> n 0) (char=? (string-ref s 0) #\;)) 1 0))
	 (dot '#f)
	 (i start))
    ;; i is at the start of a segment; accept it as a module segment if it
    ;; is a Conid followed by `.' and at least one more character.
    (do ((done? '#f))
	(done?)
      (let ((end (conid-end s i)))
	(if (and end (< (1+ end) n) (char=? (string-ref s end) #\.))
	    (begin (setf dot end) (setf i (1+ end)))
	    (setf done? '#t))))
    (if (eq? dot '#f)
	(values '#f '#f)
	(values (string->symbol
		 (string-append (if (eqv? start 1) ";" "")
				(substring s (1+ dot) n)))
		(string->symbol (substring s start dot))))))

;;; The index just past the Conid starting at I in S, or #f.

(define (conid-end s i)
  (let ((n (string-length s)))
    (if (or (>= i n) (not (char-upper-case? (string-ref s i))))
	'#f
	(do ((j (1+ i) (1+ j)))
	    ((or (>= j n)
		 (not (or (char-alphabetic? (string-ref s j))
			  (char-numeric? (string-ref s j))
			  (memv (string-ref s j) '(#\_ #\')))))
	     j)))))

;;; Enter a qualified name.  Unlike insert-top-definition this leaves the
;;; inverted table alone: a def's local (printing) name stays unqualified.

(define (insert-qualified-definition qname def)
  (let ((old (table-entry *symbol-table* qname)))
    (cond ((or (eq? old '#f) (eq? old def))
	   (setf (table-entry *symbol-table* qname) def))
	  ;; Prelude.foldr with --modern-prelude: Foldable's (PreludeModern)
	  ;; supersedes the list one, as for unqualified names
	  ((mlet (((base _) (split-qualified-name qname)))
	     (and base (supersedes-prelude-def? base def old)))
	   (setf (table-entry *symbol-table* qname) def))
	  ((mlet (((base _) (split-qualified-name qname)))
	     (and base (supersedes-prelude-def? base old def)))
	   'OK)
	  ((haskell98?)
	   ;; two modules imported as the same name (import qualified A as L;
	   ;; import qualified B as L) with an x each: only a use of L.x is
	   ;; an error (5.5.2), as for unqualified names
	   (mlet (((base _) (split-qualified-name qname)))
	     (note-name-clash qname
	       (lisp:format lisp:nil "~A.~A or ~A.~A"
			    (def-module old) (clash-display-name (or base qname))
			    (def-module def) (clash-display-name (or base qname))))))
	  (else
	   (signal-multiple-import qname *module-name*)))))

;;; Interfaces have a special table which resolves imports in the
;;; interface.  Given a name in an interface module this returns the
;;; corresponding full name: a (module,original-name) pair.  Symbols not
;;; imported are assumed to be defined in the interface.

(define (rename-interface-symbol name)
  (let ((res (assq name (module-interface-imports *module*))))
    (if (eq? res '#f)
	(values *module-name* name)
	(values (tuple-2-1 (tuple-2-2 res))
		(tuple-2-2 (tuple-2-2 res))))))

;;; This creates a locally defined var node.

(define (create-local-definition name)
  (let ((var     (make var (name name) (module *module-name*) (unit *unit*))))
    (setf (var-fixity var) (table-entry *fixity-table* name))
    var))


;;; This function creates a new variable. 
;;; The "root" may be either a symbol or a string.
;;; *unit* defines the home module of the variable.

;;; *** Maybe it would be possible to hack this so that it doesn't
;;; *** create any symbol at all until the name is demanded by something,
;;; *** but that seems like a rather sweeping change.

(define (create-temp-var root)
  (let* ((name   (gensym (if (symbol? root) (symbol->string root) root)))
	 (module  *unit*))
    (make var (name name) (module module) (unit *unit*))))


;;; The following routines install top level definitions into the symbol
;;; table.

(predefine (signal-multiple-name-conflict name old-local-name def))
    ; in import-export/ie-errors.mumble

(define (insert-top-definition name def)
  (let ((old-definition (resolve-toplevel-name name)))
    (cond ((eq? old-definition '#f)
	   (when (not (def-prelude? def))
	       (setf (table-entry *symbol-table* name) def))
	   (when (and (var? def) (not (eq? (var-fixity def) '#f)))
             (setf (table-entry *fixity-table* name)
		   (var-fixity def)))
	   (when (and (con? def) (not (eq? (con-fixity def) '#f)))
             (setf (table-entry *fixity-table* name)
		   (con-fixity def)))
	   (when (not (def-prelude? def))
 	    (if (eq? (local-name def) '#f)
		(setf (table-entry *inverted-symbol-table* def) name)
		(signal-multiple-name-conflict name (local-name def) def))))
	  ((eq? old-definition def)
	   'OK)
	  ((supersedes-prelude-def? name def old-definition)
	   (setf (table-entry *symbol-table* name) def)
	   (when (eq? (local-name def) '#f)
	     (setf (table-entry *inverted-symbol-table* def) name)))
	  ((supersedes-prelude-def? name old-definition def)
	   'OK)
	  ;; Ix's index, range, ... (core, not exported by the Prelude): a
	  ;; module's own, or one imported from another module
	  ;; (Data.ByteString's index re-exported by Data.ByteString.Lazy)
	  ((and (def-prelude? old-definition)
		(haskell98?)
		(memq name *ix-core-names*)
		(not (def-prelude? def)))
	   (setf (table-entry *symbol-table* name) def)
	   (setf (table-entry *inverted-symbol-table* def) name))
	  ;; a Prelude class method or other core name that the module's
	  ;; import of the Prelude hides (import Prelude hiding ((*)))
	  ((and (def-prelude? old-definition)
		(haskell98?)
		(not (def-prelude? def))
		(prelude-import-hides? name))
	   (setf (table-entry *symbol-table* name) def)
	   (setf (table-entry *inverted-symbol-table* def) name))
	  ;; imported from a module defining its own (Data.Stream.Monadic's
	  ;; enumFromTo): ambiguous only where used unqualified, as GHC
	  ((and (def-prelude? old-definition)
		(haskell98?)
		(not (def-prelude? def))
		(not (eq? (def-module def) *module-name*)))
	   (install-clashing-definition name def old-definition '#t))
	  ;; the module's own definition of a core name (JHC's Doc.Chars.pi):
	  ;; as of another Prelude name, ambiguous only where used unqualified
	  ((and (def-prelude? old-definition)
		(haskell98?)
		(not (def-prelude? def))
		(eq? (def-module def) *module-name*))
	   (install-clashing-definition name def old-definition '#t))
	  ((def-prelude? old-definition)
	   (signal-core-redefinition name))
	  ((and (module-uses-standard-prelude? *module*)
		(prelude-symbol-entry name))
	   (if (haskell98?)
	       (install-clashing-definition name def old-definition '#t)
	       (if (eq? (def-module def) *module-name*)
		   (signal-prelude-redefinition name)
		   (signal-prelude-reimport name (def-module def)))))
	  ((and (eq? (def-module def) *module-name*)
		(eq? (def-module old-definition) *module-name*))
	   (signal-multiple-definition-in-module name *module-name*))
	  ((haskell98?)
	   (install-clashing-definition name def old-definition '#f))
	  ((eq? (def-module def) *module-name*)
	   (signal-multiple-definition-in-module name *module-name*))
	  ((eq? (def-module old-definition) *module-name*)
	   (signal-redefinition-by-imported-symbol name *module-name*))
	  (else
	   (signal-multiple-import name *module-name*)))))

;;; Haskell 98 (5.5.2): a name may be both defined in the module and
;;; imported, or imported from several modules as different entities;
;;; only an unqualified use is an error (an ambiguous occurrence,
;;; reported by the scope phase).  The module's own definition is kept,
;;; else the one seen first; qualified names (M.x) are unaffected.
;;; FROM-PRELUDE? when OLD comes from the implicitly imported Prelude
;;; (it is in the shared prelude table, not the module's own).

(define (install-clashing-definition name def old from-prelude?)
  (let ((keep  (if (eq? (def-module def) *module-name*) def old)))
    (when (or (eq? keep def) from-prelude?)
      (setf (table-entry *symbol-table* name) keep)
      (when (eq? (local-name keep) '#f)
	(setf (table-entry *inverted-symbol-table* keep) name)))
    (let ((lost (if (eq? keep def) old def)))
      (push (cons lost name) (table-entry *clash-losers* *module-name*)))
    (note-name-clash name
      (lisp:format lisp:nil "~A.~A or ~A.~A"
		   (if from-prelude? '|Prelude| (def-module old))
		   (clash-display-name name)
		   (import-qualifier def) (clash-display-name name)))))

;;; The module name a definition being imported is known by here: the
;;; import's `as' name or module, else its defining module.

(define (import-qualifier def)
  (let ((import  (dynamic *current-import*)))
    (if (and import (not (eq? (def-module def) *module-name*)))
	(or (import-decl-as-name import) (import-decl-module-name import))
	(def-module def))))

(define (clash-display-name name)
  (let ((s  (symbol->string name)))
    (if (and (> (string-length s) 0) (char=? (string-ref s 0) #\;))
	(substring s 1 (string-length s))
	s)))

;;; Gets the fixity of a name.

(define (get-local-fixity name)
  (table-entry *fixity-table* name))

;;; These routines support general scoping issues.  Only vars have local
;;; definitions - all other names are resolved from the global symbol table.

;;; This is used when the name must be in the top symbols.

(define (fetch-top-def name type)
  (let ((def (resolve-toplevel-name name)))
    (cond ((eq? def '#f)
	   (cond ((eq? (module-type *module*) 'interface)
		  (mlet (((mod name1) (rename-interface-symbol name)))
		    (if (eq? mod *module-name*)
			(undefined-topsym name)
			(let ((new-def (create-definition/inner
					mod name1 type)))
			  (insert-top-definition name1 new-def)
			  (cond ((algdata? new-def)
				 (setf (algdata-n-constr new-def) 0)
				 (setf (algdata-constrs new-def) '())
				 (setf (algdata-context new-def) '())
				 (setf (algdata-tyvars new-def) '())
				 (setf (algdata-classes new-def) '#f)
				 (setf (algdata-enum? new-def) '#f)
				 (setf (algdata-tuple? new-def) '#f)
				 (setf (algdata-real-tuple? new-def) '#f)
				 (setf (algdata-deriving new-def) '()))
				((class? new-def)
				 (setf (class-method-vars new-def) '())
				 (setf (class-super new-def) '())
				 (setf (class-super* new-def) '())
				 (setf (class-tyvar new-def) '|a|)
				 (setf (class-instances new-def) '())
				 (setf (class-kind new-def) 'other)
				 (setf (class-n-methods new-def) 0)
				 (setf (class-dict-size new-def) 0)
				 (setf (class-selectors new-def) '()))) 
			  new-def))))
		 (else
		  (undefined-topsym name))))
	  (else def))))

(define (undefined-topsym name)
  (signal-undefined-symbol name)
  *undefined-def*)


;;; Haskell 1.2 compiler core names that the Haskell 98 Prelude does not
;;; export: programs outside the prelude may define them (the 98 Prelude
;;; modules themselves still use the core definitions).

(define (hidden-core-name? name)
  (and (haskell98?)
       (not (module-prelude? *module*))
       (or (memq name '(|Assoc| |;:=|))
	   ;; hidden by the Prelude import and given another meaning here
	   (and (prelude-import-hides? name)
		(let ((d (table-entry *symbol-table* name)))
		  (and d (not (def-prelude? d)))))
	   ;; the Monad fail; PreludeModern's MonadFail(fail) replaces it
	   (and (eq? name '|fail|) (monadfail-fail-module?))
	   ;; the list foldr; PreludeModern's Foldable foldr replaces it
	   (and (memq name *foldable-prelude-names*) (foldable-prelude-module?)))))

;;; The Prelude's list functions that base's Prelude has over Foldable or
;;; Traversable (PreludeModern's).  In a user module under
;;; --modern-prelude, the Prelude's are left out of its implicit import
;;; (prelude-symbol-entry), and an explicit import of them gives way to
;;; PreludeModern's (insert-top-definition).

(define *foldable-prelude-names*
  '(|foldr| |foldl| |foldr1| |foldl1| |null| |length| |elem| |notElem|
    |maximum| |minimum| |sum| |product| |concat| |concatMap| |and| |or|
    |any| |all| |mapM_| |sequence_| |mapM| |sequence|))

(define (foldable-prelude-module?)
  (modern-module?))

;;; Whether DEF, PreludeModern's, replaces OLD, the Prelude's, for NAME.

;;; OLD is a list version: the Prelude's, or List's or Data.List's (which
;;; re-export the Prelude's and define foldl', find, ...).

(define (supersedes-prelude-def? name def old)
  (and (or (memq name *foldable-prelude-names*)
	   (memq name *foldable-list-names*)
	   ;; MonadFail's fail over the Haskell 98 Monad's, imported
	   ;; explicitly (import Prelude hiding (...))
	   (and (eq? name '|fail|) (monadfail-fail-module?)))
       (foldable-prelude-module?)
       (eq? (def-module def) '|PreludeModern|)
       (not (eq? (def-module old) '|PreludeModern|))
       (or (eq? old (table-entry *prelude-symbol-table* name))
	   (eq? old (table-entry *prelude-core-symbols* name))
	   (memq (def-module old) '(|List| |Data.List|)))))

;;; Data.List's own functions that base has over Foldable
;;; (Data.Foldable's, defined in PreludeModern).

(define *foldable-list-names*
  '(|foldl'| |find| |maximumBy| |minimumBy|))

;;; Modules where fail is MonadFail's (PreludeModern) rather than the
;;; Haskell 98 Monad method: user modules under --modern-prelude, and
;;; modules defining or importing it.

(define (monadfail-fail-module?)
  (or (modern-module?)
      (memq *module-name* '(|PreludeModern| |Control.Monad.Fail|))
      (lisp:some (lambda (i)
		   (memq (import-decl-module-name i)
			 '(|PreludeModern| |Control.Monad.Fail|)))
		 (module-imports *module*))))

;;; Clashing names (install-clashing-definition), by module name: an
;;; alist of the name and a description of the candidates.  The kept
;;; definition is the one found; the scope phase reports an unqualified
;;; use as ambiguous (name-clash).

(define *name-clashes* (make-table))

;;; The definitions a clash left out of the symbol table, by module name:
;;; an alist of the definition and its name.  They are still in scope
;;; (qualified), so a class or type exported with (..) keeps them
;;; (import-export/ie-utils.mumble's gather-group: ListLike's
;;; ListLikeIO(..) with putStr, which clashes with the Prelude's).

(define *clash-losers* (make-table))

(define (clash-loser-name def)
  (let ((e (assq def (table-entry *clash-losers* *module-name*))))
    (and e (cdr e))))

(define (note-name-clash name description)
  (when (not (assq name (table-entry *name-clashes* *module-name*)))
    (push (cons name description) (table-entry *name-clashes* *module-name*))))

;;; The description of a clash on NAME in the current module, or #f.

(define (name-clash name)
  (let ((entry  (assq name (table-entry *name-clashes* *module-name*))))
    (and entry (cdr entry))))

;;; Ix's methods are core names, but in Haskell 98 they are the Ix
;;; library's, not the Prelude's: a module may define its own (Data.Sequence
;;; has an index), which then shadows the core one in that module.  (Other
;;; uses, as in derived Ix instances, are the core's.)

;;; Core names that are not the Prelude's (Ix's methods, Data.Array's
;;; Array): a module may define them (Data.Primitive.Array's Array).
(define *ix-core-names* '(|index| |range| |inRange| |rangeSize| |Array|))

;;; Whether the module imports the Prelude explicitly and leaves NAME out:
;;; import Prelude hiding (name), or import Prelude (...) without it.
;;; (H98 5.6.1: then the module may define the name itself.)
(define (prelude-import-hides? name)
  (let ((imports (module-prelude-import-specs *module*)))
    (and (not (null? imports))
	 (every (lambda (i)
		  (if (eq? (car i) 'all)
		      (memq name (cdr i))
		      (not (memq name (cdr i)))))
		imports))))

;;; Recorded by init-standard-module, before the import phase consumes
;;; the import declarations.
(define (record-prelude-import-specs mod)
  (setf (module-prelude-import-specs mod)
	(map (lambda (i)
	       (cons (import-decl-mode i)
		     (map (function entity-name) (import-decl-specs i))))
	     (lisp:remove-if-not
	      (lambda (i) (and (eq? (import-decl-module-name i) '|Prelude|)
			       (not (import-decl-qualified? i))))
	      (module-imports mod)))))

(define (own-definition-shadows-core? name)
  (and (haskell98?)
       (memq name *ix-core-names*)
       ;; the module's own, or one it imports (StackSet's index)
       (let ((d  (table-entry *symbol-table* name)))
	 (and d (not (def-prelude? d))))))

;;; TemplateHaskell: in a splice's code (th/splices.mumble), a qualified
;;; name M.x not in scope here is x of module M, a global name's NameG
;;; whose module need not be imported; GHC.Internal.Types.x and the like
;;; are Yale Haskell's core x (derived/lift.mumble's th-global-name).  In
;;; a module with declaration splices this holds everywhere, as their
;;; declarations are not told apart from the module's own.

(define *th-global-names?* '#f)

;;; While a [d| |] quote's body is scoped (th/quote.mumble), the module of
;;; its declarations: a name they define is a stand-in definition of
;;; module %quoted, which the quote's code names with mkName.

(define *quote-decs-module* '#f)

(predefine (quoted-decs-def name mod))  ; in th/quote.mumble

(define (resolve-toplevel-name name)
  (or (resolve-toplevel-name-0 name)
      (and (dynamic *quote-decs-module*)
	   (quoted-decs-def name (dynamic *quote-decs-module*)))
      (and (or (dynamic *th-global-names?*)
	       ;; declaration splices' code is the module's own, and type
	       ;; splices' types are synonyms of it (th/splices.mumble)
	       (and (dynamic *module*)
		    (or (not (null? (module-decl-splices (dynamic *module*))))
			(lisp:some (lambda (s) (eq? (splice-kind s) 'type))
				   (module-splices (dynamic *module*))))))
	   (resolve-th-global-name name))))

(define (resolve-toplevel-name-0 name)
  (let ((pc (table-entry *prelude-core-symbols* name)))
    (cond ((and (not (eq? pc '#f)) (not (hidden-core-name? name))
		(not (own-definition-shadows-core? name)))
	   pc)
	  ((name-clash name)
	   (resolve-toplevel-name-1 name))
	  ((module-uses-standard-prelude? *module*)
	   (let ((res (prelude-symbol-entry name)))
	     (if (eq? res '#f)
		 (or (resolve-toplevel-name-1 name)
		     (resolve-implicit-prelude-qualified name))
		 res)))
	  (else
	   (resolve-toplevel-name-1 name)))))

;;; A name the implicitly imported Prelude exports, or #f.

(define (prelude-symbol-entry name)
  (and (not (memq name *hidden-prelude-names*))
       (not (and (memq name *not-in-2010-prelude*)
		 (or (dynamic *compiling-package?*)
		     (and (haskell2010?) (not (module-library? *module*))))))
       (not (and (memq name *foldable-prelude-names*)
		 (foldable-prelude-module?)))
       (table-entry *prelude-symbol-table* name)))

;;; Names the prelude modules define for the library but the Prelude
;;; does not give programs: base's Read methods over ReadPrec (Text.Read
;;; exports them).
(define *hidden-prelude-names*
  '(|readPrec| |readListPrec| |ReadPrec| |;MkReadPrec| |<$|))

;;; Prelude.x when the Prelude is imported implicitly: its names are not
;;; in the module's symbol table (they are looked up in the prelude
;;; tables), so the qualified form is resolved through the base name.

(define (resolve-implicit-prelude-qualified name)
  (and (feature? 'qualified-names)
       (mlet (((base mod) (split-qualified-name name)))
	 (and (eq? mod '|Prelude|)
	      ;; with the modern Prelude, Prelude.foldr is Foldable's (from
	      ;; PreludeModern, imported implicitly with the Prelude), and
	      ;; Prelude.pure, Prelude.<> ... are PreludeModern's
	      (or (and (foldable-prelude-module?)
		       (memq base *foldable-prelude-names*)
		       (prelude-modern-def base))
		  (table-entry *prelude-core-symbols* base)
		  (prelude-symbol-entry base)
		  (and (foldable-prelude-module?)
		       (prelude-modern-def base)))))))

(define (resolve-toplevel-name-1 name)
  (cond ((eq? (module-inherited-env *module*) '#f)
	 (table-entry *symbol-table* name))
	(else
	 (let ((res (search-inherited-tables
		     name (module-inherited-env *module*))))
	   (if (eq? res '#f)
	       (table-entry *symbol-table* name)
	       res)))))

(define (search-inherited-tables name mod)
  (if (eq? mod '#f)
      '#f
      (let ((res (table-entry (module-symbol-table mod) name)))
	(if (eq? res '#f)
	    (search-inherited-tables name (module-inherited-env mod))
	    res))))

;;; Con-ref's are special in that the naming convention (;Name) ensures
;;; that if a def is found it must be a con.

(define (resolve-con con-ref)
  (when (eq? (con-ref-con con-ref) *undefined-def*)
    (remember-context con-ref
      (let ((def (fetch-top-def (con-ref-name con-ref) 'con)))
	(setf (con-ref-con con-ref) def)))))

(define (resolve-class class-ref)
  (when (eq? (class-ref-class class-ref) *undefined-def*)
    (remember-context class-ref
      (let* ((def0 (cond ((eq? (class-ref-name class-ref) '|%IP|)
			  ;; ImplicitParams' ?x :: t (parser/type-parser.mumble)
			  (prelude-modern-def '|IP|))
			 ((eq? (class-ref-name class-ref) '|%QC|)
			  ;; a quantified constraint's (parser/type-parser.mumble)
			  (prelude-modern-def '|QuantifiedConstraint|))
			 ((eq? (class-ref-name class-ref) '|%TypeEq|)
			  ;; an equality's (parser/type-parser.mumble's
			  ;; apply-equalities)
			  (prelude-modern-def '|TypeEquality|))
			 (else (fetch-top-def (class-ref-name class-ref) 'class))))
	     ;; a constraint family names its class (import-export/
	     ;; top-definitions.mumble's create-constraint-family-class)
	     (def (or (and (synonym? def0) (constraint-family-class def0)) def0)))
	(when (not (class? def))
	  (signal-class-name-required def (class-ref-name class-ref)))
	(setf (class-ref-class class-ref) def)))))

(define (constraint-family-class-name name)
  (string->symbol (string-append "%cfam:" (symbol->string name))))

;;; The classes named by %class:M.C literals in types, by the name.
(define *class-literals* (make-table))

;;; The class of constraint family FAM, or #f.
(define (constraint-family-class fam)
  (and (synonym-family? fam)
       (let* ((cname (constraint-family-class-name (def-name fam)))
	      (m (table-entry *modules* (def-module fam)))
	      (c (if (eq? (def-module fam) *module-name*)
		     (table-entry *symbol-table* cname)
		     (and m (table-entry (module-symbol-table m) cname)))))
	 (and (class? c) c))))

;;; The family of a constraint family's class, or #f.
(define (class-constraint-family class)
  (let ((s (symbol->string (def-name class))))
    (and (string-starts? "%cfam:" s)
	 (let* ((name (string->symbol (substring s 6 (string-length s))))
		(m (table-entry *modules* (def-module class)))
		(f (if (eq? (def-module class) *module-name*)
		       (table-entry *symbol-table* name)
		       (and m (table-entry (module-symbol-table m) name)))))
	   (and (synonym? f) f)))))


(define (resolve-tycon tycon)
  (when (eq? (tycon-name tycon) '|%type-op-chain|)
    (reassociate-type-chain! tycon))
  (when (eq? (tycon-def tycon) *undefined-def*)
    (remember-context tycon
      (let ((def (or (promoted-tycon-def (tycon-name tycon))
		     (fetch-top-def (tycon-name tycon) 'algdata))))
	(cond ((and (class? def) (haskell98?) (null? (tycon-args tycon)))
	       ;; ConstraintKinds: a class as a type argument (generic-data's
	       ;; AssertNoSum Semigroup a): a type-level literal of its name
	       ;; (parser/type-parser.mumble's type-literal-char), so that a
	       ;; class is one type wherever it is named
	       (let ((name (format '#f "%class:~A.~A" (def-module def) (def-name def))))
		 ;; (the class it names: type/mp-classes.mumble's
		 ;; class-literal-class)
		 (setf (table-entry *class-literals* (string->symbol name)) def)
		 (setf (tycon-def tycon) (core-symbol "TypeSymbol"))
		 (setf (tycon-args tycon)
		       (list (promoted-list (map (function type-literal-char)
						 (string->list name)))))))
	      ((class? def)
	       (signal-tycon-name-required (tycon-name tycon)))
	      (else
	       (setf (tycon-def tycon) def)))))))


;;; TypeOperators: a chain t0 op1 t1 op2 t2 .. (parser/type-parser.mumble)
;;; becomes the applications its operators' fixities give, the fixity of a
;;; constructor operator being its data constructor's (infixr 1 :* in
;;; aeson), else infixl 9.  CHAIN is changed in place into the outermost.

(define (reassociate-type-chain! chain)
  (let* ((operands '())
	 (ops '())
	 (items (tycon-args chain))
	 (reduce-top!
	  (lambda ()
	    (let* ((op (car ops))
		   (r (car operands))
		   (l (cadr operands)))
	      (setf ops (cdr ops))
	      (setf operands
		    (cons (make tycon (name (tycon-name op)) (def *undefined-def*)
				(args (list l r)))
			  (cddr operands)))))))
    (setf operands (list (car items)))
    (do ((rest (cdr items) (cddr rest)))
	((null? rest))
      (let* ((op (car rest))
	     (f (type-operator-fixity (tycon-name op))))
	(do () ((or (null? ops)
		    (let ((g (type-operator-fixity (tycon-name (car ops)))))
		      (not (or (> (fixity-precedence g) (fixity-precedence f))
			       (and (eqv? (fixity-precedence g) (fixity-precedence f))
				    (not (eq? (fixity-associativity f) 'r))))))))
	  (funcall reduce-top!))
	(setf ops (cons op ops))
	(setf operands (cons (cadr rest) operands))))
    (do () ((null? ops)) (funcall reduce-top!))
    (let ((top (car operands)))
      (setf (tycon-name chain) (tycon-name top))
      (setf (tycon-def chain) (tycon-def top))
      (setf (tycon-args chain) (tycon-args top)))))

(define (type-operator-fixity name)
  (let* ((con-name (add-con-prefix/symbol name))
	 (tdef (resolve-toplevel-name name))
	 (local (or (get-local-fixity name)
		    (and (or (algdata? tdef) (synonym? tdef)) (tycon-def-fixity tdef))
		    (get-local-fixity con-name)))
	 (con (and (not local) (resolve-toplevel-name con-name))))
    (or local
	(and (con? con) (con-fixity con))
	(make fixity (associativity 'l) (precedence 9)))))

;;; DataKinds: a type named K ('K, or K where no type is named K) that a
;;; data constructor in scope is named: K's promoted type, 'K of the
;;; constructor's module (import-export/top-definitions.mumble); else #f.
(define (promoted-tycon-def name)
  (and (haskell98?)
       (eq? (resolve-toplevel-name name) '#f)
       (let* ((s    (symbol->string name))
	      (base (if (and (> (string-length s) 1) (char=? (string-ref s 0) #\'))
			(substring s 1 (string-length s))
			s))
	      (con  (resolve-toplevel-name (add-con-prefix/symbol (string->symbol base)))))
	 (and (con? con)
	      (let ((pname (string->symbol (string-append "'" base))))
		(if (eq? (def-module con) *module-name*)
		    (resolve-toplevel-name pname)
		    ;; (a core constructor's, True's, is PreludeCore's)
		    (lisp:some (lambda (mod)
				 (let ((m (table-entry *modules* mod)))
				   (and m
					(let ((d (table-entry (module-symbol-table m) pname)))
					  (and (algdata? d) d)))))
			       (list (def-module con) '|PreludeCore|))))))))

;;; This should be used after the local environment has been searched.
;;; Other routines dealing with variable scoping are elsewhere.

(define (resolve-var var-ref)
  (when (eq? (var-ref-var var-ref) *undefined-def*)
    (remember-context var-ref
      (let ((def (fetch-top-def (var-ref-name var-ref) 'var)))
	(setf (var-ref-var var-ref) def)))))


;;; *** The inverted-symbol-table is the only table in the whole
;;; *** system that is not keyed off of symbols.  If this is a problem,
;;; *** things that use it could probably be rewritten to do something
;;; *** else, like store an a-list on the def itself.

;;; This does not need to consult the inherited-env flag because when this
;;; is used in extensions only new symbols get inserted.

(define (local-name def)
  (cond ((def-prelude? def)
	 (def-name def))
	((module-uses-standard-prelude? *module*)
	 (let ((res (table-entry *prelude-inverted-symbol-table* def)))
	   ;; a Prelude name this module does not see (catch in Haskell
	   ;; 2010, prelude-symbol-entry) is no name for it here
	   (when (and (not (eq? res '#f))
		      (not (eq? (prelude-symbol-entry res) def)))
	     (setf res '#f))
	   (if (eq? res '#f)
	    (table-entry *inverted-symbol-table* def)
	    res)))
	(else
	 (table-entry *inverted-symbol-table* def))))
    
(define (print-name x)
  (let ((res (local-name x)))
    (if (eq? res '#f)
	(def-name x)
	res)))


;;; Error signalling routines.

(define (signal-module-double-definition name)
  (fatal-error 'module-double-definition
    "Module ~s is defined more than once."
    name))

(define (signal-module-already-defined name)
  (fatal-error 'module-already-defined
    "Module ~a is defined more than once in the current unit."
    name))

(define (signal-multiple-definition-in-module name modname)
 (if (eq? (module-type *module*) 'extension)
     (phase-error 'cant-redefine-in-extension
        "An extension for module ~A cannot redefine the symbol ~A"
	modname name)
     (phase-error 'multiple-definition-in-module
        "There is more than one definition for the name ~a in module ~a."
	name modname)))

(define (signal-redefinition-by-imported-symbol name modname)
  (phase-error 'redefinition-by-imported-symbol
    "The name ~a is defined in module ~a, and cannot be imported."
    name modname))

(define (signal-core-redefinition name)
  (phase-error 'prelude-redefinition
    "The name ~a is defined in the prelude core and cannot be redefined."
    name))

(define (signal-prelude-redefinition name)
  (phase-error 'prelude-redefinition
    "The name ~a is defined in the prelude.~%You must hide it if you wish to use this name."
    name))

(define (signal-prelude-reimport name modname)
  (phase-error 'prelude-redefinition
    "The name ~a is both imported from ~A and defined in the prelude.~%"
    name modname))

(define (signal-multiple-import name modname)
  (phase-error 'multiple-import
    "The name ~a is imported into module ~a multiple times."
    name modname))

(define (signal-undefined-symbol name)
  (phase-error 'undefined-symbol
    "The name ~A is undefined."
    name))

(define (signal-class-name-required name def)
  (phase-error 'class-name-required
    "The name ~A defines a ~A, but a class name is required."
    name
    (if (synonym? def) "synonym" "data type")))

(define (signal-tycon-name-required name)
  (phase-error 'tycon-required
    "The name ~A defines a class, but a type constructor name is required."
    name))
