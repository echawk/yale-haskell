;;; These are global variables used throughout the compiler.

;;; Configuration stuff

(define *prelude-unit-filename* "$PRELUDE/Prelude.hu")

(define *haskell-compiler-version* "Y2.0.6")
(define *haskell-compiler-update* "")


;;; Control over the init process
(define *haskell-initialized?* '#f)

;;; Error control
(define *break-on-error?* '#f)
(define *never-break?* '#f)

(define *runtime-abort* '())

(define *recoverable-error-handler* '())
(define *error-output-port* '())  ; initialized later

(define *context* '#f)  ; ast node being compiled.

(define *unit* '())

(define *standard-module-default* '())

(define *undefined-def* '())
(define *printer-class* '())
(define *printers* '(phase-time))

(define *all-printers*
  '(phase-time time compiling loading reading extension
    parse import type-decl scope depend
    type cfn depend2
    flic optimize optimize-extra strictness grin codegen codegen-flic
    dumper dump-stat))

;;; The back end: FLIC (backend/codegen.mumble) generates Lisp from
;;; FLIC; GRIN (grin/) lowers FLIC to LGRIN and generates Lisp from that
;;; (doc/EVAL-APPLY-GRIN.md).  $YALE_HASKELL_BACKEND, if set to flic or
;;; grin, overrides it.

(define *backend* 'grin)

(define (current-backend)
  (let ((env  (getenv "YALE_HASKELL_BACKEND")))
    (cond ((and env (string=? env "grin")) 'grin)
	  ((and env (string=? env "flic")) 'flic)
	  (else (dynamic *backend*)))))

;;; The import declaration being processed (dynamically bound by the
;;; import-export phase), for its `qualified' and `as' parts.

(define *current-import* '#f)

;;; Global context stuff 
;;; ***This variable is actually only used by the parser.

(define *current-file* '())

(define *printed-tyvars* '())


;;; Used by the symbol table routines

(define *modules* '())  ; maps module name -> module structure
(define *module* '())   ; current module
(define *module-name* '())
(define *symbol-table* '())  ; part of the current module
(define *inverted-symbol-table* '())  ; maps def -> localname
(define *fixity-table* '())  ; name -> fixity
(define *suffix-table* '())  ; name -> int (for uniquifying names)

(define *special-parse-for-type-macros* '#f)

;;; These are for diagnostic purposes only

(define *big-let* '())

(define *show-end-of-phase* '#f)

;;; True when running a program from the command line (see
;;; tools/build/image.lisp): no REPL, diagnostics on stderr.
(define *haskell-batch-mode* '#f)

;;; This is used to configure error messages & responses.

(define *emacs-mode* '#f)

;;; This is used to stash the Prelude symbol environment

(define *prelude-symbol-table* '())
(define *prelude-fixity-table* '())
(define *prelude-inverted-symbol-table* '())


;;; The language dialect, one of *dialect-order*.  The compiler is shared
;;; by all dialects; each saved image has one dialect, taken from $PRELUDE
;;; (the Makefile and bin/yale-haskell point that at lib/<dialect>/prelude).
;;; The prelude build and the saved image both load the compiler with it
;;; set, so each dialect's image keeps its own value.
;;;
;;; Code that differs between dialects asks about a *feature*, not the
;;; dialect: (feature? 'do-notation).  A dialect is an element of the
;;; ordered list below; a feature holds from its first dialect to its last
;;; (#f = the last one).  A new dialect is a new column, not a hunt
;;; through the source.

(define *dialect-order* '(haskell-1.2 haskell-1.3 haskell-1.4 haskell98))

(define *dialect-features*
  '(;; syntax and the type system
    (constructor-classes haskell-1.3 #f)
    (do-notation         haskell-1.3 #f)
    (newtype             haskell-1.3 #f)
    (show-read           haskell-1.3 #f)  ; Show and Read instead of Text
    (show-method         haskell98 #f)   ; `show' is a method of Show
    (monad-fail          haskell98 #f)   ; else MonadZero(zero)
    ;; lexical differences of Haskell 98
    (h98-lexing          haskell98 #f)
    (headerless-main     haskell98 #f)
    (fixity-anywhere     haskell98 #f)
    ;; monomorphism restriction rule 2: an exported restricted (pattern)
    ;; binding is allowed but not generalised (H98 4.5.5); 1.2 rejects it.
    (mr2-export          haskell98 #f)
    ;; field labels: declaration, construction, update, patterns
    (records             haskell-1.3 #f)
    ;; M.x names, import qualified ... as ...
    (qualified-names     haskell-1.3 #f)))

(define (dialect-from-environment)
  (let ((p (getenv "PRELUDE")))
    (cond ((not (string? p)) 'haskell-1.2)
	  ((string-contains? p "haskell98") 'haskell98)
	  ((string-contains? p "haskell-1.4") 'haskell-1.4)
	  ((string-contains? p "haskell-1.3") 'haskell-1.3)
	  (else 'haskell-1.2))))

(define (string-contains? s sub)
  (let ((n (string-length s))
	(m (string-length sub)))
    (do ((i 0 (1+ i))
	 (found? '#f))
	((or found? (> (+ i m) n)) found?)
      (when (string=? (substring s i (+ i m)) sub)
	(setf found? '#t)))))

(define *haskell-dialect* (dialect-from-environment))

(define (dialect-index d)
  (let ((tail (memq d *dialect-order*)))
    (- (length *dialect-order*) (length tail))))

(define (dialect>=? d)
  (>= (dialect-index *haskell-dialect*) (dialect-index d)))

(define (feature? name)
  (let ((entry (assq name *dialect-features*)))
    (when (eq? entry '#f)
      (error "Unknown dialect feature ~A" name))
    (and (dialect>=? (cadr entry))
	 (or (eq? (caddr entry) '#f)
	     (<= (dialect-index *haskell-dialect*)
		 (dialect-index (caddr entry)))))))

(define (haskell98?)
  (eq? *haskell-dialect* 'haskell98))

;;; Haskell 2010 mode (yale-haskell --haskell2010, YALE_HASKELL_2010=1):
;;; the Haskell 98 dialect with the 2010 Report's changes that would
;;; break Haskell 98 programs.  So far: the Prelude does not export
;;; catch (*not-in-2010-prelude*; use System.IO.Error.catchIOError or
;;; Control.Exception.catch).

(define *haskell2010?* '#f)

(define (haskell2010?)
  (and (haskell98?)
       (or (dynamic *haskell2010?*)
	   (env-flag? "YALE_HASKELL_2010")
	   (modern-prelude?))))

;;; The modern Prelude (yale-haskell --modern-prelude,
;;; YALE_HASKELL_MODERN=1): Haskell 2010 mode, and every module also
;;; imports PreludeModern (lib/haskell98/PreludeModern.hs) implicitly --
;;; the names GHC's base Prelude adds: Applicative, Alternative,
;;; MonadFail (whose fail replaces the Prelude's), Semigroup, Monoid,
;;; <$>.  doc/plans/MICROCABAL.md, step 2.

(define *modern-prelude?* '#f)

(define (modern-prelude?)
  (and (haskell98?)
       (or (dynamic *modern-prelude?*) (env-flag? "YALE_HASKELL_MODERN"))))

;;; Library modules are compiled the same in every mode, so that their
;;; compiled units can be shared.  *compiling-library?* is bound while a
;;; library unit compiles (locally-compile).

(define *compiling-library?* '#f)

(define (library-source-file? file)
  (and (string? file)
       (or (string-starts? "$HASKELL_LIBRARY/" file)
	   (string-starts? "$PRELUDE/" file))))

(define (env-flag? name)
  (let ((env  (getenv name)))
    (and env (not (string=? env "")) (not (string=? env "0")))))

(define *not-in-2010-prelude* '(|catch|))
