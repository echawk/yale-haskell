;;; top.mumble -- compilation unit definition for the top level

;;; Global includes the ast definitions and all global data structures
;;; used in the compiler.

(define-compilation-unit global
  (source-filename "$Y2/src/compiler/top/")
  (require ast)
  (unit has-utils
    (source-filename "has-utils.mumble"))
  (unit core-definitions
    (require has-utils)
    (source-filename "core-definitions.mumble"))
  (unit core-symbols
    (require core-definitions)
    (source-filename "core-symbols.mumble"))
  (unit core-init
    (require core-symbols)
    (source-filename "core-init.mumble"))
  (unit globals
    (require core-init)
    (source-filename "globals.mumble"))
  (unit has-macros
    (source-filename "has-macros.mumble"))
  )


;;; These files do not need to be required by other units  

(define-compilation-unit top-level
  (source-filename "$Y2/src/compiler/top/")
  (require global)
  (unit phases
    (source-filename "phases.mumble"))
  (unit system-init
    (source-filename "system-init.mumble"))
  (unit errors
    (source-filename "errors.mumble"))
  (unit tuple
    (source-filename "tuple.mumble"))
  (unit symbol-table
    (source-filename "symbol-table.mumble"))
  )
     


