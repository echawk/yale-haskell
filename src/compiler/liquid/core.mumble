;;; core.mumble -- refinement type checking (doc/plans/LIQUID-HASKELL.md,
;;; milestone 2): --liquid checks each module's top-level functions against
;;; the refined signatures in its {-@ ... @-} comments.
;;;
;;; After cfn and the typed core (typed/retype.mumble), each top-level
;;; binding is converted to yale-liquid's small language (the grammar is in
;;; src/liquid/check.lisp): parameters, Int and Bool arithmetic and
;;; comparisons (the Int, Integer and Char instances' methods, which the
;;; type checker has already chosen), calls of the module's functions, if
;;; and let; anything else is (:unknown SORT), some value of its type.
;;; yale-liquid (a plain Common Lisp system in the image) parses the
;;; specifications and asks Z3 about each obligation; an unproved one is
;;; a compile error at its line.  yale-liquid's functions are called by
;;; name, as it is loaded after the compiler.

(define (liquid-call name . args)
  (lisp:apply (lisp:symbol-function (lisp:find-symbol name "YALE-LIQUID")) args))

(define (liquid-check-modules big-let)
  (let* ((decls (liquid-top-decls big-let))
	 (file (liquid-source-file decls)))
    (when (env-flag? "YALE_HASKELL_LIQUID_DEBUG")
      (lisp:format lisp:*error-output* "~&liquid: ~A bindings, file ~A, top ~A~%"
		   (length decls) file (lisp:type-of big-let)))
    (when (and file (file-exists? file))
      (let ((text (read-file-text file)))
	(when (lisp:search "{-@" text)
	  (mlet (((specs errors) (liquid-call "PARSE-SPEC-TEXT" text)))
	    (dolist (e errors)
	      (liquid-report file 1 (lisp:format lisp:nil "~A" e)))
	    (let* ((names (map (lambda (d) (def-name (var-ref-var (var-pat-var (valdef-lhs d)))))
			       decls))
		   (program (lisp:remove '#f (map (lambda (d) (liquid-binding d names)) decls)))
		   (failures (begin
			       ;; YALE_HASKELL_LIQUID_DEBUG=1: what is checked
			       (when (env-flag? "YALE_HASKELL_LIQUID_DEBUG")
				 (lisp:format lisp:*error-output* "~&~S~%~S~%" specs program))
			       (liquid-call "CHECK-PROGRAM" program specs))))
	      (dolist (f failures)
		(liquid-report file (liquid-call "FAILURE-LINE" f)
			       (liquid-call "FAILURE-MESSAGE" f)))
	      (when (or (not (null? failures)) (not (null? errors)))
		(abort-compilation)))))))
    big-let))

;;; The top-level bindings v = e (cfn's output is a let of them, some in
;;; recursive groups).
(define (liquid-top-decls big-let)
  (let ((result '()))
    (when (is-type? 'let big-let)
      (dolist (d (let-decls big-let))
	(dolist (d1 (if (is-type? 'recursive-decl-group d)
			(recursive-decl-group-decls d)
			(list d)))
	  (when (and (valdef? d1) (var-pat? (valdef-lhs d1)))
	    (push d1 result)))))
    (reverse result)))

;;; The file of the first source position in the bindings (cfn's top-level
;;; valdefs themselves have none).
(define (liquid-source-file decls)
  (let ((sp (lisp:some (function liquid-find-file) decls)))
    (and sp (source-pointer-file sp))))

;;; The first source position in X (a binding or an expression), or #f.
(define (liquid-find-file x)
  (cond ((and (lisp:typep x 'ast-node)
	      (is-type? 'source-pointer (ast-node-line-number x)))
	 (ast-node-line-number x))
	((valdef? x)
	 (lisp:some (lambda (sfd)
		      (lisp:some (lambda (g) (liquid-find-file (guarded-rhs-rhs g)))
				 (single-fun-def-rhs-list sfd)))
		    (valdef-definitions x)))
	((app? x) (or (liquid-find-file (app-fn x)) (liquid-find-file (app-arg x))))
	((is-type? 'lambda x) (liquid-find-file (lambda-body x)))
	((is-type? 'if x) (or (liquid-find-file (if-test-exp x))
			      (liquid-find-file (if-then-exp x))
			      (liquid-find-file (if-else-exp x))))
	((is-type? 'let x) (or (lisp:some (function liquid-find-file) (let-decls x))
			       (liquid-find-file (let-body x))))
	((is-type? 'case-block x) (lisp:some (function liquid-find-file) (case-block-exps x)))
	((is-type? 'and-exp x) (lisp:some (function liquid-find-file) (and-exp-exps x)))
	((is-type? 'return-from x) (liquid-find-file (return-from-exp x)))
	(else '#f)))

(define (liquid-report file line message)
  (let ((node (**var '|liquid|)))
    (setf (ast-node-line-number node)
	  (make source-pointer (line (if (integer? line) line 1)) (file file)))
    (remember-context node
      (phase-error 'liquid-unsafe "Refinement type error: ~A" message))))

(define (liquid-line ast)
  (let ((sp (ast-node-line-number ast)))
    (if (is-type? 'source-pointer sp) (source-pointer-line sp) '#f)))

;;; A binding: (NAME (PARAM ...) BODY LINE (SORT ...) SORT), or #f.

(define (liquid-binding d names)
  (liquid-fun d names '()))

;;; A function binding D, inside the scope of LOCALS.
(define (liquid-fun d names locals)
  (let* ((var (var-ref-var (var-pat-var (valdef-lhs d))))
	 (rhs (liquid-valdef-rhs d))
	 (params '()))
    (do () ((not (is-type? 'lambda rhs)))
      (dolist (p (lambda-pats rhs))
	(push (if (var-pat? p) (var-pat-var p) '#f) params))
      (setf rhs (lambda-body rhs)))
    (if (memq '#f params)
	'#f
	(let* ((params (map (function var-ref-var) (reverse params)))
	       (sp (liquid-find-file d)))
	  (list (symbol->string (def-name var))
		(map (function liquid-var-name) params)
		(liquid-exp rhs names (append params locals))
		(if sp (source-pointer-line sp) 1)
		(map (lambda (p) (liquid-sort (var-type p))) params)
		(liquid-exp-sort rhs))))))

(define (liquid-valdef-rhs d)
  (guarded-rhs-rhs (car (single-fun-def-rhs-list (car (valdef-definitions d))))))

(define (liquid-var-name def)
  (symbol->string (def-name def)))

;;; The sort of a type: :int, :bool, :list or #f.
(define (liquid-sort type)
  (let ((ty (cond ((gtype? type) (gtype-type type))
		  (else type))))
    (when ty (setf ty (prune ty)))
    (cond ((not (ntycon? ty)) '#f)
	  ((memq (ntycon-tycon ty)
		 (list (core-symbol "Int") (core-symbol "Integer") (core-symbol "Char")))
	   ':int)
	  ((eq? (ntycon-tycon ty) (core-symbol "Bool")) ':bool)
	  ((eq? (ntycon-tycon ty) (core-symbol "List")) ':list)
	  (else '#f))))

(define (liquid-exp-sort e)
  (liquid-sort (or (exp-core-type e) (exp-inferred-type e))))

;;; The instance methods and Prelude functions that are logic operators:
;;; (name . op); a method's name is i-Class-Type-name.
(define *liquid-ops*
  '(("+" . :+) ("-" . :-) ("*" . :*) ("negate" . :neg)
    ("<" . :<) ("<=" . :<=) (">" . :>) (">=" . :>=) ("==" . :=) ("/=" . :/=)
    ("div" . :div) ("mod" . :mod) ("quot" . :div) ("rem" . :mod)))

(define (liquid-op def nargs)
  (let ((s (symbol->string (def-name def))))
    (cond ((and (string=? s "&&") (eqv? nargs 2)) ':and)
	  ((and (string=? s "||") (eqv? nargs 2)) ':or)
	  ((and (string=? s "not") (eqv? nargs 1)) ':not)
	  (else
	   (let ((op (liquid-method-op s)))
	     (and op
		  (eqv? nargs (if (eq? (cdr op) ':neg) 1 2))
		  (cdr op)))))))

;;; i-Num-Int-+ -> ("+" . :+), for the Int, Integer, Char and Bool instances
(define (liquid-method-op s)
  (lisp:some (lambda (ty)
	       (lisp:some (lambda (cls)
			    (let ((prefix (string-append "i-" cls "-" ty "-")))
			      (and (string-starts? prefix s)
				   (assoc (substring s (string-length prefix) (string-length s))
					  *liquid-ops*))))
			  '("Num" "Ord" "Eq" "Integral")))
	     '("Int" "Integer" "Char" "Bool")))

(define (liquid-fromInteger? def)
  (let ((s (symbol->string (def-name def))))
    (or (string=? s "i-Num-Int-fromInteger")
	(string=? s "i-Num-Integer-fromInteger"))))

(define (liquid-exp e names locals)
  (let ((line (liquid-line e))
	(core (liquid-exp-1 e names locals)))
    (if (and line (memq (car core) '(:call :prim :if)))
	(list ':at line core)
	core)))

(define (liquid-exp-1 e names locals)
  (let ((sort (liquid-exp-sort e)))
    (cond ((integer-const? e) (list ':int (integer-const-value e)))
	  ((char-const? e) (list ':int (char->integer (char-const-value e))))
	  ((con-ref? e)
	   (cond ((eq? (con-ref-con e) (core-symbol "True")) (list ':bool '#t))
		 ((eq? (con-ref-con e) (core-symbol "False")) (list ':bool '#f))
		 ((eq? (con-ref-con e) (core-symbol "Nil")) (list ':nil))
		 (else (list ':unknown sort))))
	  ((var-ref? e)
	   (let ((def (var-ref-var e)))
	     (cond ((memq def locals) (list ':var (liquid-var-name def)))
		   ((liquid-callee def names)
		    (list ':call (liquid-callee def names) sort))
		   (else (list ':unknown sort)))))
	  ((app? e)
	   (let ((args '())
		 (fn e))
	     (do () ((not (app? fn)))
	       (push (app-arg fn) args)
	       (setf fn (app-fn fn)))
	     (cond
	       ((and (con-ref? fn) (eq? (con-ref-con fn) (core-symbol ":"))
		     (eqv? (length args) 2))
		(list ':cons (liquid-exp (car args) names locals)
		      (liquid-exp (cadr args) names locals)))
	       ((not (var-ref? fn))
		(list ':unknown sort))
	       (else
		(let* ((def (var-ref-var fn))
		       (op (liquid-op def (length args))))
		  (cond ((and (liquid-fromInteger? def) (eqv? (length args) 1)
			      (integer-const? (car args)))
			 (list ':int (integer-const-value (car args))))
			(op (cons ':prim
				  (cons op (map (lambda (a) (liquid-exp a names locals)) args))))
			((and (not (memq def locals)) (liquid-callee def names))
			 (cons ':call
			       (cons (liquid-callee def names)
				     (cons sort
					   (map (lambda (a) (liquid-exp a names locals)) args)))))
			(else (list ':unknown sort))))))))
	  ((is-type? 'if e)
	   (list ':if sort
		 (liquid-exp (if-test-exp e) names locals)
		 (liquid-exp (if-then-exp e) names locals)
		 (liquid-exp (if-else-exp e) names locals)))
	  ;; pattern matching on lists (cfn's case-block)
	  ((is-type? 'case-block e)
	   (liquid-case-block (case-block-exps e) sort names locals))
	  ((is-type? 'return-from e)
	   (liquid-exp (return-from-exp e) names locals))
	  ((is-type? 'is-constructor e)
	   (let ((con (is-constructor-constructor e)))
	     (cond ((eq? con (core-symbol ":"))
		    (list ':is ":" (liquid-exp (is-constructor-value e) names locals)))
		   ((eq? con (core-symbol "Nil"))
		    (list ':is "[]" (liquid-exp (is-constructor-value e) names locals)))
		   (else (list ':unknown sort)))))
	  ((and (is-type? 'sel e) (eq? (sel-constructor e) (core-symbol ":"))
		(eqv? (sel-slot e) 1))
	   (list ':tail (liquid-exp (sel-value e) names locals)))
	  ;; value bindings, in order
	  ((and (is-type? 'let e)
		(every (lambda (d)
			 (and (valdef? d)
			      (var-pat? (valdef-lhs d))
			      (not (is-type? 'lambda (liquid-valdef-rhs d)))))
		       (let-decls e)))
	   (liquid-lets (let-decls e) (let-body e) names locals))
	  ;; local functions, possibly recursive
	  ((and (is-type? 'let e) (liquid-local-funs (let-decls e)))
	   (let* ((ds (liquid-local-funs (let-decls e)))
		  (names (append (map (lambda (d) (def-name (var-ref-var (var-pat-var (valdef-lhs d)))))
				      ds)
				 names))
		  (funs (map (lambda (d) (liquid-fun d names locals)) ds)))
	     (if (memq '#f funs)
		 (list ':unknown sort)
		 (list ':letrec funs (liquid-exp (let-body e) names locals)))))
	  (else (list ':unknown sort)))))

(define (liquid-lets decls body names locals)
  (if (null? decls)
      (liquid-exp body names locals)
      (let* ((d (car decls))
	     (def (var-ref-var (var-pat-var (valdef-lhs d)))))
	(list ':let (liquid-var-name def) (liquid-sort (var-type def))
	      (liquid-exp (liquid-valdef-rhs d) names locals)
	      (liquid-lets (cdr decls) body names (cons def locals))))))

;;; A case-block's alternatives as nested ifs: an (and TEST .. BODY) is
;;; tried in turn, anything else ends the block.
(define (liquid-case-block exps sort names locals)
  (cond ((null? exps) (list ':unknown sort))
	((and (is-type? 'and-exp (car exps))
	      (not (null? (and-exp-exps (car exps)))))
	 (let* ((parts (and-exp-exps (car exps)))
		(tests (lisp:butlast parts))
		(test (if (null? tests)
			  (list ':bool '#t)
			  (lisp:reduce (lambda (a b) (list ':prim ':and a b))
				       (map (lambda (x) (liquid-exp x names locals)) tests)))))
	   (list ':if sort test
		 (liquid-exp (car (lisp:last parts)) names locals)
		 (liquid-case-block (cdr exps) sort names locals))))
	(else (liquid-exp (car exps) names locals))))

;;; The name a call of DEF is checked under: the module's own functions,
;;; and the Prelude's list functions, whose specifications are
;;; yale-liquid's *library-specs*, under Prelude.NAME.
(define *liquid-library-functions*
  '("head" "tail" "!!" "length" "++" "take" "drop" "replicate" "map"
    "null" "reverse" "filter"))

(define (liquid-callee def names)
  (let ((s (symbol->string (def-name def))))
    (cond ((memq (def-name def) names) s)
	  ((and (def-module def)
		(string-starts? "Prelude" (symbol->string (def-module def)))
		(member s *liquid-library-functions*))
	   (string-append "Prelude." s))
	  (else '#f))))

;;; The bindings of DECLS if they are all functions v = \x ... -> e, else #f.
(define (liquid-local-funs decls)
  (let ((ds '()))
    (dolist (d decls)
      (dolist (d1 (if (is-type? 'recursive-decl-group d)
		      (recursive-decl-group-decls d)
		      (list d)))
	(if (and (valdef? d1) (var-pat? (valdef-lhs d1))
		 (is-type? 'lambda (liquid-valdef-rhs d1)))
	    (push d1 ds)
	    (return-from liquid-local-funs '#f))))
    (reverse ds)))
