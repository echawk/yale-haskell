
;;; The `prune' function removes instantiated type variables at the
;;; top level of a type.

;;; It returns an uninstantiated type variable or a type constructor.

(define-integrable (prune ntype)
  (cond ((ntyvar? ntype)
	 (if (instantiated? ntype)
	     (prune-1 (ntyvar-value ntype))
	     ntype))
	((ntyapp? ntype)
	 (prune-app ntype))
	(else ntype)))

;;; An application whose function has been instantiated is normalized: a
;;; tycon takes the arguments, an application of an application is
;;; flattened.

(define (prune-app type)
  (let ((fun (prune (ntyapp-fun type))))
    (if (eq? fun (ntyapp-fun type))
	type
	(apply-ntype fun (ntyapp-args type)))))

(define (apply-ntype fun args)
  (cond ((null? args) fun)
	((ntycon? fun)
	 (**ntycon (ntycon-tycon fun) (append (ntycon-args fun) args)))
	((ntyapp? fun)
	 (**ntyapp (ntyapp-fun fun) (append (ntyapp-args fun) args)))
	(else (**ntyapp fun args))))

;;; This is because lucid can't hack inlining recursive fns.

(define (prune-1 x) (prune x))

(define-integrable (instantiated? ntyvar)
  (ntyvar-value ntyvar))
;  (not (eq? (ntyvar-value ntyvar) '#f)))  ;*** Lucid compiler bug?

(define (prune/l l)
  (map (function prune) l))


;;; These functions convert between AST types and gtypes.  Care is taken to
;;; ensure that the gtyvars are in the same order that they appear in the
;;; context.  This is needed to make dictionary conversion work right.

(define (ast->gtype context type . maybe-mcontext)
  (let ((mcontext  (if (null? maybe-mcontext) '() (car maybe-mcontext)))
	;; tyvars to number first (a one-parameter class's method: its
	;; class's, the carrier, before its own constraints' tyvars)
	(first     (if (or (null? maybe-mcontext) (null? (cdr maybe-mcontext)))
		       '()
		       (cadr maybe-mcontext))))
    ;; the tyvars of multi-parameter constraints come first, so that a
    ;; multi-parameter class's own tyvars are gtyvars 0, 1, ...
    (mlet ((env0 (mcontext-env mcontext
			       (if (null? first)
				   '()
				   (mlet (((_ e) (type->gtype/l (map (function **tyvar) first) '())))
				     e))))
	   ((gcontext env) (context->gcontext context '() env0))
	   ((type env1) (type->gtype type env))
	   (gcontext-classes (arrange-gtype-classes env1 gcontext))
	   (gtype (**gtype gcontext-classes type)))
      (setf (gtype-mcontext gtype) (mcontext->gmcontext mcontext env1))
      (setf (gtype-tyvar-names gtype)
	    (map (lambda (i)
		   (tuple-2-1 (lisp:find i env1 :key (function tuple-2-2))))
		 (gtype-index-list (length env1))))
      gtype)))

(define (gtype-index-list n)
  (let ((l '()))
    (dotimes (i n) (push (- n 1 i) l))
    l))

(define (signature->gtype signature)
  ;; an explicit forall's order is its variables' (TypeApplications:
  ;; sub @t with sub :: forall a b. (Coercible b a, ..) => b -> b)
  (let ((g (if (null? (signature-foralls signature))
	       (ast->gtype (signature-context signature)
			   (signature-type signature)
			   (signature-mcontext signature))
	       (ast->gtype (signature-context signature)
			   (signature-type signature)
			   (signature-mcontext signature)
			   (signature-foralls signature)))))
    (setf (gtype-scoped g) (signature-foralls signature))
    g))

(define (mcontext-env mcontext env)
  (if (null? mcontext)
      env
      (mlet (((_ env1) (type->gtype/l (mp-context-types (car mcontext)) env)))
	(mcontext-env (cdr mcontext) env1))))

;;; Also returning the environment, with any tyvars they add.
(define (mcontext->gmcontext/env mcontext env)
  (if (null? mcontext)
      (values '() env)
      (mlet (((gtypes env1) (type->gtype/l (mp-context-types (car mcontext)) env))
	     ((rest env2) (mcontext->gmcontext/env (cdr mcontext) env1)))
	(values (cons (tuple (class-ref-class (mp-context-class (car mcontext))) gtypes)
		      rest)
		env2))))

;;; Multi-parameter constraints as (class . gtypes); ENV has their tyvars.
(define (mcontext->gmcontext mcontext env)
  (map (lambda (c)
	 (mlet (((gtypes _) (type->gtype/l (mp-context-types c) env)))
	   (tuple (class-ref-class (mp-context-class c)) gtypes)))
       mcontext))

;;; This is similar except that the ordering of the tyvars is as defined in
;;; the data type.  This is used only for instance declarations and allows
;;; for simple context implication checks.  It also used by the signature
;;; of the dictionary variable.

(define (ast->gtype/inst context type)
  (mlet (((type env) (type->gtype type '()))
	 ((gcontext env1) (context->gcontext context '() env))
	 (gcontext-classes (arrange-gtype-classes env1 gcontext)))
    (**gtype gcontext-classes type)))

;;; This converts a context into gtype form [[class]]: a list of classes
;;; for each gtyvar.  This returns the context and the gtyvar environment.

(define (context->gcontext context gcontext env)
  (if (null? context)
      (values gcontext env)
      (mlet ((sym (context-tyvar (car context)))
	     (class (class-ref-class (context-class (car context))))
	     ((n new-env) (ast->gtyvar sym env))
	     (old-context (get-gtyvar-context n gcontext))
	     (new-context (merge-single-class class old-context))
	     (new-gcontext (cons (tuple n new-context) gcontext)))
	(context->gcontext (cdr context) new-gcontext new-env))))

;;; This assigns a gtyvar number to a tyvar name.

(define (ast->gtyvar sym env)
  (let ((res (assq sym env)))
    (if (eq? res '#f)
	(let ((n (length env)))
	  (values n (cons (tuple sym n) env)))
	(values (tuple-2-2 res) env))))

(define (get-gtyvar-context n gcontext)
  (cond ((null? gcontext)
	 '())
	((eqv? n (tuple-2-1 (car gcontext)))
	 (tuple-2-2 (car gcontext)))
	(else (get-gtyvar-context n (cdr gcontext)))))

(define *inner-tyvars* '())   ; a forall-type's tyvars: (name . -i)

(define (type->gtype type env)
  (cond ((and (tyvar? type) (assq (tyvar-name type) (dynamic *inner-tyvars*)))
	 (values (**gtyvar (tuple-2-2 (assq (tyvar-name type) (dynamic *inner-tyvars*))))
		 env))
	((tyvar? type)
	 (mlet (((n env1) (ast->gtyvar (tyvar-name type) env)))
	   (values (**gtyvar n) env1)))
	((forall-type? type)
	 ;; a nested polytype: its tyvars are -1, -2, ..., or inside
	 ;; another one's, numbered on from the enclosing ones' (so that
	 ;; forall r. (forall x. p x -> r x) -> .. keeps r and x apart)
	 (let ((inner (let ((i (- (length (dynamic *inner-tyvars*)))))
			(map (lambda (v) (decf i) (tuple v i))
			     (forall-type-tyvars type)))))
	   (dynamic-let ((*inner-tyvars* (append inner (dynamic *inner-tyvars*))))
	     (mlet (((body env1) (type->gtype (forall-type-type type) env))
		    ;; a constraint on an outer variable (C a => r, reflection's
		    ;; Gift, base's withKnownNat): one of its multi-parameter
		    ;; ones, whose dictionary its values take too
		    ((gmcontext env2)
		     (mcontext->gmcontext/env
		      (append (forall-type-mcontext type)
			      (map (lambda (c)
				     (**mp-context (context-class c)
						   (list (**tyvar (context-tyvar c)))))
				   (lisp:remove-if
				    (lambda (c) (memq (context-tyvar c) (forall-type-tyvars type)))
				    (forall-type-context type))))
		      env1)))
	       (let ((g (**gtype (map (lambda (v)
					(forall-type-classes type (tuple-2-1 v)))
				      inner)
				 body)))
		 (setf (gtype-nested? g) '#t)
		 (setf (gtype-mcontext g) gmcontext)
		 (values g env2))))))
	((tyapp? type)
	 (mlet (((fun env1) (type->gtype (tyapp-fun type) env))
		((types env2) (type->gtype/l (tyapp-args type) env1)))
	   ;; a type constructor applied in two steps ((Either e) a, from a
	   ;; synonym for a partial application) is one application
	   (values (apply-ntype fun types) env2)))
	(else
	 (mlet (((types env1) (type->gtype/l (tycon-args type) env)))
	   (values (**ntycon (tycon-def type) types) env1)))))

;;; The classes a forall-type's context gives its tyvar NAME.
(define (forall-type-classes type name)
  (let ((classes '()))
    (dolist (c (forall-type-context type))
      (when (eq? (context-tyvar c) name)
	(setf classes (merge-single-class (class-ref-class (context-class c))
					  classes))))
    classes))

(define (type->gtype/l types env)
  (if (null? types)
      (values '() env)
      (mlet (((type env1) (type->gtype (car types) env))
	     ((other-types env2) (type->gtype/l (cdr types) env1)))
	 (values (cons type other-types) env2))))

(define (arrange-gtype-classes env gcontext)
  (arrange-gtype-classes-1 0 (length env) env gcontext))

(define (arrange-gtype-classes-1 m n env gcontext)
  (if (equal? m n)
      '()
      (cons (get-gtyvar-context m gcontext)
	    (arrange-gtype-classes-1 (1+ m) n env gcontext))))

;;; These routines convert gtypes back to ordinary types.

;;; A nested polytype's instance: new type variables for its own.
;;; TYVARS replace gtyvars -1 .. -n; a polytype inside it numbers its own
;;; from -n-1 on, and they move up by n, as it is now the outer one.

(define (instantiate-polytype g)
  (let ((tyvars (map (lambda (c) (declare (ignore c)) (**ntyvar)) (gtype-context g))))
    (copy-polytype-body (gtype-type g) tyvars)))

(define (copy-polytype-body g tyvars)
  (cond ((and (gtyvar? g) (< (gtyvar-varnum g) 0))
	 (let ((i (- -1 (gtyvar-varnum g)))
	       (n (length tyvars)))
	   (if (< i n)
	       (list-ref tyvars i)
	       (**gtyvar (+ (gtyvar-varnum g) n)))))
	((and (gtype? g) (gtype-nested? g))
	 (copy-nested-gtype g (lambda (x) (copy-polytype-body x tyvars))))
	((ntyapp? g)
	 (apply-ntype (prune (copy-polytype-body (prune (ntyapp-fun g)) tyvars))
		      (map (lambda (a) (copy-polytype-body (prune a) tyvars)) (ntyapp-args g))))
	((ntycon? g)
	 (**ntycon (ntycon-tycon g)
		   (map (lambda (a) (copy-polytype-body (prune a) tyvars)) (ntycon-args g))))
	(else g)))

;;; A polytype inside a type, its body and multi-parameter constraints'
;;; types mapped by FN.
(define (copy-nested-gtype g fn)
  (let ((g1 (**gtype (gtype-context g) (funcall fn (gtype-type g)))))
    (setf (gtype-nested? g1) '#t)
    (setf (gtype-mcontext g1)
	  (map (lambda (c) (tuple (tuple-2-1 c) (map fn (tuple-2-2 c))))
	       (gtype-mcontext g)))
    g1))

(define (instantiate-gtype g)
 (mlet (((gtype _) (instantiate-gtype/newvars g)))
    gtype))

(define (instantiate-gtype/newvars g)
  (if (null? (gtype-context g))
      (values (gtype-type g) '())
      (let ((new-tyvars (create-new-tyvars (gtype-context g))))
	(values (copy-gtype (gtype-type g) new-tyvars) new-tyvars))))

;;; Also the multi-parameter constraints, as (class . ntypes).
(define (instantiate-gtype/mp g)
  (mlet (((type tyvars) (instantiate-gtype/newvars g)))
    (values type tyvars
	    (map (lambda (c)
		   (tuple (tuple-2-1 c)
			  (map (lambda (gt) (copy-gtype gt tyvars)) (tuple-2-2 c))))
		 (gtype-mcontext g)))))

(define (create-new-tyvars ctxts)
  (if (null? ctxts)
      '()
      (let ((tyvar (**ntyvar)))
	(setf (ntyvar-context tyvar) (car ctxts))
	(cons tyvar (create-new-tyvars (cdr ctxts))))))

(define (copy-gtype g env)
  (cond ((and (gtype? g) (gtype-nested? g))
	 ;; the outer type's variables are replaced, its own kept
	 (copy-nested-gtype g (lambda (x) (copy-gtype x env))))
	((and (gtyvar? g) (< (gtyvar-varnum g) 0))
	 g)
	((ntyapp? g)
	 (apply-ntype (prune (copy-gtype (ntyapp-fun g) env))
		      (map (lambda (g1) (copy-gtype g1 env))
			   (ntyapp-args g))))
	((ntycon? g)
	 (**ntycon (ntycon-tycon g)
		   (map (lambda (g1) (copy-gtype g1 env))
			(ntycon-args g))))
	((ntyvar? g)
	 g)
	((gtyvar? g)
	 (list-ref env (gtyvar-varnum g)))
	((const-type? g)
	 (const-type-type g))))

;;; ntypes may contain synonyms.  These are expanded here.  Only the
;;; top level synonym is expanded.

(define (expand-ntype-synonym type)
  (if (and (ntycon? type)
	   (synonym? (ntycon-tycon type)))
      (let ((syn (ntycon-tycon type)))
       (if (synonym-family? syn)
	;; a type family application: its equation's right-hand side, or
	;; itself while its arguments do not decide (families below)
	(let ((r (reduce-family-app type)))
	  (if (eq? r 'stuck) type (expand-ntype-synonym r)))
	;; over-applied (type R = Either String; R a): the expansion
	;; applied to the arguments beyond the synonym's own
	(let* ((n (length (synonym-args syn)))
	       (args (ntycon-args type))
	       (body (expand-ntype-synonym-1 (synonym-body syn)
					     (map (lambda (var val)
						    (tuple var val))
						  (synonym-args syn)
						  args))))
	  (expand-ntype-synonym
	   (if (> (length args) n)
	       (apply-ntype (prune body) (lisp:nthcdr n args))
	       body)))))
      type))

;;; TypeFamilies (GHC; parser/typedecl-parser.mumble, tdecl/alg-syn
;;; .mumble's process-family-equations).  A family is a synonym whose
;;; equations, (tuple arg-pattern-asts rhs-ast), are tried in order on
;;; an application: a pattern's type variable matches anything (a
;;; repeated one only the same type), a type constructor only itself.
;;; An argument still a type variable where a pattern has a constructor
;;; leaves the application stuck, and unify defers it (type/unify.mumble):
;;; it is tried again when dictionaries are resolved.  The equations are
;;; not checked for overlap or termination, and a family is not assumed
;;; injective.

(define (add-family-equation fam args rhs)
  (setf (synonym-equations fam)
	(append (synonym-equations fam) (list (tuple args rhs)))))

(define (family-app? type)
  (and (ntycon? type)
       (synonym? (ntycon-tycon type))
       (synonym-family? (ntycon-tycon type))))

;;; The reduced type, or 'stuck.
(define (family-arity family)
  ;; its declared parameters: the parser adds one, k%N, for each arrow of
  ;; a result kind (type Rep1 f :: Type -> Type), which an equation may
  ;; or may not match (parser/typedecl-parser.mumble)
  (let ((eqs (synonym-equations family))
	(declared (lisp:count-if-not
		   (lambda (v) (string-starts? "k%" (symbol->string v)))
		   (synonym-args family))))
    ;; with equations, theirs: a data instance names the extra
    ;; parameters (data KMap Bool v = ...), a type instance may not
    ;; (type R1 Box = Par)
    (if (null? eqs)
	declared
	(length (tuple-2-1 (car eqs))))))

;;; A family application with more arguments than the family has, which
;;; does not reduce yet: Rep1 g a.  Its extra arguments are an ordinary
;;; application (type/unify.mumble's unify-app-family).
(define (over-applied-family-app? type)
  (and (family-app? type)
       (> (length (ntycon-args type)) (family-arity (ntycon-tycon type)))
       (eq? (reduce-family-app type) 'stuck)))

(predefine (given-family-reduction type))  ; in type/mp-classes.mumble

(define (reduce-family-app type)
  (let* ((family (ntycon-tycon type))
	 (args (ntycon-args type))
	 (eqs (synonym-equations family))
	 (arity (family-arity family))
	 (res (let ((r (reduce-family-app-1 eqs args)))
		;; stuck: perhaps a given constraint's equality superclass
		;; decides it (ListLike text char: Item text is char)
		(when (eq? r 'stuck) (setf r (given-family-reduction type)))
		;; or an argument that is an application reducing so
		;; (SubstArg (SubstArg a) with SubstArg a ~ a given)
		(if (eq? r 'stuck) (reduce-with-reduced-args type) r))))
    ;; a family whose result is a type constructor, applied to more
    ;; arguments than it has (Rep1 f a): the result applied to the rest
    (if (or (eq? res 'stuck) (<= (length args) arity))
	res
	(apply-ntype res (list-tail args arity)))))

;;; TYPE, a stuck family application, reduced after its arguments that
;;; are family applications reducing are; else 'stuck.
(define (reduce-with-reduced-args type)
  (let* ((changed '#f)
	 (args (map (lambda (a)
		      (let ((a (prune a)))
			(if (and (family-app? a)
				 (not (eq? (reduce-family-app a) 'stuck)))
			    (begin (setf changed '#t) (prune (expand-ntype-synonym a)))
			    a)))
		    (ntycon-args type))))
    (if changed
	(let ((r (reduce-family-app (**ntycon (ntycon-tycon type) args))))
	  r)
	'stuck)))

(define (reduce-family-app-1 eqs args)
  (if (null? eqs)
      'stuck
      (let ((env (match-family-patterns (tuple-2-1 (car eqs)) args '())))
	(cond ((eq? env 'stuck) 'stuck)
	      ((eq? env 'fail) (reduce-family-app-1 (cdr eqs) args))
	      (else (expand-ntype-synonym-1 (tuple-2-2 (car eqs)) env))))))

;;; env, or 'fail (no match), or 'stuck (undecided).
(define (match-family-patterns pats types env)
  (cond ((null? pats) env)
	((null? types) 'fail)
	(else
	 (let ((env1 (match-family-pattern (car pats) (car types) env)))
	   (if (memq env1 '(stuck fail))   ; an empty env is () too
	       env1
	       (match-family-patterns (cdr pats) (cdr types) env1))))))

(define (match-family-pattern pat type env)
  (let ((type (prune type))
	;; a synonym in an equation's pattern is its expansion (Agda's type
	;; SubstArg DeBruijnPattern, DeBruijnPattern = Pattern' DBPatVar)
	(pat (expand-pattern-synonym pat 8)))
    (cond ((tyvar? pat)
	   (let ((b (assq (tyvar-name pat) env)))
	     (cond ((not b) (cons (tuple (tyvar-name pat) type) env))
		   ((eq? (prune (tuple-2-2 b)) type) env)
		   (else 'stuck))))
	  ((tycon? pat)
	   (let ((type (if (ntycon? type) (expand-ntype-synonym type) type)))
	     (cond ((ntyvar? type) 'stuck)
		   ;; a data family is generative, like a data type: Vector
		   ;; (unapplied, in Mutable Vector) or Vector a matches
		   ;; Vector and nothing else
		   ((and (family-app? type)
			 (data-family-def? (ntycon-tycon type)))
		    (if (same-tycon? (tycon-def pat) (ntycon-tycon type))
			(match-family-patterns (tycon-args pat) (ntycon-args type) env)
			'fail))
		   ((family-app? type) 'stuck)
		   ((and (ntycon? type)
			 (same-tycon? (tycon-def pat) (ntycon-tycon type)))
		    (match-family-patterns (tycon-args pat) (ntycon-args type) env))
		   ((ntycon? type) 'fail)
		   (else 'stuck))))
	  (else 'stuck))))

(define (expand-pattern-synonym pat depth)
  (if (and (> depth 0) (tycon? pat)
	   (synonym? (tycon-def pat))
	   (not (synonym-family? (tycon-def pat)))
	   (synonym-body (tycon-def pat))
	   (eqv? (length (tycon-args pat)) (length (synonym-args (tycon-def pat)))))
      (expand-pattern-synonym (expand-synonym pat) (1- depth))
      pat))

(define (expand-ntype-synonym-1 type env)
  (cond ((tyvar? type)
	 (tuple-2-2 (assq (tyvar-name type) env)))
	((tyapp? type)
	 (apply-ntype (prune (expand-ntype-synonym-1 (tyapp-fun type) env))
		      (map (lambda (ty) (expand-ntype-synonym-1 ty env))
			   (tyapp-args type))))
	(else
	 (**ntycon (tycon-def type)
		   (map (lambda (ty) (expand-ntype-synonym-1 ty env))
			(tycon-args type))))))

;;; The first n elements of a list.

(define (list-head l n)
  (if (eqv? n 0)
      '()
      (cons (car l) (list-head (cdr l) (1- n)))))

;;; This is used in generalization.  Note that ntyvars will remain when
;;; non-generic tyvars are encountered.

(define (ntype->gtype ntype)
  (mlet (((res _) (ntype->gtype/env ntype '())))
    res))

(define (ntype->gtype/env ntype required-vars)
  (mlet (((gtype env) (ntype->gtype-1 ntype required-vars)))
   (values 
    (make gtype (type gtype) (context (map (lambda (x) (ntyvar-context x))
					  env)))
    env)))

;;; A nested polytype's multi-parameter constraints, generalized with it.
(define (gmcontext->gtype mcontext env)
  (if (null? mcontext)
      (values '() env)
      (mlet (((types env1) (ntype->gtype/l (tuple-2-2 (car mcontext)) env))
	     ((rest env2) (gmcontext->gtype (cdr mcontext) env1)))
	(values (cons (tuple (tuple-2-1 (car mcontext)) types) rest) env2))))

(define (ntype->gtype-1 ntype env)
 (let ((ntype (prune ntype)))
  (cond ((ntycon? ntype)
	 (mlet (((args env1) (ntype->gtype/l (ntycon-args ntype) env)))
	   (values (**ntycon (ntycon-tycon ntype) args) env1)))
	((ntyapp? ntype)
	 (mlet (((fun env1) (ntype->gtype-1 (ntyapp-fun ntype) env))
		((args env2) (ntype->gtype/l (ntyapp-args ntype) env1)))
	   (values (**ntyapp fun args) env2)))
	((and (gtype? ntype) (gtype-nested? ntype))
	 ;; a polytype inside (RankNTypes): the type variables of its body
	 ;; that are not its own are generalized with the rest
	 (mlet (((body env1) (ntype->gtype-1 (gtype-type ntype) env))
		((mc env2) (gmcontext->gtype (gtype-mcontext ntype) env1)))
	   (let ((g (**gtype (gtype-context ntype) body)))
	     (setf (gtype-nested? g) '#t)
	     (setf (gtype-mcontext g) mc)
	     (values g env2))))
	((gtyvar? ntype)   ; a polytype's own
	 (values ntype env))
	(else
	 (ntyvar->gtyvar ntype env)))))

(define (ntype->gtype/l types env)
  (if (null? types)
      (values '() env)
      (mlet (((type env1) (ntype->gtype-1 (car types) env))
	     ((types2 env2) (ntype->gtype/l (cdr types) env1)))
	(values (cons type types2) env2))))

(define (ntyvar->gtyvar ntyvar env)
  (if (non-generic? ntyvar)
      (values ntyvar env)
      (let ((l (list-pos ntyvar env)))
	(if (eq? l '#f)
	    (values (**gtyvar (length env)) (append env (list ntyvar)))
	    (values (**gtyvar l) env)))))
     
(define (list-pos x l)
  (list-pos-1 x l 0))

(define (list-pos-1 x l n)
  (cond ((null? l)
	 '#f)
	((eq? x (car l))
	 n)
	(else
	 (list-pos-1 x (cdr l) (1+ n)))))


;;; These utils are used in dictionary conversion.

(define (**dsel/method class method dict-code)
  (let ((pos (locate-in-list method (class-method-vars class) 0)))
    (**tuple-sel (class-dict-size class) pos dict-code)))

(define (**dsel/dict class dict-class dict-code)
  (let ((pos (locate-in-list
	      dict-class (class-super* class) (class-n-methods class))))
    (**tuple-sel (class-dict-size class) pos dict-code)))
  
(define (locate-in-list var l pos)
  (if (null? l)
      (error "Locate in list failed")
      (if (eq? var (car l))
	  pos
	  (locate-in-list var (cdr l) (1+ pos)))))

;;; These routines deal with contexts.  A context is a list classes.

;;; A context is normalized whenever class is a superclass of another.

(define (merge-contexts ctxt1 ctxt2)
  (if (null? ctxt1)
      ctxt2
      (merge-single-class (car ctxt1) (merge-contexts (cdr ctxt1) ctxt2))))

;;; This could perhaps avoid some consing but I don't imagine it would
;;; make much difference.

(define (merge-single-class class ctxt)
  (cond ((null? ctxt)
	 (list class))
	((eq? class (car ctxt))
	 ctxt)
	((memq class (class-super* (car ctxt)))
	 ctxt)
	((memq (car ctxt) (class-super* class))
	 (merge-single-class class (cdr ctxt)))
	(else
	 (cons (car ctxt) (merge-single-class class (cdr ctxt))))))

;;; This determines if ctxt2 is contained in ctxt1.

(define (context-implies? ctxt1 ctxt2)
  (or (null? ctxt2)
      (and (single-class-implies? ctxt1 (car ctxt2))
	   (context-implies? ctxt1 (cdr ctxt2)))))

(define (single-class-implies? ctxt class)
  (and (not (null? ctxt))
       (or (memq class ctxt)
	   (super-class-implies? ctxt class)
	   (and (monad-implied-class? class) (context-implies-monad-class? ctxt class))
	   (catch-all-implies? ctxt class))))

;;; A catch-all instance ctx => C a gives C at a type variable whose
;;; context implies ctx (dictionary.mumble's catch-all-dict).
(define *catch-all-classes* '())   ; those being tried, against loops

(define (catch-all-implies? ctxt class)
  (let ((inst (catch-all-instance class)))
    (and inst
	 (not (memq class (dynamic *catch-all-classes*)))
	 (dynamic-let ((*catch-all-classes* (cons class (dynamic *catch-all-classes*))))
	   (every (lambda (c) (single-class-implies? ctxt c))
		  (car (instance-gcontext inst)))))))

;;; The Functor-Applicative-Monad hierarchy of today's base: Monad m
;;; implies Functor m and Applicative m.  The Haskell 98 Prelude's Monad
;;; has no superclasses, so this is an extra entailment; the dictionaries
;;; are WrappedMonad's (PreludeModern), whose instances need only Monad m
;;; (dictionary.mumble's monad-implied-dict).  Only while PreludeModern is
;;; loaded, as its classes and instances are needed.

(define (monad-implied-class? class)
  (and (table-entry *modules* '|PreludeModern|)
       (or (eq? class (core-symbol "Functor"))
	   (eq? class (prelude-modern-def '|Applicative|))
	   (alternative-class? class))))

;;; base's MonadPlus has Alternative as a superclass; ours (the Haskell 98
;;; Monad module's) does not, so Alternative m comes from MonadPlus m
;;; through WrappedMonad's instance, as Applicative m does from Monad m.

(define (alternative-class? class)
  (eq? class (prelude-modern-def '|Alternative|)))

(define (monadplus-class)
  (let ((m (table-entry *modules* '|Monad|)))
    (and m (table-entry (module-symbol-table m) '|MonadPlus|))))

;;; The class whose dictionary gives CLASS's implied one: MonadPlus for
;;; Alternative, Monad for Functor and Applicative.
(define (implying-class class)
  (if (alternative-class? class) (monadplus-class) (core-symbol "Monad")))

(define (context-has-monad? ctxt)
  (lisp:some (function monad-class?) ctxt))

;;; Whether CTXT gives CLASS by monad-implied-class? (its implying class
;;; or a subclass of it).
(define (context-implies-monad-class? ctxt class)
  (let ((need (implying-class class)))
    (and need
	 (lisp:some (lambda (c) (or (eq? c need) (memq need (class-super* c))))
		    ctxt))))

(define (monad-class? class)
  (let ((monad  (core-symbol "Monad")))
    (or (eq? class monad) (memq monad (class-super* class)))))

;;; A name PreludeModern defines, or '#f.

(define (prelude-modern-def name)
  (let ((m  (table-entry *modules* '|PreludeModern|)))
    (and m (table-entry (module-symbol-table m) name))))

(define (super-class-implies? ctxt class)
  (and (not (null? ctxt))
       (or (memq class (class-super* (car ctxt)))
	   (super-class-implies? (cdr ctxt) class))))

;;; This looks at the context of a full signature.

(define (full-context-implies? ctxt1 ctxt2)
  (or (null? ctxt1)
      (and (context-implies? (car ctxt1) (car ctxt2))
	   (full-context-implies? (cdr ctxt1) (cdr ctxt2)))))

;;; This is used to avoid type circularity on unification.

(define (occurs-in-type tyvar type) ; Cardelli algorithm
  (let ((type (prune type)))
    (cond ((gtype? type)
	   (occurs-in-type tyvar (gtype-type type)))
	  ((gtyvar? type)
	   '#f)
	  ((ntyvar? type)
	   (eq? type tyvar))
	  ((ntyapp? type)
	   (or (occurs-in-type tyvar (ntyapp-fun type))
	       (occurs-in-type/l tyvar (ntyapp-args type))))
	  (else
	   (occurs-in-type/l tyvar (ntycon-args type))))))

; Does a tyvar occur in a list of types?
(define (occurs-in-type/l tyvar types)
  (if (null? types)
      '#f
      (or (occurs-in-type tyvar (car types))
	  (occurs-in-type/l tyvar (cdr types)))))

(define-integrable (non-generic? tyvar)
  (or (occurs-in-type/l tyvar (dynamic *non-generic-tyvars*))
      ;; a GADT clause's soft-typed variable uses (type/existentials.mumble)
      (and (not (null? (dynamic *gadt-soft-uses*)))
	   (occurs-in-type/l tyvar (dynamic *gadt-soft-uses*)))))

(define (collect-tyvars ntype)
  (collect-tyvars-1 ntype '()))

(define (collect-tyvars-1 ntype vars)
 (let ((ntype (prune ntype)))
  (cond ((gtype? ntype)
	 (collect-tyvars-1 (gtype-type ntype) vars))
	((gtyvar? ntype)
	 vars)
	((ntyvar? ntype)
	 (if (or (memq ntype vars) (non-generic? ntype))
	     vars
	     (cons ntype vars)))
	((ntyapp? ntype)
	 (collect-tyvars/l-1 (ntyapp-args ntype)
			     (collect-tyvars-1 (ntyapp-fun ntype) vars)))
	(else
	 (collect-tyvars/l-1 (ntycon-args ntype) vars)))))

(define (collect-tyvars/l types)
  (collect-tyvars/l-1 types '()))

(define (collect-tyvars/l-1 types vars)
  (if (null? types)
      vars
      (collect-tyvars/l-1 (cdr types) (collect-tyvars-1 (car types) vars))))

;;; Random utilities

(define (decl-var decl)
  (var-ref-var (var-pat-var (valdef-lhs decl))))
