;;; This file handles the scoping and error checking of signatures.

;;; Possible errors:
;;;  Wrong arity in a tycon
;;;  Ambiguous context

;;; Other errors may be present; these are detected at a higher level.
;;; The list of variables used in the signature is returned.

(define *class-sig-tyvars* '())   ; a class's variables, its methods' signatures

(define (resolve-signature signature)
  (float-synonym-foralls signature)
  (expand-constraint-synonyms signature)
  (keep-family-equalities signature)
  (reduce-flexible-contexts signature)
  (add-mp-superclass-contexts signature)
  (with-slots signature (context type mcontext) signature
    (let ((tyvars (resolve-type type)))
      ;; a multi-parameter constraint may mention tyvars the type does
      ;; not (determined by a functional dependency)
      (dolist (c mcontext)
	(resolve-class (mp-context-class c))
	(dolist (ty (mp-context-types c))
	  ;; (a class's argument may be higher-kinded: MArray (STUArray s) e m)
	  (dolist (v (resolve-type-1 ty '() '#t))
	    (when (not (memq v tyvars))
	      (push v tyvars)))))
      ;; AllowAmbiguousTypes: a context's variable the type does not
      ;; mention (sizeOfType :: forall a. Prim a => Int), chosen by a type
      ;; application at each use
      ;; (or a class's variable in its method's own constraint:
      ;; ConstrainedClassMethods, *class-sig-tyvars*)
      (dolist (c context)
	(when (and (memq (context-tyvar c) (dynamic *class-sig-tyvars*))
		   (not (memq (context-tyvar c) tyvars)))
	  (setf tyvars (append tyvars (list (context-tyvar c))))))
      (when (module-extension? "AllowAmbiguousTypes")
	(dolist (c context)
	  (when (not (memq (context-tyvar c) tyvars))
	    (setf tyvars (append tyvars (list (context-tyvar c)))))))
      (resolve-signature-aux tyvars context)
      tyvars)))

;;; RankNTypes: a signature whose type is a synonym for a polytype,
;;;   type Lens s t a b = forall f. Functor f => (a -> f b) -> s -> f t
;;;   _1 :: Lens (a, c) (b, c) a b
;;; (or ends in one: Int -> Lens' s a) means the polytype with the
;;; synonym's arguments: its forall's variables (renamed apart) and
;;; context join the signature's, at the top (microlens).

(define (float-synonym-foralls signature)
  ;; C a => D a => t (Agda's killRangeN :: IsBase t ~ b => All KillRange
  ;; (Domains t) => t -> t) is (C a, D a) => t
  (do ((n 0 (1+ n)))
      ((or (> n 8) (not (forall-type? (signature-type signature)))))
    (let ((poly (signature-type signature)))
      (setf (signature-context signature)
	    (append (signature-context signature) (forall-type-context poly)))
      (setf (signature-mcontext signature)
	    (append (signature-mcontext signature) (forall-type-mcontext poly)))
      (setf (signature-type signature) (forall-type-type poly))))
  (mlet (((type contexts mcontexts) (float-foralls (signature-type signature) 8)))
    (when (or (not (null? contexts)) (not (null? mcontexts)))
      (setf (signature-type signature) type)
      (setf (signature-context signature)
	    (append (signature-context signature) contexts))
      (setf (signature-mcontext signature)
	    (append (signature-mcontext signature) mcontexts))))
  ;; one elsewhere (an argument: biextend :: (p :-> t q) -> ..., type
  ;; p :-> q = forall a b. p a b -> q a b) is the polytype it names
  (setf (signature-type signature)
	(expand-nested-polytype-synonyms (signature-type signature) 8)))

(define (expand-nested-polytype-synonyms type depth)
  (cond ((<= depth 0) type)
	((tycon? type)
	 (let ((poly (polytype-synonym-expansion type 8)))
	   (if poly
	       (float-polytype-results
		(make forall-type (tyvars (forall-type-tyvars poly))
		      (context (forall-type-context poly))
		      (mcontext (forall-type-mcontext poly))
		      (type (expand-nested-polytype-synonyms (forall-type-type poly)
							      (1- depth))))
		8)
	       (begin
		 (when (not (null? (tycon-args type)))
		   (setf (tycon-args type)
			 (map (lambda (a) (expand-nested-polytype-synonyms a depth))
			      (tycon-args type))))
		 type))))
	((tyapp? type)
	 (setf (tyapp-args type)
	       (map (lambda (a) (expand-nested-polytype-synonyms a depth))
		    (tyapp-args type)))
	 type)
	((forall-type? type)
	 (setf (forall-type-type type)
	       (expand-nested-polytype-synonyms (forall-type-type type) depth))
	 (float-polytype-results type 8))
	(else type)))

;;; A polytype whose arrow's result is a polytype (SYB's GenericQ
;;; (GenericQ r): forall a. Data a => a -> forall b. Data b => b -> r) is
;;; the one polytype with both's variables and contexts, as a signature's
;;; result polytype is floated (float-result-foralls): a function of such
;;; a type takes all the dictionaries first, wherever the type is written.
(define (float-polytype-results poly depth)
  (mlet (((body vars cs mcs) (float-arrow-result-polytypes (forall-type-type poly) depth)))
    (if (null? vars)
	poly
	(make forall-type (tyvars (append (forall-type-tyvars poly) vars))
	      (context (append (forall-type-context poly) cs))
	      (mcontext (append (forall-type-mcontext poly) mcs))
	      (type body)))))

;;; TYPE's arrows' result polytypes taken out: the type, and the
;;; polytypes' variables, contexts and multi-parameter contexts.
(define (float-arrow-result-polytypes type depth)
  (cond ((<= depth 0) (values type '() '() '()))
	((and (tycon? type)
	      (eq? (resolve-tycon-def type) (core-symbol "Arrow"))
	      (eqv? (length (tycon-args type)) 2))
	 (let* ((res0 (cadr (tycon-args type)))
		(res (if (forall-type? res0)
			 res0
			 (or (polytype-synonym-expansion res0 8) res0))))
	   (if (forall-type? res)
	       (let ((poly (rename-forall-apart res)))
		 (mlet (((body vars cs mcs)
			 (float-arrow-result-polytypes (forall-type-type poly) (1- depth))))
		   (values (make tycon (name (tycon-name type)) (def (tycon-def type))
				 (args (list (car (tycon-args type)) body)))
			   (append (forall-type-tyvars poly) vars)
			   (append (forall-type-context poly) cs)
			   (append (forall-type-mcontext poly) mcs))))
	       (mlet (((body vars cs mcs) (float-arrow-result-polytypes res (1- depth))))
		 (if (null? vars)
		     (values type '() '() '())
		     (values (make tycon (name (tycon-name type)) (def (tycon-def type))
				   (args (list (car (tycon-args type)) body)))
			     vars cs mcs))))))
	(else (values type '() '() '()))))

;;; The type with a polytype synonym at the top, or in the result of an
;;; arrow, replaced by the polytype's body; and the contexts lifted.
(define (float-foralls type depth)
  (let ((poly (and (> depth 0) (polytype-synonym-expansion type 8))))
    (cond (poly
	   (mlet (((body cs mcs) (float-foralls (forall-type-type poly) (1- depth))))
	     (values body (append (forall-type-context poly) cs)
		     (append (forall-type-mcontext poly) mcs))))
	  ((and (tycon? type)
		(eq? (resolve-tycon-def type) (core-symbol "Arrow"))
		(eqv? (length (tycon-args type)) 2))
	   (mlet (((res cs mcs) (float-result-foralls (cadr (tycon-args type)) depth)))
	     (if (and (null? cs) (null? mcs))
		 (values type '() '())
		 (values (make tycon (name (tycon-name type)) (def (tycon-def type))
			       (args (list (car (tycon-args type)) res)))
			 cs mcs))))
	  (else (values type '() '())))))

;;; An arrow's result: a polytype there is floated too, synonym or not
;;; (k :: Int -> forall a. Show a => a -> String is forall a. Show a =>
;;; Int -> a -> String, as in GHC; SYB's everywhere :: (forall a. Data a
;;; => a -> a) -> (forall a. Data a => a -> a)).
(define (float-result-foralls type depth)
  (if (and (forall-type? type) (> depth 0))
      (let ((poly (rename-forall-apart type)))
	(mlet (((body cs mcs) (float-result-foralls (forall-type-type poly) (1- depth))))
	  (values body (append (forall-type-context poly) cs)
		  (append (forall-type-mcontext poly) mcs))))
      (float-foralls type depth)))

(define (resolve-tycon-def type)
  (let ((def (tycon-def type)))
    (if (eq? def *undefined-def*)
	(resolve-toplevel-name (tycon-name type))
	def)))

;;; A forall-type, its variables renamed apart, if TYPE is an application
;;; of a type synonym (perhaps through other synonyms) for a polytype.
(define (polytype-synonym-expansion type depth)
  (and (tycon? type) (> depth 0)
       (let ((def (resolve-tycon-def type)))
	 (and (synonym? def)
	      (not (synonym-family? def))
	      (synonym-body def)
	      (eqv? (length (synonym-args def)) (length (tycon-args type)))
	      (let ((body (synonym-body def)))
		(cond ((forall-type? body)
		       (instantiate-synonym-body (rename-forall-apart body)
						 (synonym-args def) (tycon-args type)))
		      ((tycon? body)
		       (let ((b (instantiate-synonym-body body (synonym-args def)
							  (tycon-args type))))
			 (polytype-synonym-expansion b (1- depth))))
		      (else '#f)))))))

(define (instantiate-synonym-body body params args)
  (let ((fresh (map (lambda (p) (declare (ignore p)) (gentyvar "sa")) params)))
    ;; through fresh names, so that an argument naming a parameter is safe
    (let ((b body))
      (dolist2 (p params) (f fresh)
	(setf b (substitute-tyvar b p (**tyvar f))))
      (dolist2 (f fresh) (a args)
	(setf b (substitute-tyvar b f a)))
      b)))

(define (rename-forall-apart poly)
  (let ((body (forall-type-type poly))
	(contexts (forall-type-context poly))
	(mcontexts (forall-type-mcontext poly))
	(new-vars '()))
    (dolist (v (forall-type-tyvars poly))
      (let ((n (gentyvar (symbol->string v))))
	(push n new-vars)
	(setf body (substitute-tyvar body v (**tyvar n)))
	(setf contexts (map (lambda (c)
			      (if (eq? (context-tyvar c) v)
				  (**context (context-class c) n)
				  c))
			    contexts))
	(setf mcontexts (substitute-tyvar/mcontext mcontexts v (**tyvar n)))))
    (make forall-type (tyvars (reverse new-vars)) (context contexts)
	  (mcontext mcontexts) (type body))))

(define (substitute-tyvar/mcontext mcontexts tyvar new)
  (map (lambda (c)
	 (**mp-context (mp-context-class c)
		       (map (lambda (ty) (substitute-tyvar ty tyvar new))
			    (mp-context-types c))))
       mcontexts))

;;; FlexibleContexts (GHC): C t for a one-parameter class C and a type t
;;; that is not a type variable (parsed as a multi-parameter constraint
;;; with one type) is reduced through t's instance of C to constraints on
;;; type variables: Show [a] is Show a, Eq (Maybe Int) is nothing.  A
;;; constraint on an application of a type variable (Monad (m s)) cannot
;;; be reduced: it stays a multi-parameter-style constraint, whose
;;; dictionary the function takes as a parameter (type/mp-classes.mumble),
;;; and a use of the class at that type is resolved from it
;;; (type/dictionary.mumble's process-placeholder-1).

(define (reduce-flexible-contexts signature)
  (let ((keep '())
	(added '()))
    (dolist (c (signature-mcontext signature))
      (resolve-class (mp-context-class c))
      (let ((class (class-ref-class (mp-context-class c))))
	(if (and (null? (cdr (mp-context-types c)))
		 (class? class)
		 (null? (cdr (class-tyvars class)))
		 ;; Monad (m s): kept, a given whose dictionary is a
		 ;; parameter, as a multi-parameter constraint's is
		 (not (tyvar-application? (car (mp-context-types c))))
		 ;; GDefault (Rep a), on a type family application: kept too,
		 ;; also through synonyms (generic-data's Show (ConIdNamed' n t),
		 ;; a synonym of a family's)
		 (not (family-application-ast? (car (mp-context-types c))))
		 (reducible-context-type? class (car (mp-context-types c)) 20))
	    (setf added (append (reduce-context-type class (car (mp-context-types c)))
				added))
	    (push c keep))))
    (when (not (null? added))
      (setf (signature-context signature)
	    (append (signature-context signature) added))
      (setf (signature-mcontext signature) (reverse keep)))))

;;; A multi-parameter class's multi-parameter superclasses (MonadReader r m
;;; of MonadRWS r w s m; class-mp-mp-supers) hold wherever it does: they
;;; join the multi-parameter context, transitively, so that the function
;;; gets their dictionaries too.

(define (add-mp-mp-superclass-contexts signature)
  (setf (signature-mcontext signature)
	(with-mp-mp-superclasses
	 (append-new-mp-contexts
	  (signature-mcontext signature)
	  (one-parameter-mp-superclasses (signature-context signature))))))

;;; MCONTEXT with those of NEW it does not have (an instance's dictionary
;;; signature has them already: tdecl/instance.mumble).
(define (append-new-mp-contexts mcontext new)
  (dolist (c mcontext)
    (resolve-class (mp-context-class c)))
  (dolist (c new)
    (when (not (lisp:some
		(lambda (c2)
		  (and (eq? (class-ref-class (mp-context-class c2))
			    (class-ref-class (mp-context-class c)))
		       (every (function ast-types-equal?)
			      (mp-context-types c2) (mp-context-types c))))
		mcontext))
      (setf mcontext (append mcontext (list c)))))
  mcontext)

;;; The multi-parameter superclasses of a context's one-parameter classes
;;; (Unbox a gives G.Vector Vector a), as multi-parameter constraints.
(define (one-parameter-mp-superclasses context)
  (lisp:mapcan
   (lambda (c)
     (resolve-class (context-class c))
     (let ((class (class-ref-class (context-class c))))
       (if (class? class)
	   (map (lambda (s)
		  (**mp-context (**class/def (tuple-2-1 s))
				(map (lambda (p)
				       (instantiate-mp-super-template
					p (list (**tyvar (context-tyvar c)))))
				     (tuple-2-2 s))))
		;; and those of its one-parameter superclasses, at the same
		;; variable (generic-data's GTraversable t => GTraversable_ t
		;; => GTraverse Kleisli t)
		(append (class-mp-mp-supers class)
			(lisp:mapcan (lambda (super)
				       (if (class? super)
					   (lisp:copy-list (class-mp-mp-supers super))
					   '()))
				     (class-super* class))))
	   '())))
   context))

;;; A forall-type's multi-parameter context, resolved; VARS with the
;;; variables it mentions.  (Its classes' superclasses join it when it is
;;; instantiated, type/polytypes.mumble's polytype-mcontext-instance: a
;;; data type's fields are resolved before the classes' superclasses are
;;; known.)

(define (resolve-forall-mcontext type vars)
  ;; its constraint synonyms expanded, as a signature's are: a nullary
  ;; one of () is no constraint (Agda's HasCallStack => a -> m b)
  (let ((sig (make signature (context (forall-type-context type))
		   (type (forall-type-type type))
		   (mcontext (forall-type-mcontext type))
		   (foralls '()))))
    (expand-constraint-synonyms sig)
    (setf (forall-type-context type) (signature-context sig))
    (setf (forall-type-mcontext type) (signature-mcontext sig)))
  (dolist (c (forall-type-mcontext type))
    (resolve-class (mp-context-class c)))
  (dolist (c (forall-type-mcontext type))
    (dolist (ty (mp-context-types c))
      (dolist (v (resolve-type-1 ty '() '#t))
	(when (not (memq v vars))
	  (push v vars)))))
  vars)

(define (with-mp-mp-superclasses mcontext)
  (let ((work mcontext)
	(n 0))
    (do () ((or (null? work) (> n 64)))
      (let* ((c (car work))
	     (class (class-ref-class (mp-context-class c))))
	(setf work (cdr work))
	(incf n)
	(when (class? class)
	  (dolist (s (append (class-mp-mp-supers class)
			     ;; a one-parameter class at a type that is not a
			     ;; variable (GTraversable (Rep1 f)): its
			     ;; one-parameter superclasses there, whose own
			     ;; multi-parameter ones follow
			     (if (mp-class? class)
				 '()
				 (map (lambda (super) (tuple super (list 0)))
				      (lisp:remove-if-not
				       (lambda (super)
					 (and (class? super)
					      (not (null? (class-mp-mp-supers super)))))
				       (class-super* class))))))
	    (let ((types (map (lambda (p)
				(instantiate-mp-super-template p (mp-context-types c)))
			      (tuple-2-2 s))))
	      (when (not (lisp:some
			  (lambda (c2)
			    (and (eq? (class-ref-class (mp-context-class c2)) (tuple-2-1 s))
				 (every (function ast-types-equal?)
					(mp-context-types c2) types)))
			  mcontext))
		(let ((new (**mp-context (**class/def (tuple-2-1 s)) types)))
		  (setf mcontext (append mcontext (list new)))
		  (setf work (append work (list new))))))))))
    mcontext))

;;; tdecl/class.mumble's mp-super-template at the context's types.

(define (instantiate-mp-super-template p types)
  (if (integer? p)
      (list-ref types p)
      (**tycon/def (car p)
		   (map (lambda (a) (instantiate-mp-super-template a types))
			(cdr p)))))

(define (ast-types-equal? t1 t2)
  (cond ((and (tyvar? t1) (tyvar? t2)) (eq? (tyvar-name t1) (tyvar-name t2)))
	((and (tycon? t1) (tycon? t2))
	 (and (eq? (tycon-name t1) (tycon-name t2))
	      (eqv? (length (tycon-args t1)) (length (tycon-args t2)))
	      (every (function ast-types-equal?) (tycon-args t1) (tycon-args t2))))
	((and (tyapp? t1) (tyapp? t2))
	 (and (ast-types-equal? (tyapp-fun t1) (tyapp-fun t2))
	      (eqv? (length (tyapp-args t1)) (length (tyapp-args t2)))
	      (every (function ast-types-equal?) (tyapp-args t1) (tyapp-args t2))))
	(else '#f)))

;;; A multi-parameter class's superclasses (class-mp-supers) hold
;;; wherever it does: MonadReader r m adds Monad m to the context, so
;;; that the function gets the superclass's dictionary too (rather than
;;; selecting it from the class's).

(define (add-mp-superclass-contexts signature)
  (add-mp-mp-superclass-contexts signature)
  (dolist (c (signature-mcontext signature))
    (let ((class (class-ref-class (mp-context-class c))))
      (when (class? class)
	(dolist (s (class-mp-supers class))
	  (let ((ty (list-ref (mp-context-types c) (tuple-2-2 s))))
	    ;; at another type (profunctors' Sieve p (Rep p) gives Functor
	    ;; (Rep p)): a flexible constraint
	    (when (and (not (tyvar? ty))
		       (not (lisp:some
			     (lambda (c2)
			       (and (eq? (class-ref-class (mp-context-class c2)) (tuple-2-1 s))
				    (null? (cdr (mp-context-types c2)))
				    (ast-types-equal? (car (mp-context-types c2)) ty)))
			     (signature-mcontext signature))))
	      (setf (signature-mcontext signature)
		    (append (signature-mcontext signature)
			    (list (**mp-context (**class/def (tuple-2-1 s)) (list ty))))))
	    (when (and (tyvar? ty)
		       (not (lisp:some
			     (lambda (ctx)
			       (and (eq? (context-tyvar ctx) (tyvar-name ty))
				    (eq? (class-ref-class (context-class ctx))
					 (tuple-2-1 s))))
			     (signature-context signature))))
	      (setf (signature-context signature)
		    (append (signature-context signature)
			    (list (make context (class (**class/def (tuple-2-1 s)))
					         (tyvar (tyvar-name ty)))))))))))))

;;; An equality constraint (TypeEquality, parser/type-parser.mumble's
;;; apply-equalities) is kept only when a side is a type family's
;;; application, and PreludeModern is there to give the class.
(define (keep-family-equalities signature)
  (setf (signature-mcontext signature)
	(lisp:remove-if
	 (lambda (c)
	   (and (eq? (class-ref-name (mp-context-class c)) '|%TypeEq|)
		(or (not (prelude-modern-def '|TypeEquality|))
		    (not (lisp:some (function family-application-ast?)
				    (mp-context-types c))))))
	 (signature-mcontext signature))))

(define (family-application-ast? type)
  (and (tycon? type)
       (begin (resolve-type-1 type '() '#t) '#t)
       (let ((def (tycon-def type)))
	 (and (synonym? def) (synonym-family? def)))))

;;; Whether reduce-context-type can take TYPE apart: through synonyms
;;; applied to all their parameters, to a variable or a data type
;;; (generic-data's Show (ConIdNamed' n t) is a family's, kept).
(define (reducible-context-type? class type depth)
  (resolve-type type)
  (cond ((<= depth 0) '#f)
	((tyvar? type) '#t)
	((not (tycon? type)) '#f)
	((algdata? (tycon-def type))
	 ;; (as reduce-context-type: the instance's context at the arguments)
	 ;; (no instance yet, StringLike Text in ListLike's class before
	 ;; its instance's module: kept, as GHC keeps it)
	 (let ((inst (lookup-instance (tycon-def type) class)))
	   (and inst
	    (or (null? (instance-tyvars inst))
	       (not (eqv? (length (instance-tyvars inst)) (length (tycon-args type))))
	       (every (lambda (ic)
			(let ((cl (class-ref-class (context-class ic))))
			  (and (class? cl)
			       (reducible-context-type?
				cl
				(find-corresponding-tyvar
				 (context-tyvar ic) (instance-tyvars inst)
				 (tycon-args type))
				(1- depth)))))
		      (instance-context inst))))))
	((and (synonym? (tycon-def type))
	      (not (synonym-family? (tycon-def type)))
	      (synonym-body (tycon-def type))
	      (eqv? (length (tycon-args type)) (length (synonym-args (tycon-def type)))))
	 (reducible-context-type? class (expand-synonym type) (1- depth)))
	(else '#f)))

;;; TYPE with the synonyms (not families) at its head expanded.
(define (expand-plain-synonyms type depth)
  (resolve-type type)
  (if (and (> depth 0) (tycon? type) (synonym? (tycon-def type))
	   (not (synonym-family? (tycon-def type)))
	   (synonym-body (tycon-def type))
	   (eqv? (length (tycon-args type)) (length (synonym-args (tycon-def type)))))
      (expand-plain-synonyms (expand-synonym type) (1- depth))
      type))

(define (reduce-context-type class type)
  (resolve-type type)
  (cond ((tyvar? type)
	 (list (make context (class (**class/def class)) (tyvar (tyvar-name type)))))
	((and (tycon? type) (synonym? (tycon-def type)))
	 (reduce-context-type class (expand-synonym type)))
	((and (tycon? type) (algdata? (tycon-def type)))
	 (let ((inst (lookup-instance (tycon-def type) class)))
	   (when (eq? inst '#f)
	     (phase-error 'no-instance-for-context
	       "No instance of ~A for ~A, in a context." class type))
	   (let ((result '()))
	     (dolist (ic (instance-context inst))
	       (setf result
		     (append (reduce-context-type
			      (class-ref-class (context-class ic))
			      (find-corresponding-tyvar
			       (context-tyvar ic) (instance-tyvars inst)
			       (tycon-args type)))
			     result)))
	     result)))
	(else
	 (phase-error 'unsupported-context
	   "The context ~A (~A) is not supported: it is on an application of a~%~
            type variable."
	   class type)
	 '())))

(define (resolve-signature-aux tyvars context)
  (dolist (ctxt context)
    (with-slots context (class tyvar) ctxt
      (when (not (memq tyvar tyvars))
	(signal-ambiguous-context tyvar class))
      (resolve-class class))))

(define (resolve-type type)
  (resolve-type-1 type '() '#f))

;;; Partial applications of a tycon are allowed only in argument position
;;; (`partial-ok?'), where a higher-kinded parameter may be supplied.  Kinds
;;; are not otherwise checked; a mismatch shows up as a unification or
;;; instance error.

(define (resolve-type-1 type vars partial-ok?)
  (cond ((tyvar? type)
	 (cons (tyvar-name type) vars))
	((forall-type? type)
	 ;; its own type variables are not free; its context constrains
	 ;; them, or the outer variables its type mentions (C m => t
	 ;; without a forall: type FoldFn m a = Monoid m => (e -> m) -> a -> m)
	 (let ((inner (resolve-forall-mcontext type
		        (resolve-type-1 (forall-type-type type) '() '#f))))
	   (resolve-signature-aux (append (forall-type-tyvars type) inner)
				  (forall-type-context type))
	   (append (lisp:remove-if (lambda (v) (memq v (forall-type-tyvars type)))
				   inner)
		   vars)))
	((tyapp? type)
	 (resolve-type/list (tyapp-args type)
			    (resolve-type-1 (tyapp-fun type) vars '#f)))
	(else
	 (resolve-tycon type)
	 (with-slots tycon (name def args) type
	   (when (not (eq? def *undefined-def*))
	     (cond ;; a family: its declared parameters, more when its
		   ;; result is a type constructor (Rep1 g, Rep1 f a;
		   ;; util/type-utils.mumble's reduce-family-app); the arity a
		   ;; first use would record does not apply
		   ((and (synonym? def) (synonym-family? def)))
		   ((eqv? (tycon-def-arity def) -1)
		    (setf (tycon-def-arity def) (length args)))
		   ;; a synonym for a partial application, applied to more:
		   ;; type State s = StateT s Identity; State s a (GHC)
		   ((and (> (length args) (tycon-def-arity def))
			 (synonym? def) (haskell98?)
			 (expand-over-applied-synonym type))
		    (return-from resolve-type-1
		      (resolve-type-1 type vars partial-ok?)))
		   ((> (length args) (tycon-def-arity def))
		    (signal-tycon-arity name type))
		   ((and (< (length args) (tycon-def-arity def))
			 (or (not partial-ok?) (synonym? def)))
		    (signal-tycon-arity name type))))
	   (resolve-type/list args vars)))))

;;; TYPE, a synonym applied to more arguments than it has, becomes in
;;; place its expansion applied to the rest; #f if the expansion is not a
;;; type constructor application.

(define (expand-over-applied-synonym type)
  (ensure-synonym-defined (tycon-def type))
  (let* ((def    (tycon-def type))
	 (n      (tycon-def-arity def))
	 (args   (tycon-args type))
	 (head   (make tycon (name (tycon-name type)) (def def)
		       (args (lisp:subseq args 0 n))))
	 (exp    (expand-synonym head)))
    (and (tycon? exp)
	 (begin
	   (setf (tycon-name type) (tycon-name exp))
	   (setf (tycon-def type) (tycon-def exp))
	   (setf (tycon-args type) (append (tycon-args exp) (lisp:nthcdr n args)))
	   '#t))))

;;; A synonym of this module used (over-applied) by a data declaration
;;; before process-type-declarations has reached the synonyms (husk's
;;; type ThrowsError = Either LispError, used in data LispVal) is defined
;;; now.

(define (ensure-synonym-defined def)
  (when (and (not (synonym-body def)) (not (synonym-family? def))
	     (null? (synonym-constraints def)))
    (let ((decl (lisp:find-if (lambda (d) (eq? (tycon-def (synonym-decl-simple d)) def))
			      (module-synonyms *module*))))
      (when decl (synonym->def decl)))))

(define (resolve-type/list args vars)
  (if (null? args)
      vars
      (resolve-type/list (cdr args) (resolve-type-1 (car args) vars '#t))))

;;; This returns the names of the tyvars in a simple tycon

(define (simple-tyvar-list simple)
  (remember-context simple
    (let* ((res (map (lambda (x) (tyvar-name x)) (tycon-args simple)))
	   (dups (find-duplicates res)))
      (when (not (null? dups))
	(signal-non-linear-type-vars simple))
      res)))

;;; Apply an ast type to more arguments, normalizing: a tycon takes them
;;; as extra arguments, a tyvar becomes a tyapp.

(define (apply-ast-type fun args)
  (cond ((null? args) fun)
	((tyapp? fun)
	 (**tyapp (tyapp-fun fun) (append (tyapp-args fun) args)))
	;; (not a class literal, TypeSymbol of a class's name: a quantified
	;; constraint's head D t1 .. tn applies it)
	((and (tycon? fun) (not (eq? (tycon-def fun) (core-symbol "TypeSymbol")))
	      ;; (nor a class's name, unresolved yet)
	      (not (and (null? (tycon-args fun))
			(eq? (tycon-def fun) *undefined-def*)
			(is-type? 'module (dynamic *module*))
			(class? (resolve-toplevel-name (tycon-name fun))))))
	 (make tycon (name (tycon-name fun)) (def (tycon-def fun))
		     (args (append (tycon-args fun) args))))
	(else (**tyapp fun args))))

;;; This is used to build the class dictionary signature.

(define (substitute-tyvar type tyvar new)
  (cond ((tyvar? type)
	 (if (eq? (tyvar-name type) tyvar)
	     new
	     (**tyvar (tyvar-name type))))
	((tyapp? type)
	 (let ((fun (substitute-tyvar (tyapp-fun type) tyvar new))
	       (args (map (lambda (x) (substitute-tyvar x tyvar new))
			  (tyapp-args type))))
	   (apply-ast-type fun args)))
	((tycon? type)
	 (with-slots tycon (name def args) type
	   (make tycon (name name) (def def)
		       (args (map (lambda (x) (substitute-tyvar x tyvar new))
				  args)))))
	((forall-type? type)
	 ;; the forall's own variables are not substituted
	 (if (memq tyvar (forall-type-tyvars type))
	     type
	     (make forall-type (tyvars (forall-type-tyvars type))
		   (context (forall-type-context type))
		   (mcontext (substitute-tyvar/mcontext (forall-type-mcontext type)
							tyvar new))
		   (type (substitute-tyvar (forall-type-type type) tyvar new)))))
	(else
	 (**signature (signature-context type)
		      (substitute-tyvar (signature-type type) tyvar new)))))



;;; Error signalling routines

(define (signal-ambiguous-context tyvar . class)
  (phase-error 'ambiguous-context
    "~a is referenced in a context~A, but is not bound as a type variable."
    tyvar (if (pair? class)
	      (format '#f " (~A ~A, in ~A)" (class-ref-name (car class)) tyvar *module-name*)
	      "")))


(define (signal-tycon-arity name type)
  (phase-error 'tycon-arity
    "The wrong number of arguments are supplied to the constructor ~a~%~
     in the type ~a."
    name type))


(define (signal-non-linear-type-vars simple)
  (phase-error 'non-linear-type-vars
    "There are duplicate type variables in ~s."
    simple))


;;; ConstraintKinds (GHC): a constraint naming a constraint synonym
;;; (tdecl/alg-syn.mumble's constraint-synonym-body) is replaced by the
;;; synonym's constraints, its parameters substituted, repeatedly.

(define (expand-constraint-synonyms signature)
  (let ((changed '#t)
	(n 0))
    (do () ((or (not changed) (> n 20)))
      (setf changed '#f)
      (incf n)
      (let ((single '()) (multi (signature-mcontext signature)))
	(dolist (c (signature-context signature))
	  (let ((syn (constraint-synonym (class-ref-name (context-class c)))))
	    (if syn
		(begin
		  (setf changed '#t)
		  (mlet (((s m) (instantiate-constraint-synonym
				 syn (list (**tyvar (context-tyvar c))))))
		    (setf single (append single s))
		    (setf multi (append multi m))))
		(setf single (append single (list c))))))
	(let ((multi2 '()))
	  (dolist (c multi)
	    (let ((syn (constraint-synonym (class-ref-name (mp-context-class c)))))
	      (cond
	       ;; C with no arguments naming a synonym of (): no constraint
	       ((and (null? (mp-context-types c))
		     (trivial-constraint? (class-ref-name (mp-context-class c)) 10))
		(setf changed '#t))
	       ;; a type family of constraints (Agda's All KillRange
	       ;; (Domains t)): not evaluated, as a constraint synonym's
	       ;; (tdecl/alg-syn.mumble's constraint-synonym-body)
	       ((constraint-family-context? (mp-context-class c))
		(setf changed '#t))
	       (else
	      (if syn
		  (begin
		    (setf changed '#t)
		    (mlet (((s m) (instantiate-constraint-synonym syn (mp-context-types c))))
		      (setf single (append single s))
		      (setf multi2 (append multi2 m))))
		  (setf multi2 (append multi2 (list c))))))))
	  (setf (signature-context signature) single)
	  (setf (signature-mcontext signature) multi2))))))

(define (constraint-family-context? class-ref)
  (let ((def (if (eq? (class-ref-class class-ref) *undefined-def*)
		 (resolve-toplevel-name (class-ref-name class-ref))
		 (class-ref-class class-ref))))
    ;; (one with its class is kept: a dictionary, type/mp-classes.mumble's
    ;; process-cfam-placeholder)
    (and def (synonym? def) (synonym-family? def)
	 (not (constraint-family-class def)))))

;;; A nullary synonym of the unit type, directly or through others:
;;; GHC.Stack's HasCallStack, safe's  type Partial = HasCallStack.  As a
;;; constraint it is the empty one (GHC's (() :: Constraint)).
(define (trivial-constraint? name depth)
  (trivial-constraint-def? (resolve-toplevel-name name) depth))

(define (trivial-constraint-def? def depth)
  (and (synonym? def) (> depth 0)
       (null? (synonym-args def))
       (let ((body (synonym-body def)))
	 (and (tycon? body)
	      (null? (tycon-args body))
	      (let ((d (tycon-def body)))
		(or (eq? d (core-symbol "UnitType"))
		    (trivial-constraint-def? d (1- depth))))))))

(define (constraint-synonym name)
  (let ((def (resolve-toplevel-name name)))
    (and (synonym? def) (not (null? (synonym-constraints def))) def)))

;;; The synonym's constraints with its parameters replaced by TYPES:
;;; returns the one-parameter contexts (on type variables) and the others.
(define (instantiate-constraint-synonym syn types)
  (let* ((n (length (synonym-args syn)))
	 (env (map (lambda (v ty) (tuple v ty)) (synonym-args syn) (list-head types (min n (length types)))))
	 ;; an eta-reduced synonym's further arguments (type GShow0 =
	 ;; GShow Proxy, at GShow0 (Rep a)) are its constraint's last
	 (extra (list-tail types (min n (length types))))
	 (single '())
	 (multi '()))
    (dolist (c (lisp:remove '|%true| (synonym-constraints syn) :key (function car)))
      (let ((args (append (map (lambda (a) (copy-synonym-body a env)) (cdr c))
			  extra)))
	(if (and (pair? args) (null? (cdr args)) (tyvar? (car args)))
	    (push (make context (class (make class-ref (name (car c))
					      (class *undefined-def*)))
			(tyvar (tyvar-name (car args))))
		  single)
	    (push (**mp-context (make class-ref (name (car c)) (class *undefined-def*))
				args)
		  multi))))
    (values (reverse single) (reverse multi))))

;;; f a, f a b, ... with f a type variable.
(define (tyvar-application? type)
  (and (tyapp? type) (tyvar? (tyapp-fun type))))
