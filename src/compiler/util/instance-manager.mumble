
;;; This file has some random utilities dealing with instances.

;;; Right now, this is a linear search off the class.

(define (lookup-instance alg-def class-def)
  (let ((res (lookup-instance-1 alg-def (class-instances class-def))))
    (cond ((not (eq? res '#f)) res)
	  ;; a data family (an instance on it wanting its superclass's)
	  ((data-family-def? alg-def)
	   (and (typeable-class? class-def)
		(get-typeable-instance alg-def class-def
				       (length (synonym-args alg-def)))))
	  ((algdata-real-tuple? alg-def)
	   (or (lookup-possible-tuple-instances alg-def class-def)
	       (and (typeable-class? class-def)
		    (get-typeable-instance alg-def class-def
					   (length (algdata-tyvars alg-def))))))
	  ((typeable-class? class-def)
	   (get-typeable-instance alg-def class-def (length (algdata-tyvars alg-def))))
	  (else '#f))))

;;; Data.Typeable: every type constructor is Typeable, as in GHC.  The
;;; instance for T a1 .. an, made when first wanted, has the context
;;; (Typeable a1, ..., Typeable an); its dictionary is Data.Typeable's
;;; primTypeableDict applied to T's name and the arguments' dictionaries
;;; (dict-ref-code, type/dictionary.mumble; the builder is
;;; prim.typeable-dict in base-runtime.lisp).

(define (typeable-class? class-def)
  (and (eq? (def-name class-def) '|Typeable|)
       (eq? (def-module class-def) '|Data.Typeable|)))

(define *saved-typeable-instances* '())

(define (get-typeable-instance alg class n)
  (let ((res (lisp:find-if (lambda (x)
			     (and (eq? (tuple-2-1 x) alg)
				  (eq? (instance-class (tuple-2-2 x)) class)
				  (eqv? (length (instance-tyvars (tuple-2-2 x))) n)))
			   *saved-typeable-instances*)))
    (if res
	(tuple-2-2 res)
	(and (typeable-dict-builder)
	     (let ((inst (make-tuple-instance-n
			  alg n class (typeable-dict-builder))))
	       (push (tuple alg inst) *saved-typeable-instances*)
	       inst)))))

(define (typeable-dict-builder)
  (let ((m (table-entry *modules* '|BasePrims|)))
    (and m (table-entry (module-symbol-table m) '|primTypeableDict|))))

(define (typeable-instance? inst)
  (and (instance-special? inst)
       (typeable-class? (instance-class inst))))

;;; The string a Typeable dictionary is made from: the defining module, a
;;; NUL, and the name its TypeRep shows (prim.typerep-name and
;;; prim.typerep-module in base-runtime.lisp take it apart).

(define (typeable-tycon-string alg)
  (string-append (symbol->string (def-module alg))
		 (make-string 1 (integer->char 0))
		 (typeable-tycon-name alg)))

;;; The name a Typeable instance's TypeRep shows for its type constructor.

(define (typeable-tycon-name alg)
  (cond ((eq? alg (core-symbol "List")) "[]")
	((eq? alg (core-symbol "Arrow")) "->")
	((eq? alg (core-symbol "UnitType")) "()")
	((algdata-real-tuple? alg)
	 (string-append "(" (make-string (1- (tuple-size alg)) #\,) ")"))
	(else (symbol->string (def-name alg)))))

(define (lookup-instance-1 alg-def instances)
  (cond ((null? instances)
	 '#f)
	((eq? (instance-algdata (car instances)) alg-def)
	 (if (instance-ok? (car instances))
	     (car instances)
	     '#f))
	(else
	 (lookup-instance-1 alg-def (cdr instances)))))

;;; Overlapping instances (GHC's OVERLAPPABLE/OVERLAPPING): a class may
;;; have several instances for one type constructor when their heads are
;;; flexible (instance Print [a] and instance Print [Imp]).  At a type,
;;; the most specific instance whose head matches it is used; while the
;;; arguments are undecided only the general one matches.  Specificity is
;;; the number of type constructors in the head.  Without the type (or
;;; with one instance) this is lookup-instance.

(define (lookup-instance/type alg-def class-def type)
  (if (and (typeable-class? class-def) (ntycon? type)
	   (null? (lookup-instance-1 alg-def (class-instances class-def))))
      ;; at T applied to fewer arguments than it takes (Typeable Maybe)
      (get-typeable-instance alg-def class-def (length (ntycon-args type)))
      (let ((inst (or (lookup-instance/type-1 alg-def class-def type)
		      (data-family-instance alg-def class-def)
		      (catch-all-instance class-def))))
	;; an instance at the type constructor whose head does not match
	;; (TextLike ShowS, String -> String, at Int -> D) gives way to the
	;; class's instance at an application (TextLike (m a)), as with GHC's
	;; overlapping instances (JHC's DocLike)
	(cond ((and inst (not (instance-catch-all? inst))
		    (not (null? (instance-head-args inst)))
		    (ntycon? type)
		    (not (instance-head-matches? inst type))
		    ;; (nor could, the type's arguments decided further:
		    ;; DocLike String's [Char] at [t1])
		    (not (some-instance-head-could-match? inst type))
		    (app-catch-all-instance class-def))
	       (app-catch-all-instance class-def))
	      ;; no instance for the type constructor: the class's at an
	      ;; application, for one applied to an argument (JHC's
	      ;; MonadSetSrcLoc m => WithSrcLoc (m a), at Ki ())
	      ((and (not inst) (ntycon? type)
		    (not (null? (ntycon-args type)))
		    (app-catch-all-instance class-def))
	       (app-catch-all-instance class-def))
	      (else inst)))))

(define (data-family-def? def)
  (and (synonym? def) (eq? (synonym-family? def) 'data)))

;;; TypeFamilies: an instance whose head is a data family (instance Show
;;; (Vector a)), when ALG-DEF is one of the family's data instances
;;; (Vector Int's); #f otherwise.  Its types are the family application
;;; the data instance stands for (data-instance-family-app).

(define (data-family-instance alg-def class-def)
  (and (algdata? alg-def)
       (lisp:find-if (lambda (i)
		       (and (instance-ok? i)
			    (data-family-def? (instance-algdata i))
			    (data-instance-equation (instance-algdata i) alg-def)))
		     (class-instances class-def))))

;;; The family's equation whose right side is the data instance ALG-DEF.
(define (data-instance-equation family alg-def)
  (lisp:find-if (lambda (eq)
		  (let ((rhs (tuple-2-2 eq)))
		    (and (tycon? rhs) (eq? (tycon-def rhs) alg-def))))
		(synonym-equations family)))

;;; TYPE, an application of a data instance of FAMILY, as the family
;;; application it stands for: Vec:2 for Vec Bool is Vec Bool.
(define (data-instance-family-app family type)
  (let* ((eq   (data-instance-equation family (ntycon-tycon type)))
	 (env  (map (lambda (v a) (tuple (tyvar-name v) a))
		    (tycon-args (tuple-2-2 eq)) (ntycon-args type))))
    (**ntycon family (map (lambda (a) (expand-ntype-synonym-1 a env))
			  (tuple-2-1 eq)))))

;;; The class's catch-all instance C a, or #f: used at a type no other
;;; instance is for (tdecl/instance.mumble's catch-all-instance->def).
(define (catch-all-instance class-def)
  ;; (C a before C (t a))
  (or (lisp:find-if (lambda (i) (and (instance-catch-all? i) (instance-ok? i)
				     (null? (cdr (instance-tyvars i)))))
		    (class-instances class-def))
      (lisp:find-if (lambda (i) (and (instance-catch-all? i) (instance-ok? i)))
		    (class-instances class-def))))

(define (lookup-instance/type-1 alg-def class-def type)
  (let ((all (lisp:remove-if-not
	      (lambda (i) (and (eq? (instance-algdata i) alg-def) (instance-ok? i)))
	      (class-instances class-def))))
    (if (or (null? all) (null? (cdr all)))
	(lookup-instance alg-def class-def)
	(let ((matching (lisp:remove-if-not
			 (lambda (i) (instance-head-matches? i type)) all)))
	  (if (null? matching)
	      (car all)
	      (let ((best (car matching)))
		(dolist (i (cdr matching))
		  (when (> (instance-specificity i) (instance-specificity best))
		    (setf best i)))
		best))))))

(define (instance-specificity inst)
  (lisp:reduce (function +) (map (function ast-type-tycon-count)
				 (instance-head-args inst))))

(define (ast-type-tycon-count type)
  (cond ((tycon? type)
	 (+ 1 (lisp:reduce (function +) (map (function ast-type-tycon-count)
					      (tycon-args type)))))
	((tyapp? type)
	 (+ (ast-type-tycon-count (tyapp-fun type))
	    (lisp:reduce (function +) (map (function ast-type-tycon-count)
					   (tyapp-args type)))))
	(else 0)))

(define (lookup-possible-tuple-instances alg-def class-def)
  (cond ((eq? class-def (core-symbol "Eq"))
	 (get-tuple-eq-instance alg-def))
	((eq? class-def (core-symbol "Ord"))
	 (get-tuple-ord-instance alg-def))
	((eq? class-def (core-symbol "Ix"))
	 (get-tuple-ix-instance alg-def))
	((eq? class-def (core-symbol "Text"))
	 (get-tuple-text-instance alg-def))
	((eq? class-def (core-symbol "Show"))
	 (get-tuple-show-instance alg-def))
	((eq? class-def (core-symbol "Read"))
	 (get-tuple-read-instance alg-def))
	((eq? class-def (core-symbol "Binary"))
	 (get-tuple-binary-instance alg-def))
	((and (haskell98?) (eq? class-def (core-symbol "Bounded")))
	 (get-tuple-bounded-instance alg-def))
	(else '#f)))

(define *saved-eq-instances* '())
(define *saved-ord-instances* '())
(define *saved-ix-instances* '())
(define *saved-text-instances* '())
(define *saved-binary-instances* '())
(define *saved-show-instances* '())
(define *saved-read-instances* '())
(define *saved-bounded-instances* '())

(define (get-tuple-eq-instance tpl)
  (let ((res (assq tpl *saved-eq-instances*)))
    (if (not (eq? res '#f))
	(tuple-2-2 res)
	(let ((inst (make-tuple-instance
		     tpl (core-symbol "Eq") (core-symbol "tupleEqDict"))))
	  (push (tuple tpl inst) *saved-eq-instances*)
	  inst))))

(define (get-tuple-ord-instance tpl)
  (let ((res (assq tpl *saved-ord-instances*)))
    (if (not (eq? res '#f))
	(tuple-2-2 res)
	(let ((inst (make-tuple-instance
		     tpl (core-symbol "Ord") (core-symbol "tupleOrdDict"))))
