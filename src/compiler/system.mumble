;;; system.mumble -- haskell system setup
;;;
;;; author :  Sandra Loosemore
;;; date   :  22 Nov 1991
;;;
;;; This file loads in the compilation unit definition files for all
;;; of the components of the haskell system.  
;;;
;;; (The compilation unit facility is defined in src/mumble/compile.mumble.)


;;; First load the files containing module definitions.
;;; *** Add more files to the end of this list.  

(load "$Y2/src/mumble/support")
(load "$Y2/src/compiler/ast/ast")
(load "$Y2/src/compiler/top/top")
(load "$Y2/src/compiler/util/haskell-utils")
(load "$Y2/src/compiler/printers/printers")
(load "$Y2/src/compiler/parser/parser")
(load "$Y2/src/compiler/import-export/ie.mumble")
(load "$Y2/src/compiler/tdecl/tdecl.mumble")
(load "$Y2/src/compiler/derived/derived.mumble")
(load "$Y2/src/compiler/prec/prec.mumble")
(load "$Y2/src/compiler/depend/depend.mumble")
(load "$Y2/src/compiler/type/type.mumble")
(load "$Y2/src/compiler/cfn/cfn.mumble")
(load "$Y2/src/compiler/flic/flic.mumble")
(load "$Y2/src/compiler/backend/backend.mumble")
(load "$Y2/src/runtime/runtime.mumble")
(load "$Y2/src/compiler/csys/csys")
(load "$Y2/src/compiler/command-interface/command-interface")

;;; Define some functions to actually do the work.  The compilation unit 
;;; facility has conveniently kept a list of all of the unit definitions,
;;; so we can just rip through them in sequence.

(define (compile-haskell)
  (compile-and-load-unit-list compilation-units))

(define (recompile-haskell)
  (unless (null? remaining-units)
    (compile-and-load-unit-list remaining-units)))


(define (load-haskell)
  (load-unit-list compilation-units))

(define (reload-haskell)
  (unless (null? remaining-units)
    (load-unit-list remaining-units)))
