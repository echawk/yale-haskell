;;; scope.mumble -- variable scoping and precedence parsing phase
;;; 
;;; author :  John & Sandra
;;; date   :  11 Feb 1992
;;;
;;;


;;;===================================================================
;;; Basic support
;;;===================================================================

(define (scope-modules modules)
  (walk-modules modules
    (lambda ()
      (setf (module-decls *module*) (scope-ast-decls (module-decls *module*)))
      (setf (module-foreign-code *module*)
	    (map (function scope-foreign-import) (module-foreign-imports *module*)))
      (dolist (a (module-annotations *module*))
;;; This is currently bogus since it assumes only vars are annotated.	      
	 (when (annotation-decl? a)
	   (dolist (n (annotation-decl-names a))
	      (let ((v (table-entry *symbol-table* n)))
		(when (or (eq? v '#f) (not (var? v)))
		  (fatal-error 'unknown-annotation-name
			       "~A: not a var in annotation decl~%" n))
		(when (not (eq? (def-module v) *module-name*))
		  (fatal-error 'non-local-name-in-annotation
			       "~A: not a local var in annotation decl~%" n))
		(setf (var-annotations v)
		      (append (var-annotations v)
			      (annotation-decl-annotations a))))))))))

;;; A foreign import's var gets its declared type here, and its Lisp
;;; entry (backend/interface-codegen.mumble), so that the type checker
;;; and the code for its callers treat it like a primitive.

(define (scope-foreign-import fi)
  (remember-context fi
    (let* ((signature  (foreign-import-signature fi))
	   (var        (var-ref-var (foreign-import-var fi))))
      (resolve-signature signature)
      (let ((gtype  (ast->gtype (signature-context signature)
				(signature-type signature))))
	(setf (var-signature var) gtype)
	(setf (var-type var) gtype)
	(setf (var-toplevel? var) '#t)
	(codegen-foreign-import var (foreign-import-entity fi))))))

;;; Define the basic walker and some helper functions.

(define-walker scope ast-td-scope-walker)

(define (scope-ast-1 x env)
;  (call-walker scope x env))
  (remember-context x
    (call-walker scope x env)))


(define (scope-ast/list l env)
  (scope-ast/list-aux l env)
  l)

(define (scope-ast/list-aux l env)
  (when (not (null? l))
    (setf (car l) (scope-ast-1 (car l) env))
    (scope-ast/list-aux (cdr l) env)))

;;; This filters out signdecls from decl lists.  These declarations are moved
;;; into the var definitions.

(define (scope-ast/decl-list l env)
  (cond ((null? l)
	 '())
	((is-type? 'fixity-decl (car l))
	 ;; Local fixity declarations were handled by add-local-declarations.
	 (scope-ast/decl-list (cdr l) env))
	(else
	 (scope-ast/decl-list-1 l env))))

(define (scope-ast/decl-list-1 l env)
      (let ((x (scope-ast-1 (car l) env))
	    (rest (scope-ast/decl-list (cdr l) env)))
	(if (or (annotation-decls? x)
		(and (signdecl? x)
		     (not (eq? (module-type *module*) 'interface))))
	    rest
	    (begin
	      (setf (car l) x)
	      (setf (cdr l) rest)
	      l))))

;;; This is the main entry point.  It is called by the driver
;;; on each top-level decl in the module.

(define (scope-ast-decls x)
  (let ((result  (scope-ast/decl-list x '())))
;    (pprint result)   ;*** debug
    result))


;;; All top-level names are entered in the *symbol-table* hash table.
;;; This is done by the import/export phase of the compiler before
;;; we get here.
;;; The env is a list of a-lists that associates locally-defined names with
;;; their definitions.  Each nested a-list corresponds to a "level" or
;;; scope.
;;; *** If many variables are being added in each scope, it might be
;;; *** better to use a table instead of an alist to represent each contour.

(define (lookup-name name env)
  (if (null? env)
      (begin
	(let ((clash  (name-clash name)))
	  (when clash
	    (signal-ambiguous-name name clash)))
	(lookup-toplevel-name name))
      (let ((info  (assq name (car env))))
	(if info
	    (cdr info)
	    (lookup-name name (cdr env))))))


;;; H98 5.5.2: a name that is both defined in the module and imported, or
;;; imported as different entities, must be used qualified.

(define (signal-ambiguous-name name candidates)
  (phase-error 'ambiguous-name
    "Ambiguous occurrence ~A: it could refer to ~A.~%Use a qualified name."
    name candidates))

;;; Some kinds of names (e.g. type definitions) appear only at top-level,
;;; so use this to look for them directly.

(define (lookup-toplevel-name name)
  (or (resolve-toplevel-name name)
      (begin
        (signal-undefined-symbol name)
	*undefined-def*)))


;;; Some kinds of lookups (e.g., matching a signature declaration)
;;; require that the name be defined in the current scope and not
;;; an outer one.  Use this function.

(define (lookup-local-name name env)
  (if (null? env)
      (lookup-toplevel-name name)
      (let ((info  (assq name (car env))))
	(if info
	    (cdr info)
	    (begin
	      (signal-undefined-local-symbol name)
	      *undefined-def*)))))


;;; Add local declarations to the environment, returning a new env.
;;; Do not actually walk the local declarations here.

(define *scope-info* '())

(define (add-local-declarations decls env)
  (if (null? decls)
      env
      (let ((contour   '()))
	(dolist (d decls)
	  (if (is-type? 'valdef d)
	      (setf contour
		    (add-bindings (collect-pattern-vars (valdef-lhs d))
				  contour))))
	(dolist (d decls)
	  (when (is-type? 'fixity-decl d)
	    (attach-local-fixity d contour)))
	(cons contour env))))

;;; A fixity declaration in a let, where or class body (H98) applies to
;;; names bound in the same declaration list.  The defs are created here,
;;; before any expression in their scope is precedence parsed.

(define (attach-local-fixity fixity-decl contour)
  (remember-context fixity-decl
    (dolist (op (fixity-decl-names fixity-decl))
      (let ((info (assq op contour)))
	(if info
	    (setf (var-fixity (cdr info)) (fixity-decl-fixity fixity-decl))
	    (signal-fixity-without-binding op))))))

(define (signal-fixity-without-binding name)
  (phase-error 'fixity-without-binding
    "The fixity declaration for ~a is not in the same declaration list as its definition."
    name))


;;; Similar, but for adding lambda and function argument bindings to the
;;; environment.

(define (add-pattern-variables patterns env)
  (if (null? patterns)
      env
      (let ((contour   '()))
	(dolist (p patterns)
	  (setf contour (add-bindings (collect-pattern-vars p) contour)))
	(cons contour env))))


;;; Given a list of var-refs, create defs for them and add them to
;;; the local environment.
;;; Also check to see that there are no duplicates.

(define (add-bindings var-refs contour)
  (dolist (v var-refs)
   (when (eq? (var-ref-var v) *undefined-def*)
    (let* ((name     (var-ref-name v))
	   (def      (create-local-definition name)))
      (setf (var-ref-var v) def)
      (if (assq name contour)
	  (signal-multiple-bindings name)
	  (push (cons name def) contour)))))
  contour)


;;; Error signalling utilities.

(define (signal-undefined-local-symbol name)
  (phase-error 'undefined-local-symbol
    "The name ~a has no definition in the current scope."
    name))

(define (signal-multiple-signatures name)
  (phase-error 'multiple-signatures
    "There are multiple signatures for the name ~a."
    name))

(define (signal-multiple-bindings name)
  (phase-error 'multiple-bindings
    "The name ~a appears more than once in a function or pattern binding."
    name))
  


;;;===================================================================
;;; Default traversal methods
;;;===================================================================


(define-local-syntax (make-scope-code slot type)
  (let ((stype  (sd-type slot))
	(sname  (sd-name slot)))
    (cond ((and (symbol? stype)
		(or (eq? stype 'exp)
		    (subtype? stype 'exp)))
	   `(setf (struct-slot ',type ',sname object)
		  (scope-ast-1 (struct-slot ',type ',sname object) env)))
	  ((and (pair? stype)
		(eq? (car stype) 'list)
		(symbol? (cadr stype))
		(or (eq? (cadr stype) 'exp)
		    (subtype? (cadr stype) 'exp)))
	   `(setf (struct-slot ',type ',sname object)
		  (scope-ast/list (struct-slot ',type ',sname object) env)))
	  (else
;	   (format '#t "Scope: skipping slot ~A in ~A~%"
;		   (sd-name slot)
;		   type)
	   '#f))))


(define-modify-walker-methods scope
 (if           ; exp slots
   app          ; exp slots
   integer-const float-const char-const string-const  ; no slots
   list-exp     ; (list exp) slot
   sequence sequence-to sequence-then sequence-then-to ; exp slots
   section-l section-r ; exp slots
   omitted-guard overloaded-var-ref ; no slots
   negate ; no slots
   sel
   prim-definition
   con-number cast
   )
  (object env)
  make-scope-code)


;;;===================================================================
;;; valdef-structs
;;;===================================================================


;;; Signature declarations must appear at the same level as the names
;;; they apply to.  There must not be more than one signature declaration
;;; applying to a given name.

(define-walker-method scope signdecl (object env)
  (let ((signature  (signdecl-signature object)))
    (resolve-signature signature)
    (let ((gtype (ast->gtype (signature-context signature)
			     (signature-type signature))))
      (dolist (v (signdecl-vars object))
	(when (eq? (var-ref-var v) *undefined-def*)
	      (setf (var-ref-var v)
		    (lookup-local-name (var-ref-name v) env)))
	(let ((def  (var-ref-var v)))
	  (when (not (eq? def *undefined-def*))
	    ;; The lookup-local-name may fail if there is a program error.
	    ;; In that case, skip this.
	    (if (var-signature def)
		(signal-multiple-signatures (var-ref-name v))
		(setf (var-signature def) gtype))))))
    object))

;;; This attaches annotations to locally defined vars in the same
;;; manner as signdecl annotations.

(define-walker-method scope annotation-decls (object env)
  (let ((anns (annotation-decls-annotations object)))
    (dolist (a anns)
      (cond ((annotation-value? a)
	     (recoverable-error 'unknown-annotation "Unknown annotation: ~A" a))
	    ((annotation-decl? a)
	     (dolist (v (annotation-decl-names a))
	       (let ((name (lookup-local-name v env)))
		 (when (not (eq? name *undefined-def*))
		   (setf (var-annotations name)
			 (append (var-annotations name)
			      (annotation-decl-annotations a))))))))))
  object)

(define-walker-method scope exp-sign (object env)
  (resolve-signature (exp-sign-signature object))
  (setf (exp-sign-exp object) (scope-ast-1 (exp-sign-exp object) env))
  object)

;;; By the time we get to walking a valdef, all the variables it
;;; declares have been entered into the environment.  All we need to
;;; do is massage the pattern and recursively walk the definitions.

(define-walker-method scope valdef (object env)
  (setf (valdef-module object) *module-name*)
  (setf (valdef-lhs object) (massage-pattern (valdef-lhs object)))
  (setf (valdef-definitions object)
	(scope-ast/list (valdef-definitions object) env))
  object)


;;; For a single-fun-def, do the where-decls first, and then walk the
;;; rhs in an env that includes both the where-decls and the args.

(define-walker-method scope single-fun-def (object env)
  (setf env (add-pattern-variables (single-fun-def-args object) env))
  (setf env (add-local-declarations (single-fun-def-where-decls object) env))
  (setf (single-fun-def-where-decls object)
	(scope-ast/decl-list (single-fun-def-where-decls object) env))
  (setf (single-fun-def-args object)
	(massage-pattern-list (single-fun-def-args object)))
  (setf (single-fun-def-rhs-list object)
	(scope-ast/list (single-fun-def-rhs-list object) env))
  object)


;;;===================================================================
;;; exp-structs
;;;===================================================================

(define-walker-method scope lambda (object env)
  (setf env (add-pattern-variables (lambda-pats object) env))
  (setf (lambda-pats object) (massage-pattern-list (lambda-pats object)))
  (setf (lambda-body object) (scope-ast-1 (lambda-body object) env))
  object)

(define-walker-method scope let (object env)
  (setf env (add-local-declarations (let-decls object) env))
  (setf (let-decls object) (scope-ast/decl-list (let-decls object) env))
  (setf (let-body object) (scope-ast-1 (let-body object) env))
  object)


;;; The bindings of a pattern guard's quals scope over the later quals
;;; and the rhs.

(define-walker-method scope guarded-rhs (object env)
  (let ((guard  (guarded-rhs-guard object)))
    (if (is-type? 'pattern-guard guard)
	(dolist (q (pattern-guard-quals guard))
	  (cond ((is-type? 'qual-generator q)
		 (setf (qual-generator-exp q)
		       (scope-ast-1 (qual-generator-exp q) env))
		 (setf env
		       (add-pattern-variables (list (qual-generator-pat q)) env))
		 (setf (qual-generator-pat q)
		       (massage-pattern (qual-generator-pat q))))
		((is-type? 'qual-filter q)
		 (setf (qual-filter-exp q)
		       (scope-ast-1 (qual-filter-exp q) env)))
		(else
		 (setf env (add-local-declarations (qual-let-decls q) env))
		 (setf (qual-let-decls q)
		       (scope-ast/decl-list (qual-let-decls q) env)))))
	(setf (guarded-rhs-guard object) (scope-ast-1 guard env)))
    (setf (guarded-rhs-rhs object) (scope-ast-1 (guarded-rhs-rhs object) env))
    object))

;;; Case alts are treated very much like single-fun-defs.

(define-walker-method scope case (object env)
  (setf (case-exp object) (scope-ast-1 (case-exp object) env))
  (dolist (a (case-alts object))
    (let ((env  (add-pattern-variables (list (alt-pat a)) env)))
      (setf env (add-local-declarations (alt-where-decls a) env))
      (setf (alt-where-decls a)
	    (scope-ast/decl-list (alt-where-decls a) env))
      (setf (alt-pat a) (massage-pattern (alt-pat a)))
      (setf (alt-rhs-list a)
	    (scope-ast/list (alt-rhs-list a) env))))
  object)


(define-walker-method scope var-ref (object env)
  (when (eq? (var-ref-var object) *undefined-def*)
	(setf (var-ref-var object)
	      (lookup-name (var-ref-name object) env)))
  object)

(define-walker-method scope con-ref (object env)
  (declare (ignore env))
  (when (eq? (con-ref-con object) *undefined-def*)
	(setf (con-ref-con object)
	      (lookup-toplevel-name (con-ref-name object))))
  object)

(define-walker-method scope list-comp (object env)
  (dolist (q (list-comp-quals object))
    (cond ((is-type? 'qual-generator q)
	   (setf (qual-generator-exp q)
		 (scope-ast-1 (qual-generator-exp q) env))
	   (setf env
		 (add-pattern-variables (list (qual-generator-pat q)) env))
	   (setf (qual-generator-pat q)
		 (massage-pattern (qual-generator-pat q))))
	  ((is-type? 'qual-filter q)
	   (setf (qual-filter-exp q)
		 (scope-ast-1 (qual-filter-exp q) env)))))
  (setf (list-comp-exp object) (scope-ast-1 (list-comp-exp object) env))
  object)

;;; do expressions are translated here, after parsing and before their
;;; parts are scoped, because the translation depends on whether a
;;; generator's pattern can fail, which needs the constructors resolved
;;; (report 3.14):
;;;   do {e}                = e
;;;   do {e; stmts}         = e >> do {stmts}
;;;   do {p <- e; stmts}    = e >>= \p -> do {stmts}          p failure-free
;;;                         = e >>= \v -> case v of
;;;                              p -> do {stmts}; _ -> fail "..."  otherwise
;;;   do {let decls; stmts} = let decls in do {stmts}
;;; `fail' is a method of Monad in Haskell 98; before that the failure
;;; case is `zero' of class MonadZero (feature monad-fail).

(define-walker-method scope do-exp (object env)
  (scope-ast-1 (desugar-do (do-exp-stmts object)) env))

(define (desugar-do stmts)
  (cond ((null? stmts)
	 (signal-bad-do "A do expression has no statements.")
	 (**con/def (core-symbol "UnitConstructor")))
	((null? (cdr stmts))
	 (if (is-type? 'qual-filter (car stmts))
	     (qual-filter-exp (car stmts))
	     (begin
	       (signal-bad-do "The last statement of a do expression must be an expression.")
	       (**con/def (core-symbol "UnitConstructor")))))
	(else
	 (let ((stmt (car stmts))
	       (rest (desugar-do (cdr stmts))))
	   (cond ((is-type? 'qual-filter stmt)
		  (**app (**var/def (core-symbol ">>")) (qual-filter-exp stmt) rest))
		 ((is-type? 'qual-let stmt)
		  (**let (qual-let-decls stmt) rest))
		 (else
		  (desugar-do-bind (qual-generator-pat stmt)
				   (qual-generator-exp stmt)
				   rest)))))))

(define (desugar-do-bind pat exp rest)
  (let ((pat (massage-pattern pat))
	(bind (**var/def (core-symbol ">>="))))
    (if (failure-free-pattern? pat)
	(**app bind exp (make lambda (pats (list pat)) (body rest)))
	(let ((v1 (make var-ref (name '|do-v|) (infix? '#f)
			(var *undefined-def*)))
	      (v2 (make var-ref (name '|do-v|) (infix? '#f)
			(var *undefined-def*))))
	  (**app bind exp
		 (make lambda
		       (pats (list (make var-pat (var v1))))
		       (body (**case v2
				     (list (**alt/simple pat rest)
					   (**alt/simple
					    (**wildcard-pat)
					    (do-failure-exp)))))))))))

(define (do-failure-exp)
  (if (feature? 'monad-fail)
      (**app (**var/def (core-symbol "fail"))
	     (**string "Pattern match failure in do expression"))
      (**var/def (core-symbol "zero"))))

;;; A failure-free pattern can be refuted only by bottom: irrefutable
;;; patterns, and constructors of single-constructor types applied to
;;; failure-free patterns.

(define (failure-free-pattern? pat)
  (cond ((or (var-pat? pat) (wildcard-pat? pat) (is-type? 'irr-pat pat))
	 '#t)
	((is-type? 'as-pat pat)
	 (failure-free-pattern? (as-pat-pattern pat)))
	((pcon? pat)
	 (let ((con (pcon-con pat)))
	   (or (eq? con (core-symbol "UnitConstructor"))
	       (and (con? con)
		    (algdata? (con-alg con))
		    (eqv? (algdata-n-constr (con-alg con)) 1)
		    (every (function failure-free-pattern?) (pcon-pats pat))))))
	(else '#f)))

(define (signal-bad-do message)
  (phase-error 'bad-do "~A" message))

(define-walker-method scope pp-exp-list (object env)
  (massage-pp-exp-list (scope-ast/list (pp-exp-list-exps object) env)))


;;; Records (report 3.15).  Construction, update and record patterns are
;;; translated here, once constructors and field names can be resolved;
;;; the type checker sees only the translation.
;;;   C {f = e, ...}   = C e1 ... en, where ei is the value given for the
;;;                      field at position i, or an error for a missing one
;;;   e {f = v, ...}   = case e of C x1 ... xn -> C x1 ... v ... xn; ...
;;;                      for each constructor C that has all the fields
;;;   C {f = p, ...}   = C _ ... p ... _   (a pattern)
;;; Field names are top-level names; local variables do not hide them.

(define-walker-method scope record-con (object env)
  (scope-ast-1 (desugar-record-con object) env))

(define-walker-method scope record-update (object env)
  (scope-ast-1 (desugar-record-update object) env))

(define (desugar-record-con object)
  (let* ((con-ref (record-con-con object))
	 (con (lookup-toplevel-name (con-ref-name con-ref)))
	 (binds (resolve-field-bindings (record-con-fields object))))
    (if (not (con? con))
	(**abort "Bad record construction")
	(begin
	  (check-fields-of-con binds con)
	  (**app/l (**con/def con)
		   (record-con-args con binds))))))

(define (record-con-args con binds)
  (let ((labels (con-field-labels con))
	(strict (con-slot-strict? con))
	(args '()))
    (dotimes (i (con-arity con))
      (let* ((field (if (null? labels) '#f (list-ref labels i)))
	     (bind (and field (assq field binds))))
	(push (cond (bind (tuple-2-2 bind))
		    (else
		     (when (and (pair? strict) (list-ref strict i))
		       (phase-error 'missing-strict-field
			 "The strict field ~A of ~A is missing in a record construction."
			 (if field (def-name field) i)
			 (remove-con-prefix (symbol->string (def-name con)))))
		     (**abort
		      (format '#f "Missing field ~A in record construction ~A"
			      (if field (def-name field) "")
			      (remove-con-prefix (symbol->string (def-name con)))))))
	      args)))
    (reverse args)))

(define (desugar-record-update object)
  (let* ((binds (resolve-field-bindings (record-update-fields object)))
	 (alg (fields-algdata binds)))
    (if (eq? alg '#f)
	(**abort "Bad record update")
	(let ((alts '())
	      (complete? '#t))
	  (dolist (con (algdata-constrs alg))
	    (if (every (lambda (b) (field-position (tuple-2-1 b) con)) binds)
		(let ((vars (update-vars (con-arity con))))
		  (push (**alt/simple
			 (**pcon/def con (map (function **pat) vars))
			 (**app/l (**con/def con)
				  (update-args con vars binds)))
			alts))
		(setf complete? '#f)))
	  (when (null? alts)
	    (phase-error 'no-constructor-with-fields
	      "No constructor of ~A has all the fields of a record update."
	      (def-name alg)))
	  (when (not complete?)
	    (push (**alt/simple (**wildcard-pat)
				(**abort "No match in record update"))
		  alts))
	  (**case (record-update-exp object) (reverse alts))))))

(define (update-vars n)
  (do ((i n (1- i))
       (vars '() (cons (string->symbol (format '#f "upd%~A" i)) vars)))
      ((eqv? i 0) vars)))

(define (update-args con vars binds)
  (let ((labels (con-field-labels con)))
    (map (lambda (v label)
	   (let ((bind (assq label binds)))
	     (if bind (tuple-2-2 bind) (**var v))))
	 vars labels)))

;;; The datatype of the fields being updated; they must all belong to one.

(define (fields-algdata binds)
  (let ((alg '#f))
    (dolist (b binds)
      (let ((a (var-field-alg (tuple-2-1 b))))
	(cond ((eq? alg '#f) (setf alg a))
	      ((not (eq? alg a))
	       (phase-error 'mixed-record-update
		 "The fields of a record update belong to different types.")))))
    alg))

;;; Resolve the field names of (tuple var-ref item) bindings: returns a
;;; list of (tuple field-var item).  Unknown names and duplicates are
;;; errors (and are dropped).

(define (resolve-field-bindings bindings)
  (let ((result '()))
    (dolist (b bindings)
      (let* ((name (var-ref-name (tuple-2-1 b)))
	     (def (lookup-toplevel-name name)))
	(cond ((eq? def *undefined-def*))
	      ((not (and (var? def) (var-field-alg def)))
	       (phase-error 'not-a-field "~A is not a record field." name))
	      ((assq def result)
	       (phase-error 'duplicate-field
		 "The field ~A is given more than once." name))
	      (else
	       (push (tuple def (tuple-2-2 b)) result)))))
    (reverse result)))

(define (check-fields-of-con binds con)
  (dolist (b binds)
    (when (not (field-position (tuple-2-1 b) con))
      (phase-error 'field-not-in-constructor
	"The constructor ~A has no field ~A."
	(remove-con-prefix (symbol->string (def-name con)))
	(def-name (tuple-2-1 b))))))

;;; C {f = p, ...} as a pattern; called by massage-pattern.  The field
;;; patterns are massaged by the caller.

(define (desugar-record-pat pat)
  (let* ((pcon (record-pat-con pat))
	 (con (if (eq? (pcon-con pcon) *undefined-def*)
		  (lookup-toplevel-name (pcon-name pcon))
		  (pcon-con pcon)))
	 (binds (resolve-field-bindings (record-pat-fields pat))))
    (setf (pcon-con pcon) con)
    (when (con? con)
      (check-fields-of-con binds con)
      (setf (pcon-pats pcon)
	    (let ((labels (con-field-labels con))
		  (pats '()))
	      (dotimes (i (con-arity con))
		(let ((bind (and (pair? labels)
				 (assq (list-ref labels i) binds))))
		  (push (if bind (tuple-2-2 bind) (**wildcard-pat)) pats)))
	      (reverse pats))))
    pcon))
