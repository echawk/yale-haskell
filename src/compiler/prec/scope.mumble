;;; scope.mumble -- variable scoping and precedence parsing phase
;;; 
;;; author :  John & Sandra
;;; date   :  11 Feb 1992
;;;
;;;


;;;===================================================================
;;; Basic support
;;;===================================================================

(define (scope-modules modules)
  (walk-modules modules
    (lambda ()
      (register-local-pattern-synonyms)
      (setf (module-decls *module*) (scope-ast-decls (module-decls *module*)))
      (setf (module-foreign-code *module*)
	    (map (function scope-foreign-import) (module-foreign-imports *module*)))
      (dolist (a (module-annotations *module*))
;;; This is currently bogus since it assumes only vars are annotated.	      
	 (when (annotation-decl? a)
	   (dolist (n (annotation-decl-names a))
	      (let ((v (table-entry *symbol-table* n)))
		(when (or (eq? v '#f) (not (var? v)))
		  (fatal-error 'unknown-annotation-name
			       "~A: not a var in annotation decl~%" n))
		(when (not (eq? (def-module v) *module-name*))
		  (fatal-error 'non-local-name-in-annotation
			       "~A: not a local var in annotation decl~%" n))
		(setf (var-annotations v)
		      (append (var-annotations v)
			      (annotation-decl-annotations a))))))))))

;;; PatternSynonyms: each of the module's synonyms, resolved, as a
;;; template on its builder's def, for other modules
;;; (parser/pattern-parser.mumble).

(define (register-local-pattern-synonyms)
  (dolist (syn (module-pattern-synonyms *module*))
    (let ((def (resolve-toplevel-name (pattern-builder-name (car syn)))))
      (when (not (eq? def '#f))
	(let ((template
	       (make-pattern-synonym-template
		(cadr syn)
		(massage-pattern
		 ;; a template has no signature patterns: its parameters are
		 ;; typed through the pattern%P%argI functions, if any
		 (instantiate-pattern-synonym
		  (list (car syn) (cadr syn) (caddr syn))
		  (pattern-synonym-typed-args
		   syn
		   (map (lambda (v) (make var-pat (var (generated-var-ref v))))
			(cadr syn))))))))
	  (when template
	    (register-pattern-synonym def template)))))))

;;; A foreign import's var gets its declared type here, and its Lisp
;;; entry (backend/interface-codegen.mumble), so that the type checker
;;; and the code for its callers treat it like a primitive.

(define (scope-foreign-import fi)
  (remember-context fi
    (let* ((signature  (foreign-import-signature fi))
	   (var        (var-ref-var (foreign-import-var fi))))
      (resolve-signature signature)
      (let ((gtype  (ast->gtype (signature-context signature)
				(signature-type signature))))
	(setf (var-signature var) gtype)
	(setf (var-type var) gtype)
	(setf (var-toplevel? var) '#t)
	(codegen-foreign-import var (foreign-import-entity fi))))))

;;; Define the basic walker and some helper functions.

(define-walker scope ast-td-scope-walker)

(define (scope-ast-1 x env)
;  (call-walker scope x env))
  (remember-context x
    (call-walker scope x env)))


(define (scope-ast/list l env)
  (scope-ast/list-aux l env)
  l)

(define (scope-ast/list-aux l env)
  (when (not (null? l))
    (setf (car l) (scope-ast-1 (car l) env))
    (scope-ast/list-aux (cdr l) env)))

;;; This filters out signdecls from decl lists.  These declarations are moved
;;; into the var definitions.

(define (scope-ast/decl-list l env)
  (cond ((null? l)
	 '())
	((is-type? 'fixity-decl (car l))
	 ;; Local fixity declarations were handled by add-local-declarations.
	 (scope-ast/decl-list (cdr l) env))
	(else
	 (scope-ast/decl-list-1 l env))))

(define (scope-ast/decl-list-1 l env)
      (let ((x (scope-ast-1 (car l) env))
	    (rest (scope-ast/decl-list (cdr l) env)))
	(if (or (annotation-decls? x)
		(and (signdecl? x)
		     (not (eq? (module-type *module*) 'interface))))
	    rest
	    (begin
	      (setf (car l) x)
	      (setf (cdr l) rest)
	      l))))

;;; This is the main entry point.  It is called by the driver
;;; on each top-level decl in the module.

(define (scope-ast-decls x)
  (let ((result  (scope-ast/decl-list x '())))
;    (pprint result)   ;*** debug
    result))


;;; All top-level names are entered in the *symbol-table* hash table.
;;; This is done by the import/export phase of the compiler before
;;; we get here.
;;; The env is a list of a-lists that associates locally-defined names with
;;; their definitions.  Each nested a-list corresponds to a "level" or
;;; scope.
;;; *** If many variables are being added in each scope, it might be
;;; *** better to use a table instead of an alist to represent each contour.

(define (lookup-name name env)
  (if (null? env)
      (begin
	(let ((clash  (name-clash name)))
	  (when clash
	    (signal-ambiguous-name name clash)))
	(lookup-toplevel-name name))
      (let ((info  (assq name (car env))))
	(if info
	    (cdr info)
	    (lookup-name name (cdr env))))))


;;; H98 5.5.2: a name that is both defined in the module and imported, or
;;; imported as different entities, must be used qualified.

(define (signal-ambiguous-name name candidates)
  (phase-error 'ambiguous-name
    "Ambiguous occurrence ~A: it could refer to ~A.~%Use a qualified name."
    name candidates))

;;; Some kinds of names (e.g. type definitions) appear only at top-level,
;;; so use this to look for them directly.

(define (lookup-toplevel-name name)
  (or (resolve-toplevel-name name)
      (cond ((not (and (dynamic *splice-parent*)
		       (defined-in-module? name (dynamic *splice-parent*))))
	     (signal-undefined-symbol name)
	     *undefined-def*)
	    ((dynamic *scoping-quote?*)
	     ;; quoted, not run: the module's own name (th/quote.mumble gives
	     ;; it its NameG, which the module resolves to its own)
	     (splice-parent-def name (dynamic *splice-parent*)))
	    (else
	     (signal-stage-restriction name)
	     *undefined-def*))))


;;; The module whose splice is being run, if any: a splice may use only
;;; imported functions, so a name the module defines is not in scope in
;;; the splice's fragment (GHC's stage restriction).

(define *splice-parent* '#f)

(define (defined-in-module? name mod)
  (or (lisp:some (lambda (d)
		   (and (valdef? d)
			(lisp:some (lambda (v) (eq? (var-ref-name v) name))
				   (collect-pattern-vars (valdef-lhs d)))))
		 (module-decls mod))
      (lisp:some (lambda (dd)
		   (lisp:some (lambda (c)
				(eq? (con-ref-name (constr-constructor c)) name))
			      (data-decl-constrs dd)))
		 (module-algdatas mod))))

;;; Does MOD define NAME, a type or class (KIND #\t), a constructor (#\d)
;;; or a variable?
(define (parent-defines? kind name mod)
  (cond ((char=? kind #\t)
	 (let ((c (add-con-prefix/symbol name)))
	   (or (lisp:some (lambda (dd) (memq (tycon-name (data-decl-simple dd)) (list name c)))
			  (module-algdatas mod))
	       (lisp:some (lambda (sd) (memq (tycon-name (synonym-decl-simple sd)) (list name c)))
			  (module-synonyms mod))
	       (lisp:some (lambda (cd) (memq (class-ref-name (class-decl-class cd)) (list name c)))
			  (module-classes mod)))))
	((char=? kind #\d) (defined-in-module? (add-con-prefix/symbol name) mod))
	(else (defined-in-module? name mod))))

(define (splice-parent-def name mod)
  (if (has-con-prefix? (symbol->string name))
      (make con (name name) (module (module-name mod)) (unit (module-name mod)))
      (make var (name name) (module (module-name mod)) (unit (module-name mod)))))

(define (signal-stage-restriction name)
  (phase-error 'stage-restriction
    "~A is defined in this module: a splice may use only imported functions~%~
     (Template Haskell's stage restriction).  Move it to another module."
    name))

(define (resolve-th-global-name name)
  (mlet (((occ modname) (split-qualified-name name)))
    (cond ((eq? modname '#f) '#f)
	  ((string-starts? "GHC.Internal." (symbol->string modname))
	   (table-entry *core-symbols* occ))
	  (else
	   (let ((m (table-entry *modules* modname)))
	     (and m (table-entry (module-symbol-table m) occ)))))))

;;; Some kinds of lookups (e.g., matching a signature declaration)
;;; require that the name be defined in the current scope and not
;;; an outer one.  Use this function.

(define (lookup-local-name name env)
  (if (null? env)
      (lookup-toplevel-name name)
      (let ((info  (assq name (car env))))
	(if info
	    (cdr info)
	    (begin
	      (signal-undefined-local-symbol name)
	      *undefined-def*)))))


;;; Add local declarations to the environment, returning a new env.
;;; Do not actually walk the local declarations here.

(define *scope-info* '())

(define (add-local-declarations decls env)
  (lift-binding-views! decls)
  (if (null? decls)
      env
      (let ((contour   '()))
	(dolist (d decls)
	  (if (is-type? 'valdef d)
	      (setf contour
		    (add-bindings (collect-pattern-vars (valdef-lhs d))
				  contour))))
	(dolist (d decls)
	  (when (is-type? 'fixity-decl d)
	    (attach-local-fixity d contour)))
	(cons contour env))))

;;; A pattern binding whose pattern (a pattern synonym's) has view
;;; patterns, let !(SBS arr) = e: each view becomes a variable v, and a
;;; binding pat = f v follows, as lazy as the first.  DECLS is changed
;;; in place (the bindings appended), before its variables are collected.

(define (lift-binding-views! decls)
  (let ((extra '()))
    (dolist (d decls)
      (when (and (is-type? 'valdef d)
		 (not (is-type? 'var-pat (valdef-lhs d)))
		 (lisp:every (lambda (f) (null? (single-fun-def-args f)))
			     (valdef-definitions d)))
	(let ((views (lift-view-pats (list (massage-pattern (valdef-lhs d))))))
	  (when (pair? (cdr views))
	    (setf (valdef-lhs d) (car (car views)))
	    (dolist (v (cdr views))
	      (push (**valdef/pat (caddr v)
				  (make app (fn (cadr v)) (arg (generated-var-ref (car v)))))
		    extra))))))
    (when (pair? extra)
      (setf (cdr (lisp:last decls)) (reverse extra)))))

;;; A fixity declaration in a let, where or class body (H98) applies to
;;; names bound in the same declaration list.  The defs are created here,
;;; before any expression in their scope is precedence parsed.

(define (attach-local-fixity fixity-decl contour)
  (remember-context fixity-decl
    (dolist (op (fixity-decl-names fixity-decl))
      (let ((info (assq op contour)))
	(if info
	    (setf (var-fixity (cdr info)) (fixity-decl-fixity fixity-decl))
	    (signal-fixity-without-binding op))))))

(define (signal-fixity-without-binding name)
  (phase-error 'fixity-without-binding
    "The fixity declaration for ~a is not in the same declaration list as its definition."
    name))


;;; Similar, but for adding lambda and function argument bindings to the
;;; environment.

(define (add-pattern-variables patterns env)
  (if (null? patterns)
      env
      (let ((contour   '()))
	(dolist (p patterns)
	  (setf contour (add-bindings (collect-pattern-vars p) contour)))
	(cons contour env))))


;;; Given a list of var-refs, create defs for them and add them to
;;; the local environment.
;;; Also check to see that there are no duplicates.

(define (add-bindings var-refs contour)
  (dolist (v var-refs)
   (when (eq? (var-ref-var v) *undefined-def*)
    (let* ((name     (var-ref-name v))
	   (def      (create-local-definition name)))
      (setf (var-ref-var v) def)
      (if (assq name contour)
	  (signal-multiple-bindings name)
	  (push (cons name def) contour)))))
  contour)


;;; Error signalling utilities.

(define (signal-undefined-local-symbol name)
  (phase-error 'undefined-local-symbol
    "The name ~a has no definition in the current scope."
    name))

(define (signal-multiple-signatures name)
  (phase-error 'multiple-signatures
    "There are multiple signatures for the name ~a."
    name))

(define (signal-multiple-bindings name)
  (phase-error 'multiple-bindings
    "The name ~a appears more than once in a function or pattern binding."
    name))
  


;;;===================================================================
;;; Default traversal methods
;;;===================================================================


(define-local-syntax (make-scope-code slot type)
  (let ((stype  (sd-type slot))
	(sname  (sd-name slot)))
    (cond ((and (symbol? stype)
		(or (eq? stype 'exp)
		    (subtype? stype 'exp)))
	   `(setf (struct-slot ',type ',sname object)
		  (scope-ast-1 (struct-slot ',type ',sname object) env)))
	  ((and (pair? stype)
		(eq? (car stype) 'list)
		(symbol? (cadr stype))
		(or (eq? (cadr stype) 'exp)
		    (subtype? (cadr stype) 'exp)))
	   `(setf (struct-slot ',type ',sname object)
		  (scope-ast/list (struct-slot ',type ',sname object) env)))
	  (else
;	   (format '#t "Scope: skipping slot ~A in ~A~%"
;		   (sd-name slot)
;		   type)
	   '#f))))


(define-modify-walker-methods scope
 (if           ; exp slots
   app          ; exp slots
   integer-const float-const char-const string-const  ; no slots
   list-exp     ; (list exp) slot
   sequence sequence-to sequence-then sequence-then-to ; exp slots
   section-l section-r ; exp slots
   omitted-guard overloaded-var-ref ; no slots
   negate ; no slots
   sel
   prim-definition
   con-number cast
   )
  (object env)
  make-scope-code)


;;;===================================================================
;;; valdef-structs
;;;===================================================================


;;; Signature declarations must appear at the same level as the names
;;; they apply to.  There must not be more than one signature declaration
;;; applying to a given name.

(define-walker-method scope signdecl (object env)
  (let ((signature  (signdecl-signature object)))
    (resolve-signature signature)
    (let ((gtype (signature->gtype signature)))
      (dolist (v (signdecl-vars object))
	(when (eq? (var-ref-var v) *undefined-def*)
	      (setf (var-ref-var v)
		    (lookup-local-name (var-ref-name v) env)))
	(let ((def  (var-ref-var v)))
	  (when (not (eq? def *undefined-def*))
	    ;; The lookup-local-name may fail if there is a program error.
	    ;; In that case, skip this.
	    (if (var-signature def)
		(signal-multiple-signatures (var-ref-name v))
		(setf (var-signature def) gtype))))))
    object))

;;; This attaches annotations to locally defined vars in the same
;;; manner as signdecl annotations.

(define-walker-method scope annotation-decls (object env)
  (let ((anns (annotation-decls-annotations object)))
    (dolist (a anns)
      (cond ((annotation-value? a)
	     (recoverable-error 'unknown-annotation "Unknown annotation: ~A" a))
	    ((annotation-decl? a)
	     (dolist (v (annotation-decl-names a))
	       (let ((name (lookup-local-name v env)))
		 (when (not (eq? name *undefined-def*))
		   (setf (var-annotations name)
			 (append (var-annotations name)
			      (annotation-decl-annotations a))))))))))
  object)

(define-walker-method scope type-app (object env)
  ;; the type may be a partial application (@MV.MVector, of kind
  ;; * -> * -> *), as a class argument may
  (resolve-type-1 (type-app-type object) '() '#t)
  (setf (type-app-exp object) (scope-ast-1 (type-app-exp object) env))
  object)

(define-walker-method scope ip-let (object env)
  (setf (ip-let-exp object) (scope-ast-1 (ip-let-exp object) env))
  (setf (ip-let-body object) (scope-ast-1 (ip-let-body object) env))
  object)

(define-walker-method scope exp-sign (object env)
  (resolve-signature (exp-sign-signature object))
  (setf (exp-sign-exp object) (scope-ast-1 (exp-sign-exp object) env))
  object)

;;; By the time we get to walking a valdef, all the variables it
;;; declares have been entered into the environment.  All we need to
;;; do is massage the pattern and recursively walk the definitions.

(define-walker-method scope valdef (object env)
  (setf (valdef-module object) *module-name*)
  (setf (valdef-lhs object) (reject-view-pats (massage-pattern (valdef-lhs object))))
  (setf (valdef-definitions object)
	(scope-ast/list (valdef-definitions object) env))
  object)


;;; For a single-fun-def, do the where-decls first, and then walk the
;;; rhs in an env that includes both the where-decls and the args.

;;; The patterns are massaged first: a pattern synonym's expansion may
;;; bring view patterns, which become variables and guards (lift-view-pats).

(define-walker-method scope single-fun-def (object env)
  (setf (single-fun-def-args object)
	(massage-pattern-list (single-fun-def-args object)))
  (let ((views (lift-view-pats (single-fun-def-args object))))
    (setf (single-fun-def-args object) (car views))
    (setf (single-fun-def-rhs-list object)
	  (add-view-pattern-guards (cdr views) (single-fun-def-rhs-list object)
				   (single-fun-def-where-decls object)))
    ;; (the where's bindings are now the guard's, after the views: they
    ;; may use the views' variables)
    (when (pair? (cdr views))
      (setf (single-fun-def-where-decls object) '())))
  (setf env (add-pattern-variables (single-fun-def-args object) env))
  (setf env (add-local-declarations (single-fun-def-where-decls object) env))
  (setf (single-fun-def-where-decls object)
	(scope-ast/decl-list (single-fun-def-where-decls object) env))
  (setf (single-fun-def-rhs-list object)
	(scope-ast/list (single-fun-def-rhs-list object) env))
  object)

;;; PATS without view-pats: (new-pats . views), each view-pat replaced by
;;; a new variable v, and the views (v f pat), outer ones first, as
;;; add-view-pattern-guards (parser/pattern-parser.mumble) takes them.

(define (lift-view-pats pats)
  (let* ((box  (list '()))
	 (new  (map (lambda (p) (lift-view-pat p box)) pats)))
    (cons new (reverse (car box)))))

;;; BOX is a list whose car accumulates the views, newest first.
(define (lift-view-pat p box)
  (cond ((is-type? 'view-pat p)
	 (let* ((name  (string->symbol
			(format '#f "view%~A" (incf *view-pattern-count*))))
		(entry (list name (view-pat-fn p) '#f)))
	   (push entry (car box))
	   (setf (caddr entry) (lift-view-pat (view-pat-pattern p) box))
	   (make var-pat (var (generated-var-ref name)))))
	((is-type? 'pcon p)
	 (setf (pcon-pats p) (map (lambda (q) (lift-view-pat q box)) (pcon-pats p)))
	 p)
	((is-type? 'list-pat p)
	 (setf (list-pat-pats p) (map (lambda (q) (lift-view-pat q box)) (list-pat-pats p)))
	 p)
	((is-type? 'as-pat p)
	 (setf (as-pat-pattern p) (lift-view-pat (as-pat-pattern p) box)) p)
	((is-type? 'irr-pat p)
	 (setf (irr-pat-pattern p) (lift-view-pat (irr-pat-pattern p) box)) p)
	((is-type? 'bang-pat p)
	 (setf (bang-pat-pattern p) (lift-view-pat (bang-pat-pattern p) box)) p)
	((is-type? 'sig-pat p)
	 (setf (sig-pat-pattern p) (lift-view-pat (sig-pat-pattern p) box)) p)
	(else p)))

;;; A generator whose pattern (once massaged) has views becomes a
;;; generator of a variable followed by one for each view: pat <- f v in
;;; a pattern guard, pat <- [f v] in a list comprehension (LIST?).

(define (expand-view-quals quals list?)
  (lisp:mapcan
   (lambda (q)
     (if (not (is-type? 'qual-generator q))
	 (list q)
	 (let ((views (lift-view-pats
		       (list (massage-pattern (qual-generator-pat q))))))
	   (setf (qual-generator-pat q) (car (car views)))
	   (cons q
		 (map (lambda (v)
			(let ((app (make app (fn (cadr v))
					 (arg (generated-var-ref (car v))))))
			  (make qual-generator
				(pat (caddr v))
				(exp (if list? (make list-exp (exps (list app))) app)))))
		      (cdr views))))))
   quals))

;;; Where no guard can follow (lambdas, bindings).
(define (reject-view-pats pat)
  (when (pair? (cdr (lift-view-pats (list pat))))
    (phase-error 'view-pattern-synonym
      "A pattern synonym with a view pattern cannot be used in a lambda or a pattern binding."))
  pat)


;;;===================================================================
;;; exp-structs
;;;===================================================================

;;; A lambda whose patterns have views (pattern synonyms with view
;;; patterns) matches them in nested cases: \(P x) -> e is
;;; \v -> case f v of x -> e for P's view f.
(define-walker-method scope lambda (object env)
  (setf env (add-pattern-variables (lambda-pats object) env))
  (let ((lifted (lift-view-pats (massage-pattern-list (lambda-pats object)))))
    (setf (lambda-pats object) (car lifted))
    (when (pair? (cdr lifted))
      ;; the views' variables (the synonyms' are bound by the cases)
      (setf env (add-pattern-variables (car lifted) env))
      (setf (lambda-body object)
	    (wrap-view-cases (cdr lifted) (lambda-body object)))))
  (setf (lambda-body object) (scope-ast-1 (lambda-body object) env))
  object)

;;; VIEWS, (name fn pat) outermost first: case fn name of pat -> ... BODY
(define (wrap-view-cases views body)
  (if (null? views)
      body
      (let ((v (car views)))
	(**case (make app (fn (cadr v)) (arg (generated-var-ref (car v))))
		(list (**alt/simple (caddr v) (wrap-view-cases (cdr views) body)))))))

(define-walker-method scope let (object env)
  (setf env (add-local-declarations (let-decls object) env))
  (setf (let-decls object) (scope-ast/decl-list (let-decls object) env))
  (setf (let-body object) (scope-ast-1 (let-body object) env))
  object)


;;; The bindings of a pattern guard's quals scope over the later quals
;;; and the rhs.

(define-walker-method scope guarded-rhs (object env)
  (let ((guard  (guarded-rhs-guard object)))
    (when (is-type? 'pattern-guard guard)
      (setf (pattern-guard-quals guard)
	    (expand-view-quals (pattern-guard-quals guard) '#f)))
    (if (is-type? 'pattern-guard guard)
	(dolist (q (pattern-guard-quals guard))
	  (cond ((is-type? 'qual-generator q)
		 (setf (qual-generator-exp q)
		       (scope-ast-1 (qual-generator-exp q) env))
		 (setf env
		       (add-pattern-variables (list (qual-generator-pat q)) env))
		 (setf (qual-generator-pat q)
		       (reject-view-pats (massage-pattern (qual-generator-pat q)))))
		((is-type? 'qual-filter q)
		 (setf (qual-filter-exp q)
		       (scope-ast-1 (qual-filter-exp q) env)))
		(else
		 (setf env (add-local-declarations (qual-let-decls q) env))
		 (setf (qual-let-decls q)
		       (scope-ast/decl-list (qual-let-decls q) env)))))
	(setf (guarded-rhs-guard object) (scope-ast-1 guard env)))
    (setf (guarded-rhs-rhs object) (scope-ast-1 (guarded-rhs-rhs object) env))
    object))

;;; Case alts are treated very much like single-fun-defs.

(define-walker-method scope case (object env)
  (setf (case-exp object) (scope-ast-1 (case-exp object) env))
  (dolist (a (case-alts object))
    (setf (alt-pat a) (massage-pattern (alt-pat a)))
    (let ((views (lift-view-pats (list (alt-pat a)))))
      (setf (alt-pat a) (car (car views)))
      (setf (alt-rhs-list a) (add-view-pattern-guards (cdr views) (alt-rhs-list a)
						      (alt-where-decls a)))
      (when (pair? (cdr views))
	(setf (alt-where-decls a) '())))
    (let ((env  (add-pattern-variables (list (alt-pat a)) env)))
      (setf env (add-local-declarations (alt-where-decls a) env))
      (setf (alt-where-decls a)
	    (scope-ast/decl-list (alt-where-decls a) env))
      (setf (alt-rhs-list a)
	    (scope-ast/list (alt-rhs-list a) env))))
  object)


(define-walker-method scope var-ref (object env)
 (if (and (eq? (var-ref-var object) *undefined-def*)
	  (string-starts? "%nameq." (symbol->string (var-ref-name object))))
  ;; TemplateHaskell's quoted name (parser/exp-parser.mumble)
  (scope-name-quote (symbol->string (var-ref-name object)) env)
 (begin
  (when (and (eq? (var-ref-var object) *undefined-def*)
	     (string-starts? "%arrow." (symbol->string (var-ref-name object))))
    ;; Arrows' proc notation (parser/exp-parser.mumble): Control.Arrow's
    (let* ((s  (symbol->string (var-ref-name object)))
	   (name (string->symbol (substring s 7 (string-length s))))
	   (m  (table-entry *modules* '|Control.Arrow|))
	   (def (and m (table-entry (module-symbol-table m) name))))
      (if (or (eq? def '#f) (not (var? def)))
	  (phase-error 'proc-needs-arrow
	    "proc notation needs Control.Arrow (~A); import it or a module that does." name)
	  (setf (var-ref-var object) def))))
  (when (and (eq? (var-ref-var object) *undefined-def*)
	     (eq? (var-ref-name object) '|%ip|))
    ;; ImplicitParams' ?x (parser/exp-parser.mumble): PreludeModern's ip
    (setf (var-ref-var object) (prelude-modern-def '|ip|)))
  (when (and (eq? (var-ref-var object) *undefined-def*)
	     (string-starts? "%dot." (symbol->string (var-ref-name object))))
    ;; OverloadedRecordDot's field (parser/exp-parser.mumble)
    (let ((field (string->symbol
		  (substring (symbol->string (var-ref-name object)) 5
			     (string-length (symbol->string (var-ref-name object)))))))
      (setf (var-ref-name object)
	    (if (memq field (module-duplicate-fields *module*))
		(has-field-getter field)
		field))
      (setf env '())))
  (when (eq? (var-ref-var object) *undefined-def*)
    ;; DuplicateRecordFields: a field of several types, used as a
    ;; function, is HasField's getter (parser/module-parser.mumble)
    (when (and (memq (var-ref-name object) (module-duplicate-fields *module*))
	       (not (lisp:some (lambda (frame) (assq (var-ref-name object) frame)) env)))
      (setf (var-ref-name object) (has-field-getter (var-ref-name object))))
    (setf (var-ref-var object)
	  (lookup-name (var-ref-name object) env)))
  object)))


(define-walker-method scope con-ref (object env)
  (if (and (eq? (con-ref-con object) *undefined-def*)
	   (or (assq (con-ref-name object) (module-pattern-synonyms *module*))
	       (imported-pattern-synonym (con-ref-name object))))
      ;; PatternSynonyms: the builder function (parser/pattern-parser.mumble),
      ;; infix if the constructor was ((:<|| ys), a section)
      (let ((ref (generated-var-ref
		  (qualified-pattern-builder-name (con-ref-name object)))))
	(setf (var-ref-infix? ref) (con-ref-infix? object))
	(scope-ast-1 ref env))
      (begin
	(when (eq? (con-ref-con object) *undefined-def*)
	  (setf (con-ref-con object)
		(lookup-toplevel-name (con-ref-name object))))
	object)))

(define-walker-method scope list-comp (object env)
  (setf (list-comp-quals object) (expand-view-quals (list-comp-quals object) '#t))
  (dolist (q (list-comp-quals object))
    (cond ((is-type? 'qual-generator q)
	   (setf (qual-generator-exp q)
		 (scope-ast-1 (qual-generator-exp q) env))
	   (setf env
		 (add-pattern-variables (list (qual-generator-pat q)) env))
	   (setf (qual-generator-pat q)
		 (reject-view-pats (massage-pattern (qual-generator-pat q)))))
	  ((is-type? 'qual-filter q)
	   (setf (qual-filter-exp q)
		 (scope-ast-1 (qual-filter-exp q) env)))))
  (setf (list-comp-exp object) (scope-ast-1 (list-comp-exp object) env))
  object)

;;; do expressions are translated here, after parsing and before their
;;; parts are scoped, because the translation depends on whether a
;;; generator's pattern can fail, which needs the constructors resolved
;;; (report 3.14):
;;;   do {e}                = e
;;;   do {e; stmts}         = e >> do {stmts}
;;;   do {p <- e; stmts}    = e >>= \p -> do {stmts}          p failure-free
;;;                         = e >>= \v -> case v of
;;;                              p -> do {stmts}; _ -> fail "..."  otherwise
;;;   do {let decls; stmts} = let decls in do {stmts}
;;; `fail' is a method of Monad in Haskell 98; before that the failure
;;; case is `zero' of class MonadZero (feature monad-fail).

(define-walker-method scope do-exp (object env)
  (scope-ast-1 (or (and (module-extension? "ApplicativeDo")
			(applicative-do (do-exp-stmts object)))
		   (desugar-do (do-exp-stmts object)))
	       env))

;;; ApplicativeDo (GHC): do p1 <- e1; ..; pn <- en; pure e, no ei using
;;; an earlier pi's variables and each pi failure-free, is
;;; (\p1 .. pn -> e) <$> e1 <*> .. <*> en (an expression statement's
;;; pattern is _), needing only Applicative (Agda's exprToPattern).
;;; Else #f, for the monadic desugaring.
(define (applicative-do stmts)
  (let ((last (car (lisp:last stmts)))
	(binds (lisp:butlast stmts)))
    (and (not (null? binds))
	 (is-type? 'qual-filter last)
	 (lisp:every (lambda (s) (or (is-type? 'qual-filter s) (is-type? 'qual-generator s)))
		     binds)
	 (let ((result (pure-argument (qual-filter-exp last))))
	   (and result
		(let ((pats (map (lambda (s)
				   (if (is-type? 'qual-generator s)
				       (massage-pattern (qual-generator-pat s))
				       (**wildcard-pat)))
				 binds)))
		  (and (lisp:every (function failure-free-pattern?) pats)
		       (applicative-do-independent? binds pats)
		       (let ((exp (**app (**var/def (core-symbol "fmap"))
					 (make lambda (pats pats) (body result))
					 (stmt-exp (car binds)))))
			 (dolist (s (cdr binds))
			   (setf exp (**app (**var/def (prelude-modern-def '|<*>|)) exp (stmt-exp s))))
			 exp))))))))

(define (stmt-exp s)
  (if (is-type? 'qual-generator s) (qual-generator-exp s) (qual-filter-exp s)))

;;; E of pure E, return E, pure $ E or return $ E (before the precedence
;;; parse), or #f.
(define (pure-argument exp)
  (let ((pure? (lambda (f) (and (var-ref? f) (memq (var-ref-name f) '(|pure| |return|))))))
    (cond ((and (is-type? 'app exp) (funcall pure? (app-fn exp)))
	   (app-arg exp))
	  ((and (is-type? 'pp-exp-list exp)
		(>= (length (pp-exp-list-exps exp)) 3)
		(funcall pure? (car (pp-exp-list-exps exp)))
		(let ((op (cadr (pp-exp-list-exps exp))))
		  (and (var-ref? op) (eq? (var-ref-name op) '|$|))))
	   (let ((rest (cddr (pp-exp-list-exps exp))))
	     (if (null? (cdr rest))
		 (car rest)
		 (make pp-exp-list (exps rest)))))
	  (else '#f))))

;;; No statement's expression names an earlier statement's variable.
(define (applicative-do-independent? binds pats)
  (let ((bound '()))
    (lisp:every (lambda (s p)
		  (let ((ok (not (ast-mentions-names? (stmt-exp s) bound 200))))
		    (setf bound (append (map (function var-ref-name) (collect-pattern-vars p))
					bound))
		    ok))
		binds pats)))

(define (names-less-pattern-vars names pats)
  (let ((bound (map (function var-ref-name) (collect-pattern-vars/list pats '()))))
    (lisp:remove-if (lambda (n) (memq n bound)) names)))

;;; Whether a (not yet scoped) expression has a variable named one of
;;; NAMES; a structure's slots are walked generically.
(define (ast-mentions-names? x names depth)
  (cond ((null? names) '#f)
	((<= depth 0) '#t)
	((var-ref? x) (memq (var-ref-name x) names))
	((pair? x) (lisp:some (lambda (y) (ast-mentions-names? y names (1- depth))) x))
	;; (a binder shadows: \p -> .., case alternatives, do statements)
	((is-type? 'lambda x)
	 (ast-mentions-names? (lambda-body x)
			      (names-less-pattern-vars names (lambda-pats x)) (1- depth)))
	((is-type? 'alt x)
	 (let ((names (names-less-pattern-vars names (list (alt-pat x)))))
	   (or (ast-mentions-names? (alt-rhs-list x) names (1- depth))
	       (ast-mentions-names? (alt-where-decls x) names (1- depth)))))
	((is-type? 'do-exp x)
	 (let ((names names))
	   (lisp:some (lambda (s)
			(if (is-type? 'qual-generator s)
			    (let ((r (ast-mentions-names? (qual-generator-exp s) names (1- depth))))
			      (setf names (names-less-pattern-vars names (list (qual-generator-pat s))))
			      r)
			    (ast-mentions-names? s names (1- depth))))
		      (do-exp-stmts x))))
	((and (struct? x) (not (is-type? (quote def) x)))
	 (lisp:some (lambda (sd)
		      (ast-mentions-names? (funcall (lisp:symbol-function (sd-getter sd)) x) names (1- depth)))
		    (td-slots (struct-type-descriptor x))))
	(else '#f)))

(define (desugar-do stmts)
  (cond ((null? stmts)
	 (signal-bad-do "A do expression has no statements.")
	 (**con/def (core-symbol "UnitConstructor")))
	((null? (cdr stmts))
	 (if (is-type? 'qual-filter (car stmts))
	     (qual-filter-exp (car stmts))
	     (begin
	       (signal-bad-do "The last statement of a do expression must be an expression.")
	       (**con/def (core-symbol "UnitConstructor")))))
	(else
	 (let ((stmt (car stmts))
	       (rest (desugar-do (cdr stmts))))
	   (cond ((is-type? 'qual-filter stmt)
		  (**app (**var/def (core-symbol ">>")) (qual-filter-exp stmt) rest))
		 ((is-type? 'qual-let stmt)
		  (ip-let-or-let (qual-let-decls stmt) rest))
		 (else
		  (desugar-do-bind (qual-generator-pat stmt)
				   (qual-generator-exp stmt)
				   rest)))))))

(define (desugar-do-bind pat exp rest)
  (let ((pat (massage-pattern pat))
	(bind (**var/def (core-symbol ">>="))))
    (if (failure-free-pattern? pat)
	(**app bind exp (make lambda (pats (list pat)) (body rest)))
	(let ((v1 (make var-ref (name '|do-v|) (infix? '#f)
			(var *undefined-def*)))
	      (v2 (make var-ref (name '|do-v|) (infix? '#f)
			(var *undefined-def*))))
	  (**app bind exp
		 (make lambda
		       (pats (list (make var-pat (var v1))))
		       (body (**case v2
				     (list (**alt/simple pat rest)
					   (**alt/simple
					    (**wildcard-pat)
					    (do-failure-exp)))))))))))

(define (do-failure-exp)
  (if (feature? 'monad-fail)
      (**app (**var/def (core-symbol "fail"))
	     (**string "Pattern match failure in do expression"))
      (**var/def (core-symbol "zero"))))

;;; A failure-free pattern can be refuted only by bottom: irrefutable
;;; patterns, and constructors of single-constructor types applied to
;;; failure-free patterns.

(define (failure-free-pattern? pat)
  (cond ((or (var-pat? pat) (wildcard-pat? pat) (is-type? 'irr-pat pat))
	 '#t)
	((is-type? 'as-pat pat)
	 (failure-free-pattern? (as-pat-pattern pat)))
	((is-type? 'sig-pat pat)
	 (failure-free-pattern? (sig-pat-pattern pat)))
	((is-type? 'bang-pat pat)
	 (failure-free-pattern? (bang-pat-pattern pat)))
	((pcon? pat)
	 (let ((con (pcon-con pat)))
	   (or (eq? con (core-symbol "UnitConstructor"))
	       (and (con? con)
		    (algdata? (con-alg con))
		    (eqv? (algdata-n-constr (con-alg con)) 1)
		    (every (function failure-free-pattern?) (pcon-pats pat))))))
	(else '#f)))

(define (signal-bad-do message)
  (phase-error 'bad-do "~A" message))

;;; TemplateHaskell: a splice is the code it produced (th/splices.mumble).

;;; Inside a quote, a splice is not run: its expression is part of the
;;; quote's code (th/quote.mumble).

(define *scoping-quote?* '#f)
(define *quote-env* '())     ; the scope environment outside the quote
(define *quote-splice-env* '#f)
(define *quote-splice-boundary* '#f)

(predefine (quote-code bracket env))  ; in th/quote.mumble

(define-walker-method scope bracket (object env)
  (quote-code object env))

(define-walker-method scope splice (object env)
  (cond
   ((and (eq? (splice-expansion object) '#f) (dynamic *scoping-quote?*))
    (setf (splice-exp object)
	  (dynamic-let ((*scoping-quote?* '#f)
			(*quote-splice-env* env)
			(*quote-splice-boundary* (dynamic *quote-env*)))
	    (scope-ast-1 (splice-exp object) env)))
    object)
   (else
  (if (eq? (splice-expansion object) '#f)
      ;; not run: typed at the interactive prompt
      (begin
	(phase-error 'splice-not-run
	  "Template Haskell splices are not supported here yet (only in modules).")
	object)
      (dynamic-let ((*th-global-names?* '#t))
	(scope-ast-1 (splice-expansion object) env))))))

(define-walker-method scope pp-exp-list (object env)
  (massage-pp-exp-list (scope-ast/list (pp-exp-list-exps object) env)))


;;; Records (report 3.15).  Construction, update and record patterns are
;;; translated here, once constructors and field names can be resolved;
;;; the type checker sees only the translation.
;;;   C {f = e, ...}   = C e1 ... en, where ei is the value given for the
;;;                      field at position i, or an error for a missing one
;;;   e {f = v, ...}   = case e of C x1 ... xn -> C x1 ... v ... xn; ...
;;;                      for each constructor C that has all the fields
;;;   C {f = p, ...}   = C _ ... p ... _   (a pattern)
;;; Field names are top-level names; local variables do not hide them.

(define-walker-method scope record-con (object env)
  (scope-ast-1 (desugar-record-con object env) env))

(define-walker-method scope record-update (object env)
  (let ((decls (shared-update-binds object)))
    (scope-ast-1 (if (null? decls)
		     (desugar-record-update object)
		     (**let decls (desugar-record-update object)))
		 env)))

(define (desugar-record-con object env)
  (let* ((con-ref (record-con-con object))
	 (con (lookup-toplevel-name (con-ref-name con-ref)))
	 (binds (resolve-field-bindings (record-con-fields object) con)))
    (if (not (con? con))
	(**abort "Bad record construction")
	(begin
	  ;; C {..}: the other fields from local variables of their names
	  (when (record-wildcard? (record-con-fields object))
	    (setf binds
		  (append binds
			  (record-wildcard-binds
			   con binds
			   (lambda (name)
			     (and (lisp:some (lambda (frame) (assq name frame)) env)
				  (**var name)))))))
	  (check-fields-of-con binds con)
	  (**app/l (**con/def con)
		   (record-con-args con binds))))))

(define (record-con-args con binds)
  (let ((labels (con-field-labels con))
	(strict (con-slot-strict? con))
	(args '()))
    (dotimes (i (con-arity con))
      (let* ((field (if (null? labels) '#f (list-ref labels i)))
	     (bind (and field (assq field binds))))
	(push (cond (bind (tuple-2-2 bind))
		    (else
		     (when (and (pair? strict) (list-ref strict i))
		       (phase-error 'missing-strict-field
			 "The strict field ~A of ~A is missing in a record construction."
			 (if field (def-name field) i)
			 (remove-con-prefix (symbol->string (def-name con)))))
		     (**abort
		      (format '#f "Missing field ~A in record construction ~A"
			      (if field (def-name field) "")
			      (remove-con-prefix (symbol->string (def-name con)))))))
	      args)))
    (reverse args)))

(define (desugar-record-update object)
  (let* ((binds (resolve-field-bindings (record-update-fields object)))
	 (alg (fields-algdata binds)))
    (if (eq? alg '#f)
	(**abort "Bad record update")
	(let ((alts '())
	      (complete? '#t))
	  (dolist (con (algdata-constrs alg))
	    (if (every (lambda (b) (field-position (tuple-2-1 b) con)) binds)
		(let ((vars (update-vars (con-arity con))))
		  (push (**alt/simple
			 (**pcon/def con (map (function **pat) vars))
			 (**app/l (**con/def con)
				  (update-args con vars binds)))
			alts))
		(setf complete? '#f)))
	  (when (null? alts)
	    (phase-error 'no-constructor-with-fields
	      "No constructor of ~A has all the fields of a record update."
	      (def-name alg)))
	  (when (not complete?)
	    (push (**alt/simple (**wildcard-pat)
				(**abort "No match in record update"))
		  alts))
	  (**case (record-update-exp object) (reverse alts))))))

;;; With several constructors' alternatives, each new field value is
;;; let-bound first: the alternatives share no expression (a shared one
;;; would be type checked once for each: Agda's core { lhsPats = .. }).
(define (shared-update-binds object)
  (let ((decls '()))
    (setf (record-update-fields object)
	  (map (lambda (b)
		 (let ((e (tuple-2-2 b)))
		   (if (or (var-ref? e) (is-type? 'const e))
		       b
		       (let ((v (string->symbol (format '#f "updval%~A" (incf *update-var-count*)))))
			 (push (**define v '() e) decls)
			 (tuple (tuple-2-1 b) (**var v))))))
	       (record-update-fields object)))
    decls))

(define *update-var-count* 0)

(define (update-vars n)
  (do ((i n (1- i))
       (vars '() (cons (string->symbol (format '#f "upd%~A" i)) vars)))
      ((eqv? i 0) vars)))

(define (update-args con vars binds)
  (let ((labels (con-field-labels con)))
    (map (lambda (v label)
	   (let ((bind (assq label binds)))
	     ;; a literal is annotated by the type checker: one per alternative
	     (cond ((not bind) (**var v))
		   ((is-type? 'const (tuple-2-2 bind)) (copy-const (tuple-2-2 bind)))
		   (else (tuple-2-2 bind)))))
	 vars labels)))

;;; The datatype of the fields being updated; they must all belong to one.

(define (fields-algdata binds)
  (let ((alg '#f))
    (dolist (b binds)
      (let ((a (var-field-alg (tuple-2-1 b))))
	(cond ((eq? alg '#f) (setf alg a))
	      ((not (eq? alg a))
	       (phase-error 'mixed-record-update
		 "The fields of a record update belong to different types.")))))
    alg))

;;; Resolve the field names of (tuple var-ref item) bindings: returns a
;;; list of (tuple field-var item).  Unknown names and duplicates are
;;; errors (and are dropped).

(define (record-wildcard? bindings)
  (lisp:some (lambda (b) (eq? (tuple-2-1 b) '|..|)) bindings))

;;; (tuple field item) for the fields of CON not in BINDS, with
;;; (MAKE-ITEM field-name) as the item ('#f leaves the field out).

(define (record-wildcard-binds con binds make-item)
  (let ((result '()))
    (dolist (label (con-field-labels con))
      (when (and label (not (assq label binds)))
	(let ((item (funcall make-item (field-original-name label))))
	  (when item
	    (push (tuple label item) result)))))
    (reverse result)))

(define (resolve-field-bindings bindings . con)
  (let ((result '()))
    (dolist (b (lisp:remove '|..| bindings :key (function tuple-2-1)))
      (let* ((name (var-ref-name (tuple-2-1 b)))
	     (def (or (and (pair? con) (con? (car con))
			   (memq name (module-duplicate-fields *module*))
			   ;; DuplicateRecordFields: the constructor's field
			   (lisp:find-if (lambda (v)
					   (eq? (field-original-name v) name))
					 (con-field-labels (car con))))
		      (lookup-toplevel-name name))))
	(cond ((eq? def *undefined-def*))
	      ((not (and (var? def) (var-field-alg def)))
	       (phase-error 'not-a-field "~A is not a record field." name))
	      ((assq def result)
	       (phase-error 'duplicate-field
		 "The field ~A is given more than once." name))
	      (else
	       (push (tuple def (tuple-2-2 b)) result)))))
    (reverse result)))

(define (check-fields-of-con binds con)
  (dolist (b binds)
    (when (not (field-position (tuple-2-1 b) con))
      (phase-error 'field-not-in-constructor
	"The constructor ~A has no field ~A."
	(remove-con-prefix (symbol->string (def-name con)))
	(def-name (tuple-2-1 b))))))

;;; C {f = p, ...} as a pattern; called by massage-pattern.  The field
;;; patterns are massaged by the caller.

(define (desugar-record-pat pat)
  (let ((n (and (null? (record-pat-fields pat))
		(eq? (pcon-con (record-pat-con pat)) *undefined-def*)
		(pattern-synonym-arity (pcon-name (record-pat-con pat))))))
    (if n
	;; P {} of a pattern synonym (Agda's Graph.CyclicSCC{}): P _ .. _
	(let ((pcon (record-pat-con pat)))
	  (setf (pcon-pats pcon)
		(let ((l '())) (dotimes (i n) (push (**wildcard-pat) l)) l))
	  pcon)
	(desugar-record-pat-1 pat))))

;;; The number of arguments of pattern synonym NAME, or #f.
(define (pattern-synonym-arity name)
  (let ((local (assq name (module-pattern-synonyms *module*))))
    (if local
	(length (cadr local))
	(let ((template (imported-pattern-synonym name)))
	  (and template (length (car template)))))))

(define (desugar-record-pat-1 pat)
  (let* ((pcon (record-pat-con pat))
	 (con (if (eq? (pcon-con pcon) *undefined-def*)
		  (lookup-toplevel-name (pcon-name pcon))
		  (pcon-con pcon)))
	 (binds (resolve-field-bindings (record-pat-fields pat) con)))
    (setf (pcon-con pcon) con)
    (when (con? con)
      (check-fields-of-con binds con)
      (setf (pcon-pats pcon)
	    (let ((labels (con-field-labels con))
		  (pats '()))
	      (dotimes (i (con-arity con))
		(let ((bind (and (pair? labels)
				 (assq (list-ref labels i) binds))))
		  (push (if bind (tuple-2-2 bind) (**wildcard-pat)) pats)))
	      (reverse pats))))
    pcon))

;;; A field selector's name less the type a duplicated one is renamed for
;;; (f%T is f).
(define (field-original-name var)
  (let* ((s (symbol->string (def-name var)))
	 (i (lisp:position #\% s)))
    (if i (string->symbol (substring s 0 i)) (def-name var))))

;;; TemplateHaskell: 'f, 'C or ''T (STRING is %nameq.K.NAME) is the Name of
;;; what the name refers to here: a global one's NameG (with GHC's names
;;; for the built-in syntax; derived/lift.mumble's th-global-name), a
;;; local variable's mkName.

(define (scope-name-quote string env)
  (let* ((kind  (string-ref string 7))
	 (text  (substring string 9 (string-length string)))
	 (name  (string->symbol text))
	 (parent (and (dynamic *splice-parent*)
		      (not (lisp:some (lambda (frame) (assq name frame)) env))
		      (parent-defines? kind name (dynamic *splice-parent*))))
	 (def   (cond (parent 'parent)
		      ((char=? kind #\t) (name-quote-type text))
		      ((char=? kind #\d) (name-quote-con text))
		      (else (lookup-name name env)))))
    (cond ((eq? def 'parent)
	   ;; in a splice, a name the module running it defines (th/splices)
	   (**app (**var/def (th-def (cond ((char=? kind #\t) '|mkNameG_tc|)
					   ((char=? kind #\d) '|mkNameG_d|)
					   (else '|mkNameG_v|))))
		  (**string "main")
		  (**string (symbol->string (module-name (dynamic *splice-parent*))))
		  (**string text)))
	  ((eq? def 'equality)
	   ;; ''(~), which has no definition here
	   (**app (**var/def (th-def '|mkNameG_tc|))
		  (**string "main") (**string "GHC.Internal.Types") (**string "~")))
	  ((eq? def *undefined-def*) (**string text))   ; reported already
	  ((and (char=? kind #\v)
		(lisp:some (lambda (frame) (assq name frame)) env))
	   ;; a local variable (GHC: a level error)
	   (**app (**var/def (th-def '|mkName|)) (**string text)))
	  (else
	   (mlet (((modu occ) (th-global-name def)))
	     (**app (**var/def (th-def (cond ((var? def) '|mkNameG_v|)
					     ((con? def) '|mkNameG_d|)
					     (else '|mkNameG_tc|))))
		    (**string "main") (**string modu) (**string occ)))))))

(define (name-quote-con text)
  (cond ((string=? text "()") (core-symbol "UnitConstructor"))
	((string=? text "[]") (core-symbol "Nil"))
	((string-starts? "(," text)
	 (tuple-constructor (- (string-length text) 1)))
	(else (lookup-toplevel-name (string->symbol text)))))

(define (name-quote-type text)
  (cond ((string=? text "()") (core-symbol "UnitType"))
	((string=? text "[]") (core-symbol "List"))
	((string=? text "->") (core-symbol "Arrow"))
	((string=? text "~") 'equality)
	((string-starts? "(," text)
	 (tuple-tycon (- (string-length text) 1)))
	(else
	 ;; (the type or class: a constructor of the same name is not it,
	 ;; invariant's ''Invariant beside data InvariantClass = Invariant)
	 (let ((def (lisp:find-if
		     (lambda (d) (and d (or (algdata? d) (synonym? d) (class? d))))
		     (list (resolve-toplevel-name (string->symbol text))
			   (resolve-toplevel-name (add-con-prefix/symbol (string->symbol text)))))))
	   (if def
	       def
	       (begin (signal-undefined-symbol (string->symbol text))
		      *undefined-def*))))))
