;;; csys.mumble -- compilation unit definition for the compilation system

(define-compilation-unit command-interface
  (source-filename "$Y2/src/compiler/command-interface/")
  (require global)
  (unit command
    (source-filename "command.mumble"))
  (unit command-utils
    (source-filename "command-utils.mumble"))
  (unit incremental-compiler
    (source-filename "incremental-compiler.mumble"))
  (unit repl
    (source-filename "repl.mumble")
    (require command command-utils incremental-compiler)))
