;;; batch.mumble -- the command line's drivers (src/cli/cli.lisp):
;;;
;;;   yale-haskell FILE ARGS...              batch-run: compile, run Main.main
;;;   yale-haskell compile FILE --emit S..   emit-run: compile, write stages
;;;   yale-haskell build FILE [-o EXE]       batch-build: compile, and save
;;;                                          an executable running Main.main

;;; Batch mode: the program's output is the only thing on stdout;
;;; compiler diagnostics go to stderr, and a compile error or a runtime
;;; error ends the run with status 1.

(define (setup-batch-mode)
  (setf *haskell-batch-mode* '#t)
  ;; compiler diagnostics go to stderr, leaving stdout to the program
  (setf *error-output-port* lisp:*error-output*)
  ;; Haskell runtime errors (error, head [], ...) normally return to the
  ;; REPL; in batch mode they end the program with status 1.
  (setf *runtime-error-hook*
	(lambda (msg)
	  (lisp:force-output)
	  (lisp:format lisp:*error-output* "~&Haskell runtime abort.~%~a~%" msg)
	  (lisp:finish-output lisp:*error-output*)
	  (exit 1))))

;;; Runs THUNK, which returns true on success, and exits with its status.
;;; The host compiler's warnings about generated code are muffled.

(define (exit-with-batch-status thunk)
  (let ((status
	 (lisp:handler-case
	     (lisp:handler-bind ((lisp:warning
				  (lambda (c)
				    (lisp:muffle-warning c)))
				 ;; YALE_HASKELL_DEBUG=1: a Lisp backtrace for
				 ;; an internal error
				 (lisp:error
				  (lambda (c)
				    (when (env-flag? "YALE_HASKELL_DEBUG")
				      (lisp:format (debug-stream) "~&~A~%"
						   (describe-condition c)))
				    (when (env-flag? "YALE_HASKELL_DEBUG")
				      ;; plainly printed: a failure in the
				      ;; pretty printer must not hide the frames
				      #+sbcl
				      (lisp:let ((lisp:*print-pretty* lisp:nil)
						 (lisp:*print-length* 6)
						 (lisp:*print-level* 2)
						 (sb-debug:*debug-print-variable-alist*
						  '((lisp:*print-level* . 1) (lisp:*print-length* . 3))))
					(lisp:ignore-errors
					 (lisp:funcall
					  (lisp:find-symbol "PRINT-BACKTRACE" "SB-DEBUG")
					  ':count 40 ':stream (debug-stream))))))))
	       (if (funcall thunk) 0 1))
	   ;; not errors: GHC's messages and exit statuses
	   ;; the reader of stdout went away (prog | head): quietly, as a
	   ;; program SIGPIPE ends (128 + 13)
	   #+sbcl
	   (sb-int:broken-pipe ()
	     141)
	   #+sbcl
	   (sb-kernel::control-stack-exhausted ()
	     (flush-standard-output)
	     (lisp:format lisp:*error-output* "~&yale-haskell: stack overflow~%")
	     2)
	   ;; (only SBCL's: ECL's stack overflow is a storage condition it
	   ;; recovers from by growing the stack)
	   #+sbcl
	   (lisp:storage-condition ()
	     (flush-standard-output)
	     (lisp:format lisp:*error-output* "~&yale-haskell: out of memory~%")
	     251)
	   (lisp:error (c)
	     (flush-standard-output)
	     (lisp:format lisp:*error-output* "~&yale-haskell: ~a~%" (describe-condition c))
	     1))))
    (setf status (finish-batch-output status))
    (exit status)))

;;; Flush the program's output; a reader that went away is ignored here.
(define (flush-standard-output)
  (lisp:handler-case (lisp:force-output)
    (lisp:stream-error () '#f)))

;;; Flush the output; a reader that went away makes the status 141.
(define (finish-batch-output status)
  (lisp:handler-case
      (begin
	(lisp:force-output)
	(lisp:finish-output lisp:*error-output*)
	status)
    (lisp:stream-error () (if (eqv? status 0) 141 status))))

(define (batch-run file args)
  ;; getArgs, getProgName and exitWith (src/runtime/system-prims.mumble)
  (set-haskell-program-args file args)
  (setup-batch-mode)
  (init-standard-handle-buffering)
  (init-gc-parameters)
  ;; compiled units are kept between runs (src/compiler/csys/unit-cache.mumble)
  (setup-unit-cache-for 'all)
  (exit-with-batch-status (lambda () (run-program file))))


;;; A standalone executable, as ghc FILE makes one.  The program is
;;; compiled and loaded here, in the compiler's thread; SBCL saves an image
;;; only from its one remaining thread, so *executable-to-save* asks the
;;; main thread to (src/cli/cli.lisp's save-executable) once this returns.
;;; The executable is this image with the program loaded: it starts in
;;; run-saved-executable, which runs Main.main as batch-run does.

(define *executable-to-save* '#f)   ; (tuple output-file main-var)

(define (batch-build file output)
  (setup-batch-mode)
  (setup-unit-cache-for 'all)
  (let ((main-var '#f))
    (lisp:handler-bind ((lisp:warning (lambda (c) (lisp:muffle-warning c))))
      (when (compile/load file)
	(let ((main-mod (table-entry *modules* '|Main|)))
	  (setf main-var (and main-mod
			      (table-entry (module-symbol-table main-mod) '|main|))))))
    (cond ((not main-var)
	   (when (table-entry *modules* '|Main|)
	     (lisp:format lisp:*error-output* "yale-haskell: Main.main is missing~%"))
	   (lisp:finish-output lisp:*error-output*)
	   (exit 1))
	  (else
	   (setf *executable-to-save*
		 (tuple (or output (lisp:pathname-name (lisp:pathname file)))
			main-var))))))

;;; The saved executable's start: NAME is its argv[0], ARGS the rest.
(define (run-saved-executable name args)
  (let ((main-var  (tuple-2-2 *executable-to-save*)))
    (setf *executable-to-save* '#f)
    (set-haskell-program-args name args)
    (setup-batch-mode)
    (init-standard-handle-buffering)
    (init-gc-parameters)
    (exit-with-batch-status
     (lambda () (apply-exec main-var) '#t))))

;;; Emitting the compiler's intermediate forms.  STAGES are names (strings):
;;;
;;;   scope depend cfn depend2 flic optimize strictness grin codegen
;;;          the compiler's printers for those passes (as -p shows them)
;;;   typed  each top-level binding's type in the typed core (typed/),
;;;          and how many expressions typed
;;;   lisp   the unit's generated Lisp, as one file of top-level forms
;;;   asm    SBCL's disassembly of the unit's top-level functions
;;;
;;; Only the program's own units are shown, not the library's.  The
;;; program is compiled and loaded but not run.  OUTPUT is a file name,
;;; or '#f for stdout.

(define *emit-stages*
  '(scope depend cfn typed depend2 flic optimize strictness grin codegen
    codegen-flic lisp asm))

(define (emit-run file stage-names output)
  (setup-batch-mode)
  (let ((stages  (map (lambda (s)
			(or (lisp:find (lisp:string-upcase s) *emit-stages*
				       :test (function lisp:string=))
			    (begin
			      (lisp:format lisp:*error-output*
				 "yale-haskell: unknown stage ~A (~(~{~A~^ ~}~))~%"
				 s *emit-stages*)
			      (exit 64))))
		      stage-names)))
    ;; the program's units are compiled (so that they print), the
    ;; library's may come from the cache
    (setup-unit-cache 'library (unit-cache-mode-key))
    (exit-with-batch-status
     (lambda ()
       (if output
	   (lisp:with-open-file (port (lisp:ensure-directories-exist
				       (absolute-filename output))
				      :direction :output
				      :if-exists :supersede)
	     (emit-stages file stages port))
	   (emit-stages file stages (current-output-port)))))))

(define (emit-stages file stages port)
  (lisp:let ((lisp:*standard-output* port))
    (let ((mods  (dynamic-let ((*printers*
				(lisp:intersection stages *all-printers*))
			       (*print-library-units?* '#f)
			       (*emit-lisp-port* (if (memq 'lisp stages)
						     port
						     '#f)))
		   (compile/load file))))
      (when (and mods (memq 'asm stages))
	(dolist (name mods)
	  (let ((mod  (table-entry *modules* name)))
	    (when mod
	      (dolist (v (module-vars mod))
		(when (var? v)
		  (emit-asm-var v)))))))
      (force-output port)
      (if mods '#t '#f))))

;;; Only vars with code are shown (repl-disassemble-var in repl.mumble
;;; also reports the others).

(define (emit-asm-var var)
  (let ((entry  (var-optimized-entry var))
	(name   (fullname var)))
    (when (or (and entry (lisp:fboundp entry))
	      (and (lisp:boundp name)
		   (let ((value  (lisp:symbol-value name)))
		     (or (lisp:functionp value)
			 (and (pair? value)
			      (memq (car value) '(|%thunk-unevaluated%|
						  |%thunk-evaluated%|))
			      (lisp:functionp (cdr value)))))))
      (repl-disassemble-var var (symbol->string (def-name var)))
      (lisp:terpri))))

;;; Standard error as a new stream on descriptor 2: *error-output* may be
;;; the stream whose failure is being reported.
(define (debug-stream)
  #+sbcl (sb-sys:make-fd-stream 2 ':output lisp:t ':buffering ':none)
  #-sbcl lisp:*error-output*)

;;; A condition's report, or, when printing it fails (an internal type
;;; error whose datum is a compiler structure that cannot be printed),
;;; its kind and the types involved.
(define (describe-condition c)
  (or (lisp:ignore-errors (lisp:format lisp:nil "~A" c))
      (lisp:ignore-errors
       (if (lisp:typep c 'lisp:type-error)
	   (lisp:format lisp:nil "internal type error: a ~S where a ~S was expected"
			(lisp:type-of (lisp:type-error-datum c))
			(lisp:type-error-expected-type c))
	   (lisp:format lisp:nil "internal error: ~S" (lisp:type-of c))))
      "internal error"))
