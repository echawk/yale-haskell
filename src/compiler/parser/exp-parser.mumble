;;; File: expr-parser           Author: John

(define (parse-exp)
 (trace-parser exp
   (parse-exp-0)))

(define (parse-exp-0)  ;; This picks up expr type signatures
  (let ((exp (parse-exp-i)))
    (token-case
     (\:\: (let ((signature (parse-signature)))
	     (make exp-sign (exp exp) (signature signature))))
   (else exp))))

(define (parse-exp-i)  ;; This collects a list of exps for later prec parsing
  (let ((exps (parse-infix-exps)))
    (if (null? (cdr exps))
	(car exps)
	(make pp-exp-list (exps exps)))))

(define (parse-infix-exps)
  (token-case
     (- (cons (make negate) (parse-infix-exps)))
     (\\ (list (parse-lambda)))
     (|let| (list (parse-let)))
     (|if| (list (parse-if)))
     (|case| (parse-possible-app (parse-case)))
     (|do| (parse-possible-app (parse-do)))
     (else (let ((aexp (parse-aexp)))
	     (parse-possible-app aexp)))))

(define (parse-possible-app exp)
  (token-case
    (aexp-start
     (let ((exp2 (parse-aexp)))
      (parse-possible-app (make app (fn exp) (arg exp2)))))
    (varop
     (let ((varop (varop->ast)))
       (if (eq-token? '\))
	   (list exp varop)
	   `(,exp ,varop ,@(parse-infix-exps)))))
    (conop
     (let ((conop (conop->ast)))
       (if (eq-token? '\))
	   (list exp conop)
	   `(,exp ,conop ,@(parse-infix-exps)))))
    (else (list exp))))

(define (parse-lambda)
  (trace-parser lambda
   (save-parser-context
    (let ((pats (parse-apat-list)))
      (require-token -> (signal-missing-token "`->'" "lambda expression"))
      (let ((exp (parse-exp)))
	(make lambda (pats pats) (body exp)))))))

(define (parse-let)
  (trace-parser let
   (save-parser-context
    (let ((decls (parse-decl-list)))
      (require-token |in| (signal-missing-token "`in'" "let expression"))
      (let ((exp (parse-exp)))
	(make let (decls decls) (body exp)))))))

(define (parse-if)
  (trace-parser if
   (save-parser-context
    (let ((test-exp (parse-exp)))
      (require-token |then| (signal-missing-token "`then'" "if expression"))
      (let ((then-exp (parse-exp)))
	(require-token |else| (signal-missing-token "`else'" "if expression"))
	(let ((else-exp (parse-exp)))
	  (make if (test-exp test-exp)
		   (then-exp then-exp)
		   (else-exp else-exp))))))))

(define (parse-case)
  (trace-parser case
   (save-parser-context
    (let ((exp (parse-exp)))
      (require-token |of| (signal-missing-token "`of'" "case expression"))
      (let ((alts (start-layout (function parse-alts))))
	(make case (exp exp) (alts alts)))))))

(define (parse-alts in-layout?)
  (token-case
    ;; an empty alternative (H98 3.13)
    (\; (parse-alts in-layout?))
    (pat-start
     (let ((alt (parse-alt)))
       (token-case
	(\; (cons alt (parse-alts in-layout?)))
	(else (close-layout in-layout?)
	      (list alt)))))
    (else
     (close-layout in-layout?)
     '())))

(define (parse-alt)
 (trace-parser alt
  (let* ((pat (parse-pat))
	 (rhs-list (token-case
		    (-> (let ((exp (parse-exp)))
			  (list (make guarded-rhs (guard (make omitted-guard))
				                  (rhs exp)))))
		    (\| (parse-guarded-alt-rhs))
		    (else (signal-missing-token "`->' or `|'" "rhs of alt"))))
	 (decls (parse-where-decls)))
    (make alt (pat pat) (rhs-list rhs-list) (where-decls decls)))))

(define (parse-guarded-alt-rhs)
  (let ((guard (parse-guard)))
    (require-token -> (signal-missing-token "`->'" "alt"))
    (let* ((exp (parse-exp))
	   (res (make guarded-rhs (guard guard) (rhs exp))))
      (token-case
       (\| (cons res (parse-guarded-alt-rhs)))
       (else (list res))))))

;;; A guard: quals separated by commas (Haskell 2010 pattern guards,
;;; report 3.13).  A single boolean qual is returned as its expression.

(define (parse-guard)
  (let ((quals (parse-guard-quals)))
    (if (and (null? (cdr quals)) (is-type? 'qual-filter (car quals)))
	(qual-filter-exp (car quals))
	(make pattern-guard (quals quals)))))

(define (parse-guard-quals)
  (let ((qual (token-case
	       (|let| (parse-let-stmt))
	       (else (parse-qual)))))
    (token-case
     (\, (cons qual (parse-guard-quals)))
     (else (list qual)))))

;;; Record construction and update bind tighter than application
;;; (report 3.15): f r {x = 1} is f (r {x = 1}).

(define (parse-aexp)
  (parse-record-suffixes (parse-aexp-1)))

(define (parse-record-suffixes exp)
  (if (and (eq? *token* '\{) (feature? 'records))
      (begin
	(advance-token)
	(let ((fields (parse-field-bindings
		       (function parse-exp) "`='" "record expression")))
	  (parse-record-suffixes
	   (if (and (con-ref? exp) (not (con-ref-infix? exp)))
	       (make record-con (con exp) (fields fields))
	       (begin
		 (when (null? fields)
		   (parser-error 'empty-record-update
		     "A record update must name at least one field."))
		 (make record-update (exp exp) (fields fields)))))))
      exp))

;;; field = item, ..., after the {.  Returns a list of (tuple var-ref item).
;;; Used for expressions and (with parse-pat) patterns.

(define (parse-field-bindings parse-item eq-name what)
  (token-case
   (\} '())
   (else
    (let ((bindings '()))
      (do ((more? '#t))
	  ((not more?))
	(token-case
	 (var
	  (let ((field (var->ast)))
	    (require-token = (signal-missing-token eq-name what))
	    (push (tuple field (funcall parse-item)) bindings)))
	 (else (signal-missing-token "<var>" what)))
	(token-case
	 (\, '#t)
	 (\} (setf more? '#f))
	 (else (signal-missing-token "`,' or `}'" what))))
      (reverse bindings)))))

(define (parse-aexp-1)
 (trace-parser aexp
  (token-case
    (var (save-parser-context (var->ast)))
    (con (save-parser-context (con->ast)))
    (literal (literal->ast))
    (\(
     (token-case
       (\) (**con/def (core-symbol "UnitConstructor")))
       (\, (**con/def (tuple-constructor (parse-tuple-con-commas 2))))
       ((no-advance -) (parse-exp-or-tuple))
       (varop
	(let ((varop (varop->ast)))
	  (make-right-section varop)))
       (conop
	(let ((conop (conop->ast)))
	  (make-right-section conop)))
       (else
	(parse-exp-or-tuple))))
    (\[
     (token-case
      (\] (make list-exp (exps '())))
      (else
       (let ((exp (parse-exp)))
        (token-case
         (\, (let ((exp2 (parse-exp)))
	       (token-case
		 (\] (make list-exp (exps (list exp exp2))))
		 (\.\. (token-case
			 (\] (make sequence-then (from exp) (then exp2)))
			 (else
			   (let ((exp3 (parse-exp)))
			     (require-token
			       \]
			       (signal-missing-token
				 "`]'" "sequence expression"))
			     (make sequence-then-to (from exp) (then exp2)
				                    (to exp3))))))
		 (else
		  (make list-exp
			(exps `(,exp ,exp2 ,@(parse-exp-list))))))))
	 (\.\. (token-case
		 (\] (make sequence (from exp)))
		 (else
		  (let ((exp2 (parse-exp)))
		    (require-token
		      \]
		      (signal-missing-token "`]'" "sequence expression"))
		    (make sequence-to (from exp) (to exp2))))))
	 (\] (make list-exp (exps (list exp))))
	 (\| (parse-list-comp exp))
	 (else
	  (signal-invalid-syntax
	    "a list, sequence, or list comprehension")))))))
    (else
     (signal-invalid-syntax "an aexp")))))

(define (make-right-section op)
  (let ((exps (parse-infix-exps)))
    (token-case
     (\) (make pp-exp-list (exps (cons op exps))))
     (else (signal-missing-token "`)'" "right section expression")))))

(define (parse-exp-list)
  (token-case
   (\] '())
   (\, (let ((exp (parse-exp))) (cons exp (parse-exp-list))))
   (else (signal-missing-token "`]' or `,'" "list expression"))))

(define (parse-exp-or-tuple)
  (let ((exp (parse-exp)))
    (token-case
     (\) exp)  ; Note - sections ending in an op are parsed elsewhere
     (else (make-tuple-cons (cons exp (parse-tuple-exp)))))))

(define (parse-tuple-exp)
  (token-case
   (\) '())
   (\, (let ((exp (parse-exp))) (cons exp (parse-tuple-exp))))
   (else (signal-missing-token
	  "`)' or `,'" "tuple or parenthesized expression"))))

;;; do expressions: a layout block of statements, `let' statements
;;; without `in', generators and expressions.

(define (parse-do)
  (trace-parser do
   (save-parser-context
    (let ((stmts (start-layout (function parse-stmts))))
      (make do-exp (stmts stmts))))))

;;; The layout rule's parse-error(t) (Report 9.3), in the case that matters
;;; for do blocks: a token that cannot begin a statement ends an implicit
;;; block.  So `main = do ...' followed by `where' in the statements'
;;; column (where layout inserts a `;') ends the do block.  Case
;;; alternatives and declaration lists already end on such a token.

(define (parse-stmts in-layout?)
  (token-case
    (\; (parse-stmts in-layout?))
    ((no-advance \} $\})
     (close-layout in-layout?)
     '())
    ((no-advance |where| |in| |of| |then| |else| \) \] \, eof)
     (close-layout in-layout?)
     '())
    (else
     (let ((stmt (token-case
		  (|let| (parse-let-stmt))
		  (else (parse-qual)))))
       (token-case
	(\; (cons stmt (parse-stmts in-layout?)))
	(else (close-layout in-layout?)
	      (list stmt)))))))

;;; `let decls' is a statement; `let decls in exp' is an expression
;;; statement.

(define (parse-let-stmt)
  (let ((qual (parse-let-qual)))
    (if (let-qual? qual)
	(make qual-let (decls (cdr qual)))
	qual)))

;;; List comprehensions

;;; Assume | has been consumed

(define (parse-list-comp exp)
 (save-parser-context 
  (let ((quals (parse-qual-list)))
    (build-list-comp exp quals))))

(define (parse-qual-list)
  (let ((qual (token-case
	       (|let| (parse-let-qual))
	       (else (parse-qual)))))
    (token-case
      (\, (cons qual (parse-qual-list)))
      (\] (list qual))
      (else (signal-missing-token "`]' or `,'" "list comprehension")))))

;;; A `let' qualifier (H98).  `let decls in exp' is still an ordinary
;;; filter; without the `in', the qualifier is returned as the list
;;; (let-qual . decls) for build-list-comp to remove.

(define (parse-let-qual)
  (let* ((line (capture-current-line))
	 (decls (parse-decl-list)))
    (token-case
     (|in| (let* ((body (parse-exp))
		  (let-exp (make let (decls decls) (body body)))
		  (qual (make qual-filter (exp let-exp))))
	     (setf (ast-node-line-number let-exp) line)
	     (setf (ast-node-line-number qual) line)
	     qual))
     (else (cons 'let-qual decls)))))

;;; Later phases only know generators and filters, so let qualifiers are
;;; translated away here (report 3.11):
;;;   [e | let ds, Q]      =  let ds in [e | Q]       ([e] when Q is empty)
;;;   [e | Q1, let ds, Q]  =  [v | Q1, v <- let ds in [e | Q]]
;;; v is a fresh variable; it is bound only around the result v, so it
;;; cannot capture anything.

(define (build-list-comp exp quals)
  (let ((before '())
	(rest quals))
    (do () ((or (null? rest) (let-qual? (car rest))))
      (push (car rest) before)
      (setf rest (cdr rest)))
    (if (null? rest)
	(make list-comp (exp exp) (quals quals))
	(let* ((decls (cdr (car rest)))
	       (after (cdr rest))
	       (inner (make let
			    (decls decls)
			    (body (if (null? after)
				      (make list-exp (exps (list exp)))
				      (build-list-comp exp after))))))
	  (if (null? before)
	      inner
	      (let ((v (make var-ref (name '|let-qual-v|) (infix? '#f)
			     (var *undefined-def*)))
		    (vp (make var-ref (name '|let-qual-v|) (infix? '#f)
			      (var *undefined-def*))))
		(make list-comp
		      (exp v)
		      (quals (append (nreverse before)
				     (list (make qual-generator
						 (pat (make var-pat (var vp)))
						 (exp inner))))))))))))

(define (let-qual? q)
  (and (pair? q) (eq? (car q) 'let-qual)))

(define (parse-qual)
 (trace-parser qual
  (save-parser-context 
   (let* ((saved-excursion (save-scanner-state))
	  (is-gen? (and (scan-pat) (eq-token? '<-))))
    (restore-excursion saved-excursion)
    (cond (is-gen?
	   (let ((pat (parse-pat)))
	     (advance-token) ; past the <-
	     (let ((exp (parse-exp)))
	       (make qual-generator (pat pat) (exp exp)))))
	  (else
	   (let ((exp (parse-exp)))
	     (make qual-filter (exp exp)))))))))

;;; (,), (,,), ... as constructors (H98).  The scanner is just past the
;;; first comma; n is the arity so far.  Returns the arity.

(define (parse-tuple-con-commas n)
  (token-case
   (\, (parse-tuple-con-commas (1+ n)))
   (\) n)
   (else (signal-missing-token "`)' or `,'" "tuple constructor"))))

(define (make-tuple-cons args)
  (let ((tuple-con (**con/def (tuple-constructor (length args)))))
    (**app/l tuple-con args)))
