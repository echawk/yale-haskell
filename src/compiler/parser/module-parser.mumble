;;; File: module-parser         Author: John

;;; This is for using the parser to parse strings.

(define (parse-from-string string parse-proc filename)
 (dynamic-let ((*current-file* filename))
  (call-with-input-string string
    (lambda (port)
      (let ((tokens (lex-port port '#f)))
	(init-token-stream tokens)
	(let ((res (funcall parse-proc)))
	  (if (not (eq-token? 'eof))
	      (signal-leftover-tokens)
	      res)))))))

(define (signal-leftover-tokens)
  (fatal-error 'leftover-tokens
	       "Leftover tokens after parsing."))


;;; This file deals with the basic structure of a module.  It also adds
;;; the `module Main where' required by abbreviated modules.

(define (parse-tokens tokens)
  (init-token-stream tokens)
  (let ((mod (token-case
	      (|module| (parse-module))
	      (else (parse-headerless-module)))))
    (cons mod (parse-module-list))))

;;; A module without a header.  In Haskell 1.2 that means `module Main
;;; where', which exports every local name.  Haskell 98 (report 5.1)
;;; makes it `module Main(main) where'.  In the haskell98 dialect the
;;; export list is (main) whenever the module defines main at top level;
;;; a headerless file without main (a scratch file loaded into the
;;; interactive system) keeps exporting everything rather than failing.

(define (parse-headerless-module)
  (let* ((line (capture-current-line))
	 (mod (parse-modules/named '|Main| '())))
    (when (and (feature? 'headerless-main) (defines-main? mod))
      (let ((entity (make entity-var (name '|main|))))
	(setf (ast-node-line-number entity) line)
	(setf (module-exports mod) (list entity))))
    mod))

(define (defines-main? mod)
  (some (lambda (decl)
	  (and (is-type? 'valdef decl)
	       (is-type? 'var-pat (valdef-lhs decl))
	       (eq? (var-ref-name (var-pat-var (valdef-lhs decl))) '|main|)))
	(module-decls mod)))

(define (parse-module)
  (token-case
   (modid (let* ((mod-name (token->symbol))
		 (exports (parse-exports)))
	    (require-token
	      |where|
	      (signal-missing-token "`where'" "module definition"))
	    (parse-modules/named mod-name exports)))
   (else (signal-missing-token "<modid>" "module definition"))))

(define (parse-module-list)
  (token-case
   (|module|
    (let ((mod (parse-module)))
      (cons mod (parse-module-list))))
   (eof '())
   (else (signal-missing-module))))

(define (signal-missing-module)
  (parser-error 'missing-module
		"Missing `module', or leftover junk after module definition."))

(define (parse-exports)
  (token-case
   ;; module M () where: nothing but instances; '() is no export list
   ;; (everything), so it is 'none until init-modules.mumble
   (\( (if (eq-token? '\))
	    (begin (advance-token) 'none)
	    (parse-export-list)))
   (else '())))

(define (parse-export-list)
  (let ((entity (parse-entity 'export)))
    (token-case
     (\) (list entity))
     (\, (if (eq-token? '\))
	     (begin (advance-token) (list entity))   ; H98: a trailing comma
	     (cons entity (parse-export-list))))
     (else (signal-missing-token "`)' or ','" "export list")))))

(define (parse-modules/named mod-name exports)
  (trace-parser module
    (let ((mod-ast (make module
		     (name mod-name)
		     (type 'standard)
		     (exports exports)
		     (default *standard-module-default*))))
      (start-layout (lambda (in-layout?)
		      (parse-module-decls mod-ast in-layout? 'import))))))

;;; The mod-ast fields are kept in non-reversed order by appending
;;; each decl to the end of the appropriate list.  This loses for
;;; value decls, so these are in reversed order!!

(define (parse-module-decls mod-ast in-layout? state)
  (token-case
   ;; an empty declaration (H98 grammar): `x :: T;' at the end of a line
   ;; is followed by layout's own `;'
   (\; (parse-module-decls mod-ast in-layout? state))
   (|import| (let ((import (parse-import)))
	       (if (eq? state 'import)
		   (push-decl-list import (module-imports mod-ast))
		   (signal-misplaced-import)))
	     (terminate-topdecl mod-ast in-layout? state))
   (|infix| (terminate-topdecl mod-ast in-layout?
			       (parse-fixity 'n mod-ast state)))
   (|infixl| (terminate-topdecl mod-ast in-layout?
				(parse-fixity 'l mod-ast state)))
   (|infixr| (terminate-topdecl mod-ast in-layout?
				(parse-fixity 'r mod-ast state)))
   ((no-advance satisfies at-data-family-decl?)
    (let ((newtype? (eq-token? '|newtype|)))
      (advance-token)
      (if (at-varid-named? "family")
	  (parse-type-family-decl '#t)
	  (parse-data-instance newtype?)))
    (terminate-topdecl mod-ast in-layout? 'topdecl))
   (|data| (let ((data-decl (parse-type-decl '#f)))
	     (push-decl-list data-decl (module-algdatas mod-ast)))
	   (terminate-topdecl mod-ast in-layout? 'topdecl))
   (|newtype| (let ((data-decl (parse-type-decl '#f)))
		(check-newtype-decl data-decl)
		(setf (data-decl-newtype? data-decl) '#t)
		(push-decl-list data-decl (module-algdatas mod-ast)))
	      (terminate-topdecl mod-ast in-layout? 'topdecl))
   ;; PatternSynonyms (GHC), pattern-parser.mumble
   ((no-advance satisfies at-pattern-synonym?)
    (parse-pattern-synonym)
    (terminate-topdecl mod-ast in-layout? 'topdecl))
   ;; StandaloneKindSignatures (GHC): type T :: kind, ignored (kinds
   ;; are inferred)
   ((no-advance satisfies at-standalone-kind-signature?)
    (skip-to-decl-end)
    (terminate-topdecl mod-ast in-layout? 'topdecl))
   ;; TypeFamilies (GHC): type family, type instance, data family,
   ;; data/newtype instance (typedecl-parser.mumble)
   ((no-advance satisfies at-type-family-decl?)
    (advance-token)
    (cond ((at-varid-named? "family") (parse-type-family-decl))
	  (else (advance-token) (parse-type-equation)))
    (terminate-topdecl mod-ast in-layout? 'topdecl))
   ;; RoleAnnotations (GHC): type role T nominal representational;
   ;; roles only restrict coerce, which is not checked here
   ((no-advance satisfies at-role-annotation?)
    (skip-to-decl-end)
    (terminate-topdecl mod-ast in-layout? 'topdecl))
   (|type| (let ((synonym-decl (parse-synonym-decl)))
	     (push-decl-list synonym-decl (module-synonyms mod-ast)))
	   (terminate-topdecl mod-ast in-layout? 'topdecl))
   (|class| (let ((class-decl (parse-class-decl)))
	      ;; Fixity declarations for class methods (H98) are moved to
	      ;; the top level, where the methods are defined.
	      (dolist (d (class-decl-decls class-decl))
		(when (is-type? 'fixity-decl d)
		  (push-decl-list d (module-fixities mod-ast))))
	      (setf (class-decl-decls class-decl)
		    (remove-fixity-decls (class-decl-decls class-decl)))
	      (push-decl-list class-decl (module-classes mod-ast)))
	    (terminate-topdecl mod-ast in-layout? 'topdecl))
   ;; StandaloneDeriving (GHC): deriving instance [ctx =>] C (T a ...)
   ((no-advance satisfies at-standalone-deriving?)
    (advance-token)
    (advance-token)
    (parse-optional-context)   ; the derived instance's context is inferred
    (let* ((class (class->ast))
	   (type (parse-atype)))
      (when (not (tycon? type))
	(signal-invalid-syntax "a standalone deriving declaration"))
      (push (tuple class (tycon-name type)) *standalone-derivings*))
    (terminate-topdecl mod-ast in-layout? 'topdecl))
   (|instance| (let ((instance-decl (parse-instance-decl '#f)))
		 (push-decl-list instance-decl (module-instances mod-ast)))
	       (terminate-topdecl mod-ast in-layout? 'topdecl))
   (|default| (let ((types 
		     (token-case
		      (\( (token-case (\) '())
				      (else (parse-type-list))))
		      (else (list (parse-type))))))
		(if (eq? (module-default mod-ast) *standard-module-default*)
		    (setf (module-default mod-ast)
			  (make default-decl (types types)))
		    (signal-multiple-defaults)))
    (terminate-topdecl mod-ast in-layout? 'topdecl))
   ((begin-annotation no-advance)
    (let ((annotations (parse-annotations)))
      (setf (module-annotations mod-ast)
	    (append (module-annotations mod-ast) annotations)))
    (terminate-topdecl mod-ast in-layout? state))
   (pat-start (if (foreign-decl-start?)
		  (if (foreign-export-start?)
		      (parse-foreign-export mod-ast)
		      (push-decl-list (parse-foreign-import)
				      (module-foreign-imports mod-ast)))
		  (let ((decl (parse-decl)))
		    (setf (module-decls mod-ast)
			  (decl-push decl (module-decls mod-ast)))))
	      (terminate-topdecl mod-ast in-layout? 'topdecl))
   (else
    (maybe-end-module mod-ast in-layout? state))))

;;; DataKinds (GHC): each constructor C of arity n is also a type
;;; constructor C with n parameters and no values, unless the module has
;;; a type named C.  Kinds are not checked, so Vec Z a and Vec (S n) a
;;; are ordinary types; GADT indices (existentials.mumble) need no more.

(define *prelude-type-and-class-names*
  '(|Eq| |Ord| |Show| |Read| |Enum| |Bounded| |Num| |Real| |Integral|
    |Fractional| |Floating| |RealFrac| |RealFloat| |Functor| |Monad|
    |Applicative| |Foldable| |Traversable| |Semigroup| |Monoid| |Maybe|
    |Either| |Ordering| |Bool| |Char| |Int| |Integer| |Float| |Double|
    |IO| |String| |Ix| |Word| |Rational| |ShowS| |ReadS| |FilePath| |IOError|))

(define (add-promoted-constructors mod-ast)
  (let ((types (append (map (lambda (d) (tycon-name (data-decl-simple d)))
			    (module-algdatas mod-ast))
		       (map (lambda (s) (tycon-name (synonym-decl-simple s)))
			    (module-synonyms mod-ast))))
	(new '()))
    (dolist (d (module-algdatas mod-ast))
      (dolist (c (data-decl-constrs d))
	(let* ((cname (symbol->string (con-ref-name (constr-constructor c))))
	       (name (string->symbol (if (has-con-prefix? cname)
					 (remove-con-prefix cname)
					 cname))))
	  ;; unticked, a Prelude type or class name stays that
	  (when (and (not (memq name types))
		     (char-upper-case? (string-ref (symbol->string name) 0))
		     (or (mem-string (symbol->string name) *promoted-names*)
			 (not (memq name *prelude-type-and-class-names*))))
	    (push name types)
	    (let ((i 0))
	      (push (make data-decl (context '())
			  (simple (make tycon (name name) (def *undefined-def*)
					(args (map (lambda (ty)
						     (declare (ignore ty))
						     (incf i)
						     (make tyvar
						       (name (string->symbol
							      (format '#f "p~A" i)))))
						   (constr-types c)))))
			  (constrs '()) (deriving '()) (annotations '()))
		    new))))))
    (setf (module-algdatas mod-ast) (append (module-algdatas mod-ast) new))))

(define (at-type-family-decl?)
  (and (haskell98?) (eq-token? '|type|)
       (or (eq? (peek-1-type) '|instance|)
	   (and (eq? (peek-1-type) 'varid)
		(equal? (peek-1-text) "family")))))

(define (at-role-annotation?)
  (and (haskell98?) (eq-token? '|type|)
       (eq? (peek-1-type) 'varid)
       (equal? (peek-1-text) "role")
       (memq (peek-2-type) '(conid \())))

(define (at-data-family-decl?)
  (and (haskell98?) (memq *token* '(|data| |newtype|))
       (or (eq? (peek-1-type) '|instance|)
	   (and (eq-token? '|data|) (eq? (peek-1-type) 'varid)
		(equal? (peek-1-text) "family")))))

(define (at-standalone-kind-signature?)
  (and (haskell98?) (eq-token? '|type|)
       (memq (peek-1-type) '(conid \())
       (eq? (peek-2-type) '\:\:)))

;;; Skips the rest of a declaration: up to the `;' or `}' ending it.

(define (skip-to-decl-end)
  (do () ((memq *token* '(\; \} $\} eof)))
    (advance-token)))

(define (signal-misplaced-import)
  (parser-error 'misplaced-import
		"The import declaration is misplaced."))

(define (signal-multiple-defaults)
  (parser-error 'multiple-defaults
		"There are multiple default declarations."))

(define (terminate-topdecl mod-ast in-layout? state)
  (token-case
   (\; (parse-module-decls mod-ast in-layout? state))
   (else (maybe-end-module mod-ast in-layout? state))))

(define (maybe-end-module mod-ast in-layout? state)
  (declare (ignore state))
  (cond ((or (eq-token? '|module|) (eq-token? 'eof) (eq-token? '\})
	     (eq-token? '$\}))
	 (close-layout in-layout?)
	 (wrapup-module mod-ast)
	 mod-ast)
	(else
	 (signal-invalid-syntax "a topdecl"))))

(define *standalone-derivings* '())   ; (tuple class-ast type-name)

(define (at-standalone-deriving?)
  (and (haskell98?) (eq-token? '|deriving|) (eq? (peek-1-type) '|instance|)))

;;; A standalone deriving declaration adds the class to the deriving
;;; clause of the type's declaration when that is in this module; one for
;;; a type from elsewhere is kept for the derived-instance phase.

(define (attach-standalone-derivings mod-ast)
  (dolist (d (reverse *standalone-derivings*))
    (let ((decl (lisp:find (tuple-2-2 d) (module-algdatas mod-ast)
			   :key (lambda (dd) (tycon-name (data-decl-simple dd))))))
      (if decl
	  (setf (data-decl-deriving decl)
		(append (data-decl-deriving decl) (list (tuple-2-1 d))))
	  (push d (module-standalone-derivings mod-ast)))))
  (setf *standalone-derivings* '()))

(define (wrapup-module mod-ast)
  (attach-standalone-derivings mod-ast)
  ;; TypeFamilies (typedecl-parser.mumble)
  (setf (module-synonyms mod-ast)
	(append (module-synonyms mod-ast) (reverse *family-decls*)))
  (setf (module-algdatas mod-ast)
	(append (module-algdatas mod-ast) (reverse *family-data-decls*)))
  (setf (module-type-equations mod-ast) (reverse *family-equations*))
  (setf (module-pattern-synonyms mod-ast) *pattern-synonyms*)
  (dolist (d *pattern-builders*)
    (setf (module-decls mod-ast) (decl-push d (module-decls mod-ast))))
  (setf *pattern-synonyms* '())
  (setf *pattern-builders* '())
  (setf *family-decls* '())
  (setf *family-data-decls* '())
  (setf *family-equations* '())
  (when (language-extension? "DataKinds")
    (add-promoted-constructors mod-ast))
  (when (language-extension? "DuplicateRecordFields")
    (add-duplicate-record-fields mod-ast))
  ;; MagicHash: Addr# literals call GHC.Exts.addrLit# (lexer.mumble)
  (when (and (language-extension? "MagicHash")
	     (not (eq? (module-name mod-ast) '|GHC.Exts|)))
    (push (make import-decl (module-name '|GHC.Exts|) (mode 'all)
		(specs '()) (renamings '()) (qualified? '#t) (as-name '#f))
	  (module-imports mod-ast)))
  ;; RecursiveDo: rec and mdo call Control.Monad.Fix.mfix
  (when (language-extension? "RecursiveDo")
    (push (make import-decl (module-name '|Control.Monad.Fix|) (mode 'all)
		(specs '()) (renamings '()) (qualified? '#t) (as-name '#f))
	  (module-imports mod-ast)))
  ;; OverloadedLists: list literals call GHC.IsList.fromList
  (when (language-extension? "OverloadedLists")
    (push (make import-decl (module-name '|GHC.IsList|) (mode 'all)
		(specs '()) (renamings '()) (qualified? '#t) (as-name '#f))
	  (module-imports mod-ast)))
  ;; OverloadedStrings: string literals call Data.String.fromString
  (when (language-extension? "OverloadedStrings")
    (push (make import-decl (module-name '|Data.String|) (mode 'all)
		(specs '()) (renamings '()) (qualified? '#t) (as-name '#f))
	  (module-imports mod-ast)))
  (setf (module-decls mod-ast)
	(nreverse (module-decls mod-ast)))
  ;; Haskell 98 allows an empty body (module M (x) where re-exporting
  ;; only the Prelude's names, or module Main where with nothing)
  (when (and (not (haskell98?))
	     (null? (module-imports mod-ast))
	     (null? (module-decls mod-ast))
	     (null? (module-algdatas mod-ast))
	     (null? (module-synonyms mod-ast))
	     (null? (module-instances mod-ast))
	     (null? (module-classes mod-ast))
	     (null? (module-foreign-imports mod-ast))
	     (null? (module-foreign-exports mod-ast)))
    (signal-empty-module)))

(define (signal-empty-module)
  (parser-error 'empty-module "Module definition is empty."))

(define (parse-import)
 (save-parser-context
  (let ((qualified? (parse-import-qualified)))
  ;; PackageImports (GHC): import "pkg" M; the package is ignored
  (when (eq-token? 'string) (advance-token))
  (token-case
   (modid (let* ((mod (token->symbol))
		 ;; ImportQualifiedPost (GHC): import M qualified as X
		 (_ (when (parse-import-qualified) (setf qualified? '#t)))
		 (as-name (parse-import-as))
		 (mode 'all)
		 (specs '()))
	    (token-case
	     (\( (setf mode 'by-name)
		 (token-case
		  (\) (setf specs '()))
		  (else (setf specs (parse-import-list)))))
	     (|hiding| (parse-import-hiding (lambda (l) (setf specs l))))
	     (else
	      ;; Haskell 98: hiding is an identifier except here
	      (when (at-varid-named? "hiding")
		(advance-token)
		(parse-import-hiding (lambda (l) (setf specs l))))))
	    (let ((renamings (token-case (|renaming|
					   (require-token
					     \(
					     (signal-missing-token
					       "`('" "renaming clause"))
					   (parse-renamings))
					 (else '()))))
	      (make import-decl (module-name mod) (mode mode) (specs specs)
		                (renamings renamings)
				(qualified? qualified?) (as-name as-name)))))
   (else
    (signal-missing-token "<modid>" "import declaration"))))))

;;; After `hiding': the list of hidden entities, passed to SET-SPECS.

(define (parse-import-hiding set-specs)
  (require-token \( (signal-missing-token "`('" "hiding clause"))
  (funcall set-specs (parse-import-list)))

;;; `qualified' and `as' are ordinary identifiers except in these places.
;;; The scanner is at `qualified' / after the module name.

(define (parse-import-qualified)
  (if (and (feature? 'qualified-names) (at-varid-named? "qualified"))
      (begin (advance-token) '#t)
      '#f))

(define (parse-import-as)
  (if (and (feature? 'qualified-names) (at-varid-named? "as"))
      (begin
	(advance-token)
	(token-case
	 (modid (token->symbol))
	 (else (signal-missing-token "<modid>" "import ... as"))))
      '#f))

(define (at-varid-named? name)
  (and (eq? *token* 'varid) (string=? (car *token-args*) name)))

(define (parse-import-list)
  (let ((import (parse-entity 'import)))
    (token-case
     (\, (if (eq-token? '\))
	     (begin (advance-token) (list import))   ; H98: a trailing comma
	     (cons import (parse-import-list))))
     (\) (list import))
     (else (signal-missing-token "`)' or `,'" "import list")))))

(define (parse-renamings)
 (let ((renaming
	(save-parser-context
	 (token-case
	  (var (let ((name1 (var->symbol)))
		 (require-token
		   |to|
		   (signal-missing-token "`to'" "import renaming clause"))
		 (token-case
		  (var (let ((name2 (var->symbol)))
			 (make renaming (from name1) (to name2)
			       (referenced? '#f))))
		  (else (signal-invalid-syntax "import renaming clause")))))
	  (con (let ((name1 (con->symbol)))
		 (require-token
 		   |to| 
		   (signal-missing-token "`to'" "import renaming clause"))
		 (token-case
		  (con (let ((name2 (con->symbol)))
			 (make renaming (from name1) (to name2)
			       (referenced? '#f))))
		  (else (signal-invalid-syntax "import renaming clause")))))
	  (else (signal-invalid-syntax "import renaming clause"))))))
    (token-case (\, (cons renaming (parse-renamings)))
		(\) (list renaming)))))

(define (parse-fixity associativity mod-ast state)
  (let ((fixity-decl (parse-fixity-decl associativity)))
    (push-decl-list fixity-decl (module-fixities mod-ast))
    ;; Haskell 1.2 allows fixity declarations only between the imports
    ;; and the other topdecls; Haskell 98 allows them anywhere among
    ;; the topdecls.  Their order does not matter to later phases.
    (cond ((or (eq? state 'import)
	       (eq? state 'fixity))
	   'fixity)
	  ((feature? 'fixity-anywhere)
	   state)
	  (else
	   (signal-misplaced-fixity)
	   state))))

;;; Just past the infix/infixl/infixr keyword.  Also used for fixity
;;; declarations in let, where and class bodies (decl-parser).

(define (parse-fixity-decl associativity)
  (save-parser-context
   (let* ((prec (token-case
		 (k (let ((p (token->integer)))
		      (cond ((<= p 9)
			     p)
			    (else
			     (signal-bad-fixity)
			     9))))
		 (else 9)))
	  (ops (parse-op-list))
	  (fixity (make fixity (associativity associativity)
			(precedence prec))))
     (make fixity-decl (fixity fixity) (names ops)))))


(define (signal-bad-fixity)
  (parser-error 'bad-fixity
		"Expecting fixity value of 0 - 9."))

(define (signal-misplaced-fixity)
  (parser-error 'misplaced-fixity "The fixity declaration is misplaced."))

(define (parse-op-list)
  (let ((name (token-case
	       (op (op->symbol))
	       (else (signal-missing-token "<op>" "fixity declaration")))))
    (token-case
     (\, (cons name (parse-op-list)))
     (else (list name)))))

;;; PatternSynonyms: `pattern P' in an export or import list names P's
;;; builder, pattern%P, whose def carries the synonym's template
;;; (pattern-parser.mumble).

(define (pattern-entity-start?)
  (and (at-varid-named? "pattern")
       (let ((saved  (save-scanner-state)))
	 (advance-token)
	 (let ((res  (memq *token* '(conid \())))
	   (restore-excursion saved)
	   res))))

(define (parse-entity context)
 (trace-parser entity
  (save-parser-context
   (if (pattern-entity-start?)
       (begin
	 (advance-token)		; pattern
	 (make entity-var (name (pattern-builder-name (con->symbol)))))
       (parse-entity-1 context)))))

(define (parse-entity-1 context)
   (token-case
    (var (var->entity))
    ;; ExplicitNamespaces (GHC): `type (+++)', `type T' name a type
    ;; (constructor); an operator is the type operator (type-parser.mumble)
    (|type|
     (token-case
      (\( (if (memq *token* '(consym varsym))
	      (let ((name (if (eq? *token* 'varsym)
			      (string->symbol (string-append "type%" (car *token-args*)))
			      (token->symbol))))
		(advance-token)
		(require-token \) (signal-missing-token "`)'" "type operator entity"))
		(make entity-con (name name)))
	      (signal-invalid-syntax "an entity")))
      (else (parse-entity context))))
    ;; Haskell 98: `module M' (Haskell 1.2 wrote M..), in an export list
    (|module|
     (if (eq? context 'export)
	 (token-case
	  (modid (make entity-module (name (token->symbol))))
	  (else (signal-missing-token "<modid>" "module export")))
	 (signal-invalid-syntax "an entity")))
    ;; TypeOperators: (:*:)(..), a type or class named by an operator
    ((no-advance satisfies operator-tycon-entity?)
     (advance-token)
     (let ((name (token->symbol)))
       (advance-token)
       (parse-entity-tycon-rest name context)))
    (tycon
     (parse-entity-tycon-rest (token->symbol) context))
    (else (signal-invalid-syntax "an entity"))))

(define (operator-tycon-entity?)
  (and (eq-token? '\()
       (eq? (peek-1-type) 'consym)
       (eq? (peek-2-type) '\))))

;;; After a type or class name in an import or export list: (..), (a, b)
;;; or nothing.
(define (parse-entity-tycon-rest name context)
       (token-case
	(\( (token-case
	     (\.\. (token-case
		    ;; T (.., P, Q): T(..) and the pattern synonyms P, Q
		    ;; bundled with it (PatternSynonyms)
		    (\, (make entity-datatype (name name)
			      (constructors (cons '|..| (parse-con-list)))))
		    (else
		     (require-token
		      '\)
		      (signal-missing-token "`)'" "class or datatype entity"))
		     (make entity-abbreviated (name name)))))
	     (var (parse-entity-class name))
	     (con (parse-entity-datatype name))
	     (\) (make entity-class (name name) (methods '())))
	     (else (signal-invalid-syntax "an entity"))))
	(\.\. (if (eq? context 'export)
		  (make entity-module (name name))
		  (signal-invalid-syntax "an entity")))
	(else
	 (make entity-con (name name)))))

(define (parse-entity-class class-name)
  (let ((vars (parse-var-list)))
    (make entity-class (name class-name) (methods vars))))

(define (parse-entity-datatype type-name)
  (let ((constrs (parse-con-list)))
    (make entity-datatype (name type-name) (constructors constrs))))

(define (parse-var-list)
  (token-case
   (var (let ((name (var->symbol)))
	  (token-case
	   (\) (list name))
	   (\, (cons name (if (feature? 'records)
			     (parse-con-list)
			     (parse-var-list))))
	   (else
	    (signal-missing-token "`)' or `,'" "class entity")))))
   (else (signal-missing-token "<var>" "class entity"))))

;;; Constructors and (records) field names: T(C1, f, C2).

(define (parse-con-list)
  (let ((name (token-case
	       (con (con->symbol))
	       (else
		(if (feature? 'records)
		    (token-case
		     (var (var->symbol))
		     (else (signal-missing-token "<con> or <var>" "entity")))
		    (signal-missing-token "<con>" "datatype entity"))))))
    (token-case
     (\) (list name))
     (\, (cons name (parse-con-list)))
     (else (signal-missing-token "`)' or `,'" "datatype entity")))))

;;; T(f, ...) names class methods, or record fields and constructors of a
;;; datatype; which one is decided when T is resolved (locate-entity).


;;; The FFI (Haskell 2010 chapter 8): foreign is an identifier except at
;;; the start of a top-level declaration followed by import or export.

(define (foreign-decl-start?)
  (and (haskell98?)
       (at-varid-named? "foreign")
       (let ((saved  (save-scanner-state)))
	 (advance-token)
	 (let ((res  (or (eq? *token* '|import|) (at-varid-named? "export"))))
	   (restore-excursion saved)
	   res))))

(define (foreign-export-start?)
  (let ((saved  (save-scanner-state)))
    (advance-token)
    (let ((res  (at-varid-named? "export")))
      (restore-excursion saved)
      res)))

(define (parse-foreign-callconv what)
  (if (or (at-varid-named? "ccall") (at-varid-named? "capi"))
      (advance-token)
      (parser-error 'foreign-callconv
		    (format '#f "The calling convention of a foreign ~A must be ccall."
			    what))))

(define (parse-foreign-entity)
  (token-case
   ((string no-advance)
    (let ((s  (car *token-args*)))
      (advance-token)
      s))
   (else "")))

;;; foreign export ccall ["entity"] f :: t.  The entity is the C name,
;;; by default f's.  See the foreign-export struct (ast/modules.mumble).

(define (parse-foreign-export mod-ast)
  (let ((line  (capture-current-line)))
    (advance-token)			; foreign
    (advance-token)			; export
    (parse-foreign-callconv "export")
    (let* ((entity  (parse-foreign-entity))
	   (sd      (parse-signdecl))
	   (vars    (signdecl-vars sd)))
      (when (not (null? (cdr vars)))
	(parser-error 'foreign-vars
		      "A foreign export declares exactly one name."))
      (let* ((name    (var-ref-name (car vars)))
	     (hidden  (string->symbol (format '#f "~A%fexport" name)))
	     (ref     (generated-var-ref hidden))
	     (sign    (make signdecl (vars (list (generated-var-ref hidden)))
			    (signature (signdecl-signature sd))))
	     (def     (**valdef/pat (make var-pat (var ref))
				    (generated-var-ref name)))
	     (fe      (make foreign-export (var ref) (name name)
			    (entity (if (string=? entity "")
					(symbol->string name)
					entity)))))
	(setf (ast-node-line-number sign) line)
	(setf (ast-node-line-number def) line)
	(setf (ast-node-line-number fe) line)
	(setf (module-decls mod-ast) (decl-push sign (module-decls mod-ast)))
	(setf (module-decls mod-ast) (decl-push def (module-decls mod-ast)))
	(push-decl-list fe (module-foreign-exports mod-ast))))))

(define (parse-foreign-import)
  (let ((line  (capture-current-line)))
    (advance-token)			; foreign
    (advance-token)			; import
    (parse-foreign-callconv "import")
    (when (or (at-varid-named? "safe") (at-varid-named? "unsafe")
	      (at-varid-named? "interruptible"))
      (advance-token))
    (let* ((entity  (parse-foreign-entity))
	   (sd      (parse-signdecl))
	   (vars    (signdecl-vars sd)))
      (when (not (null? (cdr vars)))
	(parser-error 'foreign-vars
		      "A foreign import declares exactly one name."))
      (let ((fi  (make foreign-import (var (car vars)) (entity entity)
		       (signature (signdecl-signature sd)))))
	(setf (ast-node-line-number fi) line)
	fi))))

;;; DuplicateRecordFields (GHC): a field name used by several types of
;;; the module is renamed f%T in each type T (its selector).  A record
;;; construction, pattern or update finds the field through the
;;; constructor (prec/scope.mumble's resolve-field-bindings), and a use
;;; of f as a function (OverloadedRecordDot's e.f) is getField%f of the
;;; generated class HasField%f r a | r -> a, which has an instance for
;;; each T.

(define (add-duplicate-record-fields mod-ast)
  (let ((owners '()))   ; (field . data-decls)
    (dolist (d (module-algdatas mod-ast))
      (dolist (label (lisp:remove-duplicates
		      (lisp:mapcan (lambda (c) (append (constr-field-labels c) '()))
				   (data-decl-constrs d))))
	(let ((e (assq label owners)))
	  (if e (setf (cdr e) (cons d (cdr e))) (push (list label d) owners)))))
    (dolist (e owners)
      (when (pair? (cddr e))
	(let ((field (car e)))
	  (push field (module-duplicate-fields mod-ast))
	  (push (has-field-class field) (module-classes mod-ast))
	  (dolist (d (cdr e))
	    (let ((tname (tycon-name (data-decl-simple d))))
	      (push (has-field-instance field d) (module-instances mod-ast))
	      (dolist (c (data-decl-constrs d))
		(setf (constr-field-labels c)
		      (map (lambda (l) (if (eq? l field) (renamed-field field tname) l))
			   (constr-field-labels c)))))))))))

(define (renamed-field field tname)
  (string->symbol (format '#f "~A%~A" field tname)))

(define (has-field-class-name field)
  (string->symbol (format '#f "HasField%~A" field)))

(define (has-field-getter field)
  (string->symbol (format '#f "getField%~A" field)))

(define (has-field-class field)
  (make class-decl
	(class (make class-ref (name (has-field-class-name field)) (class *undefined-def*)))
	(super-classes '())
	(class-var '|r|)
	(decls (list (make signdecl
			   (vars (list (generated-var-ref (has-field-getter field))))
			   (signature (make signature (context '())
					    (type (**tycon/def (core-symbol "Arrow")
							       (list (make tyvar (name '|r|))
								     (make tyvar (name '|a|))))))))))
	(class-vars '(|r| |a|))
	(fundeps (list (tuple '(|r|) '(|a|))))))

(define (has-field-instance field d)
  (let* ((simple (data-decl-simple d))
	 (head (make tycon (name (tycon-name simple)) (def *undefined-def*)
		     (args (map (lambda (v) (make tyvar (name (tyvar-name v))))
				(tycon-args simple)))))
	 (ftype (field-type-of field d)))
    (make instance-decl (context '())
	  (class (make class-ref (name (has-field-class-name field)) (class *undefined-def*)))
	  (simple head)
	  (decls (list (**define (has-field-getter field) '()
				 (generated-var-ref
				  (renamed-field field (tycon-name simple))))))
	  (types (list head ftype))
	  (mcontext '()))))

;;; The field's type, from the first constructor that has it.
(define (field-type-of field d)
  (let ((result '#f))
    (dolist (c (data-decl-constrs d))
      (when (not result)
	(do ((ls (constr-field-labels c) (cdr ls))
	     (ts (constr-types c) (cdr ts)))
	    ((or (null? ls) result))
	  (when (eq? (car ls) field)
	    (setf result (tuple-2-1 (car ts)))))))
    result))
