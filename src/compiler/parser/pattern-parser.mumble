;;;  File: pattern-parser        Author: John

;;; This parses the pattern syntax except for the parts which need to be
;;; resolved by precedence parsing.

;;; This parses a list of alternating pats & conops.

(define (parse-pat)
 (trace-parser pat
   (let ((res (parse-pat/list)))
     (if (null? (cdr res))
	 (car res)
	 (make pp-pat-list (pats res))))))

;;; This parses a list of patterns with intervening conops and + patterns

(define (parse-pat/list)
  (token-case
    (con (let ((pcon (pcon->ast)))
	   (if (record-pattern-follows?)
	       (cons (parse-record-pat pcon) (parse-pat/tail))
	       (begin
		 (setf (pcon-pats pcon) (parse-apat-list))
		 (cons pcon (parse-pat/tail))))))
    (-n
     (advance-token) ; past -
     (token-case
      (numeric (let ((val (literal->ast)))
		 (cons (make pp-pat-negated)
		       (cons (make const-pat (value val))
			     (parse-pat/tail)))))
      (else
       (signal-missing-token "<number>" "negative literal pattern"))))
    (var
     (let ((var (var->ast)))
       (token-case
	(+k (cons (make var-pat (var var))
		  (parse-+k-pat)))
	(@  (let ((pattern (parse-apat)))
	      (cons (make as-pat (var var) (pattern pattern))
		    (parse-pat/tail))))
	(else (cons (make var-pat (var var)) (parse-pat/tail))))))
    (_
     (let ((pat (make wildcard-pat)))
       (token-case
	(+k (cons pat (parse-+k-pat)))
	(else (cons pat (parse-pat/tail))))))
    ((no-advance satisfies at-tuple-con?)
     (let ((pcon (parse-tuple-pcon)))
       (setf (pcon-pats pcon) (parse-apat-list))
       (cons pcon (parse-pat/tail))))
    (else (let ((apat (parse-apat)))
	    (cons apat (parse-pat/tail))))))

;;; con { field = pat, ... } (report 3.17.1); the scanner is at the `{'.

(define (record-pattern-follows?)
  (and (eq? *token* '\{) (feature? 'records)))

(define (parse-record-pat pcon)
  (advance-token)
  (make record-pat
	(con pcon)
	(fields (parse-field-bindings
		 (function parse-pat) "`='" "record pattern"
		 (lambda (name)
		   (make var-pat (var (make var-ref (name name) (infix? '#f)
					    (var *undefined-def*)))))))))

;;; (,), (,,), ... as constructors (H98).  The scanner is at the `('.

(define (parse-tuple-pcon)
  (advance-token)
  (advance-token)
  (**pcon/def (tuple-constructor (parse-tuple-con-commas 2)) '()))


(define (parse-+k-pat)
  (advance-token)  ; past +
  (token-case
   (k (let ((val (literal->ast)))
	(cons (make pp-pat-plus)
	      (cons (make const-pat (value val))
		    (parse-pat/tail)))))
   (else (signal-missing-token "<integer>" "successor pattern"))))

(define (parse-pat/tail)
   (token-case
     (conop
      (let ((con (pconop->ast)))
	(cons con (parse-pat/list))))
     (else '())))

(define (parse-apat)
 (if (at-bang?)
     (begin (advance-token)
	    (make bang-pat (pattern (parse-apat))))
     (parse-apat-1)))

;;; A bang pattern's ! (lexer.mumble's bang-shaped?).

(define (at-bang?)
  (and (eq? *token* 'varsym)
       (pair? (cdr *token-args*))
       (eq? (cadr *token-args*) 'prefix)))

(define (parse-apat-1)
 (trace-parser apat
   (token-case
     (var (let ((var (var->ast)))
	    (token-case
	     (@
	      (let ((pattern (parse-apat)))
		(make as-pat (var var) (pattern pattern))))
	     (else (make var-pat (var var))))))
     (con (let ((pcon (pcon->ast)))
	    (if (record-pattern-follows?)
		(parse-record-pat pcon)
		pcon)))
     (literal (let ((value (literal->ast)))
		(make const-pat (value value))))
     (_ (make wildcard-pat))
     (\( (token-case
           (\) (**pcon/def (core-symbol "UnitConstructor") '()))
	   (\, (**pcon/def (tuple-constructor (parse-tuple-con-commas 2)) '()))
	   (else
	    (let ((pat (if (view-pattern-follows?)
			   (parse-view-pattern)
			   (parse-pat))))
	      (token-case
		(\, (**pcon/tuple (cons pat (parse-pat-list '\)))))
		(\) pat)
		;; (pat :: type), outside Haskell 1.2
		((no-advance satisfies pattern-signature-follows?)
		 (advance-token)
		 (let ((signature (parse-signature)))
		   (require-token \)
		     (signal-missing-token "`)'" "pattern type signature"))
		   (make sig-pat (pattern pat) (signature signature))))
		(else
		 (signal-missing-token "`)' or `,'" "pattern")))))))
     (\[ (token-case
	  (\] (make list-pat (pats '())))
	  (else (make list-pat (pats (parse-pat-list '\]))))))
     (\~ (let ((pattern (parse-apat)))
	   (make irr-pat (pattern pattern))))
     (else
      (signal-invalid-syntax "an apat")))))

(define (pattern-signature-follows?)
  (and (eq? *token* '\:\:) (haskell98?)))

(define (parse-pat-list term)  ;; , separated
  (let ((pat (parse-pat)))
    (token-case
     (\, (cons pat (parse-pat-list term)))
     ((unquote term) (list pat))
     (else
      (signal-missing-token
        (if (eq? term '\)) "`)'" "`]'")
	"pattern")))))

(define (parse-apat-list)  ;; space separated
  (if (at-bang?)
      (let ((pat (parse-apat)))
	(cons pat (parse-apat-list)))
      (parse-apat-list-1)))

(define (parse-apat-list-1)
  (token-case
    (apat-start
     (let ((pat (parse-apat)))
       (cons pat (parse-apat-list))))
    (else
     '())))

;;; The following routine scans patterns without creating ast structure.
;;; They return #t or #f depending on whether a valid pattern was encountered.
;;; The leave the scanner pointing to the next token after the pattern.

(define (scan-pat)  ; same as parse-pat/list
  (and
   (token-case
    (con (scan-con)
	 (scan-apat-list))
    (-n (advance-token)
	(token-case
	 (numeric (advance-token)
		  '#t)
	 (else '#f)))
    (var (and (scan-var)
	      (token-case
	       (@ (scan-apat))
	       (+k (scan-+k))
	       (else '#t))))
    (_ (scan-+k))
    ((no-advance satisfies at-tuple-con?)
     (advance-token)
     (advance-token)
     (and (scan-tuple-con-commas)
	  (scan-apat-list)))
    (else (scan-apat)))
   (scan-pat/tail)))

(define (scan-pat/tail)
  (token-case
   (conop (and (scan-conop)
	       (scan-pat)))
   (else '#t)))

(define (scan-apat)
  (if (at-bang?)
      (begin (advance-token) (scan-apat))
      (scan-apat-1)))

(define (scan-apat-1)
  (token-case
   (var (scan-var)
	(token-case
	 (@ (scan-apat))
	 (else '#t)))
   (con (scan-con))
   (literal (advance-token)
	    '#t)
   (_ '#t)
   (\( (token-case
	(\) '#t)
	(\, (scan-tuple-con-commas))
	(else
	 (and (scan-pat)
	      (token-case
	       (\, (scan-pat-list '\)))
	       (\) '#t)
	       (\:\: (scan-to-close-paren 0))
	       (else '#f))))))
   (\[ (token-case
	(\] '#t)
	(else (scan-pat-list '\]))))
   (\~ (scan-apat))
   (else '#f)))

(define (scan-pat-list term)
  (and (scan-pat)
       (token-case
	(\, (scan-pat-list term))
	((unquote term) '#t)
	(else '#f))))

(define (scan-apat-list)
  (if (at-bang?)
      (and (scan-apat) (scan-apat-list))
      (scan-apat-list-1)))

(define (scan-apat-list-1)
  (token-case
   (apat-start
    (and (scan-apat)
	 (scan-apat-list)))
   (else '#t)))

(define (scan-var)
  (token-case
   (varid '#t)
   (\( (token-case
	(varsym
	 (token-case
	  (\) '#t)
	  (else '#f)))
	(else '#f)))
   (else '#f)))

(define (scan-con)
  (token-case
   (conid '#t)
   (\( (token-case
	(consym
	 (token-case
	  (\) '#t)
	  (else '#f)))
	(else '#f)))
   (else '#f)))

(define (scan-conop)
  (token-case
   (consym '#t)
   (\` (token-case
	(conid
	 (token-case
	  (\` '#t)
	  (else '#f)))
	(else '#f)))
   (else '#f)))

(define (scan-+k)
  (token-case
   (+k (advance-token)  ; past the +
       (token-case
	(integer '#t)
	(else '#f)))
   (else '#t)))


(define (scan-tuple-con-commas)  ; just past the first comma of (,,...)
  (token-case
   (\, (scan-tuple-con-commas))
   (\) '#t)
   (else '#f)))

;;; Skips a pattern signature's type: the tokens up to and including the
;;; `)' that closes the pattern.
(define (scan-to-close-paren depth)
  (token-case
   (\( (scan-to-close-paren (1+ depth)))
   (\) (if (eqv? depth 0) '#t (scan-to-close-paren (1- depth))))
   (eof '#f)
   (else (advance-token) (scan-to-close-paren depth))))

;;; ViewPatterns (GHC): (e -> pat).  The pattern becomes a new variable
;;; v, and (pat, e) is recorded on *view-patterns*; the clause, case
;;; alternative or lambda it is in matches it as a pattern guard,
;;; pat <- e v (decl-parser.mumble's add-view-pattern-guards).

(define *view-patterns* (quote ()))   ; (var-name exp pat), newest first

(define (view-pattern-follows?)
  (and (language-extension? "ViewPatterns")
       (let* ((saved (save-scanner-state))
	      (res (scan-for-view-arrow 0)))
	 (restore-excursion saved)
	 res)))

(define (scan-for-view-arrow depth)
  (token-case
   (-> (eqv? depth 0))
   ((\( \[) (scan-for-view-arrow (1+ depth)))
   ((\) \]) (and (> depth 0) (scan-for-view-arrow (1- depth))))
   (\, (and (> depth 0) (scan-for-view-arrow depth)))
   ((= \| \; \} |where| <- eof) '#f)
   (else (advance-token) (scan-for-view-arrow depth))))

(define *view-pattern-count* 0)

(define (parse-view-pattern)
  (let ((exp (parse-exp)))
    (require-token -> (signal-missing-token "`->'" "view pattern"))
    (let ((pat (parse-pat))
	  (name (string->symbol
		 (format '#f "view%~A" (incf *view-pattern-count*)))))
      (push (list name exp pat) *view-patterns*)
      (make var-pat (var (generated-var-ref name))))))

;;; Takes the view patterns recorded since the last call (oldest first).

(define (take-view-patterns)
  (let ((v  (reverse *view-patterns*)))
    (setf *view-patterns* '())
    v))

;;; The guards of RHS-LIST, given VIEWS: each guard g becomes the pattern
;;; guard  p1 <- e1 v1, ..., pn <- en vn, g.

(define (add-view-pattern-guards views rhs-list)
  (if (null? views)
      rhs-list
      (map (lambda (grhs)
	     (let ((g      (guarded-rhs-guard grhs))
		   (quals  (map (lambda (v)
				  (make qual-generator
					(pat (caddr v))
					(exp (make app (fn (cadr v))
						   (arg (generated-var-ref (car v)))))))
				views)))
	       (make guarded-rhs
		     (guard (make pattern-guard
				  (quals (append quals
						 (cond ((is-type? 'omitted-guard g) '())
						       ((is-type? 'pattern-guard g)
							(pattern-guard-quals g))
						       (else (list (make qual-filter (exp g)))))))))
		     (rhs (guarded-rhs-rhs grhs)))))
	   rhs-list)))

;;; PatternSynonyms (GHC), within a module:
;;;   pattern P x y = pat        (bidirectional)
;;;   pattern P x y <- pat [where P x y = e]
;;;   pattern P :: type          (ignored)
;;; A use P p1 ... pn in a pattern is pat with x, y, ... replaced by the
;;; patterns (prec/prec-parse.mumble's massage-pattern); in an expression
;;; P is the function pattern%P (prec/scope.mumble), defined from pat (as
;;; an expression) or from the where clause.  Not exported.

(define *pattern-synonyms* '())     ; (name params pat)
(define *pattern-builders* '())     ; decls of the pattern%P functions

(define (at-pattern-synonym?)
  (and (at-varid-named? "pattern")
       (memq (peek-1-type) '(conid \())
       (language-extension? "PatternSynonyms")))

(define (parse-pattern-synonym)
  (advance-token)
  (if (eq? (peek-1-type) '\:\:)
      (skip-to-decl-end)   ; a signature
      (let* ((name (con->symbol))
	     (params (parse-pattern-synonym-params)))
	(token-case
	 (= (let ((pat (parse-pat)))
	      (push (list name params pat) *pattern-synonyms*)
	      (push (pattern-builder name params (pattern->exp pat))
		    *pattern-builders*)))
	 (<- (let ((pat (parse-pat)))
	       (push (list name params pat) *pattern-synonyms*)
	       (when (eq-token? '|where|)
		 (advance-token)
		 (let ((decls (parse-decl-list)))
		   (when (pair? decls)
		     (let ((builder (explicit-pattern-builder (car decls))))
		       (when builder
			 (push (pattern-builder name (car builder) (cdr builder))
			       *pattern-builders*))))))))
	 (else (signal-missing-token "`=' or `<-'" "pattern synonym"))))))

(define (parse-pattern-synonym-params)
  (if (eq-token? 'varid)
      (let ((v (token->symbol)))
	(cons v (parse-pattern-synonym-params)))
      '()))

(define (pattern-builder-name name)
  (let ((s (symbol->string name)))
    (string->symbol (string-append "pattern%"
				   (if (has-con-prefix? s) (remove-con-prefix s) s)))))

;;; pattern%P x y = e
(define (pattern-builder name params exp)
  (**define (pattern-builder-name name) params exp))

;;; where P x y = e: (params . e), or #f
(define (explicit-pattern-builder decl)
  (and (is-type? 'valdef decl)
       (let ((lhs  (valdef-lhs decl))
	     (defs (valdef-definitions decl)))
	 (and (pair? defs)
	      (let* ((def (car defs))
		     (args (cond ((is-type? 'pcon lhs) (pcon-pats lhs))
				 ((is-type? 'pp-pat-list lhs) (cdr (pp-pat-list-pats lhs)))
				 (else (single-fun-def-args def))))
		     (rhs (car (single-fun-def-rhs-list def))))
		(and (every (lambda (p) (is-type? 'var-pat p)) args)
		     (cons (map (lambda (p) (var-ref-name (var-pat-var p))) args)
			   (guarded-rhs-rhs rhs))))))))

;;; A pattern as the expression that builds the value it matches.
(define (pattern->exp p)
  (cond ((is-type? 'var-pat p) (generated-var-ref (var-ref-name (var-pat-var p))))
	((is-type? 'const-pat p) (const-pat-value p))
	((is-type? 'pcon p)
	 (**app/l (make con-ref (name (pcon-name p)) (con (pcon-con p))
			(infix? (pcon-infix? p)))
		  (map (function pattern->exp) (pcon-pats p))))
	((is-type? 'list-pat p)
	 (make list-exp (exps (map (function pattern->exp) (list-pat-pats p)))))
	((is-type? 'pp-pat-list p)
	 (make pp-exp-list (exps (map (function pattern->exp) (pp-pat-list-pats p)))))
	((is-type? 'bang-pat p) (pattern->exp (bang-pat-pattern p)))
	((is-type? 'sig-pat p) (pattern->exp (sig-pat-pattern p)))
	(else (parser-error 'pattern-synonym-not-invertible
		"A pattern synonym with = needs a pattern that is also an expression; use <- and where."))))

;;; The pattern of a use: a copy of the synonym's, its parameters replaced.
(define (instantiate-pattern-synonym syn args)
  (copy-pattern (caddr syn)
		(map (lambda (v a) (tuple v a)) (cadr syn) args)))

(define (copy-pattern p env)
  (cond ((is-type? 'var-pat p)
	 (let ((b (assq (var-ref-name (var-pat-var p)) env)))
	   (if b
	       (tuple-2-2 b)
	       (make var-pat (var (generated-var-ref (var-ref-name (var-pat-var p))))))))
	((is-type? 'wildcard-pat p) (make wildcard-pat))
	((is-type? 'const-pat p) (make const-pat (value (const-pat-value p))))
	((is-type? 'pcon p)
	 (make pcon (name (pcon-name p)) (con (pcon-con p)) (infix? (pcon-infix? p))
	       (pats (map (lambda (q) (copy-pattern q env)) (pcon-pats p)))))
	((is-type? 'list-pat p)
	 (make list-pat (pats (map (lambda (q) (copy-pattern q env)) (list-pat-pats p)))))
	((is-type? 'pp-pat-list p)
	 (make pp-pat-list (pats (map (lambda (q) (copy-pattern q env)) (pp-pat-list-pats p)))))
	((is-type? 'as-pat p)
	 (make as-pat (var (generated-var-ref (var-ref-name (as-pat-var p))))
	       (pattern (copy-pattern (as-pat-pattern p) env))))
	((is-type? 'irr-pat p) (make irr-pat (pattern (copy-pattern (irr-pat-pattern p) env))))
	((is-type? 'bang-pat p) (make bang-pat (pattern (copy-pattern (bang-pat-pattern p) env))))
	(else p)))
