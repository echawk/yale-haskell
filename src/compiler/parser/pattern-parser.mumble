;;;  File: pattern-parser        Author: John

;;; This parses the pattern syntax except for the parts which need to be
;;; resolved by precedence parsing.

;;; This parses a list of alternating pats & conops.

(define (parse-pat)
 (trace-parser pat
   (let ((res (parse-pat/list)))
     (if (null? (cdr res))
	 (car res)
	 (make pp-pat-list (pats res))))))

;;; This parses a list of patterns with intervening conops and + patterns

(define (parse-pat/list)
  (token-case
    (con (let ((pcon (pcon->ast)))
	   (if (record-pattern-follows?)
	       (cons (parse-record-pat pcon) (parse-pat/tail))
	       (begin
		 (setf (pcon-pats pcon) (parse-apat-list))
		 (cons pcon (parse-pat/tail))))))
    (-n
     (advance-token) ; past -
     (token-case
      (numeric (let ((val (literal->ast)))
		 (cons (make pp-pat-negated)
		       (cons (make const-pat (value val))
			     (parse-pat/tail)))))
      (else
       (signal-missing-token "<number>" "negative literal pattern"))))
    (var
     (let ((var (var->ast)))
       (token-case
	(+k (cons (make var-pat (var var))
		  (parse-+k-pat)))
	(@  (let ((pattern (parse-apat)))
	      (cons (make as-pat (var var) (pattern pattern))
		    (parse-pat/tail))))
	(else (cons (make var-pat (var var)) (parse-pat/tail))))))
    (_
     (let ((pat (make wildcard-pat)))
       (token-case
	(+k (cons pat (parse-+k-pat)))
	(else (cons pat (parse-pat/tail))))))
    ((no-advance satisfies at-tuple-con?)
     (let ((pcon (parse-tuple-pcon)))
       (setf (pcon-pats pcon) (parse-apat-list))
       (cons pcon (parse-pat/tail))))
    (else (let ((apat (parse-apat)))
	    (cons apat (parse-pat/tail))))))

;;; con { field = pat, ... } (report 3.17.1); the scanner is at the `{'.

(define (record-pattern-follows?)
  (and (eq? *token* '\{) (feature? 'records)))

(define (parse-record-pat pcon)
  (advance-token)
  (make record-pat
	(con pcon)
	(fields (parse-field-bindings
		 (function parse-pat) "`='" "record pattern"
		 (lambda (name)
		   (make var-pat (var (make var-ref (name name) (infix? '#f)
					    (var *undefined-def*)))))))))

;;; (,), (,,), ... as constructors (H98).  The scanner is at the `('.

(define (parse-tuple-pcon)
  (advance-token)
  (advance-token)
  (**pcon/def (tuple-constructor (parse-tuple-con-commas 2)) '()))


(define (parse-+k-pat)
  (advance-token)  ; past +
  (token-case
   (k (let ((val (literal->ast)))
	(cons (make pp-pat-plus)
	      (cons (make const-pat (value val))
		    (parse-pat/tail)))))
   (else (signal-missing-token "<integer>" "successor pattern"))))

(define (parse-pat/tail)
   (token-case
     (conop
      (let ((con (pconop->ast)))
	(cons con (parse-pat/list))))
     (else '())))

(define (parse-apat)
 (if (at-bang?)
     (begin (advance-token)
	    (make bang-pat (pattern (parse-apat))))
     (parse-apat-1)))

;;; A bang pattern's ! (lexer.mumble's bang-shaped?).

(define (at-bang?)
  (and (eq? *token* 'varsym)
       (pair? (cdr *token-args*))
       (eq? (cadr *token-args*) 'prefix)))

(define (parse-apat-1)
 (trace-parser apat
   (token-case
     (var (let ((var (var->ast)))
	    (token-case
	     (@
	      (let ((pattern (parse-apat)))
		(make as-pat (var var) (pattern pattern))))
	     (else (make var-pat (var var))))))
     (con (let ((pcon (pcon->ast)))
	    (if (record-pattern-follows?)
		(parse-record-pat pcon)
		pcon)))
     (literal (let ((value (literal->ast)))
		(make const-pat (value value))))
     (_ (make wildcard-pat))
     (\( (token-case
           (\) (**pcon/def (core-symbol "UnitConstructor") '()))
	   (\, (**pcon/def (tuple-constructor (parse-tuple-con-commas 2)) '()))
	   (else
	    (let ((pat (if (view-pattern-follows?)
			   (parse-view-pattern)
			   (parse-pat))))
	      (token-case
		(\, (**pcon/tuple (cons pat (parse-pat-list '\)))))
		(\) pat)
		;; (pat :: type), outside Haskell 1.2
		((no-advance satisfies pattern-signature-follows?)
		 (advance-token)
		 (let ((signature (parse-signature)))
		   (require-token \)
		     (signal-missing-token "`)'" "pattern type signature"))
		   (make sig-pat (pattern pat) (signature signature))))
		(else
		 (signal-missing-token "`)' or `,'" "pattern")))))))
     (\[ (token-case
	  (\] (make list-pat (pats '())))
	  (else (make list-pat (pats (parse-pat-list '\]))))))
     (\~ (let ((pattern (parse-apat)))
	   (make irr-pat (pattern pattern))))
     (else
      (signal-invalid-syntax "an apat")))))

(define (pattern-signature-follows?)
  (and (eq? *token* '\:\:) (haskell98?)))

(define (parse-pat-list term)  ;; , separated
  (let ((pat (parse-pat)))
    (token-case
     (\, (cons pat (parse-pat-list term)))
     ((unquote term) (list pat))
     (else
      (signal-missing-token
        (if (eq? term '\)) "`)'" "`]'")
	"pattern")))))

(define (parse-apat-list)  ;; space separated
  (if (at-bang?)
      (let ((pat (parse-apat)))
	(cons pat (parse-apat-list)))
      (parse-apat-list-1)))

(define (parse-apat-list-1)
  (token-case
    (apat-start
     (let ((pat (parse-apat)))
       (cons pat (parse-apat-list))))
    (else
     '())))

;;; The following routine scans patterns without creating ast structure.
;;; They return #t or #f depending on whether a valid pattern was encountered.
;;; The leave the scanner pointing to the next token after the pattern.

(define (scan-pat)  ; same as parse-pat/list
  (and
   (token-case
    (con (and (scan-con) (scan-record-braces))
	 (scan-apat-list))
    (-n (advance-token)
	(token-case
	 (numeric (advance-token)
		  '#t)
	 (else '#f)))
    (var (and (scan-var)
	      (token-case
	       (@ (scan-apat))
	       (+k (scan-+k))
	       (else '#t))))
    (_ (scan-+k))
    ((no-advance satisfies at-tuple-con?)
     (advance-token)
     (advance-token)
     (and (scan-tuple-con-commas)
	  (scan-apat-list)))
    (else (scan-apat)))
   (scan-pat/tail)))

(define (scan-pat/tail)
  (token-case
   (conop (and (scan-conop)
	       (scan-pat)))
   (else '#t)))

(define (scan-apat)
  (if (at-bang?)
      (begin (advance-token) (scan-apat))
      (scan-apat-1)))

(define (scan-apat-1)
  (token-case
   (var (scan-var)
	(token-case
	 (@ (scan-apat))
	 (else '#t)))
   (con (and (scan-con) (scan-record-braces)))
   (literal (advance-token)
	    '#t)
   (_ '#t)
   (\( (token-case
	(\) '#t)
	(\, (scan-tuple-con-commas))
	(else
	 (and (scan-pat)
	      (token-case
	       (\, (scan-pat-list '\)))
	       (\) '#t)
	       (\:\: (scan-to-close-paren 0))
	       (else '#f))))))
   (\[ (token-case
	(\] '#t)
	(else (scan-pat-list '\]))))
   (\~ (scan-apat))
   (else '#f)))

(define (scan-pat-list term)
  (and (scan-pat)
       (token-case
	(\, (scan-pat-list term))
	((unquote term) '#t)
	(else '#f))))

(define (scan-apat-list)
  (if (at-bang?)
      (and (scan-apat) (scan-apat-list))
      (scan-apat-list-1)))

(define (scan-apat-list-1)
  (token-case
   (apat-start
    (and (scan-apat)
	 (scan-apat-list)))
   (else '#t)))

(define (scan-var)
  (token-case
   (varid '#t)
   (\( (token-case
	(varsym
	 (token-case
	  (\) '#t)
	  (else '#f)))
	(else '#f)))
   (else '#f)))

(define (scan-con)
  (token-case
   (conid '#t)
   (\( (token-case
	(consym
	 (token-case
	  (\) '#t)
	  (else '#f)))
	(else '#f)))
   (else '#f)))

(define (scan-conop)
  (token-case
   (consym '#t)
   (\` (token-case
	(conid
	 (token-case
	  (\` '#t)
	  (else '#f)))
	(else '#f)))
   (else '#f)))

(define (scan-+k)
  (token-case
   (+k (advance-token)  ; past the +
       (token-case
	(integer '#t)
	(else '#f)))
   (else '#t)))


(define (scan-tuple-con-commas)  ; just past the first comma of (,,...)
  (token-case
   (\, (scan-tuple-con-commas))
   (\) '#t)
   (else '#f)))

;;; Skips a pattern signature's type: the tokens up to and including the
;;; `)' that closes the pattern.
;;; A record pattern's fields, C {...}, if present.
(define (scan-record-braces)
  (if (and (eq-token? '\{) (feature? 'records))
      (begin (advance-token) (scan-to-close-brace 0))
      '#t))

(define (scan-to-close-brace depth)
  (token-case
   (\{ (scan-to-close-brace (1+ depth)))
   (\} (if (eqv? depth 0) '#t (scan-to-close-brace (1- depth))))
   (eof '#f)
   (else (advance-token) (scan-to-close-brace depth))))

(define (scan-to-close-paren depth)
  (token-case
   (\( (scan-to-close-paren (1+ depth)))
   (\) (if (eqv? depth 0) '#t (scan-to-close-paren (1- depth))))
   (eof '#f)
   (else (advance-token) (scan-to-close-paren depth))))

;;; ViewPatterns (GHC): (e -> pat).  The pattern becomes a new variable
;;; v, and (pat, e) is recorded on *view-patterns*; the clause, case
;;; alternative or lambda it is in matches it as a pattern guard,
;;; pat <- e v (decl-parser.mumble's add-view-pattern-guards).

(define *view-patterns* (quote ()))   ; (var-name exp pat), newest first

(define (view-pattern-follows?)
  (and (language-extension? "ViewPatterns")
       (let* ((saved (save-scanner-state))
	      (res (scan-for-view-arrow 0)))
	 (restore-excursion saved)
	 res)))

(define (scan-for-view-arrow depth)
  (token-case
   (-> (eqv? depth 0))
   ((\( \[) (scan-for-view-arrow (1+ depth)))
   ((\) \]) (and (> depth 0) (scan-for-view-arrow (1- depth))))
   (\, (and (> depth 0) (scan-for-view-arrow depth)))
   ((= \| \; \} |where| <- eof) '#f)
   (else (advance-token) (scan-for-view-arrow depth))))

(define *view-pattern-count* 0)

(define (parse-view-pattern)
  (let ((exp (parse-exp)))
    (require-token -> (signal-missing-token "`->'" "view pattern"))
    (let ((pat (parse-pat))
	  (name (string->symbol
		 (format '#f "view%~A" (incf *view-pattern-count*)))))
      (push (list name exp pat) *view-patterns*)
      (make var-pat (var (generated-var-ref name))))))

;;; Takes the view patterns recorded since the last call (oldest first).

(define (take-view-patterns)
  (let ((v  (reverse *view-patterns*)))
    (setf *view-patterns* '())
    v))

;;; The guards of RHS-LIST, given VIEWS: each guard g becomes the pattern
;;; guard  p1 <- e1 v1, ..., pn <- en vn, g.

(define (add-view-pattern-guards views rhs-list)
  (cond ((null? views)
	 rhs-list)
	((null? (cdr rhs-list))
	 (list (view-guarded-rhs views (car rhs-list))))
	(else
	 ;; several guards: one guard binds the views, then a case over
	 ;; the guards yields [e] or [], so that when every guard fails
	 ;; the clause still falls through (the views' patterns cannot be
	 ;; shared by several guards)
	 (let* ((r       (string->symbol
			  (format '#f "view%~A" (incf *view-pattern-count*))))
		(guards  (map (lambda (grhs)
				(make guarded-rhs
				      (guard (guarded-rhs-guard grhs))
				      (rhs (make list-exp
						 (exps (list (guarded-rhs-rhs grhs)))))))
			      rhs-list))
		(alts    (list (**alt (make wildcard-pat) guards '())
			       (**alt/simple (make wildcard-pat)
					     (make list-exp (exps '())))))
		(choice  (**case (generated-var-ref (car (car views))) alts))
		(bind    (make qual-generator
			       (pat (make list-pat
					  (pats (list (make var-pat
							    (var (generated-var-ref r)))))))
			       (exp choice))))
	   (list (make guarded-rhs
		       (guard (make pattern-guard
				    (quals (append (view-quals views) (list bind)))))
		       (rhs (generated-var-ref r))))))))

(define (view-quals views)
  (map (lambda (v)
	 (make qual-generator
	       (pat (caddr v))
	       (exp (make app (fn (cadr v))
			  (arg (generated-var-ref (car v)))))))
       views))

(define (view-guarded-rhs views grhs)
  (let ((g  (guarded-rhs-guard grhs)))
    (make guarded-rhs
	  (guard (make pattern-guard
		       (quals (append (view-quals views)
				      (cond ((is-type? 'omitted-guard g) '())
					    ((is-type? 'pattern-guard g)
					     (pattern-guard-quals g))
					    (else (list (make qual-filter (exp g)))))))))
	  (rhs (guarded-rhs-rhs grhs)))))

;;; PatternSynonyms (GHC), within a module:
;;;   pattern P x y = pat        (bidirectional)
;;;   pattern P x y <- pat [where P x y = e]
;;;   pattern P, Q :: type       (the builders' signature)
;;; A use P p1 ... pn in a pattern is pat with x, y, ... replaced by the
;;; patterns (prec/prec-parse.mumble's massage-pattern); in an expression
;;; P is the function pattern%P (prec/scope.mumble), defined from pat (as
;;; an expression) or from the where clause (a one-way synonym without one
;;; gets a builder that loops, so every synonym has a builder to export).
;;; Across modules, a synonym travels as a template attached to its
;;; builder's def (register-pattern-synonym below).

(define *pattern-synonyms* '())     ; (name params pat)
(define *pattern-builders* '())     ; decls of the pattern%P functions

(define (at-pattern-synonym?)
  (and (at-varid-named? "pattern")
       (or (memq (peek-1-type) '(conid \())
	   ;; pattern x :> xs = ... (an infix operator synonym)
	   (and (eq? (peek-1-type) 'varid) (eq? (peek-2-type) 'consym)))
       (language-extension? "PatternSynonyms")))

(define (parse-pattern-synonym)
  (advance-token)
  (if (or (memq (peek-1-type) '(\:\: \,))
	  ;; pattern (:>) :: ...
	  (and (eq-token? '\() (eq? (peek-1-type) 'consym)
	       (eq? (peek-2-type) '\)) (pattern-signature-after-op?)))
      (parse-pattern-synonym-signature)
      (let* ((infix? (and (eq-token? 'varid) (eq? (peek-1-type) 'consym)))
	     ;; pattern x :> xs = ... (an infix operator synonym)
	     (left (and infix? (token->symbol)))
	     (name (if infix? (token->symbol/con) (con->symbol)))
	     (params (if infix?
			 (list left (token->symbol))
			 (parse-pattern-synonym-params))))
	(token-case
	 (= (let ((pat (parse-pat)))
	      (push (list name params pat) *pattern-synonyms*)
	      (push (pattern-builder name params (pattern->exp pat))
		    *pattern-builders*)))
	 (<- (let ((pat (parse-synonym-pattern name)))
	       (push (list name params pat) *pattern-synonyms*)
	       (let ((builder '#f))
		 (when (eq-token? '|where|)
		   (advance-token)
		   (setf builder (explicit-pattern-builder name (parse-decl-list))))
		 (push (or builder
			   (**define (pattern-builder-name name) '()
				     (**app (**var/def (core-symbol "error"))
					    (**string (format '#f "~A: a one-way pattern synonym used as an expression"
							      (remove-con-prefix-if (symbol->string name)))))))
		       *pattern-builders*))))
	 (else (signal-missing-token "`=' or `<-'" "pattern synonym"))))))

;;; pattern P, Q :: t gives the builders pattern%P and pattern%Q type t,
;;; so that a builder is not defaulted (pattern Two :: Int; pattern Two =
;;; 2).  A signature with required and provided contexts (CReq => CProv
;;; => t) is not parsed by parse-signature; it is skipped.

;;; After pattern ( op ): whether :: or , follows the ), a signature.
(define (pattern-signature-after-op?)
  (let ((saved (save-scanner-state)))
    (advance-token) (advance-token) (advance-token)
    (let ((res (memq *token* '(\:\: \,))))
      (restore-excursion saved)
      res)))

(define (parse-pattern-synonym-signature)
  (let ((names (parse-pattern-synonym-names)))
    (require-token \:\: (signal-missing-token "`::'" "pattern synonym signature"))
    (let ((signature (parse-signature)))
      (if (eq? *token* '=>)
	  (skip-to-decl-end)
	  (push (make signdecl
		      (vars (map (lambda (n) (generated-var-ref (pattern-builder-name n)))
				 names))
		      (signature signature))
		*pattern-builders*)))))

(define (parse-pattern-synonym-names)
  (let ((name (con->symbol)))
    (token-case
     (\, (cons name (parse-pattern-synonym-names)))
     (else (list name)))))

;;; A one-way synonym's pattern.  Its view patterns (f -> p) become
;;; view-pats, each f a top-level function view%P%k x = f x, so that the
;;; pattern can be copied to its uses, and into other modules as a
;;; template.

(define (parse-synonym-pattern name)
  (let ((outer  *view-patterns*))
    (setf *view-patterns* '())
    (let* ((pat    (parse-pat))
	   (views  (take-view-patterns))   ; inner views first
	   (count  0)
	   (env    '()))
      (setf *view-patterns* outer)
      (dolist (v views)
	(incf count)
	(let ((fname (string->symbol
		      (format '#f "view%~A%~A"
			      (remove-con-prefix-if (symbol->string name)) count))))
	  ;; eta-expanded: a function binding is not defaulted (the
	  ;; monomorphism restriction)
	  (push (**define fname '(|view%x|) (**app (cadr v) (generated-var-ref '|view%x|)))
		*pattern-builders*)
	  ;; a view's pattern may hold an inner view's variable
	  (push (tuple (car v)
		       (make view-pat (fn (generated-var-ref fname))
			     (pattern (copy-pattern (caddr v) env))))
		env)))
      (if (null? env) pat (copy-pattern pat env)))))

(define (remove-con-prefix-if s)
  (if (has-con-prefix? s) (remove-con-prefix s) s))

(define (parse-pattern-synonym-params)
  (if (eq-token? 'varid)
      (let ((v (token->symbol)))
	(cons v (parse-pattern-synonym-params)))
      '()))

(define (pattern-builder-name name)
  (let ((s (symbol->string name)))
    (string->symbol (string-append "pattern%"
				   (if (has-con-prefix? s) (remove-con-prefix s) s)))))

;;; pattern%P x y = e
(define (pattern-builder name params exp)
  (**define (pattern-builder-name name) params exp))

;;; where P p1 ... pn = e; ...: the builder pattern%P with those clauses,
;;; or #f when a declaration is not a clause of P.

(define (explicit-pattern-builder name decls)
  (let ((defs (map (lambda (d) (explicit-builder-clause name d)) decls)))
    (and (pair? defs)
	 (every (lambda (d) d) defs)
	 (make valdef
	       (lhs (make var-pat (var (generated-var-ref (pattern-builder-name name)))))
	       (definitions (concat defs))))))

;;; A where-declaration P p1 ... pn = e as its single-fun-defs over p1 ... pn.
(define (explicit-builder-clause name decl)
  (and (is-type? 'valdef decl)
       (let ((lhs  (valdef-lhs decl)))
	 (map (lambda (def)
		(make single-fun-def
		      (args (cond ((is-type? 'pcon lhs) (pcon-pats lhs))
				  ;; x :<| xs = ... (an infix operator synonym)
				  ((and (is-type? 'pp-pat-list lhs)
					(eqv? (length (pp-pat-list-pats lhs)) 3)
					(is-type? 'pcon (cadr (pp-pat-list-pats lhs)))
					(eq? (pcon-name (cadr (pp-pat-list-pats lhs))) name))
				   (list (car (pp-pat-list-pats lhs))
					 (caddr (pp-pat-list-pats lhs))))
				  ((is-type? 'pp-pat-list lhs) (cdr (pp-pat-list-pats lhs)))
				  (else (single-fun-def-args def))))
		      (rhs-list (single-fun-def-rhs-list def))
		      (where-decls (single-fun-def-where-decls def))
		      (infix? '#f)))
	      (valdef-definitions decl)))))

;;; A pattern as the expression that builds the value it matches.
(define (pattern->exp p)
  (cond ((is-type? 'var-pat p) (generated-var-ref (var-ref-name (var-pat-var p))))
	((is-type? 'const-pat p) (copy-const (const-pat-value p)))
	((is-type? 'pcon p)
	 (**app/l (make con-ref (name (pcon-name p)) (con (pcon-con p))
			(infix? (pcon-infix? p)))
		  (map (function pattern->exp) (pcon-pats p))))
	((is-type? 'list-pat p)
	 (make list-exp (exps (map (function pattern->exp) (list-pat-pats p)))))
	((is-type? 'pp-pat-list p)
	 (make pp-exp-list (exps (map (function pattern->exp) (pp-pat-list-pats p)))))
	((is-type? 'bang-pat p) (pattern->exp (bang-pat-pattern p)))
	((is-type? 'sig-pat p) (pattern->exp (sig-pat-pattern p)))
	(else (parser-error 'pattern-synonym-not-invertible
		"A pattern synonym with = needs a pattern that is also an expression; use <- and where."))))

;;; A literal for another place: the type checker annotates literal
;;; nodes, so the builder and each use of a synonym need their own.
(define (copy-const c)
  (cond ((is-type? 'integer-const c) (make integer-const (value (integer-const-value c))))
	((is-type? 'char-const c) (make char-const (value (char-const-value c))))
	((is-type? 'string-const c) (make string-const (value (string-const-value c))))
	((is-type? 'float-const c)
	 (make float-const (numerator (float-const-numerator c))
	       (denominator (float-const-denominator c))
	       (exponent (float-const-exponent c))))
	(else c)))

;;; The pattern of a use: a copy of the synonym's, its parameters replaced.
(define (instantiate-pattern-synonym syn args)
  (copy-pattern (caddr syn)
		(map (lambda (v a) (tuple v a)) (cadr syn) args)))

(define (copy-pattern p env)
  (cond ((is-type? 'var-pat p)
	 (let ((b (assq (var-ref-name (var-pat-var p)) env)))
	   (if b
	       (tuple-2-2 b)
	       (make var-pat (var (generated-var-ref (var-ref-name (var-pat-var p))))))))
	((is-type? 'wildcard-pat p) (make wildcard-pat))
	((is-type? 'const-pat p) (make const-pat (value (copy-const (const-pat-value p)))))
	((is-type? 'pcon p)
	 (make pcon (name (pcon-name p)) (con (pcon-con p)) (infix? (pcon-infix? p))
	       (pats (map (lambda (q) (copy-pattern q env)) (pcon-pats p)))))
	((is-type? 'list-pat p)
	 (make list-pat (pats (map (lambda (q) (copy-pattern q env)) (list-pat-pats p)))))
	((is-type? 'pp-pat-list p)
	 (make pp-pat-list (pats (map (lambda (q) (copy-pattern q env)) (pp-pat-list-pats p)))))
	((is-type? 'as-pat p)
	 (make as-pat (var (generated-var-ref (var-ref-name (as-pat-var p))))
	       (pattern (copy-pattern (as-pat-pattern p) env))))
	((is-type? 'irr-pat p) (make irr-pat (pattern (copy-pattern (irr-pat-pattern p) env))))
	((is-type? 'bang-pat p) (make bang-pat (pattern (copy-pattern (bang-pat-pattern p) env))))
	((is-type? 'view-pat p)
	 (make view-pat (fn (copy-var-ref (view-pat-fn p)))
	       (pattern (copy-pattern (view-pat-pattern p) env))))
	(else p)))

(define (copy-var-ref r)
  (make var-ref (name (var-ref-name r)) (var (var-ref-var r)) (infix? '#f)))
;;; Pattern synonyms across modules.  The defining module's scope phase
;;; resolves each synonym's pattern (prec/scope.mumble) and records it as
;;; a template, plain data an interface file can hold:
;;;   (v name) (w) (i n) (ch c) (s str) (c con name infix? pat ...)
;;;   (l pat ...) (a name pat) (r pat) (b pat) (vw fn-def pat)
;;; keyed by the builder's def.  A use in another module finds the
;;; builder by name (pattern%P, or M.pattern%P for M.P) and instantiates
;;; the template, its constructors already resolved.

(define *pattern-synonym-templates* (lisp:make-hash-table :test (function lisp:eq)))

(define (register-pattern-synonym builder template)
  (setf (lisp:gethash builder *pattern-synonym-templates*) template))

(define (pattern-synonym-template builder)
  (lisp:values (lisp:gethash builder *pattern-synonym-templates*)))

;;; (params . template), or #f if the pattern has a form templates lack
(define (make-pattern-synonym-template params pat)
  (lisp:catch 'no-template
    (cons params (pattern->template pat))))

(define (pattern->template p)
  (cond ((is-type? 'var-pat p) `(v ,(var-ref-name (var-pat-var p))))
	((is-type? 'wildcard-pat p) '(w))
	((is-type? 'const-pat p)
	 (let ((c (const-pat-value p)))
	   (cond ((is-type? 'integer-const c) `(i ,(integer-const-value c)))
		 ((is-type? 'char-const c) `(ch ,(char-const-value c)))
		 ((is-type? 'string-const c) `(s ,(string-const-value c)))
		 (else (lisp:throw 'no-template '#f)))))
	((and (is-type? 'pcon p) (not (eq? (pcon-con p) *undefined-def*)))
	 `(c ,(pcon-con p) ,(pcon-name p) ,(pcon-infix? p)
	     ,@(map (function pattern->template) (pcon-pats p))))
	((is-type? 'list-pat p)
	 `(l ,@(map (function pattern->template) (list-pat-pats p))))
	((is-type? 'as-pat p)
	 `(a ,(var-ref-name (as-pat-var p)) ,(pattern->template (as-pat-pattern p))))
	((is-type? 'irr-pat p) `(r ,(pattern->template (irr-pat-pattern p))))
	((is-type? 'bang-pat p) `(b ,(pattern->template (bang-pat-pattern p))))
	((and (is-type? 'view-pat p)
	      (not (eq? (var-ref-var (view-pat-fn p)) *undefined-def*)))
	 `(vw ,(var-ref-var (view-pat-fn p)) ,(pattern->template (view-pat-pattern p))))
	(else (lisp:throw 'no-template '#f))))

;;; The pattern of a use of an imported synonym: ARGS for its parameters.
(define (instantiate-pattern-template template args)
  (template->pattern (cdr template)
		     (map (lambda (v a) (tuple v a)) (car template) args)))

(define (template->pattern tp env)
  (let ((sub (lambda (q) (template->pattern q env))))
    (case (car tp)
      (v (let ((b (assq (cadr tp) env)))
	   (if b
	       (tuple-2-2 b)
	       (make var-pat (var (generated-var-ref (cadr tp)))))))
      (w (make wildcard-pat))
      (i (make const-pat (value (make integer-const (value (cadr tp))))))
      (ch (make const-pat (value (make char-const (value (cadr tp))))))
      (s (make const-pat (value (make string-const (value (cadr tp))))))
      (c (make pcon (con (cadr tp)) (name (caddr tp)) (infix? (cadddr tp))
	       (pats (map sub (cddddr tp)))))
      (l (make list-pat (pats (map sub (cdr tp)))))
      (a (make as-pat (var (generated-var-ref (cadr tp)))
	       (pattern (funcall sub (caddr tp)))))
      (r (make irr-pat (pattern (funcall sub (cadr tp)))))
      (vw (make view-pat (fn (**var/def (cadr tp)))
		(pattern (funcall sub (caddr tp)))))
      (else (make bang-pat (pattern (funcall sub (cadr tp))))))))

;;; The builder's name for a use of P or M.P: pattern%P or M.pattern%P.
(define (qualified-pattern-builder-name name)
  (let* ((s (symbol->string name))
	 (s (if (has-con-prefix? s) (remove-con-prefix s) s))
	 (q (pattern-qualifier-length s 0)))
    (if (eqv? q 0)
	(pattern-builder-name (string->symbol s))
	(string->symbol
	 (string-append (substring s 0 q) "pattern%"
			(substring s q (string-length s)))))))

;;; The length of the M.N. prefix of S, from position I.
(define (pattern-qualifier-length s i)
  (let ((n (string-length s)))
    (if (and (< i n) (char-upper-case? (string-ref s i)))
	(let ((j (lisp:position #\. s :start i)))
	  (if (and j (< (+ j 1) n)
		   (lisp:every (lambda (c) (or (char-alphabetic? c) (char-numeric? c)
					       (memv c '(#\_ #\'))))
			       (substring s i j)))
	      (pattern-qualifier-length s (+ j 1))
	      i))
	i)))

;;; An imported synonym's template for a constructor name, or #f.
(define (imported-pattern-synonym name)
  (and (eq? (resolve-toplevel-name name) '#f)
       (let ((def (resolve-toplevel-name (qualified-pattern-builder-name name))))
	 (and (not (eq? def '#f))
	      (pattern-synonym-template def)))))
