;;;  File: pattern-parser        Author: John

;;; This parses the pattern syntax except for the parts which need to be
;;; resolved by precedence parsing.

;;; This parses a list of alternating pats & conops.

(define (parse-pat)
 (trace-parser pat
   (let ((res (parse-pat/list)))
     (if (null? (cdr res))
	 (car res)
	 (make pp-pat-list (pats res))))))

;;; This parses a list of patterns with intervening conops and + patterns

(define (parse-pat/list)
  (token-case
    (con (let ((pcon (pcon->ast)))
	   (if (record-pattern-follows?)
	       (cons (parse-record-pat pcon) (parse-pat/tail))
	       (begin
		 (setf (pcon-pats pcon) (parse-apat-list))
		 (cons pcon (parse-pat/tail))))))
    (-n
     (advance-token) ; past -
     (token-case
      (numeric (let ((val (literal->ast)))
		 (cons (make pp-pat-negated)
		       (cons (make const-pat (value val))
			     (parse-pat/tail)))))
      (else
       (signal-missing-token "<number>" "negative literal pattern"))))
    (var
     (let ((var (var->ast)))
       (token-case
	(+k (cons (make var-pat (var var))
		  (parse-+k-pat)))
	(@  (let ((pattern (parse-apat)))
	      (cons (make as-pat (var var) (pattern pattern))
		    (parse-pat/tail))))
	(else (cons (make var-pat (var var)) (parse-pat/tail))))))
    (_
     (let ((pat (make wildcard-pat)))
       (token-case
	(+k (cons pat (parse-+k-pat)))
	(else (cons pat (parse-pat/tail))))))
    ((no-advance satisfies at-tuple-con?)
     (let ((pcon (parse-tuple-pcon)))
       (setf (pcon-pats pcon) (parse-apat-list))
       (cons pcon (parse-pat/tail))))
    (else (let ((apat (parse-apat)))
	    (cons apat (parse-pat/tail))))))

;;; con { field = pat, ... } (report 3.17.1); the scanner is at the `{'.

(define (record-pattern-follows?)
  (and (eq? *token* '\{) (feature? 'records)))

(define (parse-record-pat pcon)
  (advance-token)
  (make record-pat
	(con pcon)
	(fields (parse-field-bindings
		 (function parse-pat) "`='" "record pattern"
		 (lambda (name)
		   (make var-pat (var (make var-ref (name name) (infix? '#f)
					    (var *undefined-def*)))))))))

;;; (,), (,,), ... as constructors (H98).  The scanner is at the `('.

(define (parse-tuple-pcon)
  (advance-token)
  (advance-token)
  (**pcon/def (tuple-constructor (parse-tuple-con-commas 2)) '()))


(define (parse-+k-pat)
  (advance-token)  ; past +
  (token-case
   (k (let ((val (literal->ast)))
	(cons (make pp-pat-plus)
	      (cons (make const-pat (value val))
		    (parse-pat/tail)))))
   (else (signal-missing-token "<integer>" "successor pattern"))))

(define (parse-pat/tail)
   (token-case
     (conop
      (let ((con (pconop->ast)))
	(cons con (parse-pat/list))))
     (else '())))

(define (parse-apat)
 (if (at-bang?)
     (begin (advance-token)
	    (make bang-pat (pattern (parse-apat))))
     (parse-apat-1)))

;;; A bang pattern's ! (lexer.mumble's bang-shaped?).

(define (at-bang?)
  (and (eq? *token* 'varsym)
       (pair? (cdr *token-args*))
       (eq? (cadr *token-args*) 'prefix)))

(define (parse-apat-1)
 (trace-parser apat
   (token-case
     (var (let ((var (var->ast)))
	    (token-case
	     (@
	      (let ((pattern (parse-apat)))
		(make as-pat (var var) (pattern pattern))))
	     (else (make var-pat (var var))))))
     (con (let ((pcon (pcon->ast)))
	    (if (record-pattern-follows?)
		(parse-record-pat pcon)
		pcon)))
     (literal (let ((value (literal->ast)))
		(make const-pat (value value))))
     (_ (make wildcard-pat))
     (\( (token-case
           (\) (**pcon/def (core-symbol "UnitConstructor") '()))
	   (\, (**pcon/def (tuple-constructor (parse-tuple-con-commas 2)) '()))
	   (else
	    (let ((pat (parse-pat)))
	      (token-case
		(\, (**pcon/tuple (cons pat (parse-pat-list '\)))))
		(\) pat)
		;; (pat :: type), outside Haskell 1.2
		((no-advance satisfies pattern-signature-follows?)
		 (advance-token)
		 (let ((signature (parse-signature)))
		   (require-token \)
		     (signal-missing-token "`)'" "pattern type signature"))
		   (make sig-pat (pattern pat) (signature signature))))
		(else
		 (signal-missing-token "`)' or `,'" "pattern")))))))
     (\[ (token-case
	  (\] (make list-pat (pats '())))
	  (else (make list-pat (pats (parse-pat-list '\]))))))
     (\~ (let ((pattern (parse-apat)))
	   (make irr-pat (pattern pattern))))
     (else
      (signal-invalid-syntax "an apat")))))

(define (pattern-signature-follows?)
  (and (eq? *token* '\:\:) (haskell98?)))

(define (parse-pat-list term)  ;; , separated
  (let ((pat (parse-pat)))
    (token-case
     (\, (cons pat (parse-pat-list term)))
     ((unquote term) (list pat))
     (else
      (signal-missing-token
        (if (eq? term '\)) "`)'" "`]'")
	"pattern")))))

(define (parse-apat-list)  ;; space separated
  (if (at-bang?)
      (let ((pat (parse-apat)))
	(cons pat (parse-apat-list)))
      (parse-apat-list-1)))

(define (parse-apat-list-1)
  (token-case
    (apat-start
     (let ((pat (parse-apat)))
       (cons pat (parse-apat-list))))
    (else
     '())))

;;; The following routine scans patterns without creating ast structure.
;;; They return #t or #f depending on whether a valid pattern was encountered.
;;; The leave the scanner pointing to the next token after the pattern.

(define (scan-pat)  ; same as parse-pat/list
  (and
   (token-case
    (con (scan-con)
	 (scan-apat-list))
    (-n (advance-token)
	(token-case
	 (numeric (advance-token)
		  '#t)
	 (else '#f)))
    (var (and (scan-var)
	      (token-case
	       (@ (scan-apat))
	       (+k (scan-+k))
	       (else '#t))))
    (_ (scan-+k))
    ((no-advance satisfies at-tuple-con?)
     (advance-token)
     (advance-token)
     (and (scan-tuple-con-commas)
	  (scan-apat-list)))
    (else (scan-apat)))
   (scan-pat/tail)))

(define (scan-pat/tail)
  (token-case
   (conop (and (scan-conop)
	       (scan-pat)))
   (else '#t)))

(define (scan-apat)
  (if (at-bang?)
      (begin (advance-token) (scan-apat))
      (scan-apat-1)))

(define (scan-apat-1)
  (token-case
   (var (scan-var)
	(token-case
	 (@ (scan-apat))
	 (else '#t)))
   (con (scan-con))
   (literal (advance-token)
	    '#t)
   (_ '#t)
   (\( (token-case
	(\) '#t)
	(\, (scan-tuple-con-commas))
	(else
	 (and (scan-pat)
	      (token-case
	       (\, (scan-pat-list '\)))
	       (\) '#t)
	       (\:\: (scan-to-close-paren 0))
	       (else '#f))))))
   (\[ (token-case
	(\] '#t)
	(else (scan-pat-list '\]))))
   (\~ (scan-apat))
   (else '#f)))

(define (scan-pat-list term)
  (and (scan-pat)
       (token-case
	(\, (scan-pat-list term))
	((unquote term) '#t)
	(else '#f))))

(define (scan-apat-list)
  (if (at-bang?)
      (and (scan-apat) (scan-apat-list))
      (scan-apat-list-1)))

(define (scan-apat-list-1)
  (token-case
   (apat-start
    (and (scan-apat)
	 (scan-apat-list)))
   (else '#t)))

(define (scan-var)
  (token-case
   (varid '#t)
   (\( (token-case
	(varsym
	 (token-case
	  (\) '#t)
	  (else '#f)))
	(else '#f)))
   (else '#f)))

(define (scan-con)
  (token-case
   (conid '#t)
   (\( (token-case
	(consym
	 (token-case
	  (\) '#t)
	  (else '#f)))
	(else '#f)))
   (else '#f)))

(define (scan-conop)
  (token-case
   (consym '#t)
   (\` (token-case
	(conid
	 (token-case
	  (\` '#t)
	  (else '#f)))
	(else '#f)))
   (else '#f)))

(define (scan-+k)
  (token-case
   (+k (advance-token)  ; past the +
       (token-case
	(integer '#t)
	(else '#f)))
   (else '#t)))


(define (scan-tuple-con-commas)  ; just past the first comma of (,,...)
  (token-case
   (\, (scan-tuple-con-commas))
   (\) '#t)
   (else '#f)))

;;; Skips a pattern signature's type: the tokens up to and including the
;;; `)' that closes the pattern.
(define (scan-to-close-paren depth)
  (token-case
   (\( (scan-to-close-paren (1+ depth)))
   (\) (if (eqv? depth 0) '#t (scan-to-close-paren (1- depth))))
   (eof '#f)
   (else (advance-token) (scan-to-close-paren depth))))
