;;; File: parser/typedecl-parser     Author: John

(define (parse-type-decl interface?)
 (save-parser-context
  (let* ((sig (parse-signature))
	 (contexts (signature-context sig))
	 (simple (signature-type sig))
	 (deriving '())
	 (constrs '()))
    ;; #t = builtins ([] (,,) ->) not allowed
    (check-simple simple '#t "type declaration")
    ;; KindSignatures (GHC): data T (a :: k) :: Type -> Type: the kind's
    ;; arrows are more parameters
    (when (and (haskell98?) (eq-token? '\:\:))
      (advance-token)
      (let ((n (parse-kind-arrows)))
	(dotimes (i n)
	  (setf (tycon-args simple)
		(append (tycon-args simple)
			(list (make tyvar (name (string->symbol
						 (format '#f "k%~A" (1+ i)))))))))))
    (let ((annotations (parse-constr-annotations)))
     (setf *special-derivings* '())
     (setf *mp-derivings* '())
     (token-case
      (= (setf constrs (parse-constrs))
	 (setf deriving (parse-optional-deriving)))
      ;; GADTSyntax (GHC): data T a where C :: t -> T a
      ((no-advance satisfies at-gadt-where?)
       (advance-token)
       (setf constrs (start-layout
		      (lambda (in-layout?) (parse-gadt-constrs simple in-layout?))))
       (setf deriving (parse-optional-deriving)))
      (else
       ;; data T with no constructors is Haskell 2010 (report 4.2.1);
       ;; EmptyDataDeriving (GHC): data T deriving (Show)
       (when (not (or interface? (haskell98?)))
	 (signal-missing-constructors))
       (setf deriving (parse-optional-deriving))))
    (make data-decl (context contexts) (simple simple)
		    (constrs constrs) (deriving deriving)
		    (special-derivings (reverse *special-derivings*))
		    (annotations annotations))))))

;;; deriving clauses, any number (DerivingStrategies, GHC):
;;;   deriving (C1, C2)  deriving C  deriving stock (...)
;;;   deriving newtype (...)  deriving anyclass (...)  deriving (...) via T
;;; Returns the classes derived the usual way (stock, or through the
;;; newtype for a class that has no stock deriving); the others go on
;;; *special-derivings* as (tuple class strategy), strategy anyclass,
;;; newtype, or the via type.

(define *special-derivings* '())

;;; The type families of constraints declared (by name).
(define *constraint-families* '())

;;; InstanceSigs with a forall: (tuple instance-class-ref (tuple method
;;; signature)), tdecl/instance.mumble's instance-method-renaming
(define *instance-method-sigs* '())

(define (parse-optional-deriving)
  (token-case
   (|deriving|
    (let* ((strategy (parse-deriving-strategy))
	   (classes (token-case
		     (\(
		      (token-case
		       (\) '())
		       (else (parse-class-list))))
		     (tycon (list (class->ast)))
		     (else (signal-invalid-syntax "a deriving clause"))))
	   (strategy (if (at-varid-named? "via")
			 (begin (advance-token) (parse-atype))
			 strategy))
	   (rest (parse-optional-deriving)))
      (if (or (eq? strategy 'stock) (eq? strategy '#f))
	  (append classes rest)
	  (begin
	    (dolist (c classes)
	      (push (tuple c strategy) *special-derivings*))
	    rest))))
   (else '())))

(define (parse-deriving-strategy)
  (cond ((at-varid-named? "stock") (advance-token) 'stock)
	((at-varid-named? "anyclass") (advance-token) 'anyclass)
	((eq-token? '|newtype|) (advance-token) 'newtype)
	(else '#f)))

(define (at-gadt-where?)
  (and (haskell98?) (eq-token? '|where|)))

;;; The constructors of data T a1 ... an where, in GADT syntax:
;;;   C1, C2 :: [forall ...] [ctx =>] t1 -> ... -> T b1 ... bn
;;; When the result is T applied to distinct type variables and there is
;;; no context, an ordinary constructor: its variables are renamed to
;;; a1 ... an.  Otherwise a GADT constructor (type/gadts.mumble): every
;;; type variable is existential, the context is an existential one, and
;;; the declared result is kept.  A field may be strict (!t).

(define (parse-gadt-constrs simple in-layout?)
  (token-case
   (\; (parse-gadt-constrs simple in-layout?))
   (con
    (let* ((cons (parse-gadt-con-names))
	   (_ (require-token \:\: (signal-missing-token "`::'" "GADT constructor")))
	   (_ (skip-explicit-forall))
	   (context (mlet (((single _) (split-contexts (parse-optional-context))))
		      single))
	   (args+res (parse-gadt-con-type))
	   (constrs (map (lambda (con)
			   (make-gadt-constr con simple context
					     (car args+res) (cdr args+res)))
			 cons)))
      (token-case
       (\; (append constrs (parse-gadt-constrs simple in-layout?)))
       (else (close-layout in-layout?)
	     constrs))))
   (else (close-layout in-layout?)
	 '())))

(define (parse-gadt-con-names)
  (let ((con (con->ast)))
    (token-case
     (\, (cons con (token-case
		    (con (parse-gadt-con-names))
		    (else (signal-missing-token "<con>" "GADT constructors")))))
     (else (list con)))))

;;; Returns ((tuple type annotations) ...) for the fields, and the result.

(define (parse-gadt-con-type)
  (let ((t+a (if (at-strictness-flag?)
		 (parse-strict-atype)
		 ;; (a type operator's application: Refl :: a :~: a)
		 (tuple (parse-type-operators (parse-btype)) '()))))
    (token-case
     (-> (let ((rest (parse-gadt-con-type)))
	   (cons (cons t+a (car rest)) (cdr rest))))
     (else
      (when (not (null? (tuple-2-2 t+a)))
	(signal-invalid-syntax "a GADT constructor's result type"))
      (cons '() (tuple-2-1 t+a))))))

(define (make-gadt-constr con simple context fields result)
  (when (not (and (tycon? result)
		  (eq? (tycon-name result) (tycon-name simple))
		  (eqv? (length (tycon-args result)) (length (tycon-args simple)))))
    (parser-error 'gadt-result
      "A GADT constructor's result must be ~A applied to ~A types."
      (tycon-name simple) (length (tycon-args simple))))
  (if (and (null? context)
	   (every (function tyvar?) (tycon-args result))
	   (null? (find-duplicates (map (function tyvar-name)
					(tycon-args result))))
	   ;; no existential variables in the fields
	   (every (lambda (v) (memq v (map (function tyvar-name)
					    (tycon-args result))))
		  (lisp:mapcan (lambda (f) (ast-tyvar-names (tuple-2-1 f)))
			       fields)))
      (make constr (constructor con)
	    (types (gadt-rename-fields simple fields result)))
      (make constr (constructor con) (types fields)
	    (exist-tyvars (lisp:remove-duplicates
			   (lisp:mapcan (lambda (ty) (ast-tyvar-names ty))
					(cons result (map (function tuple-2-1) fields)))))
	    (exist-context context)
	    (gadt-result result))))

(define (ast-tyvar-names type)
  (cond ((tyvar? type) (list (tyvar-name type)))
	((tycon? type) (lisp:mapcan (function ast-tyvar-names) (tycon-args type)))
	((tyapp? type)
	 (append (ast-tyvar-names (tyapp-fun type))
		 (lisp:mapcan (function ast-tyvar-names) (tyapp-args type))))
	(else '())))

(define (gadt-rename-fields simple fields result)
  (let ((renaming (map (lambda (r s) (tuple (tyvar-name r) (tyvar-name s)))
		       (tycon-args result) (tycon-args simple))))
    (map (lambda (f) (tuple (rename-type-tyvars (tuple-2-1 f) renaming)
			    (tuple-2-2 f)))
	 fields)))

(define (rename-type-tyvars type renaming)
  (cond ((tyvar? type)
	 (let ((r (assq (tyvar-name type) renaming)))
	   (if r (make tyvar (name (tuple-2-2 r))) type)))
	((tycon? type)
	 (make tycon (name (tycon-name type)) (def (tycon-def type))
	       (args (map (lambda (a) (rename-type-tyvars a renaming))
			  (tycon-args type)))))
	((tyapp? type)
	 (make tyapp (fun (rename-type-tyvars (tyapp-fun type) renaming))
	       (args (map (lambda (a) (rename-type-tyvars a renaming))
			  (tyapp-args type)))))
	(else type)))

(define (check-newtype-decl decl)
  (let ((constrs (data-decl-constrs decl)))
    (when (not (and (pair? constrs)
		    (null? (cdr constrs))
		    (eqv? (length (constr-types (car constrs))) 1)))
      (parser-error 'bad-newtype
	"A newtype declaration needs exactly one constructor with one field."))))

(define (signal-missing-constructors)
  (parser-error 'missing-constructors
		"Data type definition requires constructors"))

(define (check-simple simple fresh? where)
  (when (not (tycon? simple))
    (signal-not-simple where))
  (when (and fresh? (not (eq? (tycon-def simple) *undefined-def*)))
    (signal-not-simple where))
  (let ((tyvars (map (lambda (arg)
		       (when (not (tyvar? arg))
			     (signal-not-simple where))
		       (tyvar-name arg))
		     (tycon-args simple))))
    (when (not (null? (find-duplicates tyvars)))
      (signal-unique-tyvars-required))))

(define (signal-unique-tyvars-required)
  (parser-error 'unique-tyvars-required
		"Duplicate type variables appear in simple."))

;;; An instance head t a: a type variable applied to another.
(define (var-application-head? ty)
  (and (tyapp? ty) (tyvar? (tyapp-fun ty))
       (eqv? (length (tyapp-args ty)) 1)
       (tyvar? (car (tyapp-args ty)))
       (not (eq? (tyvar-name (tyapp-fun ty)) (tyvar-name (car (tyapp-args ty)))))))

(define (signal-not-simple where)
  (parser-error 'not-simple "Simple type required in ~a." where))

(define (parse-constrs)
  (let ((constr (parse-constr)))
    (token-case
     (\| (cons constr (parse-constrs)))
     (else (list constr)))))

;;; ExistentialQuantification (GHC): forall a. C a => K t ... ; the
;;; context is allowed only after a forall (as in GHC).

(define (parse-constr)
  (let* ((exist (skip-explicit-forall))
	 (context (if (null? exist)
		      '()
		      (mlet (((single _) (split-contexts (parse-optional-context))))
			single)))
	 (constr (parse-constr-1)))
    (setf (constr-exist-tyvars constr) exist)
    (setf (constr-exist-context constr) context)
    constr))

(define (parse-constr-1)
 (save-parser-context
  (let ((saved-excursion (save-scanner-state)))
    (token-case
     (consym/paren
      (parse-prefix-constr))
     ((no-advance satisfies at-strictness-flag?)
      (let ((t+a1 (parse-strict-atype)))
	(token-case
	 ((no-advance conop)
	  (parse-infix-constr t+a1))
	 (else
	  (signal-missing-token "<conop>" "constructor with strict field")))))
     (else
      (let ((type1 (parse-btype))
	    (anns (parse-constr-annotations)))
	(token-case
	 ((no-advance conop)
	  (parse-infix-constr (tuple type1 anns)))
	 (else
	  (restore-excursion saved-excursion)
	  (parse-prefix-constr)))))))))

;;; H98 strictness flags: `!atype' in a constructor means the same as
;;; Yale's `atype {-#STRICT#-}'.  Returns (tuple atype annotations).

(define (at-strictness-flag?)
  (and (eq? *token* 'varsym)
       (string=? (car *token-args*) "!")))

(define (parse-strict-atype)
  (advance-token)  ; past the !
  (let* ((atype (parse-atype))
	 (anns (parse-constr-annotations)))
    (tuple atype (cons (make annotation-value (name '|STRICT|) (args '()))
		       anns))))

(define (parse-prefix-constr)
  (token-case
   (con
    (let ((con (con->ast)))
      (if (and (eq? *token* '\{) (feature? 'records))
	  (begin
	    (advance-token)
	    (parse-record-constr con))
	  (make constr (constructor con) (types (parse-constr-type-list))))))
   (else
    (signal-missing-token "<con>" "constrs list"))))

;;; con { var1, ..., varn :: type, ... }, after the {.  Each label gets
;;; its own entry in types; the labels are parallel to the types.

(define (parse-record-constr con)
  (let ((types '())
	(labels '()))
    (token-case
     (\} '())
     (else
      (do ((more? '#t))
	  ((not more?))
	(let ((vars (parse-field-label-list)))
	  (require-token \:\:
	    (signal-missing-token "`::'" "field declaration"))
	  (let ((t+a (if (at-strictness-flag?)
			 (parse-strict-atype)
			 (let* ((type (parse-type))
				(anns (parse-constr-annotations)))
			   (tuple type anns)))))
	    (dolist (v vars)
	      (push v labels)
	      (push t+a types))))
	(token-case
	 (\, '#t)
	 (\} (setf more? '#f))
	 (else (signal-missing-token "`,' or `}'" "record declaration"))))))
    (make constr (constructor con) (types (reverse types))
	  (field-labels (reverse labels)))))

(define (parse-field-label-list)
  (token-case
   (var (let ((name (var->symbol)))
	  (token-case
	   (\, (cons name (parse-field-label-list)))
	   (else (list name)))))
   (else (signal-missing-token "<var>" "field declaration"))))

(define (parse-constr-type-list)
  (token-case
    ((no-advance satisfies at-strictness-flag?)
     (let ((t+a (parse-strict-atype)))
       (cons t+a (parse-constr-type-list))))
    (atype-start
     (let* ((atype (parse-atype))
	    (anns (parse-constr-annotations)))
       (cons (tuple atype anns)
	     (parse-constr-type-list))))
    (else '())))

(define (parse-infix-constr t+a1)
  (let* ((con (conop->ast))
	 (t+a2 (if (at-strictness-flag?)
		   (parse-strict-atype)
		   (let* ((type2 (parse-btype))
			  (anns (parse-constr-annotations)))
		     (tuple type2 anns)))))
    (make constr (constructor con) (types (list t+a1 t+a2)))))

(define (parse-class-list)
  (token-case
   (tycon (let* ((class (class->ast))
		 ;; a multi-parameter class, its other arguments first:
		 ;; deriving (MonadState S) (*mp-derivings*)
		 (args (if (haskell98?) (parse-atype-list) '()))
		 (classes (if (null? args) (list class) '())))
	    (when (not (null? args))
	      (push (tuple class args) *mp-derivings*))
	    (token-case
	     (\, (append classes (parse-class-list)))
	     (\) classes)
	     (else (signal-missing-token "`)' or `,'" "deriving clause")))))
   (else (signal-missing-token "<tycon>" "deriving clause"))))

;;; A newtype's derived multi-parameter classes (deriving (MonadState S),
;;; GHC's GeneralizedNewtypeDeriving): an instance like a standalone
;;; deriving's, C args (N a1 .. ak), its context C args at the field type,
;;; both without the last type variable when the field type also ends
;;; with it (newtype App a = App (StateT S IO a) gives MonadState S App
;;; from MonadState S (StateT S IO)).  Kinds are not known here: one
;;; variable, for the class of monads (* -> *) these mostly are.

(define *mp-derivings* '())

(define (mp-deriving-instances data-decl)
  (let ((derivings (reverse *mp-derivings*)))
    (setf *mp-derivings* '())
    (if (or (null? derivings)
	    (not (data-decl-newtype? data-decl)))
	'()
	(let* ((simple (data-decl-simple data-decl))
	       (field (tuple-2-1 (car (constr-types
				       (car (data-decl-constrs data-decl))))))
	       (vars (reverse (tycon-args simple))))
	  (when (eta-reducible? vars field)
	    (setf field (type-without-last-arg field))
	    (setf vars (cdr vars)))
	  (map (lambda (d)
		 (let ((class (tuple-2-1 d))
		       (args (tuple-2-2 d)))
		   (make instance-decl (context '())
			 (class class) (simple simple) (decls '())
			 (types (append args
					(list (make tycon (name (tycon-name simple))
						    (def (tycon-def simple))
						    (args (reverse vars))))))
			 (mcontext (list (make mp-context
					       (class (make class-ref
							    (name (class-ref-name class))
							    (class *undefined-def*)))
					       (types (append args (list field))))))
			 (newtype-derived? '#t))))
	       derivings)))))

(define (eta-reducible? vars field)
  (and (not (null? vars))
       (let ((args (cond ((tycon? field) (tycon-args field))
			 ((tyapp? field) (tyapp-args field))
			 (else '()))))
	 (and (not (null? args))
	      (let ((last (list-ref args (1- (length args))))
		    (v (tyvar-name (car vars))))
		(and (tyvar? last)
		     (eq? (tyvar-name last) v)
		     (not (memq v (ast-tyvar-names (type-without-last-arg field))))
		     (not (memq v (lisp:mapcan (function ast-tyvar-names)
					       (cdr vars))))))))))

(define (type-without-last-arg type)
  (if (tycon? type)
      (make tycon (name (tycon-name type)) (def (tycon-def type))
	    (args (butlast (tycon-args type))))
      (let ((args (butlast (tyapp-args type))))
	(if (null? args)
	    (tyapp-fun type)
	    (make tyapp (fun (tyapp-fun type)) (args args))))))

(define (parse-constr-annotations)
  (token-case
   ((begin-annotation no-advance)
    (let ((annotations (parse-annotations)))
      (append annotations (parse-constr-annotations))))
   (else '())))

(define (parse-synonym-decl)
 (save-parser-context
  (let* ((sig (parse-signature))
	 (contexts (signature-context sig))
	 (simple (signature-type sig)))
    (check-simple simple '#t "type synonym declaration")
    (when (not (null? contexts))
      (signal-no-context-in-synonym))
    (require-token = (signal-missing-token "`='" "type synonym declaration"))
    (let ((body (parse-type)))
      ;; KindSignatures (GHC): type Splice = Code :: kind, ignored
      ;; (kinds are inferred)
      (when (and (haskell98?) (eq-token? '\:\:))
	(skip-to-decl-end))
      (make synonym-decl (simple simple) (body body))))))

(define (signal-no-context-in-synonym)
  (parser-error 'no-context-in-synonym
		"Context is not permitted in type synonym declaration."))

;;; A class's context; its equalities (item ~ Item full) are kept in
;;; *class-context-equalities* (tdecl/class.mumble's class-equalities).
(define *class-context-equalities* '())

(define (parse-class-context)
  (let ((contexts (parse-optional-context)))
    (setf *class-context-equalities*
	  (lisp:remove-if-not (function equality-assertion?) contexts))
    contexts))

(define (parse-class-decl)
 (save-parser-context
  ;; a multi-parameter superclass (class HasSetter t b => HasUpdate t a b)
  ;; is kept apart: signatures with the class get it too
  ;; (util/signature.mumble's add-mp-superclass-contexts)
  (mlet (((supers mp-supers) (split-contexts (parse-class-context))))
    (token-case
     (tycon
      (let* ((class (class->ast))
	     ;; KindSignatures (GHC): class C (f :: * -> *)
	     (kinded? (and (haskell98?) (eq-token? '\()
			   (begin (advance-token) '#t))))
	(token-case
	 (tyvar
	  (let* ((class-var (token->symbol))
		 (_ (when kinded?
		      (require-token \:\:
			(signal-missing-token "`::'" "kind signature"))
		      (skip-kind)))
		 ;; a multi-parameter class: C a b [| a -> b]
		 (more-vars (parse-more-class-tyvars))
		 (fundeps (if (and (not (null? more-vars)) (eq-token? '\|))
			      (begin (advance-token) (parse-fundeps))
			      '()))
		 (families-before (length *family-decls*))
		 (decls (remove-inline-annotations (parse-where-decls)))
		 ;; the associated families its body declared (pushed on
		 ;; *family-decls*)
		 (families (map (lambda (d) (tycon-name (synonym-decl-simple d)))
				(lisp:subseq *family-decls* 0
					     (- (length *family-decls*) families-before)))))
	    (make class-decl (class class) (super-classes supers)
		             (class-var class-var) (decls decls)
			     (families families)
			     (class-vars (if (null? more-vars)
					     '()
					     (cons class-var more-vars)))
			     (fundeps fundeps)
			     (mp-super-classes mp-supers)
			     (equalities *class-context-equalities*))))
	 (else
	  (signal-missing-token "<tyvar>" "class declaration")))))
     (else (signal-missing-token "<tycon>" "class declaration"))))))

;;; A class's further parameters, each a tyvar or (tyvar :: kind).
(define (parse-more-class-tyvars)
  (cond ((eq-token? 'varid)
	 (let ((tyvar (token->symbol)))
	   (cons tyvar (parse-more-class-tyvars))))
	((and (eq-token? '\() (eq? (peek-1-type) 'varid))
	 (advance-token)
	 (let ((tyvar (token->symbol)))
	   (require-token \:\: (signal-missing-token "`::'" "kind signature"))
	   (skip-kind)
	   (cons tyvar (parse-more-class-tyvars))))
	(else '())))

;;; Class bodies cannot hold annotations (later phases expect only
;;; signatures and valdefs there), but H98 allows {-# INLINE m #-} on a
;;; class method.  Inlining is only a hint, so Inline annotations in a
;;; class body are dropped.

;;; Functional dependencies: a b -> c, d -> a ...

(define (parse-fundeps)
  (let* ((from (parse-fundep-vars))
	 (to (begin
	       (require-token -> (signal-missing-token "`->'" "functional dependency"))
	       (parse-fundep-vars))))
    (cons (tuple from to)
	  (token-case
	   (\, (parse-fundeps))
	   (else '())))))

(define (parse-fundep-vars)
  (token-case
   (tyvar (let ((v (token->symbol)))
	    (cons v (parse-fundep-vars))))
   (else '())))

(define (remove-inline-annotations decls)
  (cond ((null? decls) '())
	((and (is-type? 'annotation-decls (car decls))
	      (every (function inline-annotation-decl?)
		     (annotation-decls-annotations (car decls))))
	 (remove-inline-annotations (cdr decls)))
	(else
	 (cons (car decls) (remove-inline-annotations (cdr decls))))))

(define (inline-annotation-decl? a)
  (and (is-type? 'annotation-decl a)
       (every (lambda (v)
		(and (is-type? 'annotation-value v)
		     (eq? (annotation-value-name v) '|Inline|)))
	      (annotation-decl-annotations a))))

(define (signal-fixity-in-instance)
  (parser-error/recoverable 'fixity-in-instance
    "A fixity declaration may not appear in an instance declaration."))

(define (parse-instance-decl interface?)
 (save-parser-context
  (mlet (((assertions equalities) (split-equalities (parse-optional-context)))
	 ((contexts mcontexts) (split-contexts assertions))
	 (decls '()))
    (token-case
     (tycon
      (let* ((class (class->ast))
	     ;; one atype, or several for a multi-parameter class
	     (types (if (haskell98?) (parse-atype-list) (list (parse-type))))
	     (simple '#f))
	;; equality constraints (instance a ~ Char => IsString [a])
	(when (and (not (null? equalities)) (not (null? types)))
	  (mlet (((c m ts) (apply-equalities/instance equalities contexts mcontexts types)))
	    (setf contexts c)
	    (setf mcontexts m)
	    (setf types ts)))
	(setf simple (if (null? (cdr types)) (car types) '#f))
	(when (null? types)
	  (signal-missing-token "<type>" "instance declaration"))
	(when (not interface?)
	   (setf decls (dynamic-let ((*in-instance-body?* '#t)
				     (*instance-class-qualifier*
				      (name-qualifier (symbol->string (class-ref-name class)))))
			 (parse-where-decls)))
	   ;; InstanceSigs (GHC): a method's signature in the instance is
	   ;; dropped (GHC checks it against the instance's type), but one
	   ;; with a forall names the method's own type variables, which
	   ;; scope over its body (*instance-method-sigs*)
	   (when (haskell98?)
	     (dolist (d decls)
	       (when (and (is-type? 'signdecl d)
			  (not (null? (signature-foralls (signdecl-signature d)))))
		 (dolist (v (signdecl-vars d))
		   (push (tuple class (tuple (var-ref-name v) (signdecl-signature d)))
			 *instance-method-sigs*))))
	     (setf decls (lisp:remove-if (lambda (d) (is-type? 'signdecl d))
					 decls)))
	   (when (some (lambda (d) (is-type? 'fixity-decl d)) decls)
	     (signal-fixity-in-instance)
	     (setf decls (remove-fixity-decls decls))))
	(cond ((not (null? equalities))
	       ;; a head an equality made non-linear (instance (a ~ b) =>
	       ;; Each (a, b) ...: (b, b)) is not checked
	       '#t)
	      (simple
	       ;; FlexibleInstances (GHC): any arguments (tdecl/instance.mumble)
	       ;; and a catch-all instance C a (UndecidableInstances)
	       (if (and (haskell98?) (or (tycon? simple) (tyvar? simple)
					 ;; C (t a): tdecl/instance.mumble's
					 ;; catch-all-instance->def
					 (var-application-head? simple)))
		   '#t
		   (check-simple simple '#f "instance declaration")))
	      ;; FlexibleInstances: a multi-parameter instance's types may be
	      ;; any (FoldableWithIndex [Int] Tree); find-mp-instance matches
	      ;; them whole (type/mp-classes.mumble)
	      ((haskell98?) '#t)
	      (else
	       (dolist (ty types)
		 (when (not (tyvar? ty))
		   (check-simple ty '#f "instance declaration")))))
	(make instance-decl (context contexts) (class class)
	                    (simple (or simple (car types))) (decls decls)
			    (types (if simple '() types))
			    (mcontext mcontexts))))
     (else (signal-missing-token "<tycon>" "instance declaration"))))))
;;; TypeFamilies (GHC), type/families.mumble.  The declarations go on
;;; these lists, which wrapup-module (module-parser.mumble) moves into the
;;; module: a family is a synonym-decl with family? set; an equation is
;;; (tuple lhs rhs), lhs the family applied to argument types; a data
;;; instance is a new data type, named F:n, and the equation F args =
;;; F:n vars.

(define *family-decls* '())
(define *family-equations* '())
(define *family-data-decls* '())
(define *family-instance-count* 0)

;;; type family F a b [:: kind] [where equations], data family ...,
;;; and in a class body type F a [:: kind], data F a [:: kind].  The kind's
;;; arrows count as more parameters.

(define (parse-type-family-decl . data?)
  (when (at-varid-named? "family") (advance-token))
  (let* ((head (parse-infix-family-lhs (parse-btype)))
	 (extra (cond ((eq-token? '\:\:)
		       (advance-token)
		       (let ((n (parse-kind-arrows)))
			 ;; a family of constraints (NewtypeErr a b ::
			 ;; Constraint): tdecl/alg-syn.mumble's family-name?
			 (when *kind-result-constraint?*
			   (push (tycon-name head) *constraint-families*))
			 n))
		      ((at-family-result-signature?)
		       (parse-family-result-signature))
		      (else 0))))
    (when (not (tycon? head))
      (signal-invalid-syntax "a type family declaration"))
    (let ((i 0))
      (setf (tycon-args head)
	    (append (map (lambda (a)
			   (if (tyvar? a) a (make tyvar (name (gensym "k")))))
			 (tycon-args head))
		    (map (lambda (k) (declare (ignore k))
			   (incf i)
			   (make tyvar (name (string->symbol (format '#f "k%~A" i)))))
			 (list-head '(1 2 3 4 5 6 7 8) extra)))))
    ;; a data family is injective: family? is data
    (push (make synonym-decl (simple head) (body '#f)
		(family? (if (and (pair? data?) (car data?)) 'data '#t)))
	  *family-decls*)
    ;; a closed family's equations
    (when (eq-token? '|where|)
      (advance-token)
      (start-layout (function parse-family-equations)))))

;;; An infix family head or equation's left side, a || b (Data.Type.Bool):
;;; the operator applied to the two.
(define (parse-infix-family-lhs left)
  (if (type-operator-here?)
      (let* ((name (type-operator-name))
	     (right (parse-btype)))
	(make tycon (name name) (def *undefined-def*) (args (list left right))))
      left))

;;; TypeFamilyDependencies (GHC): type family F a = r | r -> a, or
;;; = (r :: kind) | ...  The injectivity is not used; the kind's arrows
;;; count as more parameters.

(define (at-family-result-signature?)
  (and (eq-token? '=)
       (or (and (eq? (peek-1-type) 'varid) (eq? (peek-2-type) '\|))
	   (and (eq? (peek-1-type) '\() (eq? (peek-2-type) 'varid)
		(eq? (peek-toks 2 *token-stream*) '\:\:)))))

(define (parse-family-result-signature)
  (advance-token)
  (let ((extra (if (eq-token? '\()
		   (begin (advance-token) (advance-token) (advance-token)
			  (let ((n (parse-kind-arrows)))
			    (require-token \) (signal-missing-token "`)'" "a type family result"))
			    n))
		   (begin (advance-token) 0))))
    (require-token \| (signal-missing-token "`|'" "a type family injectivity annotation"))
    (do () ((memq *token* '(\; \} $\} eof |where|)))
      (advance-token))
    extra))

;;; The arrows of a kind: * -> * -> *, Type -> Type, (k -> Type) -> k.
;;; (*kind-result-constraint?*: whether the kind's result is Constraint)
(define *kind-result-constraint?* '#f)

(define (parse-kind-arrows)
  (let ((n 0) (depth 0) (last '#f))
    (do () ((or (memq *token* '(\; \} $\} eof |where| =))
		(and (eqv? depth 0) (eq-token? '\))))
	    (setf *kind-result-constraint?* (equal? last "Constraint"))
	    n)
      (cond ((eq-token? '\() (incf depth))
	    ((eq-token? '\)) (decf depth))
	    ((and (eqv? depth 0) (eq-token? '->)) (incf n)))
      (setf last (and (eq-token? 'conid)
		      (let* ((s (car *token-args*))
			     (i (lisp:position #\. s :from-end '#t)))
			(if i (substring s (1+ i) (string-length s)) s))))
      (advance-token))))

(define (parse-family-equations in-layout?)
  (token-case
   (\; (parse-family-equations in-layout?))
   ((no-advance \} $\} eof)
    (close-layout in-layout?) '())
   (else
    (parse-type-equation)
    (token-case
     (\; (parse-family-equations in-layout?))
     (else (close-layout in-layout?) '())))))

;;; type instance F t1 ... tn = t, or in an instance body type F ... = t
(define (parse-type-equation)
  (let ((lhs (parse-infix-family-lhs (parse-btype))))
    (require-token = (signal-missing-token "`='" "type family equation"))
    (let ((rhs (parse-type)))
      (when (not (tycon? lhs))
	(signal-invalid-syntax "a type family equation"))
      ;; in an instance of M.C, an associated type F is C's: M.F
      (when (and *in-instance-body?* (dynamic *instance-class-qualifier*)
		 (not (name-qualifier (symbol->string (tycon-name lhs)))))
	(setf (tycon-name lhs)
	      (string->symbol (string-append (dynamic *instance-class-qualifier*) "."
					     (symbol->string (tycon-name lhs))))))
      (push (tuple lhs rhs) *family-equations*))))

;;; The module qualifier of a qualified name (Exts of Exts.IsList), or #f.
(define *instance-class-qualifier* '#f)

(define (name-qualifier s)
  (let ((i (lisp:position #\. s :from-end '#t)))
    (and i (> i 0) (char-upper-case? (string-ref s 0))
	 (substring s 0 i))))

;;; data instance F t1 ... tn = constrs [deriving], newtype instance ...
(define (parse-data-instance newtype?)
  (when (eq-token? '|instance|) (advance-token))
  (let* ((lhs (parse-btype))
	 (name (string->symbol
		(format '#f "~A:~A" (tycon-name lhs) (incf *family-instance-count*))))
	 (vars (lisp:remove-duplicates
		(lisp:mapcan (function ast-tyvar-names) (tycon-args lhs))
		:from-end '#t))
	 (simple (make tycon (name name) (def *undefined-def*)
		       (args (map (lambda (v) (make tyvar (name v))) vars)))))
    (setf *special-derivings* '())
    (require-token = (signal-missing-token "`='" "data instance"))
    (let* ((constrs (parse-constrs))
	   (deriving (parse-optional-deriving))
	   (decl (make data-decl (context '()) (simple simple) (constrs constrs)
		       (deriving deriving)
		       (special-derivings (reverse *special-derivings*))
		       (annotations '()))))
      (when newtype?
	(setf (data-decl-newtype? decl) '#t))
      (push decl *family-data-decls*)
      (push (tuple lhs (make tycon (name name) (def *undefined-def*)
			     (args (map (lambda (v) (make tyvar (name v))) vars))))
	    *family-equations*))))
