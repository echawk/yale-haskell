
;;; This is the top level entry to the parse.  The input is a list of file
;;; names to be parsed and the output is a list of modules.  Interface files
;;; generate modules similar to ordinary files.  

(define (parse-files filenames)
  (let ((all-mods '()))
    (dolist (file filenames)
      (let* ((ext (filename-type file))
	     (mods (cond ((string=? ext ".hs")
			  (parse-single-file file))
			 ((string=? ext ".lhs")
			  (parse-single-file/literate file))
			 ((string=? ext ".hi")
			  (parse-single-file/interface file)))))
	   (setf all-mods (append all-mods mods))))
    all-mods))

(define (parse-single-file filename)
  (parse-single-file-1 filename '#f '#f))

(define (parse-single-file/literate filename)
  (parse-single-file-1 filename '#t '#f))

(define (parse-single-file/interface filename)
  (parse-single-file-1 filename '#f '#t))

;;; Literate files in the LaTeX style (H98 report 9.4): the code is
;;; between \begin{code} and \end{code} lines.  Every other line is made
;;; blank, so lines and columns are kept, and the text is lexed as an
;;; ordinary file.

(define (latex-literate-file? filename)
  (call-with-input-file filename
    (lambda (port)
      (do ((line (read-line port) (read-line port))
	   (found? '#f))
	  ((or found? (eof-object? line)) found?)
	(when (string-starts? "\\begin{code}" line)
	  (setf found? '#t))))))

(define (latex-literate-code filename)
  (lisp:with-output-to-string (out)
    (call-with-input-file filename
      (lambda (port)
	(do ((line (read-line port) (read-line port))
	     (code? '#f))
	    ((eof-object? line))
	  (cond ((string-starts? "\\begin{code}" line) (setf code? '#t))
		((string-starts? "\\end{code}" line) (setf code? '#f))
		(code? (write-string line out)))
	  (write-char #\newline out))))))

;;; The text to lex for a source file that uses CPP (cpp.mumble): unlit
;;; if literate, then preprocessed.  '#f for one that does not, which is
;;; lexed as it is.

(define (preprocessed-source filename literate?)
  (and (cpp-file? filename)
       (cpp-source filename
		   (cond ((not literate?)
			  (read-file-text filename))
			 ((latex-literate-file? filename)
			  (latex-literate-code filename))
			 (else
			  (bird-unlit (read-file-text filename)))))))

(define (parse-single-file-1 filename literate? interface?)
  (when (memq 'reading *printers*)
      (format '#t "Reading Haskell source file ~s.~%" filename))
  (when (not (file-exists? filename))
    (signal-file-not-found filename))
  (setf *standalone-derivings* '())
  (dynamic-let ((*current-file* filename))
    (let ((mods '()))
      (call-with-input-file filename
        (lambda (port)
	  (let* ((text   (and (not interface?)
			      (preprocessed-source filename literate?)))
		 (tokens (dynamic-let ((*lexing-interface?* interface?))
			   (cond
			    (text
			     (lex-port (lisp:make-string-input-stream text) '#f))
			    ((and literate? (latex-literate-file? filename))
			       (lex-port (lisp:make-string-input-stream
					  (latex-literate-code filename))
					 '#f))
			    (else
			     (lex-port port literate?)))))
		 (module-asts (if interface?
				  (parse-tokens/interface tokens)
				  (parse-tokens tokens))))
	    (setf mods module-asts))))
      (when (memq 'parse *printers*)
	(dolist (m mods)
	  (format '#t "~%")
	  (print-full-module m)))
      mods)))


