;;; File: decl-parser           Author: John

(define (parse-decl)
  (let ((decl-type (find-decl-type)))
    (cond ((eq? decl-type 'signdecl)
	   (let ((line-number (capture-current-line))
		 (d (parse-signdecl)))
	     (if (and (haskell98? ) (signdecl? d)
		      (null? (cdr (signdecl-vars d)))
		      (or (eq-token? '\|) (eq-token? '=)))
		 ;; x :: t | g = e .. (GHC): the binding of x, its pattern
		 ;; with the signature (Agda's end :: Doc | sl == el = ..)
		 (add-rhs (make sig-pat (pattern (make var-pat (var (car (signdecl-vars d)))))
				(signature (signdecl-signature d)))
			  '() '#f line-number)
		 d)))
	  ((eq? decl-type 'pat-or-op)
	   (parse-pat-or-op))
	  ((eq? decl-type 'fundef)
	   (parse-fundef))
	  ((eq? decl-type 'paren-fundef)
	   (parse-paren-fundef))
	  ((eq? decl-type 'plus-def)
	   (parse-plus-def))
	  ((eq? decl-type 'annotation)
	   (make annotation-decls (annotations (parse-annotations))))
	  ((eq? decl-type 'ip-binding)
	   (parse-ip-binding)))))

;;; ImplicitParams: ?x = e (exp-parser.mumble's ip-let-or-let).
(define (parse-ip-binding)
  (save-parser-context
   (let ((name (car *token-args*)))
     (advance-token)
     (require-token = (signal-missing-token "`='" "implicit parameter binding"))
     (make ip-binding (name name) (exp (parse-exp))))))

;;; This looks at the first tokens in a definition to determine it's type.
;;;   var (:: | ,)      - signdecl
;;;   var apat-start    - function definition
;;;   (var | _) +       - definition of infix +
;;;   ( funlhs ) apat   - parenthesised function lhs (H98), e.g. (f . g) x
;;;   anything alse     - pattern binding or infix definition

(define (find-decl-type)
  (let* ((saved-excursion (save-scanner-state))
	 (decl-type
	  (token-case
	   (var (scan-var)
		(token-case
		 ((no-advance satisfies at-bang?) 'fundef)
		 ((\, \:\:) 'signdecl)
		 (apat-start 'fundef)
		 (+ 'plus-def)
		 (else 'pat-or-op)))
	   (_ (token-case
	       (+ 'plus-def)
	       (else 'pat-or-op)))
	   (begin-annotation 'annotation)
	   (ipvar 'ip-binding)
	   ((no-advance \()
	    (if (scan-paren-funlhs) 'paren-fundef 'pat-or-op))
	   (else 'pat-or-op))))
    (restore-excursion saved-excursion)
    decl-type))

;;; These are the different flavors of decl parsers

(define (parse-signdecl)
 (save-parser-context
  (trace-parser signdecl
    (let ((vars (parse-signdecl-vars)))
      (require-token \:\:
		     (signal-missing-token "`::'" "signature declaration"))
      (setf *signature-wildcard?* '#f)
      (let ((signature (parse-signature)))
	(if *signature-wildcard?*
	    ;; a partial signature: dropped (PartialTypeSignatures)
	    (begin (setf *signature-wildcard?* '#f)
		   (make annotation-decls (annotations '())))
	    (make signdecl (vars vars) (signature signature))))))))
 
(define (parse-signdecl-vars)
  (token-case
   (var (let ((var (var->ast)))
	  (token-case (\, (cons var (parse-signdecl-vars)))
		      (else (list var)))))
   (else (signal-missing-token "<var>" "signature declaration"))))

(define (parse-pat-or-op)
  (trace-parser patdef
    (let* ((line-number (capture-current-line))
	   (pat (parse-pat)))
      (token-case
       (varop (parse-infix-def pat line-number))
       (else (add-rhs pat '() '#f line-number))))))

(define (parse-infix-def pat1 line-number)
  (let* ((op (make var-pat (var (varop->ast))))
	 (pat2 (parse-pat)))
	(add-rhs op (list pat1 pat2) '#t line-number)))

(define (parse-fundef)
 (trace-parser fundef
  (let* ((start-line (capture-current-line))
	 (fn (parse-apat))  ; must be a single variable
	 (args (parse-apat-list)))
    (add-rhs fn args '#f start-line))))

;;; Haskell 98 function lhs in parentheses:
;;;   funlhs -> var apat {apat} | pat varop pat | ( funlhs ) apat {apat}
;;; `(f . g) x = e' defines (.) with three arguments, `(f x) y = e'
;;; defines f with two.  Only the parenthesised form is new here.

(define (parse-paren-fundef)
 (trace-parser paren-fundef
  (let* ((start-line (capture-current-line))
	 (lhs (parse-paren-funlhs)))
    (add-rhs (car lhs) (cdr lhs) '#f start-line))))

;;; At the `('.  Returns (fn-pat arg-pat ...).

(define (parse-paren-funlhs)
  (advance-token)
  (let ((inner (parse-funlhs-inner)))
    (require-token \) (signal-missing-token "`)'" "function lhs"))
    (append inner (parse-apat-list))))

(define (parse-funlhs-inner)
  (let ((kind (let ((saved-excursion (save-scanner-state)))
		(let ((k (scan-funlhs-inner)))
		  (restore-excursion saved-excursion)
		  k))))
    (cond ((eq? kind 'apply)
	   (let ((fn (parse-apat)))
	     (cons fn (parse-apat-list))))
	  ((eq? kind 'paren)
	   (parse-paren-funlhs))
	  (else
	   (let* ((pat1 (parse-pat))
		  (op (make var-pat (var (varop->ast))))
		  (pat2 (parse-pat)))
	     (list op pat1 pat2))))))

;;; Scanners for the above; they leave the scanner state undefined.

(define (scan-paren-funlhs)  ; at the `('
  (advance-token)
  (and (scan-funlhs-inner)
       (token-case
	(\) (token-case
	     ((no-advance apat-start) (scan-apat-list))
	     (else '#f)))
	(else '#f))))

;;; Returns apply, paren, infix or #f.

(define (scan-funlhs-inner)
  (let ((saved-excursion (save-scanner-state)))
    (cond ((and (token-case
		 ((no-advance var) (scan-var))
		 (else '#f))
		(token-case
		 ((no-advance apat-start) (scan-apat-list))
		 (else '#f)))
	   'apply)
	  ((begin
	     (restore-excursion saved-excursion)
	     (token-case
	      ((no-advance \() (scan-paren-funlhs))
	      (else '#f)))
	   'paren)
	  ((begin
	     (restore-excursion saved-excursion)
	     (and (scan-pat)
		  (scan-varop)
		  (scan-pat)))
	   'infix)
	  (else '#f))))

(define (scan-varop)
  (token-case
   (varsym '#t)
   (\` (token-case
	(varid (token-case
		(\` '#t)
		(else '#f)))
	(else '#f)))
   (else '#f)))

(define (parse-plus-def)
  (trace-parser plus-def
    (let* ((start-line (capture-current-line))
	   (var (parse-apat)))
      (parse-infix-def var start-line))))

(define (add-rhs pat args infix? start-line)
  (let* ((views (take-view-patterns))
	 (rhs0 (parse-rhs))
	 (decls0 (parse-where-decls))
	 ;; the where's bindings go after the views, which they may use
	 ;; (nonempty-containers: f (toMap -> m1) = .. where .. m1 ..)
	 (rhs (add-view-pattern-guards views rhs0 decls0))
	 (decls (if (null? views) decls0 '()))
	 (single (make single-fun-def
		       (args args)
		       (rhs-list rhs)
		       (where-decls decls)
		       (infix? infix?)))
	 (valdef (make valdef (lhs pat) (definitions (list single)))))
    (setf (ast-node-line-number single) start-line)
    (setf (ast-node-line-number valdef) start-line)
    valdef))

(define (parse-rhs)
  (token-case
   (= (let ((rhs (parse-exp)))
	(list (make guarded-rhs (guard (make omitted-guard)) (rhs rhs)))))
   (\| (parse-guarded-rhs))
   (else
    (signal-missing-token "`=' or `|'" "rhs of valdef"))))

(define (parse-guarded-rhs) ; assume just past |
 (trace-parser guard
  (let ((guard (parse-guard)))
    (require-token = (signal-missing-token "`='" "guarded rhs"))
    (let* ((exp (parse-exp))
	   (res (make guarded-rhs (guard guard) (rhs exp))))
      (token-case
       (\| (cons res (parse-guarded-rhs)))
       (else (list res)))))))

(define (parse-where-decls)
  (token-case
   (|where|
    (parse-decl-list))
   (else '())))

(define (parse-decl-list)
  (if (empty-layout-block?)
      '()
      (start-layout (function parse-decl-list-1))))

;;; Haskell 98 (report 10.3): a block opened by layout whose first token
;;; is not indented more than the enclosing block is empty, as in
;;;   instance C T where
;;;   f :: Int     -- f is the next top-level declaration
;;; (async's instance whose methods CPP removed).
(define (empty-layout-block?)
  (and (haskell98?)
       (not (eq-token? '\{))
       (not (null? *layout-stack*))
       (<= *current-col* (layout-col (car *layout-stack*)))))

(define (parse-decl-list-1 in-layout?)
  (token-case
   ;; an empty declaration (H98: `a = 1;' at the end of a layout line)
   (\; (parse-decl-list-1 in-layout?))
   ((apat-start begin-annotation)
    (let ((decl (parse-decl)))
      (parse-decl-list-2 decl in-layout?)))
   ;; let ?x = e (ImplicitParams)
   ((no-advance ipvar)
    (let ((decl (parse-decl)))
      (parse-decl-list-2 decl in-layout?)))
   ;; let !x = e (BangPatterns)
   ((no-advance satisfies at-bang?)
    (let ((decl (parse-decl)))
      (parse-decl-list-2 decl in-layout?)))
   ;; Local fixity declarations (H98).  The scope phase attaches them to
   ;; the names bound in the same declaration list and removes them.
   ;; TypeFamilies (GHC): associated types in a class (a family) or an
   ;; instance (an equation, or a data instance); typedecl-parser.mumble
   (|type| (if *in-instance-body?*
	       (parse-type-equation)
	       (parse-associated-type))
	   (token-case
	    (\; (parse-decl-list-1 in-layout?))
	    (else (close-layout in-layout?) '())))
   (|data|
    (if *in-instance-body?*
	(parse-data-instance '#f)
	(parse-type-family-decl '#t))
    (token-case
     (\; (parse-decl-list-1 in-layout?))
     (else (close-layout in-layout?) '())))
   (|newtype|
    (parse-data-instance '#t)
    (token-case
     (\; (parse-decl-list-1 in-layout?))
     (else (close-layout in-layout?) '())))
   ;; DefaultSignatures (GHC), in a class: default m :: sig
   (|default| (let ((decl (dynamic-let ((*recording-equalities?* '#t)
					  (*recorded-equalities* '()))
			    (let ((d (parse-signdecl)))
			      ;; t n ~ m, m the class's: init-methods
			      (push (tuple (signdecl-signature d)
					   (dynamic *recorded-equalities*))
				    *default-sig-equalities*)
			      d))))
		(setf (signdecl-default? decl) '#t)
		(parse-decl-list-2 decl in-layout?)))
   (|infix| (parse-decl-list-2 (parse-fixity-decl 'n) in-layout?))
   (|infixl| (parse-decl-list-2 (parse-fixity-decl 'l) in-layout?))
   (|infixr| (parse-decl-list-2 (parse-fixity-decl 'r) in-layout?))
   (else
    (close-layout in-layout?)
    '())))

(define (parse-decl-list-2 decl in-layout?)
  (token-case
   (\; (decl-cons decl (parse-decl-list-1 in-layout?)))
   (else (close-layout in-layout?)
	 (list decl))))

(define (remove-fixity-decls decls)
  (cond ((null? decls) '())
	((is-type? 'fixity-decl (car decls))
	 (remove-fixity-decls (cdr decls)))
	(else (cons (car decls) (remove-fixity-decls (cdr decls))))))

;;; This adds a new decl to a decl list.  Successive decls for the same fn
;;; are combined.

(define (decl-cons decl decl-list)
  (cond ((null? decl-list)
	 (list decl))
	(else (nconc (combine-decls decl (car decl-list)) (cdr decl-list)))))

(define (decl-push decl decl-stack)
  (cond ((null? decl-stack)
	 (list decl))
	(else (nconc (nreverse (combine-decls (car decl-stack) decl))
		     (cdr decl-stack)))))

(define (combine-decls decl1 decl2)
  (if (and (is-type? 'valdef decl1)
	   (is-type? 'valdef decl2)
	   (same-decl-var? (valdef-lhs decl1) (valdef-lhs decl2)))
      (if (eqv? (length (single-fun-def-args (car (valdef-definitions decl1))))
		(length (single-fun-def-args (car (valdef-definitions decl2)))))
	  (begin
	    (setf (valdef-definitions decl1)
		  (nconc (valdef-definitions decl1)
			 (valdef-definitions decl2)))
	    (list decl1))
	  (signal-multiple-definitions-arity-mismatch (valdef-lhs decl1)))
      (list decl1 decl2)))

(define (same-decl-var? pat1 pat2)
  (and (is-type? 'var-pat pat1)
       (is-type? 'var-pat pat2)
       (eq? (var-ref-name (var-pat-var pat1))
	    (var-ref-name (var-pat-var pat2)))))

(define (signal-multiple-definitions-arity-mismatch pat)
  (parser-error 'multiple-definitions-arity-mismatch
		"Definition of ~a does not match arity of previous definition."
		pat))
		   
	 

;;; Inside an instance's where (typedecl-parser.mumble): type and data
;;; declarations are a family's equations there.
(define *in-instance-body?* '#f)

;;; In a class: type F a [:: kind] declares an associated family; with
;;; = it is a default instance, which is not used.
(define (parse-associated-type)
  (if (associated-default-follows?)
      (begin (parse-btype)
	     (require-token = (signal-missing-token "`='" "type default"))
	     (parse-type))
      (parse-type-family-decl)))

(define (associated-default-follows?)
  (let* ((saved (save-scanner-state))
	 (res (begin (when (at-varid-named? "instance") (advance-token))
		     (parse-btype)
		     ;; (not = r | r -> a: TypeFamilyDependencies' result,
		     ;; nonempty-containers' type NE s = t | t -> s)
		     (and (eq-token? '=)
			  (not (at-family-result-signature?))))))
    (restore-excursion saved)
    res))
