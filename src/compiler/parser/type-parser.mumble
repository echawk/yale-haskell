;;; File: type-parser        Author: John

(define (parse-type)
  (if (and (haskell98?) (eq-token? 'varid) (string=? (car *token-args*) "forall"))
      ;; RankNTypes: forall a. t, or forall a. C a => t, in an argument
      ;; or field
      (let ((tyvars (skip-explicit-forall)))
	(mlet (((single mp) (split-contexts (parse-optional-context))))
	  (make forall-type (tyvars tyvars) (context single) (mcontext mp)
		(type (parse-type)))))
      (if (and (haskell98?) (has-optional-context?))
	  ;; C a => t without a forall, in an argument or field (GHC):
	  ;; gcastWith :: (a :~: b) -> ((a ~ b) => r) -> r
	  (mlet (((single mp) (split-contexts (parse-context))))
	    (if (and (null? single) (null? mp))
		(parse-type)
		(make forall-type (tyvars '()) (context single) (mcontext mp)
		      (type (parse-type)))))
	  (parse-type-1))))

(define (parse-type-1)
  (let ((type (parse-type-operators (parse-btype))))
    (cond ((linear-arrow-here?)
	   ;; LinearTypes (GHC): a %1 -> b, a %m -> b and a ⊸ b are a -> b;
	   ;; multiplicities are not checked
	   (let ((percent? (string=? (car *token-args*) "%")))
	     (advance-token)
	     (when percent?
	       (parse-atype)
	       (require-token -> (signal-missing-token "`->'" "linear arrow")))
	     (**tycon/def (core-symbol "Arrow") (list type (parse-type)))))
	  (else
	   (token-case
	     (->
	      (**tycon/def (core-symbol "Arrow") (list type (parse-type))))
	     (else type))))))

(define (linear-arrow-here?)
  (and (eq? *token* 'varsym)
       (mem-string (car *token-args*) '("%" "⊸"))
       (language-extension? "LinearTypes")))


;;; TypeOperators (GHC): t1 :+: t2, t1 + t2 is the type constructor
;;; (:+:) or (+) applied to t1 and t2; left associative (fixities of type
;;; operators are not used), binding tighter than ->.

(define (parse-type-operators left)
  (if (promoted-cons-here?)
      ;; DataKinds: t ': ts (or t : ts), right associative
      (begin
	(advance-token)
	(**tycon/def (core-symbol "PromotedCons")
		     (list left (parse-type-operators (parse-btype)))))
      (parse-type-operators-1 left)))

(define (parse-type-operators-1 left)
  (cond ((and (haskell98?) (tilde-here?)
	      (or (language-extension? "TypeOperators") (language-extension? "TypeFamilies")
		  (language-extension? "GADTs")))
	 ;; an equality as a type, in a constraint synonym's body (type C a
	 ;; = (F a ~ '())): %equality, which constraint-synonym-body drops
	 (advance-token)
	 (make tycon (name '|%equality|) (def *undefined-def*)
	       (args (list left (parse-btype)))))
	(else (parse-type-operators-2 left))))

(define (parse-type-operators-2 left)
  (if (type-operator-here?)
      ;; the operands and operators, associated by the operators'
      ;; fixities once they are known (a %type-op-chain, symbol-table's
      ;; reassociate-type-chain!)
      (let ((items (list left)))
	(do () ((not (type-operator-here?)))
	  (let* ((name (type-operator-name))
		 (right (parse-btype)))
	    (setf items (append items
				(list (make tycon (name name) (def *undefined-def*) (args '()))
				      right)))))
	(parse-type-operators
	 (if (null? (cdddr items))
	     (make tycon (name (tycon-name (cadr items))) (def *undefined-def*)
		   (args (list (car items) (caddr items))))
	     (make tycon (name '|%type-op-chain|) (def *undefined-def*) (args items)))))
      left))

;;; A type operator's name; a varsym (+) gets a prefix, as types and
;;; values share the symbol tables and a constructor operator's do.

(define (type-operator-name)
  (if (eq? *token* 'varsym)
      (let ((name (car *token-args*)))
	(advance-token)
	(string->symbol (string-append "type%" name)))
      (token->symbol)))

(define (prefix-type-operator?)
  (and (or (type-operator-here?)
	   ;; a constructor operator in parentheses needs no TypeOperators,
	   ;; as in GHC ((Eq.:~:) in semigroupoids)
	   (and (haskell98?) (eq? *token* 'consym)
		(not (mem-string (car *token-args*) '(":")))))
       (eq? (peek-1-type) '\))))

(define (type-operator-here?)
  (and (memq *token* '(consym varsym))
       (not (mem-string (car *token-args*) '("." "!" "~" "*" ":")))
       (not (linear-arrow-here?))
       (language-extension? "TypeOperators")))

;;; DataKinds (GHC): type-level lists.  '[] and '[t1, ..., tn], or
;;; [t1, t2, ...] with two or more elements, and t ': ts are built from
;;; the empty types PromotedNil and PromotedCons (PreludeCore): kinds are
;;; not checked, so a promoted list is any type made of these.

(define (promoted-cons-here?)
  (and (eq? *token* 'consym)
       (string=? (car *token-args*) ":")
       (language-extension? "DataKinds")))

(define (promoted-list types)
  (if (null? types)
      (**tycon/def (core-symbol "PromotedNil") '())
      (**tycon/def (core-symbol "PromotedCons")
		   (list (car types) (promoted-list (cdr types))))))

;;; The types of a promoted list after its [, through the ].
(define (parse-promoted-list-elements)
  (token-case
   (\] '())
   (else (let ((type (parse-type)))
	   (token-case
	    (\, (cons type (parse-promoted-list-elements)))
	    (\] (list type))
	    (else (signal-missing-token "`]' or `,'" "type-level list")))))))

(define (parse-btype)
  (token-case
   (tycon (let* ((tycon (tycon->ast))
		 (tycon-args (parse-atype-list)))
	    (setf (tycon-args tycon) tycon-args)
	    tycon))
   (tyvar (let* ((var (tyvar->ast))
		 (args (parse-atype-list)))
	    (if (null? args)
		var
		(**tyapp var args))))
   (else
    (let* ((type (parse-atype))
	   (args (parse-atype-list)))
      (if (and (not (null? args)) (tycon? type))
	  (apply-ast-type type args)   ; `(->) r', `[] a', `(,) a b'
	  type)))))

(define (at-type-wildcard?)
  (and (haskell98?) (eq-token? '\_)))

(define (parse-atype-list)
  (token-case
    ((atype-start satisfies at-type-wildcard?)
     (let ((atype (parse-atype)))
       (cons atype (parse-atype-list))))
    (else '())))

(define (parse-atype)
  (token-case
    ;; TemplateHaskell: a type splice; QuasiQuotes: [q|text|], the splice
    ;; $(quoteType q "text") (th/splices.mumble's type-splice-tycon)
    (splice-paren
     (let ((e (parse-exp)))
       (require-token \) (signal-missing-token "`)'" "a splice"))
       (type-splice-tycon e)))
    (splice-var (type-splice-tycon (var->ast)))
    ((no-advance quasi-quote)
     (let ((args *token-args*))
       (advance-token)
       (type-splice-tycon (quasi-quote-exp '|quoteType| args))))
    (tyvar (tyvar->ast))
    ;; PartialTypeSignatures (GHC): _
    ((no-advance satisfies at-type-wildcard?)
     (advance-token)
     (setf *signature-wildcard?* '#t)
     (make tyvar (name '|_wildcard|)))
    (tycon (tycon->ast))
    (\( (token-case
	  (\) (**tycon/def (core-symbol "UnitType") '()))
	  (-> (require-token \) (signal-missing-token "`)'" "type expression"))
	      (**tycon/def (core-symbol "Arrow") '()))
	  (\, (let ((n 2))
		(token-case-loop-commas n)))
	  ;; TypeOperators: (:+:) as a prefix type constructor
	  ((no-advance satisfies prefix-type-operator?)
	   (let ((name (type-operator-name)))
	     (advance-token)
	     (make tycon (name name) (def *undefined-def*) (args '()))))
	  (else
	    (let ((type (parse-type)))
	      (token-case
	       (\) type)
	       ;; KindSignatures (GHC): (t :: kind); the kind is inferred
	       (\:\: (skip-kind) type)
	       (\, (let ((types  (cons type (parse-type-list))))
		     (**tycon/def (tuple-tycon (length types)) types)))
	       (else
		(signal-missing-token "`)' or `,'" "type expression")))))))
    (\[ (token-case
	  (\] (**tycon/def (core-symbol "List") '()))
	  (else
	   (let ((type (parse-type)))
	     (token-case
	      (\] (**tycon/def (core-symbol "List") (list type)))
	      ;; DataKinds: [t1, t2, ...] is a type-level list
	      (\, (promoted-list (cons type (parse-promoted-list-elements))))
	      (else (signal-missing-token "`]'" "type expression")))))))
    ;; TemplateHaskell lexes DataKinds' tick as a name quote (lexer.mumble)
    (name-quote
     (token-case
      (\[ (promoted-list (parse-promoted-list-elements)))
      (else (parse-atype))))
    (promoted-tick
     (require-token \[ (signal-missing-token "`['" "type-level list"))
     (promoted-list (parse-promoted-list-elements)))
    ;; DataKinds' type-level literals ("text", 3, 'c'): type-literal
    ((no-advance integer)
     (let ((n (car *token-args*)))
       (advance-token)
       (**tycon/def (core-symbol "TypeNat") (list (type-literal-bits n)))))
    ((no-advance string)
     (let ((s (car *token-args*)))
       (advance-token)
       (**tycon/def (core-symbol "TypeSymbol")
		    (list (promoted-list
			   (map (function type-literal-char)
				(string->list s)))))))
    ((no-advance char)
     (let ((c (car *token-args*)))
       (advance-token)
       (type-literal-char c)))
    (else
     (signal-invalid-syntax "an atype"))))

;;; A type-level literal is a type of PreludeCore's empty types, so equal
;;; literals are equal types without definitions of their own: a natural
;;; number is TypeNat of its binary digits, least significant first, a
;;; promoted list of TypeB0 and TypeB1 (0: the empty list); a character
;;; is TypeChar of its code's; a string is TypeSymbol of a promoted list
;;; of its characters.  GHC.TypeLits' KnownNat, KnownSymbol and KnownChar
;;; have instances for them.

(define (type-literal-bits n)
  (if (<= n 0)
      (**tycon/def (core-symbol "PromotedNil") '())
      (**tycon/def (core-symbol "PromotedCons")
		   (list (**tycon/def (if (= (remainder n 2) 1) (core-symbol "TypeB1") (core-symbol "TypeB0"))
				      '())
			 (type-literal-bits (quotient n 2))))))

(define (type-literal-char c)
  (**tycon/def (core-symbol "TypeChar")
	       (list (type-literal-bits (char->integer c)))))

;;; The rest of a parenthesised kind signature, through its `)': a kind
;;; (*, Type, k -> k, Constraint, ...) is not checked.

(define (skip-kind)
  (skip-kind-1 0))

(define (skip-kind-1 depth)
  (token-case
   (\( (skip-kind-1 (1+ depth)))
   (\) (when (> depth 0) (skip-kind-1 (1- depth))))
   (eof (signal-missing-token "`)'" "kind signature"))
   (else (advance-token) (skip-kind-1 depth))))

;;; `(,' has been read; count the commas up to the `)' of `(,,)'.
(define (token-case-loop-commas n)
  (token-case
    (\, (token-case-loop-commas (1+ n)))
    (\) (**tycon/def (tuple-tycon n) '()))
    (else (signal-missing-token "`)' or `,'" "type expression"))))

(define (parse-type-list)
  (let ((type (parse-type)))
    (token-case (\, (cons type (parse-type-list)))
		(\) (list type))
		(else (signal-missing-token "`)' or `,'" "type expression")))))

;;; This is used to determine whether a type is preceded by a context

(define (has-optional-context?)
  (let* ((saved-excursion (save-scanner-state))
	 (res (if (haskell98?)
		  (scan-for-context-arrow 0)
		  (has-optional-context-1.2?))))
    (restore-excursion saved-excursion)
    res))

;;; Haskell 98: a context is everything before a `=>' outside brackets;
;;; the tokens that end a type (or cannot be in a context) stop the
;;; search.
(define (scan-for-context-arrow depth)
  (token-case
   ;; (one inside brackets is a quantified constraint's or a rank-n
   ;; argument's: (forall x. C x => D (t x)) => ..)
   (=> (or (eqv? depth 0) (scan-for-context-arrow depth)))
   ((\( \[) (scan-for-context-arrow (1+ depth)))
   ;; ImplicitParams' ?x :: t
   (ipvar (when (eq-token? '\:\:) (advance-token)) (scan-for-context-arrow depth))
   ((\) \]) (and (> depth 0) (scan-for-context-arrow (1- depth))))
   ;; (an arrow inside brackets is a class argument's: MonadReader
   ;; (MetaId -> Maybe Nat) m => ..)
   (-> (and (> depth 0) (scan-for-context-arrow depth)))
   ((= \| \; \} |where| \:\: <- eof) '#f)
   (else (advance-token) (scan-for-context-arrow depth))))

(define (has-optional-context-1.2?)
  (let* ((res (token-case
		(conid
		 (token-case
		  (varid (scan-more-context-tyvars))
		  (else '#f)))
		;; () => t: the empty context (H98 4.1.3, n = 0)
		(\( (token-case
		      (\) (eq-token? '=>))
		      (else (scan-context))))
		(else '#f))))
    res))

(define (scan-context)
  (token-case
    (conid
     (token-case
       (varid
	 (scan-context-rest))
       (else '#f)))
    (else '#f)))

;;; After the first tyvar of an assertion in parentheses: more tyvars (a
;;; multi-parameter class), then `)' or `,'.
(define (scan-context-rest)
  (token-case
    (varid (and (haskell98?) (scan-context-rest)))
    (\) (eq-token? '=>))
    (\, (scan-context))
    (else '#f)))

;;; After C a without parentheses: more tyvars (C a b), then `=>'.
(define (scan-more-context-tyvars)
  (token-case
    (varid (and (haskell98?) (scan-more-context-tyvars)))
    (else (eq-token? '=>))))

(define (parse-context)
 (let ((contexts (cond
		  ((equality-assertion-ahead?)
		   (list (parse-equality-assertion)))
		  (else
		   (token-case
		    (tycon
		     (list (parse-single-context)))
		    (\( (parse-contexts))
		    (else
		     (signal-invalid-syntax "a context")))))))
   (require-token => (signal-missing-token "`=>'" "context"))
   contexts))

(define (parse-single-context)
  (let ((class (class->ast)))
    (if (haskell98?)
	;; C a, or C t1 ... tn for a multi-parameter class
	(let ((types (parse-atype-list)))
	  (cond ((and (pair? types) (null? (cdr types)) (tyvar? (car types)))
		 (make context (class class) (tyvar (tyvar-name (car types)))))
		((and (pair? types) (pair? (cdr types)))
		 (**mp-context class types))
		;; C t, t not a type variable (FlexibleContexts): reduced
		;; to constraints on type variables by resolve-signature
		((pair? types)
		 (**mp-context class types))
		;; a nullary constraint (HasCallStack, a synonym of ()):
		;; expand-constraint-synonyms (util/signature.mumble)
		(else (**mp-context class '()))))
	(token-case
	  (tyvar
	   (let ((tyvar (token->symbol)))
	     (make context (class class) (tyvar tyvar))))
	  (else (signal-missing-token "<tyvar>" "class assertion"))))))

;;; The further tyvars of a multi-parameter class assertion, C a b.
(define (parse-more-context-tyvars)
  (if (and (eq-token? 'varid) (haskell98?))
      (let ((tyvar (token->symbol)))
	(cons tyvar (parse-more-context-tyvars)))
      '()))

;;; A context's one-parameter and multi-parameter assertions.
(define (split-contexts contexts)
  (let ((single '())
	(multi '()))
    (dolist (c contexts)
      ;; an equality (a ~ t) outside a signature is not kept
      (cond ((equality-assertion? c) '#f)
	    ((mp-context? c) (push c multi))
	    (else (push c single))))
    (values (nreverse single) (nreverse multi))))

(define (parse-contexts)
  (token-case
    (\) '())
    ((no-advance satisfies equality-assertion-ahead?)
     (let ((context (parse-equality-assertion)))
       (token-case
	(\, (cons context (parse-contexts)))
	(\) (list context))
	(else (signal-missing-token "`)' or `,'" "context")))))
    ;; QuantifiedConstraints: forall x. C x => D (t x) is PreludeModern's
    ;; QuantifiedConstraint of the polytype forall x. C x => D (t x), D
    ;; (t x) a constraint type (a class literal applied)
    ((no-advance satisfies forall-here?)
     (let* ((tyvars (skip-explicit-forall))
	    (premises (parse-optional-context))
	    (head (quantified-head (parse-btype))))
       (mlet (((single mp) (split-contexts premises)))
	 (let ((context (**mp-context (make class-ref (name '|%QC|) (class *undefined-def*))
				      (list (make forall-type (tyvars tyvars) (context single)
						  (mcontext mp) (type head))))))
	   (token-case
	    (\, (cons context (parse-contexts)))
	    (\) (list context))
	    (else (signal-missing-token "`)' or `,'" "context")))))))
    ;; ImplicitParams: ?x :: t is IP "x" t (PreludeModern's class)
    ((no-advance ipvar)
     (let ((name (car *token-args*)))
       (advance-token)
       (require-token \:\: (signal-missing-token "`::'" "implicit parameter"))
       (let ((context (**mp-context (make class-ref (name '|%IP|) (class *undefined-def*))
				    (list (ip-name-type name) (parse-type)))))
	 (token-case
	  (\, (cons context (parse-contexts)))
	  (\) (list context))
	  (else (signal-missing-token "`)' or `,'" "context"))))))
    (tycon (let ((context (parse-single-context)))
	      (token-case
		(\, (cons context (parse-contexts)))
		(\) (list context))
		(else (signal-missing-token "`)' or `,'" "context")))))
    (else (signal-missing-token "<tycon>" "class assertion"))))

(define (parse-optional-context)
  (if (has-optional-context?)
      (parse-context)
      '()))

(define (parse-signature)
  (if (parenthesized-qualified-type?)
      ;; (C a => t), a whole signature in parentheses (GHC; parsec's
      ;; alphaNum :: (Stream s m Char => ParsecT s u m Char))
      (begin
	(advance-token)
	(let ((sig (parse-signature)))
	  (require-token \) (signal-missing-token "`)'" "type signature"))
	  sig))
      (parse-signature-1)))

(define (parenthesized-qualified-type?)
  (and (haskell98?)
       (eq-token? '\()
       (let ((saved-excursion (save-scanner-state)))
	 (advance-token)
	 (let ((res (and (scan-for-context-arrow 0)
			 ;; the parentheses close the whole signature:
			 ;; (forall a. C a => a -> t) -> u is a rank-2 argument
			 (scan-to-close-paren 0)
			 ;; (and not a context: (forall x. C x => D (t x)) => ..)
			 (not (memq *token* '(-> => varid conid \( \[))))))
	   (restore-excursion saved-excursion)
	   res))))

(define (parse-signature-1)
  (let ((foralls (skip-explicit-forall)))
    (mlet (((assertions equalities) (split-equalities (parse-optional-context)))
	   ((contexts mcontexts) (split-contexts assertions))
	   (type (parse-type)))
      (apply-equalities
       equalities
       (make signature (context contexts) (type type) (mcontext mcontexts)
	     (foralls foralls))))))

;;; Equality constraints (GHC's ~, with GADTs or TypeFamilies):
;;; (a ~ b, C t a) => t -> (a -> b).  In a signature, a ~ t with a a type
;;; variable means a is t, so it is substituted into the type and the
;;; other assertions; an equality between two other types (F a ~ Int) is
;;; dropped, and the type checker does not see it.

(define (equality-assertion-ahead?)
  (and (haskell98?)
       (let ((saved (save-scanner-state)))
	 (let ((res (scan-for-tilde 0)))
	   (restore-excursion saved)
	   res))))

;;; Is there a ~ before the end of this assertion (a , ) or => outside
;;; brackets)?
(define (scan-for-tilde depth)
  (cond ((tilde-here?)
	 (eqv? depth 0))
	(else
	 (token-case
	  ((\( \[) (scan-for-tilde (1+ depth)))
	  ((\) \]) (and (> depth 0) (scan-for-tilde (1- depth))))
	  (\, (and (> depth 0) (scan-for-tilde depth)))
	  ((=> -> = \| \; \} |where| \:\: <- eof) '#f)
	  (else (advance-token) (scan-for-tilde depth))))))

;;; ~, or ~~ (heterogeneous equality, here the same), possibly qualified
;;; (Eq.~~, from Data.Type.Equality).
(define (tilde-here?)
  (or (eq? *token* '\~)
      (and (eq? *token* 'varsym) (equality-operator? (car *token-args*)))))

(define (equality-operator? s)
  (let ((op (let ((i (lisp:position #\. s :from-end '#t)))
	      (if (and i (> (string-length s) 0) (char-upper-case? (string-ref s 0)))
		  (substring s (1+ i) (string-length s))
		  s))))
    (or (string=? op "~") (string=? op "~~"))))

(define (parse-equality-assertion)
  (let ((left (parse-btype)))
    (if (tilde-here?)
	(advance-token)
	(signal-missing-token "`~'" "equality constraint"))
    (list 'equality left (parse-btype))))

(define (equality-assertion? c)
  (and (pair? c) (eq? (car c) 'equality)))

(define (split-equalities contexts)
  (values (lisp:remove-if (function equality-assertion?) contexts)
	  (lisp:remove-if-not (function equality-assertion?) contexts)))

;;; The substitutions made, (tuple name type), while recording (a
;;; class's default signature, tdecl/class.mumble's init-methods).
(define *recording-equalities?* '#f)
(define *recorded-equalities* '())

;;; Each default signature's substitutions: (tuple signature substitutions)
(define *default-sig-equalities* '())

;;; Every signature's substitutions: (tuple signature ((tuple name type)
;;; ..)), for a class method's equality on a class variable (IsBase t ~ b
;;; of Agda's killRangeN: tdecl/class.mumble).
(define *signature-equalities* '())

(define (record-signature-equality sig name type)
  (let ((e (assq sig *signature-equalities*)))
    (if e
	(setf (cdr e) (list (cons (tuple name type) (cadr e))))
	(push (list sig (list (tuple name type))) *signature-equalities*))))

(define (apply-equalities equalities sig)
  (dolist (e equalities)
    (let ((left (cadr e)) (right (caddr e)))
      (cond ((or (and (tyvar? left) (memq (tyvar-name left) (ast-tyvar-names right)))
		 (and (tyvar? right) (memq (tyvar-name right) (ast-tyvar-names left)))
		 (not (or (tyvar? left) (tyvar? right))))
	     ;; circular (SubstArg a ~ a), or between two other types (F a
	     ;; ~ Int): a TypeEquality constraint, kept when a side is a
	     ;; family's application (util/signature.mumble's
	     ;; keep-family-equalities)
	     (when (not (dynamic *recording-equalities?*))
	       (setf (signature-mcontext sig)
		     (append (signature-mcontext sig)
			     (list (**mp-context (make class-ref (name '|%TypeEq|)
						       (class *undefined-def*))
						 (list left right)))))))
	    ((tyvar? left)
	     (record-equality (tyvar-name left) right)
	     (record-signature-equality sig (tyvar-name left) right)
	     (substitute-signature sig (tyvar-name left) right))
	    ((tyvar? right)
	     (record-equality (tyvar-name right) left)
	     (record-signature-equality sig (tyvar-name right) left)
	     (substitute-signature sig (tyvar-name right) left)))))
  sig)

(define (record-equality name type)
  (when (dynamic *recording-equalities?*)
    (setf (dynamic *recorded-equalities*)
	  (cons (tuple name type) (dynamic *recorded-equalities*)))))

;;; The same for an instance (instance ann ~ Void => Pretty (Doc ann) is
;;; Pretty (Doc Void)): returns its contexts, multi-parameter contexts and
;;; head types with the equalities substituted.
(define (apply-equalities/instance equalities contexts mcontexts types)
  (let ((sig (make signature (context contexts) (mcontext mcontexts)
		   (type (**tycon/def (tuple-tycon (max 2 (length types)))
				      (if (null? (cdr types))
					  (list (car types) (car types))
					  types)))
		   (foralls '()))))
    (apply-equalities equalities sig)
    (let ((new (tycon-args (signature-type sig))))
      (values (signature-context sig) (signature-mcontext sig)
	      (if (null? (cdr types)) (list (car new)) new)))))

(define (substitute-signature sig name type)
  (let ((single '())
	(multi (map (lambda (c)
		      (**mp-context (mp-context-class c)
				    (map (lambda (ty) (substitute-tyvar ty name type))
					 (mp-context-types c))))
		    (signature-mcontext sig))))
    (dolist (c (signature-context sig))
      (if (eq? (context-tyvar c) name)
	  ;; C a with a := t: C t, reduced later (FlexibleContexts)
	  (push (**mp-context (context-class c) (list type)) multi)
	  (push c single)))
    (setf (signature-context sig) (reverse single))
    (setf (signature-mcontext sig) multi)
    (setf (signature-type sig) (substitute-tyvar (signature-type sig) name type))))

;;; forall a b . t (GHC's ExplicitForAll): the quantifier is implicit
;;; anyway.  In Haskell 98 forall is an ordinary name, but it cannot
;;; begin a type, so this changes no valid program.
;;; A quantified constraint's head D t1 .. tn as a type: the class D,
;;; unapplied (a class literal: top/symbol-table.mumble's resolve-tycon),
;;; applied to t1 .. tn.
(define (quantified-head type)
  (if (and (tycon? type) (not (null? (tycon-args type))))
      (make tyapp (fun (make tycon (name (tycon-name type)) (def *undefined-def*) (args '())))
	    (args (tycon-args type)))
      type))

(define (forall-here?)
  (and (haskell98?) (eq-token? 'varid) (string=? (car *token-args*) "forall")))

(define (skip-explicit-forall)
  (if (and (haskell98?) (eq-token? 'varid)
	   (string=? (car *token-args*) "forall"))
      (begin
	(advance-token)
	(skip-forall-tyvars))
      '()))

;;; The forall's type variables: a, or (a :: kind).  Returns their names.

(define (skip-forall-tyvars)
  (token-case
   ((no-advance varid)
    (let ((name (token->symbol)))
      (cons name (skip-forall-tyvars))))
   ((no-advance \()
    (advance-token)
    (let ((name (token->symbol)))
      (require-token \:\: (signal-missing-token "`::'" "forall kind signature"))
      (skip-kind)
      (cons name (skip-forall-tyvars))))
   ;; an inferred variable (GHC): {k} or {k :: kind}
   ((no-advance \{)
    (advance-token)
    (let ((name (token->symbol)))
      (when (eq-token? '\:\:)
	(advance-token)
	(do () ((or (eq-token? '\}) (eq-token? 'eof)))
	  (advance-token)))
      (require-token \} (signal-missing-token "`}'" "forall inferred variable"))
      (cons name (skip-forall-tyvars))))
   ((no-advance varsym)
    (if (string=? (car *token-args*) ".")
	(begin (advance-token) '())
	(signal-missing-token "`.'" "forall type")))
   (else (signal-missing-token "`.'" "forall type"))))


		 