;;; File: type-parser        Author: John

(define (parse-type)
  (let ((type (parse-btype)))
    (token-case
      (->
       (**tycon/def (core-symbol "Arrow") (list type (parse-type))))
      (else type))))

(define (parse-btype)
  (token-case
   (tycon (let* ((tycon (tycon->ast))
		 (tycon-args (parse-atype-list)))
	    (setf (tycon-args tycon) tycon-args)
	    tycon))
   (tyvar (let* ((var (tyvar->ast))
		 (args (parse-atype-list)))
	    (if (null? args)
		var
		(**tyapp var args))))
   (else
    (let* ((type (parse-atype))
	   (args (parse-atype-list)))
      (if (and (not (null? args)) (tycon? type))
	  (apply-ast-type type args)   ; `(->) r', `[] a', `(,) a b'
	  type)))))

(define (parse-atype-list)
  (token-case
    (atype-start
     (let ((atype (parse-atype)))
       (cons atype (parse-atype-list))))
    (else '())))

(define (parse-atype)
  (token-case
    (tyvar (tyvar->ast))
    (tycon (tycon->ast))
    (\( (token-case
	  (\) (**tycon/def (core-symbol "UnitType") '()))
	  (-> (require-token \) (signal-missing-token "`)'" "type expression"))
	      (**tycon/def (core-symbol "Arrow") '()))
	  (\, (let ((n 2))
		(token-case-loop-commas n)))
	  (else
	    (let ((type (parse-type)))
	      (token-case
	       (\) type)
	       ;; KindSignatures (GHC): (t :: kind); the kind is inferred
	       (\:\: (skip-kind) type)
	       (\, (let ((types  (cons type (parse-type-list))))
		     (**tycon/def (tuple-tycon (length types)) types)))
	       (else
		(signal-missing-token "`)' or `,'" "type expression")))))))
    (\[ (token-case
	  (\] (**tycon/def (core-symbol "List") '()))
	  (else
	   (let ((type (parse-type)))
	     (require-token \] (signal-missing-token "`]'" "type expression"))
	     (**tycon/def (core-symbol "List") (list type))))))
    (else
     (signal-invalid-syntax "an atype"))))

;;; The rest of a parenthesised kind signature, through its `)': a kind
;;; (*, Type, k -> k, Constraint, ...) is not checked.

(define (skip-kind)
  (skip-kind-1 0))

(define (skip-kind-1 depth)
  (token-case
   (\( (skip-kind-1 (1+ depth)))
   (\) (when (> depth 0) (skip-kind-1 (1- depth))))
   (eof (signal-missing-token "`)'" "kind signature"))
   (else (advance-token) (skip-kind-1 depth))))

;;; `(,' has been read; count the commas up to the `)' of `(,,)'.
(define (token-case-loop-commas n)
  (token-case
    (\, (token-case-loop-commas (1+ n)))
    (\) (**tycon/def (tuple-tycon n) '()))
    (else (signal-missing-token "`)' or `,'" "type expression"))))

(define (parse-type-list)
  (let ((type (parse-type)))
    (token-case (\, (cons type (parse-type-list)))
		(\) (list type))
		(else (signal-missing-token "`)' or `,'" "type expression")))))

;;; This is used to determine whether a type is preceded by a context

(define (has-optional-context?)
  (let* ((saved-excursion (save-scanner-state))
	 (res (if (haskell98?)
		  (scan-for-context-arrow 0)
		  (has-optional-context-1.2?))))
    (restore-excursion saved-excursion)
    res))

;;; Haskell 98: a context is everything before a `=>' outside brackets;
;;; the tokens that end a type (or cannot be in a context) stop the
;;; search.
(define (scan-for-context-arrow depth)
  (token-case
   (=> (eqv? depth 0))
   ((\( \[) (scan-for-context-arrow (1+ depth)))
   ((\) \]) (and (> depth 0) (scan-for-context-arrow (1- depth))))
   ((-> = \| \; \} |where| \:\: <- eof) '#f)
   (else (advance-token) (scan-for-context-arrow depth))))

(define (has-optional-context-1.2?)
  (let* ((res (token-case
		(conid
		 (token-case
		  (varid (scan-more-context-tyvars))
		  (else '#f)))
		;; () => t: the empty context (H98 4.1.3, n = 0)
		(\( (token-case
		      (\) (eq-token? '=>))
		      (else (scan-context))))
		(else '#f))))
    res))

(define (scan-context)
  (token-case
    (conid
     (token-case
       (varid
	 (scan-context-rest))
       (else '#f)))
    (else '#f)))

;;; After the first tyvar of an assertion in parentheses: more tyvars (a
;;; multi-parameter class), then `)' or `,'.
(define (scan-context-rest)
  (token-case
    (varid (and (haskell98?) (scan-context-rest)))
    (\) (eq-token? '=>))
    (\, (scan-context))
    (else '#f)))

;;; After C a without parentheses: more tyvars (C a b), then `=>'.
(define (scan-more-context-tyvars)
  (token-case
    (varid (and (haskell98?) (scan-more-context-tyvars)))
    (else (eq-token? '=>))))

(define (parse-context)
 (let ((contexts (token-case
	           (tycon
		    (list (parse-single-context)))
		   (\( (parse-contexts))
		   (else
		    (signal-invalid-syntax "a context")))))
   (require-token => (signal-missing-token "`=>'" "context"))
   contexts))

(define (parse-single-context)
  (let ((class (class->ast)))
    (if (haskell98?)
	;; C a, or C t1 ... tn for a multi-parameter class
	(let ((types (parse-atype-list)))
	  (cond ((and (pair? types) (null? (cdr types)) (tyvar? (car types)))
		 (make context (class class) (tyvar (tyvar-name (car types)))))
		((and (pair? types) (pair? (cdr types)))
		 (**mp-context class types))
		;; C t, t not a type variable (FlexibleContexts): reduced
		;; to constraints on type variables by resolve-signature
		((pair? types)
		 (**mp-context class types))
		(else (signal-missing-token "<tyvar>" "class assertion"))))
	(token-case
	  (tyvar
	   (let ((tyvar (token->symbol)))
	     (make context (class class) (tyvar tyvar))))
	  (else (signal-missing-token "<tyvar>" "class assertion"))))))

;;; The further tyvars of a multi-parameter class assertion, C a b.
(define (parse-more-context-tyvars)
  (if (and (eq-token? 'varid) (haskell98?))
      (let ((tyvar (token->symbol)))
	(cons tyvar (parse-more-context-tyvars)))
      '()))

;;; A context's one-parameter and multi-parameter assertions.
(define (split-contexts contexts)
  (let ((single '())
	(multi '()))
    (dolist (c contexts)
      (if (mp-context? c) (push c multi) (push c single)))
    (values (nreverse single) (nreverse multi))))

(define (parse-contexts)
  (token-case
    (\) '())
    (tycon (let ((context (parse-single-context)))
	      (token-case
		(\, (cons context (parse-contexts)))
		(\) (list context))
		(else (signal-missing-token "`)' or `,'" "context")))))
    (else (signal-missing-token "<tycon>" "class assertion"))))

(define (parse-optional-context)
  (if (has-optional-context?)
      (parse-context)
      '()))

(define (parse-signature)
  (skip-explicit-forall)
  (mlet (((contexts mcontexts) (split-contexts (parse-optional-context)))
	 (type (parse-type)))
    (make signature (context contexts) (type type) (mcontext mcontexts))))

;;; forall a b . t (GHC's ExplicitForAll): the quantifier is implicit
;;; anyway.  In Haskell 98 forall is an ordinary name, but it cannot
;;; begin a type, so this changes no valid program.
(define (skip-explicit-forall)
  (when (and (haskell98?) (eq-token? 'varid)
	     (string=? (car *token-args*) "forall"))
    (advance-token)
    (skip-forall-tyvars)))

(define (skip-forall-tyvars)
  (token-case
   (varid (skip-forall-tyvars))
   ((no-advance varsym)
    (if (string=? (car *token-args*) ".")
	(advance-token)
	(signal-missing-token "`.'" "forall type")))
   (else (signal-missing-token "`.'" "forall type"))))


		 