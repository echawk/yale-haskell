;;; File: parser/lexer    Author: John

;;; token data structure: a list with the token type in the
;;; car and other information in the rest of the list.  Symbols
;;; designate the token type.

;;; Reserved tokens use the name as the type and have no args.
;;; Reserved tokens:
;;;  case class data default deriving else hiding if import in infix
;;;  infixl infixr instance interface let module of renaming then to
;;;  type where .. :: => = @ \ | ~ <- -> `
;;; Other tokens:
;;;  (file string)
;;;  (newline line indent-column)
;;;  (conid string)
;;;  (varid string)
;;;  (consym string)
;;;  (varsym string)
;;;  (comment string) ;;; not used at the moment
;;;  (integer integer)
;;;  (float integer fraction exponent) 
;;;  (string string)
;;;  (eof)


;;; *** All of the stuff for lexing character and string literals is
;;; *** broken because it assumes that the host Lisp uses the ASCII
;;; *** encoding for characters and supports at least 255 characters.
;;; *** I have marked the specific places in the code where these
;;; *** assumptions are made, but fixing the problem will probably
;;; *** require more drastic changes anyway -- such as using integers
;;; *** instead of characters and vectors of integers instead of characters
;;; *** throughout the compiler.

;;; Highest character code: Unicode in Haskell 98, Latin-1 in 1.2.

(define (max-char-code)
  (if (feature? 'h98-lexing) #x10FFFF 255))

;;; Characters beyond ASCII in Haskell 98 source (report 2.2):
;;; letters (lower- or uncased: small; upper: large), symbols and
;;; punctuation (symbol), space separators (whitechar), and any printable
;;; character in literals (graphic).  The char-case classes call these
;;; (parser-macros.mumble); C may be the end-of-file object.

(define (uni-char? c)
  (and (char? c) (> (char->integer c) 127) (feature? 'h98-lexing)))

(define (uni-small-char? c)
  (and (uni-char? c) (lisp:alpha-char-p c) (not (lisp:upper-case-p c))))

(define (uni-large-char? c)
  (and (uni-char? c) (lisp:upper-case-p c)))

(define (uni-symbol-char? c)
  (and (uni-char? c)
       (memq (char-general-category c) '(:Sm :Sc :Sk :So :Pd :Po))))

(define (uni-white-char? c)
  (and (uni-char? c)
       (eq? (char-general-category c) ':Zs)))

(define (uni-graphic-char? c)
  (and (uni-char? c) (lisp:graphic-char-p c)))

;;; This defines the long names of the control chars.  Note that some of
;;; this duplicates the table above & the reader.

(define *control-char-names* '(
  ("NUL" . 0) ("SOH" . 1) ("STX" . 2) ("ETX" . 3)
  ("EOT" . 4) ("ENQ" . 5) ("ACK" . 6) ("BEL" . 7)
  ("BS" . 8) ("HT" . 9) ("LF" . 10) ("VT" . 11)
  ("FF" . 12) ("CR" . 13) ("SO" . 14) ("SI" . 15)
  ("DLE" . 16) ("DC1" . 17) ("DC2" . 18) ("DC3" . 19)
  ("DC4" . 20) ("NAK" . 21) ("SYN" . 22) ("ETB" . 23)
  ("CAN" . 24) ("EM" . 25) ("SUB" . 26) ("ESC" . 27)
  ("FS" . 28) ("GS" . 29) ("RS" . 30) ("US" . 31)
  ("SP" . 32) ("DEL" . 127)))

;;; This defines the short names for a few control chars.  This
;;; is keyed off the previous table

(define *short-control-char-names* '(
   (#\a . "BEL")    (#\b . "BS")    (#\f . "FF")    (#\n . "LF")
   (#\r . "CR") (#\t . "HT") (#\v . "VT")))

;;; This is used in the ^X construct.  Assume that ^X = code for ^A + X-A
;;; *** This is an invalid assumption.

(define *control-A* 1)

;;; This function is the interface between the lexer and the rest
;;; of the system.  Note that the `file' reported in error messages
;;; must be bound in an outer context.


;;; *** I think this function should be binding these variables and not
;;; *** just assigning them.

;;; TemplateHaskell: how many quotes are open ([| ... |], lex-one-token)
(define *quote-depth* 0)

(define (lex-port port literate?)
  (setf *lex-literate?* literate?)
  (setf *quote-depth* 0)
  (setf *current-line* 1)
  (setf *current-col* 0)
  (setf *on-new-line?* '#t)
  (setf *save-col?* '#f)
  (setf *port* port)
  (setf *tokens* '())
  (setf *char* (lex-read-char *port*))
  (setf *peek-char* (lex-read-char *port*))
  (when (eof-object? *char*)
	(setf *char* '#\space))
  (when (eof-object? *peek-char*)
	(setf *peek-char* '#\space))
  (setf *at-eof/p?* '#f)
  (setf *at-eof?* '#f)
  (when *lex-literate?*
     (process-literate-comments '#t))
  (parse-till-eof)
  (nreverse *tokens*))

(define (parse-till-eof)
  (cond (*at-eof?*
	 (emit-token 'eof)
	 '())
	(else
	 (lex-one-token)
	 (parse-till-eof))))

;;; CRLF line ends (a file from Windows) read as newlines.

(define (lex-read-char port)
  (let ((c (read-char port)))
    (if (and (eqv? c #\return) (eqv? (lisp:peek-char '#f port '#f) #\newline))
	(read-char port)
	c)))

;;; There is an assumption that the scanner never peeks beyond a newline.
;;; In literate mode, this may reveal the wrong thing.

(define (advance-char)
  (if (and *lex-literate?* (eqv? *char* #\newline))
      (process-literate-comments '#f)
      (advance-char-1)))

(define (advance-char-1)
  (setf *prev-char* *char*)
  (cond ((eqv? *char* #\newline)
	 (setf *on-new-line?* '#t)
	 (incf (the fixnum *current-line*))
	 (setf *current-col* 0))
	((eqv? *char* #\tab)
	 (incf (the fixnum *current-col*) (- 8 (modulo *current-col* 8))))
	(else
	 (incf (the fixnum *current-col*))))
  (setf *char* *peek-char*)
  (setf *at-eof?* *at-eof/p?*)
  (setf *peek-char* (lex-read-char *port*))
  (when (eof-object? *peek-char*)
     (setf *at-eof/p?* '#t)
     (setf *peek-char* '#\space))
  *char*)

(define (peek-char-2)
  (let ((ch (peek-char *port*)))
    (if (eof-object? ch)
	'#\space
	ch)))

(define (lex-one-token)
 (setf *start-line* *current-line*) ; capture the loc at the start of the token
 (setf *start-col* *current-col*)
 (setf *char-before-token* *prev-char*)
 (unless *at-eof?*
  (char-case *char*
    (whitechar
     (advance-char)
     (lex-one-token))
    (#\- (char-case *peek-char*
	    (#\- (if (feature? 'h98-lexing) (lex-varsym) (lex-comment)))
	    (#\> (cond ((feature? 'h98-lexing)
			(lex-varsym))
		       (else
			(advance-char)
			(advance-char)
			(emit-token '\-\>))))
	    (#\} (signal-missing-begin-comment)
		 (advance-char)
		 (advance-char)
		 (lex-one-token))
	    (digit
	     (if (negative-literal-here?)
		 (lex-negative-literal)
		 (begin
		   (setf *minus-was-prefix?*
			 (or (not *char-before-token*)
			     (char-whitespace? *char-before-token*)
			     (memv *char-before-token* '(#\( #\[ #\, #\;))))
		   (lex-varsym))))
	    (else
	     (lex-varsym))))
    (#\{ (cond ((char=? *peek-char* '#\-)
		(advance-char)
		(advance-char)
		(cond ((char=? *char* '#\#)
		       (advance-char)
		       (lex-pragma))
		      (else
		       (lex-ncomment)
		       (lex-one-token))))
	       (else
		(advance-char)
		(emit-token '\{ ))))
    (small (lex-varid))
    (large (lex-conid))
    (#\( (advance-char)
	 ;; UnboxedTuples (GHC): (# ... #) is an ordinary tuple
	 (when (and (char=? *char* #\#)
		    (not (char=? *peek-char* #\)))
		    (language-extension? "UnboxedTuples"))
	   (advance-char))
	 (emit-token '\())
    (#\: (lex-consym))
    (#\` (advance-char)
	 (emit-token '\`))
    ((symbol presymbol)
     (cond ((and (char=? *char* #\#) (char=? *peek-char* #\))
		 (language-extension? "UnboxedTuples"))
	    (advance-char) (advance-char) (emit-token '\)))
	   ((record-dot-here?)
	    (lex-record-dot))
	   ;; OverloadedLabels: #foo is (GHC.OverloadedLabels.fromLabel @"foo")
	   ((and (char=? *char* #\#)
		 (or (char-lower-case? *peek-char*) (char=? *peek-char* #\_))
		 (not (and (char? *char-before-token*)
			   (or (char-alphabetic? *char-before-token*)
			       (char-numeric? *char-before-token*)
			       (memv *char-before-token* '(#\_ #\' #\))))))
		 (language-extension? "OverloadedLabels"))
	    (advance-char)
	    (let ((name (list->string (scan-var-con))))
	      (emit-token '\()
	      (emit-token 'varid "GHC.OverloadedLabels.fromLabel")
	      (emit-token '@)
	      (emit-token 'string name)
	      (emit-token '\))))
	   ;; ImplicitParams: ?x is one token
	   ((and (char=? *char* #\?)
		 (or (char-lower-case? *peek-char*) (char=? *peek-char* #\_))
		 (language-extension? "ImplicitParams"))
	    (advance-char)
	    (emit-token/string 'ipvar (scan-var-con)))
	   ((and (> *quote-depth* 0) (char=? *char* #\|) (char=? *peek-char* #\]))
	    ;; the end of a quote
	    (advance-char) (advance-char)
	    (decf *quote-depth*)
	    (emit-token 'close-quote))
	   ((and (> *quote-depth* 0) (char=? *char* #\|) (char=? *peek-char* #\|)
		 (char=? (peek-char-2) #\]))
	    ;; the end of a typed quote
	    (advance-char) (advance-char) (advance-char)
	    (decf *quote-depth*)
	    (emit-token 'close-quote))
	   ((typed-splice-here?)
	    ;; typed Template Haskell: $$(c) and $$c
	    (advance-char) (advance-char)
	    (if (char=? *char* #\()
		(begin (advance-char) (emit-token 'typed-splice-paren))
		(emit-token 'typed-splice-var)))
	   ((splice-here?)
	    ;; TemplateHaskell: $(e) and $x (the variable is the next token)
	    (advance-char)
	    (if (char=? *char* #\()
		(begin (advance-char) (emit-token 'splice-paren))
		(emit-token 'splice-var)))
	   (else
	    (lex-varsym))))
    (digit (let ((before *char-before-token*))
	     (lex-numeric)
	     ;; MagicHash: 1#, 2.0## are the literals 1, 2.0, and -1# is
	     ;; one negative literal when the - is a prefix (after a space
	     ;; or an opening bracket) right before the digits
	     (when (and (char=? *char* #\#) (language-extension? "MagicHash"))
	       (do () ((not (char=? *char* #\#))) (advance-char))
	       ;; ExtendedLiterals: 42#Int8, 0xff#Word: the type's name
	       ;; is dropped (unboxed types are the boxed ones here)
	       (when (and (char-upper-case? *char*)
			  (language-extension? "ExtendedLiterals"))
		 (do () ((not (or (char-alphabetic? *char*) (char-numeric? *char*))))
		   (advance-char)))
	       (let ((num  (car *tokens*))
		     (prev (and (pair? (cdr *tokens*)) (cadr *tokens*))))
		 (when (and (eqv? before #\-)
			    *minus-was-prefix?*
			    (pair? prev) (eq? (car prev) 'varsym)
			    (equal? (cadr prev) "-")
			    (memq (car num) '(integer float)))
		   (setf (cadr num) (- (cadr num)))
		   (setf *tokens* (cons num (cddr *tokens*))))))))
    (#\' (if (name-quote-here?)
	     ;; TemplateHaskell: 'f, 'C, '(:) and ''T are names (Name values);
	     ;; in a type, the parser reads the tick as DataKinds' promotion
	     (begin
	       (advance-char)
	       (if (char=? *char* #\')
		   (begin (advance-char) (emit-token 'type-name-quote))
		   (begin
		     (emit-token 'name-quote)
		     (when (char-upper-case? *char*)
		       (lex-one-token)
		       (let ((tok  (car *tokens*)))
			 (when (eq? (car tok) 'conid)
			   (push (cadr tok) *promoted-names*)))))))
	 (if (promotion-tick?)
	     ;; DataKinds (GHC): 'Z in a type is the promoted Z
	     (begin (advance-char)
		    ;; '[ starts a promoted list, which [ alone may not
		    (when (char=? *char* #\[)
		      (emit-token 'promoted-tick))
		    (lex-one-token)
		    (let ((tok  (car *tokens*)))
		      (when (eq? (car tok) 'conid)
			(push (cadr tok) *promoted-names*))))
	     (begin
	       (lex-char)
	       ;; MagicHash: 'c'# is the Char# literal, the character
	       (when (and (char=? *char* #\#) (language-extension? "MagicHash"))
		 (advance-char))))))
    (#\" (if (and (char=? *peek-char* #\") (char=? (peek-char-2) #\")
		  (language-extension? "MultilineStrings"))
	     (lex-multiline-string)
	     (lex-string))
	 ;; MagicHash: "..."# is an Addr# literal, (GHC.Exts.addrLit# "...")
	 (when (and (char=? *char* #\#) (language-extension? "MagicHash"))
	   (advance-char)
	   (let ((str (car *tokens*)))
	     (setf *tokens* (cdr *tokens*))
	     (emit-token '\()
	     (emit-token 'varid "GHC.Exts.addrLit#")
	     (push str *tokens*)
	     (emit-token '\)))))
    (#\) (advance-char)
	 (emit-token '\)))
    (#\, (advance-char)
	 (emit-token '\,))
    (#\; (advance-char)
	 (emit-token '\;))
    (#\[ (let ((kind (quote-bracket-here?))
	       (qq (quasi-quote-here?)))
	   (cond
	    (qq
	     ;; QuasiQuotes: [quoter|text|]
	     (lex-quasi-quote qq))
	    ((eq? kind 'open-typed-quote)
	     ;; [||
	     (advance-char) (advance-char) (advance-char)
	     (incf *quote-depth*)
	     (emit-token kind))
	    (kind
	       ;; TemplateHaskell: [| [e| [p| [t| open a quote
	       (begin
		 (advance-char)
		 (when (not (char=? *char* #\|)) (advance-char))
		 (advance-char)
		 (incf *quote-depth*)
		 (emit-token kind)))
	    (else (advance-char)
		  (emit-token '\[)))))
    (#\] (advance-char)
	 (emit-token '\]))
    ;; `_' alone is the wildcard; followed by identifier characters it
    ;; begins a variable (H98: small includes `_'), e.g. _1, _foo
    (#\_ (if (and (feature? 'h98-lexing)
		  (or (char-alphabetic? *peek-char*) (char-numeric? *peek-char*)
		      (char=? *peek-char* #\_) (char=? *peek-char* #\')))
	     (lex-varid)
	     (begin (advance-char)
		    (emit-token '\_))))
    (#\} (advance-char)
	 (emit-token '\}))
    (else
     (signal-invalid-character *char*)
     (advance-char)
     (lex-one-token)))))

;;; `{-#' has been scanned.  Yale annotations ({-# f :: Inline #-},
;;; {-#STRICT#-}, {-# Prelude #-}, ...) go to the annotation parser.
;;; Haskell 98 style pragmas are named by an all-capitals word: INLINE
;;; is passed on to the annotation parser, which maps it onto Yale's
;;; Inline annotation; every other such pragma (NOINLINE, SPECIALIZE,
;;; LANGUAGE, ...) is skipped like a comment, as the report says unknown
;;; pragmas should be.  STRICT is a Yale annotation, not a pragma.

(define (lex-pragma)
  (skip-blanks-on-line)
  (char-case *char*
    (large
     (let ((word (scan-var-con)))
       (cond ((and (string=/list? word "INLINE") (inline-of-constructor?))
	      ;; of a pattern synonym ({-# INLINE Zeroy #-}): not Yale's
	      (skip-pragma *current-line*))
	     ((string=/list? word "INLINE")
	      (emit-token 'begin-annotation)
	      (emit-token/string 'conid word))
	     ((string=/list? word "LINE")
	      (lex-line-pragma))
	     ;; import {-# SOURCE #-} M (module-parser.mumble's parse-import)
	     ((and (string=/list? word "SOURCE")
		   (pair? *tokens*) (eq? (car (car *tokens*)) '|import|))
	      (skip-pragma *current-line*)
	      (emit-token 'source-pragma))
	     ((string-ci=? (list->string word) "LANGUAGE")
	      (lex-language-pragma))
	     ((or (string=/list? word "OPTIONS") (string=/list? word "OPTIONS_GHC"))
	      (lex-options-pragma))
	     ((and (pragma-word? word)
		   (not (string=/list? word "STRICT")))
	      (skip-pragma *current-line*))
	     (else
	      (emit-token 'begin-annotation)
	      (emit-token/string 'conid word)))))
    ;; GHC's pragma names are case-insensitive ({-# inline f #-}); a
    ;; lowercase word that is not one begins a Yale annotation (f :: ...)
    (small
     (let ((word (scan-var-con)))
       (skip-blanks-on-line)
       (cond ((char=? *char* #\:)
	      (emit-token 'begin-annotation)
	      (emit-token/string 'varid word))
	     ((and (string-ci=? (list->string word) "inline") (inline-of-constructor?))
	      (skip-pragma *current-line*))
	     ((string-ci=? (list->string word) "inline")
	      (emit-token 'begin-annotation)
	      (emit-token/string 'conid (string->list "INLINE")))
	     ((mem-string-ci (list->string word)
			     '("noinline" "inlinable" "inlineable" "specialize"
			       "specialise" "rules" "complete" "scc" "ann"
			       "opaque" "minimal" "overlapping" "overlappable"
			       "overlaps" "incoherent" "unpack" "nounpack"
			       "deprecated" "warning"))
	      (skip-pragma *current-line*))
	     ((string-ci=? (list->string word) "language")
	      (lex-language-pragma))
	     ((mem-string-ci (list->string word) '("options" "options_ghc"))
	      (lex-options-pragma))
	     ((mem-string-ci (list->string word) '("options_haddock" "include"))
	      (skip-pragma *current-line*))
	     (else
	      (emit-token 'begin-annotation)
	      (emit-token/string 'varid word)))))
    (else
     (emit-token 'begin-annotation))))

;;; After INLINE (blanks skipped): a capitalized name or a constructor
;;; operator, a pattern synonym's.
(define (inline-of-constructor?)
  (skip-blanks-on-line)
  (or (char-upper-case? *char*)
      (and (char=? *char* #\() (char=? *peek-char* #\:))))

(define (mem-string-ci s strings)
  (lisp:member s strings :test (function string-ci=?)))

;;; {-# LANGUAGE E1, E2 #-}: the extensions are recorded for the parser
;;; (*language-extensions*, language-extension?) and the module (its
;;; extensions slot); the pragma is otherwise a comment.

(define *language-extensions* '())

(define (language-extension? name)
  (mem-string name (dynamic *language-extensions*)))

;;; Turn on the extensions NAMES (a LANGUAGE pragma's, -X's, a package's):
;;; a language name (GHC2021, GHC2024, Haskell2010, Haskell98) stands for
;;; its extensions and is kept too; NoE turns E off.

(define (add-language-extensions names)
  (dolist (name names)
    (let ((off  (no-extension-name name)))
      (if off
	  (begin
	    (setf (dynamic *language-extensions*)
		  (lisp:remove off (dynamic *language-extensions*)
			       :test (function string=?)))
	    ;; (NoMonoLocalBinds kept: it overrides TypeFamilies' and GADTs'
	    ;; implied MonoLocalBinds, type-decl.mumble's mono-local-binds-module?)
	    (when (string=? off "MonoLocalBinds")
	      (push name (dynamic *language-extensions*))))
	  (begin
	    (when (string=? name "MonoLocalBinds")
	      (setf (dynamic *language-extensions*)
		    (lisp:remove "NoMonoLocalBinds" (dynamic *language-extensions*)
				 :test (function string=?))))
	    (add-language-extensions (language-standard-extensions name))
	    (push name (dynamic *language-extensions*)))))))

;;; E for NoE (but not for NondecreasingIndentation).
(define (no-extension-name name)
  (and (> (string-length name) 2)
       (string-starts? "No" name)
       (char-upper-case? (string-ref name 2))
       (substring name 2 (string-length name))))

;;; The extensions of a language standard, as GHC's users guide lists them
;;; (control.html); '() for another name.  Yale Haskell has no CUSKs
;;; switch, and turns on some of these always.

(define *haskell2010-extensions*
  '("ImplicitPrelude" "StarIsType" "MonomorphismRestriction"
    "TraditionalRecordSyntax" "EmptyDataDecls" "ForeignFunctionInterface"
    "PatternGuards" "DoAndIfThenElse" "FieldSelectors" "RelaxedPolyRec"
    "DatatypeContexts"))

(define *ghc2021-extensions*
  '("BangPatterns" "BinaryLiterals" "ConstrainedClassMethods"
    "ConstraintKinds" "DeriveDataTypeable" "DeriveFoldable" "DeriveFunctor"
    "DeriveGeneric" "DeriveLift" "DeriveTraversable" "DoAndIfThenElse"
    "EmptyCase" "EmptyDataDecls" "EmptyDataDeriving"
    "ExistentialQuantification" "ExplicitForAll" "FieldSelectors"
    "FlexibleContexts" "FlexibleInstances" "ForeignFunctionInterface"
    "GADTSyntax" "GeneralisedNewtypeDeriving" "GeneralizedNewtypeDeriving"
    "HexFloatLiterals" "ImplicitPrelude" "ImportQualifiedPost" "InstanceSigs"
    "KindSignatures" "MonomorphismRestriction" "MultiParamTypeClasses"
    "NamedFieldPuns" "NamedWildCards" "NumericUnderscores" "PatternGuards"
    "PolyKinds" "PostfixOperators" "RankNTypes" "RelaxedPolyRec"
    "ScopedTypeVariables" "StandaloneDeriving" "StandaloneKindSignatures"
    "StarIsType" "TraditionalRecordSyntax" "TupleSections"
    "TypeApplications" "TypeOperators" "TypeSynonymInstances"))

(define *ghc2024-extensions*
  '("DataKinds" "DerivingStrategies" "DisambiguateRecordFields"
    "ExplicitNamespaces" "GADTs" "MonoLocalBinds" "LambdaCase"
    "RoleAnnotations"))

(define (language-standard-extensions name)
  (cond ((string=? name "GHC2024")
	 (append *ghc2021-extensions* *ghc2024-extensions*))
	((string=? name "GHC2021") *ghc2021-extensions*)
	((string=? name "Haskell2010") *haskell2010-extensions*)
	((string=? name "Haskell98")
	 '("ImplicitPrelude" "StarIsType" "MonomorphismRestriction"
	   "TraditionalRecordSyntax" "FieldSelectors" "NPlusKPatterns"
	   "NondecreasingIndentation" "DatatypeContexts"))
	(else '())))

;;; The extensions every module starts with that is not an installed
;;; package's: --ghc2021, --ghc2024, -X (src/cli/cli.lisp).
(define *default-language-extensions* '())

(define (lex-language-pragma)
  (let ((chars '()))
    (do ()
	((or *at-eof?*
	     (and (char=? *char* #\#) (char=? *peek-char* #\-)
		  (char=? (peek-char-2) #\}))))
      (push *char* chars)
      (advance-char))
    (add-language-extensions (split-extension-names (list->string (reverse chars))))
    (skip-pragma *current-line*)))

;;; {-# OPTIONS -XMagicHash -XBangPatterns -cpp #-} (and OPTIONS_GHC), the
;;; older way to turn extensions on (Happy's output uses it): each -X flag
;;; is an extension, as in a LANGUAGE pragma; other flags are ignored.

(define (lex-options-pragma)
  (let ((chars '()))
    (do ()
	((or *at-eof?*
	     (and (char=? *char* #\#) (char=? *peek-char* #\-)
		  (char=? (peek-char-2) #\}))))
      (push *char* chars)
      (advance-char))
    (dolist (flag (split-extension-names (list->string (reverse chars))))
      (when (and (> (string-length flag) 2) (string-starts? "-X" flag))
	(add-language-extensions (list (substring flag 2 (string-length flag))))))
    (skip-pragma *current-line*)))

(define (split-extension-names text)
  (let ((names '())
	(current '()))
    (dolist (c (string->list text))
      (if (or (char=? c #\,) (char-whitespace? c))
	  (when (not (null? current))
	    (push (list->string (reverse current)) names)
	    (setf current '()))
	  (push c current)))
    (when (not (null? current))
      (push (list->string (reverse current)) names))
    (reverse names)))

;;; {-# LINE n "file" #-}: the next line is line n.  The C preprocessor
;;; (cpp.mumble) puts these around an #include's text, so that the lines
;;; after it keep their numbers.  The file name is not used.

(define (lex-line-pragma)
  (skip-blanks-on-line)
  (let ((n  0))
    (do ()
	((or *at-eof?* (not (char-numeric? *char*))))
      (setf n (+ (* n 10) (char->digit *char* 10)))
      (advance-char))
    (skip-pragma-text *current-line*)
    ;; the newline after the pragma makes it n
    (setf *current-line* (1- n))
    (lex-one-token)))

(define (skip-pragma-text start-line)
  (cond (*at-eof?*
	 (lexer-eof-in-comment start-line))
	((and (char=? *char* #\#)
	      (char=? *peek-char* #\-)
	      (char=? (peek-char-2) #\}))
	 (advance-char)
	 (advance-char)
	 (advance-char))
	(else
	 (advance-char)
	 (skip-pragma-text start-line))))

(define (skip-blanks-on-line)
  (when (and (not *at-eof?*)
	     (or (char=? *char* #\space) (char=? *char* #\tab)))
    (advance-char)
    (skip-blanks-on-line)))

;;; Two or more characters, all capitals, digits or underscores.

(define (pragma-word? word)
  (and (pair? (cdr word))
       (or (pragma-word-1? word)
	   ;; GHC's pragma names are not case-sensitive ({-# Language CPP #-})
	   ;; (filelock's {-# UNPACk #-})
	   (mem-string (lisp:string-upcase (list->string word))
		       '("LANGUAGE" "OPTIONS" "OPTIONS_GHC" "OPTIONS_HADDOCK"
			 "INCLUDE" "NOINLINE" "INLINABLE" "INLINEABLE"
			 "SPECIALIZE" "SPECIALISE" "RULES" "COMPLETE" "SCC"
			 "ANN" "OPAQUE" "MINIMAL" "OVERLAPPING" "OVERLAPPABLE"
			 "OVERLAPS" "INCOHERENT" "UNPACK" "NOUNPACK"
			 "DEPRECATED" "WARNING")))))

(define (pragma-word-1? word)
  (or (null? word)
      (and (char-case (car word)
	     ((large digit #\_) '#t)
	     (else '#f))
	   (pragma-word-1? (cdr word)))))

(define (skip-pragma start-line)
  (cond (*at-eof?*
	 (lexer-eof-in-comment start-line))
	((and (char=? *char* #\#)
	      (char=? *peek-char* #\-)
	      (char=? (peek-char-2) #\}))
	 (advance-char)
	 (advance-char)
	 (advance-char)
	 ;; (first on its line: the next token takes its column)
	 (when (and *on-new-line?* (not *pragma-line-col*))
	   (setf *pragma-line-col* (cons *start-line* *start-col*)))
	 (lex-one-token))
	(else
	 (advance-char)
	 (skip-pragma start-line))))

(define (signal-missing-begin-comment)
  (lexer-error 'missing-begin-comment
	       "`-}' appears outside of a nested comment."))

(define (signal-invalid-character ch)
  (lexer-error 'invalid-character 
	       "Invalid character `~a' appears in source program." ch))

(define (advance-past-white)
  (unless *at-eof?*
    (char-case *char*
      (whitechar
        (advance-char)
	(advance-past-white))
      (else
       '()))))

(define (process-literate-comments at-start?)
  (unless at-start? (advance-char-1))
  (let ((l (classify-line)))
    (cond ((or *at-eof?* (eq? l 'program))
	   '())
	  ((eq? l 'blank)
	   (skip-literate-comment '#t))
	  (else
	   (when (not at-start?)
		 (lexer-error 'blank-line-needed
		    "Literate comments must be preceeded by a blank line"))
	   (skip-literate-comment '#f)))))

(define (skip-literate-comment prev-blank)
  (skip-past-line)
  (let ((l (classify-line)))
    (cond (*at-eof?*
	   '())
	  ((eq? l 'comment)
	   (skip-literate-comment '#f))
	  ((eq? l 'blank)
	   (skip-literate-comment '#t))
	  (else
	   (when (not prev-blank)
	     (lexer-error 'blank-line-needed
		  "Literate comments must be followed by a blank line"))))))
  
(define (classify-line)
  (if *at-eof?*
      'blank
      (char-case *char*
       (#\>
	(advance-char-1)
	'program)
       (#\newline 'blank)
       (whitechar
	(classify-line-1))
       (else 'comment))))

(define (classify-line-1)
  (advance-char-1)
  (char-case *char*
    (#\newline 'blank)
    (whitechar (classify-line-1))
    (else 'comment)))

(define (skip-past-line)
  (when (not *at-eof?*)
    (char-case *char*
      (#\newline
       (advance-char-1))
      (else
       (advance-char-1)
       (skip-past-line)))))
	  
(define (lex-comment)  ;; a -- style comment
  (advance-char)
  (cond (*at-eof?* (lexer-eof-in-comment *current-line*))
	((char=? *char* #\newline)
	 (lex-one-token))
	(else
	 (lex-comment))))

(define (lexer-eof-in-comment start-line)
  (signal-eof-in-comment start-line)
  (lex-one-token))  ; will return the eof token

(define (signal-eof-in-comment start-line)
  (lexer-error 'eof-in-comment
	       "End of file in comment starting at line ~A." start-line))

;;; Here *char* and *peek-char* are the first two chars on a line.

(define (scan-symbol)
  (scan-list-of (symbol #\:)))

(define (scan-var-con)
  (let ((name (scan-list-of (large small digit #\' #\_))))
    ;; MagicHash (GHC): I#, Int#, x# are names; not the # of a pragma's
    ;; #-} ({-#UNPACK#-})
    (if (and (char=? *char* #\#) (not *at-eof?*)
	     (language-extension? "MagicHash")
	     (not (and (char=? *peek-char* #\-) (char=? (peek-char-2) #\}))))
	(append name (scan-list-of (#\#)))
	name)))

(define (lex-ncomment)
  (lex-ncomment-1 *current-line*))

(define (lex-ncomment-1 start-line)
 (if *at-eof?*
  (lexer-eof-in-comment start-line)
  (char-case *char*
    (#\- (cond ((char=? *peek-char* #\})
		(advance-char)
		(advance-char))
	       (else
		(advance-char)
		(lex-ncomment-1 start-line))))
    (#\{ (cond ((char=? *peek-char* #\-)
		(advance-char)
		(advance-char)
		(lex-ncomment)
		(lex-ncomment-1 start-line))
	       (else
		(advance-char)
		(lex-ncomment-1 start-line))))
    (else
     (advance-char)
     (lex-ncomment-1 start-line)))))

;;; Haskell 98 reserves fewer words than 1.2: hiding, renaming, to and
;;; interface are ordinary identifiers (hiding is recognised in import
;;; declarations by the parser, like qualified and as).  interface stays
;;; a keyword in interface (.hi) files, which begin with it.

(define *lexing-interface?* '#f)

(define (h98-free-word? sym)
  (and (feature? 'h98-lexing)
       (or (string=/list? sym "hiding")
	   (string=/list? sym "renaming")
	   (string=/list? sym "to")
	   (and (string=/list? sym "interface")
		(not (dynamic *lexing-interface?*))))))

(define (lex-varid)
  (let ((sym (scan-var-con)))
   (cond
    ((h98-free-word? sym)
     (emit-token/string 'varid sym))
    ((and (feature? 'do-notation) (string=/list? sym "do"))
     (emit-token '|do|))
    ((and (feature? 'newtype) (string=/list? sym "newtype"))
     (emit-token '|newtype|))
    (else
    (parse-reserved sym varid
       "case" "class"
       "data" "default" "deriving"
       "else"
       "hiding"
       "if" "import" "in" "infix" "infixl" "infixr" "instance" "interface"
       "let"
       "module"
       "of"
       "renaming"
       "then" "to" "type"
       "where")))))

(define (lex-conid)
  (let ((sym (scan-var-con)))
    (if (and (char=? *char* #\.) (feature? 'qualified-names))
	(lex-qualified sym)
	(emit-token/string 'conid sym))))

;;; Qualified names (report 2.4, 5.5.1): a conid immediately followed by
;;; `.' and an identifier or symbol, with no space, is one token: M.x, M.C,
;;; M.+, M.:+, and A.B.x.  The token has the type of its last part and the
;;; whole qualified name as its text, so the parser needs no new token
;;; types and dotted module names (import A.B) come out as one conid.
;;; M.. followed by `)' or a space is M's `.' ((P..), f P.. g), as the
;;; Report lexes it; otherwise it is M and `..', so [False..] and
;;; [False..True] still work.  M..&. (more symbol characters) is M's
;;; operator .&.
;;; PREFIX is the characters read so far; *char* is the `.'.

(define (lex-qualified prefix)
  (char-case *peek-char*
    (large
     (advance-char)
     (let ((q (append prefix (cons #\. (scan-var-con)))))
       (if (char=? *char* #\.)
	   (lex-qualified q)
	   (emit-token/string 'conid q))))
    (small
     (advance-char)
     (emit-token/string 'varid (append prefix (cons #\. (scan-var-con)))))
    (#\.
     ;; M..&. is M's operator .&.; M.. alone stays M followed by ..
     ;; (M..: too, aeson's .: as Template Haskell names it)
     (if (memv (peek-char-2) '(#\& #\| #\+ #\* #\< #\> #\= #\! #\$ #\% #\^ #\? #\/ #\\ #\~ #\@ #\# #\:))
	 (begin
	   (advance-char)
	   (let ((sym (scan-list-of (symbol presymbol #\:))))
	     (emit-token/string 'varsym (append prefix (cons #\. sym)))))
	 (if (memv (peek-char-2) '(#\) #\space #\tab #\newline))
	     (begin
	       (advance-char)
	       (advance-char)
	       (emit-token/string 'varsym (append prefix (list #\. #\.))))
	     (emit-token/string 'conid prefix))))
    ((symbol presymbol #\:)
     (advance-char)
     (let ((sym (scan-list-of (symbol presymbol #\:))))
       (emit-token/string (if (char=? (car sym) #\:) 'consym 'varsym)
			  (append prefix (cons #\. sym)))))
    (else
     (emit-token/string 'conid prefix))))

(define (lex-consym)
  (let ((sym (if (feature? 'h98-lexing) (scan-symbol-98) (scan-symbol))))
    (cond ((string=/list? (cdr sym) ":")
	   (emit-token '\:\:))
	  (else
	   (emit-token/string 'consym sym)))))

;;; UnicodeSyntax (GHC): a symbol that is one of its characters is the
;;; ASCII one's (transformers-base's ⇒).
(define (unicode-syntax-symbol sym)
  (if (and (pair? sym) (null? (cdr sym))
	   (language-extension? "UnicodeSyntax"))
      (let ((c (char->integer (car sym))))
	(cond ((= c #x21D2) (string->list "=>"))     ; ⇒
	      ((= c #x2192) (string->list "->"))     ; →
	      ((= c #x2190) (string->list "<-"))     ; ←
	      ((= c #x2237) (string->list "::"))     ; ∷
	      ((= c #x2200) (string->list "forall")) ; ∀
	      ((= c #x2605) (string->list "*"))      ; ★
	      ((= c #x2919) (string->list "-<"))     ; ⤙
	      ((= c #x291A) (string->list ">-"))     ; ⤚
	      (else sym)))
      sym))

(define (lex-varsym)
  (if (feature? 'h98-lexing)
      (lex-varsym-98)
      (lex-varsym-1.2)))

;;; Haskell 1.2: `-' and `~' may only start an operator, so `+-' is `+'
;;; followed by `-', and `--' always starts a comment.

(define (lex-varsym-1.2)
  (let ((sym (scan-symbol)))
    (cond ((and (string=/list? sym "<") (char=? *char* #\-))
	   (advance-char)
	   (emit-token '\<\-))
	  ((and (string=/list? sym "#")
		(char=? *char* #\-)
		(char=? *peek-char* #\}))
	   (advance-char)
	   (advance-char)
	   (emit-token 'end-annotation))
	  (else
	   (parse-reserved sym varsym
	      ".."
	      "=>" "="
	      "@"
	      "\\"
	      "|"
	      "~")))))

;;; Haskell 98 (report 2.2-2.4): `-' and `~' are ordinary symbol
;;; characters, and two or more dashes start a comment only if they are
;;; not part of a larger operator, so `-->' and `|--' are operators.

(define (scan-symbol-98)
  (scan-list-of (symbol presymbol #\:)))

(define (lex-varsym-98)
  (let ((sym (unicode-syntax-symbol (scan-symbol-98))))
    (cond ((string=/list? sym "forall")
	   ;; UnicodeSyntax's quantifier
	   (emit-token/string 'varid sym))
	  ((string=/list? sym "::")
	   (emit-token '\:\:))
	  ((all-dashes? sym)
	   (if (null? (cdr sym))
	       (if (char=? *char* #\})
		   (begin
		     (signal-missing-begin-comment)
		     (advance-char)
		     (lex-one-token))
		   (emit-token/string 'varsym sym))
	       (lex-comment-rest)))
	  ((and (string=/list? sym "#-")
		(char=? *char* #\}))
	   (advance-char)
	   (emit-token 'end-annotation))
	  ((and (string=/list? sym "!") (bang-shaped?))
	   (emit-token 'varsym "!" 'prefix))
	  (else
	   (parse-reserved sym varsym
	      ".."
	      "=>" "="
	      "@"
	      "\\"
	      "|"
	      "~"
	      "->" "<-")))))

;;; BangPatterns (GHC): a ! with white space or an opening bracket before it
;;; and none after, as in f !x, is a prefix bang (pattern-parser.mumble).
;;; The token stays the operator ! (a ! i) and a strictness flag (!Int).
;;; *char* is the character after the !.

(define (bang-shaped?)
  (and (haskell98?)
       (memv *char-before-token*
	     '(#\space #\tab #\newline #\( #\[ #\, #\; #\{))
       (or (char-alphabetic? *char*) (char-numeric? *char*)
	   (memv *char* '(#\_ #\( #\[ #\~ #\' #\")))))

(define (all-dashes? sym)
  (or (null? sym)
      (and (char=? (car sym) #\-)
	   (all-dashes? (cdr sym)))))

;;; Skip the rest of a -- comment whose dashes have been scanned.

(define (lex-comment-rest)
  (cond (*at-eof?*
	 (lex-one-token))
	((char=? *char* #\newline)
	 (lex-one-token))
	(else
	 (advance-char)
	 (lex-comment-rest))))

(define (lex-integer radix)
  (lex-integer-1 radix 0))

(define (lex-integer-1 radix psum)
  (declare (type fixnum radix)
	   (type integer psum))
  (skip-digit-separator radix)
  (let ((d  (char->digit *char* radix)))
    (if d
	(begin
	  (advance-char)
	  (lex-integer-1 radix (+ (* psum radix) (the fixnum d))))
	psum)))

(define (lex-fraction int-part denominator)
  (declare (type integer int-part denominator))
  (skip-digit-separator 10)
  (let ((d  (char->digit *char* 10)))
    (if d
	(begin
	  (advance-char)
	  (lex-fraction
	    (+ (* int-part 10) (the fixnum d)) (* denominator 10)))
	(values int-part denominator))))

;;; NumericUnderscores (GHC): an _ between two digits, as in 1_000_000,
;;; is skipped.  (In Haskell 98 1_000 is 1 and the name _000.)

(define (skip-digit-separator radix)
  (when (and (haskell98?)
	     (char=? *char* #\_)
	     (char->digit *peek-char* radix))
    (advance-char)))

;;; Hexadecimal (0x1F, 0X1F) and octal (0o17, 0O17) literals are from
;;; Haskell 98.  They are a pure extension, so both dialects get them.
;;; Without a digit after the x or o, `0x' is still 0 followed by x.

(define (lex-numeric)
  (let ((radix (and (char=? *char* #\0)
		    (char-case *peek-char*
		      ((#\x #\X) 16)
		      ((#\o #\O) 8)
		      ;; BinaryLiterals (GHC)
		      ((#\b #\B) (and (haskell98?) 2))
		      (else '#f)))))
    (if (and radix (char->digit (peek-char-2) radix))
	(begin
	  (advance-char)
	  (advance-char)
	  (let ((n  (lex-integer radix)))
	    (if (and (eqv? radix 16) (hex-float-follows?))
		(lex-hex-float n)
		(emit-token 'integer n))))
	(lex-decimal))))

;;; OverloadedRecordDot (GHC): a `.' right after an identifier or a
;;; closing bracket and right before a lower-case name selects a field:
;;; the token record-dot with the field's name (e.f, e.f.g); after `(' it
;;; is a selector section, record-dot-section ((.f)).  With spaces around
;;; it, `.' is composition as before.

(define (record-dot-here?)
  (and (char=? *char* #\.)
       (or (char-lower-case? *peek-char*) (char=? *peek-char* #\_))
       *prev-char*
       (or (char-alphabetic? *prev-char*) (char-numeric? *prev-char*)
	   (memv *prev-char* '(#\) #\] #\_ #\' #\()))
       (language-extension? "OverloadedRecordDot")))

(define (lex-record-dot)
  (let ((section? (char=? *prev-char* #\()))
    (advance-char)
    (emit-token/string (if section? 'record-dot-section 'record-dot)
		       (scan-var-con))))

;;; DataKinds: a ' before a constructor, [ or ( that is not a character
;;; literal ('Z', '[') promotes it; the tick is dropped (module-parser
;;; .mumble declares the promoted constructors as types), except before
;;; [, where a promoted-tick token tells '[a] (a one-element type-level
;;; list) from [a] (the list type; type-parser.mumble).

(define *promoted-names* '())   ; names written 'C (strings)

;;; TemplateHaskell (or TemplateHaskellQuotes): a ' that is not a character
;;; literal ('x', '\n') begins a quoted name: 'f, 'Just, '(:), '[], or
;;; ''T for a type.

(define (name-quote-here?)
  (and (or (language-extension? "TemplateHaskell")
	   (language-extension? "TemplateHaskellQuotes"))
       (cond ((char=? *peek-char* #\')
	      (not (char=? (peek-char-2) #\')))
	     ((char=? *peek-char* #\\) '#f)
	     (else
	      (and (not (char=? (peek-char-2) #\'))
		   (or (char-alphabetic? *peek-char*)
		       (memv *peek-char* '(#\_ #\( #\[))))))))

;;; TemplateHaskell: the token a quote's opening bracket starts, or #f:
;;; [| and [e| an expression's, [p| a pattern's, [t| a type's, [d|
;;; declarations', [|| a typed expression quote (not [e||).  Inside a
;;; quote, |] (or ||]) ends it.

(define (quote-bracket-here?)
  (and (or (language-extension? "TemplateHaskell")
	   (language-extension? "TemplateHaskellQuotes"))
       (cond ((char=? *peek-char* #\|)
	      (if (char=? (peek-char-2) #\|) 'open-typed-quote 'open-exp-quote))
	     ((char=? (peek-char-2) #\|)
	      (case *peek-char*
		(#\e 'open-exp-quote)
		(#\p 'open-pat-quote)
		(#\t 'open-type-quote)
		(#\d 'open-decs-quote)
		(else '#f)))
	     (else '#f))))

;;; QuasiQuotes: at [, the length of the quoter's name when [quoter|
;;; follows (quoter a variable, perhaps qualified, M.q; not e, p, t or d
;;; under TemplateHaskell, its quotes), else #f.  The characters looked at
;;; are put back in front of the port.
(define (quasi-quote-here?)
  (and (language-extension? "QuasiQuotes")
       (or (char-alphabetic? *peek-char*) (char=? *peek-char* #\_))
       (let ((buf '())
	     (bar? '#f))
	 (do ((c (lisp:read-char *port* '#f '#f) (lisp:read-char *port* '#f '#f)))
	     ((or (not c)
		  (not (or (char-alphabetic? c) (char-numeric? c)
			   (memv c '(#\_ #\' #\.)))))
	      (when c
		(push c buf)
		(setf bar? (char=? c #\|))))
	   (push c buf))
	 (setf *port* (lisp:make-concatenated-stream
		       (lisp:make-string-input-stream (list->string (reverse buf)))
		       *port*))
	 (and bar?
	      (let ((name (cons *peek-char* (reverse (cdr buf)))))  ; (not the |)
		(and (not (char=? (car (last name)) #\.))
		     ;; a varid's: its last part starts with a small letter
		     (let ((last-part (lisp:position #\. name :from-end '#t)))
		       (char-lower-case? (if last-part
					     (list-ref name (1+ last-part))
					     (car name))))
		     (not (and (null? (cdr name))
			       (memv (car name) '(#\e #\p #\t #\d))
			       (or (language-extension? "TemplateHaskell")
				   (language-extension? "TemplateHaskellQuotes"))))
		     (length name)))))))

;;; [quoter|text|]: the token quasi-quote, its quoter and text.
(define (lex-quasi-quote name-length)
  (advance-char)  ; [
  (let ((name '())
	(text '()))
    (dotimes (i name-length)
      (push *char* name)
      (advance-char))
    (advance-char)  ; |
    (do () ((or *at-eof?* (and (char=? *char* #\|) (char=? *peek-char* #\]))))
      (push *char* text)
      (advance-char))
    (advance-char)
    (advance-char)
    (emit-token 'quasi-quote (list->string (reverse name)) (list->string (reverse text)))))

;;; typed Template Haskell: $$ that starts a typed splice, as $ does
(define (typed-splice-here?)
  (and (char=? *char* #\$)
       (char=? *peek-char* #\$)
       (language-extension? "TemplateHaskell")
       (let ((c (peek-char-2)))
	 (or (char=? c #\() (char-lower-case? c) (char=? c #\_)))
       (or (not *char-before-token*)
	   (char-whitespace? *char-before-token*)
	   (memv *char-before-token* '(#\( #\[ #\, #\;)))))

;;; TemplateHaskell: a $ that starts a splice, as GHC has it: a prefix
;;; occurrence (after a space, an opening bracket or nothing) right before
;;; ( or a variable.  f $ x and f$x are the operator.

(define (splice-here?)
  (and (char=? *char* #\$)
       (language-extension? "TemplateHaskell")
       (or (char=? *peek-char* #\()
	   (char-lower-case? *peek-char*)
	   (char=? *peek-char* #\_))
       (or (not *char-before-token*)
	   (char-whitespace? *char-before-token*)
	   (memv *char-before-token* '(#\( #\[ #\, #\;)))))

(define (promotion-tick?)
  (and (language-extension? "DataKinds")
       (or (char-upper-case? *peek-char*)
	   (memv *peek-char* '(#\[ #\( #\:)))
       (not (char=? (peek-char-2) #\'))))

;;; NegativeLiterals / LexicalNegation (GHC): a - before a digit, after
;;; a space or an opening bracket, is part of the literal: f -1 is
;;; f (-1); x-1 is still a subtraction.

(define *minus-was-prefix?* '#f)   ; the last - lexed came after a space

(define (negative-literal-here?)
  (and (or (language-extension? "NegativeLiterals")
	   (language-extension? "LexicalNegation"))
       (or (not *char-before-token*)
	   (char-whitespace? *char-before-token*)
	   (memv *char-before-token* '(#\( #\[ #\, #\;)))))

(define (lex-negative-literal)
  (advance-char)
  (lex-numeric)
  (let ((tok  (car *tokens*)))
    (when (memq (car tok) '(integer float))
      (setf (cadr tok) (- (cadr tok))))))

;;; HexFloatLiterals (GHC): 0x1.8p1, 0xFp-2; the value is exact, a
;;; float token n/d * 10^0.

(define (hex-float-follows?)
  (and (language-extension? "HexFloatLiterals")
       (or (and (char=? *char* #\.) (char->digit *peek-char* 16))
	   (and (memv *char* '(#\p #\P))
		(or (char->digit *peek-char* 10)
		    (and (memv *peek-char* '(#\+ #\-))
			 (char->digit (peek-char-2) 10)))))))

(define (lex-hex-float int-part)
  (let ((num  int-part)
	(den  1))
    (when (char=? *char* #\.)
      (advance-char)
      (do () ((not (char->digit *char* 16)))
	(setf num (+ (* num 16) (char->digit *char* 16)))
	(setf den (* den 16))
	(advance-char)))
    (when (memv *char* '(#\p #\P))
      (advance-char)
      (let ((sign 1))
	(cond ((char=? *char* #\+) (advance-char))
	      ((char=? *char* #\-) (setf sign -1) (advance-char)))
	(let ((e  (lex-integer 10)))
	  (if (> sign 0)
	      (setf num (* num (expt 2 e)))
	      (setf den (* den (expt 2 e)))))))
    (emit-token 'float num den 0)))

(define (lex-decimal)
  (let ((int-part (lex-integer 10)))
    (cond ((and (char=? *char* #\.)
		(char->digit *peek-char* 10))
	   (lex-float int-part))
	  ;; Haskell 98 allows an exponent without a fraction: 1e10, 2E-3
	  ((and (haskell98?) (exponent-follows?))
	   (lex-float-tail int-part 1))
	  (else
	   (emit-token 'integer int-part)))))

(define (exponent-follows?)
  (char-case *char*
    (exponent
     (char-case *peek-char*
       (digit '#t)
       ((#\+ #\-) (and (char->digit (peek-char-2) 10) '#t))
       (else '#f)))
    (else '#f)))

(define (lex-float int-part)
  (advance-char)
  (multiple-value-bind (numerator denominator) (lex-fraction int-part 1)
    (lex-float-tail numerator denominator)))

(define (lex-float-tail numerator denominator)
  (begin
    (let ((no-exponent
	   (lambda () (emit-token 'float numerator denominator 0))))
      (char-case *char*
	(exponent
	  (char-case *peek-char*
	    (digit
	     (advance-char)
	     (lex-float/exp numerator denominator 1))
	    ((#\+ #\-)
	     (cond ((char->digit (peek-char-2) 10)
		    (let ((sign (if (char=? *peek-char* '#\+) 1 -1)))
		      (advance-char)
		      (advance-char)
		    (lex-float/exp numerator denominator sign)))
		 (else
		  (funcall no-exponent))))
	  (else
	   (funcall no-exponent))))
       (else
	(emit-token 'float numerator denominator 0))))))

(define (lex-float/exp numerator denominator sign)
  (let* ((exponent (lex-integer 10))
	 (e (* sign exponent)))
    (if (and (language-extension? "NumDecimals")
	     (integer? (/ (* numerator (expt 10 e)) denominator)))
	;; NumDecimals (GHC): 1e6, 2.5e3 are integer literals
	(emit-token 'integer (/ (* numerator (expt 10 e)) denominator))
	(emit-token 'float numerator denominator e))))

(define (lex-char)
  (advance-char)
  (let ((c
    (char-case *char*
      (#\' (signal-null-character)
	   '#\?)
      (#\\ (lex-escaped-char '#f))
      ((#\space graphic)
       (let ((ch *char*))
	 (advance-char)
	 ch))
      (else
       (signal-bad-character-constant *char*)
       (advance-char)
       `#\?))))
    (cond ((char=? *char* '#\')
	   (advance-char)
	   (emit-token 'char c))
	  (else
	   (signal-missing-char-quote)
	   (skip-to-quote-or-eol)))))

(define (signal-null-character)
  (lexer-error 'null-character
	       "Null character '' is illegal - use '\\'' for a quote."))

(define (signal-bad-character-constant ch)
  (lexer-error 'bad-character-constant
	       "The character `~a' may not appear in a character literal." ch))

(define (signal-missing-char-quote)
  (lexer-error 'missing-char-quote
	       "Character constant has more than one character."))
  

(define (skip-to-quote-or-eol)
  (if *at-eof?*
      (lex-one-token)
      (char-case *char*
	 (#\' (advance-char)
	      (lex-one-token))
	 (#\newline (advance-char)
		    (lex-one-token))
	 (else
	  (advance-char)
	  (skip-to-quote-or-eol)))))

(define (lex-string)
  (advance-char)
  (emit-token 'string (list->string (gather-string-chars))))

;;; MultilineStrings (GHC 9.12): """...""".  The lines' common indentation
;;; (of all but the first) goes, then a blank first and a blank last line,
;;; and the lines are joined with newlines.  An escape (\n) is a character,
;;; not a line break nor indentation.
(define (lex-multiline-string)
  (advance-char) (advance-char) (advance-char)
  (let ((lines '()) (line '()))
    (do () ((or *at-eof?*
		(and (char=? *char* #\") (char=? *peek-char* #\")
		     (char=? (peek-char-2) #\"))))
      (cond ((char=? *char* #\\)
	     (let ((ch (lex-escaped-char '#t)))
	       (when (not (eq? ch 'null))
		 (push (cons 'escaped ch) line))))
	    ((char=? *char* #\newline)
	     (advance-char)
	     (push (reverse line) lines)
	     (setf line '()))
	    (else
	     (push *char* line)
	     (advance-char))))
    (if *at-eof?*
	(signal-missing-string-quote)
	(begin (advance-char) (advance-char) (advance-char)))
    (push (reverse line) lines)
    (emit-token 'string (multiline-string-text (reverse lines)))))

(define (multiline-string-text lines)
  (let* ((blank? (lambda (l) (every (lambda (c) (and (char? c) (char-whitespace? c))) l)))
	 (indent (lambda (l) (do ((n 0 (1+ n)) (l l (cdr l)))
				 ((or (null? l) (not (char? (car l)))
				      (not (char=? (car l) #\space)))
				  n))))
	 (rest (if (null? lines) '() (cdr lines)))
	 (common (let ((m '#f))
		   (dolist (l rest)
		     (when (not (funcall blank? l))
		       (let ((n (funcall indent l)))
			 (when (or (not m) (< n m)) (setf m n)))))
		   (or m 0)))
	 (lines (if (null? lines)
		    '()
		    (cons (car lines)
			  (map (lambda (l)
				 (if (funcall blank? l)
				     '()
				     (list-tail l (min common (length l)))))
			       rest))))
	 (lines (if (and (pair? lines) (funcall blank? (car lines))) (cdr lines) lines))
	 (lines (if (and (pair? lines) (funcall blank? (car (lisp:last lines))))
		    (butlast lines)
		    lines))
	 (chars '()))
    (do ((ls lines (cdr ls))) ((null? ls))
      (dolist (c (car ls))
	(push (if (char? c) c (cdr c)) chars))
      (when (pair? (cdr ls)) (push #\newline chars)))
    (list->string (reverse chars))))

(define (gather-string-chars)
  (char-case *char*
    (#\\
      (let ((ch (lex-escaped-char '#t)))
	(if (eq? ch 'null)
	    (gather-string-chars)
	    (cons ch (gather-string-chars)))))
    (#\"
      (advance-char)
      '())
    ((graphic #\space)
     (let ((ch *char*))
       (advance-char)
       (cons ch (gather-string-chars))))
    (#\newline
     (signal-missing-string-quote)
     '())
    (else
     (signal-bad-string-constant *char*)
     (advance-char)
     (gather-string-chars))))

(define (signal-missing-string-quote)
  (lexer-error 'missing-string-quote
	       "String continued over end of line."))

(define (signal-bad-string-constant ch)
  (lexer-error 'bad-string-constant
	       "The character `~a' may not appear in a string literal." ch))


(define (convert-stupid-control-character-names)
  (let ((c1 *char*)
	(c2 *peek-char*))
    (advance-char)
    (advance-char)
    (let ((s2 (string c1 c2))
	  (s3 (string c1 c2 *char*)))
      (let ((srch3 (assoc s3 *control-char-names*)))
	(cond (srch3
	       (advance-char)
	       (integer->char (cdr srch3)))
	      (else
	       (let ((srch2 (assoc s2 *control-char-names*)))
		 (cond (srch2
			(integer->char (cdr srch2)))
		       (else
			(signal-bad-control-char s3)
			`#\?)))))))))

(define (signal-bad-control-char name)
  (lexer-error 'invalid-control-char
	       "`~a' is not a recognized control character name." name))


(define (lex-escaped-char in-string?)
  (advance-char)
  (char-case *char*
    ((#\a #\b #\f #\n #\r #\t #\v)
     (let* ((ccode (cdr (assoc *char* *short-control-char-names*)))
	    (ccode1 (cdr (assoc ccode *control-char-names*))))
       (advance-char)
       (integer->char ccode1)))
    ((#\\ #\' #\")
     (let ((ch *char*))
       (advance-char)
       ch))
    (#\&
     (advance-char)
     (cond (in-string? 'null)
	   (else
	    (signal-bad-&-escape)
	    '#\?)))
    (#\^
     ;; *** This code is problematic because it assumes
     ;; *** (1) that you can do the arithmetic on the character codes
     ;; *** (2) that the resulting integer can actually be coerced to
     ;; ***     the right character object in the host Lisp.
     (advance-char)
     (char-case *char*
       ((large #\@ #\[ #\\ #\] #\^ #\_)
	(let ((code (+ (- (char->integer *char*)
			  (char->integer '#\A))
		       *control-A*)))
	  (advance-char)
	  (integer->char code)))
       (else
	(signal-bad-^-escape *char*)
	'#\?)))
    (large
     (convert-stupid-control-character-names))
    (digit
     (convert-num-to-char (lex-integer 10)))
    (#\o
     (advance-char)
     (cond ((char->digit *char* 8)
	    (convert-num-to-char (lex-integer 8)))
	   (else
	    (signal-missing-octal-digits)
	    '#\?)))
    (#\x
     (advance-char)
     (cond ((char->digit *char* 16)
	    (convert-num-to-char (lex-integer 16)))
	   (else
	    (signal-missing-hex-digits)
	    `#\?)))
    (whitechar
     (cond (in-string?
	    (lex-gap))
	   (else
	    (signal-bad-gap)
	    `#\?)))
    (else
     (signal-bad-escape *char*)
     `#\?)))

(define (signal-bad-&-escape)
  (lexer-error 'bad-&-escape
	       "The escape `\\&' is not allowed inside a character literal."))

(define (signal-bad-^-escape ch)
  (lexer-error 'bad-^-escape
	       "The escape `\\^~a' is not recognized." ch))

(define (signal-missing-octal-digits)
  (lexer-error 'missing-octal-digits
	       "No digits provided for `\\o' escape."))

(define (signal-missing-hex-digits)
  (lexer-error 'missing-hex-digits
	       "No digits provided for `\\x' escape."))

(define (signal-bad-gap)
  (lexer-error 'invalid-gap
	       "Gaps are not allowed inside character literals."))

(define (signal-bad-escape ch)
  (lexer-error 'bad-escape
	       "The escape `\\~a' is not recognized." ch))



;;; *** This code is problematic because it assumes that integers
;;; *** between 0 and 255 map on to characters with the corresponding
;;; *** ASCII encoding in the host Lisp, and that the host Lisp actually
;;; *** supports 255 characters.

(define (convert-num-to-char num)
  (cond ((and (>= num 0) (>= (max-char-code) num))
	 (integer->char num))
	(else
	 (signal-char-out-of-range num)
	 '#\?)))

(define (signal-char-out-of-range num)
  (lexer-error 'char-out-of-range
	       "There is no character corresponding to code ~s." num))


(define (lex-gap)
  (cond (*at-eof?*
	 (signal-eof-in-gap)
	 'null)
	(else
	 (char-case *char*
	   (whitechar
	    (advance-char)
	    (lex-gap))
	   (#\\
	    (advance-char)
	    'null)
	   (else
	    (signal-missing-gap)
	    'null)))))
  
      
(define (signal-eof-in-gap)
  (lexer-error 'eof-in-gap
	       "End of file encountered inside gap."))

(define (signal-missing-gap)
  (lexer-error 'missing-gap
	       "Missing gap delimiter, or junk inside gap."))
