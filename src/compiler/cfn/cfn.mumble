(define-compilation-unit cfn
  (source-filename "$Y2/src/compiler/cfn/")
  (require ast haskell-utils)
  (unit main
	(source-filename "main.mumble"))
  (unit misc
	(source-filename "misc.mumble")
	(require main))
  (unit pattern
	(source-filename "pattern.mumble")
	(require main)))

	

