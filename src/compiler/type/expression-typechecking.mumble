;;; This file contains typecheckers for all expressions except vars and
;;; declarations.

;;; From valdef-structs:
;;;   valdef, single-fun-def are in type-decls

(define-type-checker guarded-rhs
  (if (is-type? 'pattern-guard (guarded-rhs-guard object))
      (with-new-tyvars
       (dynamic-let ((*gadt-match* '#f))
	 (type-check-guard-quals
	  (pattern-guard-quals (guarded-rhs-guard object)) object)))
      (type-check guarded-rhs rhs rhs-type
	(type-check guarded-rhs guard guard-type
	  (type-unify guard-type *bool-type*
	      (type-mismatch/fixed (guarded-rhs-guard object)
	       "Guards must be of type Bool" guard-type))
	  (return-type object rhs-type)))))

;;; The quals of a pattern guard, in order (each one's bindings are seen
;;; by the rest), then the rhs of RHS-OBJECT.  As in a list
;;; comprehension, pattern-bound variables are monomorphic.

(define (type-check-guard-quals quals rhs-object)
  (if (null? quals)
      (let ((object  rhs-object))
	;; a GADT constructor matched by a guard's pattern (| Branch k1 k2
	;; <- fields, generic-data): its rhs is coerced, as a clause's is
	;; (existentials.mumble)
	(when (dynamic *gadt-match*)
	  (gadt-coerce-rhs-list (list object)))
	(type-check guarded-rhs rhs rhs-type
	  (return-type object rhs-type)))
      (let ((object  (car quals)))
	(cond ((is-type? 'qual-generator object)
	       (fresh-type pat-type
		 (push pat-type (dynamic *non-generic-tyvars*))
		 (type-check qual-generator pat pat-type-1
		   (type-unify pat-type pat-type-1 #f)
		   (type-check qual-generator exp qual-exp-type
		     (type-unify pat-type qual-exp-type
		       (type-mismatch/fixed object
			"The pattern and expression of a pattern guard have different types"
			qual-exp-type)))))
	       (type-check-guard-quals (cdr quals) rhs-object))
	      ((is-type? 'qual-filter object)
	       (type-check qual-filter exp filter-type
		 (type-unify filter-type *bool-type*
		   (type-mismatch/fixed object
		    "Guards must be of type Bool" filter-type)))
	       (type-check-guard-quals (cdr quals) rhs-object))
	      (else
	       (type-check/decls qual-let decls
		 (type-check-guard-quals (cdr quals) rhs-object)))))))

;;; These type checkers deal with patterns.

(define-type-checker as-pat
  (type-check as-pat pattern as-type
    (setf (var-type (var-ref-var (as-pat-var object))) as-type)
    (return-type object as-type)))

(define-type-checker irr-pat
  (type-check irr-pat pattern pattern-type
    (return-type object pattern-type)))

;;; !pat: the pattern's type.
(define-type-checker bang-pat
  (type-check bang-pat pattern pattern-type
    (return-type object pattern-type)))

;;; (pat :: type): the pattern's type unified with the signature's, its
;;; type variables fresh.  ScopedTypeVariables: a name not in scope is
;;; bound by the pattern, over the rest of the clause (f (Left (e :: e))
;;; = ... where m :: Either e x), as in GHC; single-fun-def keeps the
;;; binding to its clause.
(define-type-checker sig-pat
  (type-check sig-pat pattern pattern-type
    (let ((sig  (sig-pat-signature object)))
      (mlet (((type new) (instantiate-gtype/pattern (signature->gtype sig))))
	(type-unify pattern-type type
	  (type-mismatch/fixed object
	    "The pattern does not have its signature's type" pattern-type))
	(setf (dynamic *scoped-tyvars*) (append new (dynamic *scoped-tyvars*))))
      (return-type object pattern-type))))

(define-type-checker var-pat
  (let* ((var (var-ref-var (var-pat-var object)))
	 (poly (assq var (dynamic *polytype-vars*))))
    (cond
      ((and poly (not (polytype? (tuple-2-2 poly))))
       ;; an argument whose type has a polytype in it: that type
       (setf (var-type var) (tuple-2-2 poly))
       (return-type object (tuple-2-2 poly)))
      (poly
	;; a polymorphic argument (polytypes.mumble)
	(begin
	  (setf (var-type var) (tuple-2-2 poly))
	  (return-type object (instantiate-polytype (tuple-2-2 poly)))))
      (else
	(fresh-type var-type
	  (setf (var-type var) var-type)
	  (return-type object var-type))))))

(define-type-checker wildcard-pat
 (fresh-type pat-type
    (return-type object pat-type)))

;;; Constant patterns create a piece of code to actually to the
;;; match: ((==) k), where k is the constant.  This code is placed in the
;;; match-fn slot of the const-pat and is used by the cfn.

(define-type-checker const-pat
 (let* ((val (const-pat-value object))
	(match-fn (**app (**var/def (core-symbol "==")) val)))
   (setf (const-pat-match-fn object) match-fn)
   (type-check const-pat match-fn match-type
     (fresh-type res-type
       (type-unify match-type (**arrow res-type *bool-type*) #f)
       (return-type object res-type)))))

(define-type-checker plus-pat
  (let* ((kp (**int (plus-pat-k object)))
	 (km (**int (- (plus-pat-k object))))
	 (match-fn (**app (**var/def (core-symbol "<=")) kp))
	 (bind-fn (**app (**var/def (core-symbol "+")) km)))
    (setf (plus-pat-match-fn object) match-fn)
    (setf (plus-pat-bind-fn object) bind-fn)
    (fresh-type res-type
      (setf (ntyvar-context res-type) (list (core-symbol "Integral")))
      (type-check plus-pat match-fn match-type
        (type-check plus-pat bind-fn bind-type
          (type-check plus-pat pattern pat-type
	    (type-unify match-type (**arrow pat-type *bool-type*) #f)
	    (type-unify bind-type (**arrow pat-type pat-type) #f)
	    (type-unify res-type pat-type #f)
	    (return-type object res-type)))))))

(define-type-checker pcon
 (type-check/list pcon pats arg-types
   (fresh-type res-type
     (cond
      ((con-gadt? (pcon-con object))
       ;; existentials.mumble
       (mlet (((con-type hidden) (gadt-pcon (pcon-con object))))
	 (type-unify con-type (**arrow/l-2 arg-types res-type) #f)
	 (polytype-field-vars (pcon-pats object) con-type)
	 (setf (pcon-pats object) (append hidden (pcon-pats object)))
	 (return-type object res-type)))
      ((null? (con-existential (pcon-con object)))
	 (let ((con-type (instantiate-gtype (con-signature (pcon-con object)))))
	   (type-unify con-type (**arrow/l-2 arg-types res-type) #f)
	   (polytype-field-vars (pcon-pats object) con-type)
	   (return-type object res-type)))
      (else
	 ;; existentials.mumble: the hidden dictionary fields bind variables
	 (mlet (((con-type hidden) (existential-pcon (pcon-con object))))
	   (type-unify con-type (**arrow/l-2 arg-types res-type) #f)
	   (polytype-field-vars (pcon-pats object) con-type)
	   (setf (pcon-pats object) (append hidden (pcon-pats object)))
	   (return-type object res-type)))))))

(define-type-checker list-pat
  (if (null? (list-pat-pats object))
      (return-type object (instantiate-gtype
			     (algdata-signature (core-symbol "List"))))
      (type-check/unify-list list-pat pats element-type
	   (type-mismatch/list object
	     "List elements have different types")
	(return-type object (**list-of element-type)))))

;;; These are in the order defined in exp-structs.mumble

(define-type-checker lambda
 (with-new-tyvars
  (fresh-monomorphic-types (length (lambda-pats object)) arg-vars
    (type-check/list lambda pats arg-types
     (unify-list arg-types arg-vars)
     (type-check lambda body body-type
      (return-type object (**arrow/l-2 arg-vars body-type)))))))

(define-type-checker let
  (type-check/decls let decls
    (type-check let body let-type
      (return-type object let-type))))

(define-type-checker if
  (type-check if test-exp test-type
    (type-unify test-type *bool-type*
        (type-mismatch/fixed object
	 "The test in an if statement must be of type Bool"
	 test-type))
    (type-check if then-exp then-type
      (type-check if else-exp else-type
        (type-unify then-type else-type
              (type-mismatch object
		   "then and else clauses have different types"
		   then-type else-type))
	(return-type object then-type)))))

(define-type-checker case
 (with-new-tyvars
  (let ((case-exp object))  ; needed since object is rebound later
   (fresh-monomorphic-type arg-type
    (type-check case exp exp-type
      (type-unify arg-type exp-type #f) ; just to make it monomorphic
      (fresh-type res-type
	(dolist (object (case-alts object))
	  (recover-type-error ;;; %%% Needs work
	   (dynamic-let ((*gadt-match* '#f)
			 (*gadt-refinements* '()))
	   (type-check alt pat pat-type
	     (type-unify pat-type arg-type
                 (type-mismatch case-exp
		  "Case patterns type conflict."
		  pat-type arg-type))
	     ;; a GADT constructor matched (existentials.mumble)
	     (when (dynamic *gadt-match*)
	       (gadt-coerce-rhs-list (alt-rhs-list object)))
	     (dynamic-let ((*gadt-soft-vars*
			    (if (dynamic *gadt-match*)
				(append (gadt-pattern-vars (list (alt-pat object)))
					(dynamic *gadt-soft-vars*))
				(dynamic *gadt-soft-vars*)))
			   (*gadt-soft-uses* (dynamic *gadt-soft-uses*))
			   (*gadt-soft-decl*
			    (if (dynamic *gadt-match*)
				(car (dynamic *enclosing-decls*))
				(dynamic *gadt-soft-decl*))))
	     (type-check/decls alt where-decls
	       (type-check/unify-list alt rhs-list rhs-type
                 (type-mismatch/list case-exp
		     "Guarded expressions must have the same type")
		 (type-unify rhs-type res-type
			      (type-mismatch case-exp
		   "Case expression alternatives must have the same type"
		                 rhs-type res-type)))))))))
	(return-type case-exp res-type)))))))

;;; Expressions with signatures are transformed into let expressions
;;; with signatures.  

;;;    exp :: type   is rewritten as
;;;    let temp = exp
;;;        temp :: type
;;;     in temp

;;; f @T1 @T2 ...: the type arguments are collected and f's type is
;;; instantiated with them for its first type variables (type-vars.mumble's
;;; var-ref).  The node is replaced by f.

(define *type-args* '())

(define-type-checker type-app
  (let ((args  '())
	(exp   object))
    (do () ((not (type-app? exp)))
      (push (type-app-type exp) args)
      (setf exp (type-app-exp exp)))
    (when (not (or (var-ref? exp) (con-ref? exp)))
      (phase-error 'type-application
	"A type application must be to a variable or constructor, not ~A."
	(lisp:type-of exp)))
    (mlet (((new-exp type)
	    (dynamic-let ((*type-args*
			   (map (lambda (ty)
				  (mlet (((nt _) (ast->ntype/bindings
						  ty (dynamic *scoped-tyvars*))))
				    nt))
				args)))
	      (dispatch-type-check exp))))
      (return-type new-exp type))))

;;; ImplicitParams: let ?x = e in body gives IP "x" t, t e's type, to the
;;; placeholders made in body (mp-classes.mumble's find-mp-param).  IP
;;; has one method, so its dictionary is the method: e itself.
(define-type-checker ip-let
  (type-check ip-let exp exp-type
    (let ((d (create-temp-var "d_IP")))
      (setf (var-type d) (**ntyvar))
      (mlet (((name-type _) (ast->ntype/bindings (ip-name-type (ip-let-name object)) '()))
	     ((body body-type)
	      (dynamic-let ((*local-mp-params*
			     (cons (list (prelude-modern-def '|IP|) (list name-type exp-type) d)
				   (dynamic *local-mp-params*))))
		(dispatch-type-check (ip-let-body object)))))
	(return-type (**app (**lambda/pat (list (**var-pat/def d)) body) (ip-let-exp object))
		     body-type)))))

(define-type-checker exp-sign
 (type-rewrite
  (let* ((temp-var (create-temp-var "TC"))
	 (decl (**valdef (**var-pat/def temp-var) '() (exp-sign-exp object)))
	 (let-exp (**let (list decl) (**var/def temp-var)))
	 (signature (exp-sign-signature object)))
      ;; The new valdef must belong to the enclosing module so that
      ;; defaulting finds that module's default declaration.
      (when (not (null? (dynamic *enclosing-decls*)))
	(setf (valdef-module decl)
	      (valdef-module (car (dynamic *enclosing-decls*)))))
      (setf (var-signature temp-var)
	    (signature->gtype signature))
      let-exp)))

;;; Rather than complicate the ast structure with a new node for dictSel
;;; we recognize the dictSel primitive as an application and treat it
;;; specially.

(define-type-checker app
 (cond
  ((and (var-ref? (app-fn object))
	(eq? (var-ref-var (app-fn object)) (core-symbol "dictSel")))
   (type-check-dict-sel (app-arg object)))
  ((prelude-dollar-app? object)
   (type-rewrite (**app (app-arg (app-fn object)) (app-arg object))))
  (else
  (type-check app fn fn-type0
   (let ((fn-type (polytype-function-instance object fn-type0)))
   (if (constrained-polytype-argument fn-type)
    ;; an argument of a polytype with a context (polytypes.mumble)
    (begin
      (setf (app-arg object)
	    (type-check-polytype-argument
	     (app-arg object) (constrained-polytype-argument fn-type)))
      (return-type object (cadr (ntycon-args (prune fn-type)))))
    (dynamic-let ((*polytype-vars*
		   (let ((expected (known-argument-type fn-type)))
		     (if expected
			 (append (lambda-polytype-vars (app-arg object) expected)
				 (dynamic *polytype-vars*))
			 (dynamic *polytype-vars*)))))
    (type-check app arg arg-type
      (fresh-type res-type
        (fresh-type arg-type-1
          (type-unify fn-type (**arrow arg-type-1 res-type)
              (type-mismatch/fixed object
		       "Attempt to call a non-function"
		       fn-type))
	  (type-unify arg-type-1 arg-type
              (type-mismatch object
		 "Argument type mismatch" arg-type-1 arg-type))
	  (return-type object res-type)))))))))))

;;; This is a special hack for typing dictionary selection as used in
;;; generic tuple functions.  This extracts a dictionary from a TupleDict
;;; object and uses is to resolve the overloading of a designated
;;; expression.  The expresion must generate exactly one new context.

(define (type-check-dict-sel arg)
  (when (or (not (app? arg))
	    (not (app? (app-fn arg))))
     (dict-sel-error))
  (let* ((exp (app-fn (app-fn arg)))
	 (dict-var (app-arg (app-fn arg)))
	 (i (app-arg arg))
	 (p (dynamic *placeholders*)))
    (mlet (((object exp-type) (dispatch-type-check exp)))
	  ; check for exactly one new context
      (when (or (eq? (dynamic *placeholders*) p)
		(not (eq? (cdr (dynamic *placeholders*)) p)))
	 (dict-sel-error))
	(mlet ((placeholder (car (dynamic *placeholders*)))
	       (tyvar (placeholder-tyvar placeholder))
	       ((dict-var-ast dict-var-type) (dispatch-type-check dict-var))
	       ((index-ast index-type) (dispatch-type-check i)))
	   (setf (ntyvar-context tyvar) '())  ; prevent context from leaking out
	   (setf (dynamic *placeholders*) p)
           (type-unify dict-var-type
			  (**ntycon (core-symbol "TupleDicts") '()) #f)
	   (type-unify index-type *int-type* #f)
	   (cond ((method-placeholder? placeholder)
		  (dict-sel-error))  ; I am lazy.  This means that
		 ; dictSel must not be passed a method
		 (else
		  (setf (placeholder-exp placeholder)
			(**app (**var/def (core-symbol "dictSel"))
			       dict-var-ast index-ast))))
	   (return-type object exp-type)))))

(define (dict-sel-error)
  (fatal-error 'dict-sel-error "Bad dictSel usage."))

;;; A constructor's type variables in the order of its data type's (GHC's
;;; order for type applications): the arguments of the result type
;;; T a1 ... an are gtyvars, numbered by first appearance in the
;;; constructor's type.

(define (con-tyvars-in-data-order gtype tyvars)
  (let ((result (gtype-type gtype)))
    (do () ((not (and (ntycon? result)
		      (eq? (ntycon-tycon result) (core-symbol "Arrow")))))
      (setf result (cadr (ntycon-args result))))
    (if (and (ntycon? result)
	     (every (function gtyvar?) (ntycon-args result)))
	(map (lambda (g) (list-ref tyvars (gtyvar-varnum g))) (ntycon-args result))
	tyvars)))

(define-type-checker con-ref
  (if (not (null? (con-existential (con-ref-con object))))
      (mlet (((exp type) (existential-con-ref object (con-ref-con object))))
	(return-type (if (eq? exp object) object (**save-old-exp object exp)) type))
      (con-ref-type object)))

(define (con-ref-type object)
  (let ((type-args (dynamic *type-args*)))
    (setf (dynamic *type-args*) '())
    (mlet (((type tyvars) (instantiate-gtype/newvars (con-signature (con-ref-con object)))))
      ;; TypeApplications: Right @String @Int
      (when (not (null? type-args))
	(setf (dynamic *instance-tyvars*)
	      (con-tyvars-in-data-order (con-signature (con-ref-con object)) tyvars))
	(apply-type-args (con-ref-con object) type-args))
      (return-type object type))))

(define-type-checker integer-const
  (cond ((const-overloaded? object)
	 (setf (const-overloaded? object) '#f)
	 (type-rewrite (**fromInteger object)))
	(else
	 (return-type object *Integer-type*))))

(define-type-checker float-const
  (cond ((const-overloaded? object)
	 (setf (const-overloaded? object) '#f)
	 (type-rewrite (**fromRational object)))
	(else
	 (return-type object *Rational-type*))))

(define-type-checker char-const
  (return-type object *char-type*))

(define-type-checker string-const
  (return-type object *string-type*))

(define-type-checker list-exp
  (if (null? (list-exp-exps object))
      (return-type object (instantiate-gtype
			     (algdata-signature (core-symbol "List"))))
      (type-check/unify-list list-exp exps element-type
	      (type-mismatch/list object
		 "List elements do not share a common type")
	(return-type object (**list-of element-type)))))

(define-type-checker sequence
  (type-rewrite (**enumFrom (sequence-from object))))

(define-type-checker sequence-to
  (type-rewrite (**enumFromTo (sequence-to-from object)
			      (sequence-to-to object))))

(define-type-checker sequence-then
  (type-rewrite (**enumFromThen (sequence-then-from object)
				(sequence-then-then object))))

(define-type-checker sequence-then-to
  (type-rewrite (**enumFromThenTo (sequence-then-to-from object)
				  (sequence-then-to-then object)
				  (sequence-then-to-to object))))

(define-type-checker list-comp
 (with-new-tyvars
  (dolist (object (list-comp-quals object))
    (if (is-type? 'qual-generator object)
	(fresh-type pat-type
	 (push pat-type (dynamic *non-generic-tyvars*))
	 (type-check qual-generator pat pat-type-1
	   (type-unify pat-type pat-type-1 #f)
	   (type-check qual-generator exp qual-exp-type
	     (type-unify (**list-of pat-type) qual-exp-type
                            (type-mismatch/fixed object
		 "Generator expression is not a list" qual-exp-type)))))
	 (type-check qual-filter exp filter-type
	   (type-unify filter-type *bool-type*
              (type-mismatch/fixed object
		"Filter must have type Bool" filter-type)))))
  (type-check list-comp exp exp-type
     (return-type object (**list-of exp-type)))))

;;; A section of a variable, (op v) or (v op), is \x -> op x v (or
;;; op v x): an application, so that a polytype argument (RankNTypes:
;;; Agda's (^. l), l a lens) is checked as one (polytypes.mumble).
;;; (v is a variable: nothing is evaluated twice.)  So is a section of an
;;; operator with a polytype argument, whatever the operand: (^. l1 . l2),
;;; Agda's (the operand is evaluated at each call).

(define (section-as-lambda? op exp)
  (or (var-ref? exp)
      (and (var-ref? op)
	   (var? (var-ref-var op))
	   (gtype? (var-type (var-ref-var op)))
	   (gtype-has-polytypes? (var-type (var-ref-var op))))))

(define (section-var-lambda op left right)
  (let ((x (create-temp-var "SEC")))
    (**lambda/pat (list (**var-pat/def x))
		  (**app op (if left left (**var/def x)) (if right right (**var/def x))))))
;;; When the operand left out is a polytype argument of the operator
;;; (Agda's insert = (`modifyTCLens` MapS.insert m mv), modifyTCLens ::
;;; Lens' TCState a -> (a -> a) -> m ()), the section's type is
;;; (polytype -> result), as GHC types it, and its variable is polymorphic
;;; in the body: a use (insert stOpenMetaStore) gives a polymorphic
;;; argument (polytypes.mumble), not an instance with an undecided
;;; dictionary.  INDEX is the left-out operand's position.  Returns the
;;; polytype, in a new instance of the operator's type, or #f.

(define (section-polytype-argument op index)
  (and (var-ref? op)
       (var? (var-ref-var op))
       (gtype? (var-type (var-ref-var op)))
       (gtype-has-polytypes? (var-type (var-ref-var op)))
       (let* ((inst  (instantiate-gtype/newvars (var-type (var-ref-var op))))
	      (args  (arrow-argument-types inst)))
	 (and (> (length args) index)
	      (let ((p  (prune (list-ref args index))))
		(and (polytype? p) p))))))

(define (type-check-polytype-section object op left right poly)
  (let* ((x    (create-temp-var "SEC"))
	 (lam  (**lambda/pat (list (**var-pat/def x))
			     (**app op (if left left (**var/def x))
				    (if right right (**var/def x))))))
    (setf (var-type x) poly)
    (dynamic-let ((*polytype-vars* (cons (tuple x poly) (dynamic *polytype-vars*))))
      (mlet (((body body-type) (dispatch-type-check (lambda-body lam))))
	(setf (lambda-body lam) body)
	(return-type (**save-old-exp object lam) (**arrow poly body-type))))))

(define-type-checker section-l
 (let ((poly  (section-polytype-argument (section-l-op object) 0)))
 (if poly
  (type-check-polytype-section object (section-l-op object) '#f (section-l-exp object) poly)
 (if (section-as-lambda? (section-l-op object) (section-l-exp object))
  (type-rewrite (section-var-lambda (section-l-op object) '#f (section-l-exp object)))
  (type-check section-l op op-type
    (type-check section-l exp exp-type
      (fresh-type a-type
        (fresh-type b-type
          (fresh-type c-type
            (type-unify op-type (**arrow a-type b-type c-type)
                (type-mismatch/fixed object
		     "Binary function required in section" op-type))
	    (type-unify b-type exp-type
                  (type-mismatch object
		      "Argument type mismatch" b-type exp-type))
	    (return-type object (**arrow a-type c-type)))))))))))

(define-type-checker section-r
 (let ((poly  (section-polytype-argument (section-r-op object) 1)))
 (if poly
  (type-check-polytype-section object (section-r-op object) (section-r-exp object) '#f poly)
 (if (section-as-lambda? (section-r-op object) (section-r-exp object))
  (type-rewrite (section-var-lambda (section-r-op object) (section-r-exp object) '#f))
  (type-check section-r op op-type
    (type-check section-r exp exp-type
      (fresh-type a-type
        (fresh-type b-type
          (fresh-type c-type
            (type-unify op-type (**arrow a-type b-type c-type)
                  (type-mismatch/fixed object
			 "Binary function required" op-type))
	    (type-unify exp-type a-type
                    (type-mismatch object
			 "Argument type mismatch" a-type exp-type))
	    (return-type object (**arrow b-type c-type)))))))))))

(define-type-checker omitted-guard
  (return-type object *bool-type*))

(define-type-checker con-number
  (let ((arg-type (instantiate-gtype
		   (algdata-signature (con-number-type object)))))
    (type-check con-number value arg-type1
      (type-unify arg-type arg-type1 #f)
      (return-type object *int-type*))))

(define-type-checker sel
  (let ((con-type (instantiate-gtype
		   (con-signature (sel-constructor object)))))
    (mlet (((res-type exp-type1) (get-ith-type con-type (sel-slot object))))
      (type-check sel value exp-type
        (type-unify exp-type exp-type1 #f)
	(return-type object res-type)))))

(define (get-ith-type type i)
 (let ((args (ntycon-args type)))  ; must be an arrow
  (if (eq? i 0)
      (values (car args) (get-ith-type/last (cadr args)))
      (get-ith-type (cadr args) (1- i)))))

(define (get-ith-type/last type)
  (if (eq? (ntycon-tycon type) (core-symbol "Arrow"))
      (get-ith-type/last (cadr (ntycon-args type)))
      type))

(define-type-checker is-constructor
  (let ((alg-type (instantiate-gtype
		   (algdata-signature
		    (con-alg (is-constructor-constructor object))))))
    (type-check is-constructor value arg-type
      (type-unify arg-type alg-type #f)
      (return-type object *bool-type*))))

(define-type-checker cast
  (type-check cast exp inner
    (fresh-type res
      ;; a GADT match's coercion (existentials.mumble)
      (record-gadt-cast object inner res)
      (return-type object res))))

;;; This is used for overloaded methods.  The theory is to avoid supplying
;;; the context at the class level.  This type checks the variable as if it had
;;; the supplied signature.

(define-type-checker overloaded-var-ref
  (let* ((var (overloaded-var-ref-var object))
	 (gtype (overloaded-var-ref-sig object))
	 (ovar-type (var-type var)))
    (when (recursive-type? ovar-type)
	 (error
	  "Implementation error: overloaded method found a recursive type"))
    (if (and (gtype? (var-signature var))
	     (or (not (null? (gtype-mcontext gtype)))
		 ;; (or the method's own signature has multi-parameter
		 ;; constraints: a default's at t n, t n ~ m)
		 (not (null? (gtype-mcontext (var-signature var))))))
	(return-type-of-overloaded-method object var gtype)
	(mlet (((ntype new-vars) (instantiate-gtype/newvars gtype))
	       (object1 (insert-dict-placeholders
			 (**var/def var) new-vars object)))
	  (return-type object1 ntype)))))

;;; An instance's method in its dictionary, the instance with a
;;; multi-parameter context (instance Step t u => Step [t] u): the method
;;; takes its dictionaries in its own signature's order, the instance's
;;; and its own mixed (one-parameter first, then multi-parameter ones), so
;;; the dictionary's entry is \own .. -> m <instance's and own, in order>.
(define (return-type-of-overloaded-method object var gtype)
  (mlet (((ntype otyvars omps) (instantiate-gtype/mp gtype))
	 ((vtype vtyvars vmps) (instantiate-gtype/mp (var-signature var))))
    (let ((ocontexts (map (lambda (tv) (cons tv (ntyvar-context tv))) otyvars))
	  (vcontexts (map (lambda (tv) (cons tv (ntyvar-context tv))) vtyvars))
	  (own '())
	  (args '()))
      ;; (the method's own contexts are its parameters here, not the
      ;; dictionary's: the instance's become placeholders below)
      (dolist (tv vtyvars) (setf (ntyvar-context tv) '()))
      (type-unify vtype ntype '#f)
      (dolist (vc vcontexts)
	(dolist (class (cdr vc))
	  (if (lisp:some (lambda (oc) (and (eq? (prune (car oc)) (prune (car vc)))
					   (memq class (cdr oc))))
			 ocontexts)
	      (let ((p (**dict-placeholder class (prune (car vc)) (dynamic *enclosing-decls*) object)))
		(remember-placeholder p)
		(push p args))
	      (let ((d (create-temp-var "d_own")))
		(push d own)
		(push (**var/def d) args)))))
      (dolist (m vmps)
	(if (lisp:some (lambda (om) (and (eq? (tuple-2-1 om) (tuple-2-1 m))
					 (every (function mp-type-equal?) (tuple-2-2 om) (tuple-2-2 m))))
		       omps)
	    (let ((p (**mp-placeholder (tuple-2-1 m) (tuple-2-2 m) '#f
				       (dynamic *enclosing-decls*) object)))
	      (remember-placeholder p)
	      (push p args))
	    (let ((d (create-temp-var "d_own")))
	      (push d own)
	      (push (**var/def d) args))))
      (let ((body (**app/l (**var/def var) (reverse args))))
	(return-type (if (null? own)
			 body
			 (**lambda/pat (map (function **var-pat/def) (reverse own)) body))
		     ntype)))))
