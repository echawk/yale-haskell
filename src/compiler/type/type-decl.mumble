;;; This deals with declarations (let & letrec).  The input is a list of
;;; declarations (valdefs) which may contain recursive-decl-groups, as
;;; introduced in dependency analysis.  This function alters the list
;;; of non-generic type variables.  Expressions containing declarations
;;; need to rebind the non-generic list around the decls and all expressions
;;; within their scope.

;;; This returns an updated decl list with recursive decl groups removed.

(define (type-decls decls)
  (cond ((null? decls)
	 '())
	((is-type? 'recursive-decl-group (car decls))
	 (let ((d (recursive-decl-group-decls (car decls))))
 	   (type-recursive-group d)
	   (append d (type-decls (cdr decls)))))
	(else
	 (type-non-recursive (car decls))
	 (cons (car decls)
	       (type-decls (cdr decls))))))

;;; A recursive group in which some bindings have type signatures (H98
;;; 4.4.1, 4.5.2): a reference to a variable with a signature does not
;;; make a dependency, so it is typed at its signature, which may be
;;; used polymorphically (polymorphic recursion).  Each signed variable
;;; gets its signature as its type first; the bindings without
;;; signatures are typed as a recursive group, then each signed binding
;;; on its own, its body seeing its own variable at the signature.

(define (type-recursive-group decls)
  (let ((signed    '())
	(unsigned  '()))
    (dolist (d decls)
      (if (signed-decl? d) (push d signed) (push d unsigned)))
    (if (null? signed)
	(type-recursive decls)
	(begin
	  (dolist (d signed)
	    (let ((var  (decl-var d)))
	      (setf (var-type var) (var-signature var))))
	  (when (not (null? unsigned))
	    (type-recursive (reverse unsigned)))
	  (dolist (d (reverse signed))
	    (type-non-recursive d '#t))))))

;;; A binding of a single variable that has a type signature.

(define (signed-decl? decl)
  (let ((vars  (collect-pattern-vars (valdef-lhs decl))))
    (and (pair? vars)
	 (null? (cdr vars))
	 (is-type? 'var-pat (valdef-lhs decl))
	 (not (eq? (var-signature (var-ref-var (car vars))) '#f)))))

;;; This typechecks a mutually recursive group of declarations (valdefs).
;;; Generate a monomorphic variable for each declaration and unify it with
;;; the lhs of the decl.  The variable all-vars collects all variables defined
;;; by the declaration group.  Save the values of placeholders and ng-list
;;; before recursing.

;;; The type of each variable is marked as recursive.

(define (type-recursive decls)
  (let ((old-ng (dynamic *non-generic-tyvars*))
	(old-placeholders (dynamic *placeholders*))
	(all-vars '())
	(new-tyvars '())
	(decls+tyvars '()))
    ;; on a type error set all types to `a' and give up.
    (setf (dynamic *placeholders*) '())
    (recover-type-error 
       (lambda (r)
	 (make-dummy-sigs decls)
	 (setf (dynamic *dict-placeholders*) old-placeholders)
	 (funcall r))
       ;; Type the lhs of each decl and then mark each variable bound
       ;; in the decl as recursive.
       (dolist (d decls)
        (fresh-type lhs-type
	  (push lhs-type (dynamic *non-generic-tyvars*))
	  (push lhs-type new-tyvars)
	  (type-decl-lhs d lhs-type)
	  (push (tuple d lhs-type) decls+tyvars))
	(dolist (var-ref (collect-pattern-vars (valdef-lhs d)))
	  (let ((var (var-ref-var var-ref)))
	    (push var all-vars)
	    (setf (var-type var)
		  (make recursive-type (type (var-type var))
			(placeholders '()))))))

;;; This types the decl right hand sides.  Each rhs type is unified with the
;;; tyvar corresponding to the lhs.  Before checking the signatures, the
;;; ng-list is restored.  

       ;; ScopedTypeVariables (scoped-tyvars.mumble)
       (let ((scoped '())
	     (polys '()))
	 (dolist (d decls+tyvars)
	   (let ((vs (map (function var-ref-var)
			  (collect-pattern-vars (valdef-lhs (tuple-2-1 d))))))
	     ;; a pattern binding's variables each by its own type
	     ;; (nonempty-containers' p0 :: NESet (Set a); p0@(NESet _ p0s) = ..)
	     (when (not (null? (cdr vs)))
	       (setf scoped (append (scoped-signatures
				     vs (map (lambda (v) (remove-recursive-type (var-type v)))
					     vs))
				    scoped)))
	     (when (null? (cdr vs))
	       (setf scoped (append (scoped-signatures
				     vs (list (remove-recursive-type
					       (tuple-2-2 d))))
				    scoped))
	       (when (var-pat? (valdef-lhs (tuple-2-1 d)))
		 (setf polys (append (polytype-arguments
				      (tuple-2-1 d) (car vs)
				      (remove-recursive-type (tuple-2-2 d)))
				     polys))))))
	;; the scoped type variables are the enclosing binding's: non-generic
	;; in its body (lo = toInteger (minBound :: i) in a where clause is
	;; not generalized over i)
	(dynamic-let ((*scoped-tyvars* (append scoped (dynamic *scoped-tyvars*)))
		      (*polytype-vars* (append polys (dynamic *polytype-vars*)))
		      (*non-generic-tyvars* (append (map (function tuple-2-2) scoped)
						    (dynamic *non-generic-tyvars*))))
	 (dolist (d decls+tyvars)
	   (let ((rhs-type (type-decl-rhs (tuple-2-1 d)))
		 (lhs-type (tuple-2-2 d)))
	     (type-unify lhs-type rhs-type
		   (type-mismatch (tuple-2-1 d)
			    "Decl type mismatch" lhs-type rhs-type))))))
       (setf (dynamic *non-generic-tyvars*) old-ng)
       (setf (dynamic *given-mp-constraints*) '())
       (let ((sig-contexts (check-user-signatures all-vars)))
	 (restrict-stuck-family-tyvars all-vars)
	 (apply-mono-local-binds all-vars (map (function var-type) all-vars))
	 (improve-mp-placeholders/given (dynamic *placeholders*)
					(dynamic *given-mp-constraints*))
	 ;; (before the overloaded variables are collected: improvement may
	 ;; unify them, Singleton a1 (NonEmpty a2) making a1 a2)
	 (improve-mp-placeholders (dynamic *placeholders*))

;;; This generalizes the signatures of recursive decls.  First, the
;;; context of the declaration group is computed.  Any tyvar in the
;;; bodies with a non-empty context must appear in all signatures that
;;; are non-ambiguous.
	  
	 (let* ((all-tyvars (collect-tyvars/l new-tyvars))
		(overloaded-tyvars '())
		(mp-constraints '()))
	   (dolist (tyvar all-tyvars)
	      (when (and (ntyvar-context tyvar) (not (non-generic? tyvar)))
		 (push tyvar overloaded-tyvars)))
	   (reconcile-sig-contexts overloaded-tyvars sig-contexts)
	   (improve-mp-placeholders (dynamic *placeholders*))
	   (setf mp-constraints
		 (mp-generalizable-constraints (dynamic *placeholders*)))
	 ;; We should probably also emit a warning about inherently
	 ;; ambiguous decls.
	   (when (and (or overloaded-tyvars mp-constraints)
		      (apply-pattern-binding-rule? decls))
		 (setf overloaded-tyvars
		       (lisp:remove-if (function non-generic?)
				       (restricted-tyvars all-tyvars)))
		 (setf (dynamic *non-generic-tyvars*)
		       (do-pattern-binding-rule
			decls
			(append overloaded-tyvars
				(mp-constraint-tyvars mp-constraints))
			old-ng))
		 (setf overloaded-tyvars '())
		 (setf mp-constraints '()))
	 ;; The next step is to compute the signatures of the defined
	 ;; variables and to define all recursive placeholders.  When
	 ;; there is no context the placeholders become simple var refs.
	 ;; and the types are simply converted.
	   (cond ((and (null? overloaded-tyvars) (null? mp-constraints))
		  (dolist (var all-vars)
		    (let ((r (var-type var)))
		      (setf (var-type var) (recursive-type-type (var-type var)))
		      (dolist (p (recursive-type-placeholders r))
		        (setf (recursive-placeholder-exp p)
			      (**var/def var)))
		      (generalize-type var))))
	 ;; When the declaration has a context things get very hairy.
	 ;; First, grap the recursive placeholders before generalizing the
	 ;; types.
		 (else
		  ;; Mark the overloaded tyvars as read-only.  This prevents
		  ;; signature unification from changing the set of tyvars
		  ;; defined in the mapping.
		  (dolist (tyvar overloaded-tyvars)
		     (setf (ntyvar-read-only? tyvar) '#t))
		  (let ((r-placeholders '()))
		    (dolist (var all-vars)
		     (let ((rt (var-type var)))
		      (dolist (p (recursive-type-placeholders rt))
			(push p r-placeholders))
		      (setf (var-type var) (recursive-type-type rt))))
	 ;; Now compute a signature for each definition and do dictionary
	 ;; conversion.  The var-map defines the actual parameter associated
	 ;; with each of the overloaded tyvars.
		    (let ((var-map (map (lambda (decl)
					 (tuple (decl-var decl)
					  (generalize-overloaded-type
					   decl overloaded-tyvars mp-constraints)))
					decls)))
	 ;; Finally discharge each recursive placeholder.
		      (dolist (p r-placeholders)
			(let ((ref-to (recursive-placeholder-var p))
			      (decl-from
			       (search-enclosing-decls
				 (recursive-placeholder-enclosing-decls p)
				 decls)))
			  (setf (recursive-placeholder-exp p)
				(recursive-mp-dict-args
				 (recursive-call-code decl-from ref-to var-map)
				 decl-from
				 (find-decl-of-var ref-to decls))))
			)))))
	   (setf (dynamic *placeholders*)
		 (process-placeholders
		  (dynamic *placeholders*) old-placeholders decls)))))))

;;; Non-recursive decls are easier.  Save the placeholders, use a fresh type
;;; for the left hand side, check signatures, and generalize.

;;; SIGNED?: the body sees the variable at its signature (type-recursive-group).

(define (main-var? vars)
  (and (pair? vars) (null? (cdr vars))
       (eq? (def-name (car vars)) '|main|)
       (eq? (def-module (car vars)) '|Main|)))

(define (type-non-recursive decl . signed?)
 (remember-context decl
  (fresh-type lhs-type
    (let ((old-placeholders (dynamic *placeholders*))
	  (all-vars (map (lambda (x) (var-ref-var x))
			    (collect-pattern-vars (valdef-lhs decl)))))
     (setf (dynamic *placeholders*) '())
     (recover-type-error
      (lambda (r)
        (make-dummy-sigs (list decl))
	(setf (dynamic *placeholders*) old-placeholders)
        (funcall r))
      (type-decl-lhs decl lhs-type)
      ;; ScopedTypeVariables (scoped-tyvars.mumble)
      (let ((scoped (if (null? (cdr all-vars))
			(scoped-signatures all-vars (list lhs-type))
			;; a pattern binding's variables each by its own type
			(scoped-signatures
			 all-vars
			 (map (lambda (v) (remove-recursive-type (var-type v)))
			      all-vars))))
	    ;; RankNTypes (polytypes.mumble)
	    (polys (if (and (null? (cdr all-vars)) (var-pat? (valdef-lhs decl)))
		       (polytype-arguments decl (car all-vars) lhs-type)
		       '())))
       (dynamic-let ((*scoped-tyvars* (append scoped (dynamic *scoped-tyvars*)))
		     (*polytype-vars* (append polys (dynamic *polytype-vars*)))
		     (*non-generic-tyvars* (append (map (function tuple-2-2) scoped)
						   (dynamic *non-generic-tyvars*))))
	(let ((rhs-type (if (and (pair? signed?) (car signed?)
				 (var-signature (car all-vars)))
			    (type-decl-rhs/at-signature decl all-vars)
			    (type-decl-rhs decl))))
	  (type-unify lhs-type rhs-type
	     (type-mismatch decl
		 "Decl type mismatch" lhs-type rhs-type)))))
      ;; Main.main has type IO t (H98 5): known before the monomorphism
      ;; restriction and defaulting, so main = return () is IO ()
      (when (and (haskell98?) (main-var? all-vars))
	(let ((io (**ntycon (core-symbol "IO") (list (**ntyvar)))))
	  (type-unify lhs-type io
	    (type-mismatch decl "main must have an IO type" lhs-type io))))
      (setf (dynamic *given-mp-constraints*) '())
      (check-user-signatures all-vars)
      (restrict-stuck-family-tyvars all-vars)
      (apply-mono-local-binds all-vars (list lhs-type))
      ;; multi-parameter constraints (mp-classes.mumble): improve by
      ;; functional dependencies, then those to generalize over, when
      ;; there is no signature to give them
      (improve-mp-placeholders/given (dynamic *placeholders*)
				     (dynamic *given-mp-constraints*))
      (improve-mp-placeholders (dynamic *placeholders*))
      (let* ((all-tyvars (collect-tyvars lhs-type))
	     (overloaded-tyvars '())
	     (sig-mcontext? (some (lambda (v)
				    (and (var-signature v)
					 (or (not (null? (gtype-mcontext (var-signature v))))
					     ;; AllowAmbiguousTypes: a context on a
					     ;; variable the type does not mention
					     ;; still takes a dictionary
					     (gtype-ambiguous-context? (var-signature v)))))
				  all-vars))
	     (mp-constraints (if (some (function var-signature) all-vars)
				 '()
				 (mp-generalizable-constraints
				  (dynamic *placeholders*)))))
	(dolist (tyvar all-tyvars)
	  (when (ntyvar-context tyvar)
	     (push tyvar overloaded-tyvars)))
	(when (and (or overloaded-tyvars mp-constraints)
		   (apply-pattern-binding-rule? (list decl)))
	 ;; the restriction keeps the constrained type variables
	 ;; monomorphic, those of a constraint on an application
	 ;; (Eq (t b), deferred on t) included
	 (setf overloaded-tyvars (restricted-tyvars all-tyvars))
	 (setf (dynamic *non-generic-tyvars*)
	   (do-pattern-binding-rule
	    (list decl)
	    (append overloaded-tyvars (mp-constraint-tyvars mp-constraints))
	    (dynamic *non-generic-tyvars*)))
	 (setf overloaded-tyvars '())
	 (setf mp-constraints '()))
	(if (and (null? overloaded-tyvars) (null? mp-constraints)
		 (not sig-mcontext?))
	    (dolist (var all-vars)
	      (generalize-type var))
	    (generalize-overloaded-type decl '() mp-constraints))
	(setf (dynamic *placeholders*)
	      (process-placeholders
	       (dynamic *placeholders*) old-placeholders (list decl)))))))))

;;; The right hand side typed with each variable of the binding at its
;;; signature, then given back the type its left hand side gave it.

(define (type-decl-rhs/at-signature decl vars)
  (let ((lhs-types (map (function var-type) vars)))
    (dolist (v vars)
      (setf (var-type v) (var-signature v)))
    (let ((rhs-type (type-decl-rhs decl)))
      (dolist2 (v vars) (ty lhs-types)
	(setf (var-type v) ty))
      rhs-type)))

;;; These functions type check definition components.

;;; This unifies the type of the lhs pattern with a type variable.

(define (type-decl-lhs object type)
 (dynamic-let ((*enclosing-decls* (cons object (dynamic *enclosing-decls*))))
  (remember-context object
   (type-check valdef lhs pat-type
    (type-unify type pat-type #f)))))


;;; This types the right hand side.  The *enclosing-decls* variable is
;;; used to keep track of which decl the type checker is inside.  This
;;; is needed for both defaulting (to find which module defaults apply)
;;; and recursive types to keep track of the dictionary parameter variables
;;; for recursive references.

(define (type-decl-rhs object)
 (dynamic-let ((*enclosing-decls* (cons object (dynamic *enclosing-decls*))))
  (remember-context object
   (type-check/unify-list valdef definitions res-type
       (type-mismatch/list object
	   "Right hand sides have different types")
       res-type))))


;;; This is similar to typing lambda.

(define-type-checker single-fun-def
 (dynamic-let ((*gadt-match* '#f)
	       (*gadt-refinements* '())
	       ;; pattern signatures bind type variables for this clause
	       (*scoped-tyvars* (dynamic *scoped-tyvars*)))
  (fresh-monomorphic-types (length (single-fun-def-args object)) tyvars
    (type-check/list single-fun-def args arg-types
      ;; a clause whose guards match a GADT constructor (a pattern
      ;; synonym's provided equality, pqueue's Zeroy): its constructor
      ;; patterns may be at the refined type, so each is typed apart and
      ;; related to its argument part by part (existentials.mumble)
      (when (gadt-guarded-clause? object)
	(setf arg-types (soft-pattern-types (single-fun-def-args object) arg-types)))
      (unify-list tyvars arg-types)
      ;; a GADT constructor matched (existentials.mumble)
      ;; the arguments' types are the signature's before the body is
      ;; checked (existentials.mumble's gadt-link-signature), so that a
      ;; local signature's scoped variables and a GADT's refinement see
      ;; them (nonempty-containers' p0 :: NESet (Set a) in powerSet)
      (gadt-link-signature arg-types (dynamic *gadt-match*))
      (when (dynamic *gadt-match*)
	(gadt-coerce-rhs-list (single-fun-def-rhs-list object)))
      (dynamic-let ((*gadt-soft-vars*
		     (if (dynamic *gadt-match*)
			 (append (gadt-pattern-vars (single-fun-def-args object))
				 (dynamic *gadt-soft-vars*))
			 (dynamic *gadt-soft-vars*)))
		    (*gadt-soft-uses* (dynamic *gadt-soft-uses*))
		    (*gadt-soft-decl*
		     (if (dynamic *gadt-match*)
			 (car (dynamic *enclosing-decls*))
			 (dynamic *gadt-soft-decl*))))
      (type-check/decls single-fun-def where-decls
        (type-check/unify-list single-fun-def rhs-list rhs-type
           (type-mismatch/list object
			"Bodies have incompatible types")
	  (return-type object (**arrow/l-2 arg-types rhs-type)))))))))


;;; These functions are part of the generalization process.

;;; TypeFamilies: a class constraint on a family application not decided
;;; yet (Ord (Item l) in go oc | oc <= 127 = [oc] under OverloadedLists)
;;; is not a context a type scheme can hold, so a binding without a
;;; signature is not generalized over the application's type variables:
;;; they stay the enclosing binding's, whose use decides the application
;;; and so the constraint (its placeholder is passed out to it).

;;; MonoLocalBinds (GHC; implied by TypeFamilies and GADTs): a local
;;; binding without a signature that is not closed, its type or its
;;; constraints mentioning an enclosing binding's type variables, is not
;;; generalized (Agda's recurse in instance PatternLike a (Pattern' a),
;;; whose constraint PatternLike a (Pattern' t) only a use resolves).
(define (apply-mono-local-binds vars types)
  (when (and (not (null? vars))
	     (not (null? (dynamic *enclosing-decls*)))   ; a local binding
	     (mono-local-binds-module? (car vars))
	     (not (some (function var-signature) vars)))
    (let* ((types (lisp:remove-if-not (lambda (ty) (or (ntyvar? ty) (ntycon? ty) (ntyapp? ty))) types))
	   (tyvars (collect-tyvars/l types)))
      ;; (mp-type-non-generic? sees an application's head too: m in
      ;; Pat t -> m (Pat t))
      (when (or (lisp:some (function mp-type-non-generic?) types)
		(lisp:some (lambda (p)
			     (and (mp-placeholder? p)
				  (lisp:some (function mp-type-non-generic?)
					     (mp-placeholder-types p))))
			   (dynamic *placeholders*)))
	(setf (dynamic *non-generic-tyvars*)
	      (append (lisp:remove-if (function non-generic?) tyvars)
		      (dynamic *non-generic-tyvars*)))))))

;;; Whether VAR's module has MonoLocalBinds, or TypeFamilies or GADTs.
(define (mono-local-binds-module? var)
  (let ((m (table-entry *modules* (def-module var))))
    (and m
	 (lisp:some (lambda (e) (mem-string e (module-extensions m)))
		    '("MonoLocalBinds" "TypeFamilies" "GADTs")))))

;;; A type variable this binding may generalize.
(define (non-generic-free? tv)
  (not (non-generic? tv)))

(define (restrict-stuck-family-tyvars vars)
  (when (not (some (function var-signature) vars))
    ;; a class at a family application (Show (Item l), from IsList's
    ;; toList): a flexible constraint, as a multi-parameter one, which
    ;; the binding is generalized over (Agda's local prRen)
    (setf (dynamic *placeholders*)
	  (map (lambda (p)
		 (let ((type (and (not (mp-placeholder? p)) (prune (placeholder-tyvar p)))))
		   (if (and type (ntycon? type) (family-app? (expand-ntype-synonym type))
			    (lisp:some (function non-generic-free?) (collect-tyvars type)))
		       (let ((q (**mp-placeholder
				 (if (dict-placeholder? p)
				     (dict-placeholder-class p)
				     (method-var-class (method-placeholder-method p)))
				 (list type)
				 (if (method-placeholder? p) (method-placeholder-method p) '#f)
				 (placeholder-enclosing-decls p)
				 (placeholder-overloaded-var p))))
			 (setf (placeholder-exp p) q)
			 q)
		       p)))
	       (dynamic *placeholders*)))
    (let ((tyvars '()))
      (dolist (p (dynamic *placeholders*))
	(let ((type (if (mp-placeholder? p)
			(and (null? (cdr (mp-placeholder-types p)))
			     (prune (car (mp-placeholder-types p))))
			(prune (placeholder-tyvar p)))))
	  (when (and type
		     (or (and (not (mp-placeholder? p))
			      (ntycon? type) (family-app? (expand-ntype-synonym type)))
			 ;; a constraint on an application of a type variable
			 ;; (Read (p b a)) in a local binding, which cannot
			 ;; hold it: its type variables stay the enclosing
			 ;; binding's, which can (a derived Read's helpers)
			 (and (ntyapp? type)
			      (ntyvar? (prune (ntyapp-fun type)))
			      (not (some (function var-toplevel?) vars)))))
	    (dolist (v (collect-tyvars type))
	      (when (not (memq v tyvars))
		(push v tyvars))))))
      (when (not (null? tyvars))
	(setf (dynamic *non-generic-tyvars*)
	      (append tyvars (dynamic *non-generic-tyvars*)))))))

;;; This function processes user signature declarations for the set of
;;; variables defined in a declaration.  Since unification of one signature
;;; may change the type associated with a previously verified signature,
;;; signature unification is done twice unless only one variable is
;;; involved.  The context of the signatures is returned to compare
;;; with the overall context of the declaration group.

(define (check-user-signatures vars)
  (cond ((null? vars)   ; a pattern binding of no variables: let _ = e
	 '())
	((null? (cdr vars))
	 (let* ((var (car vars))
		(sig (var-signature var)))
	   (if (eq? sig '#f)
	       '()
	       (list (tuple var (check-var-signature var sig))))))
	(else
	 (let ((sigs '()))
	   (dolist (var vars)
	     (let ((sig (var-signature var)))
	       (unless (eq? sig '#f)
		 (check-var-signature var sig))))
	   (dolist (var vars)
	     (let ((sig (var-signature var)))
	       (unless (eq? sig '#f)
		 (push (tuple var (check-var-signature var sig)) sigs))))
	   sigs))))


(define (check-var-signature var sig)
  (mlet (((sig-type sig-vars givens) (signature-instance-for-check var sig)))
    ;; the signature's multi-parameter constraints, for fundep
    ;; improvement before defaulting (mp-classes.mumble)
    (setf (dynamic *given-mp-constraints*)
	  (append givens (dynamic *given-mp-constraints*)))
    (dolist (tyvar sig-vars)
      (setf (ntyvar-read-only? tyvar) '#t))
    (type-unify (remove-recursive-type (var-type var)) sig-type
	     (signature-mismatch var))
    ;; ScopedTypeVariables: the body's scoped variables are the
    ;; signature's, those its type does not mention too
    (link-scoped-instance-tyvars var sig-vars
				 (lambda () (signature-mismatch var)))
    ;; GADTs: right-hand sides that need no refinement (existentials.mumble)
    (gadt-soft-unify var)
    (dolist (tyvar sig-vars)
      (setf (ntyvar-read-only? tyvar) '#f))
    sig-vars))

;;; The instance the body was checked against (existentials.mumble's
;;; shared-signature-instance), its variables still distinct variables
;;; (else the signature is too general), or a new one.
(define (signature-instance-for-check var sig)
  (let ((pre (lisp:gethash var *signature-instances*)))
    (if (not pre)
	(instantiate-gtype/mp sig)
	(begin
	  (lisp:remhash var *signature-instances*)
	  (setf *rigid-signature-tyvars*
		(lisp:set-difference *rigid-signature-tyvars* (cadr pre)))
	  (let ((vars (map (function prune) (cadr pre))))
	    (when (or (not (every (function ntyvar?) vars))
		      (not (eqv? (length (lisp:remove-duplicates vars)) (length vars))))
	      (type-error "Signature too general: ~A for the signature's variables of ~A."
			  vars (def-name var)))
	    (values (car pre) vars (caddr pre)))))))
  
;;; Once the declaration context is computed, it must be compared to the
;;; contexts given by the user.  All we need to check is that all tyvars
;;; constrained in the user signatures are also in the decl-context.
;;; All user supplied contexts are correct at this point - we just need
;;; to see if some ambiguous portion of the context exists.

;;; This error message needs work.  We need to present the contexts.

(define (reconcile-sig-contexts overloaded-tyvars sig-contexts)
  (dolist (sig sig-contexts)
    (let ((sig-vars (tuple-2-2 sig)))
      (dolist (d overloaded-tyvars)
	(when (not (memq d sig-vars))
	  (type-error
"Declaration signature has insufficiant context in declaration~%~A~%"
            (tuple-2-1 sig)))))))

;;; This is used for noisy type inference

(define (report-typing var)
 (when (memq 'type (dynamic *printers*))
  (let* ((name (symbol->string (def-name var))))
    (when (not (or (string-starts? "sel-" name)
		   (string-starts? "i-" name)
		   (string-starts? "default-" name)
		   (string-starts? "dict-" name)))
      (format '#t "~A :: ~A~%" var (var-type var))))))

;;; This is used during error recovery.  When a type error occurs, all
;;; variables defined in the enclosing declaration are set to type `a'
;;; and typing is resumed.

(define (make-dummy-sigs decls)
  (let ((dummy-type (make gtype (context '(()))
			        (type (**gtyvar 0)))))
    (dolist (d decls)
      (dolist (var-ref (collect-pattern-vars (valdef-lhs d)))
        (let ((var (var-ref-var var-ref)))
	  (setf (var-type var) dummy-type))))))


;;; This is used to generalize the variable signatures.  If there is
;;; an attached signature, the signature is used.  Otherwise the ntype
;;; is converted to a gtype.

(define (generalize-type var)
  (cond ((not (eq? (var-signature var) '#f))
	 (setf (var-type var) (var-signature var)))
	((gtype? (prune (var-type var)))
	 ;; RankNTypes: a variable a pattern binding takes from a polytype
	 ;; field (let R m' = f a, R's field forall b. ...) has that type
	 ;; already (polytypes.mumble)
	 (setf (var-type var) (prune (var-type var))))
	(else
	 (setf (var-type var) (ntype->gtype (var-type var)))))
  (report-typing var))
      
;;; For overloaded types, it is necessary to map the declaration context
;;; onto the generalized type.  User signatures may provide different but
;;; equivilant contexts for different declarations in a decl goup.

;;; The overloaded-vars argument allows ambiguous contexts.  This is not
;;; needed for non-recursive vars since the context cannot be ambiguous.

(define (generalize-overloaded-type decl overloaded-vars . maybe-mp)
  (let* ((var (decl-var decl))
	 (sig (var-signature var))
	 (mp-constraints (if (null? maybe-mp) '() (car maybe-mp)))
	 (new-tyvars '()))
    (cond ((eq? sig '#f)
	   (mlet (((gtype tyvars)
		   (if (null? mp-constraints)
		       (ntype->gtype/env (var-type var) overloaded-vars)
		       (ntype->gtype/mp (var-type var) overloaded-vars
					mp-constraints))))
	      (setf (var-type var) gtype)
	      (setf new-tyvars tyvars)))
	  (else
	   (mlet (((ntype tyvars givens) (instantiate-gtype/mp sig)))
	     (unify ntype (var-type var))
	     ;; ScopedTypeVariables: those only the context mentions too
	     (link-scoped-instance-tyvars var tyvars (lambda () '#f))
	     (forget-scoped-instance-tyvars var)
	     ;; a type variable only in the signature's multi-parameter
	     ;; constraints (t in (Show t, Stream s m t) => s -> m String)
	     ;; reaches the body's through the functional dependencies
	     (improve-mp-placeholders/given (dynamic *placeholders*) givens)
	     (setf (var-type var) sig)
	     (setf new-tyvars (prune/l tyvars)))))
    (report-typing var)
    (dictionary-conversion/definition decl new-tyvars)
    new-tyvars))

(define (remove-recursive-type ty)
  (if (recursive-type? ty)
      (recursive-type-type ty)
      ty))


(define (find-decl-of-var var decls)
  (cond ((null? decls) (error "Lost the decl of ~A." var))
	((eq? (decl-var (car decls)) var) (car decls))
	(else (find-decl-of-var var (cdr decls)))))

;;; The monomorphism restriction keeps the constrained type variables of
;;; TYVARS monomorphic: those with a context, those with a constraint on
;;; an application of them (Eq (t b), kept on t until t is known:
;;; unify.mumble's propagate-contexts/app), and the variables of such an
;;; application (b), which would otherwise be generalized while the
;;; constraint on them is not, leaving it nothing to resolve to.
(define (constrained-tyvars tyvars)
  (let ((in-apps '()))
    (dolist (tv tyvars)
      (dolist (ac (ntyvar-app-contexts tv))
	(dolist (v (collect-tyvars (tuple-2-1 ac)))
	  (push v in-apps))))
    (lisp:remove-if-not
     (lambda (tv)
       (or (not (null? (ntyvar-context tv)))
	   (not (null? (ntyvar-app-contexts tv)))
	   (memq tv in-apps)))
     (lisp:remove-duplicates (append tyvars in-apps)))))

;;; All that the restriction keeps monomorphic: the constrained type
;;; variables of the binding's type, and every type variable of the
;;; group's pending constraints, including one that appears in no type
;;; (x in `pt = do x <- many1 anyToken; ... show x', its type fixed later
;;; by a functional dependency): GHC leaves them all to be determined by
;;; the rest of the enclosing scope.
(define (restricted-tyvars tyvars)
  (let ((res (constrained-tyvars tyvars)))
    (dolist (p (dynamic *placeholders*))
      (dolist (v (if (mp-placeholder? p)
		     (lisp:mapcan (function collect-tyvars) (mp-placeholder-types p))
		     (collect-tyvars (placeholder-tyvar p))))
	(when (not (memq v res))
	  (push v res))))
    res))

;;; Whether gtype G has a context on a type variable its type does not
;;; mention (AllowAmbiguousTypes: k :: forall a. C a => Int).
(define (gtype-ambiguous-context? g)
  (let ((used (gtype-tyvar-nums (gtype-type g) '()))
	(i 0)
	(res '#f))
    (dolist (ctx (gtype-context g))
      (when (and (not (null? ctx)) (not (memv i used)))
	(setf res '#t))
      (incf i))
    res))

(define (gtype-tyvar-nums ty acc)
  (cond ((gtyvar? ty) (cons (gtyvar-varnum ty) acc))
	((ntycon? ty)
	 (let ((a acc))
	   (dolist (x (ntycon-args ty)) (setf a (gtype-tyvar-nums x a)))
	   a))
	((gtype? ty) (gtype-tyvar-nums (gtype-type ty) acc))
	(else acc)))
