;;; existentials.mumble -- GHC's ExistentialQuantification
;;;
;;; data S = forall a. Show a => S a
;;;
;;; S has a hidden first field for each constraint of its existential
;;; context: the dictionary (tdecl/alg-syn.mumble's add-existential-fields,
;;; con-existential).  Its signature, Show a => a -> S, has only the
;;; visible fields.
;;;
;;; Construction (S x) passes the dictionaries, as a reference to an
;;; overloaded variable does: dictionary placeholders are applied to the
;;; constructor (existential-con-ref).
;;;
;;; A pattern (S x) gives a a new rigid type variable, which must not be
;;; unified with any type (read-only), and the hidden fields are bound to
;;; variables that are a's dictionary parameters (ntyvar-dict-params), so
;;; that show x selects from the stored dictionary (existential-pcon).
;;; The type variable escaping the match is not checked.

;;; Returns the constructor reference with its dictionary placeholders,
;;; and its type.

(define (existential-con-ref object con)
  (mlet (((type tyvars) (instantiate-gtype/newvars (con-signature con))))
    (let ((exp object))
      (dolist (e (con-existential con))
	(let ((p (**dict-placeholder (tuple-2-1 e) (list-ref tyvars (tuple-2-2 e))
				     (dynamic *enclosing-decls*) object)))
	  (remember-placeholder p)
	  (setf exp (**app exp p))))
      (values exp type))))

;;; For a pattern K p1 ... pn: the constructor's type, its existential type
;;; variables made rigid with dictionary parameters, and the patterns for
;;; the hidden fields (var patterns of the dictionary variables).  Returns
;;; the type and the hidden patterns.

(define (existential-pcon con)
  (mlet (((type tyvars) (instantiate-gtype/newvars (con-signature con))))
    (let ((pats '())
	  (by-tyvar '()))
      (dolist (e (con-existential con))
	(let* ((tv (list-ref tyvars (tuple-2-2 e)))
	       (d (create-temp-var
		   (string-append "d_" (symbol->string (def-name (tuple-2-1 e))))))
	       (entry (assq tv by-tyvar)))
	  (setf (var-force-strict? d) '#t)
	  (setf (var-type d) (**ntyvar))
	  (push (**var-pat/def d) pats)
	  (if entry
	      (setf (cdr entry) (cons (tuple (tuple-2-1 e) d) (tuple-2-2 entry)))
	      (push (tuple tv (list (tuple (tuple-2-1 e) d))) by-tyvar))))
      (dolist (b by-tyvar)
	(let ((tv (tuple-2-1 b)))
	  (setf (ntyvar-read-only? tv) '#t)
	  (setf (ntyvar-existential? tv) '#t)
	  (push (tuple (car (dynamic *enclosing-decls*)) (tuple-2-2 b))
		(ntyvar-dict-params tv))))
      (values type (reverse pats)))))
;;; GADTs (GHC), the way RankNTypes are here: what GHC accepts runs,
;;; but less is checked.  A GADT constructor (parser/typedecl-parser
;;; .mumble's make-gadt-constr, con-gadt?) has its declared type, so a
;;; construction (IntE 3 :: Expr Int) is typed exactly.  A pattern
;;; matching it relates the scrutinee to T b1 ... bn, the b fresh: the
;;; constructor's result indices do not constrain it.  The clause or case
;;; alternative with such a pattern has its right-hand sides coerced
;;; (primUnsafeCoerce), so that eval (IntE n) = n and eval (BoolE b) = b
;;; have different types and both meet eval :: Expr a -> a.  A local
;;; type equality is not used, so a right-hand side whose type is
;;; ambiguous without it is defaulted.

(define *gadt-match* '#f)

;;; The constructor type for a pattern (result T b1 ... bn) and the
;;; patterns of its hidden dictionary fields.

(define (gadt-pcon con)
  (mlet (((type hidden) (if (null? (con-existential con))
			    (values (instantiate-gtype (con-signature con)) '())
			    (existential-pcon con))))
    (setf (dynamic *gadt-match*) '#t)
    (let ((alg  (con-alg con)))
      (values (**arrow/l-2
	       (arrow-argument-types type)
	       (**ntycon alg (map (lambda (v) (declare (ignore v)) (**ntyvar))
				  (algdata-tyvars alg))))
	      hidden))))

(define (gadt-coerce-rhs-list rhs-list)
  (dolist (g rhs-list)
    (setf (guarded-rhs-rhs g)
	  (**app (**var/def (prelude-prim-def '|primUnsafeCoerce|))
		 (guarded-rhs-rhs g)))))
