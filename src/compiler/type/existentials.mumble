;;; existentials.mumble -- GHC's ExistentialQuantification
;;;
;;; data S = forall a. Show a => S a
;;;
;;; S has a hidden first field for each constraint of its existential
;;; context: the dictionary (tdecl/alg-syn.mumble's add-existential-fields,
;;; con-existential).  Its signature, Show a => a -> S, has only the
;;; visible fields.
;;;
;;; Construction (S x) passes the dictionaries, as a reference to an
;;; overloaded variable does: dictionary placeholders are applied to the
;;; constructor (existential-con-ref).
;;;
;;; A pattern (S x) gives a a new rigid type variable, which must not be
;;; unified with any type (read-only), and the hidden fields are bound to
;;; variables that are a's dictionary parameters (ntyvar-dict-params), so
;;; that show x selects from the stored dictionary (existential-pcon).
;;; The type variable escaping the match is not checked.

;;; Returns the constructor reference with its dictionary placeholders,
;;; and its type.

(define (existential-con-ref object con)
  (mlet (((type tyvars) (instantiate-gtype/newvars (con-signature con))))
    (let ((exp object))
      (dolist (e (con-existential con))
	(let ((p (**dict-placeholder (tuple-2-1 e) (list-ref tyvars (tuple-2-2 e))
				     (dynamic *enclosing-decls*) object)))
	  (remember-placeholder p)
	  (setf exp (**app exp p))))
      (values exp type))))

;;; For a pattern K p1 ... pn: the constructor's type, its existential type
;;; variables made rigid with dictionary parameters, and the patterns for
;;; the hidden fields (var patterns of the dictionary variables).  Returns
;;; the type and the hidden patterns.

(define (existential-pcon con)
  (mlet (((type tyvars) (instantiate-gtype/newvars (con-signature con))))
    (let ((pats '())
	  (by-tyvar '())
	  (universal (con-result-tyvars type)))
      (dolist (e (con-existential con))
	(let* ((tv (list-ref tyvars (tuple-2-2 e)))
	       (d (create-temp-var
		   (string-append "d_" (symbol->string (def-name (tuple-2-1 e))))))
	       (entry (assq tv by-tyvar)))
	  (setf (var-force-strict? d) '#t)
	  (setf (var-type d) (**ntyvar))
	  (push (**var-pat/def d) pats)
	  (cond ((memq tv universal)
		 ;; a constraint on the result's variable (K :: NFData o =>
		 ;; .. -> T o, Agda's BackendWithOpts): given in the match,
		 ;; the variable still the scrutinee's
		 (push (list tv (tuple-2-1 e) d (car (dynamic *enclosing-decls*)))
		       *pattern-local-givens*))
		(entry
		 (setf (cdr entry) (cons (tuple (tuple-2-1 e) d) (tuple-2-2 entry))))
		(else
		 (push (tuple tv (list (tuple (tuple-2-1 e) d))) by-tyvar)))))
      (dolist (b by-tyvar)
	(let ((tv (tuple-2-1 b)))
	  (setf (ntyvar-read-only? tv) '#t)
	  (setf (ntyvar-existential? tv) '#t)
	  (push (tuple (car (dynamic *enclosing-decls*)) (tuple-2-2 b))
		(ntyvar-dict-params tv))))
      (values type (reverse pats)))))
;;; The constraints a match gives on the scrutinee's own type variables
;;; (a GADT-syntax constructor's NFData o, its result T o): (tyvar class
;;; dictionary-var decl) ..., consulted by unify.mumble's read-only check
;;; and dictionary.mumble.  The dictionary is bound only in the match's
;;; clause, where GHC lets the constraint be used.
(define *pattern-local-givens* '())

(define (pattern-local-given-classes type)
  (let ((type (prune type)))
    (lisp:mapcan (lambda (g) (if (eq? (prune (car g)) type) (list (cadr g)) '()))
		 *pattern-local-givens*)))

;;; (class . dictionary var) given at TYPE, for dict-reference-code; '().
(define (pattern-local-given-params type)
  (let ((type (prune type)))
    (lisp:mapcan (lambda (g) (if (eq? (prune (car g)) type) (list (tuple (cadr g) (caddr g))) '()))
		 *pattern-local-givens*)))

;;; The type variables a constructor type's result applies its type to.
(define (con-result-tyvars type)
  (let ((res (prune type)))
    (do () ((not (and (ntycon? res) (eq? (ntycon-tycon res) (core-symbol "Arrow")))))
      (setf res (prune (cadr (ntycon-args res)))))
    (if (ntycon? res)
	(lisp:remove-if-not (function ntyvar?) (map (function prune) (ntycon-args res)))
	'())))

;;; GADTs (GHC), the way RankNTypes are here: what GHC accepts runs,
;;; but less is checked.  A GADT constructor (parser/typedecl-parser
;;; .mumble's make-gadt-constr, con-gadt?) has its declared type, so a
;;; construction (IntE 3 :: Expr Int) is typed exactly.  A pattern
;;; matching it relates the scrutinee to T b1 ... bn, the b fresh: the
;;; constructor's result indices do not constrain it.  The clause or case
;;; alternative with such a pattern has its right-hand sides coerced
;;; (primUnsafeCoerce), so that eval (IntE n) = n and eval (BoolE b) = b
;;; have different types and both meet eval :: Expr a -> a.  A local
;;; type equality is not used, so a right-hand side whose type is
;;; ambiguous without it is defaulted.

(define *gadt-match* '#f)

;;; The pattern variables of a clause or alternative that matched a GADT
;;; constructor, while its right-hand sides are checked: a use's type is
;;; fresh, unified with the variable's part by part (gadt-soft-unify), so
;;; that the GADT's refinement (Refl :: Equal f (f b) b gives a ~ f b in
;;; gtraverse_ Refl (Rec1 x) = ... sequenceA x, generic-data) is not
;;; needed by the variable's type.
(define *gadt-soft-vars* '())
(define *gadt-soft-decl* '#f)   ; the declaration of the clause

;;; (those of a pattern with a GADT constructor in it are exactly typed by
;;; the constructor: eval (Add a b) = eval a + eval b)
(define (gadt-pattern-vars pats)
  (let ((refined (gadt-refined-tyvars)))
    (lisp:remove-if-not
     ;; only those whose type has a variable the match refines (aeson's
     ;; m1 beside targs@(To1Args ..) keeps its type)
     ;; (or a polytype's, at its free variables: Agda's mapWithIndex f
     ;; (Cons p ps) = Cons (f Zero p) ..., f :: forall x. Index xs x ->
     ;; p x -> q x and the match refining xs)
     (lambda (v)
       (let ((ty (var-type v)))
	 (lisp:some (lambda (tv) (memq tv refined))
		    (ntype-free-tyvars (if (gtype? ty) (gtype-type ty) ty)))))
     (lisp:mapcan (lambda (p)
		    (if (pattern-has-gadt-con? p)
			'()
			(map (function var-ref-var) (collect-pattern-vars p))))
		  pats))))

;;; Whether a clause's guards (a view pattern's, a pattern synonym's)
;;; match a GADT constructor, and its declaration has a signature.
(define (gadt-guarded-clause? def)
  (and (gadt-signed-decl?)
       (lisp:some (lambda (grhs)
		    (let ((g (guarded-rhs-guard grhs)))
		      (and (is-type? 'pattern-guard g)
			   (lisp:some (lambda (q)
					(and (is-type? 'qual-generator q)
					     (pattern-has-gadt-con? (qual-generator-pat q))))
				      (pattern-guard-quals g)))))
		  (single-fun-def-rhs-list def))))

(define (gadt-signed-decl?)
  (let ((decl (car (dynamic *enclosing-decls*))))
    (and (valdef? decl)
	 (let ((vs (collect-pattern-vars (valdef-lhs decl))))
	   (and (not (null? vs)) (null? (cdr vs))
		(var-signature (var-ref-var (car vs))))))))

;;; The argument types, a constructor pattern's a fresh type related to
;;; the pattern's part by part when the signature is checked.
(define (soft-pattern-types pats types)
  (map (lambda (p ty)
	 (if (is-type? 'pcon p)
	     (let ((slot (**ntyvar)))
	       (push (list p (car (dynamic *enclosing-decls*)) ty slot)
		     (dynamic *gadt-cast-types*))
	       slot)
	     ty))
       pats types))

(define (pattern-has-gadt-con? p)
  (cond ((is-type? 'pcon p)
	 (or (con-gadt? (pcon-con p))
	     (lisp:some (function pattern-has-gadt-con?) (pcon-pats p))))
	((is-type? 'as-pat p) (pattern-has-gadt-con? (as-pat-pattern p)))
	((is-type? 'irr-pat p) (pattern-has-gadt-con? (irr-pat-pattern p)))
	((is-type? 'sig-pat p) (pattern-has-gadt-con? (sig-pat-pattern p)))
	((is-type? 'bang-pat p) (pattern-has-gadt-con? (bang-pat-pattern p)))
	((is-type? 'view-pat p) (pattern-has-gadt-con? (view-pat-pattern p)))
	((is-type? 'pp-pat-list p) (lisp:some (function pattern-has-gadt-con?) (pp-pat-list-pats p)))
	(else '#f)))

;;; The constructor type for a pattern (result T b1 ... bn) and the
;;; patterns of its hidden dictionary fields.

(define (gadt-pcon con)
  (mlet (((type hidden) (if (null? (con-existential con))
			    (values (instantiate-gtype (con-signature con)) '())
			    (existential-pcon con))))
    (setf (dynamic *gadt-match*) '#t)
    (let* ((alg  (con-alg con))
	   (scrutinee (**ntycon alg (map (lambda (v) (declare (ignore v)) (**ntyvar))
					 (algdata-tyvars alg)))))
      ;; the scrutinee's indices the constructor's result refines (not a
      ;; plain variable there): gadt-pattern-vars
      (push (tuple (refined-index-positions type) scrutinee)
	    (dynamic *gadt-refinements*))
      ;; an index the result has as a plain variable is the scrutinee's
      ;; (profunctors' Prep :: x -> p x a -> Prep p a: p and a)
      (link-unrefined-indices type scrutinee)
      (values (**arrow/l-2 (arrow-argument-types type) scrutinee)
	      hidden))))

(define *gadt-refinements* '())

(define (link-unrefined-indices con-type scrutinee)
  (let ((res (prune con-type)))
    (do () ((not (and (ntycon? res) (eq? (ntycon-tycon res) (core-symbol "Arrow")))))
      (setf res (prune (cadr (ntycon-args res)))))
    (when (and (ntycon? res)
	       (eqv? (length (ntycon-args res)) (length (ntycon-args scrutinee))))
      (let* ((args (map (function prune) (ntycon-args res)))
	     ;; a variable that is one index only (not Refl :: a :~: a's a,
	     ;; nor Equal f (f b) b's f and b)
	     (once (lisp:remove-if-not
		    (lambda (a)
		      (and (ntyvar? a)
			   (eqv? (lisp:count a args) 1)
			   (not (lisp:some (lambda (other)
					     (and (not (ntyvar? other))
						  (occurs-in-type a other)))
					   args))))
		    args)))
	(dolist2 (a args) (b (ntycon-args scrutinee))
	  (when (memq a once)
	    (type-unify a b '#f)))))))

;;; Whether a constructor type's result refines its type's indices: an
;;; argument not a plain variable, or a variable twice (Magma :: i -> a
;;; -> Magma i b b a, lens').
(define (gadt-result-refines? con-type)
  (let ((res (prune con-type)))
    (do () ((not (and (ntycon? res) (eq? (ntycon-tycon res) (core-symbol "Arrow")))))
      (setf res (prune (cadr (ntycon-args res)))))
    (and (ntycon? res)
	 (let ((args (map (function prune) (ntycon-args res))))
	   (lisp:some (lambda (a)
			(or (not (ntyvar? a)) (> (lisp:count a args) 1)))
		      args))
	 '#t)))

;;; The positions of a constructor type's result's arguments that are not
;;; a plain type variable (Refl :: Equal f (f b) b: 1).
(define (refined-index-positions con-type)
  (let ((res (prune con-type)))
    (do () ((not (and (ntycon? res) (eq? (ntycon-tycon res) (core-symbol "Arrow")))))
      (setf res (prune (cadr (ntycon-args res)))))
    (let ((i 0) (positions '()))
      (when (ntycon? res)
	(dolist (a (ntycon-args res))
	  (when (not (ntyvar? (prune a)))
	    (push i positions))
	  (incf i)))
      positions)))

;;; The type variables at the refined positions of the scrutinees matched.
(define (gadt-refined-tyvars)
  (let ((vars '()))
    (dolist (r (dynamic *gadt-refinements*))
      (let ((scrutinee (prune (tuple-2-2 r))))
	(when (ntycon? scrutinee)
	  (dolist (i (tuple-2-1 r))
	    (setf vars (append (ntype-free-tyvars (list-ref (ntycon-args scrutinee) i))
			       vars))))))
    vars))

(define (ntype-free-tyvars type)
  (let ((type (prune type)))
    (cond ((ntyvar? type) (list type))
	  ((ntycon? type) (lisp:mapcan (function ntype-free-tyvars) (ntycon-args type)))
	  ((ntyapp? type)
	   (append (ntype-free-tyvars (ntyapp-fun type))
		   (lisp:mapcan (function ntype-free-tyvars) (ntyapp-args type))))
	  (else '()))))

;;; A clause's argument types unified with its declaration's signature's,
;;; before its right-hand sides (as GHC checks against a signature), so
;;; that gadt-pattern-vars sees which variables the match refines.
;;; (FRESH-OK?: a GADT match, where an instance of the signature is used
;;; when the declaration's type is not yet the signature's; elsewhere a
;;; fresh instance's family applications, Mutable v, would not be tied to
;;; the signature's when it is checked: vector's freeze)
;;; The instance of VAR's signature its body is checked against, made once:
;;; (type tyvars givens), as instantiate-gtype/mp gives them.
(define *signature-instances* (lisp:make-hash-table :test (function lisp:eq)))
(define *rigid-signature-tyvars* '())

(define (shared-signature-instance var sig)
  (let ((pre (lisp:gethash var *signature-instances*)))
    (if pre
	(car pre)
	(mlet (((type tyvars givens) (instantiate-gtype/mp sig)))
	  (setf (lisp:gethash var *signature-instances*) (list type tyvars givens))
	  (setf *rigid-signature-tyvars* (append tyvars *rigid-signature-tyvars*))
	  type))))

(define (gadt-link-signature arg-types fresh-ok?)
  (let* ((decl (car (dynamic *enclosing-decls*)))
	 (var (and (valdef? decl)
		   (let ((vs (collect-pattern-vars (valdef-lhs decl))))
		     (and (not (null? vs)) (null? (cdr vs)) (var-ref-var (car vs))))))
	 (sig (and var (var-signature var)))
	 ;; the declaration's own type, once the signature's (a scoped
	 ;; signature is: scoped-tyvars.mumble's scoped-signatures, which
	 ;; then drops the signature)
	 (own (cond ((not var) '())
		    ;; checked at its signature (type-decl.mumble's
		    ;; type-decl-rhs/at-signature): its own type
		    ((and (gtype? (var-type var))
			  (assq var (dynamic *at-signature-lhs-types*)))
		     (arrow-argument-types
		      (tuple-2-2 (assq var (dynamic *at-signature-lhs-types*)))))
		    (else
		     (arrow-argument-types (remove-recursive-type (var-type var))))))
	 (sig-args (cond ((>= (length own) (length arg-types)) own)
			 ((and fresh-ok? sig (gtype? sig) (not (gtype-nested? sig)))
			  (arrow-argument-types (instantiate-gtype sig)))
			 ;; else the instance the signature is checked with
			 ;; (type-decl.mumble's check-var-signature), so that the
			 ;; body sees the signature's types and nothing ties them
			 ;; later (Agda's rf x = applySubst rho x, rho the
			 ;; enclosing binding's Substitution' Term)
			 ((and sig (gtype? sig) (not (gtype-nested? sig)))
			  (arrow-argument-types (shared-signature-instance var sig)))
			 (else '())))
	 (n (min (length sig-args) (length arg-types))))
    (dolist2 (a (list-head arg-types n)) (b (list-head sig-args n))
      (when (could-unify? a b 32)
	(type-unify a b '#f)))
    ;; the signature's result type there, for the clause's (or #f): a
    ;; polymorphic argument's given equality (p ~ (->), lens' conjoined)
    ;; is then on the signature's p, which the other arguments' types
    ;; have, before their functional dependencies improve them (singular)
    (and var sig (gtype? sig) (not (gtype-nested? sig))
	 (eqv? n (length arg-types))
	 (> (length sig-args) 0)
	 (eq? sig-args (if (>= (length own) (length arg-types)) own sig-args))
	 (let ((full (cond ((>= (length own) (length arg-types))
			    (if (assq var (dynamic *at-signature-lhs-types*))
				(tuple-2-2 (assq var (dynamic *at-signature-lhs-types*)))
				(remove-recursive-type (var-type var))))
			   ((not fresh-ok?) (shared-signature-instance var sig))
			   (else '#f))))
	   (and full (arrow-result-after full n))))))

(define (arrow-result-after type n)
  (let ((type (expand-ntype-synonym (prune type))))
    (cond ((eqv? n 0) type)
	  ((and (ntycon? type) (eq? (ntycon-tycon type) (core-symbol "Arrow")))
	   (arrow-result-after (cadr (ntycon-args type)) (1- n)))
	  (else '#f))))

(define (gadt-coerce-rhs-list rhs-list)
  (dolist (g rhs-list)
    (let ((c (make cast (exp (guarded-rhs-rhs g)))))
      (push c (dynamic *gadt-casts*))
      (setf (guarded-rhs-rhs g) c))))

;;; A coerced right-hand side's type and the clause's (the cast's), and
;;; the declaration: (cast decl inner outer).  When the declaration's
;;; signature is checked, each pair that can be unified without binding
;;; the signature's variables is (gadt-soft-unify): the coercion is for
;;; the GADT's type refinement (eval (IntE n) = n, at Expr a -> a), but a
;;; right-hand side that needs none gets its type from the signature as
;;; GHC's does, so that its constraints are not ambiguous
;;; (transformers-compat: gread (NonV4Read1Args rp rl) = coerceRec1 ...
;;; liftReadsPrec ..., whose Read1 f is the instance's).
(define *gadt-casts* '())
(define *gadt-cast-types* '())

(define (record-gadt-cast object inner outer)
  (when (memq object (dynamic *gadt-casts*))
    (push (list object (car (dynamic *enclosing-decls*)) inner outer)
	  (dynamic *gadt-cast-types*))))

(define (gadt-soft-unify var)
  (let ((keep '()))
    (dolist (entry (dynamic *gadt-cast-types*))
      (let ((decl (cadr entry)))
	(if (and (valdef? decl)
		 (memq var (map (function var-ref-var)
				(collect-pattern-vars (valdef-lhs decl)))))
	    (let ((inner (caddr entry))
		  (outer (cadddr entry)))
	      (if (eq? (car entry) 'coerce)
		  (coercible-unify inner outer 16)
		  (soft-unify-parts inner outer 16)))
	    (push entry keep))))
    (setf (dynamic *gadt-cast-types*) (reverse keep))))

;;; Coercible (Data.Coerce's coerce): its type a -> b, a and b related up
;;; to newtypes once the declaration's signature is checked, so that the
;;; argument's type is known (pqueue's coerce Q.mapEitherWithKey, from
;;; MinPQueue (Down k) to MaxPQueue k).

(define (coerce-var? var)
  (and (eq? (def-name var) '|coerce|)
       (memq (def-module var) '(|Data.Coerce| |GHC.Exts| |GHC.Prim|))
       '#t))

(define (record-coercion object type)
  (let ((type (prune type)))
    (when (and (ntycon? type) (eq? (ntycon-tycon type) (core-symbol "Arrow"))
	       (not (null? (dynamic *enclosing-decls*))))
      (push (list 'coerce (car (dynamic *enclosing-decls*))
		  (car (ntycon-args type)) (cadr (ntycon-args type)))
	    (dynamic *gadt-cast-types*)))))

;;; Unifies the parts that agree, through a newtype (on either side) whose
;;; head is not the other's: its field type at its arguments.
(define (coercible-unify t1 t2 depth)
  (let ((t1 (prune t1))
	(t2 (prune t2)))
    (cond ((<= depth 0) '#f)
	  ((could-unify? t1 t2 32)
	   (type-unify t1 t2 '#f))
	  ((and (ntycon? t1) (ntycon? t2)
		(eq? (ntycon-tycon t1) (ntycon-tycon t2))
		(eqv? (length (ntycon-args t1)) (length (ntycon-args t2))))
	   (if (eq? (ntycon-tycon t1) (core-symbol "Arrow"))
	       (dolist2 (a (ntycon-args t1)) (b (ntycon-args t2))
		 (coercible-unify a b (1- depth)))
	       ;; (a newtype's parameters may be phantom: only those that
	       ;; could be equal)
	       (dolist2 (a (ntycon-args t1)) (b (ntycon-args t2))
		 (coercible-unify a b (1- depth)))))
	  ((newtype-rep-ntype t1)
	   (coercible-unify (newtype-rep-ntype t1) t2 (1- depth)))
	  ((newtype-rep-ntype t2)
	   (coercible-unify t1 (newtype-rep-ntype t2) (1- depth)))
	  (else '#f))))

;;; A newtype application's field type at its arguments, or #f.
(define (newtype-rep-ntype type)
  (and (ntycon? type)
       (algdata? (ntycon-tycon type))
       (algdata-newtype? (ntycon-tycon type))
       (let ((alg (ntycon-tycon type)))
	 (and (not (null? (algdata-constrs alg)))
	      (eqv? (length (algdata-tyvars alg)) (length (ntycon-args type)))
	      (let* ((con (car (algdata-constrs alg)))
		     (ctype (instantiate-gtype (con-signature con)))
		     (args (arrow-argument-types ctype)))
		(and (null? (con-existential con))
		     (not (null? args))
		     (null? (cdr args))
		     (let ((res (prune ctype)))
		       (do () ((not (and (ntycon? res) (eq? (ntycon-tycon res) (core-symbol "Arrow")))))
			 (setf res (prune (cadr (ntycon-args res)))))
		       (and (could-unify? res type 32)
			    (begin (type-unify res type '#f) (car args))))))))))

;;; The types unified where they could be, part by part: m (U1 p) and
;;; ReadPrec a, a the signature's (generic-data's toReadPrec U1Leaf = pure
;;; U1), unify m with ReadPrec, so that pure's Applicative is not
;;; ambiguous, and leave U1 p and a (the GADT's refinement) apart.
(define (soft-unify-parts t1 t2 depth)
  (let ((t1 (prune t1))
	(t2 (prune t2)))
    (cond ((could-unify? t1 t2 32)
	   (type-unify t1 t2 '#f))
	  ((<= depth 0) '#f)
	  ((and (ntycon? t1) (ntycon? t2)
		(eq? (ntycon-tycon t1) (ntycon-tycon t2))
		(not (family-app? t1))
		(eqv? (length (ntycon-args t1)) (length (ntycon-args t2))))
	   (dolist2 (a (ntycon-args t1)) (b (ntycon-args t2))
	     (soft-unify-parts a b (1- depth))))
	  ((and (ntyapp? t1) (ntyapp? t2)
		(eqv? (length (ntyapp-args t1)) (length (ntyapp-args t2))))
	   (soft-unify-parts (ntyapp-fun t1) (ntyapp-fun t2) (1- depth))
	   (dolist2 (a (ntyapp-args t1)) (b (ntyapp-args t2))
	     (soft-unify-parts a b (1- depth))))
	  ((and (ntyapp? t1) (ntycon? t2) (not (family-app? t2))
		(>= (length (ntycon-args t2)) (length (ntyapp-args t1))))
	   (soft-unify-app-parts t1 t2 depth))
	  ((and (ntyapp? t2) (ntycon? t1) (not (family-app? t1))
		(>= (length (ntycon-args t1)) (length (ntyapp-args t2))))
	   (soft-unify-app-parts t2 t1 depth))
	  (else '#f))))

;;; f x1 .. xk against T t1 .. tn: f with T t1 .. t(n-k), each x with t.
(define (soft-unify-app-parts app con depth)
  (let* ((k (length (ntyapp-args app)))
	 (n (length (ntycon-args con)))
	 (head (**ntycon (ntycon-tycon con) (list-head (ntycon-args con) (- n k)))))
    (soft-unify-parts (ntyapp-fun app) head (1- depth))
    (dolist2 (a (ntyapp-args app)) (b (list-tail (ntycon-args con) (- n k)))
      (soft-unify-parts a b (1- depth)))))

;;; Whether the types unify, binding no read-only (a signature's)
;;; variable to anything but a free variable.  No side effects: the
;;; tentative bindings of free variables are kept in an alist, so that
;;; Refl :: c :~: c does not unify with b :~: a.
(define (scoped-ntyvar? tv)
  (or (lisp:some (lambda (b) (eq? (prune (tuple-2-2 b)) tv)) (dynamic *scoped-tyvars*))
      ;; or the variable of a signature's instance a body is checked
      ;; against (shared-signature-instance)
      (memq tv *rigid-signature-tyvars*)))

(define (could-unify? t1 t2 depth)
  (not (eq? (could-unify-1 t1 t2 depth '()) 'fail)))

(define (could-unify-1 t1 t2 depth env)
  (let ((t1 (could-unify-resolve (prune t1) env))
	(t2 (could-unify-resolve (prune t2) env)))
    (cond ((eq? env 'fail) 'fail)
	  ((<= depth 0) 'fail)
	  ((eq? t1 t2) env)
	  ;; (as unify: a monomorphic variable is not bound to a signature's:
	  ;; bifunctors' smash's go (One x) (One _) = p x)
	  ;; (nor is an enclosing signature's scoped type variable: Agda's
	  ;; coerce v :: t, t conApp's)
	  ((and (ntyvar? t1) (not (ntyvar-read-only? t1)) (not (scoped-ntyvar? t1)))
	   (if (or (occurs-in-type t1 t2) (monomorphic-to-signature? t1 t2))
	       'fail
	       (cons (cons t1 t2) env)))
	  ((and (ntyvar? t2) (not (ntyvar-read-only? t2)) (not (scoped-ntyvar? t2)))
	   (if (or (occurs-in-type t2 t1) (monomorphic-to-signature? t2 t1))
	       'fail
	       (cons (cons t2 t1) env)))
	  ((or (ntyvar? t1) (ntyvar? t2)) 'fail)
	  ((and (ntycon? t1) (ntycon? t2))
	   (if (and (eq? (ntycon-tycon t1) (ntycon-tycon t2))
		    (not (family-app? t1))
		    (eqv? (length (ntycon-args t1)) (length (ntycon-args t2))))
	       (could-unify-list (ntycon-args t1) (ntycon-args t2) depth env)
	       'fail))
	  ((and (ntyapp? t1) (ntyapp? t2)
		(eqv? (length (ntyapp-args t1)) (length (ntyapp-args t2))))
	   (could-unify-list (cons (ntyapp-fun t1) (ntyapp-args t1))
			     (cons (ntyapp-fun t2) (ntyapp-args t2)) depth env))
	  (else 'fail))))

(define (monomorphic-to-signature? var type)
  (and (ntyvar? type) (ntyvar-read-only? type) (not (ntyvar-existential? type))
       (non-generic? var)))

(define (could-unify-list l1 l2 depth env)
  (if (or (null? l1) (eq? env 'fail))
      env
      (could-unify-list (cdr l1) (cdr l2) depth
			(could-unify-1 (car l1) (car l2) (1- depth) env))))

;;; A variable's tentative binding, followed.
(define (could-unify-resolve type env)
  (if (and (ntyvar? type) (pair? env))
      (let ((b (assq type env)))
	(if b (could-unify-resolve (prune (cdr b)) env) type))
      type))
