
;;; File: type/unify.mumble   Author: John

;;; This is the basic unification algorithm used in type checking.

;;; Unification failure invokes the current type error handler

;;; Start by removing instantiated type variables from the type.

(define (unify type1 type2)
  (unify-1 (instance-if-polytype (prune type1))
	   (instance-if-polytype (prune type2))))

;;; RankNTypes: a polytype unifies as a new instance of itself (the
;;; argument given for it is not checked to be polymorphic).

(define (instance-if-polytype type)
  (if (and (gtype? type) (gtype-nested? type))
      (instantiate-polytype type)
      type))

;;; Whether a polymorphic argument being checked is given T1 ~ T2, a type
;;; variable one side (*local-mp-params*).
(define (local-type-equality? t1 t2)
  (and (or (ntyvar? t1) (ntyvar? t2))
       (lisp:some (lambda (param)
		    (let ((class (mp-param-class param))
			  (types (mp-param-types param)))
		      (and (class? class)
			   (type-equality-class? class)
			   (pair? types) (pair? (cdr types))
			   (or (and (mp-type-equal? (car types) t1)
				    (mp-type-equal? (cadr types) t2))
			       (and (mp-type-equal? (car types) t2)
				    (mp-type-equal? (cadr types) t1))))))
		  (dynamic *local-mp-params*))))

;;; The only real tweak here is the read-only bit on type variables.
;;; The rule is that a RO tyvar can be unified only with a generic
;;; non-RO tyvar which has the same or more general context.

;;; Aside from this, this is standard unification except that context
;;; propagation is needed when a tyvar with a non-empty context is
;;; instantiated.

;;; If type2 is a tyvar and type1 is not they are switched.

(define (unify-1 type1 type2)
    (cond ((eq? type1 type2)  ;; this catches variable to variable unify
	   'OK)
	  ((and (not (null? (dynamic *local-mp-params*)))
		(local-type-equality? type1 type2))
	   ;; an equality a polymorphic argument is given (p ~ (->)): holds
	   ;; inside it, nothing bound
	   'OK)
	  ((and (ntyvar? type1) (family-app? type2)
		(or (ntyvar-read-only? type1)
		    ;; (an enclosing signature's scoped variable is rigid:
		    ;; Agda's SubstArg a ~ t in a local signature, t the
		    ;; enclosing one's)
		    (scoped-ntyvar? type1)
		    (occurs-in-type type1 type2)
		    (not (eq? (reduce-family-app type2) 'stuck))))
	   ;; a variable and a type family application that reduces, or
	   ;; mentions it, or meets a signature's variable (TypeFamilies)
	   (unify-family type1 type2))
	  ;; TypeFamilies: the variable occurs in TYPE2 only inside family
	  ;; applications (m ~ ST (PrimState m)): those become new variables,
	  ;; the variable is bound, and each new variable is unified with
	  ;; its application, which may then reduce (PrimState (ST v) = v)
	  ((and (ntyvar? type1)
		(not (ntyvar-read-only? type1))
		(occurs-in-type type1 type2)
		(not (occurs-outside-families? type1 type2)))
	   (let* ((pending '())
		  (abstracted (abstract-family-apps type1 type2
				(lambda (v app) (push (tuple v app) pending)))))
	     (unify-1 type1 abstracted)
	     (dolist (p (reverse pending))
	       (unify-1 (tuple-2-1 p) (tuple-2-2 p)))
	     'OK))
	  ;; a synonym application the variable occurs in may expand to
	  ;; something it does not occur in (Agda's Arrows '[] b, a synonym
	  ;; for Foldr (->) b '[], is b): its expansion
	  ((and (ntyvar? type1)
		(ntycon? type2)
		(synonym? (ntycon-tycon type2))
		(not (synonym-family? (ntycon-tycon type2)))
		(occurs-in-type type1 type2)
		(not (eq? (expand-ntype-synonym type2) type2)))
	   (unify-1 type1 (prune (expand-ntype-synonym type2))))
	  ((ntyvar? type1)
	   (cond ((occurs-in-type type1 type2)
		  (type-error "Circular type: cannot unify ~A with ~A"
			      type1 type2))
		 ((ntyvar-read-only? type1)
		  (cond ((or (not (ntyvar? type2)) (ntyvar-read-only? type2))
			 (type-error
			  "Signature too general: cannot unify ~A with ~A"
			  type1 type2))
			(else
			 (unify-1 type2 type1))))
		 ((and (ntyvar? type2)
		       (ntyvar-read-only? type2)
		       (not (ntyvar-existential? type2))
		       (non-generic? type1))
		  (type-error
 "Type signature cannot be used: monomorphic type variables present."))
		 ;; (a rigid variable, a signature's instance's or a scoped one,
		 ;; is the one kept: the other may yet be bound to a family's
		 ;; application, Agda's substPattern')
		 ((and (ntyvar? type2) (not (ntyvar-read-only? type2))
		       (scoped-ntyvar? type1) (not (scoped-ntyvar? type2)))
		  (unify-1 type2 type1))
		 ;; (one that has dictionary parameters already, a signature's
		 ;; variable once generalized, is kept: its parameters are
		 ;; found through it, ce of Agda's prettyAs met by an
		 ;; equality solved after)
		 ((and (ntyvar? type2) (not (ntyvar-read-only? type2))
		       (not (null? (ntyvar-dict-params type1)))
		       (null? (ntyvar-dict-params type2)))
		  (unify-1 type2 type1))
		 (else
		  (instantiate-tyvar type1 type2)
		  (let ((classes (ntyvar-context type1))
			(pending (ntyvar-app-contexts type1)))
		    (when (not (null? pending))
		      (setf (ntyvar-app-contexts type1) '()))
		    (when (not (null? classes))
		      (propagate-contexts/ntype type1 type2 classes))
		    ;; Constraints on applications headed by this variable
		    ;; can now be checked.
		    (dolist (p pending)
		      (propagate-contexts/ntype
		       type1 (tuple-2-1 p) (tuple-2-2 p)))
		    'OK))))
	  ((ntyvar? type2)
	   (unify-1 type2 type1))
	  (else
	   (unify-nonvar type1 type2))))

;;; Neither type is a variable.  Each is a tycon application or an
;;; application of a type variable.

(define (unify-nonvar type1 type2)
  (cond ((and (ntyapp? type1) (over-applied-family-app? type2))
	 (unify-app-family type1 type2))
	((and (ntyapp? type2) (over-applied-family-app? type1))
	 (unify-app-family type2 type1))
	((or (family-app? type1) (family-app? type2))
	 (unify-family type1 type2))
	((and (ntycon? type1) (ntycon? type2))
	 (if (and (eq? (ntycon-tycon type1) (ntycon-tycon type2))
		  (not (phantom-synonym? (ntycon-tycon type1))))
	     (unify-args type1 type2)
	     (unify-expanded type1 type2)))
	((and (ntyapp? type1) (ntyapp? type2))
	 (unify-apps type1 type2))
	((ntyapp? type1)
	 (if (synonym? (ntycon-tycon type2))
	     (unify-expanded type1 type2)
	     (unify-app-con type1 type2)))
	(else
	 (if (synonym? (ntycon-tycon type1))
	     (unify-expanded type1 type2)
	     (unify-app-con type2 type1)))))

;;; A synonym with a parameter its body does not use (cmdargs' type AnyT t
;;; = Any): AnyT a and AnyT [a] are the same type, so it is expanded rather
;;; than its arguments unified.
(define (phantom-synonym? def)
  (and (synonym? def)
       (not (synonym-family? def))
       (synonym-body def)
       (let ((used (ast-tyvar-names (synonym-body def))))
	 (lisp:some (lambda (a) (not (memq a used))) (synonym-args def)))))

(define (unify-args type1 type2)
  (if (eqv? (length (ntycon-args type1)) (length (ntycon-args type2)))
      (unify-list (ntycon-args type1) (ntycon-args type2))
      (type-error "Type conflict: type ~A does not match ~A (kind mismatch)"
		  type1 type2)))

(define (unify-expanded type1 type2)
  (let ((etype1 (if (ntycon? type1) (expand-ntype-synonym type1) type1))
	(etype2 (if (ntycon? type2) (expand-ntype-synonym type2) type2)))
    (cond ((and (or (not (eq? etype1 type1)) (not (eq? etype2 type2)))
		(or (family-app? etype1) (family-app? etype2)))
	   ;; a synonym for a family application (Agda's StrictProducts as,
	   ;; Foldr StrictPair () as): unified as one, which may reduce
	   (unify-1 (prune etype1) (prune etype2)))
	  ((and (ntycon? etype1) (ntycon? etype2))
	   (if (same-tycon? (ntycon-tycon etype1) (ntycon-tycon etype2))
	       (unify-args etype1 etype2)
	       ;; This error message should probably show both the original
	       ;; and the expanded types for clarity.
	       (type-error "Type conflict: type ~A does not match ~A"
			   etype1 etype2)))
	(else
	 (unify-1 (prune etype1) (prune etype2))))))

;;; f a1 .. an  against  T b1 .. bm  with m >= n:  f = T b1 .. b(m-n)
;;; and the remaining arguments pair up.

;;; h b with Rep1 g a, the family applied to more than its arity: the
;;; extra arguments are an application, so h is Rep1 g and b is a.
(define (unify-app-family app fam)
  (let ((fun (prune (ntyapp-fun app))))
    (if (and (ntycon? fun) (family-app? fun))
	;; the function a family application itself (f e, f = Base t',
	;; with Base e e): the whole equation, Base t' e ~ Base e e, not
	;; Base t' ~ Base e, which loses e (recursion-schemes' lambek)
	(unify-family (**ntycon (ntycon-tycon fun)
				(append (ntycon-args fun) (ntyapp-args app)))
		      fam)
	(unify-app-family-1 app fam))))

(define (unify-app-family-1 app fam)
  (let* ((args (ntyapp-args app))
	 (n (length args))
	 (fargs (ntycon-args fam))
	 (arity (family-arity (ntycon-tycon fam)))
	 (extra (- (length fargs) arity)))
    (if (<= n extra)
	(begin
	  ;; (the function first: an argument may be an application of
	  ;; it, t4 (Base t5 t5) with Base t6 (t4 t5), where t4 is Base t6)
	  (unify (ntyapp-fun app)
		 (**ntycon (ntycon-tycon fam) (list-head fargs (- (length fargs) n))))
	  (unify-list args (list-tail fargs (- (length fargs) n))))
	(begin
	  (unify-list (list-tail args (- n extra)) (list-tail fargs arity))
	  (unify (apply-ntype (ntyapp-fun app) (list-head args (- n extra)))
		 (**ntycon (ntycon-tycon fam) (list-head fargs arity)))))))

(define (unify-app-con app con)
  (if (and (algdata? (ntycon-tycon con))
	   (algdata-data-family (ntycon-tycon con)))
      ;; a data instance (Vec:2, for Vec Bool) is its family application
      ;; here: f a is Vec Bool, f = Vec, a = Bool
      (unify-app-con-1 app (data-instance-family-app
			    (algdata-data-family (ntycon-tycon con)) con))
      (unify-app-con-1 app con)))

(define (unify-app-con-1 app con)
  (let* ((n (length (ntyapp-args app)))
	 (cargs (ntycon-args con))
	 (m (length cargs)))
    (if (< m n)
	(type-error "Type conflict: type ~A does not match ~A" app con)
	(begin
	  (unify-list (ntyapp-args app) (list-tail cargs (- m n)))
	  (unify (ntyapp-fun app)
		 (**ntycon (ntycon-tycon con) (list-head cargs (- m n))))))))

(define (unify-apps app1 app2)
  (let* ((args1 (ntyapp-args app1))
	 (args2 (ntyapp-args app2))
	 (n1 (length args1))
	 (n2 (length args2)))
    (cond ((eqv? n1 n2)
	   (unify-list args1 args2)
	   (unify (ntyapp-fun app1) (ntyapp-fun app2)))
	  ((> n1 n2)
	   (unify-list (list-tail args1 (- n1 n2)) args2)
	   (unify (apply-ntype (ntyapp-fun app1) (list-head args1 (- n1 n2)))
		  (ntyapp-fun app2)))
	  (else
	   (unify-list args1 (list-tail args2 (- n2 n1)))
	   (unify (ntyapp-fun app1)
		  (apply-ntype (ntyapp-fun app2) (list-head args2 (- n2 n1))))))))


(define-integrable (instantiate-tyvar tyvar val)
  (setf (ntyvar-value tyvar) val))

;;; This is needed since interface files may leave multiple def's
;;; for the same tycon sitting around.

(define (same-tycon? ty1 ty2)
  (or (eq? ty1 ty2)
      (and (eq? (def-name ty1) (def-name ty2))
	   (eq? (def-module ty1) (def-module ty2)))))


;;; unifies two lists of types pairwise.  Used for tycon args.

(define (unify-list args1 args2)
  (if (null? args1)
      'OK
      (begin (unify-list (cdr args1) (cdr args2))
	     (unify (car args1) (car args2)))))

;;; combines a list of types into a single type.  Used in constructs
;;; such as [x,y,z] and case expressions.

(define (unify-list/single-type types)
  (when (not (null? types))
    (let ((type (car types)))
      (dolist (type2 (cdr types))
        (unify type type2)))))

;;; This propagates the context from a just instantiated tyvar to the
;;; instantiated value.  If the value is a tycon, instances must be
;;; looked up.  If the value is a tyvar, the context is added to that of
;;; other tyvar.

;;; This is used to back out of the unification on errors.  This is a
;;; poor mans trail stack!  Without this, error messages get very
;;; obscure.

(define *instantiated-tyvar* '())

(define (propagate-contexts/ntype tyvar type classes)
 (dynamic-let ((*instantiated-tyvar* tyvar))
    (propagate-contexts/inner type classes)))

(define (propagate-contexts/inner type classes)
 (let ((type (prune type)))
  (if (ntyapp? type)
      (propagate-contexts/app type classes)
  (if (ntyvar? type)
      (if (ntyvar-read-only? type)
	  (if (or (context-implies? (ntyvar-context type) classes)
		  ;; or a given constraint family's constraint gives them
		  ;; (All Show '[a]: mp-classes.mumble's cfam-given-classes)
		  (context-implies? (append (ntyvar-context type) (cfam-given-classes type)
					    (given-classes-at-reduced type)
					    ;; or a method's own constraint on
					    ;; its class's variable, given at it
					    ;; (mp-context-keep?)
					    (given-classes-at-tyvar type)
					    ;; or a polymorphic argument's
					    ;; context (KnownNat n => r)
					    (local-given-classes-at-tyvar type)
					    ;; or a match on a constructor whose
					    ;; context gives it (existentials.mumble)
					    (pattern-local-given-classes type))
				    classes))
	      'OK ; no need for context propagation here
	      (begin 
		(setf (ntyvar-value (dynamic *instantiated-tyvar*)) '#f)
		(type-error "Signature context is too general")))
	  (let ((classes (if (null? (dynamic *local-mp-params*))
			     classes
			     ;; (not those a polymorphic argument being checked
			     ;; is given there: Top's Heuristic field gives
			     ;; Show info, from HasTypeGraph m info)
			     (let ((local (local-given-classes-at-tyvar type)))
			       (lisp:remove-if (lambda (c) (memq c local)) classes)))))
	    (if (null? (ntyvar-context type))
		(setf (ntyvar-context type) classes)
		(setf (ntyvar-context type)
		      (merge-contexts classes (ntyvar-context type))))))
      (let ((etype  (expand-ntype-synonym type)))
	(cond ((family-app? etype)
	       ;; undecided yet (TypeFamilies): the dictionaries are
	       ;; looked for when the placeholders are resolved
	       'OK)
	      ((ntycon? etype)
	       ;; (but those a polymorphic argument's context gives at the
	       ;; type: Given Int in reflection's give 5 (given + 1))
	       (let ((local (local-given-classes-at-type etype)))
		 (propagate-contexts-1
		  etype (lisp:remove-if (lambda (c) (memq c local)) classes))))
	      (else
	       ;; a family application that reduced to a variable
	       (propagate-contexts/inner etype classes))))))))

;;; A constraint on `f a' where f is a type variable cannot be resolved
;;; yet.  It is remembered with f and re-examined when f is instantiated.

(define (propagate-contexts/app type classes)
  (let ((head (prune (ntyapp-fun type))))
    (cond ((and (ntyvar? head) (ntyvar-read-only? head)
		(not (every (lambda (c) (or (given-app-constraint? c type)
					    ;; C (t a) gives it (its arguments'
					    ;; constraints found with the dictionary)
					    (app-catch-all-instance c)
					    ;; the given's at the head, the arguments
					    ;; still to unify (free's Read (w (CofreeF
					    ;; f a ..)), w unified before f)
					    (unify-with-given-app c type)))
			    classes)))
	   (setf (ntyvar-value (dynamic *instantiated-tyvar*)) '#f)
	   (type-error
	    "Signature context is too general: no instance for ~A" type))
	  ((ntyvar? head)
	   (setf (ntyvar-app-contexts head)
		 (cons (tuple type classes) (ntyvar-app-contexts head))))
	  (else
	   (propagate-contexts/inner (prune type) classes)))))

;;; The type has now been expanded.  This propagates each class constraint
;;; in turn.

(define (propagate-contexts-1 type classes)
  (dolist (class classes)
     (propagate-single-class type class)))

;;; Now we have a single class & data type.  Either an instance decl can
;;; be found or a type error should be signalled.  Once the instance
;;; decl is found, contexts are propagated to the component types.

(define (propagate-single-class type class)
  (if (given-app-constraint? class type)
      ;; given as is by the signature being checked (a flexible given,
      ;; Hilite (RenamingTo m) in Agda's FromAbstract): no instance is
      ;; chosen, even the only one for the type constructor
      'OK
      (propagate-single-class/instance type class)))

(define (propagate-single-class/instance type class)
  (let* ((instance (lookup-instance/type (ntycon-tycon type) class type))
	 (args (and instance
		    (or (instance-head-matches? instance type)
			(unify-with-only-instance-head instance type))
		    (instance-arg-types instance type))))
    (cond ((and instance (not args) (some-instance-head-could-match? instance type))
	   ;; several flexible instances (Stringalike String and
	   ;; Stringalike [PackedString]) that the type's undecided
	   ;; arguments may still choose between: left for dictionary
	   ;; resolution, when the type is known (permissive: the
	   ;; instance's context is not propagated)
	   'OK)
	  ((and instance (not (instance-head-matches? instance type)))
	   (setf (ntyvar-value (dynamic *instantiated-tyvar*)) '#f)
	   (type-error "Type ~A is not in class ~A: the instance is for ~A"
		       type class (make-instance-type instance)))
	  ((and (eq? instance '#f) (qc-given-matches? class (list type)))
	   ;; a given quantified constraint's head
	   'OK)
	  ((and (eq? instance '#f)
		;; given by the signature being checked (a flexible given,
		;; StringLike Text in ListLike's class)
		(lisp:some (lambda (g)
			     (and (eq? (tuple-2-1 g) class)
				  (null? (cdr (tuple-2-2 g)))
				  (mp-type-equal? (car (tuple-2-2 g)) type)))
			   (dynamic *given-mp-constraints*)))
	   'OK)
	  ((eq? instance '#f)
	   ;; This remove the instantiation which caused the type
	   ;; error - perhaps stop error propagation & make
	   ;; error message better.
	   (setf (ntyvar-value (dynamic *instantiated-tyvar*)) '#f)
	   (type-error "Type ~A is not in class ~A" type class))
	  ((not (eqv? (length (instance-gcontext instance))
		      (length args)))
	   (setf (ntyvar-value (dynamic *instantiated-tyvar*)) '#f)
	   (type-error "Kind mismatch: ~A cannot be in class ~A" type class))
	  (else
	   ;; The instance contains a list of class constraints for
	   ;; each argument.  This loop pairs the argument to the
	   ;; type constructor with the context required by the instance
	   ;; decl.
	   (dolist2 (classes (instance-gcontext instance))
		    (arg args)
	     (propagate-contexts/inner arg classes)))))
  'OK)

;;; Whether the signature being checked gives CLASS at TYPE, an
;;; application of a type variable (Monad (m s): util/signature.mumble's
;;; reduce-flexible-contexts keeps such constraints).
(define (given-app-constraint? class type)
  (or (qc-given-matches? class (list type))
   (lisp:some (lambda (g)
	       (and (or (eq? (tuple-2-1 g) class)
			;; a subclass given (Ord (f a) gives Eq (f a))
			(and (class? (tuple-2-1 g))
			     (memq class (class-super* (tuple-2-1 g)))))
		    (null? (cdr (tuple-2-2 g)))
		    (mp-type-equal? (car (tuple-2-2 g)) type)))
	     (dynamic *given-mp-constraints*))))

;;; CLASS at TYPE, an application of a signature's variable whose
;;; arguments are not all decided yet (unification binds a type's last
;;; argument first): when one given constraint is at an application of
;;; that variable whose arguments the type's could be, the type is
;;; unified with it.  #t if it was.
(define (unify-with-given-app class type)
  (let* ((head (prune (ntyapp-fun type)))
	 (args (ntyapp-args type))
	 (candidates
	  (lisp:remove-if-not
	   (lambda (g)
	     (and (or (eq? (tuple-2-1 g) class)
		      (and (class? (tuple-2-1 g))
			   (memq class (class-super* (tuple-2-1 g)))))
		  (null? (cdr (tuple-2-2 g)))
		  (let ((gt (prune (car (tuple-2-2 g)))))
		    (and (ntyapp? gt)
			 (eq? (prune (ntyapp-fun gt)) head)
			 (eqv? (length (ntyapp-args gt)) (length args))
			 (every (function given-arg-could-match?)
				args (ntyapp-args gt))))))
	   (dynamic *given-mp-constraints*))))
    (and (not (null? candidates))
	 (null? (cdr candidates))
	 (not (every (function mp-type-equal?)
		     args (ntyapp-args (prune (car (tuple-2-2 (car candidates)))))))
	 (begin
	   (dolist2 (a args) (ga (ntyapp-args (prune (car (tuple-2-2 (car candidates))))))
	     (unify a ga))
	   '#t))))

;;; Whether A could become GA: equal, or equal but for type variables
;;; still to be decided (not a signature's).
(define (given-arg-could-match? a ga)
  (let ((a (prune a)) (ga (prune ga)))
    (cond ((mp-type-equal? a ga) '#t)
	  ((and (ntyvar? a) (not (ntyvar-read-only? a))) '#t)
	  ((and (ntycon? a) (ntycon? ga))
	   (and (eq? (ntycon-tycon a) (ntycon-tycon ga))
		(eqv? (length (ntycon-args a)) (length (ntycon-args ga)))
		(every (function given-arg-could-match?) (ntycon-args a) (ntycon-args ga))))
	  ((and (ntyapp? a) (ntyapp? ga))
	   (and (given-arg-could-match? (ntyapp-fun a) (ntyapp-fun ga))
		(eqv? (length (ntyapp-args a)) (length (ntyapp-args ga)))
		(every (function given-arg-could-match?) (ntyapp-args a) (ntyapp-args ga))))
	  (else '#f))))

;;; A flexible head not matched yet because the type's arguments are still
;;; undecided (Map t a against instance C (Map Face a)): when this is the
;;; only instance of the class for the type constructor, any solution
;;; uses it, so the type is unified with the head.  #t if it was.

(define (unify-with-only-instance-head instance type)
  (and (not (null? (instance-head-args instance)))
       ;; not when an enclosing signature has a flexible given of the
       ;; class (Hilite (RenamingTo m) =>): the type may be the given's
       (not (enclosing-signature-gives? (instance-class instance)))
       ;; nor when the class has an instance at an application, which the
       ;; type may yet be (JHC's TextLike ShowS and TextLike (m a), at t ->
       ;; t: G Doc -> G Doc)
       (not (app-catch-all-instance (instance-class instance)))
       (null? (cdr (lisp:remove-if-not
		    (lambda (i) (eq? (instance-algdata i) (instance-algdata instance)))
		    (class-instances (instance-class instance)))))
       (mlet (((pattern vars) (ast->ntype/bindings (make-instance-type instance) '())))
	 (and (head-could-match? pattern type (map (function tuple-2-2) vars))
	      (begin
		(unify pattern type)
		(instance-head-matches? instance type))))))

(define (enclosing-signature-gives? class)
  (lisp:some
   (lambda (d)
     (and (valdef? d)
	  (lisp:some
	   (lambda (vr)
	     (let ((sig (var-signature (var-ref-var vr))))
	       (and (gtype? sig)
		    (lisp:some (lambda (c) (eq? (tuple-2-1 c) class))
			       (gtype-mcontext sig)))))
	   (collect-pattern-vars (valdef-lhs d)))))
   (dynamic *enclosing-decls*)))

(define (head-could-match? pattern type pvars)
  (let ((type (prune type)))
    (cond ((memq pattern pvars) '#t)
	  ((ntyvar? type) (not (ntyvar-read-only? type)))
	  ;; a family application not reduced yet may be anything ([Item
	  ;; t] against [Char], Agda's toHtml (List1.toList s))
	  ((and (family-app? type) (eq? (reduce-family-app type) 'stuck)) '#t)
	  ;; so may an application of a variable not known yet ((Name, t
	  ;; Type) against (Name, Dom' Term Type), Agda's addContext .
	  ;; distributeF)
	  ((and (ntyapp? type)
		(let ((head (prune (ntyapp-fun type))))
		  (and (ntyvar? head) (not (ntyvar-read-only? head)))))
	   '#t)
	  ((ntycon? pattern)
	   (let ((pattern (expand-ntype-synonym pattern))
		 (type (if (ntycon? type) (expand-ntype-synonym type) type)))
	     (and (ntycon? pattern) (ntycon? type)
		  (eq? (ntycon-tycon pattern) (ntycon-tycon type))
		  (eqv? (length (ntycon-args pattern)) (length (ntycon-args type)))
		  (lisp:every (lambda (p a) (head-could-match? p a pvars))
			 (ntycon-args pattern) (ntycon-args type)))))
	  (else '#f))))

;;; Whether some instance of INSTANCE's class for the type constructor
;;; could match TYPE once its type variables are decided.
(define (some-instance-head-could-match? instance type)
  (lisp:some
   (lambda (i)
     (and (eq? (instance-algdata i) (instance-algdata instance))
	  (instance-ok? i)
	  (mlet (((pattern vars) (ast->ntype/bindings (make-instance-type i) '())))
	    (head-could-match? pattern type (map (function tuple-2-2) vars)))))
   (class-instances (instance-class instance))))

;;; CLASS's instance C (t a), or #f.
(define (app-catch-all-instance class)
  (and (class? class)
       (lisp:find-if (lambda (i) (and (instance-catch-all? i) (instance-ok? i)
				      (pair? (cdr (instance-tyvars i)))))
		     (class-instances class))))

;;; An application's function and last argument, or #f.
(define (application-parts type)
  (let ((type (if (ntycon? type) (prune (expand-ntype-synonym type)) type)))
    (cond ((and (ntycon? type) (not (null? (ntycon-args type)))
		(not (family-app? type)))
	   (list (**ntycon (ntycon-tycon type) (lisp:butlast (ntycon-args type)))
		 (car (lisp:last (ntycon-args type)))))
	  ((and (ntyapp? type) (not (null? (ntyapp-args type))))
	   (list (if (null? (cdr (ntyapp-args type)))
		     (ntyapp-fun type)
		     (**ntyapp (ntyapp-fun type) (lisp:butlast (ntyapp-args type))))
		 (car (lisp:last (ntyapp-args type)))))
	  (else '#f))))

;;; The types an instance's tyvars stand for at TYPE (an ntycon of the
;;; instance's type constructor): its arguments, or for a flexible head
;;; (instance C [Char]) what matching the head binds (when
;;; instance-head-matches?).  A tyvar the head does not bind gets a fresh
;;; type variable.  (A list, possibly empty: not #f.)

(define (instance-head-matches? instance type)
  (or (and (instance-catch-all? instance)
	   (or (null? (cdr (instance-tyvars instance)))
	       (application-parts (prune type))))
      (null? (instance-head-args instance))
      (not (eq? (instance-head-bindings instance type) '#f))))

(define (instance-head-bindings instance type)
  (match-head-type (make-instance-type instance) type
		   (list (tuple '|%none| '|%none|))))

(define (instance-arg-types instance type)
  (cond ((and (instance-catch-all? instance) (pair? (cdr (instance-tyvars instance))))
	 ;; C (t a) at T x1 .. xn: T x1 .. xn-1 and xn
	 (let ((parts (application-parts (prune type))))
	   (if parts
	       (list (car parts) (cadr parts))
	       (list type type))))
	((instance-catch-all? instance) (list type))
	;; at a data instance of the family the instance is for
	((and (data-family-def? (instance-algdata instance))
	      (ntycon? type)
	      (not (eq? (ntycon-tycon type) (instance-algdata instance))))
	 (instance-arg-types instance
	   (data-instance-family-app (instance-algdata instance) type)))
	((null? (instance-head-args instance))
	 (ntycon-args type))
	(else
      (let ((b (instance-head-bindings instance type)))
	(map (lambda (v)
	       (let ((x (and b (assq v b))))
		 (if x (tuple-2-2 x) (**ntyvar))))
	     (instance-tyvars instance))))))

;;; The routines which handle contexts (merge-contexts and context-implies?)
;;; are in type-utils.  The occurs check is also there.


;;; TypeFamilies (util/type-utils.mumble): a family application is
;;; reduced first; when it cannot be yet, the equation is deferred, and
;;; tried again later (retry-family-equalities, before dictionaries are
;;; resolved).  An equation still undecided then is dropped: less is
;;; rejected than by GHC.

(define *deferred-family-equalities* '())

;;; Kept for a later try, unless it says nothing (the same type on both
;;; sides) or is kept already: an equality tried again and still undecided
;;; is kept again, and the copies filled the list (Agda.Syntax.Common's
;;; NameOf t1 ~ NameOf (t2 t1), compiled before Scope.Base, crowded out
;;; its AbstractName ~ Item t9, and allNamesInScope was ambiguous).
(define (defer-family-equality type1 type2)
  (let ((t1 (prune type1))
	(t2 (prune type2)))
    (unless (or (ntype-identical? t1 t2)
		(lisp:some (lambda (p)
			     (or (and (ntype-identical? (prune (car p)) t1)
				      (ntype-identical? (prune (cdr p)) t2))
				 (and (ntype-identical? (prune (car p)) t2)
				      (ntype-identical? (prune (cdr p)) t1))))
			   *deferred-family-equalities*))
      (push (cons type1 type2) *deferred-family-equalities*))))

(define (unify-family type1 type2)
  (let ((r1 (if (family-app? type1) (reduce-family-app type1) type1))
	(r2 (if (family-app? type2) (reduce-family-app type2) type2)))
    (cond ((and (eq? r1 'stuck) (eq? r2 'stuck)
		(same-head-over-applied-family? type1 type2))
	   ;; Rep1 w x with Rep1 w y: the same type (Rep1 w) applied to
	   ;; x and y, so x = y
	   (let ((arity (family-arity (ntycon-tycon type1))))
	     (unify-list (list-tail (ntycon-args type1) arity)
			 (list-tail (ntycon-args type2) arity))))
	  ((and (eq? r1 'stuck) (eq? r2 'stuck)
		(data-family-app? type1) (data-family-app? type2)
		(same-tycon? (ntycon-tycon type1) (ntycon-tycon type2)))
	   ;; a data family is injective
	   (unify-args type1 type2))
	  ;; a data family is injective: v s a with MVector s b is v =
	  ;; MVector s, a = b, as with a type constructor
	  ((and (eq? r1 'stuck) (data-family-app? type1) (ntyapp? type2))
	   (unify-app-con-1 type2 type1))
	  ((and (eq? r2 'stuck) (data-family-app? type2) (ntyapp? type1))
	   (unify-app-con-1 type1 type2))
	  ((and (eq? r1 'stuck) (data-family-app? type1) (ntycon? r2)
		(unify-data-family-instance type1 r2))
	   'OK)
	  ((and (eq? r2 'stuck) (data-family-app? type2) (ntycon? r1)
		(unify-data-family-instance type2 r1))
	   'OK)
	  ((and (not (eq? r1 'stuck)) (not (eq? r2 'stuck)))
	   (unify r1 r2))
	  ((not (eq? r1 'stuck))
	   (if (eq? r1 type1)
	       (defer-family-equality type1 type2)
	       (unify r1 type2)))
	  ((not (eq? r2 'stuck))
	   (if (eq? r2 type2)
	       (defer-family-equality type1 type2)
	       (unify type1 r2)))
	  (else
	   (defer-family-equality type1 type2)
	   'OK))))

;;; Both applications of one family to more arguments than it has, the
;;; family's own arguments the same types.
(define (same-head-over-applied-family? type1 type2)
  (and (family-app? type1) (family-app? type2)
       (eq? (ntycon-tycon type1) (ntycon-tycon type2))
       (let ((arity (family-arity (ntycon-tycon type1)))
	     (args1 (ntycon-args type1))
	     (args2 (ntycon-args type2)))
	 (and (> (length args1) arity)
	      (eqv? (length args1) (length args2))
	      (mp-types-equal? (list-head args1 arity) (list-head args2 arity))))))

(define (retry-family-equalities)
  ;; until none is decided: deciding one (Rep1 k y = Rep1 w (h x), with
  ;; k = w) may decide another (Rep1 h x = Rep1 w a, now h = w)
  (do ((progress? '#t) (n 0 (1+ n)))
      ((or (not progress?) (> n 20)) '#t)
    (let ((pairs *deferred-family-equalities*))
      (setf progress? '#f)
      (setf *deferred-family-equalities* '())
      (dolist (p pairs)
	(let ((t1 (prune (car p)))
	      (t2 (prune (cdr p))))
	  (if (or (and (family-app? t1) (not (eq? (reduce-family-app t1) 'stuck)))
		  (and (family-app? t2) (not (eq? (reduce-family-app t2) 'stuck)))
		  (same-head-over-applied-family? t1 t2))
	      (begin
		(setf progress? '#t)
		(unify t1 t2))
	      ;; still undecided: kept for a later try (a bounded number)
	      (when (< (length *deferred-family-equalities*) 500)
		(defer-family-equality t1 t2)))))
      ;; two undecided equalities with the same family application on
      ;; one side make their other sides equal (t ~ AbsOfRef (t, Elim)
      ;; and AbsOfRef (t, Elim) ~ Expr give t ~ Expr: Agda's foldM (curry
      ;; toAbstract) f elims)
      (when (and (not progress?) (join-family-equalities))
	(setf progress? '#t)))))

(define (join-family-equalities)
  (let ((seen '())
	(joined? '#f))
    ;; (either side, when both are: Base x x ~ Base t x and Base x x ~
    ;; Base t t give Base t x ~ Base t t, so x = t: recursion-schemes'
    ;; lambek = cata (fmap embed))
    (dolist (p *deferred-family-equalities*)
      (let ((t1 (prune (car p))) (t2 (prune (cdr p))))
	(dolist (side (list (tuple t1 t2) (tuple t2 t1)))
	  (let ((app (tuple-2-1 side))
		(other (tuple-2-2 side)))
	    (when (and (not joined?) (family-app? app))
	      (let ((before (lisp:find-if (lambda (s) (ntype-identical? (car s) app)) seen)))
		(if (and before (not (ntype-identical? (prune (cdr before)) (prune other))))
		    (begin
		      (unify (cdr before) other)
		      (setf joined? '#t))
		    (push (cons app other) seen))))))))
    joined?))

(define (data-family-app? type)
  (and (family-app? type) (eq? (synonym-family? (ntycon-tycon type)) 'data)))

;;; F args (a data family, stuck) against T ts, T the type of one of F's
;;; instances: the instance's equation is the only one giving T, so args
;;; are its patterns (fresh variables for theirs).  #f if T is no
;;; instance's type.
(define (unify-data-family-instance app type)
  (let ((eq (lisp:find-if (lambda (e)
			    (let ((rhs (tuple-2-2 e)))
			      (and (tycon? rhs)
				   (same-tycon? (tycon-def rhs) (ntycon-tycon type)))))
			  (synonym-equations (ntycon-tycon app)))))
    (and eq
	 (let ((env (map (lambda (v) (tuple v (**ntyvar)))
			 (lisp:remove-duplicates
			  (lisp:mapcan (function ast-type-tyvar-names) (tuple-2-1 eq))))))
	   (unify-list (ntycon-args app)
		       (map (lambda (p) (expand-ntype-synonym-1 p env)) (tuple-2-1 eq)))
	   (unify (expand-ntype-synonym-1 (tuple-2-2 eq) env) type)
	   '#t))))

(define (ast-type-tyvar-names type)
  (cond ((tyvar? type) (list (tyvar-name type)))
	((tycon? type) (lisp:mapcan (function ast-type-tyvar-names) (tycon-args type)))
	((tyapp? type)
	 (append (ast-type-tyvar-names (tyapp-fun type))
		 (lisp:mapcan (function ast-type-tyvar-names) (tyapp-args type))))
	(else '())))

;;; Whether TYVAR occurs in TYPE other than inside a type family
;;; application.
(define (occurs-outside-families? tyvar type)
  (let ((type (prune type)))
    (cond ((family-app? type) '#f)
	  ((gtype? type) (occurs-outside-families? tyvar (gtype-type type)))
	  ((gtyvar? type) '#f)
	  ((ntyvar? type) (eq? type tyvar))
	  ((ntyapp? type)
	   (or (occurs-outside-families? tyvar (ntyapp-fun type))
	       (lisp:some (lambda (a) (occurs-outside-families? tyvar a)) (ntyapp-args type))))
	  (else
	   (lisp:some (lambda (a) (occurs-outside-families? tyvar a)) (ntycon-args type))))))

;;; TYPE with each family application that mentions TYVAR replaced by a new
;;; variable; RECORD gets (variable application) for each.
(define (abstract-family-apps tyvar type record)
  (let ((type (prune type)))
    (cond ((and (family-app? type) (occurs-in-type tyvar type))
	   (let ((v (**ntyvar)))
	     (funcall record v type)
	     v))
	  ((ntyapp? type)
	   (**ntyapp (abstract-family-apps tyvar (ntyapp-fun type) record)
		     (map (lambda (a) (abstract-family-apps tyvar a record)) (ntyapp-args type))))
	  ((ntycon? type)
	   (**ntycon (ntycon-tycon type)
		     (map (lambda (a) (abstract-family-apps tyvar a record)) (ntycon-args type))))
	  (else type))))
