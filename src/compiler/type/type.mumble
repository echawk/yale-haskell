(define-compilation-unit type
  (source-filename "$Y2/src/compiler/type/")
  (require ast haskell-utils)
  (unit type-macros
        (source-filename "type-macros.mumble"))
  (unit unify
	(require type-macros)
	(source-filename "unify.mumble"))
  (unit type-main
	(require type-macros)
	(source-filename "type-main.mumble"))
  (unit type-decl
	(require type-macros)
	(source-filename "type-decl.mumble"))
  (unit dictionary
	(require type-macros)
	(source-filename "dictionary.mumble"))
  (unit mp-classes
	(require type-macros)
	(source-filename "mp-classes.mumble"))
  (unit default
	(require type-macros)
	(source-filename "default.mumble"))
  (unit pattern-binding
	(require type-macros)
	(source-filename "pattern-binding.mumble"))
  (unit type-vars
	(require type-macros)
	(source-filename "type-vars.mumble"))
  (unit expression-typechecking
	(require type-macros)
	(source-filename "expression-typechecking.mumble"))
  (unit type-error-handlers
	(require type-macros)
	(source-filename "type-error-handlers.mumble")))
