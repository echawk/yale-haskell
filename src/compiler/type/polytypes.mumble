;;; polytypes.mumble -- GHC's RankNTypes
;;;
;;; A type may contain a polytype, (forall a. t), as an argument or a
;;; field's type: a gtype with nested? set, whose own type variables are
;;; gtyvars -1, -2, ... (util/type-utils.mumble's type->gtype); copying the
;;; outer type replaces only the outer ones.
;;;
;;; Unifying a polytype with a type instantiates it first (unify.mumble):
;;; a function's polymorphic argument, a field's, runST's action, take a
;;; new instance each time.  So an argument given for a polytype without
;;; a context is not checked to be polymorphic enough, and a program GHC
;;; accepts runs the same.
;;;
;;; Inside a function whose signature gives an argument a polytype, the
;;; variable bound to that argument has the polytype itself as its type,
;;; and each use instantiates it (type-vars.mumble's var-ref): this is
;;; what lets app f = (f 1, f True) type check.
;;;
;;; A polytype may have a context, (forall s. Shape s => s -> Double).
;;; Its values take the dictionaries first, in the order an overloaded
;;; variable's do (type-vars.mumble's insert-dict-placeholders): for each
;;; of its type variables, for each class of its context.
;;;
;;;  - A use of a variable with that type instantiates it with the
;;;    context and applies it to dictionary placeholders
;;;    (instantiate-polytype/context).
;;;  - An argument given for it, in an application whose function's type
;;;    is known to take it, is checked against a rigid instance whose
;;;    type variables have new dictionary variables as their dictionary
;;;    parameters, as an existential pattern's do, and becomes a lambda
;;;    over them (type-check-polytype-argument).
;;;  - An application of an expression whose type is a polytype (a
;;;    field selector's result, runChurch n s z) instantiates it the
;;;    same way (polytype-function-instance).
;;;
;;; An argument given where the function's type is not yet known gets no
;;; dictionaries: such a function needs a signature, as in GHC.  Passing
;;; a polymorphic argument on (twice f = both f) gives (\d -> f d), which
;;; the optimizer eta-reduces to f (optimize.mumble's
;;; eta-reduce-dictionary-lambdas).  A constructor pattern's variable
;;; bound to a polytype field is polymorphic too (polytype-field-vars).

(define *polytype-vars* '())   ; (tuple var polytype)

(define (polytype? type)
  (and (gtype? type) (gtype-nested? type)))

(define (gtype-has-polytypes? g)
  (polytype-in? (gtype-type g)))

(define (polytype-in? type)
  (cond ((polytype? type) '#t)
	((ntycon? type) (lisp:some (function polytype-in?) (ntycon-args type)))
	((ntyapp? type) (lisp:some (function polytype-in?) (ntyapp-args type)))
	(else '#f)))

;;; Before a function's body is typed: when its signature has polytype
;;; arguments, its type is unified with the signature's instance, and
;;; the variables its clauses bind to those arguments get the polytypes.
;;; Returns the (tuple var polytype) bindings.

(define (rhs-lambda-pats def)
  (let ((rhs-list (single-fun-def-rhs-list def)))
    (if (and (not (null? rhs-list)) (null? (cdr rhs-list))
	     (is-type? 'omitted-guard (guarded-rhs-guard (car rhs-list)))
	     (is-type? 'lambda (guarded-rhs-rhs (car rhs-list))))
	(lambda-pats (guarded-rhs-rhs (car rhs-list)))
	'())))

(define (polytype-arguments decl var lhs-type)
  (let ((sig (or (var-signature var)
		 (lisp:values (lisp:gethash var *dropped-scoped-signatures*)))))
    (if (or (eq? sig '#f) (not (gtype-has-polytypes? sig)))
	'()
	(mlet (((inst _) (instantiate-gtype/newvars sig)))
	  (type-unify lhs-type inst '#f)
	  (let ((arg-types (arrow-argument-types inst))
		(result '()))
	    (dolist (def (valdef-definitions decl))
	      (do ((args (append (single-fun-def-args def)
				 ;; and a right-hand side's lambda's (f t unT
				 ;; = \f -> .., monad-control's defaultLiftWith)
				 (rhs-lambda-pats def))
			 (cdr args))
		   (types arg-types (cdr types)))
		  ((or (null? args) (null? types)))
		;; (and one whose type has a polytype in it, a function of a
		;; polymorphic argument: g f = f (return 3), f :: (forall n.
		;; Monad n => n Int) -> Maybe Int; var-pat's type checker)
		(when (and (var-pat? (car args))
			   (or (polytype? (car types)) (polytype-in? (car types))))
		  (push (tuple (var-ref-var (var-pat-var (car args))) (car types))
			result))))
	    result)))))

(define (arrow-argument-types type)
  (let ((type (prune type)))
    (if (and (ntycon? type) (eq? (ntycon-tycon type) (core-symbol "Arrow")))
	(cons (car (ntycon-args type))
	      (arrow-argument-types (cadr (ntycon-args type))))
	'())))

;;; ARG, given where a value of type EXPECTED is wanted, when it is a
;;; lambda: the (tuple var polytype) bindings for its variables bound to
;;; polytype arguments of EXPECTED, which then are polymorphic inside it,
;;; as in GHC (Copastro $ \n -> rmap f (h n), n :: forall x y. p x y -> r x y).

(define (lambda-polytype-vars arg expected)
  (let ((type (prune expected))
	(result '()))
    (when (polytype? type)
      (setf type (instantiate-polytype type)))
    (when (is-type? 'lambda arg)
      (do ((pats (lambda-pats arg) (cdr pats))
	   (types (arrow-argument-types type) (cdr types)))
	  ((or (null? pats) (null? types)))
	(let ((t1 (prune (car types))))
	  (when (and (polytype? t1) (var-pat? (car pats)))
	    (push (tuple (var-ref-var (var-pat-var (car pats))) t1) result)))))
    result))

;;; FN-TYPE's argument type when it is known to be a function type.

(define (known-argument-type fn-type)
  (let ((type (prune fn-type)))
    (and (ntycon? type)
	 (eq? (ntycon-tycon type) (core-symbol "Arrow"))
	 (car (ntycon-args type)))))

;;; f $ x, with the Prelude's $, is typed as f x, as GHC does: so that x
;;; may be given for a polytype argument of f (runST $ do ..).

(define (prelude-dollar-app? object)
  (and (app? object)
       (app? (app-fn object))
       (var-ref? (app-fn (app-fn object)))
       (let ((def (var-ref-var (app-fn (app-fn object)))))
	 (and (eq? (def-name def) '|$|)
	      (eq? (def-module def) '|Prelude|)))))

;;; A polytype with a non-empty context.

(define (constrained-polytype? type)
  (and (polytype? type)
       (or (lisp:some (lambda (c) (not (null? c))) (gtype-context type))
	   (not (null? (gtype-mcontext type))))))

;;; A new instance of the polytype G whose type variables have its
;;; context.  Returns the type, the type variables and its multi-parameter
;;; constraints as (class . ntypes).

(define (instantiate-polytype/context g)
  (let ((tyvars (map (lambda (c)
		       (let ((tv (**ntyvar)))
			 (setf (ntyvar-context tv) c)
			 tv))
		     (gtype-context g))))
    (values (copy-polytype-body (gtype-type g) tyvars)
	    tyvars
	    (polytype-mcontext-instance g tyvars))))

;;; With the classes' multi-parameter superclasses, transitively (Vector v a
;;; gives MVector (Mutable v) a; tdecl/class.mumble's mp-super-template).
(define (polytype-mcontext-instance g tyvars)
  (let* ((given (append
		 (map (lambda (c)
			(tuple (tuple-2-1 c)
			       (map (lambda (ty) (copy-polytype-body ty tyvars))
				    (tuple-2-2 c))))
		      (gtype-mcontext g))
		 ;; and those of its one-parameter classes, from their
		 ;; multi-parameter superclasses on (DeBruijn (SubstArg b) of
		 ;; Subst b, Agda's bind': util/signature.mumble's
		 ;; one-parameter-mp-superclasses)
		 (polytype-one-parameter-mp-supers g tyvars)))
	 (result given)
	 (work given)
	 (n 0))
    (do () ((or (null? work) (> n 64)) result)
      (let ((c (car work)))
	(setf work (cdr work))
	(incf n)
	(dolist (s (append (class-mp-mp-supers (tuple-2-1 c))
			   ;; a one-parameter class's one-parameter superclasses
			   ;; (util/signature.mumble's with-mp-mp-superclasses)
			   (if (mp-class? (tuple-2-1 c))
			       '()
			       (map (lambda (super) (tuple super (list 0)))
				    (lisp:remove-if-not
				     (lambda (super)
				       (and (class? super)
					    (not (null? (class-mp-mp-supers super)))))
				     (class-super* (tuple-2-1 c)))))))
	  (let ((types (map (lambda (p) (instantiate-mp-super-template/ntype
					 p (tuple-2-2 c)))
			    (tuple-2-2 s))))
	    (when (not (lisp:some (lambda (c2)
				    (and (eq? (tuple-2-1 c2) (tuple-2-1 s))
					 (mp-types-equal? (tuple-2-2 c2) types)))
				  result))
	      (let ((new (tuple (tuple-2-1 s) types)))
		(setf result (append result (list new)))
		(setf work (append work (list new)))))))))))

(define (instantiate-mp-super-template/ntype p types)
  (cond ((integer? p) (list-ref types p))
	((eq? (car p) '%app)
	 (apply-ntype (instantiate-mp-super-template/ntype (cadr p) types)
		      (map (lambda (a) (instantiate-mp-super-template/ntype a types))
			   (cddr p))))
	(else
	 (**ntycon (car p)
		   (map (lambda (a) (instantiate-mp-super-template/ntype a types))
			(cdr p))))))

;;; FN-TYPE's argument type when it is a function type whose argument is a
;;; constrained polytype, else #f.

(define (constrained-polytype-argument fn-type)
  (let ((type (prune fn-type)))
    (and (ntycon? type)
	 (eq? (ntycon-tycon type) (core-symbol "Arrow"))
	 (let ((arg (prune (car (ntycon-args type)))))
	   (and (constrained-polytype? arg) arg)))))

;;; Type checks ARG, given for the constrained polytype POLY: returns
;;; (\d1 ... dn -> arg), d1 ... dn its dictionaries.

(define (type-check-polytype-argument arg poly)
  (let ((tyvars '())
	(dict-pats '()))
    (dolist (classes (gtype-context poly))
      (let ((tv (**ntyvar))
	    (params '()))
	(setf (ntyvar-context tv) classes)
	(dolist (class classes)
	  (let ((d (create-temp-var
		    (string-append "d_" (symbol->string (def-name class))))))
	    (setf (var-type d) (**ntyvar))
	    (setf (var-force-strict? d) '#t)
	    (push (**var-pat/def d) dict-pats)
	    (push (tuple class d) params)))
	(when (not (null? params))
	  (setf (ntyvar-read-only? tv) '#t)
	  (push (tuple (car (dynamic *enclosing-decls*)) (reverse params))
		(ntyvar-dict-params tv)))
	(push tv tyvars)))
    (let* ((type (copy-polytype-body (gtype-type poly) (reverse tyvars)))
	   ;; then one for each multi-parameter constraint, given to the
	   ;; placeholders made inside (mp-classes.mumble's
	   ;; process-mp-placeholder)
	   (mp-params (map (lambda (c)
			     (let ((d (create-temp-var
				       (string-append "d_" (symbol->string
							    (def-name (tuple-2-1 c)))))))
			       (setf (var-type d) (**ntyvar))
			       (setf (var-force-strict? d) '#t)
			       (push (**var-pat/def d) dict-pats)
			       (list (tuple-2-1 c) (tuple-2-2 c) d)))
			   (polytype-mcontext-instance poly (reverse tyvars)))))
      (mlet (((arg1 arg-type)
	      (dynamic-let ((*polytype-vars*
			     (append (lambda-polytype-vars arg type)
				     (dynamic *polytype-vars*)))
			    (*local-mp-params*
			     (append mp-params (dynamic *local-mp-params*))))
		(dispatch-type-check arg))))
	(type-unify arg-type type
	  (type-mismatch arg
	    "The argument is not as polymorphic as its type requires"
	    arg-type type))
	(**lambda/pat (reverse dict-pats) arg1)))))

;;; In the application OBJECT, a function of type FN-TYPE: when it is a
;;; polytype, its instance with dictionary placeholders applied to the
;;; function.  Returns the type to apply.

(define (polytype-function-instance object fn-type)
  (let ((type (prune fn-type)))
    (if (polytype? type)
	(mlet (((ntype tyvars mps) (instantiate-polytype/context type)))
	  (setf (app-fn object)
		(insert-mp-placeholders
		 (insert-dict-placeholders (app-fn object) tyvars (app-fn object))
		 mps (app-fn object)))
	  ntype)
	fn-type)))

;;; In a constructor pattern, a variable bound to a field whose type is a
;;; polytype has the polytype as its type, as a polymorphic argument does.

(define (polytype-field-vars pats con-type)
  (do ((pats pats (cdr pats))
       (types (arrow-argument-types con-type) (cdr types)))
      ((or (null? pats) (null? types)))
    (let ((pat (car pats))
	  (type (prune (car types))))
      (when (and (polytype? type) (var-pat? pat))
	(setf (var-type (var-ref-var (var-pat-var pat))) type)))))

;;; The multi-parameter superclasses of G's one-parameter classes at TYVARS
;;; (Subst b gives DeBruijn (SubstArg b)), with those of their own
;;; superclasses, as (class . ntypes).
(define (polytype-one-parameter-mp-supers g tyvars)
  (let ((result '()))
    (dolist2 (classes (gtype-context g)) (tv tyvars)
      (dolist (c classes)
	(when (class? c)
	  (dolist (s (append (class-mp-mp-supers c)
			     (lisp:mapcan (lambda (super)
					    (if (class? super)
						(lisp:copy-list (class-mp-mp-supers super))
						'()))
					  (class-super* c))))
	    (let ((types (map (lambda (p) (instantiate-mp-super-template/ntype p (list tv)))
			      (tuple-2-2 s))))
	      (when (not (lisp:some (lambda (r)
				      (and (eq? (tuple-2-1 r) (tuple-2-1 s))
					   (mp-types-equal? (tuple-2-2 r) types)))
				    result))
		(push (tuple (tuple-2-1 s) types) result)))))))
    (reverse result)))
