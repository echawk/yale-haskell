;;; type/mp-classes.mumble -- multi-parameter type classes
;;;
;;; A constraint C t1 ... tn of a multi-parameter class lives apart from
;;; the one-parameter machinery, which keeps its constraints on type
;;; variables (ntyvar-context):
;;;  - a gtype's multi-parameter constraints are its mcontext, a list of
;;;    (class . gtypes) (util/type-utils: ast->gtype, instantiate-gtype/mp);
;;;  - a reference to an overloaded variable makes an mp-placeholder for
;;;    each (type-vars.mumble), for a dictionary or, for a method of the
;;;    class, the method;
;;;  - a binding with multi-parameter constraints in its type gets a
;;;    dictionary parameter for each (valdef-mp-dict-params, after the
;;;    one-parameter ones);
;;;  - when a binding is generalized (type-decl.mumble), each
;;;    mp-placeholder is resolved (process-mp-placeholder): by a dictionary
;;;    parameter of an enclosing binding, by an instance, or passed out to
;;;    the enclosing binding when it mentions its type variables.
;;;
;;; Functional dependencies (class-fundeps, positions from -> to) improve
;;; types: when a constraint's `from' types match a given constraint or an
;;; instance, its `to' types are unified with theirs.
;;;
;;; An instance's dictionary is an ordinary overloaded definition whose
;;; signature is the instance's context (tdecl/instance.mumble), so a
;;; dictionary reference is typed like any variable reference, which
;;; supplies its subdictionaries.

;;; Dictionary parameters: (class types var).

(define (mp-param-class p) (car p))
(define (mp-param-types p) (cadr p))
(define (mp-param-var p) (caddr p))

;;; A parameter for each multi-parameter constraint of a binding's
;;; generalized type; TYVARS are the binding's tyvars, by gtyvar number.

(define (mp-dict-params gmcontext tyvars)
  (map (lambda (c)
	 (let ((var (create-temp-var
		     (string-append "d_" (symbol->string (def-name (tuple-2-1 c)))))))
	   (setf (var-force-strict? var) '#t)
	   (list (tuple-2-1 c)
		 (map (lambda (g) (copy-gtype g tyvars)) (tuple-2-2 c))
		 var)))
       gmcontext))

;;; The positions of a class's types that are not determined by others
;;; (all of them without functional dependencies).

(define (mp-determining-positions class)
 (if (null? (class-tyvars class))
  ;; a one-parameter class at an application (Show (f a)): its type
  ;; (else every given Show (...) would match, and be unified with it)
  '(0)
  (let ((determined (mp-fundep-determined class 8)))
    (let ((res '()))
      (dotimes (i (length (class-tyvars class)))
	(when (not (memv i determined))
	  (push i res)))
      ;; each determined by another (Strict lazy strict | lazy -> strict,
      ;; strict -> lazy): all of them, or every instance would match
      (if (null? res)
	  (gtype-index-list (length (class-tyvars class)))
	  (nreverse res))))))

;;; The positions CLASS's functional dependencies decide, and those its
;;; multi-parameter superclasses' decide at its own variables
;;; (ListLikeProcessIO text char, class ListLikeIO text char =>, with
;;; ListLikeIO full item | full -> item: char).
(define (mp-fundep-determined class depth)
  (let ((determined '()))
    (dolist (fd (class-fundeps class))
      (setf determined (append (tuple-2-2 fd) determined)))
    (when (> depth 0)
      (dolist (s (class-mp-mp-supers class))
	(let ((templates (tuple-2-2 s)))
	  (when (and (class? (tuple-2-1 s)) (every (function integer?) templates))
	    (dolist (i (mp-fundep-determined (tuple-2-1 s) (1- depth)))
	      (when (< i (length templates))
		(push (list-ref templates i) determined)))))))
    determined))

;;; Structural equality of ntypes (tyvars by identity).

(define (mp-type-equal? t1 t2)
  (let ((t1 (reduce-mp-type t1))
	(t2 (reduce-mp-type t2)))
    (cond ((eq? t1 t2) '#t)
	  ((and (ntycon? t1) (ntycon? t2))
	   (and (eq? (ntycon-tycon t1) (ntycon-tycon t2))
		(mp-types-equal? (ntycon-args t1) (ntycon-args t2))))
	  ((and (ntyapp? t1) (ntyapp? t2))
	   (and (mp-type-equal? (ntyapp-fun t1) (ntyapp-fun t2))
		(mp-types-equal? (ntyapp-args t1) (ntyapp-args t2))))
	  (else '#f))))

(define (mp-types-equal? l1 l2)
  (cond ((null? l1) (null? l2))
	((null? l2) '#f)
	(else (and (mp-type-equal? (car l1) (car l2))
		   (mp-types-equal? (cdr l1) (cdr l2))))))

(define (mp-equal-at? positions types1 types2)
  (every (lambda (i) (mp-type-equal? (list-ref types1 i) (list-ref types2 i)))
	 positions))

;;; Does the type mention a type variable that is not an enclosing
;;; binding's?
(define (mp-type-generic? type)
  (some (lambda (v) (not (non-generic? v))) (collect-tyvars type)))

;;; Does the type mention a type variable of an enclosing binding?

(define (mp-type-non-generic? type)
  (let ((type (prune type)))
    (cond ((ntyvar? type) (non-generic? type))
	  ((ntycon? type) (some (function mp-type-non-generic?) (ntycon-args type)))
	  ((ntyapp? type)
	   (or (mp-type-non-generic? (ntyapp-fun type))
	       (some (function mp-type-non-generic?) (ntyapp-args type))))
	  (else '#f))))

;;;=====================================================================
;;; Instances
;;;=====================================================================

;;; The instance of CLASS whose head matches TYPES at the determining
;;; positions, and the bindings of its tyvars: (instance . bindings), or
;;; #f.  A binding is (tyvar-symbol . ntype).

(define (find-mp-instance class types)
  (let ((positions (mp-determining-positions class)))
    (find-mp-instance-1 (class-instances class) positions
			(map (function reduce-mp-type) types))))

;;; A synonym or family application reduced where it can be (MVec
;;; (Mutable Vector) a, from Vector's superclass, is MVec MVector a).
(define (reduce-mp-type type)
  (let ((type (prune type)))
    (if (ntycon? type)
	(let ((e (prune (expand-ntype-synonym type))))
	  (if (eq? e type) type (reduce-mp-type e)))
	type)))

(define (find-mp-instance-1 instances positions types)
  ;; of the instances whose heads match, the most specific (OVERLAPPING:
  ;; the most type constructors in its head)
  (let ((best '#f) (best-n -1))
    (dolist (inst instances)
      (let ((bindings (and (instance-ok? inst)
			   (not (null? (instance-mp-types inst)))
			   ;; (bindings start non-empty: '() is #f)
			   (match-mp-head positions (instance-mp-types inst)
					  types (list (tuple '|%none| '|%none|))))))
	(when (not (eq? bindings '#f))
	  (let ((n (head-specificity (instance-mp-types inst))))
	    (when (> n best-n)
	      (setf best (tuple inst bindings))
	      (setf best-n n))))))
    best))

;;; (a repeated variable counts too: (K1 i a) a is more specific than
;;; (K1 i a) b)
(define (head-specificity types)
  (let ((n 0)
	(vars '()))
    (dolist (ty types)
      (setf n (+ n (head-type-tycons ty)))
      (setf vars (head-type-tyvars ty vars)))
    (+ n (- (length vars) (length (lisp:remove-duplicates vars))))))

(define (head-type-tyvars ty vars)
  (cond ((tyvar? ty) (cons (tyvar-name ty) vars))
	((tycon? ty)
	 (let ((vs vars))
	   (dolist (a (tycon-args ty)) (setf vs (head-type-tyvars a vs)))
	   vs))
	((tyapp? ty)
	 (let ((vs (head-type-tyvars (tyapp-fun ty) vars)))
	   (dolist (a (tyapp-args ty)) (setf vs (head-type-tyvars a vs)))
	   vs))
	(else vars)))

(define (head-type-tycons ty)
  (cond ((tycon? ty)
	 (+ 1 (lisp:reduce (function +) (map (function head-type-tycons) (tycon-args ty))
			   :initial-value 0)))
	((tyapp? ty)
	 (+ (head-type-tycons (tyapp-fun ty))
	    (lisp:reduce (function +) (map (function head-type-tycons) (tyapp-args ty))
			 :initial-value 0)))
	(else 0)))

(define (match-mp-head positions heads types bindings)
  (if (null? positions)
      bindings
      (let ((b (match-head-type (list-ref heads (car positions))
				(list-ref types (car positions))
				bindings)))
	(and b (match-mp-head (cdr positions) heads types b)))))

;;; Matches an instance head type (an AST type) against an ntype; the
;;; extended bindings, or #f.  The head becomes an ntype whose tyvars are
;;; fresh pattern variables, matched structurally, type synonyms expanded
;;; on both sides.

(define (match-head-type head type bindings)
  (mlet (((pattern vars) (ast->ntype/bindings head '())))
    (let ((env (match-ntype pattern type (map (function tuple-2-2) vars)
			    (list (tuple '|%none| '|%none|)))))
      (if (eq? env '#f)
	  '#f
	  (bind-pattern-vars vars env bindings)))))

;;; env: (pattern-var . ntype), starting with a sentinel.
(define (match-ntype pattern type pvars env)
  (let ((type (prune type)))
    (cond ((eq? env '#f) '#f)
	  ((memq pattern pvars)
	   (let ((old (assq pattern env)))
	     (cond ((eq? old '#f) (cons (tuple pattern type) env))
		   ((mp-type-equal? (tuple-2-2 old) type) env)
		   (else '#f))))
	  ((ntycon? pattern)
	   (let ((pattern (expand-ntype-synonym pattern))
		 (type (if (ntycon? type) (expand-ntype-synonym type) type)))
	     (if (and (ntycon? pattern) (ntycon? type)
		      (eq? (ntycon-tycon pattern) (ntycon-tycon type))
		      (eqv? (length (ntycon-args pattern)) (length (ntycon-args type))))
		 (match-ntypes (ntycon-args pattern) (ntycon-args type) pvars env)
		 (if (ntycon? pattern)
		     '#f
		     (match-ntype pattern type pvars env)))))
	  ((ntyapp? pattern)
	   (cond ((ntyapp? type)
		  (match-ntypes (ntyapp-args pattern) (ntyapp-args type) pvars
				(match-ntype (ntyapp-fun pattern) (ntyapp-fun type)
					     pvars env)))
		 ;; v a against T t1 .. tn: v is T t1 .. t(n-k), a the rest
		 ;; (ListLike's FoldableLL (v a) a at a vector type)
		 ((and (ntycon? type)
		       (>= (length (ntycon-args type)) (length (ntyapp-args pattern))))
		  (let* ((k (length (ntyapp-args pattern)))
			 (n (length (ntycon-args type)))
			 (head (**ntycon (ntycon-tycon type)
					 (list-head (ntycon-args type) (- n k)))))
		    (match-ntypes (ntyapp-args pattern) (list-tail (ntycon-args type) (- n k))
				  pvars
				  (match-ntype (ntyapp-fun pattern) head pvars env))))
		 (else '#f)))
	  (else (if (eq? pattern type) env '#f)))))

(define (match-ntypes patterns types pvars env)
  (cond ((eq? env '#f) '#f)
	((null? patterns) (if (null? types) env '#f))
	((null? types) '#f)
	(else (match-ntypes (cdr patterns) (cdr types) pvars
			    (match-ntype (car patterns) (car types) pvars env)))))

;;; The head's tyvars (symbol . pattern-var) bound by ENV, into BINDINGS.
(define (bind-pattern-vars vars env bindings)
  (cond ((null? vars) bindings)
	((eq? bindings '#f) '#f)
	(else
	 (let ((b (assq (tuple-2-2 (car vars)) env)))
	   (bind-pattern-vars (cdr vars) env
	     (if (eq? b '#f)
		 bindings
		 (bind-head-tyvar (tuple-2-1 (car vars)) (tuple-2-2 b) bindings)))))))

(define (bind-head-tyvar sym type bindings)
  (let ((old (assq sym bindings)))
    (cond ((eq? old '#f) (cons (tuple sym type) bindings))
	  ((mp-type-equal? (tuple-2-2 old) type) bindings)
	  (else '#f))))

;;; An AST type as an ntype, its tyvars by BINDINGS; unbound tyvars get
;;; fresh ntyvars, added to the bindings.  Returns the type and bindings.

(define (ast->ntype/bindings type bindings)
  (cond ((tyvar? type)
	 (let ((b (assq (tyvar-name type) bindings)))
	   (if b
	       (values (tuple-2-2 b) bindings)
	       (let ((v (**ntyvar)))
		 (values v (cons (tuple (tyvar-name type) v) bindings))))))
	((tyapp? type)
	 (mlet (((fun b1) (ast->ntype/bindings (tyapp-fun type) bindings))
		((args b2) (ast->ntype/bindings/l (tyapp-args type) b1)))
	   (values (apply-ntype fun args) b2)))
	((forall-type? type)
	 ;; a nested polytype (an instance's quantified constraint): its own
	 ;; variables kept, the others the bindings'
	 (let* ((free (lisp:remove-duplicates
		       (lisp:remove-if (lambda (v) (memq v (forall-type-tyvars type)))
				       (append (ast-tyvar-names (forall-type-type type))
					       (lisp:mapcan (lambda (c)
							      (lisp:mapcan (function ast-tyvar-names)
									   (mp-context-types c)))
							    (forall-type-mcontext type))))))
		(b1 bindings)
		(vars (map (lambda (v)
			     (let ((b (assq v b1)))
			       (if b
				   (tuple-2-2 b)
				   (let ((tv (**ntyvar)))
				     (setf b1 (cons (tuple v tv) b1))
				     tv))))
			   free))
		(env '()))
	   (dolist (v free)
	     (mlet (((_ env1) (ast->gtyvar v env)))
	       (setf env env1)))
	   (mlet (((g _) (type->gtype type env)))
	     (values (copy-gtype g vars) b1))))
	(else
	 (mlet (((args b1) (ast->ntype/bindings/l (tycon-args type) bindings)))
	   (values (**ntycon (tycon-def type) args) b1)))))

(define (ast->ntype/bindings/l types bindings)
  (if (null? types)
      (values '() bindings)
      (mlet (((t1 b1) (ast->ntype/bindings (car types) bindings))
	     ((ts b2) (ast->ntype/bindings/l (cdr types) b1)))
	(values (cons t1 ts) b2))))

;;; The instance's head types at the non-determining positions, unified
;;; with TYPES (fundep improvement).  Returns the bindings.

(define (improve-from-instance inst bindings types . unified)
  ;; (UNIFIED: the positions to unify, a fundep's `to' when the instance
  ;; was found by its `from'; else those not determining it)
  (let ((determining (mp-determining-positions (instance-class inst)))
	(heads (instance-mp-types inst)))
    (dotimes (i (length types))
      (when (if (pair? unified)
		(memv i (car unified))
		(not (memv i determining)))
	(mlet (((head-type b) (ast->ntype/bindings (list-ref heads i) bindings)))
	  (setf bindings b)
	  (type-unify head-type (list-ref types i)
	    (type-error "The functional dependency of ~A requires ~A, not ~A."
			(instance-class inst) head-type (list-ref types i))))))
    bindings))

;;;=====================================================================
;;; Improvement
;;;=====================================================================

;;; Before a binding is generalized: types determined by a functional
;;; dependency are unified, with an instance or with another constraint
;;; of the same class agreeing on the determining types.  Repeated while
;;; something changes.

;;; The constraints of the signatures being checked, (class . ntypes)
;;; (type-decl.mumble's check-var-signature).
(define *given-mp-constraints* '())

;;; A family application stuck on a signature's variables that a given
;;; constraint's equality superclass decides, as GHC's given equalities:
;;; with ListLike text char given (item ~ Item full), Item text is char.
;;; The type it reduces to, or 'stuck (util/type-utils.mumble's
;;; reduce-family-app).
(define (given-family-reduction type)
  (or (lisp:some
       (lambda (g)
	 (let ((class (car g))
	       (types (cdr g)))
	   (and (class? class)
		(type-equality-class? class)
		;; oriented when both sides are applications (PrimState m1 ~
		;; PrimState m2, primitive's): the first reduces to the
		;; second, not back
		(cond ((ntype-identical? (car types) type) (cadr types))
		      ((and (ntype-identical? (cadr types) type)
			    (not (family-app? (prune (car types)))))
		       (car types))
		      (else '#f)))))
       (dynamic *given-mp-constraints*))
      (lisp:some
       (lambda (g)
	 (let ((class (car g))
	       (types (cdr g)))
	   (and (class? class)
		(lisp:some (lambda (e)
			     (and (given-template-matches? (cdr e) types type)
				  (list-ref types (car e))))
			   (class-equalities class)))))
       (dynamic *given-mp-constraints*))
      'stuck))

;;; PreludeModern's TypeEquality: an equality constraint on a family's
;;; application (parser/type-parser.mumble's apply-equalities).
(define (type-equality-class? class)
  (and (eq? (def-name class) '|TypeEquality|)
       (eq? (def-module class) '|PreludeModern|)))

;;; A wanted equality: its types unified, its dictionary ().  Where it is
;;; made (type-vars.mumble's insert-mp-placeholders, EAGER?), one with a
;;; side a family application that does not reduce yet waits until the
;;; placeholder is processed, when the binding's signature (SubstArg a ~
;;; a, Agda's composeS calling itself) may give it.
(define (solve-type-equality p . eager?)
  (when (type-equality-class? (mp-placeholder-class p))
    (let ((types (mp-placeholder-types p)))
      (when (not (and (not (null? eager?))
		      (lisp:some (function stuck-family-app?) types)))
	(type-unify (car types) (cadr types)
	  (type-error "The types ~A and ~A of an equality constraint do not match."
		      (car types) (cadr types)))
	(setf (placeholder-exp p) (**con/def (core-symbol "UnitConstructor")))))))

(define (stuck-family-app? type)
  (let ((type (prune type)))
    (and (family-app? type) (eq? (reduce-family-app type) 'stuck))))

;;; Structural equality of ntypes, nothing reduced (tyvars by identity).
(define (ntype-identical? t1 t2)
  (let ((t1 (prune t1)) (t2 (prune t2)))
    (cond ((eq? t1 t2) '#t)
	  ((and (ntycon? t1) (ntycon? t2))
	   (and (eq? (ntycon-tycon t1) (ntycon-tycon t2))
		(eqv? (length (ntycon-args t1)) (length (ntycon-args t2)))
		(every (function ntype-identical?) (ntycon-args t1) (ntycon-args t2))))
	  ((and (ntyapp? t1) (ntyapp? t2))
	   (and (ntype-identical? (ntyapp-fun t1) (ntyapp-fun t2))
		(eqv? (length (ntyapp-args t1)) (length (ntyapp-args t2)))
		(every (function ntype-identical?) (ntyapp-args t1) (ntyapp-args t2))))
	  (else '#f))))

;;; Whether TYPE is the class equality's template at a given's types
;;; (structurally, type variables by identity, nothing reduced).
(define (given-template-matches? template types type)
  (let ((type (prune type)))
    (if (integer? template)
	(eq? (prune (list-ref types template)) type)
	(and (ntycon? type)
	     (eq? (ntycon-tycon type) (car template))
	     (eqv? (length (ntycon-args type)) (length (cdr template)))
	     (every (lambda (p a) (given-template-matches? p types a))
		    (cdr template) (ntycon-args type))))))

;;; Fundep improvement against the signature's own constraints: a
;;; placeholder that agrees with a given one at the determining positions
;;; gets its other types.  Before defaulting, so that put 100 under
;;; MonadState Int m makes 100 an Int.

(define (improve-mp-placeholders/given placeholders givens)
  (when (not (null? givens))
    (dolist (p placeholders)
      (when (mp-placeholder? p)
	;; by the class's functional dependencies, or a superclass's
	;; (ListLikeProcessIO text char, without one of its own, has
	;; ListLikeIO full item | full -> item)
	(dolist (c (mp-constraint-closure (mp-placeholder-class p)
					  (mp-placeholder-types p)))
	  (let ((class (car c))
		(types (cdr c)))
	    (when (not (null? (class-fundeps class)))
	      (dolist (g givens)
		(when (and (eq? (tuple-2-1 g) class)
			   (mp-equal-at? (mp-determining-positions class)
					 (tuple-2-2 g) types))
		  (dolist2 (t1 (tuple-2-2 g)) (t2 types)
		    (type-unify t1 t2 '#f)))))))))))

;;; Whether TYVAR is at a position a functional dependency decides, in
;;; one of the deferred multi-parameter placeholders (or a superclass of
;;; one), from types the enclosing bindings have (non-generic).
(define (fundep-determined-by-non-generic? tyvar deferred)
  (lisp:some
   (lambda (q)
     (and (mp-placeholder? q)
	  (lisp:some
	   (lambda (c)
	     (let ((class (car c))
		   (types (cdr c)))
	       (lisp:some
		(lambda (fd)
		  (and (every (lambda (i) (mp-type-non-generic? (list-ref types i)))
			      (tuple-2-1 fd))
		       (lisp:some (lambda (i) (ntype-mentions-tyvar? (list-ref types i) tyvar))
				  (tuple-2-2 fd))))
		(if (class? class) (class-fundeps class) '()))))
	   (mp-constraint-closure (mp-placeholder-class q) (mp-placeholder-types q)))))
   deferred))

(define (ntype-mentions-tyvar? type tyvar)
  (let ((type (prune type)))
    (cond ((eq? type tyvar) '#t)
	  ((ntycon? type)
	   (lisp:some (lambda (a) (ntype-mentions-tyvar? a tyvar)) (ntycon-args type)))
	  ((ntyapp? type)
	   (or (ntype-mentions-tyvar? (ntyapp-fun type) tyvar)
	       (lisp:some (lambda (a) (ntype-mentions-tyvar? a tyvar)) (ntyapp-args type))))
	  (else '#f))))

;;; A multi-parameter constraint and its multi-parameter superclasses at
;;; its types, transitively: ((class . ntypes) ...).
(define (mp-constraint-closure class types)
  (let ((result (list (cons class types)))
	(work (list (cons class types)))
	(n 0))
    (do () ((or (null? work) (> n 32)))
      (let ((c (car work)))
	(setf work (cdr work))
	(incf n)
	(when (class? (car c))
	  (dolist (s (class-mp-mp-supers (car c)))
	    (let ((new (cons (tuple-2-1 s)
			     (map (lambda (p) (instantiate-mp-template/ntype p (cdr c)))
				  (tuple-2-2 s)))))
	      (when (not (assq (car new) result))
		(push new result)
		(setf work (append work (list new)))))))))
    result))

;;; tdecl/class.mumble's mp-super-template at ntypes.
(define (instantiate-mp-template/ntype p types)
  (if (integer? p)
      (list-ref types p)
      (**ntycon (car p) (map (lambda (a) (instantiate-mp-template/ntype a types))
			     (cdr p)))))

(define (improve-mp-placeholders placeholders)
  (let ((mps '()))
    (dolist (p placeholders)
      (when (and (mp-placeholder? p)
		 (not (null? (class-fundeps (mp-placeholder-class p)))))
	(push p mps)))
    (improve-mp-loop mps 50)))

;;; Repeats while types change; a type error can leave them changing, so
;;; there is a limit.

(define (improve-mp-loop mps limit)
  (let ((changed '#f))
    (dolist (p mps)
      (let* ((class (mp-placeholder-class p))
	     (types (mp-placeholder-types p))
	     (before (map (function mp-type-snapshot) types)))
	;; by each functional dependency: an instance whose head agrees at
	;; its `from' positions (strict -> lazy improves the lazy type from
	;; the strict one)
	(dolist (fd (class-fundeps class))
	  (let ((found (find-mp-instance-1 (class-instances class) (tuple-2-1 fd)
					   (map (function reduce-mp-type) types))))
	    (when found
	      (improve-through-instance (tuple-2-1 found) (tuple-2-2 found) types 8
					(tuple-2-2 fd)))))
	(dolist (q mps)
	  (when (and (not (eq? p q))
		     (eq? (mp-placeholder-class q) class))
	    (improve-by-fundeps class types (mp-placeholder-types q))))
	(when (not (equal? before (map (function mp-type-snapshot) types)))
	  (setf changed '#t))))
    (when (and changed (> limit 0))
      (improve-mp-loop mps (1- limit)))))

;;; Improvement by an instance's head, then by its context's
;;; multi-parameter constraints (instance MonadState s m => MonadState s
;;; (WriterT w m): MonadState Int (WriterT w (StateT t Identity)) makes t
;;; Int through the StateT instance), DEPTH levels deep.

(define (improve-through-instance inst bindings types depth . matched)
  (let ((bindings (if (pair? matched)
		      (improve-from-instance inst bindings types (car matched))
		      (improve-from-instance inst bindings types))))
    (when (> depth 0)
      (dolist (c (instance-mcontext inst))
	(let ((class (class-ref-class (mp-context-class c))))
	  (when (not (null? (class-fundeps class)))
	    (mlet (((ctypes _) (ast->ntype/bindings/l (mp-context-types c) bindings)))
	      (let ((found (find-mp-instance class ctypes)))
		(when found
		  (improve-through-instance (tuple-2-1 found) (tuple-2-2 found)
					    ctypes (1- depth)))))))))))

;;; For each fundep whose `from' types agree, unify the `to' types.
(define (improve-by-fundeps class types1 types2)
  (dolist (fd (class-fundeps class))
    (when (mp-equal-at? (tuple-2-1 fd) types1 types2)
      (dolist (i (tuple-2-2 fd))
	(type-unify (list-ref types1 i) (list-ref types2 i)
	  (type-error "The functional dependency of ~A requires ~A and ~A to agree."
		      class (list-ref types1 i) (list-ref types2 i)))))))

;;; A crude picture of a type, to notice that improvement changed it.
(define (mp-type-snapshot type)
  (let ((type (prune type)))
    (cond ((ntycon? type)
	   (cons (ntycon-tycon type) (map (function mp-type-snapshot) (ntycon-args type))))
	  ((ntyapp? type)
	   (cons (mp-type-snapshot (ntyapp-fun type))
		 (map (function mp-type-snapshot) (ntyapp-args type))))
	  (else type))))

;;;=====================================================================
;;; Generalization
;;;=====================================================================

;;; The multi-parameter constraints a binding without a signature is
;;; generalized over: those of PLACEHOLDERS that no instance resolves and
;;; that mention one of its own (generic) type variables, as distinct
;;; (class . types).  (A constraint mentioning only an enclosing
;;; binding's type variables is passed out to it.)

(define (local-mp-param-matches? p class types)
  (lisp:some (lambda (param)
	       (and (eq? (mp-param-class param) class)
		    (mp-equal-at? (mp-determining-positions class)
				  (mp-param-types param) types)))
	     (mp-placeholder-local-params p)))

(define (mp-generalizable-constraints placeholders)
  (let ((res '()))
    (dolist (p placeholders)
      (when (and (mp-placeholder? p)
		 (eq? (mp-placeholder-exp p) '#f))
	(let ((class (mp-placeholder-class p))
	      (types (mp-placeholder-types p)))
	  (when (and (some (function mp-type-generic?) types)
		     ;; (a quantified constraint is made where it is wanted)
		     (not (qc-class? class))
		     ;; a polymorphic argument's context gives it
		     ;; (process-mp-placeholder)
		     (not (local-mp-param-matches? p class types))
		     (eq? (find-mp-instance class types) '#f)
		     (not (some (lambda (c)
				  (and (eq? (tuple-2-1 c) class)
				       (mp-types-equal? (tuple-2-2 c) types)))
				res)))
	    (push (tuple class types) res)))))
    (nreverse res)))

;;; The tyvars of the constraints.
(define (mp-constraint-tyvars constraints)
  (let ((res '()))
    (dolist (c constraints)
      (dolist (ty (tuple-2-2 c))
	(dolist (v (collect-tyvars ty))
	  (when (not (memq v res))
	    (push v res)))))
    res))

;;; A gtype for a binding's type and inferred multi-parameter
;;; constraints: the type's tyvars as ntype->gtype/env numbers them
;;; (REQUIRED-VARS first), then any the constraints add.  Returns the
;;; gtype and the tyvars by gtyvar number.

(define (ntype->gtype/mp ntype required-vars constraints)
  (mlet (((gtype env) (ntype->gtype-1 ntype required-vars))
	 ((gmcontext env1) (mp-constraints->gtypes constraints env)))
    (values (make gtype (type gtype)
		        (context (map (lambda (x) (ntyvar-context x)) env1))
			(mcontext gmcontext))
	    env1)))

(define (mp-constraints->gtypes constraints env)
  (if (null? constraints)
      (values '() env)
      (mlet (((types env1) (ntype->gtype/l (tuple-2-2 (car constraints)) env))
	     ((rest env2) (mp-constraints->gtypes (cdr constraints) env1)))
	(values (cons (tuple (tuple-2-1 (car constraints)) types) rest) env2))))

;;;=====================================================================
;;; Resolution
;;;=====================================================================

;;; Resolves a multi-parameter placeholder (see process-placeholder in
;;; dictionary.mumble); returns the placeholders still to be resolved.

(define (process-mp-placeholder p deferred decls)
  (cond ((not (eq? (mp-placeholder-exp p) '#f))
	 deferred)
	((type-equality-class? (mp-placeholder-class p))
	 (solve-type-equality p)
	 deferred)
	((qc-class? (mp-placeholder-class p))
	 (process-qc-wanted p deferred decls))
	((class-constraint-family (mp-placeholder-class p))
	 (process-cfam-placeholder p deferred decls))
	((reducible-one-parameter-mp? p)
	 ;; a one-parameter class at a synonym or family application that
	 ;; reduces (Eq (Item [a]), from a signature's Eq (Item full):
	 ;; util/signature.mumble's apply-class-equalities): an ordinary
	 ;; placeholder at the reduced type
	 (let ((dp (**dict-placeholder (mp-placeholder-class p)
				       (reduce-mp-type (car (mp-placeholder-types p)))
				       (placeholder-enclosing-decls p)
				       (placeholder-overloaded-var p))))
	   (setf (placeholder-exp p) (mp-dict-use p dp))
	   (process-placeholder dp deferred decls)))
	(else
	 (process-mp-placeholder-1 p deferred decls))))

;;; A constraint family's constraint (Agda's All KillRange (Domains t)):
;;; the enclosing binding's, or the family application reduced, its
;;; dictionary that of the constraints it reduces to: () the unit, a tuple
;;; (c1, .., cn) the tuple of theirs, a class's its own (a class in a
;;; type is the literal %class:M.C: top/symbol-table.mumble's
;;; resolve-tycon), another family's as this one.  Stuck on the
;;; enclosing bindings' types: left for them.
(define (process-cfam-placeholder p deferred decls)
  (let* ((class (mp-placeholder-class p))
	 (types (mp-placeholder-types p))
	 (param (find-mp-param p class types decls)))
    (cond
     (param
      (setf (placeholder-exp p) (mp-dict-use p (**var/def (mp-param-var param))))
      deferred)
     ((cfam-given-component p class types decls)
      ;; part of a given one (All Show (a ': as) gives All Show as)
      (setf (placeholder-exp p) (mp-dict-use p (cfam-given-component p class types decls)))
      deferred)
     (else
	(let ((reduced (prune (expand-ntype-synonym
			       (**ntycon (class-constraint-family class) types)))))
	  (cond ((and (ntycon? reduced) (family-app? reduced))
		 (if (some (function mp-type-non-generic?) types)
		     (cons p deferred)
		     (begin (signal-unresolved-mp-constraint p) deferred)))
		(else
		 (let ((d (list deferred)))
		   (setf (placeholder-exp p)
			 (mp-dict-use p (cfam-dict-exp reduced p d decls)))
		   (car d)))))))))

;;; The one-parameter classes at type variable TYVAR that the signatures'
;;; constraint family constraints being checked give.
;;; The one-parameter classes the signature gives at a type that reduces
;;; to TYVAR: DeBruijn (SubstArg a), Subst a's superclass, with SubstArg a
;;; ~ a given (Agda's lookupS).
(define (given-classes-at-reduced tyvar)
  (let ((classes '()))
    (dolist (g (dynamic *given-mp-constraints*))
      (when (and (class? (car g))
		 (pair? (cdr g)) (null? (cddr g))
		 (not (eq? (prune (cadr g)) tyvar))
		 (eq? (reduce-mp-type (cadr g)) tyvar))
	(push (car g) classes)))
    classes))

(define (cfam-given-classes tyvar)
  (let ((classes '()))
    (dolist (g (dynamic *given-mp-constraints*))
      (let ((fam (and (class? (car g)) (class-constraint-family (car g)))))
	(when fam
	  (setf classes
		(cfam-component-classes
		 (prune (expand-ntype-synonym (**ntycon fam (cdr g)))) tyvar classes 8)))))
    classes))

(define (cfam-component-classes ty tyvar classes depth)
  (let ((ty (prune (if (ntycon? ty) (expand-ntype-synonym ty) ty))))
    (mlet (((c args) (constraint-type-class ty)))
      (cond ((and c (class? c) (not (class-constraint-family c))
		  (eqv? (length args) 1) (eq? (prune (car args)) tyvar))
	     (cons c classes))
	    ((and c (> depth 0) (class-constraint-family c))
	     (let ((r (prune (expand-ntype-synonym (**ntycon (class-constraint-family c) args)))))
	       (if (and (ntycon? r) (family-app? r))
		   classes
		   (cfam-component-classes r tyvar classes (1- depth)))))
	    ((and (ntycon? ty) (is-tuple-tycon? (ntycon-tycon ty)) (> depth 0))
	     (let ((cs classes))
	       (dolist (a (ntycon-args ty))
		 (setf cs (cfam-component-classes a tyvar cs (1- depth))))
	       cs))
	    (else classes)))))

;;; CLASS at TYPES out of a constraint family's constraint the enclosing
;;; binding is given (All Show (a ': as) gives Show a and All Show as):
;;; the expression selecting its dictionary there, or #f.
(define (cfam-given-component p class types decls)
  (let ((decl (find-enclosing-decl (placeholder-enclosing-decls p) decls)))
    (and decl
	 (lisp:some
	  (lambda (param)
	    (let ((fam (class-constraint-family (mp-param-class param))))
	      (and fam
		   (let ((reduced (prune (expand-ntype-synonym
					  (**ntycon fam (mp-param-types param))))))
		     (cfam-find-component reduced class types
					  (**var/def (mp-param-var param)) 8)))))
	  (valdef-mp-dict-params decl)))))

(define (cfam-find-component ty class types exp depth)
  (let ((ty (prune (if (ntycon? ty) (expand-ntype-synonym ty) ty))))
    (mlet (((c args) (constraint-type-class ty)))
      (cond ((and c (eq? c class) (eqv? (length args) (length types))
		  (every (function mp-type-equal?) args types))
	     exp)
	    ((and c (class? c) (eq? (length types) 1) (eqv? (length args) 1)
		  (null? (cdr (class-tyvars class)))
		  (memq class (class-super* c))
		  (mp-type-equal? (car args) (car types)))
	     ;; a subclass's dictionary (Ord a gives Eq a)
	     (**dsel/dict c class exp))
	    ((and c (> depth 0) (class-constraint-family c))
	     ;; a constraint family's, reduced
	     (let ((r (prune (expand-ntype-synonym (**ntycon (class-constraint-family c) args)))))
	       (and (not (and (ntycon? r) (family-app? r)))
		    (cfam-find-component r class types exp (1- depth)))))
	    ((and (ntycon? ty) (is-tuple-tycon? (ntycon-tycon ty)) (> depth 0))
	     (let ((n (length (ntycon-args ty)))
		   (i 0))
	       (lisp:some (lambda (a)
			    (let ((k i))
			      (incf i)
			      (cfam-find-component a class types (tuple-select-exp exp n k)
						   (1- depth))))
			  (ntycon-args ty))))
	    (else '#f)))))

;;; Component K of the N-tuple EXP.
(define (tuple-select-exp exp n k)
  (let ((vars (let ((l '())) (dotimes (i n) (push (create-temp-var "TS") l)) l)))
    (**case exp
	    (list (**alt/simple (**pcon/def (tuple-constructor n)
					    (map (function **var-pat/def) vars))
				(**var/def (list-ref vars k)))))))

;;; The dictionary for constraint type TY; D, a one-element list, collects
;;; the placeholders left.
(define (cfam-dict-exp ty p d decls)
  (let ((ty (prune (if (ntycon? ty) (expand-ntype-synonym ty) ty))))
    (mlet (((class args) (constraint-type-class ty)))
      (cond ((and (ntycon? ty) (eq? (ntycon-tycon ty) (core-symbol "UnitType")))
	     (**con/def (core-symbol "UnitConstructor")))
	    ((and (ntycon? ty) (is-tuple-tycon? (ntycon-tycon ty)))
	     (**tuple/l (map (lambda (a) (cfam-dict-exp a p d decls)) (ntycon-args ty))))
	    ((and class (null? (cdr (class-tyvars class))) (not (null? args)) (null? (cdr args)))
	     ;; a one-parameter class
	     (let ((q (**dict-placeholder class (car args)
					  (placeholder-enclosing-decls p)
					  (placeholder-overloaded-var p))))
	       (setf (car d) (process-placeholder q (car d) decls))
	       q))
	    (class
	     (let ((q (**mp-placeholder class args '#f
					(placeholder-enclosing-decls p)
					(placeholder-overloaded-var p))))
	       (setf (car d) (process-placeholder q (car d) decls))
	       q))
	    (else
	     (phase-error 'unresolved-mp-constraint
	       "The constraint ~A, from ~A, is not a class's."
	       ty (**mp-context (**class/def (mp-placeholder-class p)) (mp-placeholder-types p)))
	     (**con/def (core-symbol "UnitConstructor")))))))

;;; The class of a constraint type and its arguments: C t1 .. tn with C a
;;; class literal (%class:M.C, applied), or a constraint family's
;;; application; else #f.
(define (constraint-type-class ty)
  (let ((ty (prune ty)))
    (cond ((and (ntycon? ty) (family-app? ty) (constraint-family-class (ntycon-tycon ty)))
	   (values (constraint-family-class (ntycon-tycon ty)) (ntycon-args ty)))
	  ((and (ntycon? ty) (eq? (ntycon-tycon ty) (core-symbol "TypeSymbol"))
		(not (null? (ntycon-args ty))))
	   (values (class-literal-class (car (ntycon-args ty))) (cdr (ntycon-args ty))))
	  ((ntyapp? ty)
	   (mlet (((c args) (constraint-type-class (ntyapp-fun ty))))
	     (values c (append args (ntyapp-args ty)))))
	  (else (values '#f '())))))

;;; The class a %class:M.C literal (a promoted list of characters) names.
(define (class-literal-class lit)
  (let ((s (ntype-promoted-string lit)))
    (and s (string-starts? "%class:" s)
	 (or (let ((c (table-entry *class-literals* (string->symbol s)))) (and (class? c) c))
	 (let* ((qual (substring s 7 (string-length s)))
		(i (lisp:position #\. qual :from-end '#t))
		(mod (and i (string->symbol (substring qual 0 i))))
		(name (and i (string->symbol (substring qual (1+ i) (string-length qual)))))
		(m (and mod (table-entry *modules* mod)))
		(c (and m (table-entry (module-symbol-table m) name))))
	   (and (class? c) c))))))

;;; The characters of a promoted list of TypeChar literals, or #f.
(define (ntype-promoted-string ty)
  (let ((chars (ntype-promoted-chars ty)))
    (and (not (eq? chars 'bad)) (list->string chars))))

(define (ntype-promoted-chars ty)
  (let ((ty (prune ty)))
    (cond ((and (ntycon? ty) (eq? (ntycon-tycon ty) (core-symbol "PromotedNil"))) '())
	  ((and (ntycon? ty) (eq? (ntycon-tycon ty) (core-symbol "PromotedCons"))
		(eqv? (length (ntycon-args ty)) 2))
	   (let ((c (ntype-type-char (car (ntycon-args ty))))
		 (rest (ntype-promoted-chars (cadr (ntycon-args ty)))))
	     (if (or (not c) (eq? rest 'bad)) 'bad (cons c rest))))
	  (else 'bad))))

(define (ntype-type-char ty)
  (let ((ty (prune ty)))
    (and (ntycon? ty) (eq? (ntycon-tycon ty) (core-symbol "TypeChar"))
	 (eqv? (length (ntycon-args ty)) 1)
	 (let ((n (ntype-bits (car (ntycon-args ty)))))
	   (and n (integer->char n))))))

(define (ntype-bits ty)
  (let ((ty (prune ty)))
    (cond ((not (ntycon? ty)) '#f)
	  ((eq? (ntycon-tycon ty) (core-symbol "PromotedNil")) 0)
	  ((and (eq? (ntycon-tycon ty) (core-symbol "PromotedCons"))
		(eqv? (length (ntycon-args ty)) 2))
	   (let ((b (prune (car (ntycon-args ty))))
		 (rest (ntype-bits (cadr (ntycon-args ty)))))
	     (and rest (ntycon? b)
		  (cond ((eq? (ntycon-tycon b) (core-symbol "TypeB0")) (* 2 rest))
			((eq? (ntycon-tycon b) (core-symbol "TypeB1")) (+ 1 (* 2 rest)))
			(else '#f)))))
	  (else '#f))))

(define (reducible-one-parameter-mp? p)
  (let ((types (mp-placeholder-types p))
	(class (mp-placeholder-class p)))
    (and (null? (cdr types))
	 (null? (cdr (class-tyvars class)))
	 (let ((type (prune (car types))))
	   (and (ntycon? type)
		(let ((reduced (prune (reduce-mp-type type))))
		  ;; (a stuck application may come back as a copy)
		  (and (not (eq? reduced type))
		       (not (and (ntycon? reduced) (family-app? reduced))))))))))

(define (process-mp-placeholder-1 p deferred decls)
  (if (not (eq? (mp-placeholder-exp p) '#f))
      deferred
      (let* ((class (mp-placeholder-class p))
	     (types (mp-placeholder-types p))
	     (param (find-mp-param p class types decls))
	     (sub (if (eq? param '#f) (find-subclass-mp-param p class types decls) '#f))
	     ;; Functor or Applicative at an application given Monad there
	     ;; (profunctors' Monad (Rep p) => .. pure): through WrappedMonad
	     (implied (if (and (eq? param '#f) (eq? sub '#f)
			       (null? (cdr types))
			       (monad-implied-class? class))
			  (find-implying-mp-param p class types decls)
			  '#f))
	     (found (if (and (eq? param '#f) (eq? sub '#f) (eq? implied '#f))
			(find-mp-instance class types)
			'#f)))
	(cond ((not (eq? param '#f))
	       (setf (placeholder-exp p)
		     (mp-dict-use p (**var/def (mp-param-var param))))
	       deferred)
	      ((not (eq? implied '#f))
	       (setf (placeholder-exp p)
		     (mp-dict-use p (**app (dict-ref-code
					    (lookup-instance (prelude-modern-def '|WrappedMonad|)
							     class))
					   (let ((d (**var/def (mp-param-var implied)))
						 (implying (implying-class class)))
					     (if (eq? (mp-param-class implied) implying)
						 d
						 (**dsel/dict (mp-param-class implied)
							      implying d))))))
	       deferred)
	      ((not (eq? sub '#f))
	       ;; given a subclass at the type (GOrd (f p) gives GEq (f p)):
	       ;; its superclass dictionary
	       (setf (placeholder-exp p)
		     (mp-dict-use p (**dsel/dict (mp-param-class sub) class
						 (**var/def (mp-param-var sub)))))
	       deferred)
	      ((and (null? (cdr types))
		    (null? (cdr (class-tyvars class)))
		    (ntycon? (expand-ntype-synonym (prune (car types))))
		    ;; (not a family application still stuck: no instance
		    ;; is for it, SubstArg a of Agda's composeS)
		    (not (family-app? (expand-ntype-synonym (prune (car types))))))
	       ;; a one-parameter class given at an application of a type
	       ;; variable (Monad (m s)), now wanted at a known type:
	       ;; the type's instance, as for any other dictionary
	       (let ((type (expand-ntype-synonym (prune (car types)))))
		 (mlet (((code def1)
			 (generate-dict-ref
			  (lookup-instance/type (ntycon-tycon type) class type)
			  type deferred decls (placeholder-enclosing-decls p)
			  (placeholder-overloaded-var p))))
		   (setf (placeholder-exp p) (mp-dict-use p code))
		   def1)))
	      ((not (eq? found '#f))
	       (resolve-mp-by-instance p (tuple-2-1 found) (tuple-2-2 found)
				       deferred decls))
	      ((qc-given-find p class types decls)
	       ;; a given quantified constraint's head
	       (mlet (((code d1) (qc-given-dict (qc-given-find p class types decls)
						p deferred decls)))
		 (setf (placeholder-exp p) (mp-dict-use p code))
		 d1))
	      ((some (function mp-type-non-generic?) types)
	       (cons p deferred))
	      ((inside-enclosing-decl? p decls)
	       ;; a local binding's: the enclosing binding's signature may
	       ;; give it (ImplicitParams' ?x, a pattern binding's)
	       (cons p deferred))
	      (else
	       (signal-unresolved-mp-constraint p)
	       deferred)))))

;;; Whether placeholder P, made in a binding of DECLS, is inside another
;;; binding too.
(define (inside-enclosing-decl? p decls)
  (let ((edecls (placeholder-enclosing-decls p)))
    (do ((l edecls (cdr l)))
	((or (null? l) (memq (car l) decls))
	 (and (pair? l) (pair? (cdr l)))))))

;;; The dictionary, or the method selected from it.
(define (mp-dict-use p dict-code)
  (let ((method (mp-placeholder-method p)))
    (if (eq? method '#f)
	dict-code
	(let ((sel (tuple-2-2 (assq method (class-selectors (mp-placeholder-class p))))))
	  (**app (**var/def sel) dict-code)))))

;;; A dictionary parameter of an enclosing binding being generalized
;;; that provides the constraint: equal types at the determining
;;; positions, the others then unified (fundep improvement).

(define (find-mp-param p class types decls)
  (let ((decl (find-enclosing-decl (placeholder-enclosing-decls p) decls)))
    (or (find-mp-param-1 (mp-placeholder-local-params p) class types)
	(and (not (eq? decl '#f))
	     (or (find-mp-param-1 (valdef-mp-dict-params decl) class types)
		 (find-only-mp-param (valdef-mp-dict-params decl) class types))))))

;;; A one-parameter class wanted at an application (GEq (f p)), given by
;;; the enclosing binding as a subclass at the same type (GOrd (f p),
;;; class GEq a => GOrd a): that parameter, or #f.

;;; The enclosing binding's Monad (or MonadPlus, for Alternative) at the
;;; same type, for a monad-implied CLASS: that parameter, or #f.
(define (find-implying-mp-param p class types decls)
  (let ((decl (find-enclosing-decl (placeholder-enclosing-decls p) decls))
	(implying (implying-class class)))
    (and decl
	 (lisp:find-if
	  (lambda (param)
	    (and (null? (cdr (mp-param-types param)))
		 (or (eq? (mp-param-class param) implying)
		     (memq implying (class-super* (mp-param-class param))))
		 (mp-type-equal? (car (mp-param-types param)) (car types))))
	  (valdef-mp-dict-params decl)))))

(define (find-subclass-mp-param p class types decls)
  (let ((decl (find-enclosing-decl (placeholder-enclosing-decls p) decls)))
    (and decl
	 (null? (cdr types))
	 (null? (cdr (class-tyvars class)))
	 (lisp:find-if
	  (lambda (param)
	    (let ((pclass (mp-param-class param)))
	      (and (null? (cdr (mp-param-types param)))
		   (not (eq? pclass class))
		   (memq class (class-super* pclass))
		   (mp-type-equal? (car (mp-param-types param)) (car types)))))
	  (valdef-mp-dict-params decl)))))

;;; AllowAmbiguousTypes: a type variable only a constraint mentions (n in
;;; get :: Get n l r => l -> r) is not determined by the types, so a
;;; wanted constraint can have a new variable where the given has the
;;; binding's own (an instance's dictionary using its method).  When one
;;; parameter of the class agrees at every position where the wanted
;;; types are not a bare type variable, it is the one: unified with it.

(define (find-only-mp-param params class types)
  (let ((candidates
	 (lisp:remove-if-not
	  (lambda (param)
	    (and (eq? (mp-param-class param) class)
		 (every (lambda (pt wt)
			  (let ((wt (prune wt)))
			    (or (and (ntyvar? wt) (not (ntyvar-read-only? wt)))
				(mp-type-equal? pt wt))))
			(mp-param-types param) types)))
	  params)))
    (and (not (null? candidates))
	 (null? (cdr candidates))
	 (find-mp-param-1/unify (car candidates) class types))))

(define (find-mp-param-1/unify param class types)
  (dolist2 (t1 (mp-param-types param)) (t2 types)
    (type-unify t2 t1
      (type-error "The constraint ~A does not match the given ~A."
		  (**mp-context (**class/def class) types)
		  (**mp-context (**class/def class) (mp-param-types param)))))
  param)

(define (find-enclosing-decl edecls decls)
  (cond ((null? edecls) '#f)
	((memq (car edecls) decls) (car edecls))
	(else (find-enclosing-decl (cdr edecls) decls))))

(define (find-mp-param-1 params class types)
  (cond ((null? params) '#f)
	((and (eq? (mp-param-class (car params)) class)
	      (mp-equal-at? (mp-determining-positions class)
			    (mp-param-types (car params)) types))
	 ;; (the wanted type bound to the given's: a given's variable only
	 ;; its context mentions keeps its own dictionaries)
	 (dolist2 (t1 (mp-param-types (car params))) (t2 types)
	   (type-unify t2 t1
	     (type-error "The constraint ~A does not match the given ~A."
			 (**mp-context (**class/def class) types)
			 (**mp-context (**class/def class)
				       (mp-param-types (car params))))))
	 (car params))
	(else (find-mp-param-1 (cdr params) class types))))

;;; A reference to the instance's dictionary, typed at the instance's
;;; types so that its own context's dictionaries are supplied (as new
;;; placeholders, resolved here).

(define *mp-resolve-depth* 0)

(define (resolve-mp-by-instance p inst bindings deferred decls)
  ;; instance contexts nest only so deep; deeper is a loop, as after a
  ;; type error in improvement
  (if (> (dynamic *mp-resolve-depth*) 40)
      (begin
	(phase-error 'mp-instance-loop
	  "Resolving the constraint ~A loops through instance contexts."
	  (mp-placeholder-class p))
	deferred)
      (dynamic-let ((*mp-resolve-depth* (1+ (dynamic *mp-resolve-depth*))))
	(resolve-mp-by-instance-1 p inst bindings deferred decls))))

(define (resolve-mp-by-instance-1 p inst bindings deferred decls)
  (let* ((bindings (improve-from-instance inst bindings (mp-placeholder-types p)))
	 (dict-var (instance-dictionary inst))
	 (new-placeholders '())
	 (code '#f))
    (mlet (((expected _) (ast->ntype/bindings (generate-mp-dictionary-type inst)
					      bindings)))
      (dynamic-let ((*placeholders* '())
		    (*enclosing-decls* (placeholder-enclosing-decls p)))
	(mlet (((dict-type tyvars mps)
		;; (from an interface file the type is var-type: signatures
		;; are the module's own)
		(instantiate-gtype/mp (or (var-signature dict-var)
					  (var-type dict-var)))))
	  (type-unify dict-type expected
	    (type-error "Internal error: dictionary type of ~A ~A."
			(instance-class inst) (instance-mp-types inst)))
	  ;; the head's matched types, by name: a variable of the instance
	  ;; that no method type mentions (n in Get ('S n) l r with
	  ;; get :: l -> r) is bound only this way
	  (bind-dictionary-tyvars-by-name dict-var tyvars bindings)
	  (setf code (insert-mp-placeholders
		      (insert-dict-placeholders (**var/def dict-var) tyvars
						(placeholder-overloaded-var p))
		      mps (placeholder-overloaded-var p)))
	  (setf new-placeholders (dynamic *placeholders*)))))
    (setf (placeholder-exp p) (mp-dict-use p code))
    (process-placeholders new-placeholders deferred decls)))

(define (bind-dictionary-tyvars-by-name dict-var tyvars bindings)
  (let ((sig (var-signature dict-var)))
    (when (and sig (gtype? sig)
	       (eqv? (length (gtype-tyvar-names sig)) (length tyvars)))
      (dolist2 (name (gtype-tyvar-names sig)) (tv tyvars)
	(let ((b (assq name bindings)))
	  (when b
	    (type-unify tv (tuple-2-2 b) '#f)))))))

(define (signal-unresolved-mp-constraint p)
  (phase-error 'unresolved-mp-constraint
    "No instance for ~A~%(and no constraint in the type signature provides it)."
    (**mp-context (**class/def (mp-placeholder-class p))
		  (mp-placeholder-types p))))

;;; Recursive calls within a group generalized over multi-parameter
;;; constraints pass the caller's dictionaries for the callee's
;;; constraints (the same ones: the group shares its type variables).

(define (recursive-mp-dict-args exp from-decl to-decl)
  (dolist (param (valdef-mp-dict-params to-decl))
    (let ((mine (find-mp-param-1/exact (valdef-mp-dict-params from-decl)
					(mp-param-class param)
					(mp-param-types param))))
      (setf exp (**app exp (**var/def (mp-param-var mine))))))
  exp)

(define (find-mp-param-1/exact params class types)
  (cond ((null? params)
	 (error "Lost a multi-parameter dictionary in a recursive group."))
	((and (eq? (mp-param-class (car params)) class)
	      (mp-types-equal? (mp-param-types (car params)) types))
	 (car params))
	(else (find-mp-param-1/exact (cdr params) class types))))

;;; A one-parameter instance's multi-parameter constraints (instance C a b
;;; => D (T a b)), at the type TYPE (a T ...): placeholders applied to
;;; DICT after its one-parameter dictionaries, and resolved.  Returns the
;;; dictionary code and the placeholders still to be resolved.

(define (instance-mp-dict-args instance type dict deferred decls edecls var)
  (let ((bindings (list (tuple '|%none| '|%none|))))
    ;; (a catch-all instance's variable is the whole type: instance-arg-types)
    (dolist2 (tv (instance-tyvars instance)) (ty (instance-arg-types instance type))
      (push (tuple tv ty) bindings))
    (dolist (c (instance-mcontext instance))
      (mlet (((types b1) (ast->ntype/bindings/l (mp-context-types c) bindings))
	     (p (**mp-placeholder (class-ref-class (mp-context-class c)) types
				  '#f edecls var)))
	(setf bindings b1)
	(setf dict (**app dict p))
	(setf deferred (process-mp-placeholder p deferred decls))))
    (values dict deferred)))

;;;=====================================================================
;;; Quantified constraints
;;;=====================================================================

;;; QuantifiedConstraints: forall x. C x => D (t x) is PreludeModern's
;;; QuantifiedConstraint at the polytype forall x. C x => D (t x)
;;; (parser/type-parser.mumble), its head a constraint type (the class
;;; literal of D applied: constraint-type-class).  Its dictionary is a
;;; function from the premises' dictionaries, one for each class on each
;;; of the polytype's variables in order, then one for each of its
;;; multi-parameter constraints, to the head's.  Given, it gives the head
;;; at any instance of the variables (qc-given-dict); wanted, it is that
;;; function, made from the instances there are (process-qc-wanted).

(define (qc-class? class)
  (and (class? class)
       (eq? (def-name class) '|QuantifiedConstraint|)
       (eq? (def-module class) '|PreludeModern|)))

;;; A new instance of the quantified constraint's polytype G: the head's
;;; class and types, the polytype's variables (with their premises as
;;; their contexts) and its multi-parameter premises as (class . types).
(define (qc-instantiate g)
  (let ((g (prune g)))
    (if (not (polytype? g))
	(values '#f '() '() '())
	(let ((tyvars (map (lambda (c) (declare (ignore c)) (**ntyvar)) (gtype-context g))))
	  (dolist2 (tv tyvars) (c (gtype-context g))
	    (setf (ntyvar-context tv) c))
	  (mlet (((class args) (constraint-type-class (copy-polytype-body (gtype-type g) tyvars))))
	    ;; (synonyms expanded: KiCS2's Curry (C_Apply t x), C_Apply a b
	    ;; = a b)
	    (values class (map (function reduce-mp-type) args) tyvars
		    (map (lambda (c)
			   (tuple (tuple-2-1 c)
				  (map (lambda (ty) (copy-polytype-body ty tyvars))
				       (tuple-2-2 c))))
			 (gtype-mcontext g))))))))

;;; Matches PATTERNS, types whose PVARS may stand for any type, against
;;; TYPES: the bindings ((tyvar . type) ...), or 'fail.
(define (qc-match-list patterns types pvars env)
  (cond ((eq? env 'fail) 'fail)
	((and (null? patterns) (null? types)) env)
	((or (null? patterns) (null? types)) 'fail)
	(else (qc-match-list (cdr patterns) (cdr types) pvars
			     (qc-match (car patterns) (car types) pvars env)))))

(define (qc-match pat type pvars env)
  (let ((pat (reduce-mp-type pat))
	(type (reduce-mp-type type)))
    (cond ((eq? env 'fail) 'fail)
	  ((and (ntyvar? pat) (memq pat pvars))
	   (let ((b (assq pat env)))
	     (cond ((not b) (cons (cons pat type) env))
		   ((mp-type-equal? (cdr b) type) env)
		   (else 'fail))))
	  ((and (ntycon? pat) (ntycon? type)
		(eq? (ntycon-tycon pat) (ntycon-tycon type)))
	   (qc-match-list (ntycon-args pat) (ntycon-args type) pvars env))
	  ((and (ntyapp? pat) (ntyapp? type)
		(eqv? (length (ntyapp-args pat)) (length (ntyapp-args type))))
	   (qc-match-list (ntyapp-args pat) (ntyapp-args type) pvars
			  (qc-match (ntyapp-fun pat) (ntyapp-fun type) pvars env)))
	  ;; T a b against an application t c of a variable (a head's t x
	  ;; with t L)
	  ((and (ntyapp? pat) (ntycon? type)
		(>= (length (ntycon-args type)) (length (ntyapp-args pat))))
	   (let* ((n (length (ntyapp-args pat)))
		  (k (- (length (ntycon-args type)) n)))
	     (qc-match-list (ntyapp-args pat) (list-tail (ntycon-args type) k) pvars
			    (qc-match (ntyapp-fun pat)
				      (**ntycon (ntycon-tycon type) (list-head (ntycon-args type) k))
				      pvars env))))
	  ((mp-type-equal? pat type) env)
	  (else 'fail))))

;;; The quantified constraints given to the bindings enclosing P, as
;;; (polytype . dictionary var): the enclosing binding's parameters, and
;;; a polymorphic argument's (*local-mp-params*).
(define (qc-givens p decls)
  (let ((decl (find-enclosing-decl (placeholder-enclosing-decls p) decls))
	(res '()))
    (dolist (param (append (if (mp-placeholder? p) (mp-placeholder-local-params p) '())
			   (placeholder-given-locals p)
			   (dynamic *local-mp-params*)
			   (if decl (valdef-mp-dict-params decl) '())))
      (when (qc-class? (mp-param-class param))
	(push (cons (car (mp-param-types param)) (mp-param-var param)) res)))
    (reverse res)))

;;; Whether the signature's givens (*given-mp-constraints*) have a
;;; quantified constraint whose head is CLASS at TYPES (unify.mumble's
;;; given-app-constraint?).
(define (qc-given-matches? class types)
  (lisp:some (lambda (g)
	       (and (qc-class? (car g))
		    (mlet (((hclass hargs tyvars _) (qc-instantiate (cadr g))))
		      (and hclass
			   (or (eq? hclass class) (memq class (class-super* hclass)))
			   (not (eq? (qc-match-list hargs types tyvars '()) 'fail))))))
	     (dynamic *given-mp-constraints*)))

;;; A given quantified constraint of the bindings enclosing P whose head
;;; is CLASS at TYPES: (given tyvars mps bindings), or #f; qc-given-dict
;;; makes the dictionary.
(define (qc-given-find p class types decls)
  (let ((found '#f))
    (dolist (g (qc-givens p decls))
      (when (not found)
	(mlet (((hclass hargs tyvars mps) (qc-instantiate (car g))))
	  ;; (or a superclass of its head's: Curry gives NonDet, KiCS2's)
	  (when (and hclass (or (eq? hclass class) (memq class (class-super* hclass))))
	    (let ((env (qc-match-list hargs types tyvars '())))
	      (when (not (eq? env 'fail))
		(setf found (list g tyvars mps env hclass class))))))))
    found))

;;; The dictionary from FOUND (qc-given-find): the given's function applied
;;; to the premises' dictionaries, new placeholders processed here.
;;; Returns the code and the placeholders left.
(define (qc-given-dict found p deferred decls)
	(let* ((g (car found)) (tyvars (cadr found)) (mps (caddr found))
	       (env (cadddr found))
	       (args '())
	       (edecls (placeholder-enclosing-decls p))
	       (var (placeholder-overloaded-var p)))
	  ;; the variables the match left unbound (a premise's only) stay
	  ;; new variables
	  (dolist (tv tyvars)
	    (let ((classes (ntyvar-context tv))
		  (b (assq tv env)))
	      (setf (ntyvar-context tv) '())
	      (when b (setf (ntyvar-value tv) (cdr b)))
	      (dolist (c classes)
		(let ((q (**dict-placeholder c (prune tv) edecls var)))
		  (setf deferred (process-placeholder q deferred decls))
		  (push q args)))))
	  (dolist (m mps)
	    (let ((q (**mp-placeholder (tuple-2-1 m) (tuple-2-2 m) '#f edecls var)))
	      (setf deferred (process-placeholder q deferred decls))
	      (push q args)))
	  (let ((code (**app/l (**var/def (cdr g)) (reverse args)))
		(hclass (list-ref found 4))
		(class (list-ref found 5)))
	    (values (if (eq? hclass class) code (**dsel/dict hclass class code))
		    deferred))))

;;; A wanted quantified constraint: \d1 .. dn -> the head's dictionary,
;;; the polytype's variables new ones given the premises by d1 .. dn
;;; (as a polymorphic argument's are: polytypes.mumble).
(define (process-qc-wanted p deferred decls)
  (mlet (((hclass hargs tyvars mps) (qc-instantiate (car (mp-placeholder-types p)))))
    (if (not hclass)
	(begin
	  (signal-unresolved-mp-constraint p)
	  deferred)
	(let ((pats '())
	      (local '())
	      (edecls (placeholder-enclosing-decls p))
	      (var (placeholder-overloaded-var p)))
	  (dolist (tv tyvars)
	    (let ((params '()))
	      (dolist (c (ntyvar-context tv))
		(let ((d (create-temp-var (string-append "d_" (symbol->string (def-name c))))))
		  (setf (var-type d) (**ntyvar))
		  (push (**var-pat/def d) pats)
		  (push (tuple c d) params)))
	      (when (not (null? params))
		(setf (ntyvar-read-only? tv) '#t)
		(push (tuple (car edecls) (reverse params)) (ntyvar-dict-params tv)))))
	  (dolist (m mps)
	    (let ((d (create-temp-var (string-append "d_" (symbol->string (def-name (tuple-2-1 m)))))))
	      (setf (var-type d) (**ntyvar))
	      (push (**var-pat/def d) pats)
	      (push (list (tuple-2-1 m) (tuple-2-2 m) d) local)))
	  ;; (the premises are given while the head is resolved, also to the
	  ;; placeholders made on the way: an instance's context)
	  (dynamic-let ((*local-mp-params*
			 (append (reverse local) (dynamic *local-mp-params*))))
	    (let ((q (if (and (null? (cdr hargs)) (null? (cdr (class-tyvars hclass))))
			 (**dict-placeholder hclass (car hargs) edecls var)
			 (**mp-placeholder hclass hargs '#f edecls var))))
	      (setf deferred (process-placeholder q deferred decls))
	      (setf (placeholder-exp p)
		    (if (null? pats) q (**lambda/pat (reverse pats) q)))
	      deferred))))))
