
;;; type/dictionary.mumble

;;; This function supports dictionary conversion.  It creates lambda
;;; variables to bind to the dictionary args needed by the context.
;;; The actual conversion to lambda is done in the cfn.  Each tyvar in
;;; the context has an associated mapping from class to dictionary
;;; variable.  This mapping depends on the decl containing the placeholder
;;; since different recursive decls share common tyvars.  The mapping is
;;; two levels: decl -> class -> var.

;;; Due to language restrictions this valdef must be a simple variable
;;; definition.

(define (dictionary-conversion/definition valdef tyvars)
  (let* ((all-tyvars tyvars)
	 (var (decl-var valdef))
	 (type (var-type var))
	 (context (gtype-context type))
	 (dict-param-vars '()))
    (dolist (c context)
      (let ((tyvar (car tyvars))
	    (dparams '()))
       (when (not (null? c))
	(dolist (class c)
          (let ((var (create-temp-var
		      (string-append "d_"
				     (symbol->string (def-name class))))))
	    (setf (var-force-strict? var) '#t)
	    (push (tuple class var) dparams)
	    (push var dict-param-vars)))
	(push (tuple valdef dparams) (ntyvar-dict-params tyvar)))
       (setf tyvars (cdr tyvars))))
    ;; then one for each multi-parameter constraint (mp-classes.mumble)
    (let ((mp-params (mp-dict-params (gtype-mcontext type) all-tyvars)))
      (setf (valdef-mp-dict-params valdef) mp-params)
      (setf (valdef-dictionary-args valdef)
	    (append (nreverse dict-param-vars)
		    (map (function mp-param-var) mp-params))))))

;;; These routines deal with dict-var processing.

;;; This discharges the tyvars associated with dictionaries.  The dict-vars
;;; to be processed at the next level are returned.

(define (process-placeholders placeholders deferred decls)
  ;; multi-parameter ones first: their fundep improvement may decide a
  ;; one-parameter one's type (ListLike's map FM.toList, toList's
  ;; Foldable t from ListLike full (FMList Char))
  ;; and of those, constraints only at families' applications last:
  ;; another's improvement decides their arguments (megaparsec's default
  ;; hidden: Ord (Token s) after MonadParsec e s (StateT st m))
  (let ((mps (lisp:remove-if-not (function mp-placeholder?) placeholders)))
    (process-placeholders-1
     (append (lisp:remove-if (function family-app-mp-placeholder?) mps)
	     (lisp:remove-if-not (function family-app-mp-placeholder?) mps)
	     (lisp:remove-if (function mp-placeholder?) placeholders))
     deferred decls)))

(define (family-app-mp-placeholder? p)
  (every (lambda (ty)
	   (let ((ty (prune ty)))
	     (and (ntycon? ty) (family-app? (expand-ntype-synonym ty)))))
	 (mp-placeholder-types p)))

(define (process-placeholders-1 placeholders deferred decls)
  (when (not (null? *deferred-family-equalities*))
    (retry-family-equalities))
  (if (null? placeholders)
      deferred
      (let ((d1 (process-placeholder (car placeholders) deferred decls)))
	(process-placeholders-1 (cdr placeholders) d1 decls))))

;;; This processes a placeholder.  The following cases arise:
;;;  a) the variable has already been processed (no placeholders remain) -
;;;     ignore it.  placeholders may contain duplicates so this is likely.
;;;  b) the type variable is from an outer type environment (in ng-list)
;;;     and should just be passed up to the next level (added to old-placeholders)
;;;  c) the type variable is associated with a dictionary parameter
;;;  d) the type variable is instantiated to a type constructor
;;;  e) the type variable is ambiguous (none of the above)

(define (process-placeholder p deferred decls)
  ;; (what was given where P was made is given to the placeholders made
  ;; on the way: an instance's context)
  (dynamic-let ((*local-mp-params*
		 (append (placeholder-given-locals p)
			 (if (mp-placeholder? p) (mp-placeholder-local-params p) '())
			 (dynamic *local-mp-params*))))
    (if (mp-placeholder? p)
	(process-mp-placeholder p deferred decls)
	(process-placeholder-1 p deferred decls))))

(define (process-placeholder-1 p deferred decls)
  (process-placeholder-at p (prune (placeholder-tyvar p)) deferred decls))

;;; Whether no instance of P's class matches TYPE yet, but one could once
;;; its arguments' variables, an enclosing binding's, are known.
(define (undecided-flexible-instance? p type)
  (undecided-flexible-instance/class? (placeholder-class p) type))

(define (undecided-flexible-instance/class? class type)
  (and (algdata? (ntycon-tycon type))
       (mp-type-non-generic? type)
       (let ((instance (lookup-instance/type (ntycon-tycon type) class type)))
	 (and instance
	      (not (instance-head-matches? instance type))
	      (some-instance-head-could-match? instance type)))))

(define (process-placeholder-at p type deferred decls)
  (let ((expanded (if (ntycon? type)
		      (prune (expand-ntype-synonym type))
		      type)))
    (cond ((and (ntycon? type) (not (ntycon? expanded)))
	   ;; a synonym or family application reducing to a variable or
	   ;; an application (E (Box a) = a): dispatch on that
	   (process-placeholder-at p expanded deferred decls))
	  ((and (ntycon? type) (family-app? (expand-ntype-synonym type)))
	   ;; a type family application not decided yet (TypeFamilies):
	   ;; given by the enclosing binding's signature (Size (Rep a) =>),
	   ;; or left for later
	   (let ((given (given-class-params p type decls))
		 (family (ntycon-tycon (expand-ntype-synonym type))))
	     (cond ((not (null? given))
		    (setf (placeholder-exp p)
			  (if (dict-placeholder? p)
			      (dict-reference-code (dict-placeholder-class p) given)
			      (let ((m (method-placeholder-method p)))
				(method-reference-code m (method-var-class m) given))))
		    deferred)
		   ;; out of a constraint family's given constraint (Agda's
		   ;; All EmbPrj (CoDomain t ': Domains t) gives EmbPrj
		   ;; (CoDomain t))
		   ((cfam-given-component p (placeholder-class p) (list type) decls)
		    (let ((d (cfam-given-component p (placeholder-class p) (list type) decls)))
		      (setf (placeholder-exp p)
			    (if (dict-placeholder? p)
				d
				(let ((m (method-placeholder-method p)))
				  (**app (**var/def (tuple-2-2 (assq m (class-selectors (placeholder-class p)))))
					 d)))))
		    deferred)
		   ;; a data family with an instance of its own (instance
		   ;; Show (Vector a)): that instance, at any arguments
		   ((and (data-family-def? family)
			 (family-instance-for p family))
		    (process-instantiated-tyvar (expand-ntype-synonym type)
						p deferred decls))
		   (else (cons p deferred)))))
	  ((and (ntycon? type) (given-class-params p type decls))
	   ;; given by the enclosing binding's context at this very type
	   ;; (megaparsec's (Show (ParseError s e), Show s) => Show (State
	   ;; s e)), whose instance would want what is not given (Show
	   ;; (Token s))
	   (let ((given (given-class-params p type decls)))
	     (setf (placeholder-exp p)
		   (if (dict-placeholder? p)
		       (dict-reference-code (dict-placeholder-class p) given)
		       (let ((m (method-placeholder-method p)))
			 (method-reference-code m (method-var-class m) given))))
	     deferred))
	  ((and (ntycon? type) (undecided-flexible-instance? p (expand-ntype-synonym type)))
	   ;; several flexible instances (Subst (Pattern' A), Subst (Pattern'
	   ;; B)) its arguments, an enclosing binding's variables, are still
	   ;; to choose between (Agda's dotSub in LHS.Unify): left for the
	   ;; enclosing binding
	   (cons p deferred))
	  ((ntycon? type)
	   (process-instantiated-tyvar
	    (expand-ntype-synonym type) p deferred decls))
	  ((ntyapp? type)
	   (let ((given (given-class-params p type decls)))
	     (cond (given
		    ;; the enclosing binding's signature gives the class
		    ;; (or a subclass) at this type: Monad (m s)
		    (setf (placeholder-exp p)
			  (if (dict-placeholder? p)
			      (dict-reference-code (dict-placeholder-class p) given)
			      (let ((m (method-placeholder-method p)))
				(method-reference-code m (method-var-class m) given))))
		    deferred)
		   ((qc-given-find p (placeholder-class p) (list type) decls)
		    ;; a given quantified constraint's head (forall x. Curry x
		    ;; => Curry (t x), KiCS2's)
		    (mlet (((code d1) (qc-given-dict
				       (qc-given-find p (placeholder-class p) (list type) decls)
				       p deferred decls)))
		      (setf (placeholder-exp p)
			    (if (dict-placeholder? p)
				code
				(let ((m (method-placeholder-method p)))
				  (**app (**var/def (tuple-2-2 (assq m (class-selectors
									  (placeholder-class p)))))
					 code))))
		      d1))
		   ((app-catch-all-instance (placeholder-class p))
		    ;; C (t a) (Agda's TermSize (t a))
		    (process-app-catch-all type p deferred decls))
		   ((non-generic-app? type)
		    (cons p deferred))
		   (else
		    (signal-unresolved-app-constraint type p)
		    deferred))))
	  ;; given by a match on a constructor whose context has it (its
	  ;; result's NFData o, Agda's BackendWithOpts: existentials.mumble)
	  ((and (ntyvar? type)
		(not (dict-params-give? (placeholder-class p) (ntyvar-dict-params type)))
		(pattern-local-given-gives? (placeholder-class p) type))
	   (let ((given (pattern-local-given-params type)))
	     (setf (placeholder-exp p)
		   (if (dict-placeholder? p)
		       (dict-reference-code (dict-placeholder-class p) given)
		       (let ((m (method-placeholder-method p)))
			 (method-reference-code m (method-var-class m) given)))))
	   deferred)
	  ;; a one-parameter class given as a multi-parameter constraint at
	  ;; the variable (an instance method's own Monad m, after the
	  ;; instance's context: tdecl/instance.mumble's
	  ;; generate-method-signature)
	  ((and (ntyvar? type)
		(not (dict-params-give? (placeholder-class p) (ntyvar-dict-params type)))
		(given-class-params p type decls))
	   (let ((given (given-class-params p type decls)))
	     (setf (placeholder-exp p)
		   (if (dict-placeholder? p)
		       (dict-reference-code (dict-placeholder-class p) given)
		       (let ((m (method-placeholder-method p)))
			 (method-reference-code m (method-var-class m) given)))))
	   deferred)
	  ;; a class out of a constraint family's given constraint (All Show
	  ;; '[a] gives Show a: mp-classes.mumble's cfam-given-component)
	  ((and (ntyvar? type)
		(not (dict-params-give? (placeholder-class p) (ntyvar-dict-params type)))
		(cfam-given-component p (placeholder-class p) (list type) decls))
	   (let ((d (cfam-given-component p (placeholder-class p) (list type) decls)))
	     (setf (placeholder-exp p)
		   (if (dict-placeholder? p)
		       d
		       (let ((m (method-placeholder-method p)))
			 (**app (**var/def (tuple-2-2 (assq m (class-selectors (placeholder-class p)))))
				d)))))
	   deferred)
	  ;; an existential pattern's type variable has its dictionaries,
	  ;; though it is non-generic inside a lambda (existentials.mumble)
	  ((and (not (null? (ntyvar-dict-params type))) (ntyvar-read-only? type)
		(non-generic? type))
	   (if (dict-placeholder? p)
	       (placeholder->dict-param p (ntyvar-dict-params type) decls)
	       (placeholder->method p (ntyvar-dict-params type) decls))
	   deferred)
	  ((non-generic? type)
	   (cons p deferred))
	  ((not (null? (ntyvar-dict-params type)))
	   (if (dict-placeholder? p)
	       (placeholder->dict-param p (ntyvar-dict-params type) decls)
	       (placeholder->method p (ntyvar-dict-params type) decls))
	   deferred)
	  ((fundep-determined-by-non-generic? type deferred)
	   ;; decided by a deferred multi-parameter constraint's functional
	   ;; dependency (or a superclass's) from the enclosing binding's
	   ;; types: Dot char of ListLikeProcessIO text char, text the
	   ;; enclosing signature's (process-extras' doOutput)
	   (cons p deferred))
	  (else
	   ;; Since default types are monotypes, no new vars will
	   ;; be added to old-placeholders
	   (when (maybe-default-ambiguous-tyvar
		  type (placeholder-overloaded-var p)
		  (valdef-module (car (placeholder-enclosing-decls p))))
	      (process-placeholder p deferred decls))
	   deferred))))
	       
;;; The class of a dictionary or method placeholder.
(define (placeholder-class p)
  (if (dict-placeholder? p)
      (dict-placeholder-class p)
      (method-var-class (method-placeholder-method p))))

;;; Whether dictionary parameters (ntyvar-dict-params) give CLASS, or a
;;; subclass of it.
(define (dict-params-give? class params)
  (lisp:some (lambda (decl-params)
	       (lisp:some (lambda (cv)
			    (or (eq? (tuple-2-1 cv) class)
				(memq class (class-super* (tuple-2-1 cv)))))
			  (tuple-2-2 decl-params)))
	     params))

;;; The type variable is associated with a dictionary parameter.  The only
;;; complication here is that the class needed may not be directly available -
;;; it may need to be obtained from the super classes of the parameter
;;; dictionaries.

(define (placeholder->dict-param p param-vars decls)
  (let ((class (dict-placeholder-class p))
	(edecls (dict-placeholder-enclosing-decls p)))
    (setf (placeholder-exp p)
	  (dict-reference-code class (locate-params param-vars edecls decls)))))

(define (dict-reference-code class param-vars)
  (let ((var (assq class param-vars)))
    (if (not (eq? var '#f))
	(**var/def (tuple-2-2 var))
	(search-superclasses class param-vars))))

(define (locate-params param-vars enclosing-decls decls)
  (if (null? (cdr param-vars))
      (tuple-2-2 (car param-vars))
      (let ((decl (search-enclosing-decls enclosing-decls decls)))
	(tuple-2-2 (assq decl param-vars)))))

;;; This finds the first dictionary containing the needed class in its
;;; super classes and generates a selector to get the needed dictionary.

(define (search-superclasses class param-vars)
  (search-superclasses-1 class param-vars param-vars))

(define (search-superclasses-1 class params all-params)
  (if (null? params)
      (or (catch-all-dict class all-params)
	  (monad-implied-dict class all-params))
      (let ((pclass (tuple-2-1 (car params))))
	(if (memq class (class-super* pclass))
	    (**dsel/dict pclass class (**var/def (tuple-2-2 (car params))))
	    (search-superclasses-1 class (cdr params) all-params)))))

;;; C at a type variable through C's catch-all instance ctx => C a: its
;;; dictionary applied to those of ctx at the same variable (PARAM-VARS),
;;; or #f.

(define (catch-all-dict class param-vars)
  (let ((inst (catch-all-instance class)))
    (and inst
	 ;; (C a, not C (t a), at a type variable)
	 (null? (cdr (instance-tyvars inst)))
	 (not (monad-implied-class? class))
	 (let ((dict (dict-ref-code inst)))
	   (dolist (c (car (instance-gcontext inst)))
	     (setf dict (**app dict (dict-reference-code c param-vars))))
	   dict))))

;;; Functor m or Applicative m from Monad m (type-utils.mumble's
;;; monad-implied-class?): the instance for WrappedMonad m, a newtype,
;;; applied to the Monad dictionary.

(define (monad-implied-dict class param-vars)
  (let ((wrapped  (prelude-modern-def '|WrappedMonad|)))
    (if (or (not (monad-implied-class? class)) (eq? wrapped '#f))
	(begin
	  ;; (an internal error, at the definition being typed)
	  (phase-error 'no-dictionary
	    "Internal error: no dictionary for class ~A among ~A."
	    (def-name class) (map (lambda (p) (def-name (tuple-2-1 p))) param-vars))
	  (**abort "no dictionary"))
	(**app (dict-ref-code (lookup-instance wrapped class))
	       (dict-reference-code (implying-class class) param-vars)))))

(define (placeholder->method p param-vars decls)
  (let* ((method (method-placeholder-method p))
	 (class (method-var-class method))
	 (edecls (placeholder-enclosing-decls p))
	 (params (locate-params param-vars edecls decls)))
    (setf (placeholder-exp p)
	  (method-reference-code method class params))))

(define (method-reference-code m c param-vars)
  (method-reference-code-1 m c param-vars param-vars))

(define (method-reference-code-1 m c params all-params)
 (if (null? params)
     ;; a Functor or Applicative method from a Monad dictionary, or the
     ;; class's catch-all instance
     (**app (**var/def (tuple-2-2 (assq m (class-selectors c))))
	    (or (catch-all-dict c all-params)
		(monad-implied-dict c all-params)))
     (let ((pclass (tuple-2-1 (car params))))
       (if (or (eq? c pclass)
	       (memq c (class-super* pclass)))
	   (let* ((msel (assq m (class-selectors pclass)))
		  (mvar (tuple-2-2 msel)))
	     (**app (**var/def mvar) (**var/def (tuple-2-2 (car params)))))
	   (method-reference-code-1 m c (cdr params) all-params)))))

;;; This is for tyvars instantiated to a tycon.  A reference to the
;;; appropriate dictionary is generated.  This reference must be recursively
;;; dictionary converted since dictionaries may need subdictionaries
;;; when referenced.

;;; The instance of P's class whose head is the data family FAMILY, or #f.
(define (family-instance-for p family)
  (let ((class (if (dict-placeholder? p)
		   (dict-placeholder-class p)
		   (method-var-class (method-placeholder-method p)))))
    (or (typeable-class? class)   ; made when wanted (get-typeable-instance)
	(lisp:find-if (lambda (i) (and (instance-ok? i) (eq? (instance-algdata i) family)))
		      (class-instances class)))))

(define (process-instantiated-tyvar tycon p deferred decls)
  (let ((given (given-class-params p tycon decls)))
    (if given
	;; the enclosing binding's signature gives it (a flexible given:
	;; StringLike Text in ListLike's class, its instance in a later
	;; module; Hilite (RenamingTo m) in Agda's FromAbstract, before
	;; the instances for RenamingTo, as GHC prefers givens)
	(begin
	  (setf (placeholder-exp p)
		(if (dict-placeholder? p)
		    (dict-reference-code (dict-placeholder-class p) given)
		    (let ((m (method-placeholder-method p)))
		      (method-reference-code m (method-var-class m) given))))
	  deferred)
	(let ((qc (qc-given-find p (placeholder-class p) (list tycon) decls)))
	  (if qc
	      ;; a given quantified constraint's head (forall x. Curry x =>
	      ;; Curry (Apply t x)), before an instance, as GHC prefers
	      ;; givens
	      (mlet (((code d1) (qc-given-dict qc p deferred decls)))
		(setf (placeholder-exp p)
		      (if (dict-placeholder? p)
			  code
			  (let ((m (method-placeholder-method p)))
			    (**app (**var/def (tuple-2-2 (assq m (class-selectors
								    (placeholder-class p)))))
				   code))))
		d1)
	      (process-instantiated-tyvar-1 tycon p deferred decls))))))

;;; C at an application of a type variable, through C's instance C (t a).
(define (process-app-catch-all type p deferred decls)
  (let* ((class (placeholder-class p))
	 (instance (app-catch-all-instance class)))
    (mlet (((code def1)
	    (generate-dict-ref instance type deferred decls
			       (placeholder-enclosing-decls p)
			       (placeholder-overloaded-var p))))
      (setf (placeholder-exp p)
	    (if (dict-placeholder? p)
		code
		(**app (**var/def (tuple-2-2 (assq (method-placeholder-method p)
						   (class-selectors class))))
		       code)))
      def1)))

(define (instance-for-placeholder? tycon p)
  (let ((class (if (dict-placeholder? p)
		   (dict-placeholder-class p)
		   (method-var-class (method-placeholder-method p)))))
    (and (algdata? (ntycon-tycon tycon))
	 (lookup-instance (ntycon-tycon tycon) class)
	 '#t)))

(define (process-instantiated-tyvar-1 tycon p deferred decls)
  (let* ((alg (ntycon-tycon tycon))
	 (edecls (placeholder-enclosing-decls p))
	 (var (placeholder-overloaded-var p))
	 (class (if (dict-placeholder? p)
		    (dict-placeholder-class p)
		    (method-var-class (method-placeholder-method p))))
	 (instance (lookup-instance/type alg class tycon)))
    (if (dict-placeholder? p)
	(mlet (((code def1)
		(generate-dict-ref instance tycon deferred decls edecls var)))
	   (setf (placeholder-exp p) code)
	   (setf deferred def1))
	(let ((method (method-placeholder-method p)))
	  (instance-arg-types/checked instance tycon)
	  (if (and (every (function null?) (instance-gcontext instance))
		   (null? (instance-mcontext instance)))
	      (let ((mvar (tuple-2-2
			   (assq method (instance-methods instance)))))
		(setf (placeholder-exp p) (**var/def mvar)))
	      (mlet (((code def1)
		      (generate-dict-ref
		         instance tycon deferred decls edecls var))
		     (sel (tuple-2-2 (assq method (class-selectors class)))))
		(setf (method-placeholder-exp p) (**app (**var/def sel) code))
		(setf deferred def1)))))
    deferred))

;;; This generates a reference to a specific dictionary and binds
;;; needed subdictionaries.  Since subdictionaries may be part of the outer
;;; type environment new placeholders may be generated for later resolution.

(define (generate-dict-ref instance type deferred decls edecls var)
  (let* ((ctxt (instance-gcontext instance))
	 (dict (dict-ref-code instance)))
    (do-contexts (class ctxt) (ty (instance-arg-types/checked instance type))
      (let ((ntype (prune ty)))
	;; a synonym or a type family application (Item (Array a)) may
	;; expand to something else than a constructor: a type variable
	(when (ntycon? ntype)
	  (setf ntype (prune (expand-ntype-synonym ntype))))
	(cond
	 ((family-app? ntype)
	  ;; a type family application not decided (Functor (Corep p) of
	  ;; Compose's instance, profunctors): as any placeholder at it,
	  ;; given by the enclosing binding or left for later
	  (let ((p (**dict-placeholder class ntype edecls var)))
	    (setf deferred (process-placeholder p deferred decls))
	    (setf dict (**app dict p))))
	 ((and (ntycon? ntype) (undecided-flexible-instance/class? class ntype))
	  ;; an instance's context at a type whose flexible instance is
	  ;; not chosen yet (Subst (Pattern' x) of Subst [NamedArg
	  ;; (Pattern' x)], Agda's ceq): left for the enclosing binding
	  (let ((p (**dict-placeholder class ntype edecls var)))
	    (setf dict (**app dict p))
	    (push p deferred)))
	 ((and (ntycon? ntype) (given-type-gives? class edecls ntype decls))
	  ;; given by the enclosing binding at this type (megaparsec's
	  ;; Show (ParseError s e), for a field of type [ParseError s e])
	  (setf dict (**app dict (dict-reference-code
				  class (given-type-dict-params edecls ntype decls)))))
	 ((ntycon? ntype)
	  (mlet ((alg (ntycon-tycon ntype))
		 (instance (lookup-instance/type alg class ntype))
		 ((code dv1)
		  (generate-dict-ref
		    instance ntype deferred decls edecls var)))
	      (setf dict (**app dict code))
	      (setf deferred dv1)))
	 ((ntyapp? ntype)
	  (let* ((p (**dict-placeholder class ntype edecls var))
		 (given (given-class-params p ntype decls))
		 (qc (and (null? given) (qc-given-find p class (list ntype) decls))))
	    (cond ((not (null? given))
		   ;; given by the enclosing binding (a derived instance's
		   ;; inferred Eq (f a), for a field of type [f a])
		   (setf dict (**app dict (dict-reference-code class given))))
		  (qc
		   ;; by a given quantified constraint (KiCS2's forall x.
		   ;; Curry x => Curry (C_Apply t x))
		   (mlet (((code d1) (qc-given-dict qc p deferred decls)))
		     (setf dict (**app dict code))
		     (setf deferred d1)))
		  ((non-generic-app? ntype)
		   (setf dict (**app dict p))
		   (push p deferred))
		  (else
		   (signal-unresolved-app-constraint ntype p)))))
	 ((non-generic? ntype)
	  (let ((p (**dict-placeholder
		    class ntype edecls var)))
	    (setf dict (**app dict p))
	    (push p deferred)))
	 ((null? (ntyvar-dict-params ntype))
	  (let ((ref-code (**dict-placeholder
			   class ntype edecls var)))
	     (when (maybe-default-ambiguous-tyvar
		    ntype var (valdef-module (car edecls)))
		(process-placeholder ref-code '() decls))
	     (setf dict (**app dict ref-code))))
	 (else
	  (let ((p (locate-params (ntyvar-dict-params ntype) edecls decls)))
	    (setf dict (**app dict (dict-reference-code class p))))))))
    ;; then the instance's multi-parameter constraints (mp-classes.mumble)
    (when (not (null? (instance-mcontext instance)))
      (mlet (((d1 def1) (instance-mp-dict-args instance type dict deferred
					     decls edecls var)))
	(setf dict d1)
	(setf deferred def1)))
    (values dict deferred)))

;;; The following routines deal with recursive placeholders.  The basic
;;; strategy is to pass the entire context as a parameter with each
;;; recursive call (this could be optimized later to make use of an
;;; internal entry point).  The basic complication is that the context
;;; of each function in a letrec may be arranged differently.

;;; This generates a call inside decl 'from' to the var 'to'.  Vmap is an
;;; alist from vars to a list of vars corresponding to the gtyvars of
;;; the decl signature.

(define (recursive-call-code from to vmap)
  (let ((exp (**var/def to))
	(tyvars (tuple-2-2 (assq to vmap)))
	(contexts (gtype-context (var-type to))))
    (do-contexts (class contexts) (tyvar tyvars)
       (setf exp (**app exp (locate-param-var tyvar class from))))
    exp))

(define (locate-param-var tyvar class decl)
  (let ((vmap (tuple-2-2 (assq decl (ntyvar-dict-params tyvar)))))
    (**var/def (tuple-2-2 (assq class vmap)))))

;;; This is used to get the code for a specific dictionary reference.

(define (instance-arg-types/checked instance type)
  (when (not (instance-head-matches? instance type))
    (phase-error 'no-instance
      "No instance of ~A for ~A: the instance is for ~A."
      (instance-class instance) type (make-instance-type instance)))
  (instance-arg-types instance type))

(define (dict-ref-code instance)
  (cond ((typeable-instance? instance)
	 (**app (**var/def (typeable-dict-builder))
		(**string (typeable-tycon-string (instance-algdata instance)))))
	((instance-newtype-of instance)
	 ;; the field type's dictionary (derived-instances.mumble's
	 ;; add-newtype-derived-instance), as the newtype's: its type is
	 ;; the field type's (Agda's MutualId, a Word32, in HasFresh's
	 ;; superclass Enum)
	 (make cast (exp (**var/def (instance-dictionary instance)))))
	(else
	 (**var/def (instance-dictionary instance)))))

;;; This is used to locate the correct enclosing decl.

(define (search-enclosing-decls decl-list decls)
  (cond ((null? decl-list)
	 (error "Lost decl in search-enclosing-decls!"))
	((memq (car decl-list) decls)
	 (car decl-list))
	(else
	 (search-enclosing-decls (cdr decl-list) decls))))



;;; A constraint on an application of a type variable (`Show (m a)') that
;;; is not tied to an enclosing monomorphic variable cannot be turned into
;;; a dictionary parameter.

(define (non-generic-app? type)
  (let ((head (prune (ntyapp-fun type))))
    (and (ntyvar? head) (non-generic? head))))

(define (signal-unresolved-app-constraint type p)
  (phase-error 'unresolved-app-constraint
    "Cannot resolve the constraint ~A on the type ~A~%~
     (a context on an application of a type variable)."
    (if (dict-placeholder? p)
	(dict-placeholder-class p)
	(method-var-class (method-placeholder-method p)))
    type))

;;; The dictionary parameters, as (class . var), that the binding
;;; enclosing placeholder P takes for constraints given at TYPE, an
;;; application of a type variable (Monad (m s) in its signature, kept by
;;; util/signature.mumble's reduce-flexible-contexts as a multi-parameter
;;; constraint of one type).
;;; Given parameters at TYPE that give P's class (or by a subclass), or #f.
(define (given-class-params p type decls)
  (let ((given (given-app-dict-params p type decls))
	(class (placeholder-class p)))
    (and (or (lisp:some (lambda (g) (or (eq? (tuple-2-1 g) class)
					(memq class (class-super* (tuple-2-1 g)))))
			given)
	     ;; Functor (t m) from a given Monad (t m) (free's iterTM)
	     (and (monad-implied-class? class)
		  (context-implies-monad-class? (map (function tuple-2-1) given) class)))
	 given)))

(define (given-app-dict-params p type decls)
  (given-type-dict-params (placeholder-enclosing-decls p) type decls))

(define (given-type-dict-params edecls type decls)
  (let ((decl (find-enclosing-decl edecls decls)))
    (if (eq? decl '#f)
	'()
	(lisp:mapcan (lambda (param)
		       (if (and (null? (cdr (mp-param-types param)))
				(mp-type-equal? (car (mp-param-types param)) type))
			   (list (tuple (mp-param-class param) (mp-param-var param)))
			   '()))
		     (valdef-mp-dict-params decl)))))

(define (given-type-gives? class edecls type decls)
  (lisp:some (lambda (g) (or (eq? (tuple-2-1 g) class)
			     (memq class (class-super* (tuple-2-1 g)))))
	     (given-type-dict-params edecls type decls)))

;;; Whether a match gives CLASS (or a subclass of it) at TYPE.
(define (pattern-local-given-gives? class type)
  (lisp:some (lambda (g) (or (eq? (tuple-2-1 g) class)
			     (memq class (class-super* (tuple-2-1 g)))))
	     (pattern-local-given-params type)))
