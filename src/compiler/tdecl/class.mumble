;;; Before classes are converted, the super class relation is computed.
;;; This sets up the super and super* field of each class and
;;; checks for the following errors:
;;;  Wrong tyvar in context
;;;  cyclic class structure
;;;  Non-class in context

(define (compute-super-classes modules)
  (let ((all-classes '()))
    (walk-modules modules
     (lambda ()       
      (dolist (c (module-classes *module*))
       (remember-context c
	(with-slots class-decl (super-classes class class-var class-vars fundeps
				   mp-super-classes) c
	  (let* ((def (class-ref-class class))
		 (local-ctxts '())
		 (super '()))
	    (when (not (null? class-vars))
	      (setf (class-tyvars def) class-vars)
	      (setf (class-fundeps def)
		    (map (lambda (fd)
			   (tuple (fundep-positions (tuple-2-1 fd) class-vars c)
				  (fundep-positions (tuple-2-2 fd) class-vars c)))
			 fundeps))
	      ;; superclasses of a multi-parameter class: one-parameter
	      ;; classes of its type variables
	      (setf (class-mp-supers def)
		    (map (lambda (context)
			   (resolve-class (context-class context))
			   (tuple (class-ref-class (context-class context))
				  (locate-in-list (context-tyvar context) class-vars 0)))
			 super-classes))
	      ;; multi-parameter superclasses whose types are made of the
	      ;; class's type variables: MVector (Mutable v) a of Vector v a
	      ;; (mp-super-template)
	      (setf (class-mp-mp-supers def)
		    (lisp:mapcan
		     (lambda (mc)
		       (resolve-class (mp-context-class mc))
		       (let ((positions
			      (map (lambda (ty) (mp-super-template ty class-vars))
				   (mp-context-types mc))))
			 (if (and (class? (class-ref-class (mp-context-class mc)))
				  (every (lambda (p) (not (eq? p '#f))) positions))
			     (list (tuple (class-ref-class (mp-context-class mc)) positions))
			     '())))
		     mp-super-classes))
	      (setf super-classes '()))
	    ;; a one-parameter class's multi-parameter superclasses
	    ;; (class (G.Vector Vector a, M.MVector MVector a) => Unbox a):
	    ;; templates over its variable, as above
	    (when (and (null? class-vars) (not (null? mp-super-classes)))
	      (setf (class-mp-mp-supers def)
		    (lisp:mapcan
		     (lambda (mc)
		       (resolve-class (mp-context-class mc))
		       (let ((positions
			      (map (lambda (ty) (mp-super-template ty (list class-var)))
				   (mp-context-types mc))))
			 (if (and (class? (class-ref-class (mp-context-class mc)))
				  (every (lambda (p) (not (eq? p '#f))) positions))
			     (list (tuple (class-ref-class (mp-context-class mc)) positions))
			     '())))
		     mp-super-classes)))
	    (dolist (context super-classes)
              (with-slots context (class tyvar) context
		(when (not (eq? class-var tyvar))
		  (signal-super-class-tyvar-error class class-var tyvar))
		(resolve-class class)
		(let ((super-def (class-ref-class class)))
		  (when (not (eq? super-def *undefined-def*))
		    (push super-def super)
		    (when (eq? *unit* (def-unit super-def))
		      (push super-def local-ctxts))))))
	    (update-slots class def
	       (super super)
	       (tyvar class-var))
	    (push (cons def local-ctxts) all-classes)))))))
    (multiple-value-bind (status sorted) (topsort all-classes)
      (when (eq? status 'cyclic)
	(signal-cyclic-class-structure sorted))
      (dolist (c sorted)
        (let* ((super (class-super c))
	       (super* super))
	   (dolist (s super)
	     (setf super* (set-union super* (class-super* s)))
	     (setf (class-super* c) super*)))))))

(define (fundep-positions vars class-vars decl)
  (map (lambda (v)
	 (if (memq v class-vars)
	     (locate-in-list v class-vars 0)
	     (begin (signal-bad-fundep-var v decl) 0)))
       vars))

(define (signal-bad-fundep-var v decl)
  (phase-error 'bad-fundep-var
    "~A in a functional dependency of ~A is not one of the class's type variables."
    v (class-ref-name (class-decl-class decl))))

;;; A superclass argument as a template over the class's type variables:
;;; a variable's position, or (tycon-def . argument templates) for a type
;;; constructor or family applied to such (Mutable v); #f otherwise.
;;; util/signature.mumble's instantiate-mp-super-template undoes it.

(define (mp-super-template ty class-vars)
  (cond ((tyvar? ty)
	 (and (memq (tyvar-name ty) class-vars)
	      (locate-in-list (tyvar-name ty) class-vars 0)))
	((tycon? ty)
	 (resolve-type-1 ty '() '#t)
	 (let ((args (map (lambda (a) (mp-super-template a class-vars))
			  (tycon-args ty))))
	   (and (not (eq? (tycon-def ty) *undefined-def*))
		(every (lambda (a) (not (eq? a '#f))) args)
		(cons (tycon-def ty) args))))
	(else '#f)))

(define (signal-mp-superclasses-unsupported class)
  (phase-error 'mp-superclasses
    "Superclasses of a multi-parameter class (~A) are not supported yet."
    (class-ref-name class)))

(define (signal-super-class-tyvar-error class class-var tyvar)
  (recoverable-error 'super-class-tyvar-error
    "The context for class ~A must only refer to type variable ~A.~%~
     Type variable ~A cannot be used here."
    (class-ref-name class) class-var tyvar))

(define (signal-cyclic-class-structure classes)
  (fatal-error 'cyclic-class-structure
    "There is a cycle in the superclass relation involving these classes:~%~a"
    classes))


;;;  This sets up the following fields in the class entry:
;;;    instances '()
;;;    defaults = ast for defaults
;;;    kind
;;;    methods
;;;    signatures
;;;    method-vars
;;;    selectors
;;;  Each method is initialized with
;;;    class
;;;    signature
;;;    type
;;;  Errors detected:
;;;   signature doesnt reference class 

(define (class->def class-decl)
 (remember-context class-decl
   (let* ((class (class-ref-class (class-decl-class class-decl)))
	  (decls (class-decl-decls class-decl)))
     (setf (class-instances class) '())
     (setf (class-kind class) (find-class-kind class))
     (init-methods class decls)  ; sets up defaults, method signatures
     (setf (class-n-methods class) (length (class-method-vars class)))
     (setf (class-dict-size class)
	   (+ (class-n-methods class) (length (class-super* class))))
     class)))

(define (find-class-kind class)
  (cond ((not (module-prelude? *module*))
	 'other)
	;; Haskell 98 4.3.4: defaulting is allowed when all the classes
	;; are from the Prelude or a standard library, so the standard
	;; classes that are not core symbols (Bounded) count too.
	((and (haskell98?) (eq? (def-name class) '|Bounded|))
	 'Standard)
	((memq class
	       (list (core-symbol "Eq") (core-symbol "Ord")
		     (core-symbol "Text") (core-symbol "Binary")
		     (core-symbol "Show") (core-symbol "Read")
		     (core-symbol "Ix") (core-symbol "Enum")))
	 'Standard)
	((memq class
	       (list (core-symbol "Num") (core-symbol "Real")
		     (core-symbol "Integral") (core-symbol "Fractional")
		     (core-symbol "Floating") (core-symbol "RealFrac")
		     (core-symbol "RealFloat")))
		     'Numeric)
	(else
	 'other)))

(define (init-methods class decls)
 (let* ((tyvar (class-tyvar class))
	;; a multi-parameter class has all its tyvars
	(class-tyvars (if (mp-class? class) (class-tyvars class) (list tyvar)))
        (class-context (if (mp-class? class)
			   '()
			   (list (**context (**class/def class) tyvar))))
	(class-mcontext (if (mp-class? class)
			    (list (**mp-context (**class/def class)
						(map (function **tyvar) class-tyvars)))
			    '())))
  (let ((default-sigs '()))   ; (tuple method-name signature)
  ;; DefaultSignatures (GHC): the default method has this type
  (dolist (decl decls)
    (when (and (is-type? 'signdecl decl) (signdecl-default? decl))
      (resolve-signature (signdecl-signature decl))
      (dolist (v (signdecl-vars decl))
	(push (tuple (var-ref-name v)
		     (rename-class-sig-vars (signdecl-signature decl) class-tyvars))
	      default-sigs))))
  (dolist (decl decls)
   (remember-context decl
    (cond ((and (is-type? 'signdecl decl) (signdecl-default? decl))
	   '#f)
	  ((is-type? 'signdecl decl)
	   (let* ((signature (signdecl-signature decl))
		  (vars (resolve-signature signature)))
	     ;; AllowAmbiguousTypes (GHC): a method may mention none of the
	     ;; class's variables (name :: String in class Name a b); its
	     ;; type has them in its context, and a type application picks
	     ;; the instance (name @Int @Bool)
	     (when (and (not (some (lambda (v) (memq v vars)) class-tyvars))
			(not (module-extension? "AllowAmbiguousTypes")))
	       (signal-class-sig-ignores-type signature))
	     ;; Note: signature does not include defined class yet
	     (dolist (context (signature-context signature))
               (when (memq (context-tyvar context) class-tyvars)
		 (signal-method-constrains-class-tyvar context)))
	     (setf signature (rename-class-sig-vars signature class-tyvars))
	     (let ((gtype (ast->gtype (append class-context
					      (signature-context signature))
				      (signature-type signature)
				      (append class-mcontext
					      (signature-mcontext signature))
				      ;; the class's tyvar first (the carrier)
				      (if (mp-class? class) '() (list tyvar)))))
 	       (dolist (var-ref (signdecl-vars decl))
	         (let ((var (var-ref-var var-ref)))
		   (setf (var-type var) gtype)
		   (setf (method-var-method-signature var) signature))))))
	  (else  ; decl must be a default definition
	   (let ((vars (collect-pattern-vars (valdef-lhs decl))))
	     (dolist (var-ref vars)
	       (resolve-var var-ref)
               (let* ((method-name (var-ref-name var-ref))
		      (method-var (var-ref-var var-ref)))
		 (when (not (eq? method-var *undefined-def*))
		  (if (and (method-var? method-var)
			   (eq? (method-var-class method-var) class))
		   (let ((default-var
			   (make-new-var
			     (string-append
			       "default-"
			       (symbol->string (def-name method-var))))))
		     (setf (var-ref-var var-ref) default-var)
		     (setf (var-ref-name var-ref) (def-name default-var))
		     (when (not (eq? (method-var-default method-var) '#f))
		       (signal-multiple-definition-of-default method-name))
		     (setf (method-var-default method-var) default-var)
		     (let* ((dsig (assq (def-name method-var) default-sigs))
			    (sig (if dsig
				     (tuple-2-2 dsig)
				     (method-var-method-signature method-var)))
			    (context (append class-context
					     (signature-context sig)))
			    (new-sig (**signature context
						  (signature-type sig))))
		       (setf (signature-mcontext new-sig)
			     (append class-mcontext (signature-mcontext sig)))
		       ;; ScopedTypeVariables: the class's variables scope
		       ;; over the default's body ((dummy :: a)), as in GHC
		       (when (module-extension? "ScopedTypeVariables")
			 (setf (signature-foralls new-sig) class-tyvars))
		       (add-new-module-signature default-var new-sig)))
		   (signal-default-not-in-class method-var class)))))
	     (add-new-module-decl decl)))))))))

(define (signal-class-sig-ignores-type signature)
  (phase-error 'class-sig-ignores-type
    "The method signature ~a does not reference the overloaded type."
    signature))


;;; *** I don't understand this message.

(define (signal-method-constrains-class-tyvar context)
  (phase-error 'method-constrains-class-tyvar
    "Individual methods may not further constrain a class: ~A" context))


;;; *** I don't understand this message.

(define (signal-multiple-definition-of-default method-name)
  (phase-error 'multiple-definition-of-default
   "More that one default for ~A."
   method-name))


;;; *** I don't understand this message.

(define (signal-default-not-in-class method-var class)
  (phase-error 'default-not-in-class
	       "~A is not a method in class ~A."
	       method-var class))

	   
(define (create-selector-functions class)
  (let ((res '()))
    (dolist (c (cons class (class-super* class)))
      (dolist (m (class-method-vars c))
	;; a superclass's method's selector names that class too: the
	;; method may have the same name as one of this class's
	;; (MonadFail's fail and Monad's fail)
	(let* ((var (make-new-var
	        (string-append "sel-"
			       (symbol->string (def-name class))
			       "/"
			       (if (eq? c class)
				   ""
				   (string-append (symbol->string (def-name c)) "."))
			       (symbol->string (def-name m)))))
	       (sel-body (create-selector-code class m)))
	  (setf (var-selector-fn? var) '#t)
	  (push (tuple m var) res)
	  (when (not (eq? (module-type *module*) 'interface))
	     (add-new-module-def var sel-body)))))
    res))

(define (create-selector-code c m)
  (let ((var (create-local-definition '|d|)))
    (setf (var-force-strict? var) '#t)
    (let ((body (create-selector-code-1 c m (**var/def var))))
      (**lambda/pat (list (**var-pat/def var)) body))))

(define (create-selector-code-1 class method d)
  (let ((mcl (method-var-class method)))
    (cond ((eq? mcl class)
	   (**dsel/method class method d))
	  (else
	   (**dsel/method mcl method (**dsel/dict class mcl d))))))
	     
;;; The following code is for the alpha conversion of method
;;; signatures.  The class tyvar is unchanged; all others are renamed.
;;; This is needed because all method types are combined to form the
;;; dictionary signature and aliasing among different tyvars should be
;;; prevented.

(define (rename-class-sig-vars signature tyvars)
  (mlet (((new-context env1)
	  (rename-context-vars (signature-context signature)
			       (map (lambda (v) (tuple v v)) tyvars)))
	 ((new-type env2)
	  (rename-type-vars (signature-type signature) env1))
	 (new-sig (**signature new-context new-type)))
    (setf (signature-mcontext new-sig)
	  (map (lambda (c)
		 (**mp-context (mp-context-class c)
			       (map (lambda (ty)
				      (mlet (((ty1 _) (rename-type-vars ty env2)))
					ty1))
				    (mp-context-types c))))
	       (signature-mcontext signature)))
    new-sig))

(define (rename-context-vars contexts env)
  (if (null? contexts)
      (values '() env)
      (mlet (((new-tyvar env1)
	      (rename-sig-tyvar (context-tyvar (car contexts)) env))
	     ((rest env2)
	      (rename-context-vars (cdr contexts) env1)))
       (values (cons (**context (context-class (car contexts)) new-tyvar) rest)
	       env2))))

(define (rename-type-vars type env)
  (cond ((tyvar? type)
	 (mlet (((tyvar env1)
		 (rename-sig-tyvar (tyvar-name type) env)))
	   (values (**tyvar tyvar) env1)))
	((tyapp? type)
	 (mlet (((fun env1) (rename-type-vars (tyapp-fun type) env))
		((new-types env2) (rename-type-vars/l (tyapp-args type) env1)))
	   (values (**tyapp fun new-types) env2)))
	((forall-type? type)
	 ;; a rank-n argument (cohoist :: (forall x. w x -> v x) -> ...):
	 ;; its own variables keep their names, the class's are renamed
	 (let* ((bound  (forall-type-tyvars type))
		(local  (map (lambda (v) (tuple v v)) bound)))
	   (mlet (((body env1)
		   (rename-type-vars (forall-type-type type) (append local env)))
		  ((mcontext env2)
		   (rename-mcontext-vars (forall-type-mcontext type) env1)))
	     (values (make forall-type (tyvars bound)
			   (context (forall-type-context type))
			   (mcontext mcontext)
			   (type body))
		     (lisp:remove-if (lambda (e) (memq e local)) env2)))))
	(else
	 (mlet (((new-types env1) (rename-type-vars/l (tycon-args type) env)))
	   (values (**tycon/def (tycon-def type) new-types) env1)))))

(define (rename-mcontext-vars mcontext env)
  (if (null? mcontext)
      (values '() env)
      (mlet (((types env1) (rename-type-vars/l (mp-context-types (car mcontext)) env))
	     ((rest env2) (rename-mcontext-vars (cdr mcontext) env1)))
	(values (cons (**mp-context (mp-context-class (car mcontext)) types) rest)
		env2))))

(define (rename-type-vars/l types env)
  (if (null? types)
      (values '() env)
      (mlet (((type1 env1) (rename-type-vars (car types) env))
	     ((new-types env2) (rename-type-vars/l (cdr types) env1)))
          (values (cons type1 new-types) env2))))

(define (rename-sig-tyvar tyvar env)
  (let ((res (assq tyvar env)))
    (if (eq? res '#f)
	(let ((new-tyvar (gentyvar (symbol->string tyvar))))
	  (values new-tyvar (cons (tuple tyvar new-tyvar) env)))
	(values (tuple-2-2 res) env))))

(define *tyvar-counter* 0)

;;; This generates a new interned tyvar name

(define (gentyvar root)
  (incf *tyvar-counter*)
  (string->symbol (format '#f "~A-~A" root *tyvar-counter*)))
