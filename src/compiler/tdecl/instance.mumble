;;; tdecl/instance.mumble

;;; Convert an instance decl to a definition

;;; The treatment of instances is more complex than the treatment of other
;;; type definitions due to the possibility of derived instances.
;;; Here's the plan:
;;;  a) instance-decls are converted to instance structures.  The type
;;;     information is verified but the decls are unchanged.
;;;  b) All instances are linked into the associated classes.
;;;  c) Derived instances are generated.
;;;  d) Instance dictionaries are generated from the decls in the instances.
;;;     

;;; Instances-decl to instance definition conversion
;;; Errors detected:
;;;  Class must be a class
;;;  Data type must be an alg
;;;  Tyvars must be distinct
;;;  Correct number of tyvars
;;;  Context applies only to tyvars in simple
;;;  C-T restriction

;;; Needs work for interface files.

(define (instance->def inst-decl)
 ;; ConstraintKinds: constraint synonyms in the context (generic-data's
 ;; GShow0 (Rep a), GShow0 = GShow Proxy)
 (let ((sig (**signature (instance-decl-context inst-decl) (**tyvar '|a|))))
   (setf (signature-mcontext sig) (instance-decl-mcontext inst-decl))
   (expand-constraint-synonyms sig)
   (setf (instance-decl-context inst-decl) (signature-context sig))
   (setf (instance-decl-mcontext inst-decl) (signature-mcontext sig)))
 (let ((inst (if (not (null? (instance-decl-types inst-decl)))
		 (mp-instance->def inst-decl)
		 (instance->def-1 inst-decl)))
       (sigs '()))
   (dolist (e *instance-method-sigs*)
     (when (eq? (tuple-2-1 e) (instance-decl-class inst-decl))
       (push (tuple-2-2 e) sigs)))
   (when (and inst (not (null? sigs)))
     (push (tuple inst sigs) *instance-sigs*))
   inst))

;;; InstanceSigs with a forall (parser/typedecl-parser.mumble): for each
;;; instance, (tuple method-name signature).  The method's own type
;;; variables are given the signature's names, and scope over its body
;;; (instance D Tree where mk :: forall b. [b] -> Tree b; mk ys = r where
;;; r :: Tree b ...): generate-method-signature.
(define *instance-sigs* '())

;;; (tuple old-name new-name) for the method's type's variables, found by
;;; walking the method's type at the instance and the instance's
;;; signature's type together.
(define (instance-method-renaming inst method-var type)
  (let ((e (assq inst *instance-sigs*)))
    (if (not e)
	'()
	(let ((s (assq (def-name method-var) (tuple-2-2 e))))
	  (if (not s)
	      '()
	      (let ((env '()))
		(match-type-tyvars type (signature-type (tuple-2-2 s))
		  (lambda (old new)
		    (when (and (not (memq old (instance-tyvars inst)))
			       (not (assq old env)))
		      (push (tuple old new) env))))
		env))))))

(define (match-type-tyvars t1 t2 found)
  (cond ((and (tyvar? t1) (tyvar? t2))
	 (funcall found (tyvar-name t1) (tyvar-name t2)))
	;; the signature's forall, or a synonym for a polytype with its
	;; context (Agda's recurseExpr :: forall m. RecurseExprFn m Expr,
	;; type RecurseExprFn m a = Applicative m => ...)
	((forall-type? t2)
	 (match-type-tyvars t1 (forall-type-type t2) found))
	((forall-type? t1)
	 (match-type-tyvars (forall-type-type t1) t2 found))
	((and (tycon? t2)
	      (not (and (tycon? t1) (eq? (tycon-name t1) (tycon-name t2))))
	      (polytype-synonym-expansion t2 8))
	 (match-type-tyvars t1 (polytype-synonym-expansion t2 8) found))
	((and (tycon? t1) (tycon? t2)
	      (eqv? (length (tycon-args t1)) (length (tycon-args t2))))
	 (dolist2 (a (tycon-args t1)) (b (tycon-args t2))
	   (match-type-tyvars a b found)))
	((and (tyapp? t1) (tyapp? t2)
	      (eqv? (length (tyapp-args t1)) (length (tyapp-args t2))))
	 (match-type-tyvars (tyapp-fun t1) (tyapp-fun t2) found)
	 (dolist2 (a (tyapp-args t1)) (b (tyapp-args t2))
	   (match-type-tyvars a b found)))
	(else '#f)))

;;; An instance of a multi-parameter class: C t1 ... tn, each ti a tyvar
;;; or a type constructor applied to distinct tyvars.

(define (mp-instance->def inst-decl)
 (recover-errors '#f
  (remember-context inst-decl
    (with-slots instance-decl (context class types decls mcontext newtype-derived?
			       head-equalities?) inst-decl
      (dolist (ty types)
	(resolve-type-1 ty '() '#t))
      (resolve-class class)
      (let* ((class-def (class-ref-class class))
	     (tyvars (mp-instance-tyvars types)))
	(when (not (and (mp-class? class-def)
			(eqv? (length (class-tyvars class-def)) (length types))))
	  (signal-mp-instance-arity class-def (length types)))
	(resolve-signature-aux tyvars context)
	(dolist (c mcontext)
	  (resolve-class (mp-context-class c))
	  ;; (its types too: BUMP t (IsBase t), a family application)
	  (dolist (ty (mp-context-types c))
	    (resolve-type-1 ty '() '#t)))
	(dolist (old (class-instances class-def))
	  (when (and (instance-ok? old)
		     ;; (overlapping heads are allowed, the most specific
		     ;; chosen: mp-classes.mumble's find-mp-instance)
		     (identical-instance-heads? (instance-mp-types old) types)
		     ;; (another module's may be one never imported with this
		     ;; one: uniplate's Biplate a b in both .Typeable and .Data)
		     (eq? (def-module (instance-dictionary old)) *module-name*))
	    (signal-multiple-mp-instance class-def)))
	(let ((inst (new-mp-instance class-def types tyvars)))
	  (setf (instance-head-equalities? inst) head-equalities?)
	  (setf (instance-context inst) context)
	  ;; with the superclasses its dictionary's signature gives
	  ;; (util/signature.mumble's instance-mcontext-with-mp-supers):
	  ;; megaparsec's MonadParsec e s m => MonadParsec e s (StateT st m),
	  ;; whose methods want Ord (Token s)
	  (setf (instance-mcontext inst)
		(instance-mcontext-with-mp-supers
		 context
		 (with-mp-mp-superclasses
		  (append-new-mp-contexts mcontext (one-parameter-mp-superclasses context)))
		 tyvars))
	  (setf (instance-decls inst)
		(if newtype-derived?
		    (mp-newtype-method-decls class-def types)
		    decls))
	  (when newtype-derived?
	    (setf (instance-scoped-tyvars? inst) '#t))
	  (setf (instance-ok? inst) '#t)
	  inst))))))

;;; deriving instance C t1 .. tn-1 (N u1 ..) for a newtype N: each method
;;; is the one at N's field type (without N's remaining parameters),
;;; coerced, the class's other types the head's (as GHC's
;;; GeneralizedNewtypeDeriving, through the last parameter).

(define (mp-newtype-method-decls class types)
  (let* ((last   (car (lisp:last types)))
	 (alg    (and (tycon? last) (tycon-def last))))
    (if (not (and (algdata? alg) (algdata-newtype? alg)))
	(phase-error 'not-newtype-deriving
	  "A derived instance of ~A needs a newtype as its last type." class)
	(let* ((given   (tycon-args last))
	       (tyvars  (algdata-tyvars alg))
	       (dropped (list-tail tyvars (length given)))
	       (field   (car (con-types (car (algdata-constrs alg)))))
	       (field1  (substitute-tyvars-simultaneously
			 field (list-head tyvars (length given)) given))
	       (via     (drop-trailing-type-args field1 dropped))
	       (ctyvs   (class-tyvars class))
	       (lastv   (car (lisp:last ctyvs)))
	       (others  (lisp:butlast ctyvs)))
	  (map (lambda (m)
		 (let* ((sig     (method-var-method-signature m))
			(own     (lisp:set-difference
				  (ast-type-tyvars (signature-type sig)) ctyvs))
			(renamed (substitute-tyvars-simultaneously
				  (signature-type sig) own
				  (map (lambda (v) (declare (ignore v)) (**tyvar (gentyvar "m"))) own)))
			(head    (lisp:butlast types))
			(at-via  (substitute-tyvars-simultaneously
				  renamed (append others (list lastv)) (append head (list via))))
			(at-inst (substitute-tyvars-simultaneously
				  renamed (append others (list lastv)) (append head (list last)))))
		   (**define (def-name m) '()
		     (**app (make exp-sign
				  (exp (**var/def (prelude-prim-def '|primUnsafeCoerce|)))
				  (signature (**signature '() (**arrow-type at-via at-inst))))
			    (**var/def m)))))
	       (class-method-vars class))))))

;;; TYPE with the type variables VARS replaced by TYPES at once (through
;;; fresh names, so that a replacement mentioning a variable is safe).
(define (substitute-tyvars-simultaneously type vars types)
  (let ((fresh (map (lambda (v) (declare (ignore v)) (gentyvar "s")) vars))
	(b type))
    (dolist2 (v vars) (f fresh)
      (setf b (substitute-tyvar b v (**tyvar f))))
    (dolist2 (f fresh) (ty types)
      (setf b (substitute-tyvar b f ty)))
    b))

;;; The distinct tyvars of the head types, in order.
(define (mp-instance-tyvars types)
  ;; any types (FlexibleInstances: FoldableWithIndex [Int] Tree)
  (flexible-head-tyvars types '()))

;;; Two instance heads that overlap: in each position, types that could
;;; be the same: a tyvar, or the same type constructor with arguments that
;;; could be the same, synonyms expanded (GRead1 v (D1 d f) and
;;; GRead1 v (C1 c f), D1 = M1 D and C1 = M1 C, do not overlap).
;;; The same heads up to the names of their type variables.
;;; The same heads up to a renaming of their variables: (K1 i a) a and
;;; (K1 i a) b are not (generic-deriving's overlapping Uniplate').
(define (identical-instance-heads? types1 types2)
  (and (eqv? (length types1) (length types2))
       (not (eq? (identical-head-types types1 types2 '()) 'no))))

;;; The variable pairs ((v1 . v2) ...) of a renaming of T1 to T2, or no.
(define (identical-head-types l1 l2 pairs)
  (cond ((eq? pairs 'no) 'no)
	((null? l1) (if (null? l2) pairs 'no))
	((null? l2) 'no)
	(else (identical-head-types (cdr l1) (cdr l2)
				    (identical-head-type (car l1) (car l2) pairs)))))

(define (identical-head-type t1 t2 pairs)
  (cond ((and (tyvar? t1) (tyvar? t2))
	 (let ((p1 (assq (tyvar-name t1) pairs))
	       (p2 (lisp:rassoc (tyvar-name t2) pairs)))
	   (cond ((and (not p1) (not p2))
		  (cons (cons (tyvar-name t1) (tyvar-name t2)) pairs))
		 ((and p1 (eq? (cdr p1) (tyvar-name t2))) pairs)
		 (else 'no))))
	((and (tycon? t1) (tycon? t2))
	 (if (eq? (tycon-def t1) (tycon-def t2))
	     (identical-head-types (tycon-args t1) (tycon-args t2) pairs)
	     'no))
	((and (tyapp? t1) (tyapp? t2))
	 (identical-head-types (tyapp-args t1) (tyapp-args t2)
			       (identical-head-type (tyapp-fun t1) (tyapp-fun t2) pairs)))
	(else 'no)))

(define (same-instance-heads? types1 types2)
  (every (lambda (t1 t2) (instance-types-may-overlap? t1 t2 8))
	 types1 types2))

(define (instance-types-may-overlap? t1 t2 depth)
  (let ((t1 (expand-head-synonym t1 depth))
	(t2 (expand-head-synonym t2 depth)))
    (cond ((or (<= depth 0) (tyvar? t1) (tyvar? t2)) '#t)
	  ((and (tycon? t1) (tycon? t2))
	   (and (eq? (tycon-def t1) (tycon-def t2))
		(or (not (eqv? (length (tycon-args t1)) (length (tycon-args t2))))
		    (every (lambda (a1 a2) (instance-types-may-overlap? a1 a2 (1- depth)))
			   (tycon-args t1) (tycon-args t2)))))
	  (else '#t))))

;;; A synonym's application expanded (with more arguments than the
;;; synonym takes: type D1 = M1 D, D1 d f), else the type.
(define (expand-head-synonym type depth)
  (if (and (> depth 0)
	   (tycon? type)
	   (synonym? (tycon-def type))
	   (synonym-body (tycon-def type))
	   (not (synonym-family? (tycon-def type)))
	   (>= (length (tycon-args type)) (length (synonym-args (tycon-def type)))))
      (let* ((def   (tycon-def type))
	     (n     (length (synonym-args def)))
	     (body  (copy-synonym-body
		     (synonym-body def)
		     (map (function tuple) (synonym-args def)
			  (list-head (tycon-args type) n))))
	     (extra (list-tail (tycon-args type) n)))
	(expand-head-synonym
	 (if (and (tycon? body) (not (null? extra)))
	     (make tycon (def (tycon-def body)) (name (tycon-name body))
		   (args (append (tycon-args body) extra)))
	     body)
	 (1- depth)))
      type))

(define (signal-mp-instance-arity class n)
  (phase-error 'mp-instance-arity
    "The class ~A does not take ~A type arguments." class n))

(define (signal-multiple-mp-instance class)
  (phase-error 'multiple-instance
    "The instance overlaps another instance of class ~A." class))

(define (instance->def-1 inst-decl)
 (if (or (tyvar? (instance-decl-simple inst-decl))
	 (var-application-head? (instance-decl-simple inst-decl)))
     (catch-all-instance->def inst-decl)
     (instance->def-2 inst-decl)))

;;; instance ctx => C a: one per class (as GHC, it overlaps every other
;;; instance of C, which win where they apply).

(define (catch-all-instance->def inst-decl)
 (recover-errors '#f
  (remember-context inst-decl
    (with-slots instance-decl (context class simple decls mcontext) inst-decl
      (resolve-class class)
      (let* ((class-def (class-ref-class class))
	     ;; C a, or C (t a) (Agda's TermSize (t a)): at an
	     ;; application, t the function and a the last argument
	     ;; (type/unify.mumble's instance-arg-types)
	     (tyvars (if (tyvar? simple)
			 (list (tyvar-name simple))
			 (list (tyvar-name (tyapp-fun simple))
			       (tyvar-name (car (tyapp-args simple))))))
	     (tyvar (car tyvars)))
	(resolve-signature-aux tyvars context)
	(when (lisp:some (lambda (i) (and (instance-catch-all? i)
					  (eqv? (length (instance-tyvars i)) (length tyvars))
					  ;; (another module's may be one never
					  ;; imported with this one: uniplate's
					  ;; Uniplate a in both .Typeable and .Data)
					  (eq? (def-module (instance-dictionary i))
					       *module-name*)))
			 (class-instances class-def))
	  (signal-multiple-instance class-def simple))
	(let ((inst (make instance (algdata '#f) (tyvars tyvars)
			  (class class-def) (gcontext '()) (context '())
			  (dictionary (make-new-var
				       (unique-instance-name
					(string-append "dict-"
						       (symbol->string (print-name class-def))
						       "-all")))))))
	  (setf (instance-catch-all? inst) '#t)
	  (link-instance inst)
	  (setf (instance-context inst) context)
	  (dolist (c mcontext)
	    (resolve-class (mp-context-class c))
	    (dolist (ty (mp-context-types c))
	      (resolve-type-1 ty '() '#t)))
	  (setf (instance-mcontext inst) mcontext)
	  (setf (instance-decls inst) decls)
	  (setf (instance-ok? inst) '#t)
	  inst))))))

(define (instance->def-2 inst-decl)
 (recover-errors '#f
  (remember-context inst-decl
    (with-slots instance-decl (context class simple decls mcontext) inst-decl
      (resolve-type-1 simple '() '#t)
      (resolve-class class)
      ;; instance C String (TypeSynonymInstances): the synonym's expansion
      (do () ((not (and (haskell98?) (tycon? simple)
			(synonym? (tycon-def simple))
			(not (synonym-family? (tycon-def simple))))))
	(setf simple (expand-synonym simple)))
      (let ((alg-def (tycon-def simple))
	    (class-def (class-ref-class class))
	    (flexible? (flexible-instance-head? simple)))
        ;; or a data family: instance NFData (Vector a), for each of its
	;; data instances (util/instance-manager.mumble's
	;; data-family-instance)
        (when (not (or (algdata? (tycon-def simple))
		       (data-family-def? (tycon-def simple))))
	  (signal-datatype-required (tycon-def simple)))
        (let ((tyvars (if flexible?
			  (flexible-head-tyvars (tycon-args simple) '())
			  (simple-tyvar-list simple))))
	  (resolve-signature-aux tyvars context)
	  ;; Haskell 98 has no C-T rule: an instance may be declared in any
	  ;; module (duplicates are still rejected below).
	  (when (and (not (haskell98?))
		     (not (eq? *module-name* (def-module alg-def)))
		     (not (eq? *module-name* (def-module class-def))))
	    (signal-c-t-rule-violation class-def alg-def))
	  (let ((old-inst (lookup-instance alg-def class-def)))
	    ;; a flexible head may overlap another instance's
	    ;; (lookup-instance/type, util/instance-manager.mumble)
	    (when (and (not (eq? old-inst '#f))
		       (not (instance-special? old-inst))
		       (not flexible?)
		       (null? (instance-head-args old-inst)))
	    (signal-multiple-instance class-def alg-def))
	    (let ((inst (new-instance class-def alg-def tyvars)))
	      (when flexible?
		(setf (instance-head-args inst) (tycon-args simple)))
	      (setf (instance-context inst) context)
	      ;; multi-parameter constraints in the context
	      (dolist (c mcontext)
		(resolve-class (mp-context-class c))
		(dolist (ty (mp-context-types c))
		  (resolve-type-1 ty '() '#t)))
	      ;; with its one-parameter classes' multi-parameter
	      ;; superclasses (Unbox a gives G.Vector Vector a), which the
	      ;; methods' signatures get (util/signature.mumble)
	      (setf (instance-mcontext inst)
		    (with-mp-mp-superclasses
		     (append-new-mp-contexts
		      mcontext (one-parameter-mp-superclasses context))))
	      ;; and its multi-parameter constraints' one-parameter
	      ;; superclasses, as the dictionary's signature has them
	      (setf (instance-mcontext inst)
		    (instance-mcontext-with-mp-supers
		     (instance-context inst) (instance-mcontext inst) tyvars))
	      (setf (instance-decls inst) decls)
	      (setf (instance-ok? inst) '#t)
	      inst))))))))

;;; FlexibleInstances (GHC): the head is T t1 ... tn with the ti not all
;;; distinct type variables.  Its tyvars are those of the ti, in order.
;;; There is still one instance per class and type constructor; a use at
;;; T u1 ... un must match the head (instance-arg-types, type/unify.mumble).

(define (flexible-instance-head? simple)
  (and (haskell98?)
       (let ((args (tycon-args simple)))
	 (not (and (every (function tyvar?) args)
		   (null? (find-duplicates (map (function tyvar-name) args))))))))

(define (flexible-head-tyvars types vars)
  (if (null? types)
      (reverse vars)
      (let ((ty (car types)))
	(flexible-head-tyvars
	 (cdr types)
	 (cond ((tyvar? ty)
		(if (memq (tyvar-name ty) vars) vars (cons (tyvar-name ty) vars)))
	       ;; (VARS is newest first; the call answers them oldest first)
	       ((tycon? ty)
		(reverse (flexible-head-tyvars (tycon-args ty) vars)))
	       ((tyapp? ty)
		(reverse (flexible-head-tyvars (cons (tyapp-fun ty) (tyapp-args ty))
					       vars)))
	       (else vars))))))

(define (signal-datatype-required def)
  (phase-error 'datatype-required
    "The synonym type ~a cannot be declared as an instance."
    (def-name def)))

(define (signal-c-t-rule-violation class-def alg-def)
  (phase-error 'c-t-rule-violation
    "Instance declaration does not appear in the same module as either~%~
     the class ~a or type ~a."
    class-def alg-def))

(define (signal-multiple-instance class-def alg-def)
  (phase-error 'multiple-instance
    "The type ~a has already been declared to be an instance of class ~a."
    alg-def class-def))

;;; This generates the dictionary for each instance and makes a few final
;;; integrity checks in the instance context.  This happens after derived
;;; instances are inserted.

(define (expand-instance-decls inst)
  (when (instance-ok? inst)
    (cond ((instance-newtype-of inst)
	   (expand-newtype-derived-instance inst))
	  ((not (null? (instance-mp-types inst)))
	   (expand-mp-instance-decls inst))
	  (else
	   (expand-instance-decls-1 inst)))))

;;; A newtype is the same as its underlying type at run time, so a
;;; newtype-derived instance (derived/derived-instances.mumble) shares the
;;; underlying instance's dictionary and methods.

(define (expand-newtype-derived-instance inst)
  (let ((under  (instance-newtype-of inst)))
    (setf (instance-dictionary inst) (instance-dictionary under))
    (setf (instance-methods inst) (instance-methods under))
    ;; no class on each of the type's parameters
    (setf (instance-gcontext inst) (map (lambda (v) (declare (ignore v)) '())
					(instance-tyvars inst)))
    (setf (instance-context inst) '())
    (setf (instance-decls inst) '())))

;;; As expand-instance-decls, for a multi-parameter class: there are no
;;; superclasses, and the class's tyvars are replaced by the head types.

(define (expand-mp-instance-decls inst)
  (with-slots instance (class dictionary decls) inst
    ;; uniquify the instance's tyvars, as for one-parameter instances
    ;; (and, the same way, keep under ScopedTypeVariables those no method
    ;; signature uses, so that they scope over the methods)
    (let* ((taken (class-method-tyvar-names class))
	   (new-tyvars (map (lambda (tyvar)
			      (tuple tyvar
				     (if (and (or (module-extension? "ScopedTypeVariables")
						  (instance-scoped-tyvars? inst))
					      (not (memq tyvar taken)))
					 tyvar
					 (gentyvar "tv"))))
			    (instance-tyvars inst))))
      (setf (instance-tyvars inst) (map (function tuple-2-2) new-tyvars))
      (setf (instance-mp-types inst)
	    (map (lambda (ty) (rename-ast-tyvars ty new-tyvars))
		 (instance-mp-types inst)))
      (setf (instance-context inst)
	    (map (lambda (c)
		   (**context (context-class c)
			      (tuple-2-2 (assq (context-tyvar c) new-tyvars))))
		 (instance-context inst)))
      (setf (instance-mcontext inst)
	    (map (lambda (c)
		   (**mp-context (mp-context-class c)
				 (map (lambda (ty) (rename-ast-tyvars ty new-tyvars))
				      (mp-context-types c))))
		 (instance-mcontext inst))))
    (setf (instance-gcontext inst) '())
    (let ((methods-used '())
	  (new-instance-vars (map (lambda (m) (tuple m (method-def-var m inst)))
				  (class-method-vars class))))
      (dolist (decl decls)
	(setf methods-used
	      (process-instance-decl decl new-instance-vars methods-used)))
      (dolist (m-v new-instance-vars)
	(let* ((method-var (tuple-2-1 m-v))
	       (definition-var (tuple-2-2 m-v))
	       (signature (generate-method-signature inst method-var '#t)))
	  (when (not (memq method-var methods-used))
	    (add-new-module-def definition-var
	      (if (eq? (method-var-default method-var) '#f)
		  (begin
		    (signal-missing-method method-var inst)
		    (**abort (format '#f
			       "No method declared for method ~A in instance ~A ~A."
			       method-var class (instance-mp-types inst))))
		  (**var/def (method-var-default method-var)))))
	  (add-new-module-signature definition-var signature)))
      (setf (instance-methods inst) new-instance-vars)
      (add-new-module-def dictionary
	(if (null? new-instance-vars)
	    ;; a class without methods: [] (generate-mp-dictionary-type)
	    (**null)
	    (**tuple/l (map (lambda (m-v)
			      (dict-method-ref (tuple-2-1 m-v) (tuple-2-2 m-v) inst))
			    new-instance-vars))))
      (add-new-module-signature dictionary (generate-dictionary-signature inst))
      (setf (instance-decls inst) '()))))

;;; Today's base defaults Monad's return to pure, and MonadPlus's mzero and
;;; mplus to Alternative's empty and <|>; the Haskell 98 Prelude's Monad
;;; and MonadPlus have no defaults.  While PreludeModern is loaded, an
;;; instance without them gets PreludeModern's (which need the type's
;;; Applicative or Alternative instance, as base does: Control.Arrow's
;;; instance MonadPlus m => MonadPlus (Kleisli m a)).  Returns the
;;; default's var, or '#f.

(define (monad-return-default method-var)
  (cond ((eq? method-var (core-symbol "return"))
	 (prelude-modern-def '|pure|))
	((not (eq? (def-name (method-var-class method-var)) '|MonadPlus|))
	 '#f)
	((eq? (def-name method-var) '|mzero|)
	 (prelude-modern-def '|empty|))
	((eq? (def-name method-var) '|mplus|)
	 (prelude-modern-def '|<\|>|))
	(else '#f)))

(define (rename-ast-tyvars type new-tyvars)
  (if (null? new-tyvars)
      type
      (rename-ast-tyvars
       (substitute-tyvar type (tuple-2-1 (car new-tyvars))
			 (**tyvar (tuple-2-2 (car new-tyvars))))
       (cdr new-tyvars))))

;;; The class's tyvars replaced by an instance's types (in an AST type).
(define (substitute-class-tyvars type inst)
  (let ((class (instance-class inst)))
    (if (null? (instance-mp-types inst))
	(substitute-tyvar type (class-tyvar class) (make-instance-type inst))
	;; simultaneously: an instance type may mention a name that is
	;; also a class variable (instance C (S l) (a, b) r for class
	;; C n l r), so the class variables are first renamed apart
	(let ((fresh (map (lambda (tv)
			    (declare (ignore tv))
			    (make tyvar (name (gentyvar "cv"))))
			  (class-tyvars class))))
	  (substitute-class-tyvars-1
	   (substitute-class-tyvars-1 type (class-tyvars class) fresh)
	   (map (function tyvar-name) fresh)
	   (instance-mp-types inst))))))

(define (substitute-class-tyvars-1 type tyvars types)
  (if (null? tyvars)
      type
      (substitute-class-tyvars-1 (substitute-tyvar type (car tyvars) (car types))
				 (cdr tyvars) (cdr types))))

(define (expand-instance-decls-1 inst)
  (when (instance-ok? inst)
    (check-inst-type inst)
    (with-slots instance (class algdata dictionary decls context tyvars) inst
     (let ((simple (make-instance-type inst)))
      (setf (instance-gcontext inst)
	    (gtype-context (ast->gtype/inst context simple)))
      (with-slots class (super* method-vars) class
	;; Before computing signatures uniquify tyvar names to prevent
        ;; collision with method tyvar names.  Under ScopedTypeVariables
        ;; a name no method signature uses is kept, so that the
        ;; instance head's type variables scope over the methods (GHC):
        ;; generate-method-signature marks them as scoped.
	(let* ((taken (class-method-tyvar-names class))
	       (new-tyvars
		(map (lambda (tyvar)
		       (tuple tyvar
			      (if (and (or (module-extension? "ScopedTypeVariables")
					   (instance-scoped-tyvars? inst))
				       (not (memq tyvar taken)))
				  tyvar
				  (gentyvar "tv"))))
		     (instance-tyvars inst))))
	  (setf (instance-tyvars inst) (map (function tuple-2-2) new-tyvars))
	  (setf (instance-head-args inst)
		(map (lambda (ty) (rename-ast-tyvars ty new-tyvars))
		     (instance-head-args inst)))
	  (setf (instance-context inst)
   	    (map (lambda (c)
                  (**context (context-class c)
			     (tuple-2-2 (assq (context-tyvar c) new-tyvars))))
		 (instance-context inst)))
	  (setf (instance-mcontext inst)
	    (map (lambda (c)
		   (**mp-context (mp-context-class c)
				 (map (lambda (ty) (rename-ast-tyvars ty new-tyvars))
				      (mp-context-types c))))
		 (instance-mcontext inst))))
	;; Now walk over the decls & rename each method with a unique name
	;; generated by combining the class, type, and method.  Watch for
	;; multiple defs of methods and add defaults after all decls have
	;; been scanned.
	(let ((methods-used '())
	      (new-instance-vars (map (lambda (m)
					(tuple m (method-def-var m inst)))
				      method-vars)))
          (dolist (decl decls)
            (setf methods-used
  	      (process-instance-decl decl new-instance-vars methods-used)))
	  ;; now add defaults when needed
	  (dolist (m-v new-instance-vars)
           (let* ((method-var (tuple-2-1 m-v))
		  (definition-var (tuple-2-2 m-v))
		  (signature (generate-method-signature inst method-var '#t)))
            (if (memq method-var methods-used)
		(add-new-module-signature definition-var signature)
		(let ((method-body
		       (cond
			((monad-return-default method-var)
			 (**var/def (monad-return-default method-var)))
			((eq? (method-var-default method-var) '#f)
			   (signal-missing-method method-var inst)
			   (**abort (format '#f
     "No method declared for method ~A in instance ~A(~A)."
                              method-var class algdata)))
			(else
			   (**var/def (method-var-default method-var))))))
		  (add-new-module-def definition-var method-body)
		  (add-new-module-signature definition-var signature)))))
	  (setf (instance-methods inst) new-instance-vars)
	  (add-new-module-def dictionary
	   (if (empty-dictionary-class? class)
	     (**null)   ; (generate-dictionary-type)
	     (**tuple/l (append (map (lambda (m-v)
				       (dict-method-ref
					(tuple-2-1 m-v)	(tuple-2-2 m-v)	inst))
				     new-instance-vars)
				(map (lambda (c)
				       (cond ((or (instance-catch-all? inst)
						  ;; a flexible instance (S (UTF8
						  ;; B.ByteString)): S at its head,
						  ;; as the type checker finds it among
						  ;; S's instances for the constructor
						  (and (not (null? (instance-head-args inst)))
						       (several-instances? algdata c)))
					      (catch-all-super-dict c))
					     ((num-stub-superclass? inst c)
					      (**abort (format '#f
     "Num ~A has no ~A instance here (base's Num has no superclasses)."
						     algdata c)))
					     (else
					      (get-class-dict algdata c))))
				     super*)))))
	  (let ((dict-sig (generate-dictionary-signature inst)))
	    (add-new-module-signature dictionary dict-sig))
	  (setf (instance-decls inst) '())))))))

;;; GHC's -Wmissing-methods, for an instance declaration (not a derived
;;; one): the method has no definition and no default, so calling it is
;;; an error.
(define (signal-missing-method method-var inst)
  (when (explicit-module-instance? inst)
    (maybe-remember-context inst
      (haskell-warning 'missing-method
	"No definition of ~A in the instance ~A ~A, and the class has no default: calling it is a run-time error."
	method-var (instance-class inst)
	(or (instance-algdata inst) (instance-mp-types inst))))))

(define (dict-method-ref method-var inst-var inst)
  ;; the method's own context (one- or multi-parameter) stays its
  ;; parameters: the instance's dictionaries alone are applied
  (if (and (null? (signature-context (method-var-method-signature method-var)))
	   (null? (signature-mcontext (method-var-method-signature method-var))))
      (if (ambiguous-instance-method? inst method-var)
	  (instance-method-type-app inst method-var inst-var)
	  (**var/def inst-var))
      (let ((sig (generate-method-signature inst method-var '#f)))
	(make overloaded-var-ref
	      (sig (signature->gtype sig))
	      (var inst-var)))))

;;; AllowAmbiguousTypes: a method whose type leaves out a variable the
;;; instance's context constrains (generic-data's gCardinality :: Int in
;;; instance (Bounded c, Enum c) => GEnum FiniteEnum (K1 i c)).  The
;;; dictionary names the instance's variables (scoped: its signature's
;;; foralls) and applies the method to them, m @c, in the order of the
;;; method's type's variables; another of its variables is a fresh one.

(define (ambiguous-instance-method? inst method-var)
  (let ((in-type (ast-tyvar-names
		  (substitute-class-tyvars
		   (signature-type (method-var-method-signature method-var)) inst))))
    (lisp:some (lambda (v) (not (memq v in-type)))
	       (instance-context-tyvars inst))))

(define (instance-context-tyvars inst)
  (append (map (function context-tyvar) (instance-context inst))
	  (lisp:mapcan (lambda (c)
			 (lisp:mapcan (function ast-tyvar-names)
				      (mp-context-types c)))
		       (instance-mcontext inst))))

(define (instance-method-type-app inst method-var inst-var)
  (let* ((g (signature->gtype (generate-method-signature inst method-var '#t)))
	 (exp (**var/def inst-var))
	 (n 0))
    (dolist (name (gtype-tyvar-names g))
      (setf exp (make type-app (exp exp)
		      (type (**tyvar (if (memq name (instance-tyvars inst))
					 name
					 (begin
					   (incf n)
					   (string->symbol
					    (format '#f "fresh-~A" n)))))))))
    exp))

(define (instance-has-ambiguous-method? inst)
  (lisp:some (lambda (m)
	       (and (null? (signature-context (method-var-method-signature m)))
		    (null? (signature-mcontext (method-var-method-signature m)))
		    (ambiguous-instance-method? inst m)))
	     (class-method-vars (instance-class inst))))

;;; A catch-all instance's (instance GFoldable_ t => GFoldable t,
;;; generic-data) superclass dictionary at its variable: from its context,
;;; as the type checker finds it.  primUnsafeCoerce, the identity, is
;;; given the type S a => <S's dictionary at a>, so that the dictionary
;;; placeholder for S a is its argument.
(define (several-instances? algdata class)
  (> (lisp:count-if (lambda (i) (eq? (instance-algdata i) algdata))
		    (class-instances class))
     1))

(define (catch-all-super-dict super)
  (let ((sig (**signature (list (**context (**class/def super) '|a|))
			  (class-dictionary-type super (**tyvar '|a|)))))
    (make overloaded-var-ref
	  (sig (signature->gtype sig))
	  (var (prelude-prim-def '|primUnsafeCoerce|)))))

;;; The type of CLASS's dictionary at SIMPLE, from the class alone: its
;;; methods' types, then its superclasses' dictionaries.
(define (class-dictionary-type class simple)
  (if (empty-dictionary-class? class)
      (**tycon/def (core-symbol "List") (list simple))
      (**tuple-type/l
       (append (map (lambda (m)
		      (substitute-tyvar (signature-type (method-var-method-signature m))
					(class-tyvar class) simple))
		    (class-method-vars class))
	       (map (lambda (s) (class-dictionary-type s simple))
		    (class-super* class))))))

(define (get-class-dict algdata class)
  (let ((inst (lookup-instance algdata class)))
    (if (eq? inst '#f)
	(**abort "Missing super class")
	;; (a Typeable superclass's dictionary is made from the type's name)
	(dict-ref-code inst))))
					 
(define (process-instance-decl decl new-instance-vars methods-used)
  (if (valdef? decl)
      (rename-instance-decl decl new-instance-vars methods-used)
      (begin
       (dolist (a (annotation-decls-annotations decl))
	(cond ((annotation-value? a)
	       (recoverable-error 'misplaced-annotation
		      "Misplaced annotation: ~A~%" a))
	      (else
	       (dolist (name (annotation-decl-names a))
                 (attach-method-annotation
		  name (annotation-decl-annotations a) new-instance-vars)))))
       methods-used)))

(define (attach-method-annotation name annotations vars)
  (cond ((null? vars)
	 (signal-no-method name))
	((eq? name (def-name (tuple-2-1 (car vars))))
	 (setf (var-annotations (tuple-2-2 (car vars)))
	       (append annotations (var-annotations (tuple-2-2 (car vars))))))
	(else (attach-method-annotation name annotations (cdr vars)))))

(define (signal-no-method name)
  (recoverable-error 'no-method "~A is not a method in this class.~%"
      name))

(define (rename-instance-decl decl new-instance-vars methods-used)
  (let ((decl-vars (collect-pattern-vars (valdef-lhs decl))))
    (dolist (var decl-vars)
      ;; An instance's binding names the class's method, whatever is in
      ;; scope under that name (H2010 4.3.2): a module's fail or foldr may be
      ;; the Prelude's while the class is PreludeModern's, and the class
      ;; may be imported only qualified (Semigroup.<> in parsec).
      (let ((by-name (lisp:find (var-ref-name var) new-instance-vars
				:key (lambda (m-v) (def-name (tuple-2-1 m-v))))))
	(if (and by-name
		 (eq? (var-ref-var var) *undefined-def*)
		 (eq? (resolve-toplevel-name (var-ref-name var)) '#f))
	    (setf (var-ref-var var) (tuple-2-1 by-name))
	    (resolve-var var)))
      (let* ((by-name (lisp:find (var-ref-name var) new-instance-vars
				 :key (lambda (m-v) (def-name (tuple-2-1 m-v)))))
	     (method (if (and by-name
			      (not (assq (var-ref-var var) new-instance-vars)))
			 (tuple-2-1 by-name)
			 (var-ref-var var))))
        (when (not (eq? method *undefined-def*))
         (let ((m-v (assq method new-instance-vars)))
          (cond ((memq method methods-used)
		 (signal-multiple-instance-def method))
		((eq? m-v '#f)
		 (signal-not-in-class method))
		(else
		 (setf (var-ref-name var) (def-name (tuple-2-2 m-v)))
		 (setf (var-ref-var var) (tuple-2-2 m-v))
		 (push (tuple-2-1 m-v) methods-used)))))))
    (add-new-module-decl decl)
    methods-used))

(define (signal-multiple-instance-def method)
  (phase-error 'multiple-instance-def
    "The instance declaration has multiple definitions of the method ~a."
     method))

(define (signal-not-in-class method)
  (phase-error 'not-in-class
    "The instance declaration includes a definition for ~a,~%~
     which is not one of the methods for this class."
    method))


(define (method-def-var method-var inst)
  (make-new-var
   (unique-instance-name
    (string-append "i-"
		   (symbol->string (print-name (instance-class inst))) "-"
		   (instance-type-name inst) "-"
		   (symbol->string (def-name method-var))))))

;;; Two instances in a module can have the same type name (a lazy and a
;;; strict StateT, from different modules): later ones get -2, -3, ...

(define *instance-names* (make-table))

(define (unique-instance-name name)
  (let* ((key  (string->symbol (string-append (symbol->string *module-name*)
					      "." name)))
	 (n    (or (table-entry *instance-names* key) 0)))
    (setf (table-entry *instance-names* key) (1+ n))
    (if (eqv? n 0)
	name
	(format '#f "~A-~A" name (1+ n)))))

(define (generate-method-signature inst method-var keep-method-context?)
  (let* ((class-context (instance-context inst))
	 (signature (method-var-method-signature method-var))
	 (type (substitute-class-tyvars (signature-type signature) inst))
	 (renaming (instance-method-renaming inst method-var type))
	 (sig
	  (make signature
		;; ScopedTypeVariables: the instance's type variables scope over
		;; the method's body (only those kept by name, expand-instance-
		;; decls-1), and an instance signature's forall's
		(foralls (append
			  (if (or (module-extension? "ScopedTypeVariables")
				  (instance-scoped-tyvars? inst))
			      (instance-tyvars inst)
			      '())
			  (map (function tuple-2-2) renaming)))
		(context (if keep-method-context?
			     (append class-context
				     (lisp:remove-if (lambda (c) (class-tyvar-context? c inst))
						     (signature-context signature)))
			     class-context))
		(type type)
		(mcontext (if keep-method-context?
			      (append (instance-mcontext inst)
				      ;; ConstrainedClassMethods: a method's
				      ;; constraint on a class's variable (Ord
				      ;; item) at the instance's type (Ord Int)
				      (map (lambda (c)
					     (**mp-context (context-class c)
							   (list (substitute-class-tyvars
								  (**tyvar (context-tyvar c)) inst))))
					   (lisp:remove-if-not
					    (lambda (c) (class-tyvar-context? c inst))
					    (signature-context signature)))
				      ;; (the method's own constraints at the
				      ;; instance's types: ListLike's unlines ::
				      ;; ListLike full s => .. at s = FMList Char)
				      (map (lambda (c)
					     (copy-mp-context-keep
					      c
					      (**mp-context (mp-context-class c)
							    (map (lambda (ty) (substitute-class-tyvars ty inst))
								 (mp-context-types c)))))
					   (signature-mcontext signature)))
			      (instance-mcontext inst))))))
    (dolist (r renaming)
      (setf sig (rename-signature-tyvar sig (tuple-2-1 r) (tuple-2-2 r))))
    sig))

(define (class-tyvar-context? c inst)
  (let ((class (instance-class inst)))
    (and (mp-class? class)
	 (memq (context-tyvar c) (class-tyvars class))
	 '#t)))

(define (rename-signature-tyvar sig old new)
  (make signature
	(foralls (signature-foralls sig))
	(context (map (lambda (c)
			(if (eq? (context-tyvar c) old)
			    (**context (context-class c) new)
			    c))
		      (signature-context sig)))
	(type (substitute-tyvar (signature-type sig) old (**tyvar new)))
	(mcontext (map (lambda (c)
			 (copy-mp-context-keep
			  c
			  (**mp-context (mp-context-class c)
					(map (lambda (ty)
					       (substitute-tyvar ty old (**tyvar new)))
					     (mp-context-types c)))))
		       (signature-mcontext sig)))))

(define (copy-mp-context-keep from to)
  (setf (mp-context-keep? to) (mp-context-keep? from))
  to)

(define (make-instance-type inst)
  (if (instance-catch-all? inst)
      (if (null? (cdr (instance-tyvars inst)))
	  (**tyvar (car (instance-tyvars inst)))
	  (apply-ast-type (**tyvar (car (instance-tyvars inst)))
			  (list (**tyvar (cadr (instance-tyvars inst))))))
      (make-instance-type-1 inst)))

(define (make-instance-type-1 inst)
  (**tycon/def (instance-algdata inst)
	       (if (null? (instance-head-args inst))
		   (map (function **tyvar) (instance-tyvars inst))
		   (instance-head-args inst))))

(define (generate-dictionary-signature inst)
  (let ((sig (**signature (sort-inst-context-by-tyvar
			   (instance-context inst) (instance-tyvars inst))
			  (if (null? (instance-mp-types inst))
			      (generate-dictionary-type inst (make-instance-type inst))
			      (generate-mp-dictionary-type inst)))))
    (setf (signature-mcontext sig) (instance-mcontext inst))
    (when (instance-has-ambiguous-method? inst)
      (setf (signature-foralls sig) (instance-tyvars inst)))
    sig))

;;; The tuple of a multi-parameter instance's method types.  A class
;;; without methods (mtl's MonadRWS) has [(t1, ..., tn)], the instance's
;;; types, so that the instance's context is on type variables of the
;;; dictionary's type; its value is [].
(define (generate-mp-dictionary-type inst)
  (if (null? (class-method-vars (instance-class inst)))
      (**tycon/def (core-symbol "List")
		   (list (**tuple-type/l (instance-mp-types inst))))
      (generate-mp-dictionary-type-1 inst)))

(define (generate-mp-dictionary-type-1 inst)
  (**tuple-type/l
   (map (lambda (method-var)
	  (substitute-class-tyvars
	   (signature-type (method-var-method-signature method-var)) inst))
	(class-method-vars (instance-class inst)))))

(define (sort-inst-context-by-tyvar ctxt tyvars)
  (concat (map (lambda (tyvar)
		 (extract-single-context tyvar ctxt)) tyvars)))

(define (extract-single-context tyvar ctxt)
  (if (null? ctxt)
      '()
      (let ((rest (extract-single-context tyvar (cdr ctxt))))
	(if (eq? tyvar (context-tyvar (car ctxt)))
	    (cons (car ctxt) rest)
	    rest))))

(define (generate-dictionary-type inst simple)
  (if (empty-dictionary-class? (instance-class inst))
      ;; [T a ..] rather than (), so that the instance's context is on
      ;; type variables of the dictionary's type (instance Unbox a =>
      ;; Unbox (Complex a), Unbox's superclasses all multi-parameter);
      ;; its value is []
      (**tycon/def (core-symbol "List") (list simple))
      (generate-dictionary-type-1 inst simple)))

;;; A class whose dictionary has nothing: no methods, no superclasses
;;; (multi-parameter ones are passed apart).
(define (empty-dictionary-class? class)
  (and (null? (class-method-vars class))
       (null? (class-super* class))))

(define (generate-dictionary-type-1 inst simple)
  (let* ((class (instance-class inst))
	 (algdata (instance-algdata inst))
	 (tyvar (class-tyvar class)))
    (**tuple-type/l (append (map (lambda (method-var)
				   ;; This ignores the context associated
				   ;; with a method
				   (let ((sig (method-var-method-signature
					        method-var)))
				     (substitute-tyvar (signature-type sig)
						       tyvar
						       simple)))
				 (class-method-vars class))
			    (map (lambda (super-class)
				   (let ((super (and algdata
						     (lookup-instance algdata super-class))))
				     (cond ((not algdata)
					    ;; a catch-all instance's
					    (class-dictionary-type super-class simple))
					   ((eq? super '#f)
					    (signal-missing-superclass-instance
					     super-class algdata class))
					   (else
					    (generate-dictionary-type super simple)))))
				 (class-super* class))))))

(define (signal-missing-superclass-instance super algdata class)
  (phase-error 'missing-superclass-instance
    "There is no instance ~A(~A), which the instance ~A(~A) needs~%~
     (~A is a superclass of ~A)."
    super algdata class algdata super class))

;;; GHC's Num has no Eq or Show superclass (base 4.5); ours, shared with
;;; Haskell 98, does.  In a module that sees base's Prelude
;;; (modern-module?), an instance Num T whose T has no Eq or Show gets one
;;; whose methods are errors, so that GHC's programs compile; using it is
;;; a run-time error where GHC gives a type error.

(define (add-num-superclass-stubs)
  (when (modern-module?)
    (dolist (inst (module-instance-defs *module*))
      (when (and (instance-ok? inst)
		 (null? (instance-mp-types inst))
		 (eq? (instance-class inst) (core-symbol "Num")))
	(dolist (super (list (core-symbol "Eq") (core-symbol "Show")))
	  (when (eq? (lookup-instance (instance-algdata inst) super) '#f)
	    (let ((stub (new-instance super (instance-algdata inst)
				      (instance-tyvars inst))))
	      (setf (instance-context stub) (instance-context inst))
	      (setf (instance-mcontext stub) '())
	      (setf (instance-decls stub)
		    (list (num-superclass-stub-method
			   (if (eq? super (core-symbol "Eq")) '|==| '|showsPrec|)
			   super (instance-algdata inst))))
	      (setf (instance-ok? stub) '#t)
	      (push stub (module-instance-defs *module*)))))))))

;;; The same when T's Eq or Show instance needs more than the Num instance
;;; gives (bifunctors' Num (Biap bi a b), whose derived Eq needs
;;; Eq (bi a b)): the superclass slot is an error.
(define (num-stub-superclass? inst super)
  (and (modern-module?)
       (eq? (instance-class inst) (core-symbol "Num"))
       (memq super (list (core-symbol "Eq") (core-symbol "Show")))
       (let ((super-inst (lookup-instance (instance-algdata inst) super)))
	 (and super-inst
	      (not (null? (instance-mcontext super-inst)))
	      (null? (instance-mcontext inst))))))

(define (num-superclass-stub-method name class algdata)
  (**define name '(_ _)
	    (**app (**var/def (core-symbol "error"))
		   (**string (format '#f "No instance for ~A ~A (only Num ~A, which GHC's Num allows)"
				     (def-name class) (def-name algdata)
				     (def-name algdata))))))

;;; Checks performed here:
;;;  Instance context must include the following:
;;;     Context associated with data type
;;;     Context associated with instances for each super class
;;;  All super class instances must exist

(define (check-inst-type inst)
  ;; (a data family's instance: its data instances have no context, and
  ;; its superclasses' instances may be at each of them)
  (when (not (or (instance-catch-all? inst)
		 (data-family-def? (instance-algdata inst))))
    (check-inst-type-1 inst)))

(define (check-inst-type-1 inst)
   (let* ((class (instance-class inst))
	  (algdata (instance-algdata inst))
	  (inst-context (instance-gcontext inst))
	  (alg-context (gtype-context (algdata-signature algdata))))
     (when (not (full-context-implies? inst-context alg-context))
       (signal-instance-context-needs-alg-context algdata))
     (dolist (super-c (class-super class))
       (let ((super-inst (lookup-instance algdata super-c)))
	 (cond ((num-stub-superclass? inst super-c))
	       ((eq? super-inst '#f)
		(signal-no-super-class-instance class algdata super-c))
	       (else
		(when (not (full-context-implies?
			     inst-context (instance-context super-inst)))
		  (signal-instance-context-insufficient-for-super
		    class algdata super-c))))))
     ))

(define (signal-instance-context-needs-alg-context algdata)
  (phase-error 'instance-context-needs-alg-context
    "The instance context needs to include context defined for data type ~A."
    algdata))

(define (signal-no-super-class-instance class algdata super-c)
  (fatal-error 'no-super-class-instance
    "The instance ~A(~A) requires that the instance ~A(~A) be provided."
    class algdata super-c algdata))

(define (signal-instance-context-insufficient-for-super class algdata super-c)
  (phase-error 'instance-context-insufficient-for-super
    "Instance ~A(~A) does not imply super class ~A instance context."
    class algdata super-c))

;;; The type variable names of a class's methods' signatures other than
;;; the class's own (which substitute-class-tyvars replaces), which
;;; instance tyvars must not reuse.
(define (class-method-tyvar-names class)
  (let ((names '()))
    (dolist (m (class-method-vars class))
      (let ((sig (method-var-method-signature m)))
	(dolist (n (ast-type-tyvars (signature-type sig)))
	  (push n names))
	(dolist (c (signature-context sig))
	  (push (context-tyvar c) names))))
    ;; the class's variables are substituted away; a method's own are not
    (lisp:set-difference names (if (null? (class-tyvars class))
				   (list (class-tyvar class))
				   (class-tyvars class)))))
