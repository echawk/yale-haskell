;;; functor.mumble -- derived Functor, Foldable and Traversable instances
;;; (GHC's DeriveFunctor, DeriveFoldable, DeriveTraversable)
;;;
;;; For data T b1 ... bk a, the instance is for T b1 ... bk, over the
;;; last type variable a.  Each field of type t is mapped by how t
;;; mentions a:
;;;   not at all             fmap: x            foldr: acc     traverse: pure x
;;;   a                      f x                f x acc        f x
;;;   F ... u  (a not in ...)  fmap g x         foldr g acc x  traverse g x
;;; where g does the same for u (F a type constructor, or a type variable
;;; bi, which then needs Functor bi etc. in the instance's context).
;;; Functor also maps functions, b -> u, as \y -> g (x (h y)): g maps u,
;;; and h maps b the other way (a in b must be in a function's argument
;;; again: Bar's (a -> b) -> t in profunctors); and a polytype's body,
;;; forall f. C f => u (Bazaar), whose own variables take their classes
;;; from its context.  Any other use of a (a function's argument, a in
;;; two arguments) is not derivable.
;;; Foldable and Traversable are PreludeModern's classes.

(define (constructor-class-derivable? class)
  (or (eq? class (core-symbol "Functor"))
      (and (prelude-modern-def '|Foldable|)
	   (or (eq? class (prelude-modern-def '|Foldable|))
	       (eq? class (prelude-modern-def '|Traversable|))))))

;;; The instance, with the context it needs (find-derivable-instances).

(define (add-constructor-class-instance insts alg class)
  (let ((tyvars (algdata-tyvars alg)))
    (cond ((null? tyvars)
	   (phase-error 'cannot-derive-instance
	     "Instance ~A(~A) cannot be derived: ~A has no type parameter."
	     class alg alg)
	   insts)
	  ((lookup-instance alg class)
	   (signal-instance-exists alg class)
	   insts)
	  (else
	   (let* ((a     (car (lisp:last tyvars)))
		  (inst  (new-instance class alg (lisp:butlast tyvars)))
		  (vars  '()))
	     (dolist (con (algdata-constrs alg))
	       (dolist (ty (con-types con))
		 (setf vars (functor-context-tyvars ty a vars))))
	     ;; a variable gets the class, an application of one (bi a, in a
	     ;; field bi a b) a flexible context: Functor (bi a)
	     (setf (instance-context inst)
		   (map (lambda (v) (**context (**class/def class) v))
			(lisp:remove-if-not (function symbol?) vars)))
	     (setf (instance-mcontext inst)
		   (map (lambda (ty) (**mp-context (**class/def class) (list ty)))
			(lisp:remove-if (function symbol?) vars)))
	     (setf (instance-decls inst) '())
	     (setf (instance-ok? inst) '#t)
	     (setf (instance-suppress-readers? inst) '#f)
	     (cons inst insts))))))

;;; What needs the class: a type variable applied (in the last position)
;;; to something that mentions a (its name), or such a variable applied to
;;; more arguments, without the last (bi a in bi a b: an AST type).

(define (functor-context-tyvars ty a vars)
  (let ((ty  (functor-expand ty)))
    (cond ((tyapp? ty)
	   (let* ((fun   (tyapp-fun ty))
		  (args  (tyapp-args ty))
		  (need  (and (tyvar? fun)
			      (mentions-tyvar? (car (lisp:last args)) a)
			      (if (null? (cdr args))
				  (tyvar-name fun)
				  (apply-ast-type fun (lisp:butlast args))))))
	     (functor-context-tyvars
	      (car (lisp:last args)) a
	      (if (and need
		       (not (lisp:some (lambda (v)
					 (if (symbol? need)
					     (eq? v need)
					     (and (not (symbol? v)) (ast-types-equal? v need))))
				       vars)))
		  (cons need vars)
		  vars))))
	  ((arrow-ast-type? ty)
	   (functor-context-tyvars (car (tycon-args ty)) a
	     (functor-context-tyvars (cadr (tycon-args ty)) a vars)))
	  ((and (tycon? ty) (is-tuple-tycon? (tycon-def ty)))
	   ;; (each component of a tuple: tuple-field-case)
	   (let ((vs vars))
	     (dolist (u (tycon-args ty)) (setf vs (functor-context-tyvars u a vs)))
	     vs))
	  ((and (tycon? ty) (not (null? (tycon-args ty))))
	   (functor-context-tyvars (car (lisp:last (tycon-args ty))) a vars))
	  ((forall-type? ty)
	   ;; what needs the class in the body, but not the polytype's own
	   ;; variables: its context has them
	   (let ((own (forall-type-tyvars ty)))
	     (append (lisp:remove-if
		      (lambda (v)
			(if (symbol? v)
			    (memq v own)
			    (mentions-any-tyvar? v own)))
		      (functor-context-tyvars (forall-type-type ty) a '()))
		     vars)))
	  (else vars))))

(define (mentions-any-tyvar? ty names)
  (lisp:some (lambda (n) (mentions-tyvar? ty n)) names))

(define (functor-expand ty)
  ;; (not a type family's application, which has no body: megaparsec's
  ;; Token s in a field of Result)
  (if (and (tycon? ty) (synonym? (tycon-def ty))
	   (not (synonym-family? (tycon-def ty)))
	   (synonym-body (tycon-def ty)))
      (functor-expand (expand-synonym ty))
      ty))

(define (mentions-tyvar? ty a)
  (let ((ty  (functor-expand ty)))
    (cond ((tyvar? ty) (eq? (tyvar-name ty) a))
	  ((tycon? ty) (lisp:some (lambda (u) (mentions-tyvar? u a)) (tycon-args ty)))
	  ((tyapp? ty) (or (mentions-tyvar? (tyapp-fun ty) a)
			   (lisp:some (lambda (u) (mentions-tyvar? u a))
				      (tyapp-args ty))))
	  ((forall-type? ty) (and (not (memq a (forall-type-tyvars ty)))
				  (mentions-tyvar? (forall-type-type ty) a)))
	  (else '#f))))

(define (arrow-ast-type? ty)
  (and (tycon? ty) (eq? (tycon-def ty) (core-symbol "Arrow"))))

;;; For a type F t1 ... tn: its last argument, if only it mentions a.

(define (functor-last-arg ty a class)
  (let* ((ty    (functor-expand ty))
	 (args  (cond ((tyapp? ty) (tyapp-args ty))
		      ((tycon? ty) (tycon-args ty))
		      (else '()))))
    (when (or (null? args)
	      (lisp:some (lambda (u) (mentions-tyvar? u a)) (lisp:butlast args))
	      (and (tycon? ty) (eq? (tycon-def ty) (core-symbol "Arrow"))))
      (phase-error 'cannot-derive-instance
	"Instance ~A cannot be derived: a field's type, ~A (in ~A), uses the last~%~
         type variable other than as the last argument of a type."
	class ty *module-name*))
    (car (lisp:last args))))

(define *functor-var-count* 0)

(define (functor-temp root)
  (string->symbol (format '#f "~A~A" root (incf *functor-var-count*))))

(define (functor-method name)
  (if (eq? name '|fmap|)
      (core-symbol "fmap")
      (prelude-modern-def name)))

;;; fmap f (C x1 ... xn) = C e1 ... en

(define (functor-fns alg)
  (let ((a  (car (lisp:last (algdata-tyvars alg)))))
    (list
     (**define '|fmap| '(|f%| |x%|)
       (**case/con alg (**var '|x%|)
	 (lambda (con vars)
	   (**app/l (**con/def con)
		    (map (lambda (v ty) (fmap-field ty a (**var '|f%|) (**var v)))
			 vars (con-types con)))))))))

;;; A tuple field (a, ListT m a, ..): each component mapped (as GHC's
;;; DeriveFunctor does), by case on the tuple.
(define (tuple-field? ty)
  (let ((ty (functor-expand ty)))
    (and (tycon? ty) (is-tuple-tycon? (tycon-def ty)))))

(define (tuple-field-case ty x fn)
  (let* ((args (tycon-args (functor-expand ty)))
	 (vars (map (lambda (a) a (functor-temp "t%")) args)))
    (**case x
	    (list (**alt/simple (**pat (cons (tuple-constructor (length args)) vars))
				(funcall fn args vars))))))

(define (fmap-field ty a f x)
  (cond ((not (mentions-tyvar? ty a)) x)
	((tyvar? (functor-expand ty)) (**app f x))
	((tuple-field? ty)
	 (tuple-field-case ty x
	   (lambda (args vars)
	     (**app/l (**con/def (tuple-constructor (length args)))
		      (map (lambda (ty1 v) (fmap-field ty1 a f (**var v))) args vars)))))
	((forall-type? (functor-expand ty))
	 (fmap-field (forall-type-type (functor-expand ty)) a f x))
	((arrow-ast-type? (functor-expand ty))
	 (map-arrow-field ty a f x (function fmap-field) (function cofmap-field)))
	(else
	 (**app (**var/def (functor-method '|fmap|))
		(fmap-fn (functor-last-arg ty a (core-symbol "Functor")) a f)
		x))))

;;; b -> u: \y -> (MAP-RESULT u) (x ((MAP-ARG b) y))

(define (map-arrow-field ty a f x map-result map-arg)
  (let ((args  (tycon-args (functor-expand ty)))
	(y     (functor-temp "y%")))
    (**lambda (list y)
      (funcall map-result (cadr args) a f
	       (**app x (funcall map-arg (car args) a f (**var y)))))))

;;; The contravariant map, for a function's argument: from TY with a's
;;; image for a, to TY.

(define (cofmap-field ty a f x)
  (cond ((not (mentions-tyvar? ty a)) x)
	((arrow-ast-type? (functor-expand ty))
	 (map-arrow-field ty a f x (function cofmap-field) (function fmap-field)))
	(else
	 (phase-error 'cannot-derive-instance
	   "Instance Functor cannot be derived: a field's type uses the last type~%~
            variable in a function's argument.")
	 x)))

(define (fmap-fn ty a f)
  (if (tyvar? (functor-expand ty))
      f
      (let ((y  (functor-temp "y%")))
	(**lambda (list y) (fmap-field ty a f (**var y))))))

;;; foldr f z (C x1 ... xn) = g1 (g2 ... (gn z))

(define (foldable-fns alg)
  (let ((a  (car (lisp:last (algdata-tyvars alg)))))
    (list
     (**define '|foldr| '(|f%| |z%| |x%|)
       (**case/con alg (**var '|x%|)
	 (lambda (con vars)
	   (let ((acc  (**var '|z%|)))
	     (dolist (v+ty (reverse (map (function cons) vars (con-types con))))
	       (setf acc (foldr-field (cdr v+ty) a (**var '|f%|)
				      (**var (car v+ty)) acc)))
	     acc)))))))

(define (foldr-field ty a f x acc)
  (cond ((not (mentions-tyvar? ty a)) acc)
	((tyvar? (functor-expand ty)) (**app f x acc))
	((tuple-field? ty)
	 (tuple-field-case ty x
	   (lambda (args vars)
	     (let ((r acc))
	       (dolist (tv (reverse (map (function cons) args vars)))
		 (setf r (foldr-field (car tv) a f (**var (cdr tv)) r)))
	       r))))
	(else
	 (**app (**var/def (functor-method '|foldr|))
		(foldr-fn (functor-last-arg ty a (prelude-modern-def '|Foldable|))
			  a f)
		acc x))))

(define (foldr-fn ty a f)
  (if (tyvar? (functor-expand ty))
      f
      (let ((y    (functor-temp "y%"))
	    (acc  (functor-temp "acc%")))
	(**lambda (list y acc) (foldr-field ty a f (**var y) (**var acc))))))

;;; traverse f (C x1 ... xn) = pure C <*> h1 <*> ... <*> hn

(define (traversable-fns alg)
  (let ((a  (car (lisp:last (algdata-tyvars alg)))))
    (list
     (**define '|traverse| '(|f%| |x%|)
       (**case/con alg (**var '|x%|)
	 (lambda (con vars)
	   (let ((exp  (**app (**var/def (functor-method '|pure|)) (**con/def con))))
	     (dolist (v+ty (map (function cons) vars (con-types con)))
	       (setf exp (**app (**var/def (functor-method '|<*>|))
				exp
				(traverse-field (cdr v+ty) a (**var '|f%|)
						(**var (car v+ty))))))
	     exp)))))))

(define (traverse-field ty a f x)
  (cond ((not (mentions-tyvar? ty a))
	 (**app (**var/def (functor-method '|pure|)) x))
	((tyvar? (functor-expand ty)) (**app f x))
	((tuple-field? ty)
	 (tuple-field-case ty x
	   (lambda (args vars)
	     (let ((exp (**app (**var/def (functor-method '|pure|))
			       (**con/def (tuple-constructor (length args))))))
	       (dolist (tv (map (function cons) args vars))
		 (setf exp (**app (**var/def (functor-method '|<*>|))
				  exp
				  (traverse-field (car tv) a f (**var (cdr tv))))))
	       exp))))
	(else
	 (**app (**var/def (functor-method '|traverse|))
		(traverse-fn (functor-last-arg ty a
					       (prelude-modern-def '|Traversable|))
			     a f)
		x))))

(define (traverse-fn ty a f)
  (if (tyvar? (functor-expand ty))
      f
      (let ((y  (functor-temp "y%")))
	(**lambda (list y) (traverse-field ty a f (**var y))))))
