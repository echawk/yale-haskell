
;;; Basic DI structure:
;;;  a. Create the set of instances
;;;  b. Expand the context of each potential instance.
;;;  c. Once b. reaches a fixpoint, fill in the ast for the generated instances

(define *di-context-changed* '#f)

(define (add-derived-instances modules)
  (let ((insts '())
	(owners '()))   ; (inst . the module deriving it)
    (walk-modules modules
     (lambda ()
       (let ((new (find-derivable-instances)))
	 (dolist (i new) (push (cons i *module*) owners))
	 (setf insts (append new insts)))))
    (compute-di-fixpoint insts)
    (dolist (inst insts)
      (when (instance-ok? inst)
	;; its context's multi-parameter superclasses, as a declared
	;; instance's (tdecl/instance.mumble): Subst a gives DeBruijn
	;; (SubstArg a) (Agda's deriving instance (Subst a, Ord a) => Ord
	;; (Tele a))
	(setf (instance-mcontext inst)
	      (with-mp-mp-superclasses
	       (append-new-mp-contexts
		(instance-mcontext inst)
		(one-parameter-mp-superclasses (instance-context inst)))))
        (create-instance-fns inst)
	(let ((m (cdr (assq inst owners))))
	  (push inst (module-instance-defs m)))))))

(define (compute-di-fixpoint insts)
  (setf *di-context-changed* '#f)
  (dolist (inst insts)
    (propagate-di-context inst))
  (when *di-context-changed* (compute-di-fixpoint insts)))

;;; Create instance decls for all derived instances in a module.  Filter
;;; out underivable instances (Ix & Enum only)

(define (find-derivable-instances)
  (let ((algs (module-alg-defs *module*))
	(insts '()))
    (dolist (alg algs)
      (dolist (class (algdata-deriving alg))
	(setf insts (derive-instance alg class insts)))
      (dolist (d (algdata-special-derivings alg))
	(add-special-derived-instance alg (tuple-2-1 d) (tuple-2-2 d))))
    ;; StandaloneDeriving of a type declared in another module
    (dolist (d (reverse (module-standalone-derivings *module*)))
      (remember-context (tuple-2-1 d)
	(let* ((class-ref (tuple-2-1 d))
	       (via?      (and (pair? (tuple-2-2 d)) (eq? (car (tuple-2-2 d)) '%via)))
	       (stand?    (and (pair? (tuple-2-2 d)) (eq? (car (tuple-2-2 d)) '%stand)))
	       (stand-args (if stand? (caddr (tuple-2-2 d)) '()))
	       (stand-ctx (if stand? (cadddr (tuple-2-2 d)) '()))
	       (stand-mp (if (and stand? (> (length (tuple-2-2 d)) 4))
			     (list-ref (tuple-2-2 d) 4)
			     '()))
	       (target    (if (or via? stand?) (cadr (tuple-2-2 d)) (tuple-2-2 d)))
	       (alg       (synonym-algdata
			   (if (algdata? target)
			       target
			       (lookup-toplevel-name target)))))
	  (resolve-class class-ref)
	  (cond (via?
		 ;; deriving via T instance C (A a ..): T with the head's
		 ;; variables A's own (by position)
		 (let* ((via   (caddr (tuple-2-2 d)))
			(args  (list-ref (tuple-2-2 d) 3))
			(pairs (lisp:remove-if-not (lambda (p) (tyvar? (car p)))
						   (map (function cons) args
							(list-head (algdata-tyvars alg)
								   (min (length args)
									(length (algdata-tyvars alg))))))))
		   (resolve-type-1 via '() '#t)
		   (dynamic-let ((*standalone-context*
				  (let ((ctx (and (> (length (tuple-2-2 d)) 4)
						  (list-ref (tuple-2-2 d) 4))))
				    (and (pair? ctx)
					 (map (lambda (c)
						(let ((p (lisp:find (context-tyvar c) pairs
								    :key (lambda (p) (tyvar-name (car p))))))
						  (**context (context-class c)
							     (if p (cdr p) (context-tyvar c)))))
					      ctx)))))
		     (add-special-derived-instance
		      alg (class-ref-class class-ref)
		      (substitute-tyvars-simultaneously
		       via (map (lambda (p) (tyvar-name (car p))) pairs)
		       (map (lambda (p) (**tyvar (cdr p))) pairs))))))
		;; every type constructor is Typeable already (a data
		;; family too: deriving instance Typeable Vector)
		((typeable-class? (class-ref-class class-ref)))
		((not (algdata? alg))
		 (signal-not-derivable (tuple-2-2 d)))
		((synonym-head-args target stand-args)
		 ;; deriving instance C S, S = T Term: the instance at T Term,
		 ;; as GHC's (Agda's Ord Level, Level = Level' Term, whose
		 ;; PlusLevel's Ord is for PlusLevel' Term only)
		 (let ((before insts)
		       (modules-before (module-instance-defs *module*)))
		   (dynamic-let ((*standalone-head-args* (synonym-head-args target stand-args)))
		     (setf insts (derive-instance alg (class-ref-class class-ref) insts)))
		   ;; (a derived class not among the standard ones goes
		   ;; straight to the module: pandoc-types' deriving instance
		   ;; Semigroup Blocks, Blocks = Many Block, beside its
		   ;; instance Semigroup Inlines)
		   (when (and (eq? insts before)
			      (not (eq? (module-instance-defs *module*) modules-before)))
		     (let ((inst (car (module-instance-defs *module*)))
			   (args (synonym-head-args target stand-args)))
		       (dolist (c stand-ctx)
			 (resolve-class (context-class c)))
		       (setf (instance-head-args inst) args)
		       (setf (instance-tyvars inst)
			     (lisp:remove-duplicates (lisp:mapcan (function ast-tyvar-names) args)))
		       (setf (instance-context inst) stand-ctx)))
		   (when (and (not (eq? insts before)) (pair? insts))
		     (let ((inst (car insts))
			   (args (synonym-head-args target stand-args)))
		       (dolist (c stand-ctx)
			 (resolve-class (context-class c)))
		       (setf (instance-head-args inst) args)
		       (setf (instance-tyvars inst)
			     (lisp:remove-duplicates (lisp:mapcan (function ast-tyvar-names) args)))
		       (setf (instance-context inst) stand-ctx)))))
		((and stand? (or (pair? stand-ctx) (pair? stand-mp))
		      (standalone-newtype-deriving? alg (class-ref-class class-ref) stand-args))
		 ;; GeneralizedNewtypeDeriving with the declared context and
		 ;; head: deriving instance (Monad m, Null (m Doc)) => Null
		 ;; (AbsToConT m Doc), Agda's
		 (add-standalone-newtype-instance alg class-ref stand-args stand-ctx stand-mp))
		(else
		 (let ((before insts))
		   (setf insts (derive-instance alg (class-ref-class class-ref) insts))
		   ;; (a context on types that are not variables: inference
		   ;; cannot give it)
		   (when (and stand? (pair? stand-mp)
			      (not (eq? insts before)) (pair? insts))
		     (use-declared-context (car insts) stand-ctx stand-mp stand-args))))))))
    insts))

;;; deriving instance (Show (Token s), Show e) => Show (ParseError s e)
;;; (megaparsec's): the declared context is the instance's, as GHC takes
;;; it, not one inferred from the fields (Token s, a family application,
;;; has no instances to look in).
(define (use-declared-context inst ctx mctx args)
  (dolist (c ctx)
    (resolve-class (context-class c)))
  (dolist (c mctx)
    (resolve-class (mp-context-class c))
    (dolist (ty (mp-context-types c))
      (resolve-type-1 ty '() '#t)))
  ;; in the instance's variables, the data type's (deriving instance
  ;; (Functor (f a), ...) => Functor (Sum f g a), data Sum p q a b,
  ;; bifunctors'): the head's variables, position by position, through
  ;; fresh names so that a swap (Sum q p) comes out right
  (let ((fresh '()) (back '()))
    (dolist2 (a args) (tv (list-head (instance-tyvars inst)
				     (min (length args) (length (instance-tyvars inst)))))
      (when (tyvar? a)
	(let ((g (gentyvar "dc")))
	  (push (tuple (tyvar-name a) g) fresh)
	  (push (tuple g tv) back))))
    (setf ctx (map (lambda (c)
		     (let* ((r1 (assq (context-tyvar c) fresh))
			    (r2 (and r1 (assq (tuple-2-2 r1) back))))
		       (if r2 (**context (context-class c) (tuple-2-2 r2)) c)))
		   ctx))
    (setf mctx (map (lambda (c)
		      (**mp-context (mp-context-class c)
				    (map (lambda (ty)
					   (rename-ast-tyvars (rename-ast-tyvars ty fresh) back))
					 (mp-context-types c))))
		    mctx)))
  (setf (instance-context inst) ctx)
  (setf (instance-mcontext inst) mctx)
  (setf (instance-declared-context? inst) '#t))

;;; Whether a standalone deriving of CLASS for the newtype ALG at ARGS is
;;; through its field type (as derive-instance would choose, at the end of
;;; its cases).
(define (standalone-newtype-deriving? alg class args)
  (and (haskell98?)
       (algdata-newtype? alg)
       (eqv? (length args) (length (algdata-tyvars alg)))
       (eqv? (class-tyvar-arity class 4) 0)
       (or (module-extension? "GeneralizedNewtypeDeriving")
	   (module-extension? "GeneralisedNewtypeDeriving"))
       (not (module-extension? "DeriveAnyClass"))
       (not (memq class (list (core-symbol "Eq") (core-symbol "Ord")
			      (core-symbol "Text") (core-symbol "Show")
			      (core-symbol "Read") (core-symbol "Binary")
			      (core-symbol "Ix") (core-symbol "Enum")
			      (core-symbol "Bounded") *printer-class*)))
       (not (typeable-class? class))
       (not (constructor-class-derivable? class))
       (not (generic-class? class))
       (not (lift-class? class))
       (not (data-class? class))
       (not (memq (def-name class) '(|NFData|)))))

;;; The instance as if written: each method the field type's, coerced, at
;;; the declared head ARGS, with the declared context.
(define (add-standalone-newtype-instance alg class-ref args ctx mctx)
  (let ((inst (instance->def (make instance-decl (context ctx) (class class-ref)
				   (simple (**tycon/def alg args)) (decls '())
				   (mcontext mctx)))))
    (when inst
      (let* ((field (car (con-types (car (algdata-constrs alg)))))
	     (via (substitute-tyvars-simultaneously field (algdata-tyvars alg) args)))
	(setf (instance-decls inst)
	      (via-method-decls (class-ref-class class-ref) via (**tycon/def alg args)))
	(setf (instance-scoped-tyvars? inst) '#t)
	(push inst (module-instance-defs *module*))))))

;;; For a synonym S a1 .. ak = T t1 .. tn applied to ARGS (S u1 .. um, m
;;; >= k), with a ti not a type variable: T's arguments, t1 .. tn with the
;;; ai the ui, then the further ui; else #f.
(define (synonym-head-args target args)
  (let ((def (if (symbol? target) (lookup-toplevel-name target) target)))
    (and (synonym? def) (not (synonym-family? def))
	 (tycon? (synonym-body def))
	 (>= (length args) (length (synonym-args def)))
	 (let* ((params (synonym-args def))
		(body-args (map (lambda (a)
				  (let ((ty a))
				    (dolist2 (p params) (u (list-head args (length params)))
				      (setf ty (substitute-tyvar ty p u)))
				    ty))
				(tycon-args (synonym-body def))))
		(all (append body-args (list-tail args (length params)))))
	   (and (lisp:some (lambda (a) (not (tyvar? a))) all)
		all)))))

;;; deriving instance C S, S a synonym for T t1 .. tn (Agda's Show
;;; TypedBinding, TypedBinding' Expr): T's instance, its context inferred
;;; (more general than GHC's, at the arguments).
(define (synonym-algdata def)
  (if (and (synonym? def) (not (synonym-family? def))
	   (tycon? (synonym-body def))
	   (algdata? (tycon-def (synonym-body def))))
      (tycon-def (synonym-body def))
      def))

;;; The derived instance of CLASS for ALG, added to INSTS (the standard
;;; classes, whose instances are computed together) or to the module.

(define (derive-instance alg class insts)
	 (cond ((memq class (list (core-symbol "Eq")
				  (core-symbol "Ord")
				  (core-symbol "Text")
				  (core-symbol "Show")
				  (core-symbol "Read")
				  (core-symbol "Binary")))
		(setf insts (add-derivable-instance insts alg class '#f)))
	       ((eq? class *printer-class*)
		(setf insts (add-derivable-instance
			     insts alg
			     (if (feature? 'show-read)
				 (core-symbol "Show")
				 (core-symbol "Text"))
			     '#t)))
	       ;; GeneralizedNewtypeDeriving: Enum of a newtype comes through
	       ;; its field type, as GHC derives it (bifunctors' Biap); stock
	       ;; Bounded and Ix of a one-constructor type agree with it.
	       ;; So do Functor, Foldable and Traversable, whose stock
	       ;; deriving would need the field type's context (newtype AppT
	       ;; m a = AppT (StateT S m a): Functor m)
	       ((and (or (eq? class (core-symbol "Enum"))
			 (constructor-class-derivable? class))
		     (haskell98?)
		     (algdata-newtype? alg)
		     (or (module-extension? "GeneralizedNewtypeDeriving")
			 (module-extension? "GeneralisedNewtypeDeriving"))
		     ;; (a constructor class through the field type only when
		     ;; that is T .. a: newtype Pointwise a = Pointwise a,
		     ;; Agda's, derives Functor as data does)
		     (or (eq? class (core-symbol "Enum"))
			 (newtype-field-eta-reducible? alg)))
		(if (eq? class (core-symbol "Enum"))
		    (add-newtype-derived-instance alg class)
		    ;; (a dictionary of its own, its methods coerced: shared
		    ;; with the field type's, Foldable (Strict.Vector) would
		    ;; have V.Vector's type, vector's Data.Vector.Strict)
		    (add-special-derived-instance alg class 'newtype)))
	       ((eq? class (core-symbol "Ix"))
		(if (or (algdata-enum? alg)
			(algdata-tuple? alg))
		    (setf insts (add-derivable-instance insts alg class '#f))
		    (signal-cant-derive-ix alg)))
	       ((eq? class (core-symbol "Enum"))
		(if (algdata-enum? alg)
		    (setf insts (add-derivable-instance insts alg class '#f))
		    (signal-cant-derive-enum alg)))
	       ((and (haskell98?) (eq? class (core-symbol "Bounded")))
		(if (or (algdata-enum? alg)
			(algdata-tuple? alg))
		    (setf insts (add-derivable-instance insts alg class '#f))
		    (signal-cant-derive-bounded alg)))
	       ;; every type is Typeable already (util/instance-manager.mumble)
	       ((typeable-class? class))
	       ((constructor-class-derivable? class)
		(setf insts (add-constructor-class-instance insts alg class)))
	       ;; Generic, Generic1 (generic.mumble)
	       ((generic-class? class)
		(setf insts (add-generic-instance insts alg class)))
	       ;; Lift (lift.mumble)
	       ((lift-class? class)
		(setf insts (add-derivable-instance insts alg class '#f)))
	       ;; Data (data.mumble), when every field has an instance
	       ((and (data-class? class) (data-derivable? alg class))
		(setf insts (add-derivable-instance insts alg class '#f)))
	       ;; DeriveAnyClass (GHC): an empty instance, as GHC prefers
	       ;; it to newtype deriving when both are on.  NFData,
	       ;; Typeable and Lift too (GHC.Generics has only the class).
	       ((or (module-extension? "DeriveAnyClass")
		    (memq (def-name class) '(|Generic| |Generic1| |NFData| |Data|
					     |Typeable| |Lift|)))
		(add-special-derived-instance alg class 'anyclass))
	       ((and (haskell98?) (algdata-newtype? alg))
		(add-newtype-derived-instance alg class))
	       (else
		(signal-not-derivable class)))
  insts)

;;; DerivingStrategies (GHC), parser/typedecl-parser.mumble:
;;;  - anyclass: an empty instance (DeriveAnyClass), its methods the
;;;    class defaults;
;;;  - via T (DerivingVia): each method is T's, coerced:
;;;      m = primUnsafeCoerce (m :: sig[class tyvar := T])
;;;    since a newtype and its field are the same at run time;
;;;  - newtype: via the newtype's field type.
;;; The instance context is the class on each of the type's parameters
;;; that the via type mentions (GHC infers it).

;;; A standalone deriving's declared context (find-derivable-instances).
(define *standalone-context* '#f)

;;; A standalone deriving's head arguments, when it is at a synonym for an
;;; application (deriving instance C S, S = T t): the instance is at that
;;; head, so another instance of C for T at another head is no conflict.
(define *standalone-head-args* '())

(define (add-special-derived-instance alg class strategy)
  (if (and (lookup-instance alg class)
	   (null? (dynamic *standalone-head-args*)))
      (signal-instance-exists alg class)
      (let* (;; a class of type constructors takes T's parameters but the
	     ;; last n, n the arguments its variable is applied to in its
	     ;; methods: Generic1 (T a) for T a b, Bifunctor (Biap bi) for
	     ;; Biap bi a b
	     (n     (min (class-tyvar-arity class 4) (length (algdata-tyvars alg))))
	     (n     (if (and (eqv? n 0) (eq? (def-name class) '|Generic1|)
			     (not (null? (algdata-tyvars alg))))
			1
			n))
	     (tyvars (lisp:butlast (algdata-tyvars alg) n))
	     (dropped (lisp:last (algdata-tyvars alg) n))
	     (inst  (new-instance class alg tyvars))
	     (via   (cond ((eq? strategy 'anyclass) '#f)
			  ((eq? strategy 'newtype)
			   (drop-trailing-type-args
			    (car (con-types (car (algdata-constrs alg)))) dropped))
			  (else (drop-trailing-type-args strategy dropped)))))
	(setf (instance-ok? inst) '#t)
	(setf (instance-suppress-readers? inst) '#f)
	(cond ((dynamic *standalone-context*)
	       ;; a standalone deriving's own context
	       (dolist (c (dynamic *standalone-context*))
		 (resolve-class (context-class c)))
	       (setf (instance-context inst) (dynamic *standalone-context*)))
	      ((and via (tyapp? via) (tyvar? (tyapp-fun via)))
	       ;; a via type headed by a variable (bi a): C (bi a), a
	       ;; flexible context, as GHC infers it
	       (setf (instance-context inst) '())
	       (setf (instance-mcontext inst)
		     (list (**mp-context (**class/def class) (list via)))))
	      ((and via (via-instance-context via class (algdata-tyvars alg)))
	       (setf (instance-context inst)
		     (car (via-instance-context via class (algdata-tyvars alg)))))
	      (else
	       (setf (instance-context inst)
		     (if via
			 (map (lambda (v) (**context (**class/def class) v))
			      (lisp:intersection (algdata-tyvars alg) (ast-type-tyvars via)))
			 '()))))
	(setf (instance-decls inst)
	      (if via
		  (via-method-decls class via
		    (**tycon/def alg (map (function **tyvar) tyvars)))
		  '()))
	(setf (instance-scoped-tyvars? inst) '#t)
	(push inst (module-instance-defs *module*)))))

;;; The context a via type's own instance needs, at the via type's
;;; arguments, as GHC infers it: newtype AppT m a = AppT (StateT S m a)
;;; deriving Applicative has StateT's (Functor m, Monad m); through an
;;; argument that is itself T t1 .. tn, that one's instance's (ReaderT r
;;; (STT s m): STT's Functor m).  A context at another type is taken to
;;; hold.  A list of it, or '#f when the via type is not T t1 .. tn with
;;; an instance from another module having only a simple context.

(define (via-instance-context via class tyvars)
  (let ((ctx (via-instance-context-1 via class tyvars '() 0)))
    (and (not (eq? ctx 'fail)) (list ctx))))

(define (via-instance-context-1 via class tyvars ctx depth)
  (let* ((type (and (tycon? via) (< depth 8) (newtype-underlying-type via)))
	 (under (and type (lookup-instance (tycon-def type) class))))
    (if (not (and under
		  (instance-ok? under)
		  (null? (instance-head-args under))
		  (null? (instance-mcontext under))
		  (or (not (eq? (def-module (tycon-def type)) *module-name*))
		      (explicit-module-instance? under))
		  (= (length (instance-tyvars under)) (length (tycon-args type)))))
	'fail
	(begin
	  (dolist (c (instance-context under))
	    (let ((arg (find-corresponding-tyvar
			(context-tyvar c) (instance-tyvars under)
			(tycon-args type)))
		  (cl (class-ref-class (context-class c))))
	      (cond ((eq? ctx 'fail))
		    ((tyvar? arg)
		     (when (memq (tyvar-name arg) tyvars)
		       (setf ctx (augment-context ctx cl (tyvar-name arg)))))
		    ((and (tycon? arg)
			  (lisp:intersection tyvars (ast-type-tyvars arg)))
		     (setf ctx (via-instance-context-1 arg cl tyvars ctx
						       (1+ depth)))))))
	  ctx))))

;;; Whether INST is an instance declaration of this module: made before
;;; the derived ones (tdecl/type-declaration-analysis.mumble), its
;;; context known (Agda's PartialOrd (CallMatrixAug cinfo), for CMSet's
;;; Monoid through Favorites (CallMatrixAug cinfo)).
(define (explicit-module-instance? inst)
  (and (memq inst (module-instance-defs *module*))
       (not (instance-scoped-tyvars? inst))
       (eq? (instance-newtype-of inst) '#f)))

;;; How many arguments the class's type variable takes in its methods'
;;; signatures (Bifunctor's p in p a c: 2), or its superclasses'; 0 for a
;;; class of types.
(define (class-tyvar-arity class depth)
  (let ((v  (class-tyvar class))
	(n  0))
    (dolist (m (class-method-vars class))
      (setf n (max n (ast-tyvar-application-arity
		      (signature-type (method-var-method-signature m)) v))))
    (when (and (eqv? n 0) (> depth 0))
      (dolist (sc (class-super class))
	(setf n (max n (class-tyvar-arity sc (1- depth))))))
    n))

(define (ast-tyvar-application-arity type v)
  (cond ((tyapp? type)
	 (max (if (and (tyvar? (tyapp-fun type)) (eq? (tyvar-name (tyapp-fun type)) v))
		  (length (tyapp-args type))
		  (ast-tyvar-application-arity (tyapp-fun type) v))
	      (lisp:reduce (function max)
			   (map (lambda (a) (ast-tyvar-application-arity a v))
				(tyapp-args type))
			   :initial-value 0)))
	((tycon? type)
	 (lisp:reduce (function max)
		      (map (lambda (a) (ast-tyvar-application-arity a v)) (tycon-args type))
		      :initial-value 0))
	(else 0)))

;;; TYPE without its last arguments when they are the type variables
;;; Whether a newtype's field type is F t1 .. a, a its last variable not
;;; otherwise in it.
(define (newtype-field-eta-reducible? alg)
  (let ((tyvars (algdata-tyvars alg))
	(cons (algdata-constrs alg)))
    (and (not (null? tyvars))
	 (not (null? cons))
	 (not (null? (con-types (car cons))))
	 (let* ((a (car (lisp:last tyvars)))
		(ty (car (con-types (car cons))))
		(dropped (drop-trailing-type-args ty (list a))))
	   (and (not (eq? dropped ty))
		(not (mentions-tyvar? dropped a)))))))

;;; DROPPED (bi a b without a b is bi), else TYPE.
(define (drop-trailing-type-args type dropped)
  (let ((n  (length dropped)))
    (cond ((eqv? n 0) type)
	  ((and (tyapp? type)
		(>= (length (tyapp-args type)) n)
		(every (lambda (a v) (and (tyvar? a) (eq? (tyvar-name a) v)))
		       (lisp:last (tyapp-args type) n) dropped))
	   (let ((rest (lisp:butlast (tyapp-args type) n)))
	     (if (null? rest) (tyapp-fun type) (apply-ast-type (tyapp-fun type) rest))))
	  ((and (tycon? type)
		(>= (length (tycon-args type)) n)
		(every (lambda (a v) (and (tyvar? a) (eq? (tyvar-name a) v)))
		       (lisp:last (tycon-args type) n) dropped))
	   (make tycon (name (tycon-name type)) (def (tycon-def type))
		 (args (lisp:butlast (tycon-args type) n))))
	  (else type))))

;;; The via type's variables are the instance head's, which scope over the
;;; methods (instance-scoped-tyvars?): deriving Describe (Wrap a) via
;;; Maybe a needs Describe (Maybe a) at the instance's a.

;;; Each method is the via type's, coerced to the instance's type: the
;;; coercion's annotation names both, the method's own type variables
;;; shared (bifoldMap :: Monoid m => (a -> m) -> (b -> m) -> p a b -> m at
;;; p := bi, coerced to p := Biap bi), so that a method with its own
;;; context is not ambiguous; as GHC's coerce @via @instance.

(define (via-method-decls class via inst-type)
  (map (lambda (m)
	 (let* ((sig   (method-var-method-signature m))
		(ctyv  (class-tyvar class))
		;; the method's own type variables, renamed apart from the
		;; via type's
		(own   (lisp:remove ctyv (ast-type-tyvars (signature-type sig))))
		(ren   (map (lambda (v) (tuple v (gentyvar "m"))) own))
		(renamed (rename-ast-tyvars (signature-type sig) ren))
		(at-via  (substitute-tyvar renamed ctyv via))
		(at-inst (substitute-tyvar renamed ctyv inst-type)))
	   (**define (def-name m) '()
	     (**app (make exp-sign
			  (exp (**var/def (prelude-prim-def '|primUnsafeCoerce|)))
			  (signature (**signature '() (**arrow-type at-via at-inst))))
		    (**var/def m)))))
       (class-method-vars class)))

(define (ast-type-tyvars type)
  (cond ((tyvar? type) (list (tyvar-name type)))
	((tyapp? type)
	 (lisp:remove-duplicates
	  (append (ast-type-tyvars (tyapp-fun type))
		  (lisp:mapcan (function ast-type-tyvars) (tyapp-args type)))))
	((tycon? type)
	 (lisp:remove-duplicates
	  (lisp:mapcan (function ast-type-tyvars) (tycon-args type))))
	(else '())))

(define (prelude-prim-def name)
  (let ((m  (table-entry *modules* '|PreludePrims|)))
    (and m (table-entry (module-symbol-table m) name))))

;;; GeneralizedNewtypeDeriving (GHC): newtype N ... = N t deriving (C)
;;; for any other class C.  When t's instance of C has no context and is
;;; from another module, the instance shares that one's dictionary
;;; (tdecl/instance.mumble's expand-newtype-derived-instance); otherwise
;;; it is derived as deriving newtype is, its methods t's coerced.

(define (add-newtype-derived-instance alg class)
  (let* ((field  (car (con-types (car (algdata-constrs alg)))))
	 (type   (newtype-underlying-type field))
	 (under  (and type (lookup-instance (tycon-def type) class))))
    (cond ((and (lookup-instance alg class)
		(null? (dynamic *standalone-head-args*)))
	   (signal-instance-exists alg class))
	  ((or (not under)
	       (not (null? (instance-context under)))
	       (not (null? (instance-head-args under)))
	       ;; a class of type constructors (MonadTrans, its variable
	       ;; applied to two arguments): the instance is at the newtype
	       ;; less as many parameters, which add-special-derived-instance
	       ;; works out (Agda's BlockT m a, MonadTrans BlockT)
	       (> (class-tyvar-arity class 4) 0)
	       (eq? (def-module (tycon-def type)) *module-name*)
	       ;; the class (so the field type's instance, perhaps) is this
	       ;; module's, not compiled yet
	       (eq? (def-module class) *module-name*))
	   ;; otherwise each method is the field type's, coerced
	   (add-special-derived-instance alg class 'newtype))
	  (else
	   (let ((inst (new-instance class alg (algdata-tyvars alg))))
	     (setf (instance-ok? inst) '#t)
	     (setf (instance-newtype-of inst) under)
	     (push inst (module-instance-defs *module*)))))))

(define (newtype-underlying-type type)
  (cond ((and (tycon? type) (synonym? (tycon-def type)))
	 (newtype-underlying-type (expand-synonym type)))
	((and (tycon? type) (algdata? (tycon-def type))) type)
	(else '#f)))

(define (signal-cant-derive-bounded alg)
  (phase-error 'cant-derive-Bounded
    "A Bounded instance for ~A cannot be derived.  It is neither an~%~
     enumeration nor a single-constructor datatype."
    alg))


(define (signal-cant-derive-ix alg)
  (phase-error 'cant-derive-IX
    "An Ix instance for ~A cannot be derived.  It is not an enumeration~%~
     or single-constructor datatype."
    alg))

(define (signal-cant-derive-enum alg)
  (phase-error 'cant-derive-Enum
    "An Enum instance for ~A cannot be derived.  It is not an enumeration."
    alg))

(define (signal-not-derivable class)
  (recoverable-error 'not-derivable
    "Class ~A is not one of the classes that permits derived instances."
    class))


;; This adds a provisional instance template.  Of course, there may already
;;; be an instance (error!)

(define (add-derivable-instance insts alg cls sp)
  (let ((existing-inst (lookup-instance alg cls)))
    (cond ((or (eq? existing-inst '#f)
	       (not (null? (dynamic *standalone-head-args*))))
	   (let ((inst (new-instance cls alg (algdata-tyvars alg))))
	     (setf (instance-context inst) (algdata-context alg))
	     (setf (instance-decls inst) '())
	     (setf (instance-ok? inst) '#t)
	     (setf (instance-suppress-readers? inst) sp)
	     (cons inst insts)))
	  (else
	   (signal-instance-exists alg cls)
	   insts))))

(define (signal-instance-exists alg cls)
  (recoverable-error 'instance-exists
    "An instance for type ~A in class ~A already exists;~%~
     the deriving clause is being ignored."
    alg cls))

;;; This updates all instance contexts for an algdata.  Each derivable
;;; instance generates a recursive context for every field.  If a
;;; component cannot satisfy the desired context, the ok? field is set to
;;; #f to mark the instance as bogus.

(define (propagate-di-context inst)
  ;; (a derived Functor, Foldable or Traversable has its context already)
  (when (and (instance-ok? inst)
	     (not (constructor-class-derivable? (instance-class inst)))
	     (not (generic-class? (instance-class inst)))
	     ;; (one at a flexible head has its standalone context, as one
	     ;; with a declared context)
	     (null? (instance-head-args inst))
	     (not (instance-declared-context? inst)))
    (propagate-constructor-contexts inst
			   (algdata-constrs (instance-algdata inst)))))

;;; These two functions propagate the context to ever field of every
;;; constructor

(define (propagate-constructor-contexts inst constrs)
  (or (null? constrs)
      (and (propagate-contexts inst (instance-class inst)
			       (con-types (car constrs)))
	   (propagate-constructor-contexts inst (cdr constrs)))))

(define (propagate-contexts inst class types)
  (or (null? types)
      (and (propagate-type-context inst class (car types))
	   (propagate-contexts inst class (cdr types)))))

;;; This propagates a context out to a given type.  The type can only contain
;;; the tyvars which are args to the algdata.

(define (propagate-type-context inst class type)
  (cond ((tyvar? type)
	 (cond ((single-ast-context-implies?
		   (instance-context inst) class (tyvar-name type))
		'#t)
	       (else
		(setf *di-context-changed* '#t)
		(setf (instance-context inst)
		      (augment-context (instance-context inst) class
				       (tyvar-name type)))
		'#t)))
	((and (tyapp? type) (haskell98?))
	 ;; a context on an application of a type variable (newtype Biap
	 ;; bi a b = Biap (bi a b) deriving Eq: Eq (bi a b)), as GHC infers
	 ;; it: a flexible context of the instance
	 (when (not (lisp:some
		     (lambda (mc)
		       (and (eq? (class-ref-class (mp-context-class mc)) class)
			    (ast-types-equal? (car (mp-context-types mc)) type)))
		     (instance-mcontext inst)))
	   (setf *di-context-changed* '#t)
	   (setf (instance-mcontext inst)
		 (append (instance-mcontext inst)
			 (list (**mp-context (**class/def class) (list type))))))
	 '#t)
	((tyapp? type)
	 ;; Needs a context on an application of a type variable.
	 (signal-cannot-derive-instance
	   (instance-class inst) (instance-algdata inst))
	 (setf (instance-ok? inst) '#f)
	 (setf *di-context-changed* '#t)
	 '#f)
	((synonym? (tycon-def type))
	 (propagate-type-context inst class (expand-synonym type)))
	(else
	 (let* ((algdata (tycon-def type))  ; must be a algdata
	        (args (tycon-args type))
		(new-inst (lookup-instance algdata class)))
	   (cond ((or (eq? new-inst '#f)
		      (not (instance-ok? new-inst)))
		  (signal-cannot-derive-instance
		    (instance-class inst) (instance-algdata inst))
		  (setf (instance-ok? inst) '#f)
		  (setf *di-context-changed* '#t)
		  '#f)
		 (else
		  (propagate-instance-contexts inst 
				      (instance-context new-inst)
				      (instance-tyvars new-inst)
				      args)))))))


(define (single-ast-context-implies? ast-context class tyvar)
  (cond ((null? ast-context)
	 '#f)
	((eq? tyvar (context-tyvar (car ast-context)))
	 (let ((class1 (class-ref-class (context-class (car ast-context)))))
	   (or (eq? class1 class)
	       (memq class (class-super* class1))
	       (single-ast-context-implies? (cdr ast-context) class tyvar))))
	(else
	 (single-ast-context-implies? (cdr ast-context) class tyvar))))

;;; *** This message makes no sense to me.  What is the problem that
;;; *** makes it impossible to derive the instance?

(define (signal-cannot-derive-instance class alg)
  (phase-error 'cannot-derive-instance
    "Instance ~A(~A) cannot be derived."
    class alg))


;;; This propagates contexts into structure components.  The context
;;; changes due to the context associated with the various instance
;;; decls encountered.

;;; Here's the plan for expanding Cls(Alg t1 t2 .. tn) using
;;; instance (Cls1(vx),Cls2(vy),...) => Cls(Alg(v1 v2 .. vn))
;;;   for each Clsx in the instance context, propagate Clsx to the
;;;   ti corresponding to vx, where vx must be in the set vi.

(define (propagate-instance-contexts inst contexts tyvars args)
  (or (null? contexts)
      (and (propagate-type-context inst
	      (class-ref-class (context-class (car contexts)))
	      (find-corresponding-tyvar
	       (context-tyvar (car contexts)) tyvars args))
	   (propagate-instance-contexts inst (cdr contexts) tyvars args))))

;;; Given the t(i) and the v(i), return the t corresponding to a v.

(define (find-corresponding-tyvar tyvar tyvars args)
  (if (eq? tyvar (car tyvars))
      (car args)
      (find-corresponding-tyvar tyvar (cdr tyvars) (cdr args))))

;;; 1 level type synonym expansion

(define (expand-synonym type)
  (if (eq? (synonym-family? (tycon-def type)) 'data)
      ;; a data family's application (JHC's GMap Atom TyTy): its data
      ;; instance's type
      (let ((m '#f))
	(dolist (e (synonym-equations (tycon-def type)))
	  (when (not m)
	    (let ((alist (ast-family-match (tuple-2-1 e) (tycon-args type) '())))
	      (when alist
		(setf m (copy-synonym-body (tuple-2-2 e) (cdr alist)))))))
	(or m type))
      (expand-synonym-1 type)))

;;; A data instance's argument patterns (AST types) matched against ARGS:
;;; (#t . bindings), or #f.
(define (ast-family-match pats args acc)
  (cond ((null? pats) (cons '#t acc))
	((null? args) '#f)
	(else
	 (let ((p (car pats)) (a (car args)))
	   (cond ((tyvar? p)
		  (ast-family-match (cdr pats) (cdr args) (cons (tuple (tyvar-name p) a) acc)))
		 ((and (tycon? p) (tycon? a) (eq? (tycon-def p) (tycon-def a)))
		  (let ((inner (ast-family-match (tycon-args p) (tycon-args a) acc)))
		    (and inner (ast-family-match (cdr pats) (cdr args) (cdr inner)))))
		 (else '#f))))))

(define (expand-synonym-1 type)
  (let* ((synonym (tycon-def type))
	 (args (synonym-args synonym))
	 (body (synonym-body synonym)))
  (let ((alist (map (lambda (tyvar arg) (tuple tyvar arg))
		    args (tycon-args type))))
    (copy-synonym-body body alist))))

(define (copy-synonym-body type alist)
  (cond ((tyvar? type)
	 (tuple-2-2 (assq (tyvar-name type) alist)))
	((tyapp? type)
	 (apply-ast-type (copy-synonym-body (tyapp-fun type) alist)
			 (map (lambda (ty) (copy-synonym-body ty alist))
			      (tyapp-args type))))
	(else
	 (make tycon (def (tycon-def type))
	             (name (tycon-name type))
		     (args (map (lambda (ty)
				  (copy-synonym-body ty alist))
				(tycon-args type)))))))

;;; This fills in the body decls for an instance function.

(define (create-instance-fns inst)
  (let ((class (instance-class inst))
	(alg (instance-algdata inst)))
    (cond ((eq? class (core-symbol "Eq"))
	   (add-instance inst (eq-fns alg)))
	  ((eq? class (core-symbol "Ord"))
	   (add-instance inst (ord-fns alg)))
	  ((eq? class (core-symbol "Ix"))
	   (add-instance inst (ix-fns alg)))
	  ((eq? class (core-symbol "Enum"))
	   (add-instance inst (enum-fns alg)))
	  ((eq? class (core-symbol "Bounded"))
	   (add-instance inst (bounded-fns alg)))
	  ((eq? class (core-symbol "Text"))
	   (add-instance inst (text-fns alg (instance-suppress-readers? inst))))
	  ((eq? class (core-symbol "Show"))
	   (add-instance inst (text-fns alg '#t)))
	  ((eq? class (core-symbol "Read"))
	   (add-instance inst (list (cadr (text-fns alg '#f)))))
	  ((eq? class (core-symbol "Binary"))
	   (add-instance inst (binary-fns alg)))
	  ((eq? class (core-symbol "Functor"))
	   (add-instance inst (functor-fns alg)))
	  ((eq? class (prelude-modern-def '|Foldable|))
	   (add-instance inst (foldable-fns alg)))
	  ((eq? class (prelude-modern-def '|Traversable|))
	   (add-instance inst (traversable-fns alg)))
	  ((data-class? class)
	   (add-instance inst (data-fns alg inst)))
	  ((lift-class? class)
	   (add-instance inst (lift-fns alg)))
	  ((generic-class? class)
	   (add-instance inst (generic-fns alg (eq? (def-name class) '|Generic1|)))))))

(define (add-instance inst decls)
  (setf (instance-decls inst) decls))

;;; Add class(var) to a context, removing any contexts made redundant by
;;; the new addition.  Example: adding Ord a to (Eq a, Eq b) would yield
;;; (Ord a,Eq b).

(define (augment-context contexts cl var)
  (cons (**context (**class/def cl) var)
	(remove-implied-contexts cl var contexts)))

(define (remove-implied-contexts class1 tyvar1 contexts)
  (if (null? contexts)
      '#f
      (with-slots context (class tyvar) (car contexts)
	(let ((rest (remove-implied-contexts class1 tyvar1 (cdr contexts)))
	      (class2 (class-ref-class class)))
	  (if (and (eq? tyvar1 tyvar)
		   (memq class2 (class-super* class1)))
	      rest
	      (cons (car contexts) rest))))))
