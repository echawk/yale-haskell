
;;; This generates code for vars defined in an interface.  This looks at
;;; annotations and fills in the slots of the var definition.

(define (haskell-codegen/interface mods)
  (codegen/interface (car mods)))

(define (codegen/interface mod)
 (let ((code '()))
  (dolist (d (module-decls mod))
    (when (not (signdecl? d))
      (error 'bad-decl))
    (dolist (var (signdecl-vars d))
     (let ((v (var-ref-var var)))
      (setf (var-type v) (var-signature v))
      (setf (var-toplevel? v) '#t)
      (let ((a (lookup-annotation v '|Complexity|)))
	(when (not (eq? a '#f))
	  (setf (var-complexity v)
		(car (annotation-value-args a)))))
      (let ((a (lookup-annotation v '|LispName|)))
	(when (not (eq? a '#f))
	   (let ((lisp-entry (generate-lisp-entry v a)))
	     (push lisp-entry code)
	     (when (memq 'codegen (dynamic *printers*))
  	        (pprint* lisp-entry))))))))
  `(begin ,@code)))

(define (generate-lisp-entry v a)
  (let ((lisp-name (read-lisp-object (car (annotation-value-args a))))
	(type (maybe-expand-io-type (gtype-type (var-type v)))))
    (setf (var-optimized-entry v) lisp-name)
    (if (arrow-type? type)
	(codegen-lisp-fn v (gather-arg-types type))
	(codegen-lisp-const v type))))

(define (codegen-lisp-fn var arg-types)
  (let* ((aux-definition '())
	 (wrapper? (foreign-fn-needs-wrapper? var arg-types))
	 (strictness-annotation (lookup-annotation var '|Strictness|))
	 (strictness (determine-strictness strictness-annotation arg-types))
	 (temps (gen-temp-names strictness)))
    (setf (var-strict? var) '#t)
    (setf (var-arity var) (length strictness))
    (setf (var-strictness var) strictness)
    (when wrapper?
	  (mlet (((code name)
		  (make-wrapper-fn var (var-optimized-entry var) arg-types)))
	      (setf (var-optimized-entry var) name)
	      (setf aux-definition (list code))))
    `(begin ,@aux-definition
	    (define ,(fullname var)
		    ,(maybe-make-box-value
		       (codegen-curried-fn
			(if wrapper?
			    `(function ,(var-optimized-entry var))
			    `(lambda ,temps
			          (,(var-optimized-entry var) ,@temps)))
			 (var-strictness var))
		       '#t)))))

(define (determine-strictness a args)
  (if (eq? a '#f)
      (map (lambda (x) (declare (ignore x)) '#t) (cdr args))
      (parse-strictness (car (annotation-value-args a)))))

(define (codegen-lisp-const var type)
  (let ((conversion-fn (output-conversion-fn type)))
    (setf (var-strict? var) '#f)
    (setf (var-arity var) 0)
    (setf (var-strictness var) '())
    `(define ,(fullname var)
             (delay
	       ,(apply-conversion conversion-fn (var-optimized-entry var))))))

(define (maybe-expand-io-type ty)
  (cond ((and (ntycon? ty)
	      (eq? (ntycon-tycon ty) (core-symbol "IO")))
	 (**ntycon (core-symbol "Arrow")
		   (list (**ntycon (core-symbol "SystemState") '())
			 (**ntycon (core-symbol "IOResult")
				   (ntycon-args ty)))))
	((arrow-type? ty)
	 (**ntycon (core-symbol "Arrow")
		   (list (car (ntycon-args ty))
			 (maybe-expand-io-type (cadr (ntycon-args ty))))))
	(else ty)))

(define (gather-arg-types type)
  (if (arrow-type? type)
      (let ((a (ntycon-args type)))
	(cons (car a) (gather-arg-types (cadr a))))
      (list type)))
	   
(define (input-conversion-fn ty)
  (if (ntycon? ty)
      (let ((tycon (ntycon-tycon ty)))
	(cond ((eq? tycon (core-symbol "String"))
	       (lambda (x) `(haskell-string->string ,x)))
	      ((eq? tycon (core-symbol "List"))  ; needs to convert elements
	       (let ((var (gensym "X"))
		     (inner-fn (input-conversion-fn (car (ntycon-args ty)))))
		 (lambda (x) `(haskell-list->list
			       (lambda (,var)
				 ,(if (eq? inner-fn '#f)
				      var
				      (funcall inner-fn var)))
			       ,x))))
	      ((eq? tycon (core-symbol "Char"))
	       (lambda (x) `(integer->char ,x)))
	      (else '#f)))
      '#f))

(define (output-conversion-fn ty)
  (if (ntycon? ty)
      (let ((tycon (ntycon-tycon ty)))
	(cond ((eq? tycon (core-symbol "String"))
	       (lambda (x) `(make-haskell-string ,x)))
	      ((eq? tycon (core-symbol "List"))
	       (let ((var (gensym "X"))
		     (inner-fn (output-conversion-fn (car (ntycon-args ty)))))
		 (lambda (x) `(list->haskell-list
			       (lambda (,var)
				 ,(if (eq? inner-fn '#f)
				      var
				      (funcall inner-fn var)))
			       ,x))))
	      ((eq? tycon (core-symbol "UnitType"))
	       (lambda (x) `(insert-unit-value ,x)))
	      ((eq? tycon (core-symbol "IOResult"))
	       (lambda (x)
		 (let ((c1 (output-conversion-fn (car (ntycon-args ty)))))
		   `(box ,(apply-conversion c1 x)))))
	      (else '#f)))
      '#f))

(define (apply-conversion fn x)
  (if (eq? fn '#f)
      x
      (funcall fn x)))

(define (foreign-fn-needs-wrapper? var args)
 (if (lookup-annotation var '|NoConversion|)
     '#f
     (ffnw-1 args)))

(define (ffnw-1 args)
  (if (null? (cdr args))
      (not (eq? (output-conversion-fn (car args)) '#f))
      (or (not (eq? (input-conversion-fn (car args)) '#f))
	  (systemstate? (car args))
	  (ffnw-1 (cdr args)))))

(define (make-wrapper-fn var fn args)
  (mlet ((new-fn (symbol-append (fullname var) '|/wrapper|))
	 (avars (gen-temp-names (cdr args)))
	 (ignore-state? (systemstate? (cadr (reverse args))))
	 ((arg-conversions res-conversion)
	  (collect-conversion-fns avars args)))
     (values
      `(define (,new-fn ,@avars)
	 ,@(if ignore-state? `((declare (ignore ,(car (last avars)))))
	                     '())
	 ,@arg-conversions
	 ,(apply-conversion res-conversion
			    `(,fn ,@(if ignore-state?
					(butlast avars)
					avars))))
      new-fn)))

(define (collect-conversion-fns avars args)
  (if (null? avars)
      (values '() (output-conversion-fn (car args)))
      (mlet ((fn (input-conversion-fn (car args)))
	     ((c1 r) (collect-conversion-fns (cdr avars) (cdr args))))
	 (values (if (eq? fn '#f)
		     c1
		     `((setf ,(car avars) ,(funcall fn (car avars))) ,@c1))
		 r))))

(define (arrow-type? x)
  (and (ntycon? x)
       (eq? (ntycon-tycon x) (core-symbol "Arrow"))))

(define (systemstate? x)
  (and (ntycon? x)
       (eq? (ntycon-tycon x) (core-symbol "SystemState"))))

(define (gen-temp-names l)
  (gen-temp-names-1 l '(A B C D E F G H I J K L M N O P)))

(define (gen-temp-names-1 l1 l2)
  (if (null? l1)
      '()
      (if (null? l2)
	  (gen-temp-names-1 l1 (list (gensym "T")))
	  (cons (car l2) (gen-temp-names-1 (cdr l1) (cdr l2))))))



;;;=====================================================================
;;; foreign import ccall (Haskell 2010 chapter 8), over CFFI
;;;=====================================================================

;;; The Lisp code for VAR, a foreign import of ENTITY: an entry
;;; function VAR/ffi calling cffi:foreign-funcall, which becomes the var's
;;; optimized entry exactly as for a LispName primitive.  An IO result
;;; adds the state argument, which is ignored.  The argument and result
;;; types must be marshallable (ffi-marshalling); arguments arrive
;;; evaluated, since the entry is strict in all of them.

(define (codegen-foreign-import var entity)
  (lisp:catch 'ffi-error
    (codegen-foreign-import-1 var entity)))

(define (codegen-foreign-import-1 var entity)
  (let* ((gtype   (var-signature var))
	 (types   (gather-arg-types (ffi-expand (gtype-type gtype))))
	 (args    (butlast types))
	 (res     (car (last types)))
	 (io?     (and (ntycon? res) (eq? (ntycon-tycon res) (core-symbol "IO"))))
	 (rtype   (if io? (ffi-expand (car (ntycon-args res))) res))
	 (spec    (ffi-parse-entity entity (symbol->string (def-name var)))))
    (when (not (null? (gtype-context gtype)))
      (ffi-error var "its type has a class context"))
    (let ((arg-ms  (map (lambda (ty) (ffi-marshalling var ty '#f)) args))
	  (res-m   (ffi-marshalling var rtype '#t))
	  (params  (map (lambda (ty) (declare (ignore ty)) (gensym "A")) args))
	  (state   (gensym "S")))
      (cond ((eq? (car spec) 'address)
	     (when (or io? (not (null? args)) (not (eq? (car res-m) ':pointer)))
	       (ffi-error var "an & import must have type Ptr t or FunPtr t"))
	     (setf (var-optimized-entry var) '#f)
	     (setf (var-strict? var) '#f)
	     (setf (var-arity var) 0)
	     (setf (var-strictness var) '())
	     `(define ,(fullname var)
		(delay (ffi-symbol-pointer ,(cadr spec)))))
	    (else
	     (let* ((call-args  (concat (map (lambda (m p)
					       (list (car m) (ffi-apply (cadr m) p)))
					     arg-ms params)))
		    (call       (if (eq? (car spec) 'dynamic)
				    (begin
				      (when (or (null? args)
						(not (eq? (car (car arg-ms)) ':pointer)))
					(ffi-error var "a dynamic import's first argument must be a FunPtr"))
				      `(,(ffi-cffi-symbol "FOREIGN-FUNCALL-POINTER")
					,(car params) ()
					,@(cddr call-args) ,(car res-m)))
				    `(,(ffi-cffi-symbol "FOREIGN-FUNCALL")
				      ,(cadr spec) ,@call-args ,(car res-m))))
		    (body       (ffi-apply (caddr res-m) call))
		    (entry      (symbol-append (fullname var) '|/ffi|))
		    (all-params (if io? (append params (list state)) params))
		    (strictness (map (lambda (p) (declare (ignore p)) '#t) all-params)))
	       (when (eq? (car spec) 'wrapper)
		 (ffi-error var "\"wrapper\" imports (callbacks) are not supported yet"))
	       (setf (var-optimized-entry var) entry)
	       (setf (var-strict? var) '#t)
	       (setf (var-arity var) (length all-params))
	       (setf (var-strictness var) strictness)
	       (if (null? all-params)
		   ;; a pure constant: called once, when first needed
		   (begin
		     (setf (var-optimized-entry var) '#f)
		     (setf (var-strict? var) '#f)
		     `(define ,(fullname var) (delay ,body)))
		   `(begin
		      (define (,entry ,@all-params)
			,@(if io? `((declare (ignore ,state))) '())
			,body)
		      (define ,(fullname var)
			,(maybe-make-box-value
			  (codegen-curried-fn `(function ,entry) strictness)
			  '#t))))))))))

(define (ffi-cffi-symbol name)
  (let ((pkg  (lisp:find-package "CFFI")))
    (if (eq? pkg '#f)
	(fatal-error 'no-cffi "The FFI needs CFFI, which is not loaded.")
	(lisp:intern name pkg))))

(define (ffi-apply fn x)
  (if (eq? fn '#f) x (funcall fn x)))

(define (ffi-expand ty)
  (expand-ntype-synonym (prune ty)))

(define (ffi-error var what)
  (phase-error 'bad-foreign-import
    "The foreign import ~A is not supported: ~A." (def-name var) what)
  ;; after a recoverable error, no code for this declaration
  (lisp:throw 'ffi-error '(begin)))

;;; ENTITY (report 8.3.1) as (static "cname"), (address "cname"),
;;; (dynamic) or (wrapper).  A header file name and `static' are ignored;
;;; the C name defaults to the Haskell name.

(define (ffi-parse-entity entity default)
  (let ((words  (ffi-words entity)))
    (cond ((equal? words '("dynamic")) '(dynamic))
	  ((equal? words '("wrapper")) '(wrapper))
	  (else
	   (let ((ws  (lisp:remove-if (lambda (w)
					(or (string=? w "static")
					    (and (> (string-length w) 2)
						 (lisp:string= ".h" w
							       :start2 (- (string-length w) 2)))))
				      words))
		 (address?  '#f))
	     (when (and (not (null? ws)) (string=? (car ws) "&"))
	       (setf address? '#t)
	       (setf ws (cdr ws)))
	     (when (and (not (null? ws)) (lisp:char= (lisp:char (car ws) 0) #\&))
	       (setf address? '#t)
	       (setf ws (cons (lisp:subseq (car ws) 1) (cdr ws))))
	     (list (if address? 'address 'static)
		   (if (null? ws) default (car ws))))))))

(define (ffi-words s)
  (let ((start  (lisp:position #\space s :test-not (function lisp:char=))))
    (if (eq? start '#f)
	'()
	(let ((end  (or (lisp:position #\space s :start start) (string-length s))))
	  (cons (lisp:subseq s start end)
		(ffi-words (lisp:subseq s end)))))))

;;; How a value of type TY crosses to C: (cffi-type to-c from-c), where
;;; to-c and from-c are #f or functions of a form.  Int is a C long; the
;;; Data.Int and Data.Word types (and the Foreign.C.Types synonyms for
;;; them) have their own widths; Char is an int code; Bool an int.

(define (ffi-marshalling var ty result?)
  (let ((m  (ffi-marshalling-1 ty result?)))
    (if (eq? m '#f)
	(ffi-error var (format '#f "it cannot pass a ~A ~A C"
			       ty (if result? "back from" "to")))
	m)))

(define *ffi-sized-types*
  '((|Data.Int| (|Int8| :int8) (|Int16| :int16) (|Int32| :int32) (|Int64| :int64))
    (|Data.Word| (|Word8| :uint8) (|Word16| :uint16) (|Word32| :uint32)
		 (|Word64| :uint64) (|Word| :uint64))
    (|ForeignPrims| (|Ptr| :pointer) (|FunPtr| :pointer))))

(define (ffi-marshalling-1 ty result?)
  (let ((ty  (ffi-expand ty)))
    (if (not (ntycon? ty))
	'#f
	(let ((tycon  (ntycon-tycon ty)))
	  (cond ((eq? tycon (core-symbol "Int")) '(:long #f #f))
		((eq? tycon (core-symbol "Double")) '(:double #f #f))
		((eq? tycon (core-symbol "Float")) '(:float #f #f))
		((eq? tycon (core-symbol "Char")) '(:int32 #f #f))
		((eq? tycon (core-symbol "Bool"))
		 (list ':int
		       (lambda (x) `(if ,x 1 0))
		       (lambda (x) `(not (eqv? ,x 0)))))
		((and result? (eq? tycon (core-symbol "UnitType")))
		 (list ':void '#f (lambda (x) `(begin ,x 0))))
		(else
		 (let* ((mod   (assq (def-module tycon) *ffi-sized-types*))
			(entry (and mod (assq (def-name tycon) (cdr mod)))))
		   (if entry
		       (list (cadr entry) '#f '#f)
		       '#f))))))))
