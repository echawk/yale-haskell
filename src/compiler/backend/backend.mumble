(define-compilation-unit backend
  (source-filename "$Y2/src/compiler/backend/")
  (require flic)
  (unit optimize
	(source-filename "optimize.mumble"))
  (unit strictness
	(source-filename "strictness.mumble"))
  (unit box
	(source-filename "box.mumble"))
  (unit codegen
	(source-filename "codegen.mumble"))
  (unit interface-codegen
	(source-filename "interface-codegen.mumble")))

