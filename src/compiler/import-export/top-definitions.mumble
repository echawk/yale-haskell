;;; File: top-definitions.mumble

;;; Description: This creates definitions for all top level (exportable)
;;;  object in a module.

(define (create-top-definitions)
  (dolist (decl (module-decls *module*))
    (if (eq? (module-type *module*) 'interface)
	(when (signdecl? decl)
	   (create-var-definitions decl (signdecl-vars decl)))
	(when (valdef? decl)
	   (create-var-definitions
	    decl (collect-pattern-vars (valdef-lhs decl))))))
  (dolist (fi (module-foreign-imports *module*))
    (create-var-definitions fi (list (foreign-import-var fi))))
  ;; DataKinds: each constructor's promoted type, 'K (symbol-table.mumble's
  ;; promoted-tycon-def), an empty data type of the constructor's arity
  (when (not (eq? (module-type *module*) 'interface))
    (setf (module-algdatas *module*)
	  (append (module-algdatas *module*)
		  (promoted-data-decls (module-algdatas *module*)))))
  (dolist (algdata (module-algdatas *module*))
    (create-alg-definitions algdata))
  ;; DataKinds' unticked promoted K (parser/module-parser.mumble's
  ;; add-promoted-constructors) is 'K too: another module's 'K is this one
  (when (not (eq? (module-type *module*) 'interface))
    (dolist (alg (module-algdatas *module*))
      (let ((name (tycon-name (data-decl-simple alg))))
	(when (and (null? (data-decl-constrs alg)) (promoted-unticked? alg))
	  (setf (table-entry *symbol-table* (promoted-type-name name))
		(tycon-def (data-decl-simple alg)))))))
  (dolist (synonym (module-synonyms *module*))
    (create-syn-definitions synonym))
  (dolist (class (module-classes *module*))
    (create-class-definitions class)))

;;; ------------------------------------------------------------------------
;;; creation of definitions
;;; ------------------------------------------------------------------------

(define (create-var-definitions decl vars)
  (remember-context decl
    (dolist (v vars)
     (let* ((var-name (var-ref-name v))
	    (def (create-top-definition var-name 'var)))
       (setf (var-ref-var v) def)
       (push def (module-vars *module*))
       (add-new-group var-name def)))))

;;; Whether ALG, a data declaration without constructors, is the parser's
;;; promoted constructor K: the module has a constructor K.
(define (promoted-unticked? alg)
  (let ((name (add-con-prefix/symbol (tycon-name (data-decl-simple alg)))))
    (lisp:some (lambda (d)
		 (lisp:some (lambda (c) (eq? (con-ref-name (constr-constructor c)) name))
			    (data-decl-constrs d)))
	       (module-algdatas *module*))))

;;; data 'K a1 .. an, for each constructor K of n fields of DECLS (but a K
;;; the parser has promoted already: promoted-unticked?).
(define (promoted-data-decls decls)
  (lisp:mapcan
   (lambda (d)
     (map (lambda (c)
	    (let ((name (con-ref-name (constr-constructor c)))
		  (i 0))
	      (make data-decl (context '())
		    (simple (make tycon (name (promoted-type-name name))
				  (def *undefined-def*)
				  (args (map (lambda (ty) (declare (ignore ty))
					       (incf i)
					       (make tyvar (name (string->symbol
								  (format '#f "p~A" i)))))
					     (constr-types c)))))
		    (constrs '()) (deriving '()) (special-derivings '())
		    (annotations '()))))
	  (lisp:remove-if
	   (lambda (c)
	     (let ((base (remove-con-prefix/symbol (con-ref-name (constr-constructor c)))))
	       (lisp:some (lambda (d2) (and (null? (data-decl-constrs d2))
					    (eq? (tycon-name (data-decl-simple d2)) base)))
			  decls)))
	   (data-decl-constrs d))))
   decls))

;;; 'K for the constructor named K (;K).
(define (promoted-type-name con-name)
  (let ((s (symbol->string con-name)))
    (string->symbol (string-append "'" (if (has-con-prefix? s) (remove-con-prefix s) s)))))

;;; This also creates definitions for the constructors

(define (create-alg-definitions algdata)
  (remember-context algdata
    (with-slots data-decl (simple constrs) algdata
      (let* ((alg-name (tycon-name simple))
	     (def (create-top-definition alg-name 'algdata)))
	(setf (tycon-def simple) def)
	(let* ((constr-group
		(map (lambda (constr) 
		      (let* ((con-ref (constr-constructor constr))
			     (con-name (con-ref-name con-ref))
			     (con-def (create-top-definition con-name 'con)))
			 (setf (con-ref-con con-ref) con-def)
			 (tuple con-name con-def)))
		     constrs))
	       (field-group (create-field-definitions def constrs)))
	  (setf (algdata-constrs def) (map (function tuple-2-2) constr-group))
	  (setf (tycon-def-arity def) (length (tycon-args simple)))
	  (add-new-group alg-name def (append constr-group field-group)))))))

;;; Record fields: one selector var per distinct label of the datatype,
;;; shared by the constructors that have it (report 3.15.1).  Each
;;; constructor's con-field-labels lists the var of every argument.
;;; Returns the (name def) group entries of the fields.

(define (create-field-definitions alg constrs)
  (let ((fields '()))
    (dolist (constr constrs)
      (let ((labels (constr-field-labels constr)))
	(check-duplicate-field-labels labels)
	(setf (con-field-labels (con-ref-con (constr-constructor constr)))
	      (map (lambda (label)
		     (let ((old (assq label fields)))
		       (if old
			   (tuple-2-2 old)
			   (let ((var (create-top-definition label 'var)))
			     (setf (var-field-alg var) alg)
			     (push var (module-vars *module*))
			     (push (tuple label var) fields)
			     var))))
		   labels))))
    (reverse fields)))

(define (check-duplicate-field-labels labels)
  (let ((dups (find-duplicates labels)))
    (when (not (null? dups))
      (phase-error 'duplicate-field-label
	"The field ~A appears more than once in a constructor." (car dups)))))

(define (create-class-definitions class-decl)
  (remember-context class-decl
    (with-slots class-decl (class decls) class-decl
      (let* ((class-name (class-ref-name class))
	     (class-def (create-top-definition class-name 'class)))
	(setf (class-ref-class class) class-def)
	(let ((method-group
	       (concat
		(map
		 (lambda (decl) 
		  (if (and (is-type? 'signdecl decl)
			   ;; DefaultSignatures: not a new method
			   (not (signdecl-default? decl)))
		      (remember-context decl
		       (map (lambda (method-var)
			      (let* ((var-name (var-ref-name method-var))
				     (def (create-top-definition
					      var-name 'method-var)))
				(setf (method-var-class def) class-def)
				(setf (method-var-default def) '#f)
				(setf (var-ref-var method-var) def)
				(tuple var-name def)))
			    (signdecl-vars decl)))
		      '()))
		decls))))
	  (setf (class-method-vars class-def)
		(map (function tuple-2-2) method-group))
	  ;; associated families: in C(..) with the methods
	  (let ((fam-group '()))
	    (dolist (name (class-decl-families class-decl))
	      (let ((s (lisp:find name (module-synonyms *module*)
				  :key (lambda (d) (tycon-name (synonym-decl-simple d))))))
		(when s
		  (push (tuple name (tycon-def (synonym-decl-simple s))) fam-group))))
	    (setf (class-families class-def) (map (function tuple-2-2) fam-group))
	    (add-new-group class-name class-def (append method-group fam-group))))))))

(define (create-syn-definitions synonym-decl)
  (remember-context synonym-decl
    (let* ((simple (synonym-decl-simple synonym-decl))
	   (syn-name (tycon-name simple))
	   (def (create-top-definition syn-name 'synonym)))
      (setf (tycon-def simple) def)
      (setf (tycon-def-arity def) (length (tycon-args simple)))
      (add-new-group syn-name def))))

(define (add-new-group name def . others)
  (when (memq *module* (module-exported-modules *module*))
      (export-group (cons (tuple name def)
			  (if (null? others)
			      '()
			      (car others))))))



