;;; This file deals with entities in import / export lists

;;; This resolves an entity with the export table of a
;;; module.  It returns either a group, the symbol 'error, or the symbol
;;; 'not-found.  When force-error? is true, signal an error when
;;; the module is not found & return 'error.

;;; `pattern C' (pattern%C) naming a data constructor, not a synonym (GHC:
;;; import Data.List.NonEmpty (pattern (:|))): a group of the constructor.

(define (pattern-constructor-group name mod)
  (let ((s  (symbol->string name)))
    (and (string-starts? "pattern%" s)
	 (let ((con   (string->symbol
		       (add-con-prefix (substring s 8 (string-length s)))))
	       (found '#f))
	   (table-for-each
	    (lambda (key group)
	      (declare (ignore key))
	      (when (not found)
		(dolist (n-d (cdr group))
		  (when (and (eq? (tuple-2-1 n-d) con) (con? (tuple-2-2 n-d)))
		    (setf found (list n-d))))))
	    (module-export-table mod))
	   found))))

;;; A class method or record field named by itself (import M (method)):
;;; a group of just that member, from the class's or type's export group.

(define (group-member-group name mod)
  (let ((found  '#f))
    (table-for-each
     (lambda (key group)
       (declare (ignore key))
       (when (not found)
	 (dolist (n-d (cdr group))
	   (when (and (eq? (tuple-2-1 n-d) name) (var? (tuple-2-2 n-d)))
	     (setf found (list n-d))))))
     (module-export-table mod))
    found))

(define (locate-entity/export-table entity mod force-error?)
  (let* ((name (entity-name entity))
	 (group (or (table-entry (module-export-table mod) name)
		    (and (is-type? 'entity-var entity)
			 (or (group-member-group name mod)
			     (pattern-constructor-group name mod))))))
    (if (eq? group '#f)
	(if (not force-error?)
	    'not-found
	    (signal-entity-not-found name (module-name mod)))
	(let ((def (group-definition group)))
	  (cond ((is-type? 'entity-var entity)
		 group)
		((is-type? 'entity-con entity)
		 (cond ((algdata? def)
			(strip-constructors group))
		       ((synonym? def)
			;; H98 names a synonym by its bare name
			(if (haskell98?)
			    group
			    (signal-synonym-needs-dots name (module-name mod))))
		       ((and (class? def) (haskell98?))
			;; a class by its bare name: without its methods
			(list (car group)))
		       (else
			(signal-wrong-definition
			  "type constructor" name (module-name mod)))))
		((is-type? 'entity-abbreviated entity)
		 (cond ((algdata? def)
			(cond ((and (hidden-constructors? group) (haskell98?))
			       ;; T(..) of an abstract type is T alone, as in
			       ;; GHC (import GHC.Base (Int(..)))
			       (strip-constructors group))
			      ((hidden-constructors? group)
			       (if force-error?
				   (signal-abstract-type
				     name (module-name mod))
				   'not-found))
			      (else
			       group)))
		       ((or (class? def) (synonym? def))
			group)
		       (else
			(signal-wrong-definition
			  "class or datatype" name (module-name mod)))))
		((is-type? 'entity-class entity)
		 (cond ((class? def)
			(match-constituents group (entity-class-methods entity)
					    entity "method"))
		       ;; T(f, ...): record fields of a datatype
		       ((and (algdata? def) (feature? 'records))
			(match-constituents group (entity-class-methods entity)
					    entity "constructor or field"))
		       (else
			(signal-wrong-definition "class" name (module-name mod)))))
		((is-type? 'entity-datatype entity)
		 (if (algdata? def)
		     (match-constituents group
					 (entity-datatype-constructors entity)
					 entity "constructor")
		     (signal-wrong-definition
		       "data type" name (module-name mod))))
		(else
		 (error "Bad entity ~s." entity))
		)))))

;;; Haskell 1.2 requires an entity specification to name every constructor
;;; or method.  Haskell 98 allows a subset, T(C1), and the result is the
;;; group restricted to the names listed.

(define (match-constituents group names entity what)
  ;; MagicHash: Int(I#) names the boxing constructor, which is the
  ;; identity (parser/exp-parser.mumble), not a constituent
  (setf names (lisp:remove-if (lambda (n) (memq n *magic-hash-boxes*)) names))
  ;; a pattern synonym bundled with the type (Seq(Empty)): its builder
  (setf names (map (lambda (n)
		     (if (and (not (assq n (cdr group)))
			      (assq (pattern-builder-name n) (cdr group)))
			 (pattern-builder-name n)
			 n))
		   names))
  (check-duplicates names entity)
  (when (not (haskell98?))
    (dolist (n-d (cdr group))
      (when (not (memq (tuple-2-1 n-d) names))
	(signal-extra-constituent entity (tuple-2-1 n-d) what))))
  (dolist (name names)
    (when (not (assq name (cdr group)))
      (signal-missing-constituent entity name what)))
  (if (haskell98?)
      (let ((kept '()))
	(dolist (n-d (cdr group))
	  (when (memq (tuple-2-1 n-d) names)
	    (push n-d kept)))
	(cons (car group) (reverse kept)))
      group))


;;; The following routine locates an entity in the current module.
;;; It may return 'error, 'not-found, or a group.

(define (locate-entity entity)
  (let* ((qname (entity-name entity))
	 (def (resolve-toplevel-name qname))
	 ;; module A (C.choice) where import qualified B as C: exported
	 ;; under its own name, choice (Haskell 98 5.2)
	 (name (mlet (((base _) (split-qualified-name qname)))
		 (or base qname))))
    (cond ((eq? def '#f)
	   'not-found)
	  ((is-type? 'entity-var entity)
	   ;; Haskell 98 5.2: a class method may be exported by name
	   (if (and (method-var? def) (not (haskell98?)))
	       (signal-export-method-var name)
	       (make-group name def)))
	  ((is-type? 'entity-con entity)
	   (cond ((algdata? def)
		  (make-group name def))
		 ((synonym? def)
		  (if (haskell98?)
		      (make-group name def)
		      (signal-synonym-needs-dots name *module-name*)))
		 ;; Haskell 98 5.2: a class by its bare name, without its methods
		 ((and (class? def) (haskell98?))
		  (make-group name def))
		 (else
		  (signal-wrong-definition
		    "type constructor" name *module-name*))))
	  ((is-type? 'entity-abbreviated entity)
	   (cond ((and (algdata? def) (not (eq? name qname)))
		  ;; Q.T(..): the constructors and fields in scope as Q.C
		  (require-complete-algdata
		   (gather-qualified-group name def qname
		     (append (algdata-constrs def) (algdata-field-vars def)))))
		 ((algdata? def)
		  (require-complete-algdata
		   (gather-algdata-group name def)))
		 ((data-family? def)
		  (gather-data-family-group name def))
		 ((synonym? def)
		  (make-group name def))
		 ((and (class? def) (not (eq? name qname)))
		  (gather-qualified-group name def qname (class-method-vars def)))
		 ((class? def)
		  (gather-class-group name def))
		 (else
		  (signal-wrong-definition
		    "type constructor or class" name *module-name*))))
	  ((is-type? 'entity-class entity)
	   (cond ((class? def)
		  (match-group-names
		   (gather-class-group name def)
		   (entity-class-methods entity)
		   entity
		   "method"))
		 ;; T(f, ...): record fields of a datatype
		 ((and (algdata? def) (feature? 'records))
		  (match-group-names
		   (require-complete-algdata (gather-algdata-group name def))
		   (entity-class-methods entity)
		   entity "constructor or field"))
		 (else
		  (signal-wrong-definition "class" name *module-name*))))
	  ((and (is-type? 'entity-datatype entity) (data-family? def))
	   ;; F(C, ...): a data family with its instances' constructors
	   (let ((names (entity-datatype-constructors entity))
		 (group (gather-data-family-group name def)))
	     (if (memq '|..| names)
		 group
		 (match-group-names group names entity "constructor"))))
	  ((and (is-type? 'entity-class entity) (data-family? def))
	   (match-group-names (gather-data-family-group name def)
			      (entity-class-methods entity) entity
			      "constructor or field"))
	  ((is-type? 'entity-datatype entity)
	   (if (algdata? def)
	       (bundle-pattern-synonyms
		entity
		(let* ((group (gather-algdata-group name def))
		       (names (entity-datatype-constructors entity))
		       (real (lisp:remove-if-not
			      (lambda (n) (assq n (cdr group))) names)))
		  (if (memq '|..| names)
		      (require-complete-algdata group)
		      (match-group-names group real entity "constructor"))))
	       (signal-wrong-definition "data type" name *module-name*)))
	  (else
	   (error "Bad entity ~s." entity)))))

;;; TypeFamilies: a data family's group has the constructors and fields of
;;; its data instances in this module (the types F:1, F:2, ...;
;;; parser/typedecl-parser.mumble's parse-data-instance).

(define (data-family? def)
  ;; (the family flag is set after this phase: tdecl/alg-syn.mumble)
  (and (synonym? def) (not (null? (data-family-instances def)))))

(define (data-family-instances def)
  (let ((prefix (string-append (symbol->string (def-name def)) ":"))
	(res '()))
    (dolist (decl (module-algdatas *module*))
      (let ((name (tycon-name (data-decl-simple decl))))
	(when (string-starts? prefix (symbol->string name))
	  (let ((alg (or (resolve-toplevel-name (add-con-prefix/symbol name))
			 (resolve-toplevel-name name))))
	    (when (algdata? alg)
	      (push alg res))))))
    (reverse res)))

(define (gather-data-family-group name def)
  (let ((members '()))
    (dolist (alg (data-family-instances def))
      (setf members (append members (algdata-constrs alg) (algdata-field-vars alg))))
    (cons (tuple name def) (gather-group members))))

;;; PatternSynonyms: T (P, Q) or T (.., P, Q) in an export list bundles
;;; the pattern synonyms P and Q with T: their builders (pattern%P,
;;; parser/pattern-parser.mumble) join T's group, so that importing T(..)
;;; brings them (containers' Seq (Empty, (:<|), (:|>))).
(define (bundle-pattern-synonyms entity group)
  (if (eq? group 'not-found)
      group
      (let ((extra '()))
	(dolist (n (entity-datatype-constructors entity))
	  (when (and (not (eq? n '|..|)) (not (assq n (cdr group))))
	    (let* ((b (pattern-builder-name n))
		   (def (resolve-toplevel-name b)))
	      (if (var? def)
		  (push (tuple b def) extra)
		  (signal-missing-constituent entity n "constructor or pattern")))))
	(append group (reverse extra)))))

(define (require-complete-algdata group)
  (if (hidden-constructors? group)
      'not-found
      group))

;;; The group of a type or class exported by a qualified name (Q.T(..)):
;;; its members in scope by the same qualifier (Q.C), by their own names.
(define (gather-qualified-group name def qname members)
  (let* ((s (symbol->string qname))
	 (dot (lisp:position #\. s :from-end '#t))
	 (qual (substring s 0 (1+ dot)))
	 (res '()))
    (dolist (m members)
      (let* ((mname (symbol->string (def-name m)))
	     (con? (and (> (string-length mname) 0)
			(char=? (string-ref mname 0) #\;)))
	     (q (string->symbol
		 (if con?
		     (string-append ";" qual (substring mname 1 (string-length mname)))
		     (string-append qual mname)))))
	(when (eq? (table-entry *symbol-table* q) m)
	  (push (tuple (def-name m) m) res))))
    (cons (tuple name def) (reverse res))))

;;; Returns the group restricted to NAMES (Haskell 98 partial exports).

(define (match-group-names group names entity what)
  (if (eq? group 'not-found)
      group
      (match-constituents group names entity what)))


