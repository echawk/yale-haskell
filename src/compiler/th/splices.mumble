;;; splices.mumble -- running Template Haskell's expression splices
;;; (doc/plans/TEMPLATE-HASKELL.md, milestone 2)
;;;
;;; After parsing, before the other phases (top/phases.mumble's
;;; compile-haskell-files), each splice $(e) of a module (parser's
;;; record-splice, in source order) is run:
;;;
;;;  - e becomes the binding splice_expression :: Q Exp of a fragment module,
;;;    Yale_Splice_N, whose imports are copies of the module's own, so e
;;;    sees what the module imports and nothing the module defines (TH's
;;;    stage restriction: a splice may use only imported functions);
;;;  - the fragment is compiled and loaded, and its splice_text, the Exp
;;;    printed by pprint (lib/haskell98/Language/Haskell/TH/YaleSplice.hs),
;;;    is parsed as an expression: the splice's expansion, which the scope
;;;    phase puts in its place (prec/scope.mumble).  There, a global
;;;    name's qualified M.x need not have M imported.
;;;
;;; A splice inside another's expression is run first, and the outer one's
;;; fragment has its expansion.  --printers splices shows each expansion.
;;;
;;; A declaration splice, $(e), $x or an expression alone at the top level
;;; (module-parser.mumble's at-decl-splice?), runs the same way after the
;;; module's expression splices, with e :: Q [Dec]; its declarations,
;;; printed and parsed, join the module's.  So declarations before and
;;; after it see them (GHC sees them only after), and reify finds the
;;; module's types from their declarations (reify.mumble).

(define *splice-counter* 0)

;;; A type splice: the type constructor Splice%N standing in its place,
;;; and (splice . tycon) on *type-splices* (parser/type-parser.mumble).
;;; Run, it becomes the synonym Splice%N v1 .. vn = its type, over the
;;; type's variables, and the stand-in is applied to them.
(define *type-splice-counter* 0)
(define *type-splices* '())

(define *quoted-type-splices* '())   ; (name . exp): one inside a [t| |]

(define (type-splice-tycon e)
  (if (dynamic *in-quote?*)
      ;; inside a quote: the quote's code binds e's type there
      ;; (th/quote.mumble's quote-type)
      (let ((name (string->symbol (format '#f "Splice%~A" (incf *type-splice-counter*)))))
	(push (cons name e) *quoted-type-splices*)
	(make tyvar (name name)))
      (type-splice-tycon-1 e)))

(define (type-splice-tycon-1 e)
  (let* ((s (record-splice (make splice (exp e) (kind 'type))))
	 (name (string->symbol (format '#f "Splice%~A" (incf *type-splice-counter*))))
	 (tc (make tycon (name name) (def *undefined-def*) (args '()))))
    (push (cons s tc) *type-splices*)
    tc))

(define (define-type-splice s type mod)
  (let* ((entry (assq s *type-splices*))
	 (tc (cdr entry))
	 (vars (lisp:remove-duplicates (ast-tyvar-names type) :from-end '#t)))
    (setf (tycon-args tc) (map (lambda (v) (make tyvar (name v))) vars))
    (setf (module-synonyms mod)
	  (append (module-synonyms mod)
		  (list (make synonym-decl
			      (simple (make tycon (name (tycon-name tc))
					    (def *undefined-def*)
					    (args (map (lambda (v) (make tyvar (name v)))
						       vars))))
			      (body type)))))))
(define *splice-fragment* '#f)   ; the fragment running a splice (reify.mumble)

(define (expand-splices mods)
  (dolist (m mods)
    (dolist (s (module-splices m))
      (setf (splice-expansion s)
	    (parse-splice-text (run-splice s m (splice-kind s)) m (source-file-of s)
			       (source-line-of s) (splice-kind s)))
      (when (eq? (splice-kind s) 'type)
	(define-type-splice s (splice-expansion s) m)))
    ;; declaration splices: their declarations join the module's
    (dolist (s (module-decl-splices m))
      (merge-spliced-decls m (parse-spliced-decls (run-splice s m 'decs) m s)))))

;;; Runs the splice S of MOD, of KIND exp (Q Exp) or decs (Q [Dec]); its
;;; code as text.

(define (run-splice s mod kind)
  (incf *splice-counter*)
  (let* ((name (string->symbol (format '#f "Yale_Splice_~A" *splice-counter*)))
	 (file (source-file-of s))
	 (frag (splice-fragment name mod file kind))
	 (text '#f))
    (set-splice-hole frag s)
    (dynamic-let ((*printers* (if (memq 'extension (dynamic *printers*))
				  (dynamic *printers*)
				  '()))
		  (*splice-parent* mod)
		  (*splice-fragment* frag)
		  (*current-splice* s))
      (eval (modules->lisp-code (list frag)))
      ;; run it: reify asks the fragment and the module (reify.mumble)
      (let ((var (table-entry (module-symbol-table frag) '|splice_text|)))
	(setf text (haskell-string->string (force (eval (fullname var)))))
	;; then the declarations addTopDecls added: they join the module
	(let* ((tvar (table-entry (module-symbol-table frag) '|splice_top|))
	       (top (haskell-string->string (force (eval (fullname tvar))))))
	  (when (not (string=? top ""))
	    (merge-spliced-decls mod (parse-spliced-decls top mod s))))))
    (remove-module-from-symbol-table frag)
    (when (memq 'splices (dynamic *printers*))
      (format '#t "~&Splice at line ~A of ~A:~%~A~%"
	      (source-line-of s) file text))
    text))

(define (splice-fragment name mod file kind)
  (let ((frag (car (dynamic-let ((*language-extensions* (module-extensions mod)))
		     (parse-from-string
		      (format '#f "module ~A where~%~
                                   import qualified Language.Haskell.TH.Syntax~%~
                                   import qualified Language.Haskell.TH.YaleSplice~%~
                                   import qualified Language.Haskell.TH.Quote~%~
                                   splice_expression :: Language.Haskell.TH.Syntax.Q ~A~%~
                                   splice_expression = splice_expression~%~
                                   splice_text :: [Char]~%~
                                   splice_text = Language.Haskell.TH.YaleSplice.~A splice_expression~%~
                                   splice_top :: [Char]~%~
                                   splice_top = Language.Haskell.TH.YaleSplice.spliceTopDeclsText splice_text~%"
			      name
			      (case kind
				(exp "Language.Haskell.TH.Syntax.Exp")
				(pat "Language.Haskell.TH.Syntax.Pat")
				(type "Language.Haskell.TH.Syntax.Type")
				(else "[Language.Haskell.TH.Syntax.Dec]"))
			      (case kind
				(exp "spliceExpText")
				(pat "splicePatText")
				(type "spliceTypeText")
				(else "spliceDecsText")))
		      (function parse-module-list)
		      file)))))
    (setf (module-imports frag)
	  (append (module-imports frag)
		  (map (function copy-import-decl) (module-imports mod))))
    (setf (module-extensions frag) (module-extensions mod))
    (setf (module-unit frag) name)
    frag))

;;; A copy for another module: import/export fills in the copy's own
;;; module slot and resolves its entities.

(define (copy-import-decl d)
  (let ((c (lisp:copy-structure d)))
    (setf (import-decl-specs c)
	  (map (function lisp:copy-structure) (import-decl-specs d)))
    (setf (import-decl-renamings c)
	  (map (function lisp:copy-structure) (import-decl-renamings d)))
    c))

(define (set-splice-hole frag s)
  (dolist (d (module-decls frag))
    ;; errors in the fragment's bindings are the splice's
    (setf (ast-node-line-number d) (ast-node-line-number s))
    (when (and (valdef? d)
	       (var-pat? (valdef-lhs d))
	       (eq? (var-ref-name (var-pat-var (valdef-lhs d))) '|splice_expression|))
      (setf (guarded-rhs-rhs
	     (car (single-fun-def-rhs-list (car (valdef-definitions d)))))
	    (splice-exp s)))))

;;; The code is parsed at the splice's line, for its error messages.
(define (parse-splice-text text mod file line kind)
  (dynamic-let ((*language-extensions* (splice-text-extensions mod)))
    (parse-from-string (string-append
			(make-string (if (integer? line) (1- line) 0) #\newline)
			text)
		       (case kind
			 (pat (function parse-pat))
			 (type (function parse-type))
			 (else (function parse-exp)))
		       file)))

;;; A declaration splice's declarations: TEXT parsed as a module's body,
;;; at the splice's line.

(define (parse-spliced-decls text mod s)
  (let ((line (source-line-of s)))
    (car (dynamic-let ((*language-extensions* (splice-text-extensions mod)))
	   (parse-from-string
	    (string-append (make-string (if (integer? line) (1- line) 0) #\newline)
			   (format '#f "module ~A where~%~A~%" (module-name mod) text))
	    (function parse-module-list)
	    (source-file-of s))))))

(define (merge-spliced-decls mod new)
  (setf (module-decls mod) (append (module-decls mod) (module-decls new)))
  (setf (module-algdatas mod) (append (module-algdatas mod) (module-algdatas new)))
  (setf (module-synonyms mod) (append (module-synonyms mod) (module-synonyms new)))
  (setf (module-classes mod) (append (module-classes mod) (module-classes new)))
  (setf (module-instances mod) (append (module-instances mod) (module-instances new)))
  (setf (module-fixities mod) (append (module-fixities mod) (module-fixities new)))
  (setf (module-standalone-derivings mod)
	(append (module-standalone-derivings mod) (module-standalone-derivings new)))
  (setf (module-type-equations mod)
	(append (module-type-equations mod) (module-type-equations new))))

;;; A splice's printed code is read with the module's extensions and
;;; MagicHash, for the primitive literals pprint writes ("..."#, from aeson's
;;; deriveJSON's BytesPrimL).
(define (splice-text-extensions mod)
  (if (member "MagicHash" (module-extensions mod))
      (module-extensions mod)
      (cons "MagicHash" (module-extensions mod))))

(define (source-file-of ast)
  (let ((sp (ast-node-line-number ast)))
    (if (is-type? 'source-pointer sp) (source-pointer-file sp) "<splice>")))

(define (source-line-of ast)
  (let ((sp (ast-node-line-number ast)))
    (if (is-type? 'source-pointer sp) (source-pointer-line sp) "?")))
