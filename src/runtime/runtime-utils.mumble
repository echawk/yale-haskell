;;; runtime-utils.mumble -- basic runtime support
;;;
;;; author :  Sandra Loosemore
;;; date   :  9 Jun 1992
;;;
;;; This file contains definitions (beyond the normal mumble stuff)
;;; that is referenced directly in code built by the code generator.
;;; See backend/codegen.mumble.
;;;



;;; Thunks (phase P1 of doc/EVAL-APPLY-GRIN.md, section 4).
;;;
;;; A thunk is a cons whose car is one of three private markers:
;;;   (%thunk-unevaluated% . closure)   not yet evaluated
;;;   (%thunk-blackhole%   . closure)   being evaluated (re-entry is <<loop>>)
;;;   (%thunk-evaluated%   . value)     evaluated; value in WHNF, never a thunk
;;; The hot paths use CL's eq/consp directly: mumble's eq?/pair? are not
;;; inlined in the runtime.  The markers are private symbols (quoted
;;; constants, so a test is one compare), which no Haskell value can be, so
;;; a thunk is never confused with a data cons (a list cell or a pair,
;;; whose car is a field value).  This keeps a thunk at two words; a
;;; struct would take four on SBCL/arm64 and measured slower.
;;;
;;; A "boxed" object may be a thunk or an already evaluated value; an
;;; evaluated value needs no box, so BOX is the identity.  FORCE evaluates
;;; a thunk if needed and returns any other object unchanged.  On update
;;; the closure is dropped (it no longer keeps its free variables alive).


(define-syntax (make-thunk code)
  `(cons '|%thunk-unevaluated%| ,code))

;;; Any thunk, evaluated or not.
(define-syntax (thunk? x)
  (let ((temp (gensym)) (c (gensym)))
    `(let ((,temp ,x))
       (and (lisp:consp ,temp)
	    (let ((,c (car ,temp)))
	      (or (lisp:eq ,c '|%thunk-evaluated%|) (lisp:eq ,c '|%thunk-unevaluated%|)
		  (lisp:eq ,c '|%thunk-blackhole%|)))))))

;;; Blackhole bookkeeping for non-local exits (doc/EVAL-APPLY-GRIN.md
;;; section 4.2).  When *track-blackholes* is true (bound by prim.catch-io,
;;; and by apply-exec in the interactive system, for the extent of the
;;; protected action), every thunk entered is pushed on *blackhole-trail*
;;; and popped when its evaluation finishes.  After a non-local exit,
;;; restore-blackholes turns the thunks still blackholed back into
;;; unevaluated ones, so a later force re-evaluates them instead of
;;; reporting a false <<loop>>.  Outside such extents nothing is recorded.

(define *track-blackholes* '#f)
(define *blackhole-trail* '())

(define (restore-blackholes mark)
  (do ()
      ((or (lisp:eq (dynamic *blackhole-trail*) mark)
	   (lisp:null (dynamic *blackhole-trail*))))
    (let ((th (car (dynamic *blackhole-trail*))))
      (setf (dynamic *blackhole-trail*) (cdr (dynamic *blackhole-trail*)))
      (when (lisp:eq (car th) '|%thunk-blackhole%|)
	(setf (car th) '|%thunk-unevaluated%|)))))

(define-syntax (with-blackhole-restore . body)
  (let ((mark  (gensym)))
    `(let ((,mark  (dynamic *blackhole-trail*)))
       (lisp:unwind-protect
	   (dynamic-let ((*track-blackholes* '#t))
	     ,@body)
	 (restore-blackholes ,mark)))))

(define (haskell-loop-error)
  (haskell-runtime-error "<<loop>>"))

;;; TH is a thunk that is not evaluated (marked unevaluated or blackhole).

(define (force-thunk th)
  (declare (type pair th))
  (if (lisp:eq (car th) '|%thunk-blackhole%|)
      (haskell-loop-error)
      (let ((code (cdr th)))
	(setf (car th) '|%thunk-blackhole%|)
	(if (dynamic *track-blackholes*)
	    (let ((old (dynamic *blackhole-trail*)))
	      (setf (dynamic *blackhole-trail*) (cons th old))
	      (let ((result (funcall (the function code))))
		(setf (dynamic *blackhole-trail*) old)
		(setf (car th) '|%thunk-evaluated%|)
		(setf (cdr th) result)))
	    (let ((result (funcall (the function code))))
	      (setf (car th) '|%thunk-evaluated%|)
	      (setf (cdr th) result))))))


;;; (delay form)
;;;   returns a thunk that will evaluate "form".

(define-syntax (delay form)
  `(make-thunk (lambda () ,form)))


;;; (box form)
;;;   an evaluated value is its own box.

(define-syntax (box form)
  form)

;;; (unbox form)
;;;   form is known to be evaluated: a plain value or an evaluated thunk.

(define-syntax (unbox form)
  (let ((temp (gensym)))
    `(let ((,temp ,form))
       (if (and (lisp:consp ,temp) (lisp:eq (car ,temp) '|%thunk-evaluated%|))
	   (cdr ,temp)
	   ,temp))))

;;; (forced? form)
;;;   true unless form is an unevaluated (or blackholed) thunk.

(define-syntax (forced? form)
  (let ((temp (gensym)) (c (gensym)))
    `(let ((,temp ,form))
       (or (not (lisp:consp ,temp))
	   (let ((,c (car ,temp)))
	     (not (or (lisp:eq ,c '|%thunk-unevaluated%|) (lisp:eq ,c '|%thunk-blackhole%|))))))))


;;; Inline version of the above.  Not good to use everywhere because
;;; of code bloat problems, but handy for helper functions.

(define-syntax (force-inline object)
  (let ((temp (gensym)) (c (gensym)))
    `(let ((,temp ,object))
       (if (lisp:consp ,temp)
	   (let ((,c (car ,temp)))
	     (cond ((lisp:eq ,c '|%thunk-evaluated%|) (cdr ,temp))
		   ((or (lisp:eq ,c '|%thunk-unevaluated%|) (lisp:eq ,c '|%thunk-blackhole%|))
		    (force-thunk ,temp))
		   (else ,temp)))
	   ,temp))))


;;; (force object)
;;;   evaluate object if it is a thunk; otherwise return it.

(define (force object)
  (force-inline object))


;;; Function values (phase P2 of doc/EVAL-APPLY-GRIN.md, section 3).
;;;
;;; A Haskell function value is a FUN: its arity and its standard entry,
;;; a Lisp function of exactly ARITY boxed arguments that returns an
;;; unboxed (WHNF) value.  The code generator builds the entry of a
;;; function with an optimized entry point as a wrapper that forces the
;;; strict arguments and calls it.  A partial application is a FUN of
;;; the remaining arity whose entry closes over the arguments supplied so
;;; far.
;;;
;;; An unknown call goes through (apply-1 f a) ... (apply-4 f a b c d) or
;;; (apply-n f . args), where F is an evaluated function value.  When the
;;; number of arguments is the arity (the common case) the entry is called
;;; directly, with no consing; otherwise the out-of-line slow path builds
;;; a partial application or applies the result to the leftover arguments.

(lisp:defstruct (fun (:constructor make-fun (arity entry))
		     (:predicate fun?)
		     (:copier lisp:nil))
  (arity 1 :type lisp:fixnum :read-only lisp:t)
  (entry (function lisp:identity) :type lisp:function :read-only lisp:t))

#+sbcl
(lisp:declaim (sb-ext:freeze-type fun))

;;; A plain Lisp function is also accepted as a function value and
;;; called with whatever arguments it is given: some primitives (the
;;; tuple dictionary builders in tuple-prims.mumble) are variadic.

;;; The arguments are bound once: both branches use them, and pasting
;;; the argument forms into each would double the code at every level
;;; of nested calls (f (g (h ...))).

(define-syntax (define-apply name slow . args)
  `(define-syntax (,name f ,@args)
     (let ((fv     (gensym))
	   (temps  (map (lambda (a) (declare (ignore a)) (gensym))
			(list ,@args))))
       `(let* ((,fv ,f)
	       ,@(map (function list) temps (list ,@args)))
	  (if (and (fun? ,fv) (lisp:eql (fun-arity ,fv) ,,(length args)))
	      (funcall (fun-entry ,fv) ,@temps)
	      (,',slow ,fv ,@temps))))))

(define-apply apply-1 apply-1-slow a)
(define-apply apply-2 apply-2-slow a b)
(define-apply apply-3 apply-3-slow a b c)
(define-apply apply-4 apply-4-slow a b c d)

(define-syntax (apply-n f . args)
  `(apply-list ,f (list ,@args)))

;;; Under-saturated: F (arity n) applied to ARGS, fewer than n of them.
;;; The common shapes get a fixed-arity entry; the rest use &rest.

(define (make-pap f args)
  (let* ((e  (fun-entry f))
	 (k  (length args))
	 (n  (- (the fixnum (fun-arity f)) (the fixnum k))))
    (declare (type function e) (type fixnum k n))
    (make-fun
     n
     (cond ((eqv? k 1)
	    (let ((a (car args)))
	      (cond ((eqv? n 1) (lambda (b) (funcall e a b)))
		    ((eqv? n 2) (lambda (b c) (funcall e a b c)))
		    ((eqv? n 3) (lambda (b c d) (funcall e a b c d)))
		    (else (lambda more (apply e a more))))))
	   ((eqv? k 2)
	    (let ((a (car args))
		  (b (cadr args)))
	      (cond ((eqv? n 1) (lambda (c) (funcall e a b c)))
		    ((eqv? n 2) (lambda (c d) (funcall e a b c d)))
		    (else (lambda more (apply e a b more))))))
	   (else
	    (lambda more (apply e (append args more))))))))

;;; The slow paths: F is not a FUN, or ARGS is not its arity.

(define (apply-1-slow f a)
  (if (fun? f)
      (make-pap f (list a))
      (funcall (the function f) a)))

(define (apply-2-slow f a b)
  (cond ((not (fun? f)) (funcall (the function f) a b))
	((eqv? (fun-arity f) 1) (apply-1 (funcall (fun-entry f) a) b))
	(else (make-pap f (list a b)))))

(define (apply-3-slow f a b c)
  (if (fun? f)
      (let ((n  (fun-arity f)))
	(cond ((eqv? n 1) (apply-2 (funcall (fun-entry f) a) b c))
	      ((eqv? n 2) (apply-1 (funcall (fun-entry f) a b) c))
	      (else (make-pap f (list a b c)))))
      (funcall (the function f) a b c)))

(define (apply-4-slow f a b c d)
  (apply-list f (list a b c d)))

;;; ARGS is a fresh list of at least one argument.

(define (apply-list f args)
  (if (not (fun? f))
      (apply (the function f) args)
      (let ((n  (fun-arity f))
	    (k  (length args)))
	(declare (type fixnum n k))
	(cond ((eqv? n k)
	       (apply (fun-entry f) args))
	      ((< k n)
	       (make-pap f args))
	      (else
	       (let ((rest  (list-tail args n)))
		 (setf (cdr (list-tail args (1- n))) '())
		 (apply-list (apply (fun-entry f) args) rest)))))))


;;; The (:) constructor as a function value.

(define *cons-constructor* (make-fun 2 (lambda (a b) (cons a b))))


;;; (make-tuple . args)
;;;   an untagged data structure with one slot per argument

(define-syntax (make-tuple . args)
  (let ((arity  (length args)))
    (cond ((eqv? arity 0)
	   ;; Actually, should never happen -- this is the unit constructor
	   0)
	  ((eqv? arity 1)
	   (car args))
	  ((eqv? arity 2)
	   `(cons ,@args))
	  (else
	   `(vector ,@args)))))


;;; (make-tagged-data n . args)
;;;   a data structure with tag "n" and one slot per argument

(define-syntax (make-tagged-data n . args)
  `(vector ,n ,@args))


;;; (tuple-select arity i object)
;;;   extract component "i" from untagged "object"

(define-syntax (tuple-select arity i object)
  (cond ((eqv? arity 1)
	 object)
	((eqv? arity 2)
	 (if (eqv? i 0)
	     `(car ,object)
	     `(cdr ,object)))
	(else
	 `(vector-ref (the vector ,object) (the fixnum ,i)))))


;;; (tagged-data-select arity i object)
;;;   extract component "i" from tagged "object"

(define-syntax (tagged-data-select arity i object)
  (declare (ignore arity))
  `(vector-ref (the vector ,object) (the fixnum ,(1+ i))))


;;; (constructor-number object)
;;;   return the tag from "object"

(define-syntax (constructor-number object)
  `(vector-ref (the vector ,object) 0))



;;; (make-haskell-string string)
;;;   Converts a Lisp string to a haskell string, a chunk at a time
;;;   (haskell-string-from).  Returns an unboxed result.

(define (make-haskell-string string)
  (declare (type string string))
  (let ((size  (string-length string)))
    (if (eqv? size 0)
	'()
	(haskell-string-from string 0 size '()))))


;;; Similar, but accepts an arbitrary tail (which must be a delay object)

(define (make-haskell-string-tail string tail-delay)
  (declare (type string string))
  (let ((size  (string-length string)))
    (if (eqv? size 0)
	(force-inline tail-delay)
	(haskell-string-from string 0 size tail-delay))))

;;; Characters START (< SIZE) to SIZE-1 of STRING as a Haskell list ending
;;; in TAIL (boxed).  The string is all there, so it is converted eagerly
;;; a chunk at a time; only the rest of a long string is suspended, one
;;; thunk per chunk rather than per character.

(define-integrable *haskell-string-chunk* 32)

(define (haskell-string-from string start size tail)
  (declare (type string string) (type fixnum start size))
  (let* ((end   (min size (+ start *haskell-string-chunk*)))
	 (rest  (if (eqv? end size)
		    tail
		    (make-thunk
		     (lambda () (haskell-string-from string end size tail))))))
    (declare (type fixnum end))
    (do ((i  (1- end) (1- i))
	 (l  rest (cons (char->integer (string-ref string i)) l)))
	((< i start) l)
      (declare (type fixnum i)))))


(define (haskell-string->string s)
  (let ((length  0))
    (declare (type fixnum length))
    (do ((s s (force (cdr s))))
	((null? s))
	(setf length (+ length 1)))
    (let ((result  (make-string length)))
      (declare (type string result))
      (do ((s s (unbox (cdr s)))
	   (i 0 (+ i 1)))
	  ((null? s))
	  (declare (type fixnum i))
	  (setf (string-ref result i) (integer->char (force (car s)))))
      result)))


(define (print-haskell-string s port)
   (do ((s1 s (force (cdr s1))))
       ((null? s1))
     (write-char (integer->char (force (car s1))) port)))

;;; This explicates the value returned by a proc (the IO () type).

(define (insert-unit-value x)
  (declare (ignore x))
  0)

;;; These handle list conversions

(define (haskell-list->list fn l)
  (if (null? l)
      '()
      (cons (funcall fn (force (car l))) 
	    (haskell-list->list fn (force (cdr l))))))

(define (list->haskell-list fn l)
  (if (null? l)
      '()
      (cons (box (funcall fn (car l)))
	    (box (list->haskell-list fn (cdr l))))))

(define (haskell-list->list/identity l)
  (if (null? l)
      '()
      (cons (force (car l))
	    (haskell-list->list/identity (force (cdr l))))))

(define (list->haskell-list/identity l)
  (if (null? l)
      '()
      (cons (box (car l))
	    (box (list->haskell-list/identity (cdr l))))))
