;; these primitives support arbitrary sized tuples.

(define (prim.tupleSize x)
  (vector-length x))

(define (prim.tupleSel tuple i n)
 (force
  (if (eqv? n 2)
      (if (eqv? i 0)
	  (car tuple)
	  (cdr tuple))
      (vector-ref tuple i))))

(define (prim.list->tuple l)
  (let ((l (haskell-list->list/non-strict l)))
    (if (null? (cddr l))
	(cons (car l) (cadr l))
	(list->vector l))))

(define (haskell-list->list/non-strict l)
  (if (null? l)
      '()
      (cons (car l)
	    (haskell-list->list/non-strict (force (cdr l))))))

(define (prim.dict-sel dicts i)
  (force (vector-ref dicts i)))

;;; These generate dictionaries.

(define-local-syntax (create-dict dicts vars other-dicts)
  `(let ((dict-vector (box (list->vector ,dicts))))
     (make-tuple
       ,@(map (lambda (v)
		`(delay (apply-1 (force (dynamic ,v)) dict-vector)))
	   vars)
       ,@(map (lambda (sd)
		`(delay (,(car sd)
			 (map (lambda (d)
			       (tuple-select ,(cadr sd) ,(caddr sd) (force d)))
			      ,dicts))))
	      other-dicts))))

;;; The layout of a dictionary is the class's methods in declaration order
;;; followed by its superclass dictionaries (class-super*).  The position of
;;; a superclass dictionary is computed from the class definitions rather
;;; than being fixed here, so the Prelude may add methods to a class.

(define (dict-super-slot class super)
  (do ((l (class-super* class) (cdr l))
       (i (class-n-methods class) (1+ i)))
      ((eq? (car l) super) i)))

(define prim.tupleEqdict
  (lambda dicts
    (tupleEqDict/l dicts)))

(define (tupleEqDict/l dicts)
  (create-dict dicts
     (|PreludeTuple:tupleEq| |PreludeTuple:tupleNeq|)
     ()))

(define prim.tupleOrdDict
 (lambda dicts
   (tupleOrdDict/l dicts)))

;;; Whether the Ord class declares a `compare' method.  Read from the
;;; class definition rather than branching on the dialect (invariant 2):
;;; H98's Ord adds compare; 1.2's does not.
(define (ord-has-compare? ord)
  (memq '|compare| (map (function def-name) (class-method-vars ord))))

(define (tupleOrdDict/l d)
  (let ((ord (core-symbol "Ord")))
    (if (ord-has-compare? ord)
	;; Haskell 98: compare is the last method
	(create-dict d
	 (|PreludeTuple:tupleLe| |PreludeTuple:tupleLeq|
	  |PreludeTuple:tupleGe| |PreludeTuple:tupleGeq|
	  |PreludeTuple:tupleMax| |PreludeTuple:tupleMin|
	  |PreludeTuple:tupleCompare|)
	 ((tupleEqDict/l (class-dict-size ord)
			 (dict-super-slot ord (core-symbol "Eq")))))
	(create-dict d
	 (|PreludeTuple:tupleLe| |PreludeTuple:tupleLeq|
	  |PreludeTuple:tupleGe| |PreludeTuple:tupleGeq|
	  |PreludeTuple:tupleMax| |PreludeTuple:tupleMin|)
	 ((tupleEqDict/l (class-dict-size ord)
			 (dict-super-slot ord (core-symbol "Eq"))))))))

(define prim.tupleIxDict
 (lambda dicts
   (let* ((ix (core-symbol "Ix"))
	  (dict-vector (box (list->vector dicts)))
	  (methods (list (delay (apply-1 (force (dynamic |PreludeTuple:tupleRange|))
					 dict-vector))
			 (delay (apply-1 (force (dynamic |PreludeTuple:tupleIndex|))
					 dict-vector))
			 (delay (apply-1 (force (dynamic |PreludeTuple:tupleInRange|))
					 dict-vector))))
	  ;; Haskell 98's Ix has rangeSize too (Haskell 1.2's does not)
	  (methods (if (> (length (class-method-vars ix)) 3)
		       (append methods
			       (list (delay (apply-1
					     (force (dynamic |PreludeTuple:tupleRangeSize|))
					     dict-vector))))
		       methods))
	  (supers
	   (map (lambda (super)
		  (let ((fn (tuple-super-dict-fn super))
			(size (class-dict-size ix))
			(slot (dict-super-slot ix super)))
		    (delay (funcall fn (map (lambda (d)
					      (dict-component (force d) size slot))
					    dicts)))))
		(class-super* ix))))
     (list->vector (append methods supers)))))

;;; The dictionary builder for a superclass of Ix.

(define (tuple-super-dict-fn class)
  (cond ((eq? class (core-symbol "Eq")) (function tupleEqDict/l))
	((eq? class (core-symbol "Ord")) (function tupleOrdDict/l))
	((eq? class (core-symbol "Text")) (function tupleTextDict/l))
	((eq? class (core-symbol "Show")) (function tupleShowDict/l))
	(else (error "No tuple dictionary for superclass ~A" class))))

(define (dict-component d size i)
  (cond ((eqv? size 1) d)
	((eqv? size 2) (if (eqv? i 0) (car d) (cdr d)))
	(else (vector-ref d i))))

;;; Haskell 98 only.
(define prim.tupleBoundedDict
 (lambda dicts
   (create-dict dicts
    (|PreludeTuple:tupleMinBound| |PreludeTuple:tupleMaxBound|)
    ())))

(define prim.tupleTextDict
 (lambda dicts
   (tupleTextDict/l dicts)))

(define (tupleTextDict/l d)
  (create-dict d
     (|PreludeTuple:tupleReadsPrec| |PreludeTuple:tupleShowsPrec|
      |PreludeTuple:tupleReadList| |PreludeTuple:tupleShowList|)
     ()))

(define prim.tupleBinaryDict
 (lambda dicts
   (create-dict dicts
    (|PreludeTuple:tupleReadBin| |PreludeTuple:tupleShowBin|)
    ())))


;;; Show and Read (Haskell 1.3 and later).  H98's Show also has `show'.

(define prim.tupleShowDict
 (lambda dicts
   (tupleShowDict/l dicts)))

(define (tupleShowDict/l d)
  (if (feature? 'show-method)
      (create-dict d
       (|PreludeTuple:tupleShowsPrec| |PreludeTuple:tupleShow|
	|PreludeTuple:tupleShowList|)
       ())
      (create-dict d
       (|PreludeTuple:tupleShowsPrec| |PreludeTuple:tupleShowList|)
       ())))

(define prim.tupleReadDict
 (lambda dicts
   (create-dict dicts
    (|PreludeTuple:tupleReadsPrec| |PreludeTuple:tupleReadList|)
    ())))
