;;; array-prims.mumble -- array primitives
;;;
;;; author :  John & Sandra
;;; date   :  14 May 1993


;;; An array's vector is a simple vector, or, for an unboxed array of
;;; Bool made by newArray (prim.new-unboxed-mut-arr in base-runtime.lisp)
;;; and frozen, a bit vector: one bit per element where a simple vector
;;; takes a word (starray's 10^7 Bools: 80 MB -> 1.25 MB, as GHC packs
;;; them).  Access tests which, one header check.

;;; Vector reference, returning unboxed value

(define-syntax (prim.vector-sel vec i)
  (let ((v (gensym)) (j (gensym)))
    `(let ((,v ,vec) (,j ,i))
       (if (lisp:simple-bit-vector-p ,v)
	   (lisp:eql (lisp:sbit ,v ,j) 1)
	   (vector-ref ,v ,j)))))


;;; Destructive vector update.  All arguments are unboxed.

(define-syntax (prim.vector-update vec i newval)
  (let ((v (gensym)) (j (gensym)) (x (gensym)))
    `(let ((,v ,vec) (,j ,i) (,x ,newval))
       (if (lisp:simple-bit-vector-p ,v)
	   (setf (lisp:sbit ,v ,j) (bool-bit ,x))
	   (setf (vector-ref ,v ,j) ,x))
       ,x)))

;;; A Bool's bit; any other value cannot go in a bit vector.
(define-syntax (bool-bit x)
  (let ((v (gensym)))
    `(let ((,v ,x))
       (cond ((eq? ,v '#t) 1)
	     ((eq? ,v '#f) 0)
	     (else (unboxed-element-error))))))

(define (unboxed-element-error)
  (haskell-runtime-error
   "an unboxed array made with a Bool element was given another value"))


;;; Make a vector whose elements are initialized to val (which is boxed).

(define-syntax (prim.make-vector size val)
  `(make-vector ,size ,val))


;;; Copy an existing vector.

(define-syntax (prim.copy-vector vec)
  `(lisp:copy-seq ,vec))


;;; Explicit force operation

(define-syntax (prim.force x)
  `(force ,x))


;;; seq (primSeq in PreludeArrayPrims.hi) is strict in both arguments, so
;;; both arrive evaluated and the second is the result, left in tail
;;; position.

(define-syntax (prim.seq force-this result)
  `(begin ,force-this ,result))

;;; The first parameter is forced first since this prim is declared to
;;; be strict in the first arg.

(define-syntax (prim.strict1 force-this leave-this)
  `(begin
     ;; Can't ignore the first argument entirely since doing so
     ;; might result in variable-bound-but-not-referenced errors.
     ;; Hopefully the Lisp compiler will be smart enough to get
     ;; rid of this when appropriate.
     ,force-this
     ;; Don't generate a stupid (force (delay x)) sequence here if
     ;; we don't need to.
     ,(cond ((and (pair? leave-this)
		  (or (eq? (car leave-this) 'delay)
		      (eq? (car leave-this) 'box)))
	     (cadr leave-this))
	    ;; An IO action's result (returnIO x s is x, unevaluated: the
	    ;; IO bind's getRes forces it when it is used), as when an
	    ;; inlined return ends an action.
	    ((and (pair? leave-this)
		  (eq? (car leave-this) 'prim.returnio))
	     leave-this)
	    (else
	     `(force-inline ,leave-this)))))


