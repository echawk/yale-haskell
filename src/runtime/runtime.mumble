(define-compilation-unit runtime
  (source-filename "$Y2/src/runtime/")
  (require global)
  (unit runtime-utils
	(source-filename "runtime-utils.mumble"))
  (unit prims
	(require runtime-utils)
	(source-filename "prims.mumble"))
  (unit io-primitives
	(require runtime-utils)
	(source-filename "io-primitives.mumble"))
  (unit array-prims
	(require runtime-utils)
	(source-filename "array-prims.mumble"))
  (unit debug-utils
	(require runtime-utils)
	(source-filename "debug-utils.mumble"))
  (unit tuple-prims
        (require runtime-utils)
	(source-filename "tuple-prims.mumble"))
  (unit io-errors
	(require runtime-utils)
	(source-filename "io-errors.mumble"))
  (unit system-prims
	(require io-errors prims)
	(source-filename "system-prims.mumble"))
  (unit handle-prims
	(require io-errors system-prims)
	(source-filename "handle-prims.mumble")))
