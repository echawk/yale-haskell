#!/bin/sh
#
# savesys -- load the compiled system and prelude and save the core
# bin/sbcl-haskell.core.  Run it with bin/yale-haskell.

. "$(dirname "$0")/env.sh"
cd "$Y2" || exit 1
if [ ! -f "$PRELUDEBIN/Prelude.fasl" ]; then
  echo "Build the prelude first (com/sbcl/build-prelude)." >&2
  exit 1
fi
run_sbcl --eval '(load "cl-support/cl-setup")' \
         --eval '(load "cl-support/cl-init")' \
         --load com/sbcl/savesys.lisp
