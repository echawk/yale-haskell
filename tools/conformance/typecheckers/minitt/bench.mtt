-- A Mini-TT benchmark for Yale Haskell: types computed by unary arithmetic.
let Bool : U = Sum (true 1 | false 1) ;
letrec Nat : U = Sum (zero 1 | succ Nat) ;
let one : Nat = $ succ ($ zero 0) ;
let two : Nat = $ succ one ;
let three : Nat = $ succ two ;
letrec add : Nat -> Nat -> Nat
  = \x . fun (zero -> \_ . x | succ -> \y . $ succ (add x y)) ;
letrec mult : Nat -> Nat -> Nat
  = \x . fun (zero -> \_ . $ zero 0 | succ -> \y . add x (mult x y)) ;
letrec pow : Nat -> Nat -> Nat
  = \x . fun (zero -> \_ . one | succ -> \y . mult x (pow x y)) ;
letrec eqNat : Nat -> Nat -> Bool
  = fun
    ( zero -> \_ . fun (zero -> \_ . $ true 0  | succ -> \y . $ false 0)
    | succ -> \x . fun (zero -> \_ . $ false 0 | succ -> \y . eqNat x y)
    ) ;
let Empty : U = Sum () ;
let IsTrue : Bool -> U = fun (true -> \_ . 1 | false -> \_ . Empty) ;
letrec T : Nat -> U = fun (zero -> \_ . 1 | succ -> \n . T n) ;
let ten : Nat = add (mult three three) one ;
let x1 : T (pow two ten) = 0 ;
let x2 : T (pow three (add three (add two two))) = 0 ;
let p1 : IsTrue (eqNat (pow two ten) (mult (pow two (add three two)) (pow two (add three two)))) = 0 ;
let p2 : IsTrue (eqNat (mult (pow three three) (pow three three)) (pow three (add three three))) = 0 ;
letrec List : U -> U = \A . Sum (nil 1 | cons (Sig _ : A . List A)) ;
letrec replicate : Nat -> Pi A : U . A -> List A
  = fun (zero -> \_ . \A . \a . $ nil 0 | succ -> \n . \A . \a . $ cons (a, replicate n A a)) ;
letrec length : Pi A : U . List A -> Nat
  = \A . fun (nil -> \_ . $ zero 0 | cons -> \(a, as) . $ succ (length A as)) ;
let p3 : IsTrue (eqNat (length Nat (replicate (pow two (add ten one)) Nat one)) (pow two (add ten one))) = 0 ;
0
