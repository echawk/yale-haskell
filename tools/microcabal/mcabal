#!/bin/sh
#
# mcabal -- MicroCabal, built from build/microcabal/src (setup.sh, run
# when that is missing or older than its sources), run by Yale Haskell,
# building packages with Yale Haskell by default.
#
#   tools/microcabal/mcabal [FLAGS] COMMAND ...      (mcabal help)
#
# $YALE is the yale-haskell the backend runs (default: this checkout's
# bin/yale-haskell); packages are installed in $CABALDIR (default
# ~/.mcabal) under yale-VERSION/.  Fetching needs curl and tar.

here=$(cd "$(dirname "$0")" && pwd)
top=$(dirname "$(dirname "$here")")
out=$top/build/microcabal/src
stamp=$out/.stamp
if [ ! -f "$stamp" ] ||
   [ -n "$(find "$here/Yale.hs" "$here/yale-backend.patch" "$here/mcabal.hs" \
              "$top/ref/MicroCabal/src" -newer "$stamp" 2>/dev/null | head -1)" ]; then
  "$here/setup.sh" && touch "$stamp" || exit 1
fi
YALE=${YALE:-$top/bin/yale-haskell}
export YALE
# patches for packages that only GHC was meant to compile (Yale.hs)
YALE_MCABAL_PATCHES=${YALE_MCABAL_PATCHES:-$here/patches}
export YALE_MCABAL_PATCHES
exec "$top/bin/yale-haskell" --haskell98 --modern-prelude "$out/mcabal.hs" "$@"
