#!/bin/sh
#
# mcabal -- MicroCabal, from the submodule tools/microcabal/MicroCabal
# (the branch yale-backend of https://github.com/echawk/MicroCabal, which
# adds the Yale Haskell backend), run by Yale Haskell, building packages
# with Yale Haskell (--yale).
#
#   tools/microcabal/mcabal [FLAGS] COMMAND ...      (mcabal help)
#
# $YALE is the yale-haskell the backend runs (default: this checkout's
# bin/yale-haskell); packages are installed in $CABALDIR (default
# ~/.mcabal) under yale-VERSION/.  Fetching needs curl and tar.

here=$(cd "$(dirname "$0")" && pwd)
top=$(dirname "$(dirname "$here")")
src=$here/MicroCabal/src
if [ ! -f "$src/MicroCabal/Main.hs" ]; then
  git -C "$top" submodule update --init tools/microcabal/MicroCabal || exit 1
fi
YALE=${YALE:-$top/bin/yale-haskell}
export YALE
# patches for packages that only GHC was meant to compile
# (MicroCabal/Backend/Yale.hs)
YALE_MCABAL_PATCHES=${YALE_MCABAL_PATCHES:-$here/patches}
export YALE_MCABAL_PATCHES
# HsFFI.h, for packages' C sources (Backend/Yale.hs)
YALE_MCABAL_INCLUDE=${YALE_MCABAL_INCLUDE:-$here/include}
export YALE_MCABAL_INCLUDE
# hsc2hs's constructs (#{const ..}, #peek, ...) in .hsc modules
# (Backend/Yale.hs)
YALE_HSC2HS=${YALE_HSC2HS:-$here/yale-hsc2hs}
export YALE_HSC2HS
# -ffake-ghc: impl(ghc >= v) holds as for GHC 9.6, whose boot packages
# Yale Haskell's library follows (so a package does not take the
# branches for old GHCs, integer-gmp and the like)
exec "$top/bin/yale-haskell" --haskell98 --modern-prelude -i "$src" "$here/mcabal.hs" --yale -ffake-ghc "$@"
