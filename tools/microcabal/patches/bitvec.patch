bitvec: F2Poly without GHC.Num.BigNat (Yale Haskell's Integer is the host's):
conversions to and from Integer bit by bit.
diff -ruN a/Data/Bit/F2Poly.hs b/Data/Bit/F2Poly.hs
--- a/Data/Bit/F2Poly.hs	2026-10-26 07:37:26
+++ b/Data/Bit/F2Poly.hs	2026-10-26 07:37:26
@@ -40,8 +40,10 @@
 import qualified Data.Vector.Unboxed.Mutable as MU
 import GHC.Exts
 import GHC.Generics
+#ifndef __YALE_HASKELL__
 import GHC.Num.BigNat
 import GHC.Num.Integer
+#endif
