 -- | Binary polynomials of one variable, backed
@@ -82,13 +84,32 @@
 toF2Poly :: U.Vector Bit -> F2Poly
 toF2Poly xs = F2Poly $ dropWhileEnd $ castFromWords $ cloneToWords xs
 
+#ifdef __YALE_HASKELL__
+-- (Yale Haskell: no GHC.Num.BigNat; the conversions go bit by bit)
 zero :: F2Poly
+zero = toF2Poly U.empty
+
+one :: F2Poly
+one = toF2Poly (U.singleton (Bit True))
+
+integerToF2Poly :: Integer -> F2Poly
+integerToF2Poly n
+  | n < 0 = throw Underflow
+  | otherwise = toF2Poly (U.fromList (go n))
+  where go 0 = []
+        go m = Bit (odd m) : go (m `div` 2)
+
+f2PolyToInteger :: F2Poly -> Integer
+f2PolyToInteger = foldr (\(Bit b) acc -> 2 * acc + (if b then 1 else 0)) 0 . U.toList . unF2Poly
+#else
+zero :: F2Poly
 zero = F2Poly $ BitVec 0 0 $
   ByteArray (unBigNat bigNatZero)
 
 one :: F2Poly
 one = F2Poly $ BitVec 0 1 $
   ByteArray (unBigNat bigNatOne)
+#endif
 
