ram: Data.Word's popCount and byteSwap64 (base >= 4.7), not the fallbacks CPP picks without MIN_VERSION_base.
diff -ruN a/Data/Memory/Internal/Compat.hs b/Data/Memory/Internal/Compat.hs
--- a/Data/Memory/Internal/Compat.hs	2026-11-01 03:58:37
+++ b/Data/Memory/Internal/Compat.hs	2026-11-01 03:58:37
@@ -35,14 +35,14 @@
 unsafeDoIO = unsafePerformIO
 #endif
 
-#if !(MIN_VERSION_base(4,5,0))
+#if 0
 popCount :: Word64 -> Int
 popCount n = loop 0 n
   where loop c 0 = c
         loop c i = loop (c + if testBit c 0 then 1 else 0) (i `shiftR` 1)
 #endif
 
-#if !(MIN_VERSION_base(4,7,0))
+#if 0
 byteSwap64 :: Word64 -> Word64
 byteSwap64 w =
         (w `shiftR` 56)                  .|. (w `shiftL` 56)
@@ -51,7 +51,7 @@
     .|. ((w `shiftR` 8)  .&. 0xff000000) .|. ((w .&. 0xff000000) `shiftL` 8)
 #endif
 
-#if !(MIN_VERSION_base(4,7,0))
+#if 0
 byteSwap32 :: Word32 -> Word32
 byteSwap32 w =
         (w `shiftR` 24)
@@ -60,13 +60,13 @@
     .|. ((w .&. 0xff00) `shiftL` 8)
 #endif
 
-#if !(MIN_VERSION_base(4,7,0))
+#if 0
 byteSwap16 :: Word16 -> Word16
 byteSwap16 w =
     (w `shiftR` 8) .|. (w `shiftL` 8)
 #endif
 
-#if !(MIN_VERSION_base(4,5,0))
+#if 0
 unsafeShiftL :: Bits a => a -> Int -> a
 unsafeShiftL = shiftL
 
